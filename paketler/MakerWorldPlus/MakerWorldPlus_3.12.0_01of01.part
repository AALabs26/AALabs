          }), { rootMargin: '200px' });
        }
        // React aynı öğeyi başka model için yeniden kullanabilir: model değişince yeniden gözlenir
        if (!k.__mwxModel || k.__mwxModel.id !== m.id) { k.__mwxModel = m; KART.gozcu.observe(k); }
      } else kuyruga(m);
      kartRozeti(k, m);
    });
    KART.durum = { n: kartlar.size, y, h };
  }

  // ═══════════════════════════════════════════════════════════════════════
  // ORTAK AYARLAR (kapalı Shadow DOM, kipli <dialog>)
  // ═══════════════════════════════════════════════════════════════════════
  const UI = { host: null, kok: null, pencere: null, bolum: 'sekme', ara: '', onceki: null, kabul: depoOku('kabul', {}) || {} };
  const BOLUMLER = [['sekme', 'mwx'], ['rozet', 'mwx'], ['uyumsuz', 'mwx'], ['filtre', 'mwx'], ['kart', 'mwx'], ['gelismis', 'mwx'],
    ['genel', 'ortak'], ['kisayol', 'ortak'], ['tani', 'ortak'], ['hakkinda', 'ortak']];
  // Ölçek: ≥ 3 px değerler calc(Npx*var(--o)) (platform-userscript §3.8)
  const carp = (s) => s.replace(/(^|[^\w.#-])(\d+(?:\.\d+)?)px/g, (m, on, n) => (Number(n) <= 2 ? m : `${on}calc(${n}px*var(--o))`));
  const UI_CSS = carp(`
/* TOKEN-BASLA */
:host{--ana:#2456D6;--ana-acik:#E5EBFA;--ana-hover:#F2F5FD;--ana-uzeri:#FFFFFF;--vurgu:#2456D6;--zemin:#F6F9FC;--yuzey:#FFFFFF;
 --metin:#17252E;--metin-ikincil:#4E6269;--kenar:#7A9199;--ayirici:#D3DEE6;--basari:#18763F;--basari-bg:#E4F5E8;--uyari:#9A5B00;
 --uyari-bg:#FDF6D8;--hata:#C4313B;--hata-bg:#FDE8E8;--perde:rgba(15,21,32,.42);--o:1;color-scheme:light}
:host([data-tema="koyu"]){--ana-acik:#1D2C4F;--ana-hover:#1B2434;--vurgu:#86A8FF;--zemin:#0F1520;--yuzey:#161E2B;--metin:#E6ECF5;
 --metin-ikincil:#9AA8BC;--kenar:#6A7B93;--ayirici:#263142;--basari:#4CC38A;--basari-bg:#13301F;--uyari:#E8AC45;--uyari-bg:#33270F;
 --hata:#FF8189;--hata-bg:#3A161A;--perde:rgba(0,0,0,.55);color-scheme:dark}
/* TOKEN-BITIR */
[hidden]{display:none !important}
*{box-sizing:border-box}
dialog{padding:0;border:1px solid var(--kenar);border-radius:6px;background:var(--yuzey);color:var(--metin);width:min(780px,calc(100vw - 32px));
 height:min(560px,calc(100vh - 32px));font:400 13px/1.45 "Open Sans","Segoe UI",Roboto,sans-serif;overflow:hidden}
dialog[open]{display:flex;flex-direction:column}
dialog::backdrop{background:var(--perde)}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--vurgu);outline-offset:2px}
.ust{display:flex;align-items:center;gap:8px;padding:8px 10px;border-bottom:1px solid var(--ayirici)}
.kod{width:24px;height:24px;border-radius:4px;background:var(--ana);color:var(--ana-uzeri);display:grid;place-items:center;font-size:9px;font-weight:700;flex:0 0 auto}
.bas{font-weight:600;flex:1 1 auto;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ara{height:28px;border:1px solid var(--kenar);border-radius:4px;background:var(--zemin);padding:0 8px;width:190px;min-width:0}
.kucuk{height:28px;min-width:28px;padding:0 6px;border:1px solid var(--kenar);border-radius:4px;background:var(--yuzey);cursor:pointer;display:inline-grid;place-items:center}
.kucuk:hover,.dug:hover{background:var(--ana-hover)}
.kucuk[disabled]{opacity:.55;cursor:default}
.govde{display:grid;grid-template-columns:184px minmax(0,1fr);flex:1 1 auto;min-height:0}
nav{border-right:1px solid var(--ayirici);padding:8px 0;overflow:auto;background:var(--zemin)}
nav .grup{font-size:11px;font-weight:700;color:var(--metin-ikincil);letter-spacing:.06em;padding:8px 12px 4px}
nav button{display:block;width:100%;text-align:left;border:0;background:transparent;padding:0 12px;height:28px;cursor:pointer;
 white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
nav button:hover{background:var(--ana-hover)}
nav button[aria-current="true"]{background:var(--ana-acik);font-weight:600;box-shadow:inset 3px 0 var(--ana)}
.icerik{overflow:auto;padding:12px 16px 24px}
.bolum + .bolum{border-top:1px solid var(--ayirici);padding-top:12px;margin-top:12px}
h4{margin:0 0 2px;font-size:14px;font-weight:600}
.acik{margin:0 0 8px;color:var(--metin-ikincil);font-size:12px}
.oge{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;align-items:center;padding:6px 0;border-bottom:1px solid var(--ayirici)}
.oge:last-child{border-bottom:0}
.oge small{display:block;color:var(--metin-ikincil)}
.anahtar{width:36px;height:20px;border-radius:10px;border:1px solid var(--kenar);background:var(--zemin);position:relative;cursor:pointer;padding:0}
.anahtar::after{content:"";position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;background:var(--kenar);transition:left .12s}
.anahtar[aria-checked="true"]{background:var(--ana);border-color:var(--ana)}
.anahtar[aria-checked="true"]::after{left:18px;background:var(--ana-uzeri)}
.seg{display:inline-flex;flex-wrap:wrap;border:1px solid var(--kenar);border-radius:4px;overflow:hidden}
.seg button{border:0;background:var(--yuzey);padding:4px 10px;cursor:pointer;border-right:1px solid var(--ayirici)}
.seg button:last-child{border-right:0}
.seg button[aria-pressed="true"]{background:var(--ana);color:var(--ana-uzeri)}
.kutular{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:4px 12px;padding:4px 0 8px}
.kutular label{display:flex;gap:6px;align-items:center;cursor:pointer}
input[type=checkbox]{accent-color:var(--ana);width:15px;height:15px;margin:0}
.sayi{width:84px;height:28px;border:1px solid var(--kenar);border-radius:4px;background:var(--zemin);padding:0 6px}
.sira{display:flex;flex-direction:column;gap:4px}
.sira div{display:flex;align-items:center;gap:6px;border:1px solid var(--ayirici);border-radius:4px;padding:2px 4px 2px 8px;min-width:150px}
.sira span{flex:1 1 auto;font-weight:600}
.sira select{height:28px;border:1px solid var(--kenar);border-radius:4px;background:var(--yuzey)}
.dug{height:28px;padding:0 12px;border:1px solid var(--kenar);background:var(--yuzey);border-radius:4px;cursor:pointer}
.dug.onay{border-color:var(--hata);color:var(--hata)}
.dugmeler{display:flex;gap:8px;flex-wrap:wrap}
.kisayol{width:140px;height:28px;border:1px solid var(--kenar);border-radius:4px;background:var(--zemin);padding:0 8px;font-weight:700;cursor:pointer}
table{width:100%;border-collapse:collapse;font-size:12px}
td{padding:5px 4px;border-bottom:1px solid var(--ayirici);vertical-align:top}
td:first-child{width:22px;font-weight:700}
.v{color:var(--basari)} .x{color:var(--hata)} .b{color:var(--metin-ikincil)}
code{font-family:Consolas,"Cascadia Mono",monospace;font-size:11px;color:var(--metin-ikincil);overflow-wrap:anywhere}
.madde{border:1px solid var(--ayirici);border-radius:4px;padding:8px;margin-top:6px}
.madde p{margin:0 0 6px}
.madde small{display:block;color:var(--metin-ikincil);margin-bottom:6px}
.madde input[type=text]{width:100%;height:28px;border:1px solid var(--kenar);border-radius:4px;background:var(--zemin);padding:0 8px;margin-top:6px}
.alt{display:flex;justify-content:space-between;gap:8px;padding:8px 10px;border-top:1px solid var(--ayirici);color:var(--metin-ikincil);font-size:12px}
.alt b{font-weight:700}
.bildirim{position:absolute;left:50%;bottom:48px;transform:translateX(-50%);background:var(--metin);color:var(--yuzey);border-radius:4px;padding:6px 12px;font-size:12px;max-width:90%}
textarea{width:100%;height:120px;font-family:Consolas,monospace;font-size:11px;background:var(--zemin);color:var(--metin);border:1px solid var(--kenar);border-radius:4px}
@media (max-width:560px){.govde{grid-template-columns:1fr}nav{display:none}.ara{width:120px}}
@media (prefers-reduced-motion:reduce){*{transition:none !important}}
`);

  function uiKur() {
    if (UI.host && UI.host.isConnected) return;
    const yer = document.body || document.documentElement;
    if (!yer) return;
    UI.host = O('div', { id: `${ONEK}-kok` });
    UI.kok = UI.host.attachShadow({ mode: 'closed' });
    UI.kok.append(O('style', { text: UI_CSS }));
    UI.pencere = O('dialog', { 'aria-label': AD + ' · ' + t('ayarlar') });
    UI.pencere.addEventListener('close', () => { if (UI.onceki && UI.onceki.focus) { try { UI.onceki.focus(); } catch (e) { /* yok */ } } UI.onceki = null; });
    UI.pencere.addEventListener('pointerdown', (e) => { UI.basHedef = e.target; });
    UI.pencere.addEventListener('click', (e) => { if (e.target === UI.pencere && UI.basHedef === UI.pencere) { const r = UI.pencere.getBoundingClientRect(); if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) UI.pencere.close(); } });
    UI.kok.append(UI.pencere);
    yer.append(UI.host);
    temaUygula();
  }
  function acikMi() { return !!(UI.pencere && UI.pencere.open); }
  function ayarlariAc() {
    uiKur();
    if (!UI.pencere) return;
    if (acikMi()) { UI.pencere.close(); return; }
    UI.onceki = document.activeElement;
    UI.host.style.setProperty('--o', String(AYAR.olcek / 100));
    pencereCiz();
    UI.pencere.showModal();
    const ilk = UI.kok.querySelector('nav button[aria-current="true"]') || UI.kok.querySelector('.ara');
    if (ilk) ilk.focus();
  }
  function bildir(m) {
    if (!UI.kok) return;
    const b = O('div', { class: 'bildirim', role: 'status', text: m });
    (acikMi() ? UI.pencere : UI.kok).append(b);
    setTimeout(() => b.remove(), 2600);
  }
  function degisti(yeniden, cizme) {
    ayarKaydet();
    if (cubuk) { cubuk.remove(); cubuk = null; }
    D.secMat.clear();
    temaUygula();
    if (UI.host) UI.host.style.setProperty('--o', String(AYAR.olcek / 100));
    if (yeniden) menuKaydet();
    planla(true);
    if (acikMi() && !cizme) pencereCiz();
  }
  function anahtarK(k) {
    return O('button', { class: 'anahtar', role: 'switch', type: 'button', 'data-k': k, 'aria-checked': AYAR[k] ? 'true' : 'false', 'aria-label': t('o_' + k),
      onclick: () => { AYAR[k] = !AYAR[k]; if (k === 'hatirla') depoYaz('filtre', AYAR.hatirla ? D.filtre : ''); degisti(); } });
  }
  function segK(k, secenekler, donustur) {
    const s = O('div', { class: 'seg', role: 'group', 'aria-label': t('o_' + k) });
    secenekler.forEach(([v, ad]) => s.append(O('button', { type: 'button', 'data-k': k + ':' + v, 'aria-pressed': String(AYAR[k]) === String(v) ? 'true' : 'false', text: ad,
      onclick: () => { AYAR[k] = donustur ? donustur(v) : v; if (k === 'vsrt') D.vsrt = AYAR.vsrt; degisti(k === 'dil'); } })));
    return s;
  }
  function sayiK(k) {
    const i = O('input', { type: 'number', class: 'sayi', 'data-k': k, 'aria-label': t('o_' + k) });
    i.value = String(AYAR[k]);
    // Yeniden çizim yok: blur anındaki change, tıklanan sonraki denetimi DOM'dan silmesin
    i.addEventListener('change', () => { const y = dogrula(Object.assign({}, AYAR, { [k]: Number(i.value) })); AYAR[k] = y[k]; i.value = String(AYAR[k]); degisti(false, true); });
    return i;
  }
  function oge(ad, ipucu, kontrol, aramaEk) {
    const o = O('div', { class: 'oge' }, O('div', {}, ad, ipucu ? O('small', { text: ipucu }) : null), kontrol || O('span'));
    o.dataset.ara = katla([ad, ipucu || '', aramaEk || ''].join(' '));
    return o;
  }

  // Başka sekmenin cevaplarını ezmemek için her yazmadan önce depodan yeniden okunur
  function kabulYaz(k, c) {
    const d = depoOku('kabul', {});
    UI.kabul = d && typeof d === 'object' && !Array.isArray(d) ? d : {};
    UI.kabul[k] = c;
    depoYaz('kabul', UI.kabul);
  }
  function bolumCiz(id) {
    const b = O('section', { class: 'bolum', 'data-bolum': id }, O('h4', { text: t('b_' + id) }));
    const ac = t('a_' + id);
    if (ac !== 'a_' + id && METIN.tr['a_' + id]) b.append(O('p', { class: 'acik', text: ac }));
    if (id === 'sekme') {
      const s = O('div', { class: 'sira' });
      AYAR.sira.forEach((p, i) => s.append(O('div', {}, O('span', { text: p }),
        O('button', { type: 'button', class: 'kucuk', 'data-k': 'sira:' + i + ':y', 'aria-label': p + ' ↑', disabled: i === 0, onclick: () => { [AYAR.sira[i - 1], AYAR.sira[i]] = [AYAR.sira[i], AYAR.sira[i - 1]]; degisti(); } }, svg('yukari')),
        O('button', { type: 'button', class: 'kucuk', 'data-k': 'sira:' + i + ':a', 'aria-label': p + ' ↓', disabled: i === AYAR.sira.length - 1, onclick: () => { [AYAR.sira[i + 1], AYAR.sira[i]] = [AYAR.sira[i], AYAR.sira[i + 1]]; degisti(); } }, svg('asagi')),
        O('button', { type: 'button', class: 'kucuk', 'aria-label': t('o_cikar') + ': ' + p, title: t('o_cikar'), disabled: AYAR.sira.length < 2, onclick: () => { AYAR.sira.splice(i, 1); degisti(); } }, svg('x')))));
      const kalan = YAZICI_LISTE.filter((y) => !AYAR.sira.some((s0) => esYazici(s0, y)));
      if (kalan.length && AYAR.sira.length < 6) {
        const sec = O('select', { 'data-k': 'sira-ekle', 'aria-label': t('o_ekle') }, O('option', { value: '', text: t('o_ekle') + '…' }), kalan.map((y) => O('option', { value: y, text: y })));
        sec.addEventListener('change', () => { if (sec.value) { AYAR.sira.push(sec.value); degisti(); } });
        s.append(sec);
      }
      b.append(oge(t('o_sira'), t('o_siraI'), s, AYAR.sira.join(' ')), oge(t('o_oto'), '', anahtarK('oto')), oge(t('o_url'), t('o_urlI'), anahtarK('url')),
        oge(t('o_ilk'), t('o_ilkI'), anahtarK('ilk')), oge(t('o_bilgi'), t('o_bilgiI'), anahtarK('bilgi')));
    }
    if (id === 'rozet') {
      const k = O('div', { class: 'kutular' });
      ALANLAR.forEach((a) => {
        const c = O('input', { type: 'checkbox', 'data-k': 'alan:' + a }); c.checked = AYAR.alan.indexOf(a) >= 0;
        c.addEventListener('change', () => { AYAR.alan = ALANLAR.filter((x) => (x === a ? c.checked : AYAR.alan.indexOf(x) >= 0)); degisti(); });
        k.append(O('label', {}, c, t('f_' + a)));
      });
      b.append(oge(t('o_alan'), '', null, ALANLAR.map((a) => t('f_' + a)).join(' ')), k, oge(t('o_hazne'), t('o_hazneI'), anahtarK('hazne')),
        oge(t('o_noz'), t('o_nozI'), segK('noz', [[0.2, '0.2'], [0.4, '0.4'], [0.6, '0.6'], [0.8, '0.8']], Number)));
    }
    if (id === 'uyumsuz') {
      b.append(oge(t('o_stil'), '', segK('stil', ['blur', 'dim', 'hide', 'none'].map((s) => [s, t('s_' + s)]))),
        oge(t('o_net'), '', anahtarK('net')), oge(t('o_sona'), t('o_sonaI'), anahtarK('sona')));
    }
    if (id === 'filtre') {
      const g = O('div', { class: 'kutular' });
      MALZEMELER.forEach((m) => {
        const c = O('input', { type: 'checkbox', 'data-k': 'gizli:' + m }); c.checked = AYAR.gizli.indexOf(m) >= 0;
        c.addEventListener('change', () => { AYAR.gizli = MALZEMELER.filter((x) => (x === m ? c.checked : AYAR.gizli.indexOf(x) >= 0)); degisti(); });
        g.append(O('label', {}, c, m));
      });
      b.append(oge(t('o_kutu'), '', anahtarK('kutu')), oge(t('o_hatirla'), '', anahtarK('hatirla')), oge(t('o_cip'), '', anahtarK('cip')),
        oge(t('o_gizli'), t('o_gizliI'), null, MALZEMELER.join(' ')), g, oge(t('o_srt'), '', anahtarK('srt')),
        oge(t('o_vsrt'), '', segK('vsrt', SIRALAR.map((s) => [s, t('v_' + (s === 'default' ? 'varsayilan' : s))]))));
    }
    if (id === 'kart') b.append(oge(t('o_kartAc'), t('o_kartAcI'), anahtarK('kartAc')), oge(t('o_kartUyum'), '', anahtarK('kartUyum')), oge(t('o_kartGor'), t('o_kartGorI'), anahtarK('kartGor')));
    if (id === 'gelismis') {
      b.append(oge(t('o_bekle'), '', sayiK('bekle')), oge(t('o_aralik'), '', sayiK('aralik')), oge(t('o_deneme'), '', sayiK('deneme')),
        oge(t('o_sure'), '', sayiK('sure')), oge(t('o_onbellek'), '', sayiK('onbellek')), oge(t('o_gunluk'), '', anahtarK('gunluk')),
        oge(t('o_kapali'), t('o_kapaliI'), anahtarK('kapali')));
    }
    if (id === 'genel') {
      const vars = O('button', { type: 'button', class: 'dug', 'data-k': 'vars', text: t('vars') });
      let zaman = 0;
      vars.addEventListener('click', () => {
        if (Date.now() - zaman < 500) return; // çift tıklama iki adımı birden geçmesin
        if (Date.now() - zaman > 4000) { zaman = Date.now(); vars.textContent = t('varsOnay'); vars.classList.add('onay'); setTimeout(() => { vars.textContent = t('vars'); vars.classList.remove('onay'); }, 4000); return; }
        AYAR = kopya(VARSAYILAN); D.vsrt = AYAR.vsrt; degisti(true); bildir(t('varsYapildi'));
      });
      b.append(oge(t('o_tema'), '', segK('tema', [['sayfa', t('t_sayfa')], ['acik', t('t_acik')], ['koyu', t('t_koyu')]])),
        oge(t('o_dil'), AYAR.dil === 'tarayici' ? t('d_algi', { d: tarayiciDili() === 'tr' ? 'Türkçe' : 'English' }) : '', segK('dil', [['tarayici', t('d_tarayici')], ['tr', 'Türkçe'], ['en', 'English']])),
        oge(t('o_olcek'), '', segK('olcek', [90, 100, 115, 130].map((v) => [v, dil() === 'tr' ? '%' + v : v + '%']), Number)),
        oge(t('o_vars'), '', vars));
    }
    if (id === 'kisayol') {
      const kutu = O('input', { class: 'kisayol', type: 'text', readonly: true, 'aria-label': t('k_ayarlar') });
      kutu.value = AYAR.kisayol.ayarlar;
      kutu.addEventListener('focus', () => { kutu.value = t('k_bas'); });
      kutu.addEventListener('blur', () => { kutu.value = AYAR.kisayol.ayarlar; });
      kutu.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') return;
        e.preventDefault(); e.stopPropagation();
        if (e.key === 'Escape') { kutu.blur(); return; }
        if (['Control', 'Shift', 'Alt', 'Meta', 'AltGraph'].indexOf(e.key) >= 0) return;
        const k = tusKombo(e);
        if (!k || yasakMi(k)) { bildir(t('k_gecersiz', { k: k || e.key })); return; }
        AYAR.kisayol.ayarlar = k; degisti(); bildir(t('k_degisti', { k }));
      });
      const v = O('button', { type: 'button', class: 'dug', text: t('k_varsayilan'), onclick: () => { AYAR.kisayol.ayarlar = VARSAYILAN.kisayol.ayarlar; degisti(); } });
      b.append(oge(t('k_ayarlar'), '', O('div', { class: 'dugmeler' }, kutu, v), AYAR.kisayol.ayarlar));
    }
    if (id === 'tani') {
      const tb = O('table');
      taniSatirlari().forEach(([d, ad, deger]) => tb.append(O('tr', {}, O('td', { class: d, text: d === 'v' ? '✓' : d === 'x' ? '✗' : '–' }), O('td', {}, ad, O('br'), O('code', { text: deger })))));
      const tt = O('table');
      tarihAlanlari().forEach(([ad, deger]) => tt.append(O('tr', {}, O('td', { class: 'b', text: '·' }), O('td', {}, ad, O('br'), O('code', { text: deger })))));
      const kopyaD = O('button', { type: 'button', class: 'dug', text: t('tn_kopya'), onclick: () => raporKopyala(b) });
      b.append(tb, O('h4', { text: t('tn_tarih'), style: 'margin-top:12px' }), tt, O('div', { class: 'dugmeler', style: 'margin-top:8px' }, kopyaD));
      b.append(O('h4', { text: t('tn_kabul'), style: 'margin-top:14px' }), O('p', { class: 'acik', text: t('tn_kabulA') }));
      KABUL.forEach((k) => {
        const c = (UI.kabul[k] && UI.kabul[k].v === SURUM) ? UI.kabul[k] : {};
        const not = O('input', { type: 'text', maxlength: 200, 'data-k': 'not:' + k, placeholder: t('tn_not'), 'aria-label': t('tn_not'), hidden: c.s !== 'sorun' });
        not.value = c.n || '';
        let notZaman = null;
        const notYaz = () => { clearTimeout(notZaman); kabulYaz(k, { s: 'sorun', n: not.value.slice(0, 200), v: SURUM }); };
        not.addEventListener('input', () => { clearTimeout(notZaman); notZaman = setTimeout(notYaz, 400); });
        not.addEventListener('change', notYaz);
        const seg = O('div', { class: 'seg', role: 'group', 'aria-label': t(k) });
        [['gecti', t('tn_gecti')], ['sorun', t('tn_sorun')], ['atla', t('tn_atla')]].forEach(([s, ad]) => seg.append(O('button', { type: 'button', text: ad, 'data-k': 'kabul:' + k + ':' + s,
          'aria-pressed': c.s === s ? 'true' : 'false',
          onclick: () => { kabulYaz(k, { s, n: s === 'sorun' ? not.value.slice(0, 200) : '', v: SURUM }); pencereCiz(); bildir(t('tn_kabulBitti')); } })));
        b.append(O('div', { class: 'madde' }, O('p', { text: t(k) }), O('small', { text: t(k + 'i') }), seg, not));
      });
    }
    if (id === 'hakkinda') {
      const disa = O('button', { type: 'button', class: 'dug', text: t('h_disa'), onclick: () => {
        const a = O('a', { href: 'data:application/json;charset=utf-8,' + encodeURIComponent(JSON.stringify({ uygulama: 'MWX', surum: SURUM, ayar: AYAR }, null, 2)), download: 'AALabs.MakerWorldPlus.ayar.json' });
        UI.pencere.append(a); a.click(); a.remove();
      } });
      const dosya = O('input', { type: 'file', accept: 'application/json,.json', hidden: true });
      dosya.addEventListener('change', () => {
        const f = dosya.files && dosya.files[0]; if (!f) return;
        const r = new FileReader();
        r.onload = () => {
          try {
            const j = JSON.parse(String(r.result));
            if (!j || j.uygulama !== 'MWX' || !j.ayar || typeof j.ayar !== 'object' || Array.isArray(j.ayar) || !Object.keys(j.ayar).some((x) => x in VARSAYILAN)) throw new Error('biçim'); AYAR = dogrula(j.ayar); D.vsrt = AYAR.vsrt; degisti(true); bildir(t('h_iceTamam')); }
          catch (e) { bildir(t('h_iceHata')); }
          dosya.value = ''; // aynı dosya yeniden seçilebilsin
        };
        r.readAsText(f);
      });
      const ice = O('button', { type: 'button', class: 'dug', text: t('h_ice'), onclick: () => dosya.click() });
      b.append(O('p', { text: t('h_surum', { ad: AD, s: SURUM }) }), O('p', { class: 'acik', text: t('h_kaynak') }), O('p', { class: 'acik', text: t('h_eskiBetik') }),
        oge(t('h_yedek'), '', O('div', { class: 'dugmeler' }, disa, ice, dosya)));
    }
    return b;
  }

  function pencereCiz() {
    if (!UI.pencere) return;
    const kayit = UI.kok.querySelector('.icerik');
    const kaydirma = kayit ? kayit.scrollTop : 0;
    const etkin = UI.kok.activeElement;
    const odakAra = etkin && etkin.classList && etkin.classList.contains('ara');
    const imlec = odakAra ? [etkin.selectionStart, etkin.selectionEnd] : null;
    const odakK = etkin && etkin.dataset ? etkin.dataset.k : null;
    const oncekiAra = UI.cizilenAra;
    UI.cizilenAra = UI.ara;
    UI.pencere.setAttribute('aria-label', AD + ' · ' + t('ayarlar'));
    UI.pencere.textContent = '';
    const ara = O('input', { class: 'ara', type: 'search', placeholder: t('ara'), 'aria-label': t('ara') });
    ara.value = UI.ara;
    ara.addEventListener('input', (e) => { if (e.isComposing) return; UI.ara = ara.value; pencereCiz(); });
    ara.addEventListener('compositionend', () => { UI.ara = ara.value; pencereCiz(); });
    const kapat = O('button', { type: 'button', class: 'kucuk', 'aria-label': t('kapat'), title: t('kapat') + ' (Esc)', onclick: () => UI.pencere.close() }, svg('x'));
    const ust = O('div', { class: 'ust' }, O('span', { class: 'kod', 'aria-hidden': 'true', text: KOD }), O('span', { class: 'bas', text: AD + ' · ' + t('ayarlar') }), ara, kapat);
    const nav = O('nav', { 'aria-label': t('ayarlar') });
    let grup = null;
    BOLUMLER.forEach(([id, g]) => {
      if (g !== grup) { grup = g; nav.append(O('div', { class: 'grup', text: g === 'mwx' ? KOD : t('ortak') })); }
      nav.append(O('button', { type: 'button', title: t('b_' + id), text: t('b_' + id), 'aria-current': id === UI.bolum && !UI.ara ? 'true' : 'false',
        onclick: () => { UI.bolum = id; UI.ara = ''; pencereCiz(); const s = UI.kok.querySelector('.icerik'); if (s) s.scrollTop = 0; } }));
    });
    const icerik = O('div', { class: 'icerik' });
    const q = katla(UI.ara.trim());
    if (q) {
      let bulundu = false;
      BOLUMLER.forEach(([id]) => {
        const b = bolumCiz(id);
        const bas = katla(t('b_' + id)).indexOf(q) >= 0;
        const ogeler = Array.from(b.querySelectorAll('.oge'));
        const eslesen = ogeler.filter((o) => (o.dataset.ara || '').indexOf(q) >= 0);
        if (!bas && !eslesen.length) return;
        if (!bas) ogeler.forEach((o) => { if (eslesen.indexOf(o) < 0) o.hidden = true; });
        bulundu = true; icerik.append(b);
      });
      if (!bulundu) icerik.append(O('p', { class: 'acik', text: t('sonucYok') }));
    } else icerik.append(bolumCiz(UI.bolum));
    const alt = O('div', { class: 'alt' }, O('span', { text: t('altSol') }), O('span', {}, O('b', { text: AYAR.kisayol.ayarlar }), ' · ' + t('altSag')));
    UI.pencere.append(ust, O('div', { class: 'govde' }, nav, icerik), alt);
    if (kayit && (!q || oncekiAra === UI.ara)) icerik.scrollTop = kaydirma;
    if (odakAra) {
      ara.focus();
      const n = ara.value.length;
      try { ara.setSelectionRange(Math.min(imlec[0] == null ? n : imlec[0], n), Math.min(imlec[1] == null ? n : imlec[1], n)); } catch (e) { /* search türü */ }
    } else if (odakK) {
      // Klavyeyle değiştirilen denetim yeniden çizimden sonra odakta kalır
      const e = Array.from(UI.pencere.querySelectorAll('[data-k]')).find((x) => x.dataset.k === odakK);
      if (e && !e.disabled) e.focus();
    }
  }

  // ═══════════════════════════════════════════════════════════════════════
  // TANI (+ E5 tarih alanları) ve rapor
  // ═══════════════════════════════════════════════════════════════════════
  function taniSatirlari() {
    const s = [];
    const model = !!D.modelId;
    let yon = t('tn_bilinmiyor');
    try { yon = (GM_info && GM_info.scriptHandler ? GM_info.scriptHandler + ' ' + (GM_info.version || '') : t('tn_bilinmiyor')); } catch (e) { /* yok */ }
    s.push(['v', t('tn_betik'), `${SURUM} · ${yon.trim()} · ${dil()} · ${t('t_' + etkinTema())}${AYAR.kapali ? ' · ' + t('o_kapali') : ''}`]);
    if (!model) {
      s.push(['b', t('tn_veri'), t('tn_modelDegil')]);
    } else if (D.tasarim) s.push(['v', t('tn_veri'), `${D.kaynak === 'onbellek' ? t('kn_onbellek') : D.kaynak} · ${t('tn_profilSay', { n: D.profil.size })}`]);
    else if (D.yukleniyor || !D.veriHata.length) s.push(['b', t('tn_veri'), t('tn_bekliyor')]);
    else s.push(['x', t('tn_veri'), D.veriHata.join(' · ')]);
    if (model) {
      const r = profilSatirlari();
      const es = r.filter((x) => satirVerisi(x)).length;
      if (!r.length) s.push(['b', t('tn_satir'), t('tn_bekliyor') + ' · span.config_title']);
      else s.push([D.tasarim && es < r.length ? 'x' : 'v', t('tn_satir'), t('tn_eslesti', { n: es, m: r.length }) + ' · span.config_title']);
      const c = sekmeCubugu();
      s.push(c ? ['v', t('tn_sekme'), t('tn_sekmeSay', { n: c.sekmeler.length }) + ' · .swiper-wrapper'] : ['b', t('tn_sekme'), t('tn_bekliyor') + ' · .swiper-wrapper']);
      s.push([D.sec.neden === 'vazgecti' ? 'x' : D.sec.neden === 'tamam' ? 'v' : 'b', t('tn_secim'), `${t('sn_' + D.sec.neden)}${D.sec.secilen ? ' · ' + D.sec.secilen : ''} · ${t('sn_deneme', { n: D.sec.deneme })}${D.sec.yol ? ' · ' + D.sec.yol : ''}`]);
      s.push([D.siralama === 'atlandi' ? 'x' : D.siralama === 'dogrulandi' ? 'v' : 'b', t('tn_sirala'), t('tn_' + (D.siralama === 'atlandi' ? 'atlandi' : D.siralama === 'dogrulandi' ? 'dogrulandi' : 'gerekmez'))]);
      s.push(D.cubukCapa ? ['v', t('tn_cubuk'), t('cp_' + D.cubukCapa)] : ['b', t('tn_cubuk'), t('tn_bekliyor')]);
    }
    if (AYAR.kartAc) {
      const k = KART.durum;
      s.push(k.n ? [k.h && !k.y ? 'x' : 'v', t('tn_kart'), t('tn_kartDurum', { n: k.n, y: k.y, h: k.h })] : ['b', t('tn_kart'), t('tn_kartYok')]);
    }
    if (istek.son) s.push(['b', t('tn_istek'), `${istek.son.yol} · ${istek.son.durum} · ${istek.son.adres.replace(/\/models\/[^/]+/, '/models/…')}`]);
    return s;
  }
  function tarihAlanlari() {
    const d = D.tasarim;
    const yok = t('dt_yok');
    if (!d) return [[t('dt_create'), yok]];
    const pt = (d.instances || []).map((i) => i.publishTime).filter(Boolean).sort();
    let site = yok;
    document.querySelectorAll('span').forEach((sp) => {
      if (site !== yok || sp.childElementCount || !RE_RELEASED.test(yazi(sp)) || sp.closest(`#${ONEK}-kok`)) return;
      const m = /(\d{4}-\d{2}-\d{2})/.exec(yazi(sp.parentElement && sp.parentElement.parentElement));
      if (m) site = m[1];
    });
    return [[t('dt_create'), tarih(d.createTime) || yok], [t('dt_update'), tarih(d.updateTime) || yok], [t('dt_site'), site],
      [t('dt_eski'), tarih(pt[0]) || yok], [t('dt_yeni'), tarih(pt[pt.length - 1]) || yok]];
  }
  function raporMetni() {
    const sat = [`${AD} ${SURUM} · ${t('b_tani')}`, new Date().toISOString().replace('T', ' ').slice(0, 19) + ' UTC', ''];
    taniSatirlari().forEach(([d, a, v]) => sat.push(`${d === 'v' ? '✓' : d === 'x' ? '✗' : '–'} ${a}: ${v}`));
    sat.push('', t('tn_tarih') + ':');
    tarihAlanlari().forEach(([a, v]) => sat.push(`  ${a}: ${v}`));
    const cevap = KABUL.filter((k) => UI.kabul[k] && UI.kabul[k].v === SURUM);
    if (cevap.length) {
      sat.push('', 'ELLE SONUÇ');
      KABUL.forEach((k) => { const c = UI.kabul[k]; if (!c || c.v !== SURUM) return; sat.push(`${c.s === 'gecti' ? '✓' : c.s === 'sorun' ? '✗' : '–'} ${k.toUpperCase()} ${t(k)}${c.n ? ' · ' + c.n : ''}`); });
    }
    return sat.join('\n');
  }
  async function raporKopyala(bolum) {
    const m = raporMetni();
    try { if (typeof GM_setClipboard === 'function') { GM_setClipboard(m, 'text'); bildir(t('tn_kopyalandi')); return; } } catch (e) { /* sonraki */ }
    try { await navigator.clipboard.writeText(m); bildir(t('tn_kopyalandi')); return; } catch (e) { /* sonraki */ }
    const a = O('textarea', { readonly: true, 'aria-label': t('tn_kopya') }); a.value = m;
    bolum.append(a); a.focus(); a.select(); bildir(t('tn_kopyaYok'));
  }

  // ═══════════════════════════════════════════════════════════════════════
  // KISAYOL (platform-userscript §2.8)
  // ═══════════════════════════════════════════════════════════════════════
  function tusKombo(e) {
    if (e.getModifierState && e.getModifierState('AltGraph')) return null;
    if (e.ctrlKey && e.altKey) return null;
    let ad = null;
    const k = e.key || '';
    if (/^Key[A-Z]$/.test(e.code || '')) ad = e.code.slice(3);
    else if (/^Digit\d$/.test(e.code || '')) ad = e.code.slice(5);
    else if (k.length === 1 && k.trim()) {
      const u = k === '+' ? 'Plus' : k.toLocaleUpperCase('en-US');
      // Türkçe Q'da noktalı i (Quote) 'I' üretir; KeyI ile karışmasın diye fiziksel kod kullanılır
      ad = /^[A-Z]$/.test(u) && e.code ? e.code : u;
    } else if (/^F\d{1,2}$/.test(k)) ad = k;
    if (!ad) return null;
    // Cmd (Meta) Ctrl sayılır; değiştirici sırası her zaman Ctrl, Alt, Shift
    return (e.ctrlKey || e.metaKey ? 'Ctrl+' : '') + (e.altKey ? 'Alt+' : '') + (e.shiftKey ? 'Shift+' : '') + ad;
  }
  function komboKanonikMi(v) {
    const m = /^(Ctrl\+)?(Alt\+)?(Shift\+)?([^+]+|Plus)$/.exec(String(v));
    if (!m || !(m[1] || m[2])) return false;
    if (m[1] && m[2]) return false;
    const tus = m[4];
    if (/\s|[\x00-\x1f]/.test(tus)) return false;
    if ([...tus].length === 1) return tus === tus.toLocaleUpperCase('en-US');
    return /^(F\d{1,2}|Plus)$/.test(tus);
  }
  const YASAK = new Set(['Ctrl+T', 'Ctrl+W', 'Ctrl+N', 'Ctrl+L', 'Ctrl+R', 'Ctrl+F', 'Ctrl+P', 'Ctrl+D', 'Ctrl+S', 'Ctrl+O', 'Ctrl+H', 'Ctrl+J',
    'Ctrl+U', 'Ctrl+K', 'Ctrl+E', 'Ctrl+G', 'Ctrl+Q', 'Ctrl+A', 'Ctrl+C', 'Ctrl+V', 'Ctrl+X', 'Ctrl+Z', 'Ctrl+Y', 'Ctrl+Plus', 'Ctrl+-', 'Ctrl+0',
    'Ctrl+Shift+T', 'Ctrl+Shift+N', 'Ctrl+Shift+W', 'Ctrl+Shift+I', 'Ctrl+Shift+J', 'Ctrl+Shift+C', 'Ctrl+Shift+B', 'Ctrl+Shift+O',
    'Ctrl+Shift+Q', 'Ctrl+Shift+R', 'Ctrl+Shift+Delete', 'Alt+D', 'Alt+F4', 'Alt+Home', 'Ctrl+F4', 'Ctrl+F5',
    // düzenleme ve Firefox tuşları (3.12.0 inceleme)
    'Ctrl+B', 'Ctrl+I', 'Ctrl+M', 'Ctrl+=', 'Ctrl+Shift+P', 'Ctrl+Shift+A', 'Ctrl+Shift+E', 'Ctrl+Shift+K', 'Ctrl+Shift+M',
    'Ctrl+Shift+S', 'Ctrl+Shift+Y', 'Ctrl+Shift+H', 'Ctrl+Shift+D', 'Ctrl+Shift+Z', 'Ctrl+Shift+V',
    'Alt+F', 'Alt+E', 'Alt+V', 'Alt+S', 'Alt+B', 'Alt+T', 'Alt+H']);
  function yasakMi(k) {
    const n = String(k);
    if (YASAK.has(n)) return true;
    if (/^Ctrl\+\d$/.test(n)) return true;
    return !komboKanonikMi(k);
  }
  function tusDinle(e) {
    if (e.repeat || e.isComposing) return;
    const k = tusKombo(e);
    if (!k) return;
    if (k !== AYAR.kisayol.ayarlar) return;
    e.preventDefault(); e.stopPropagation();
    ayarlariAc();
  }

  // ═══════════════════════════════════════════════════════════════════════
  // TAMPERMONKEY MENÜSÜ (dil değişince yeniden kayıt)
  // ═══════════════════════════════════════════════════════════════════════
  let menuKimlikleri = [], menuKayitli = false;
  function menuKaydet() {
    if (typeof GM_registerMenuCommand !== 'function') return;
    // Silinemeyen kayıt (kimlik yok ya da unregister yok) bir kez yapılır; dil değişince çift komut çıkmaz
    if (menuKayitli && (typeof GM_unregisterMenuCommand !== 'function' || !menuKimlikleri.length)) return;
    if (typeof GM_unregisterMenuCommand === 'function') menuKimlikleri.forEach((k) => { try { GM_unregisterMenuCommand(k); } catch (e) { /* yok */ } });
    try {
      const harf = dil() === 'tr' ? 'a' : 's';
      const id = GM_registerMenuCommand(t('m_ayarlar') + ' (' + harf.toUpperCase() + ')', () => ayarlariAc(), harf);
      menuKimlikleri = id != null ? [id] : [];
      menuKayitli = true;
    } catch (e) { hata('menü', e); }
  }

  // ═══════════════════════════════════════════════════════════════════════
  // DÖNGÜ — gecikmeli toplama + kendi değişikliklerini yok sayma (3.12.0: zaman penceresi yerine düğüm süzgeci)
  // ═══════════════════════════════════════════════════════════════════════
  const BEKLEME = 200;
  let zamanlayici = null, susturUntil = 0;
  const turGecmisi = [];
  const BIZIM = `[id^="${ONEK}"], [class*="${ONEK}"]`;
  function bizimOge(n) {
    if (!n) return false;
    const el = n.nodeType === 1 ? n : n.parentElement;
    if (!el) return false;
    return !!(el.closest && el.closest(BIZIM));
  }
  // Kayıt ya bizim öğemizin içinde olmuş ya da yalnız bizim düğümlerimizi eklemiş/silmiş olmalı
  function bizimKayit(k) {
    if (bizimOge(k.target)) return true;
    const d = [...k.addedNodes, ...k.removedNodes];
    return d.length > 0 && d.every((n) => (n.nodeType === 1 ? (n.id || '').indexOf(ONEK) === 0 || String(n.className || '').indexOf(ONEK) >= 0 : false));
  }
  function planla(hemen) {
    if (hemen) { clearTimeout(zamanlayici); zamanlayici = null; }
    if (zamanlayici) return;
    zamanlayici = setTimeout(() => { zamanlayici = null; tur(); }, hemen ? 0 : BEKLEME);
  }
  async function tur() {
    // Döngü bekçisi: 5 sn'de 25'ten çok tur → 2 sn sus (süzgeçten kaçan bir kendi değişikliğimize karşı)
    const simdi = Date.now();
    turGecmisi.push(simdi);
    while (turGecmisi.length && simdi - turGecmisi[0] > 5000) turGecmisi.shift();
    if (turGecmisi.length > 25) { susturUntil = simdi + 2000; turGecmisi.length = 0; gunluk('döngü bekçisi devrede'); }
    try { await turIc(); } catch (e) { hata('tur', e); }
  }
  async function turIc() {
    D.turSay = (D.turSay || 0) + 1;
    if (!document.body) return;
    sayfaStiliEkle();
    temaUygula();
    if (AYAR.kapali) return;
    if (location.href !== D.adres) { D.adres = location.href; }
    const m = location.pathname.match(MODEL_YOLU);
    const slug = m ? m[1] : null;
    const id = slug ? (slug.match(/^\d+/) || [null])[0] : null;
    if (id !== D.modelId) {
      D.slug = slug; D.modelId = id; D.tasarim = null; D.kaynak = null; D.veriHata = [];
      D.sec = yeniSecim(); D.ilkAcildi = false; D.bilgi = null; D.siralama = 'gerekmez'; D.cubukCapa = null;
      D.profil.clear(); D.baslik.clear(); D.secMat.clear();
      if (!AYAR.hatirla) D.filtre = '';
      D.vsrt = AYAR.vsrt;
      if (cubuk) { cubuk.remove(); cubuk = null; }
      if (id && !D.yukleniyor) {
        D.yukleniyor = true;
        try { const t0 = await tasarimAl(slug, id); if (t0 && D.modelId === id) tasarimIsle(t0); }
        finally {
          D.yukleniyor = false;
          // Yükleme sürerken başka modele geçildiyse o model yüklenmemiş kaldı: sonraki tur baştan kursun
          if (D.modelId !== id) D.modelId = null;
          planla();
        }
        if (D.modelId !== id) return;
      }
    }
    if (id) {
      const c = sekmeCubugu();
      if (c) {
        try { sekmeleriSirala(c); } catch (e) { hata('sekme', e); }
        try { otoSec(c); } catch (e) { hata('seçim', e); }
        try { bilgiHesapla(c); } catch (e) { hata('bilgi', e); }
        if (!D.sec.bitti && AYAR.oto) planla();
      }
      try { satirlariSusle(); } catch (e) { hata('rozet', e); }
      try { if (AYAR.kutu || AYAR.srt || AYAR.cip) { cubukBagla(); cipleriKur(); } else if (cubuk) { cubuk.remove(); cubuk = null; } } catch (e) { hata('çubuk', e); }
      try { sirala(); } catch (e) { hata('sıralama', e); }
      try { suz(); } catch (e) { hata('filtre', e); }
    }
    try { kartlariIsle(); } catch (e) { hata('kart', e); }
  }

  function basla() {
    sayfaStiliEkle();
    uiKur();
    temaUygula();
    menuKaydet();
    D.vsrt = AYAR.vsrt;
    document.addEventListener('keydown', tusDinle, true);
    new MutationObserver((kayitlar) => { if (Date.now() < susturUntil) return; if (kayitlar.every(bizimKayit)) return; planla(); }).observe(document.documentElement, { childList: true, subtree: true });
    window.addEventListener('popstate', () => planla());
    window.addEventListener('load', () => planla());
    setInterval(() => { if (location.href !== D.adres || (!D.sec.bitti && AYAR.oto && D.modelId && !AYAR.kapali)) planla(); }, 2000);
    planla(true);
    // Test kancası: yalnız test düzeneğinde (platform-userscript §4.3)
    let testMi = false;
    try { testMi = typeof GM_info === 'object' && GM_info && GM_info.scriptHandler === 'Test'; } catch (e) { testMi = false; }
    const kanca = window.__AALABS_TEST__;
    if (testMi && kanca && typeof kanca === 'object') {
      kanca.mwx = { kok: () => UI.kok, ayar: () => AYAR, durum: () => D, tani: taniSatirlari, rapor: raporMetni, ac: ayarlariAc, tur: () => tur(), kart: () => KART, metin: METIN, kombo: tusKombo, yasak: yasakMi, dogrula };
    }
  }

  AYAR = ayarYukle();
  D.vsrt = AYAR.vsrt;
  D.filtre = AYAR.hatirla ? String(depoOku('filtre', '') || '') : '';
  sayfaStiliEkle();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', basla, { once: true });
  else basla();
}());
