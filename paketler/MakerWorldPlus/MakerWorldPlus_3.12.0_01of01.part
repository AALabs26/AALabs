// ==UserScript==
// @name         AALabs MakerWorld Plus
// @namespace    aalabs
// @version      3.12.0
// @description  MakerWorld baskı profillerinde filament, renk, gramaj ve yazıcı uyumunu satırda gösterir; tercih edilen yazıcıyı seçer, profilleri süzer ve sıralar.
// @author       AALabs
// @match        https://makerworld.com/*
// @match        https://*.makerworld.com/*
// @icon         data:image/png;base64,
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_unregisterMenuCommand
// @grant        GM_setClipboard
// @grant        GM_info
// @grant        unsafeWindow
// @run-at       document-start
// @noframes
// @aalabs-ikon  MWX
// ==/UserScript==

