  // ═══════════════════════════════════════════════════════════════════════
  // SABİTLER
  // ═══════════════════════════════════════════════════════════════════════
  const YAZICI = /^(all|t[uü]m[uü]|全部|x1\s?carbon|x1e|x1|x2d|p1p|p1s|p2s|a1\s?mini|a1|a2l|h2d\s?pro|h2d|h2s|h2c|h2)$/i;
  const HEPSI = /^(all|t[uü]m[uü]|全部)$/i;
  const YAZICI_LISTE = ['P2S', 'A1', 'A1 mini', 'P1S', 'P1P', 'X1 Carbon', 'X1', 'X1E', 'X2D', 'H2D', 'H2D Pro', 'H2S', 'H2C', 'A2L'];
  const HAZNE = /^(abs|asa|pc|pa|paht|ppa|pp|pet-?cf|pa-?cf|pps)/i;
  const MODEL_YOLU = /\/models\/([^/?#]+)/;
  const KAPAK_PROFIL = /\/model\/[^/]+\/(\d+)\/instance\//;
  const RE_RELEASED = /^(released|yayınlandı|yayın)/i;
  const ALANLAR = ['filaments', 'colors', 'weight', 'nozzle', 'ams', 'released', 'compat', 'settings', 'plates', 'printers'];
  const SIRALAR = ['default', 'newest', 'oldest', 'downloads', 'rating'];
  const MALZEMELER = ['PLA', 'PETG', 'ABS', 'ASA', 'TPU', 'PC', 'PA'];
  const KABUL = ['kb1', 'kb2', 'kb3', 'kb4', 'kb5'];

  const VARSAYILAN = {
    sira: ['P2S', 'A1'], oto: true, url: true, ilk: false, bilgi: true,
    alan: ['filaments', 'colors', 'weight', 'nozzle', 'ams', 'released', 'compat'], hazne: true, noz: 0.4,
    stil: 'blur', net: true, sona: true,
    kutu: true, hatirla: false, cip: true, gizli: [], srt: true, vsrt: 'default',
    kartAc: true, kartUyum: true, kartGor: true,
    bekle: 600, aralik: 350, deneme: 40, sure: 30, onbellek: 10, gunluk: false, kapali: false,
    tema: 'sayfa', dil: 'tarayici', olcek: 100,
    kisayol: { ayarlar: 'Ctrl+,' },
  };

  // ═══════════════════════════════════════════════════════════════════════
  // DEPO (GM) ve ayar doğrulama
  // ═══════════════════════════════════════════════════════════════════════
  const GM_VAR = typeof GM_getValue === 'function' && typeof GM_setValue === 'function';
  const bellek = {};
  function depoOku(k, v) {
    try { if (GM_VAR) { const x = GM_getValue(k); return x === undefined ? v : x; } } catch (e) { /* bellek */ }
    return k in bellek ? bellek[k] : v;
  }
  function depoYaz(k, v) {
    try { if (GM_VAR) { GM_setValue(k, v); return; } } catch (e) { /* bellek */ }
    bellek[k] = v;
  }

  const kopya = (o) => JSON.parse(JSON.stringify(o));
  const sayiAraligi = (v, en, ek, vars) => (typeof v === 'number' && isFinite(v) ? Math.min(ek, Math.max(en, v)) : vars);

  function dogrula(ham) {
    const a = kopya(VARSAYILAN);
    if (!ham || typeof ham !== 'object' || Array.isArray(ham)) return a;
    const bool = (k) => { if (typeof ham[k] === 'boolean') a[k] = ham[k]; };
    ['oto', 'url', 'ilk', 'bilgi', 'hazne', 'net', 'sona', 'kutu', 'hatirla', 'cip', 'srt', 'kartAc', 'kartUyum', 'kartGor', 'gunluk', 'kapali'].forEach(bool);
    if (Array.isArray(ham.sira)) {
      const s = [];
      ham.sira.forEach((p) => {
        if (typeof p !== 'string' || !YAZICI.test(p.trim()) || HEPSI.test(p.trim()) || s.some((x) => esYazici(x, p))) return;
        s.push(YAZICI_LISTE.find((y) => esYazici(y, p)) || p.trim().toUpperCase());
      });
      if (s.length) a.sira = s.slice(0, 6);
    }
    if (Array.isArray(ham.alan)) a.alan = ALANLAR.filter((x) => ham.alan.indexOf(x) >= 0);
    if (Array.isArray(ham.gizli)) a.gizli = MALZEMELER.filter((x) => ham.gizli.some((g) => String(g).toUpperCase() === x));
    if ([0.2, 0.4, 0.6, 0.8].indexOf(Number(ham.noz)) >= 0) a.noz = Number(ham.noz);
    if (['blur', 'dim', 'hide', 'none'].indexOf(ham.stil) >= 0) a.stil = ham.stil;
    if (SIRALAR.indexOf(ham.vsrt) >= 0) a.vsrt = ham.vsrt;
    if (['sayfa', 'acik', 'koyu'].indexOf(ham.tema) >= 0) a.tema = ham.tema;
    if (['tarayici', 'tr', 'en'].indexOf(ham.dil) >= 0) a.dil = ham.dil;
    if ([90, 100, 115, 130].indexOf(ham.olcek) >= 0) a.olcek = ham.olcek;
    a.bekle = sayiAraligi(ham.bekle, 0, 5000, a.bekle);
    a.aralik = sayiAraligi(ham.aralik, 100, 5000, a.aralik);
    a.deneme = Math.round(sayiAraligi(ham.deneme, 1, 200, a.deneme));
    a.sure = sayiAraligi(ham.sure, 3, 300, a.sure);
    a.onbellek = sayiAraligi(ham.onbellek, 0, 1440, a.onbellek);
    if (ham.kisayol && typeof ham.kisayol.ayarlar === 'string' && komboKanonikMi(ham.kisayol.ayarlar) && !yasakMi(ham.kisayol.ayarlar)) {
      a.kisayol.ayarlar = ham.kisayol.ayarlar;
    }
    return a;
  }

  // MWFX 3.x ayarları sayfanın localStorage'ındaydı; bir kez okunup taşınır.
  function eskiAyarlariTasi() {
    if (depoOku('tasindi', false)) return null;
    let eski = null;
    try { eski = JSON.parse(localStorage.getItem('mwfx.cfg.v31') || localStorage.getItem('mwfx.cfg.v3') || 'null'); } catch (e) { return null; }
    // İşaret yalnız eski kayıt gerçekten okununca yazılır (depolama kapalı ya da başka alt alan adı → sonra yine denenir)
    if (!eski || typeof eski !== 'object') return null;
    depoYaz('tasindi', true);
    const y = {
      sira: eski.preferredPrinters, oto: eski.autoSelectPrinter, ilk: eski.autoSelectFirstProfile, url: eski.respectUrlProfile,
      alan: eski.showBadges === false ? [] : eski.badgeFields, hazne: eski.warnEnclosure, noz: eski.warnNozzle,
      stil: eski.incompatibleStyle, net: eski.revealOnHover, srt: eski.showSort,
      vsrt: eski.sortMode, kutu: eski.showFilter, cip: eski.showMaterialChips, gizli: eski.hideMaterials,
      hatirla: eski.persistFilter, gunluk: eski.debug, kapali: eski.enabled === false,
      bekle: eski.selectStableMs, aralik: eski.selectRetryMs, deneme: eski.selectMaxTries,
      sure: typeof eski.selectTimeoutMs === 'number' ? eski.selectTimeoutMs / 1000 : undefined,
      onbellek: typeof eski.cacheTtlMs === 'number' ? eski.cacheTtlMs / 60000 : undefined,
    };
    try { const f = localStorage.getItem('mwfx.filter'); if (f && eski.persistFilter) depoYaz('filtre', f); } catch (e) { /* yok */ }
    return dogrula(y);
  }

  // Yükleme dosyanın sonunda (ayarYukle): yardımcı sabitler (sade, YASAK) o noktada tanımlı olur.
  let AYAR = null;
  function ayarYukle() {
    const tasinan = eskiAyarlariTasi();
    if (tasinan) { depoYaz('ayar', tasinan); return tasinan; }
    return dogrula(depoOku('ayar', null));
  }
  function ayarKaydet() { depoYaz('ayar', AYAR); }

  // ═══════════════════════════════════════════════════════════════════════
  // DİL, GÜNLÜK
  // ═══════════════════════════════════════════════════════════════════════
  function tarayiciDili() { return /^tr\b/i.test((navigator.languages && navigator.languages[0]) || navigator.language || '') ? 'tr' : 'en'; }
  function dil() { return AYAR.dil === 'tarayici' ? tarayiciDili() : AYAR.dil; }
  function t(k, d) {
    let s = (METIN[dil()] && METIN[dil()][k]) || METIN.tr[k] || k;
    if (d) s = s.replace(/\{(\w+)\}/g, (m, x) => (x in d ? d[x] : m));
    return s;
  }
  function gunluk(...a) { if (AYAR.gunluk) console.log('[MWX]', ...a); }
  function hata(yer, e) { console.error('[MWX] ' + yer + ' hatası:', e); }

  // ═══════════════════════════════════════════════════════════════════════
  // YARDIMCILAR
  // ═══════════════════════════════════════════════════════════════════════
  const yazi = (el) => ((el && el.textContent) || '').replace(/\s+/g, ' ').trim();
  const sade = (s) => String(s || '').toLowerCase().replace(/[\s\-_]/g, '');
  function esYazici(a, b) { return sade(a) === sade(b); }
  const katla = (s) => String(s).toLocaleLowerCase('tr-TR').replace(/ı/g, 'i');
  const tarih = (iso) => {
    const d = new Date(iso); if (!iso || isNaN(d)) return null;
    const p = (n) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
  };

  function ekle(el, cocuklar) {
    for (const c of [cocuklar].flat(Infinity)) {
      if (c == null || c === false) continue;
      el.append(c instanceof Node ? c : document.createTextNode(String(c)));
    }
    return el;
  }
  function ogeKur(etiket, ozellik, ...cocuk) {
    const el = document.createElement(etiket);
    for (const k in (ozellik || {})) {
      const v = ozellik[k];
      if (v == null || v === false) continue;
      if (k === 'class') el.className = v;
      else if (k === 'text') el.textContent = v;
      else if (k.slice(0, 2) === 'on' && typeof v === 'function') el.addEventListener(k.slice(2), v);
      else el.setAttribute(k, v === true ? '' : String(v));
    }
    return ekle(el, cocuk);
  }
  const O = ogeKur;

  function css(el, obj) {
    if (!el) return;
    for (const k in obj) {
      const p = k.replace(/[A-Z]/g, (m) => '-' + m.toLowerCase());
      if (el.style.getPropertyValue(p) !== obj[k] || el.style.getPropertyPriority(p) !== 'important') el.style.setProperty(p, obj[k], 'important');
    }
  }
  function cssSil(el, liste) { if (el) liste.forEach((k) => el.style.removeProperty(k.replace(/[A-Z]/g, (m) => '-' + m.toLowerCase()))); }

  // Sayfa bağlamı: Firefox'ta Tampermonkey'in fetch'i moz-extension kökenli gider (platform-userscript §2.11)
  const SAYFA = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
  function sayfayaKopya(o) { try { if (typeof cloneInto === 'function') return cloneInto(o, SAYFA); } catch (e) { /* düz */ } return o; }
  const FETCH_YOLLARI = [];
  try { if (SAYFA !== window && typeof SAYFA.fetch === 'function') FETCH_YOLLARI.push(['sayfa', (u, i) => SAYFA.fetch(u, sayfayaKopya(i))]); } catch (e) { /* yok */ }
  try { if (typeof content !== 'undefined' && content && typeof content.fetch === 'function') FETCH_YOLLARI.push(['content', (u, i) => content.fetch(u, sayfayaKopya(i))]); } catch (e) { /* yok */ }
  FETCH_YOLLARI.push(['betik', (u, i) => fetch(u, i)]);

  const istek = { son: null };
  async function jsonAl(url) {
    let sonHata = null;
    for (const [ad, fn] of FETCH_YOLLARI) {
      try {
        const r = await fn(url, { credentials: 'include', headers: { Accept: 'application/json' } });
        istek.son = { yol: ad, durum: r.status, adres: url.replace(location.origin, '').split('?')[0] };
        // Sunucu cevap verdiyse (404/429 …) başka yoldan aynı istek yinelenmez
        if (!r.ok) throw Object.assign(new Error(String(r.status)), { sunucu: true });
        return JSON.parse(await r.text());
      } catch (e) {
        if (e && e.sunucu) throw e;
        sonHata = e; istek.son = { yol: ad, durum: 'hata', adres: url.replace(location.origin, '').split('?')[0] };
      }
    }
    throw sonHata || new Error('istek');
  }
  function onbellekAl(k) {
    try {
      const o = JSON.parse(sessionStorage.getItem(ONEK + ':' + k) || 'null');
      return o && Date.now() - o.t < AYAR.onbellek * 60000 ? o.v : null;
    } catch (e) { return null; }
  }
  function onbellekYaz(k, v) {
    const ham = JSON.stringify({ t: Date.now(), v });
    try { sessionStorage.setItem(ONEK + ':' + k, ham); return; } catch (e) { /* kota: eskileri sil, bir kez daha dene */ }
    try {
      const bizim = [];
      for (let i = 0; i < sessionStorage.length; i++) {
        const a = sessionStorage.key(i);
        if (a && a.indexOf(ONEK + ':') === 0) { let z = 0; try { z = JSON.parse(sessionStorage.getItem(a)).t || 0; } catch (e) { /* bozuk */ } bizim.push([z, a]); }
      }
      bizim.sort((x, y) => x[0] - y[0]).slice(0, Math.max(1, Math.ceil(bizim.length / 2))).forEach((x) => sessionStorage.removeItem(x[1]));
      sessionStorage.setItem(ONEK + ':' + k, ham);
    } catch (e) { /* yine sığmadı: önbelleksiz devam */ }
  }
  function nextVeri() {
    const el = document.getElementById('__NEXT_DATA__');
    if (!el) return null;
    try { return JSON.parse(el.textContent); } catch (e) { return null; }
  }

  // React'in kendi onClick'i: Firefox'ta sayfa nesnesi wrappedJSObject arkasında (Xray)
  function reactTikla(el) {
    let n = el;
    for (let d = 0; d < 4 && n; d++, n = n.parentElement) {
      const s = n.wrappedJSObject || n;
      let anahtarlar = [];
      try { anahtarlar = Object.keys(s); } catch (e) { anahtarlar = []; }
      for (const k of anahtarlar) {
        if (k.indexOf('__reactProps$') !== 0) continue;
        const p = s[k];
        if (p && typeof p.onClick === 'function') {
          try {
            let sahte = { type: 'click', bubbles: true, isTrusted: false, defaultPrevented: false, nativeEvent: {},
              preventDefault() {}, stopPropagation() {}, persist() {} };
            try { if (typeof cloneInto === 'function') sahte = cloneInto(sahte, SAYFA, { cloneFunctions: true }); } catch (e) { /* düz nesne */ }
            const yaz = sahte.wrappedJSObject || sahte;
            yaz.currentTarget = s; yaz.target = s;
            p.onClick(sahte); return true;
          } catch (e) { gunluk('react onClick', e); return false; }
        }
      }
    }
    return false;
  }

  // ═══════════════════════════════════════════════════════════════════════
  // TEMA ve SAYFA STİLİ
  // ═══════════════════════════════════════════════════════════════════════
  function sayfaKoyuMu() {
    const renk = (el) => { try { return el ? getComputedStyle(el).backgroundColor : ''; } catch (e) { return ''; } };
    let r = renk(document.body);
    if (!r || /rgba\(0, 0, 0, 0\)|transparent/.test(r)) r = renk(document.documentElement);
    const m = /rgba?\((\d+),\s*(\d+),\s*(\d+)/.exec(r || '');
    if (!m) return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    const [R, G, B] = [m[1], m[2], m[3]].map(Number);
    return (0.2126 * R + 0.7152 * G + 0.0722 * B) / 255 < 0.45;
  }
  function etkinTema() { return AYAR.tema === 'sayfa' ? (sayfaKoyuMu() ? 'koyu' : 'acik') : AYAR.tema; }
  function temaUygula() {
    const tm = etkinTema();
    const kok = document.documentElement;
    if (kok && kok.getAttribute('data-' + ONEK + '-tema') !== tm) kok.setAttribute('data-' + ONEK + '-tema', tm);
    if (UI.host && UI.host.getAttribute('data-tema') !== tm) UI.host.setAttribute('data-tema', tm);
  }

  function sayfaStiliEkle() {
    const yer = document.head || document.documentElement;
    if (!yer || document.getElementById(ONEK + '-stil')) return;
    const s = document.createElement('style');
    s.id = ONEK + '-stil';
    s.textContent = `
/* TOKEN-BASLA — AALabs tasarım dili 1.4.1 (aalabs-tema.css'ten) */
html[data-${ONEK}-tema="acik"]{--${ONEK}-roz:#EEF2F5;--${ONEK}-roz-kenar:#C2D0DA;--${ONEK}-metin:#17252E;--${ONEK}-ikincil:#4E6269;
  --${ONEK}-basari:#18763F;--${ONEK}-basari-bg:#E4F5E8;--${ONEK}-uyari:#9A5B00;--${ONEK}-uyari-bg:#FDF6D8;--${ONEK}-hata:#C4313B;--${ONEK}-hata-bg:#FDE8E8;
  --${ONEK}-ana:#2456D6;--${ONEK}-ana-acik:#E5EBFA;--${ONEK}-vurgu:#2456D6;--${ONEK}-kenar:#7A9199;--${ONEK}-ayirici:#D3DEE6;--${ONEK}-golge:rgba(23,37,46,.18)}
html[data-${ONEK}-tema="koyu"]{--${ONEK}-roz:#1F2937;--${ONEK}-roz-kenar:#3A475A;--${ONEK}-metin:#E6ECF5;--${ONEK}-ikincil:#9AA8BC;
  --${ONEK}-basari:#4CC38A;--${ONEK}-basari-bg:#13301F;--${ONEK}-uyari:#E8AC45;--${ONEK}-uyari-bg:#33270F;--${ONEK}-hata:#FF8189;--${ONEK}-hata-bg:#3A161A;
  --${ONEK}-ana:#2456D6;--${ONEK}-ana-acik:#1D2C4F;--${ONEK}-vurgu:#86A8FF;--${ONEK}-kenar:#6A7B93;--${ONEK}-ayirici:#263142;--${ONEK}-golge:rgba(0,0,0,.4)}
html[data-${ONEK}-tema]{--${ONEK}-maske:linear-gradient(90deg,#000 0%,rgba(0,0,0,.55) 45%,rgba(0,0,0,.18) 100%)}
/* TOKEN-BITIR */
.${ONEK}-rozetler{display:flex;flex-wrap:wrap;gap:5px;align-items:center;margin:5px 0 0;font-size:11px;line-height:18px;width:100%;color:var(--${ONEK}-metin)}
.${ONEK}-roz{display:inline-flex;align-items:center;gap:4px;padding:0 7px;height:18px;border:1px solid var(--${ONEK}-roz-kenar);border-radius:9px;
  background:var(--${ONEK}-roz);white-space:nowrap;font-weight:500;color:var(--${ONEK}-metin)}
.${ONEK}-roz b{font-weight:600;color:var(--${ONEK}-ikincil);font-size:9.5px;letter-spacing:.4px;text-transform:uppercase}
.${ONEK}-ok{border-color:var(--${ONEK}-basari);color:var(--${ONEK}-basari);background:var(--${ONEK}-basari-bg)}
.${ONEK}-no{border-color:var(--${ONEK}-hata);color:var(--${ONEK}-hata);background:var(--${ONEK}-hata-bg)}
.${ONEK}-uyari{border-color:var(--${ONEK}-uyari);color:var(--${ONEK}-uyari);background:var(--${ONEK}-uyari-bg)}
.${ONEK}-yukleniyor{font-style:italic;color:var(--${ONEK}-ikincil)}
.${ONEK}-nokta{width:10px;height:10px;border-radius:50%;display:inline-block;border:1px solid var(--${ONEK}-kenar);flex:0 0 auto}
.${ONEK}-bulanik{filter:blur(1.6px) saturate(.45);opacity:.55;
  -webkit-mask-image:var(--${ONEK}-maske);mask-image:var(--${ONEK}-maske);transition:filter .15s,opacity .15s}
.${ONEK}-bulanik.${ONEK}-netles:hover,.${ONEK}-bulanik.${ONEK}-netles:focus-within{filter:none;opacity:1;-webkit-mask-image:none;mask-image:none}
.${ONEK}-soluk{opacity:.4}
.${ONEK}-gizli,.${ONEK}-suzuldu{display:none !important}
.${ONEK}-fav > div{box-shadow:inset 0 -2px 0 0 var(--${ONEK}-basari)}
.${ONEK}-cubuk{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:6px 0 2px;width:100%;color:var(--${ONEK}-metin)}
.${ONEK}-cubuk input{flex:1 1 180px;min-width:150px;height:28px;padding:0 9px;font:inherit;font-size:12px;color:inherit;
  background:var(--${ONEK}-roz);border:1px solid var(--${ONEK}-roz-kenar);border-radius:6px;outline:none}
.${ONEK}-cubuk input:focus,.${ONEK}-cubuk select:focus,.${ONEK}-cubuk button:focus-visible{outline:2px solid var(--${ONEK}-vurgu);outline-offset:1px}
.${ONEK}-cubuk input::placeholder{color:var(--${ONEK}-ikincil)}
.${ONEK}-cubuk select{flex:0 0 auto;height:28px;padding:0 6px;font:inherit;font-size:12px;color:inherit;background:var(--${ONEK}-roz);
  border:1px solid var(--${ONEK}-roz-kenar);border-radius:6px;cursor:pointer;max-width:190px}
.${ONEK}-dug{flex:0 0 auto;min-width:28px;height:28px;border:1px solid var(--${ONEK}-roz-kenar);border-radius:6px;background:var(--${ONEK}-roz);
  color:inherit;cursor:pointer;font:inherit;font-size:14px;line-height:1;display:inline-grid;place-items:center;position:relative;padding:0 6px}
.${ONEK}-dug svg{width:16px;height:16px}
.${ONEK}-dug[data-sorun="1"]::after{content:"";position:absolute;top:3px;right:3px;width:7px;height:7px;border-radius:50%;background:var(--${ONEK}-hata)}
.${ONEK}-sayac{flex:0 0 auto;font-size:11px;color:var(--${ONEK}-ikincil);font-variant-numeric:tabular-nums;white-space:nowrap}
.${ONEK}-cipler{flex:1 0 100%;width:100%;display:flex;flex-wrap:wrap;gap:5px;align-items:center;font-size:11px}
.${ONEK}-cipler:empty{display:none}
.${ONEK}-cip{display:inline-flex;align-items:center;gap:5px;height:22px;padding:0 9px;border-radius:11px;cursor:pointer;font:inherit;font-size:11px;
  font-weight:600;color:inherit;background:var(--${ONEK}-roz);border:1px solid var(--${ONEK}-roz-kenar)}
.${ONEK}-cip[aria-pressed="true"]{color:var(--${ONEK}-basari);border-color:var(--${ONEK}-basari);background:var(--${ONEK}-basari-bg)}
.${ONEK}-cip i{font-style:normal;color:var(--${ONEK}-ikincil);font-weight:500;font-size:10px}
.${ONEK}-cip[data-kapali="1"]{text-decoration:line-through;color:var(--${ONEK}-ikincil)}
.${ONEK}-bilgi{flex:1 0 100%;border:1px solid var(--${ONEK}-uyari);background:var(--${ONEK}-uyari-bg);color:var(--${ONEK}-metin);border-radius:4px;padding:5px 9px;font-size:12px}
.${ONEK}-bilgi[hidden]{display:none}
.${ONEK}-sirali > *{border-bottom:1px solid var(--${ONEK}-ayirici)}
.${ONEK}-kart{margin:6px 0 2px}
`;
    yer.appendChild(s);
  }

  // ═══════════════════════════════════════════════════════════════════════
  // DURUM
  // ═══════════════════════════════════════════════════════════════════════
  function yeniSecim() { return { bitti: false, deneme: 0, son: 0, imza: null, oturma: 0, bitis: 0, neden: 'bekliyor', secilen: null, yol: null }; }
  const D = {
    slug: null, modelId: null, tasarim: null, kaynak: null, veriHata: [],
    profil: new Map(), baslik: new Map(), sec: yeniSecim(), ilkAcildi: false, yukleniyor: false,
    siralama: 'gerekmez', siraliKap: null, cubukCapa: null, bilgi: null,
    filtre: '',
    secMat: new Set(), adres: location.href, vsrt: 'default',
  };

  // ═══════════════════════════════════════════════════════════════════════
  // VERİ
  // ═══════════════════════════════════════════════════════════════════════
  async function tasarimAl(slug, id) {
    const ck = 'tasarim:' + id;
    const ob = onbellekAl(ck);
    if (ob) { D.kaynak = 'onbellek'; return ob; }
    D.veriHata = [];
    const nd = nextVeri();
    const gomulu = nd && nd.props && nd.props.pageProps && nd.props.pageProps.design;
    if (gomulu && String(gomulu.id) === String(id)) { D.kaynak = '__NEXT_DATA__'; onbellekYaz(ck, gomulu); return gomulu; }
    D.veriHata.push('__NEXT_DATA__ —');
    if (nd && nd.buildId) {
      try {
        const j = await jsonAl(`${location.origin}/_next/data/${nd.buildId}/${nd.locale || 'en'}/models/${slug}.json?designId=${encodeURIComponent(slug)}`);
        const d = j && j.pageProps && j.pageProps.design;
        if (d && String(d.id) === String(id)) { D.kaynak = '_next/data'; onbellekYaz(ck, d); return d; }
      } catch (e) { D.veriHata.push('_next/data ' + e.message); }
    }
    try {
      const j = await jsonAl(`${location.origin}/api/v1/design-service/design/${id}`);
      const d = (j && j.design) || j;
      if (d && Array.isArray(d.instances)) { D.kaynak = 'API'; onbellekYaz(ck, d); return d; }
    } catch (e) { D.veriHata.push('API ' + e.message); }
    return null;
  }

  function profilOzeti(inst) {
    const mi = (inst.extention && inst.extention.modelInfo) || {};
    const fl = (Array.isArray(inst.instanceFilaments) ? inst.instanceFilaments : []).filter((f) => f && typeof f === 'object');
    const mats = [], renkler = [];
    fl.forEach((f) => {
      const m = String(f.type || '').trim();
      if (m && mats.indexOf(m) < 0) mats.push(m);
      String(f.color || '').split(/[,;\s]+/).forEach((c) => {
        if (/^#?[0-9a-f]{6}$/i.test(c)) { const h = '#' + c.replace('#', '').toUpperCase(); if (renkler.indexOf(h) < 0) renkler.push(h); }
      });
    });
    const yaz = [];
    if (mi.compatibility && mi.compatibility.devProductName) yaz.push(mi.compatibility.devProductName);
    (Array.isArray(mi.otherCompatibility) ? mi.otherCompatibility : []).forEach((c) => { if (c && c.devProductName && yaz.indexOf(c.devProductName) < 0) yaz.push(c.devProductName); });
    const ps = mi.projectSettings || {};
    return {
      profileId: inst.profileId, baslik: inst.title, mats, renkler, yazicilar: yaz,
      gram: typeof inst.weight === 'number' ? inst.weight : null, ams: !!inst.needAms,
      nozzle: (mi.compatibility && mi.compatibility.nozzleDiameter) || null,
      plaka: Array.isArray(mi.plates) ? mi.plates.length : null,
      katman: ps.layerHeight || null, duvar: ps.wallLoops || null, dolgu: ps.sparseInfillDensity || null,
      yayin: inst.publishTime || inst.createTime || null,
      indirme: inst.downloadCount || 0, puanSay: inst.ratingCount || 0,
      puan: inst.ratingCount ? (inst.ratingScoreTotal || 0) / inst.ratingCount : 0,
      parca: fl.map((f) => ({ tur: f.type, g: f.usedG })),
    };
  }

  function tasarimIsle(t0) {
    D.tasarim = t0; D.profil.clear(); D.baslik.clear();
    (Array.isArray(t0.instances) ? t0.instances : []).filter((i) => i && typeof i === 'object').forEach((i) => {
      const o = profilOzeti(i);
      if (i.profileId) D.profil.set(String(i.profileId), o);
      if (i.title) D.baslik.set(String(i.title).trim(), o);
    });
    gunluk('profil:', D.profil.size, 'kaynak:', D.kaynak);
  }
  const uyumluMu = (o, y) => !!o && o.yazicilar.some((p) => esYazici(p, y));

  // ═══════════════════════════════════════════════════════════════════════
  // PROFİL SATIRLARI + ROZETLER
  // ═══════════════════════════════════════════════════════════════════════
  function profilSatirlari() {
    const out = [];
    document.querySelectorAll('span.config_title').forEach((s) => {
      const satir = s.closest('[aria-haspopup="true"]');
      if (!satir) return;
      let pid = null;
      const img = satir.querySelector('img[src*="/instance/"]');
      if (img) { const m = (img.getAttribute('src') || '').match(KAPAK_PROFIL); if (m) pid = m[1]; }
      out.push({ satir, baslikEl: s, baslik: yazi(s), pid });
    });
    return out;
  }
  const satirVerisi = (r) => (r.pid && D.profil.get(r.pid)) || D.baslik.get(r.baslik) || null;
  function bilgiSutunu(b) {
    let el = b.parentElement;
    for (let i = 0; i < 5 && el; i++) { if (el.querySelector('span.time')) return el; el = el.parentElement; }
    return b.parentElement && b.parentElement.parentElement;
  }
  function roz(etiket, deger, ek) {
    const s = O('span', { class: `${ONEK}-roz` + (ek ? ` ${ONEK}-${ek}` : '') });
    if (etiket) s.append(O('b', { text: etiket }));
    ekle(s, deger);
    return s;
  }
  function rozetKutusu(o) {
    const k = O('div', { class: `${ONEK}-rozetler` });
    const hedef = AYAR.sira[0];
    const uyum = uyumluMu(o, hedef);
    for (const a of AYAR.alan) {
      if (a === 'filaments' && o.mats.length) {
        k.append(roz('', o.parca.length > 1 ? o.parca.map((x) => `${x.tur} ${x.g}g`).join(' + ') : o.mats.join(' · ')));
        if (AYAR.hazne && o.mats.some((m) => HAZNE.test(m))) k.append(roz('', t('r_kapali'), 'uyari'));
      }
      if (a === 'colors' && o.renkler.length) {
        const w = O('span', { style: 'display:inline-flex;gap:3px' });
        o.renkler.slice(0, 10).forEach((c) => { const n = O('i', { class: `${ONEK}-nokta`, title: c }); n.style.background = c; w.append(n); });
        k.append(roz(o.renkler.length > 1 ? o.renkler.length + '×' : '', w));
      }
      if (a === 'weight' && o.gram != null && o.parca.length <= 1) k.append(roz('', Math.round(o.gram) + ' g'));
      if (a === 'nozzle' && o.nozzle) k.append(roz(t('r_nozzle'), o.nozzle + ' mm', Math.abs(o.nozzle - AYAR.noz) > 0.001 ? 'uyari' : ''));
      if (a === 'ams' && o.ams) k.append(roz('', 'AMS'));
      if (a === 'released' && o.yayin) { const d = tarih(o.yayin); if (d) { const r = roz(t('r_yayin'), d); r.title = t('r_yayinI', { d }); k.append(r); } }
      if (a === 'settings' && (o.katman || o.duvar || o.dolgu)) {
        const p = [];
        if (o.katman) p.push(o.katman + ' mm');
        if (o.duvar) p.push(t('r_duvar', { n: o.duvar }));
        if (o.dolgu) p.push(o.dolgu);
        k.append(roz('', p.join(' · ')));
      }
      if (a === 'plates' && o.plaka) k.append(roz('', t('r_plaka', { n: o.plaka })));
      if (a === 'printers' && o.yazicilar.length) k.append(roz(t('r_uyumlu'), o.yazicilar.slice(0, 8).join(' · ')));
      if (a === 'compat' && o.yazicilar.length) k.append(roz('', (uyum ? '✓ ' : '✗ ') + hedef, uyum ? 'ok' : 'no'));
    }
    return k;
  }
  function uyumsuzUygula(satir, uyum) {
    const s = AYAR.stil;
    satir.classList.toggle(`${ONEK}-bulanik`, s === 'blur' && !uyum);
    satir.classList.toggle(`${ONEK}-netles`, s === 'blur' && !uyum && AYAR.net);
    satir.classList.toggle(`${ONEK}-soluk`, s === 'dim' && !uyum);
    satir.classList.toggle(`${ONEK}-gizli`, s === 'hide' && !uyum);
  }
  function satirlariSusle() {
    if (!D.tasarim) return;
    profilSatirlari().forEach((r) => {
      const o = satirVerisi(r);
      if (!o) return;
      if (o.yazicilar.length) uyumsuzUygula(r.satir, uyumluMu(o, AYAR.sira[0]));
      const sut = bilgiSutunu(r.baslikEl);
      if (!sut) return;
      const imza = JSON.stringify([o.profileId, AYAR.alan, AYAR.sira[0], dil(), AYAR.hazne, AYAR.noz]);
      const eski = sut.querySelector(`:scope > .${ONEK}-rozetler`);
      if (eski && eski.dataset.imza === imza) return;
      if (eski) eski.remove();
      if (!AYAR.alan.length) return;
      const k = rozetKutusu(o);
      if (!k.childElementCount) return;
      k.dataset.imza = imza;
      sut.append(k);
    });
  }

  // ═══════════════════════════════════════════════════════════════════════
  // YAZICI SEKMELERİ
  // ═══════════════════════════════════════════════════════════════════════
  function sekmeCubugu() {
    for (const w of document.querySelectorAll('.swiper-wrapper')) {
      const s = Array.from(w.children).filter((c) => c.classList.contains('swiper-slide'));
      // Bütün slide'lar yazıcı adı (ya da All) olmalı; en az bir gerçek yazıcı (1–2 sekmeli modeller de)
      if (s.length && s.every((x) => YAZICI.test(yazi(x))) && s.some((x) => !HEPSI.test(yazi(x)))) return { sarici: w, sekmeler: s };
    }
    return null;
  }
  function sekmeleriSirala(c) {
    const n = AYAR.sira.length;
    let degisti = false;
    c.sekmeler.forEach((s, i) => {
      const y = yazi(s);
      const pi = AYAR.sira.findIndex((p) => esYazici(y, p));
      const sira = String(pi >= 0 ? pi : (HEPSI.test(y) ? n : n + 1 + i));
      if (s.style.order !== sira) { s.style.order = sira; degisti = true; }
      s.classList.toggle(`${ONEK}-fav`, pi >= 0);
    });
    if (degisti) { try { const sw = c.sarici.parentElement && (c.sarici.parentElement.wrappedJSObject || c.sarici.parentElement).swiper; if (sw) sw.update(); } catch (e) { /* yok */ } }
  }
  function tikla(sekme, deneme) {
    const zincir = [sekme.querySelector(':scope > div > div'), sekme.querySelector(':scope > div'), sekme].filter(Boolean);
    if (deneme < 3) {
      const el = zincir[deneme % zincir.length];
      const o = { bubbles: true, cancelable: true, view: window, button: 0, composed: true };
      ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'].forEach((tp) => { try { el.dispatchEvent(new MouseEvent(tp, o)); } catch (e) { /* yok */ } });
      return 'event';
    }
    for (const el of zincir) if (reactTikla(el)) return 'react';
    return '—';
  }
  function bilgiHesapla(c) {
    const ilk = AYAR.sira[0];
    if (c.sekmeler.some((s) => esYazici(yazi(s), ilk))) { D.bilgi = null; return; }
    const diger = AYAR.sira.slice(1).find((p) => c.sekmeler.some((s) => esYazici(yazi(s), p)));
    if (diger && AYAR.oto && D.sec.secilen === diger) D.bilgi = t('bl_yedek', { a: ilk, b: diger });
    else if (diger) D.bilgi = t('bl_yok', { a: ilk });
    else D.bilgi = AYAR.sira.length > 1 ? t('bl_hicbiri', { l: AYAR.sira.join(', ') }) : t('bl_yok', { a: ilk });
  }
  function otoSec(c) {
    const s = D.sec;
    if (!AYAR.oto || s.bitti) return;
    if (AYAR.url && /profileId[-=]\d+/.test(location.hash + location.search)) { s.bitti = true; s.neden = 'adres'; return; }
    if (document.readyState !== 'complete') { s.neden = 'yukleniyor'; return; }
    const imza = c.sekmeler.map(yazi).join('|');
    if (imza !== s.imza) { s.imza = imza; s.oturma = Date.now(); s.neden = 'oturuyor'; return; }
    if (Date.now() - s.oturma < AYAR.bekle) { s.neden = 'oturuyor'; return; }
    let sekme = null, istenen = null;
    for (const p of AYAR.sira) { const x = c.sekmeler.find((y) => esYazici(yazi(y), p)); if (x) { sekme = x; istenen = p; break; } }
    if (!s.bitis) s.bitis = Date.now() + AYAR.sure * 1000;
    if (!sekme) { if (Date.now() > s.bitis) { s.bitti = true; s.neden = 'sekmeYok'; } return; }
    if (sekme.querySelector('.selected')) {
      s.bitti = true; s.neden = 'tamam'; s.secilen = istenen;
      if (AYAR.ilk) { const mid = D.modelId; setTimeout(() => { if (D.modelId === mid) ilkProfiliAc(); }, 600); }
      return;
    }
    if (Date.now() > s.bitis || s.deneme >= AYAR.deneme) { s.bitti = true; s.neden = 'vazgecti'; return; }
    if (Date.now() - s.son < AYAR.aralik) return;
    s.son = Date.now();
    s.neden = 'deneniyor'; s.yol = tikla(sekme, s.deneme++);
  }
  function ilkProfiliAc() {
    if (D.ilkAcildi) return;
    const gizli = ['gizli', 'suzuldu', 'bulanik', 'soluk'].map((x) => `${ONEK}-${x}`);
    const hepsi = profilSatirlari();
    const kap = listeKabi(hepsi);
    const sira = (x) => { const o = kap && ogesi(x.satir, kap); const n = o ? parseInt(getComputedStyle(o).order, 10) : 0; return isNaN(n) ? 0 : n; };
    // Ekranda en üstte görünen (CSS order) uyumlu profil açılır
    const r = hepsi.filter((x) => !gizli.some((g) => x.satir.classList.contains(g))).map((x, i) => ({ x, i, o: sira(x) }))
      .sort((a, b) => a.o - b.o || a.i - b.i);
    if (!r.length) return;
    D.ilkAcildi = true;
    r[0].x.satir.click();
  }

  // ═══════════════════════════════════════════════════════════════════════
  // SIRALAMA (CSS order; DOM taşınmaz) — E2: uyumsuzlar sona
  // ═══════════════════════════════════════════════════════════════════════
  function listeKabi(r) {
    if (!r.length) return null;
    const zincir = (el) => { const o = []; let c = el; while (c) { o.push(c); c = c.parentElement; } return o; };
    const ilk = zincir(r[0].satir);
    if (r.length === 1) return ilk[1] ? ilk[1].parentElement : null;
    const kumeler = r.slice(1).map((x) => new Set(zincir(x.satir)));
    return ilk.find((n) => kumeler.every((k) => k.has(n))) || null;
  }
  function ogesi(satir, kap) { let c = satir; while (c && c.parentElement !== kap) c = c.parentElement; return c; }
  // Kap doğrulaması (3.11.1): aksiyon paneli, başlık ya da swiper içeren kap reddedilir; "see more" düğmesi sorun değil
  function profilListesiMi(kap, r) {
    if (!kap || r.length < 2) return false;
    if (kap.querySelector('span.primaryButton') || kap.querySelector('h1,h2,h3,h4,h5') || kap.querySelector('.swiper-wrapper')) return false;
    return Array.from(kap.children).filter((c) => c.querySelector('span.config_title')).length >= r.length;
  }
  function siraTemizle(kap) {
    if (!kap || !kap.dataset.mwxSirali) return;
    cssSil(kap, ['display', 'flexDirection']);
    kap.classList.remove(`${ONEK}-sirali`);
    Array.from(kap.children).forEach((c) => cssSil(c, ['order', 'display']));
    delete kap.dataset.mwxSirali;
  }
  function sirala() {
    const r = profilSatirlari();
    const kap = listeKabi(r);
    if (D.siraliKap && D.siraliKap !== kap) { siraTemizle(D.siraliKap); D.siraliKap = null; }
    if (!kap) { D.siralama = 'gerekmez'; return; }
    const uyumsuzVar = AYAR.sona && AYAR.stil !== 'hide' && r.some((x) => { const o = satirVerisi(x); return o && o.yazicilar.length && !uyumluMu(o, AYAR.sira[0]); });
    const gerek = D.vsrt !== 'default' || uyumsuzVar;
    if (!gerek) { siraTemizle(kap); D.siraliKap = null; D.siralama = 'gerekmez'; return; }
    if (!profilListesiMi(kap, r)) { siraTemizle(kap); D.siralama = 'atlandi'; return; }
    D.siralama = 'dogrulandi';
    D.siraliKap = kap;
    kap.dataset.mwxSirali = '1';
    kap.classList.add(`${ONEK}-sirali`);
    css(kap, { display: 'flex', flexDirection: 'column' });
    Array.from(kap.children).forEach((c) => {
      if (c.tagName === 'HR') { css(c, { display: 'none' }); return; }
      if (!c.querySelector('span.config_title')) css(c, { order: '9999' });
    });
    const anahtar = {
      default: () => 0,
      newest: (o) => (o && o.yayin ? -new Date(o.yayin).getTime() : null),
      oldest: (o) => (o && o.yayin ? new Date(o.yayin).getTime() : null),
      downloads: (o) => (o ? -o.indirme : null),
      rating: (o) => (o ? -(o.puan * 1000 + Math.min(o.puanSay, 999) / 1000) : null),
    }[D.vsrt] || (() => 0);
    const liste = r.map((x, i) => {
      const o = satirVerisi(x);
      const uy = !o || !o.yazicilar.length || uyumluMu(o, AYAR.sira[0]);
      return { oge: ogesi(x.satir, kap), k: anahtar(o), i, son: uyumsuzVar && !uy ? 1 : 0 };
    }).filter((x) => x.oge);
    liste.sort((a, b) => (a.son - b.son) || (a.k == null) - (b.k == null) || ((a.k || 0) - (b.k || 0)) || (a.i - b.i));
    liste.forEach((x, i) => css(x.oge, { order: String(i) }));
  }

  // ═══════════════════════════════════════════════════════════════════════
  // FİLTRE ÇUBUĞU (filtre, sıralama, dişli, çipler, bilgi satırı)
  // ═══════════════════════════════════════════════════════════════════════
  const IKON = {
    disli: 'M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z|C12 12 3',
    x: 'M18 6 6 18|M6 6l12 12',
    yukari: 'm18 15-6-6-6 6',
    asagi: 'm6 9 6 6 6-6',
  };
  function svg(ad) {
    const NS = 'http://www.w3.org/2000/svg';
    const s = document.createElementNS(NS, 'svg');
    ['viewBox:0 0 24 24', 'width:16', 'height:16', 'fill:none', 'stroke:currentColor', 'stroke-width:2', 'stroke-linecap:round', 'stroke-linejoin:round', 'aria-hidden:true']
      .forEach((x) => { const i = x.indexOf(':'); s.setAttribute(x.slice(0, i), x.slice(i + 1)); });
    IKON[ad].split('|').forEach((p) => {
      if (p[0] === 'C') { const [cx, cy, r] = p.slice(1).trim().split(' '); const c = document.createElementNS(NS, 'circle'); c.setAttribute('cx', cx); c.setAttribute('cy', cy); c.setAttribute('r', r); s.append(c); }
      else { const e = document.createElementNS(NS, 'path'); e.setAttribute('d', p); s.append(e); }
    });
    return s;
  }

  let cubuk = null;
  function filtreUyar(m) {
    const q = D.filtre.trim();
    if (!q) return true;
    const rx = q.match(/^\/(.*)\/([a-z]*)$/);
    if (rx) { try { return new RegExp(rx[1], rx[2] || 'i').test(m); } catch (e) { return true; } }
    const k = katla(m);
    for (const w of katla(q).split(/\s+/).filter(Boolean)) {
      if (w[0] === '-') { if (w.length > 1 && k.indexOf(w.slice(1)) >= 0) return false; }
      else if (k.indexOf(w) < 0) return false;
    }
    return true;
  }
  function malzemeUyar(o) {
    if (!o || !o.mats.length) return true;
    const m = o.mats.map((x) => x.toUpperCase());
    if (AYAR.gizli.length && m.every((x) => AYAR.gizli.indexOf(x) >= 0)) return false;
    return !D.secMat.size || m.some((x) => D.secMat.has(x));
  }
  function cubukKur() {
    const w = O('div', { class: `${ONEK}-cubuk`, id: `${ONEK}-cubuk`, 'data-dil': dil() });
    if (AYAR.kutu) {
      const g = O('input', { type: 'text', spellcheck: 'false', placeholder: t('fl_yer'), 'aria-label': t('fl_yer') });
      g.value = D.filtre;
      g.addEventListener('input', () => { D.filtre = g.value; if (AYAR.hatirla) depoYaz('filtre', D.filtre); suz(); });
      g.addEventListener('keydown', (e) => { e.stopPropagation(); if (e.key === 'Escape') { g.value = ''; D.filtre = ''; if (AYAR.hatirla) depoYaz('filtre', ''); suz(); } });
      const x = O('button', { type: 'button', class: `${ONEK}-dug`, title: t('fl_temizle'), 'aria-label': t('fl_temizle') }, svg('x'));
      x.addEventListener('click', () => { g.value = ''; D.filtre = ''; if (AYAR.hatirla) depoYaz('filtre', ''); suz(); g.focus(); });
      w.append(g, x, O('span', { class: `${ONEK}-sayac`, 'aria-live': 'polite' }));
    }
    if (AYAR.srt) {
      const s = O('select', { title: t('fl_sira'), 'aria-label': t('fl_sira') });
      SIRALAR.forEach((v) => s.append(O('option', { value: v, text: t('sr_' + (v === 'default' ? 'varsayilan' : v)) })));
      s.value = D.vsrt;
      s.addEventListener('change', () => { D.vsrt = s.value; sirala(); });
      w.append(s);
    }
    const disli = O('button', { type: 'button', class: `${ONEK}-dug ${ONEK}-disli`, title: t('ayarlarAc') + ' (' + AYAR.kisayol.ayarlar + ')', 'aria-label': t('ayarlarAc') }, svg('disli'));
    disli.addEventListener('click', () => ayarlariAc());
    w.append(disli);
    w.append(O('div', { class: `${ONEK}-cipler` }));
    w.append(O('div', { class: `${ONEK}-bilgi`, role: 'status', hidden: true }));
    return w;
  }
  function cubukCapasi() {
    const h = Array.from(document.querySelectorAll('h1,h2,h3,h4,h5')).find((x) => /print\s*profile|baskı\s*profil/i.test(yazi(x)));
    if (h) return { dugum: h, yer: 'sonra', ad: 'baslik' };
    const c = sekmeCubugu();
    if (c) {
      let n = c.sarici;
      for (let i = 0; i < 3 && n.parentElement; i++) { if (/swiper/i.test(n.className || '')) n = n.parentElement; else break; }
      return { dugum: n, yer: 'once', ad: 'sekme' };
    }
    const kap = listeKabi(profilSatirlari());
    return kap ? { dugum: kap, yer: 'once', ad: 'liste' } : null;
  }
  function cubukBagla() {
    const c = cubukCapasi();
    if (!c) { D.cubukCapa = null; return; }
    D.cubukCapa = c.ad;
    if (cubuk && cubuk.getAttribute('data-dil') !== dil()) { cubuk.remove(); cubuk = null; }
    if (!cubuk) cubuk = cubukKur();
    const yerinde = c.yer === 'sonra' ? cubuk.previousElementSibling === c.dugum : cubuk.nextElementSibling === c.dugum;
    if (!cubuk.isConnected || !yerinde) {
      if (c.yer === 'sonra') c.dugum.after(cubuk); else c.dugum.parentElement.insertBefore(cubuk, c.dugum);
    }
  }
  function cipleriKur() {
    if (!cubuk) return;
    const kap = cubuk.querySelector(`.${ONEK}-cipler`);
    if (!AYAR.cip) { kap.textContent = ''; kap.dataset.imza = ''; return; }
    const say = new Map();
    for (const o of D.profil.values()) new Set(o.mats.map((m) => m.toUpperCase())).forEach((m) => say.set(m, (say.get(m) || 0) + 1));
    const imza = Array.from(say.entries()).sort().map((e) => e.join(':')).join(',') + '|' + AYAR.gizli.join(',') + '|' + dil();
    if (kap.dataset.imza === imza) {
      kap.querySelectorAll(`.${ONEK}-cip`).forEach((c) => c.setAttribute('aria-pressed', D.secMat.has(c.dataset.mat) ? 'true' : 'false'));
      return;
    }
    kap.dataset.imza = imza; kap.textContent = '';
    Array.from(say.entries()).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).forEach(([m, n]) => {
      const kapali = AYAR.gizli.indexOf(m) >= 0;
      const c = O('button', { type: 'button', class: `${ONEK}-cip`, 'data-mat': m, 'aria-pressed': D.secMat.has(m) ? 'true' : 'false', title: kapali ? t('fl_cipGizli', { m }) : t('fl_cip', { m }) }, m, O('i', { text: String(n) }));
      if (kapali) c.dataset.kapali = '1';
      c.addEventListener('click', () => { if (D.secMat.has(m)) D.secMat.delete(m); else D.secMat.add(m); cipleriKur(); suz(); });
      kap.append(c);
    });
  }
  function suz() {
    const r = profilSatirlari();
    let gor = 0;
    r.forEach((x) => {
      const ok = filtreUyar(x.baslik) && malzemeUyar(satirVerisi(x));
      x.satir.classList.toggle(`${ONEK}-suzuldu`, !ok);
      if (ok) gor++;
    });
    if (cubuk) {
      const s = cubuk.querySelector(`.${ONEK}-sayac`);
      const v = (D.filtre.trim() || D.secMat.size || AYAR.gizli.length) ? `${gor} / ${r.length}` : '';
      if (s && s.textContent !== v) s.textContent = v;
      const b = cubuk.querySelector(`.${ONEK}-bilgi`);
      if (b) { const m = AYAR.bilgi ? D.bilgi : null; b.hidden = !m; if (m && b.textContent !== m) b.textContent = m; }
      const d = cubuk.querySelector(`.${ONEK}-disli`);
      if (d) d.setAttribute('data-sorun', taniSatirlari().some((x) => x[0] === 'x') ? '1' : '0');
    }
  }

  // ═══════════════════════════════════════════════════════════════════════
  // E4 — MODEL KARTLARI (arama, kategori, profil sayfaları)
  // Kart: /models/<id> bağlantısı ve görseli olan en geniş ortak kap.
  // ═══════════════════════════════════════════════════════════════════════
  const KART = { veri: new Map(), kuyruk: [], calisan: 0, gozcu: null, durum: { n: 0, y: 0, h: 0 } };
  const kartModelId = (a) => { const m = (a.getAttribute('href') || '').match(/\/models\/(\d+)(?:-([^/?#]*))?/); return m ? { id: m[1], slug: m[1] + (m[2] ? '-' + m[2] : '') } : null; };
  function kartKabi(a, id) {
    let k = a;
    for (let i = 0; i < 6 && k.parentElement && k.parentElement !== document.body; i++) {
      const ust = k.parentElement;
      const baglar = Array.from(ust.querySelectorAll('a[href*="/models/"]'));
      if (baglar.some((b) => { const m = kartModelId(b); return m && m.id !== id; })) break;
      // Sayfada tek model bağlantısı kalınca ızgaraya ya da ana bölüme çıkılmaz
      if (k.querySelector('img') && ust.offsetWidth > k.offsetWidth * 1.5) break;
      k = ust;
    }
    return k.querySelector('img') ? k : null;
  }
  function kartlariBul() {
    const sonuc = new Map();
    const buModel = D.modelId;
    document.querySelectorAll('a[href*="/models/"]').forEach((a) => {
      if (a.closest(`#${ONEK}-kok`)) return;
      const m = kartModelId(a);
      if (!m || m.id === buModel) return;
      const k = kartKabi(a, m.id);
      if (!k || k.closest('[aria-haspopup="true"]')) return;
      for (const [onceki, om] of sonuc) {
        if (om.id !== m.id) continue;
        if (onceki === k || onceki.contains(k)) return;
        if (k.contains(onceki)) sonuc.delete(onceki);
      }
      sonuc.set(k, m);
    });
    return sonuc;
  }
  function kartOzeti(t0) {
    const mats = [];
    let uyum = {};
    (Array.isArray(t0.instances) ? t0.instances : []).filter((i) => i && typeof i === 'object').forEach((i) => {
      const o = profilOzeti(i);
      o.mats.forEach((m) => { const u = m.toUpperCase(); if (mats.indexOf(u) < 0) mats.push(u); });
      AYAR.sira.forEach((y) => { if (uyumluMu(o, y)) uyum[y] = true; });
    });
    return { mats, uyum };
  }
  function kartRozeti(k, m) {
    let kutu = k.querySelector(`:scope > .${ONEK}-kart`);
    const v = KART.veri.get(m.id);
    const imza = JSON.stringify([m.id, v ? (v.hata ? 'h' : v.ozet ? 'o' : 'y') : 'b', AYAR.kartUyum, AYAR.sira, AYAR.hazne, dil()]);
    if (kutu && kutu.dataset.imza === imza) return;
    if (!kutu) { kutu = O('div', { class: `${ONEK}-rozetler ${ONEK}-kart` }); k.append(kutu); }
    kutu.dataset.imza = imza; kutu.textContent = '';
    if (!v || v.yukleniyor) { kutu.append(roz('', t('kr_yukleniyor'), 'yukleniyor')); return; }
    if (v.hata) { const r = roz('', '—'); r.title = t('kr_okunamadi'); kutu.append(r); return; }
    if (v.ozet.mats.length) kutu.append(roz('', v.ozet.mats.join(' · ')));
    if (AYAR.hazne && v.ozet.mats.some((x) => HAZNE.test(x))) kutu.append(roz('', t('r_kapali'), 'uyari'));
    if (AYAR.kartUyum) {
      const y = AYAR.sira.find((p) => v.ozet.uyum[p]);
      kutu.append(y ? roz('', '✓ ' + y, 'ok') : roz('', '✗ ' + AYAR.sira[0], 'no'));
    }
  }
  const KART_SURUM = 'kart2:';
  const gecerliTasarim = (t0, id) => !!t0 && Array.isArray(t0.instances) && (t0.id == null || String(t0.id) === String(id));
  async function kartYukle(m) {
    const v = KART.veri.get(m.id);
    if (v && !v.bekliyor) return;
    const n0 = (v && v.n) || 0;
    KART.veri.set(m.id, { yukleniyor: true, n: n0 });
    const hataYaz = () => KART.veri.set(m.id, { hata: true, t: Date.now(), n: n0 + 1 });
    let t0 = onbellekAl(KART_SURUM + m.id);
    if (t0 && !Array.isArray(t0.instances)) t0 = null;
    if (!t0) { const tam = onbellekAl('tasarim:' + m.id); if (gecerliTasarim(tam, m.id)) t0 = tam; }
    let yeni = false;
    if (!t0) {
      try {
        const j = await jsonAl(`${location.origin}/api/v1/design-service/design/${m.id}`);
        t0 = (j && j.design) || j;
        if (!gecerliTasarim(t0, m.id)) throw new Error('biçim');
      } catch (e) {
        const nd = nextVeri();
        try {
          if (!nd || !nd.buildId) throw e;
          const j = await jsonAl(`${location.origin}/_next/data/${nd.buildId}/${nd.locale || 'en'}/models/${m.slug}.json?designId=${encodeURIComponent(m.slug)}`);
          t0 = j && j.pageProps && j.pageProps.design;
          if (!gecerliTasarim(t0, m.id)) throw new Error('biçim');
        } catch (e2) { hataYaz(); return; }
      }
      yeni = true;
    }
    let ozet;
    try {
      // yalnız gereken alanlar tutulur
      t0 = { instances: t0.instances.filter((i) => i && typeof i === 'object').map((i) => {
        const mi = (i.extention && i.extention.modelInfo) || {};
        return { instanceFilaments: i.instanceFilaments, extention: { modelInfo: { compatibility: mi.compatibility, otherCompatibility: mi.otherCompatibility } } };
      }) };
      ozet = kartOzeti(t0);
    } catch (e) { hata('kart özeti', e); hataYaz(); return; }
    if (yeni) onbellekYaz(KART_SURUM + m.id, t0);
    KART.veri.set(m.id, { ozet });
  }
  function kuyrukIsle() {
    while (KART.calisan < 3 && KART.kuyruk.length) {
      const m = KART.kuyruk.shift();
      KART.calisan++;
      kartYukle(m).catch((e) => hata('kart', e)).finally(() => { KART.calisan--; planla(); kuyrukIsle(); });
    }
  }
  function kuyruga(m) {
    const v = KART.veri.get(m.id);
    // Geçici hata (ağ, 429): 60 sn sonra en çok 2 kez yeniden denenir
    const yenidenDene = v && v.hata && (v.n || 1) <= 2 && Date.now() - (v.t || 0) > 60000;
    if (v && !yenidenDene && (v.ozet || v.hata || v.yukleniyor || v.sirada)) return;
    KART.veri.set(m.id, { sirada: true, bekliyor: true, yukleniyor: true, n: (v && v.n) || 0 });
    KART.kuyruk.push(m); kuyrukIsle();
  }
  function kartlariIsle() {
    const kartlar = AYAR.kartAc ? kartlariBul() : new Map();
    document.querySelectorAll(`.${ONEK}-kart`).forEach((k) => { if (!kartlar.has(k.parentElement)) k.remove(); });
    let y = 0, h = 0;
    kartlar.forEach((m, k) => {
      const v = KART.veri.get(m.id);
      if (v && v.ozet) y++;
      if (v && v.hata) { h++; kuyruga(m); }
      if (!AYAR.kartGor) kuyruga(m);
      else if (typeof IntersectionObserver === 'function') {
        if (!KART.gozcu) {
          KART.gozcu = new IntersectionObserver((girdiler) => girdiler.forEach((g) => {
            if (!g.isIntersecting) return;
