// ==UserScript==
// @name         AALabs Tweet Toplayıcı
// @namespace    aalabs
// @version      1.1.0
// @description  X'te açık tweeti ve bütün cevaplarını toplar; Markdown olarak kopyalar ya da indirir.
// @match        https://x.com/*
// @icon         data:image/png;base64,
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_unregisterMenuCommand
// @grant        GM_setClipboard
// @grant        unsafeWindow
// @run-at       document-start
// @noframes
// @aalabs-ikon  TWS
// ==/UserScript==

(function () {
  'use strict';

  const SURUM = '1.1.0';
  const KOD = 'TWS';
  const ONEK = 'aalabs-tws';
  const SAYFA = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;

  // ---------------------------------------------------------------- metinler
  const METIN = {
    tr: {
      ad: 'Tweet Toplayıcı',
      hazir: 'Hazır. Bu tweeti ve cevaplarını topla.',
