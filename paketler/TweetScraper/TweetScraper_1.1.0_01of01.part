      ortak: 'ORTAK',
      kapat: 'Kapat',
      bToplama: 'Toplama',
      bDisa: 'Dışa aktarma',
      bPanel: 'Panel',
      bGenel: 'Genel',
      bKisayol: 'Klavye kısayolları',
      bTani: 'Tanı',
      bHakkinda: 'Hakkında',
      kaynak: 'Veri kaynağı',
      kX: 'X verisi',
      kS: 'Yalnız sayfa',
      kaynakN: 'X verisi alınamazsa kendiliğinden sayfa okumaya geçer ve bunu yazar.',
      bekle: 'Kaydırma arası bekleme',
      bekleN: 'Sayfa yavaşsa artır.',
      sn: 'sn',
