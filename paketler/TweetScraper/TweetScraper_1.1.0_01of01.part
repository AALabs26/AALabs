      mdZincir: 'yalnız yazarın zinciri',
      mdNot: '> Not: X verisi alınamadı; cevap ağacı kurulamadı, düz liste yazıldı.',
      mdBos: '(metin yok)',
      menuKomut: 'Ayarlar (A)',
      topluyor1: 'Topluyor… {n} tweet · tur {tur}',
      bitti1: 'Bitti · {n} tweet toplandı',
      bittiZ1: 'Bitti · yazarın zinciri: {n} tweet',
      durdu1: 'Durduruldu · {n} tweet',
      kopyalandi1: 'Panoya kopyalandı · {n} tweet',
      toplandiBildirim1: '{n} tweet toplandı',
      zincirBildirim1: 'Yazarın zinciri: {n} tweet'
    },
    en: {
      ad: 'Tweet Collector',
      hazir: 'Ready. Collect this tweet and its replies.',
      bekliyor: 'Open a tweet’s page.',
      topluyor: 'Collecting… {n} tweets · round {tur}',
      bitti: 'Done · {n} tweets collected',
      bittiZ: 'Done · author’s thread: {n} tweets',
      durdu: 'Stopped · {n} tweets',
      hata: 'No tweets on this page. Open a tweet’s page.',
      kaynakX: 'Source: X data',
      kaynakS: 'Source: page reading (X data unavailable)',
      kaynakSecim: 'Source: page reading (setting)',
      topla: 'Collect',
      durdur: 'Stop',
      zincir: 'Author’s thread only',
      mdKop: 'Copy Markdown',
      mdInd: 'Download Markdown',
      ayarlar: 'Settings',
      kopyalandi: 'Copied to clipboard · {n} tweets',
      kopyaOlmadi: 'Could not copy. The text is selected; press Ctrl+C.',
      indirildi: 'Downloaded · {ad}',
      veriYok: 'Collect first; nothing to export yet.',
      toplandiBildirim: '{n} tweets collected',
      zincirBildirim: 'Author’s thread: {n} tweets',
      ara: 'Search settings',
      aramaYok: 'No results.',
      ortak: 'COMMON',
      kapat: 'Close',
      bToplama: 'Collecting',
      bDisa: 'Export',
      bPanel: 'Panel',
      bGenel: 'General',
      bKisayol: 'Keyboard shortcuts',
      bTani: 'Diagnosis',
      bHakkinda: 'About',
      kaynak: 'Data source',
      kX: 'X data',
      kS: 'Page only',
      kaynakN: 'If X data is unavailable it switches to page reading by itself and says so.',
      bekle: 'Wait between scrolls',
      bekleN: 'Raise it if the page is slow.',
      sn: 's',
      bos: 'Stop when no new tweets',
      bosN: 'Collecting ends after this many empty rounds.',
      enCok: 'Maximum rounds',
      enCokN: 'Safety limit (20–2000).',
      dahaFazla: 'Press “Show more replies” buttons itself',
      agac: 'Reply tree',
      agacN: 'Who replied to whom, shown by indentation.',
      sade: 'Plain text mode',
      sadeN: 'Counts, dates and links are dropped; the file gets smaller.',
      metrik: 'Reply, repost and like counts',
      alinti: 'Quoted tweet',
      dosyaAdi: 'File name',
      dosyaAdiN: '{id}, {kullanici} and {tarih} can be used.',
      sira: 'Order',
      siraS: 'Page order',
      siraZ: 'By time',
      konum: 'Panel position',
      sagAlt: 'Bottom right',
      solAlt: 'Bottom left',
      yalniz: 'Show only on tweet pages',
      bitince: 'Show a notice when done',
      bitinceN: 'Visible for 4 s.',
      dil: 'Language',
      tarayici: 'Browser language',
      algilanan: 'Detected: {dil}',
      tema: 'Theme',
      siteyi: 'Follow the site',
      acik: 'Light',
      koyu: 'Dark',
      olcek: 'Scale',
      varsayilan: 'Reset to defaults',
      varsayilanOldu: 'Settings were reset to defaults.',
      kAyar: 'Open settings',
      kTopla: 'Collect',
      kZincir: 'Author’s thread only',
      kKop: 'Copy Markdown',
      kYok: 'none',
      kBekle: 'Press keys…',
      kNot: 'Click the box, press keys. Delete clears it. Browser and X keys are not accepted.',
      kRed: 'This key cannot be used: {tus}. Try Ctrl+Shift, Alt or Ctrl with punctuation.',
      kCakisma: 'This key is already used by: {is}.',
      tSayfa: 'Tweet page',
      tKart: 'Tweet card',
      tAd: 'User name',
      tMetin: 'Tweet text',
      tVeri: 'X data (TweetDetail)',
      tVeriYanit: 'responses: {n} · tweets: {t} · {yol}',
      tVeriYok: 'unavailable',
      tVeriBekle: 'waiting',
      tKanca: 'Data hook',
      tKancaVar: 'installed ({yol})',
      tKancaYok: 'not installed',
      tKesif: '“Discover more” section',
      tKesifN: 'cards skipped: {n}',
      tDaha: '“Show more replies” button',
      tDahaN: 'pressed: {n}',
      tBekliyor: 'waiting',
      kabul: 'Acceptance test',
      gecti: 'Pass',
      sorun: 'Problem',
      atla: 'Skip',
      nasil: 'How to test: ',
      rapor: 'Copy report',
      raporKopyalandi: 'Report copied to clipboard.',
      k1m: 'When done, is the number on the button close to the reply count on the page?',
      k1i: 'Open a tweet with 20–50 replies. Press Collect. When done, look at the number on the TWS button.',
      k2m: 'In the pasted Markdown, is the root tweet at the top?',
      k2i: 'When done, press Copy Markdown. Paste it into Notepad.',
      k3m: 'Does the downloaded .md file show ş, ğ, ı correctly?',
      k3i: 'Press Download Markdown. Open the file in Notepad.',
      k4m: 'Does the counter stop when you press Stop?',
      k4i: 'Press Collect. After 5 s press Stop in the menu.',
      k5m: 'Is the menu text readable in X’s dark theme?',
      k5i: 'In X Settings › Display choose "Lights out". Open the TWS menu.',
      surum: 'Version {s}',
      aps: 'Updated by AALabs App Store.',
      yedek: 'Settings backup',
      disaAl: 'Export',
      iceAl: 'Import',
      yedekHazir: 'Downloading the backup file.',
      yedekAlindi: 'Settings restored from the backup.',
      yedekBozuk: 'This file is not a TWS settings backup. Pick a file made with Export.',
      mdBas: '# Tweet and replies',
      mdKaynak: 'Source',
      mdTop: 'Collected',
      mdTw: 'tweets',
      mdKok: 'Root',
      mdBaglam: 'Context (earlier tweets)',
      mdCevaplar: 'Replies',
      mdCevap: 'Replies',
      mdRt: 'RT',
      mdBeg: 'Likes',
      mdAlinti: 'Quote',
      mdVeri: 'source',
      mdVX: 'X data',
      mdVS: 'page reading',
      mdZincir: 'author’s thread only',
      mdNot: '> Note: X data unavailable; the reply tree could not be built, a flat list was written.',
      mdBos: '(no text)',
      menuKomut: 'Settings (A)',
      topluyor1: 'Collecting… 1 tweet · round {tur}',
      bitti1: 'Done · 1 tweet collected',
      bittiZ1: 'Done · author’s thread: 1 tweet',
      durdu1: 'Stopped · 1 tweet',
      kopyalandi1: 'Copied to clipboard · 1 tweet',
      toplandiBildirim1: '1 tweet collected',
      zincirBildirim1: 'Author’s thread: 1 tweet'
    }
  };

  // ---------------------------------------------------------------- ayarlar
  const VARSAYILAN = {
    dil: 'sistem', tema: 'site', olcek: 100,
    kaynak: 'x', bekle: 1300, bosTur: 6, enCokTur: 600, dahaFazla: true,
    agac: true, sade: false, metrik: true, alinti: true, dosyaAdi: 'tweet_{id}_{tarih}', sira: 'sayfa',
    konum: 'sag', yalnizTweet: true, bildirim: true,
    kisayol: { ayarlar: 'Ctrl+,', topla: '', zincir: '', kopya: '' },
    kabul: { K1: null, K2: null, K3: null, K4: null, K5: null }
  };
  const SECENEK = {
    dil: ['sistem', 'tr', 'en'], tema: ['site', 'acik', 'koyu'], olcek: [90, 100, 115, 130],
    kaynak: ['x', 'sayfa'], bekle: [800, 1300, 2000], bosTur: [4, 6, 10], sira: ['sayfa', 'zaman'], konum: ['sag', 'sol']
  };
  const KABUL_DEGER = ['gecti', 'sorun', 'atla'];

  const gmVar = typeof GM_getValue === 'function' && typeof GM_setValue === 'function';
  let bellekAyar = null;

  function kopyala(o) { return JSON.parse(JSON.stringify(o)); }
  function dogrula(ham) {
    const a = kopyala(VARSAYILAN);
    if (!ham || typeof ham !== 'object') return a;
    for (const k of Object.keys(SECENEK)) if (SECENEK[k].includes(ham[k])) a[k] = ham[k];
    for (const k of ['dahaFazla', 'agac', 'sade', 'metrik', 'alinti', 'yalnizTweet', 'bildirim']) if (typeof ham[k] === 'boolean') a[k] = ham[k];
    if (Number.isInteger(ham.enCokTur) && ham.enCokTur >= 20 && ham.enCokTur <= 2000) a.enCokTur = ham.enCokTur;
    if (typeof ham.dosyaAdi === 'string' && ham.dosyaAdi.trim() && ham.dosyaAdi.length <= 80) a.dosyaAdi = ham.dosyaAdi.trim();
    if (ham.kisayol && typeof ham.kisayol === 'object') {
      for (const k of Object.keys(a.kisayol)) {
        const v = ham.kisayol[k];
        if (v === '' || (typeof v === 'string' && komboKanonikMi(v) && !yasakMi(v) && !Object.values(a.kisayol).some((o, i) => o === v && Object.keys(a.kisayol)[i] !== k))) a.kisayol[k] = v;
      }
    }
    if (ham.kabul && typeof ham.kabul === 'object') {
      for (const k of Object.keys(a.kabul)) if (ham.kabul[k] === null || KABUL_DEGER.includes(ham.kabul[k])) a.kabul[k] = ham.kabul[k];
    }
    return a;
  }
  function ayarOku() {
    if (!gmVar) return bellekAyar ? kopyala(bellekAyar) : kopyala(VARSAYILAN);
    try { const h = GM_getValue('ayar', null); return dogrula(typeof h === 'string' ? JSON.parse(h) : h); } catch (_h) { return kopyala(VARSAYILAN); }
  }
  function ayarYaz() {
    if (!gmVar) { bellekAyar = kopyala(ayar); return; }
    try { GM_setValue('ayar', JSON.stringify(ayar)); } catch (_h) { /* depo yoksa bellekte kalır */ }
  }
  let ayar = null;   // kısayol denetimi tanımlandıktan sonra okunur (aşağıda)

  // ---------------------------------------------------------------- dil
  function dilEtkin() {
    if (ayar.dil !== 'sistem') return ayar.dil;
    const d = (navigator.language || 'en').toLowerCase();
    return d.startsWith('tr') ? 'tr' : 'en';
  }
  function t(anahtar, deg) {
    const d = METIN[dilEtkin()] || METIN.tr;
    let s = d[anahtar] != null ? d[anahtar] : (METIN.tr[anahtar] != null ? METIN.tr[anahtar] : anahtar);
    if (deg) for (const k of Object.keys(deg)) s = s.split('{' + k + '}').join(String(deg[k]));
    return s;
  }
  function tn(anahtar, deg) {                                              // tekil (EN) + sayı biçimi
    const bir = deg && deg.n === 1;
    const d = Object.assign({}, deg, deg && typeof deg.n === 'number' ? { n: sayiYaz(deg.n) } : {});
    return bir ? t(anahtar + '1', d) : t(anahtar, d);
  }
  function sayiYaz(n) { return Number(n).toLocaleString(dilEtkin() === 'tr' ? 'tr-TR' : 'en-US'); }
  function katla(s) { return String(s).toLocaleLowerCase('tr-TR').replace(/ı/g, 'i'); }

  // ---------------------------------------------------------------- kısayollar
  const YASAK = new Set([
    'Ctrl+Shift+T', 'Ctrl+Shift+N', 'Ctrl+Shift+W', 'Ctrl+Shift+I', 'Ctrl+Shift+J', 'Ctrl+Shift+C', 'Ctrl+Shift+B',
    'Ctrl+Shift+O', 'Ctrl+Shift+Q', 'Ctrl+Shift+R', 'Ctrl+Shift+Delete', 'Ctrl+Shift+K', 'Ctrl+Shift+E', 'Ctrl+Shift+P',
    'Alt+D', 'Alt+F', 'Alt+F4', 'Alt+Home', 'Alt+ArrowLeft', 'Alt+ArrowRight', 'Ctrl+Tab', 'Ctrl+Shift+Tab', 'Ctrl+Enter',
    'Ctrl+Shift+V', 'Ctrl+Shift+Z', 'Ctrl+Shift+Enter'
  ]);
  function komboKanonikMi(v) {
    const m = /^(Ctrl\+)?(Alt\+)?(Shift\+)?(Meta\+)?([^+]+|Plus)$/.exec(v);
    if (!m || !(m[1] || m[2] || m[4])) return false;
    const tus = m[5];
    if ([...tus].length === 1) return tus === tus.toLocaleUpperCase('en-US');
    return /^[A-Z][A-Za-z0-9]{1,15}$/.test(tus);
  }
  function yasakMi(v) {
    if (YASAK.has(v)) return true;
    if (/^Meta\+|\+Meta\+/.test(v) || v.startsWith('Meta')) return true;            // Meta = Ctrl eşdeğeri; sayılmaz
    if (/^Ctrl\+Alt\+/.test(v)) return true;                                          // AltGr ile karışır
    if (/^Ctrl\+([A-Z0-9])$/.test(v)) return true;                                     // tarayıcının Ctrl+harf/rakam tuşları
    if (/^Ctrl\+F\d+$/.test(v) || /^F(5|11|12)$/.test(v)) return true;
    if (/^Ctrl\+(Shift\+)?(Arrow\w+|Home|End|PageUp|PageDown|Insert|Delete|Backspace|-|=|Plus|0)$/.test(v)) return true;   // yazı düzenleme, sekme, yakınlaştırma
    return false;
  }
  function tusKombo(e) {
    if (e.getModifierState && e.getModifierState('AltGraph')) return null;             // AltGr yazı içindir
    const k = e.key || '';
    if (['Control', 'Shift', 'Alt', 'Meta', 'AltGraph', 'CapsLock', 'Dead', 'Unidentified', 'Process', ' '].includes(k)) return null;
    let ad = null;
    if (/^Key[A-Z]$/.test(e.code || '')) ad = e.code.slice(3);
    else if (/^Digit\d$/.test(e.code || '')) ad = e.code.slice(5);
    else if (/^F\d{1,2}$/.test(k)) ad = k;
    else if (k === '+') ad = 'Plus';
    else if ([...k].length === 1) ad = k.toLocaleUpperCase('en-US').replace('İ', 'I');
    else if (/^[A-Z][A-Za-z0-9]{1,15}$/.test(k)) ad = k;
    if (!ad) return null;
    const meta = e.metaKey;
    return (e.ctrlKey || meta ? 'Ctrl+' : '') + (e.altKey ? 'Alt+' : '') + (e.shiftKey ? 'Shift+' : '') + ad;
  }

  ayar = ayarOku();

  // ---------------------------------------------------------------- veri deposu
  const VERI = new Map();          // id → kayıt (X verisinden ya da sayfadan)
  const TANI = { yanit: 0, xTweet: 0, yol: '', kanca: '', hata: 0, kesif: 0, dahaFazla: 0, kart: 0, adVar: 0, metinVar: 0 };
  let siraSayac = 0;

  function htmlCoz(s) { return String(s).replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, '&'); }
  const AYLAR = { Jan: 1, Feb: 2, Mar: 3, Apr: 4, May: 5, Jun: 6, Jul: 7, Aug: 8, Sep: 9, Oct: 10, Nov: 11, Dec: 12 };
  function xTarih(s) {
    const m = /^\w{3} (\w{3}) (\d{1,2}) (\d{2}):(\d{2}):(\d{2}) ([+-]\d{4}) (\d{4})$/.exec(String(s || ''));
    if (!m || !AYLAR[m[1]]) { const d = new Date(s); return isNaN(d.getTime()) ? '' : d.toISOString(); }
    const o = m[6], dk = (o[0] === '-' ? -1 : 1) * (parseInt(o.slice(1, 3), 10) * 60 + parseInt(o.slice(3), 10));
    const ms = Date.UTC(+m[7], AYLAR[m[1]] - 1, +m[2], +m[3], +m[4], +m[5]) - dk * 60000;
    return isNaN(ms) ? '' : new Date(ms).toISOString();
  }
  function kisaltmaAc(metin, legacy) {
    let s = metin;
    const ent = legacy && legacy.entities;
    if (ent && Array.isArray(ent.urls)) for (const u of ent.urls) if (u && u.url && u.expanded_url) s = s.split(u.url).join(u.expanded_url);
    return s;
  }
  function kullanici(tw) {
    const u = tw && tw.core && tw.core.user_results && tw.core.user_results.result;
    if (!u) return { ad: '', kullanici: '' };
    const c = u.core || {}, l = u.legacy || {};
    return { ad: c.name || l.name || '', kullanici: c.screen_name || l.screen_name || '' };
  }
  function tweetAc(r) {
    if (!r || typeof r !== 'object') return null;
    if (r.__typename === 'TweetWithVisibilityResults' && r.tweet) return r.tweet;
    if (r.__typename === 'Tweet' || (r.rest_id && r.legacy)) return r;
    return null;
  }
  function tweetMetni(tw) {
    const l = tw.legacy || {};
    const rt = tweetAc(l.retweeted_status_result && l.retweeted_status_result.result);
    if (rt && rt.legacy) return `RT @${kullanici(rt).kullanici}: ${tweetMetni(rt)}`;
    const not = tw.note_tweet && tw.note_tweet.note_tweet_results && tw.note_tweet.note_tweet_results.result;
    if (not && typeof not.text === 'string') return kisaltmaAc(htmlCoz(not.text), { entities: not.entity_set }).trim();
    // Dizin anlamına bağlı kalmadan: baştaki cevap etiketlerini ve sondaki medya bağlantılarını desenle at
    let s = htmlCoz(String(l.full_text || ''));
    const r = l.display_text_range;
    if (Array.isArray(r) && r[0] > 0) s = s.replace(/^(?:@\w{1,15}\s+)+/, '');
    const medya = new Set([...(((l.extended_entities || {}).media) || []), ...(((l.entities || {}).media) || [])].map((m) => m && m.url).filter(Boolean));
    for (;;) {
      const m = /\s*(https:\/\/t\.co\/\w+)\s*$/.exec(s);
      if (!m || !medya.has(m[1])) break;
      s = s.slice(0, m.index);
    }
    return kisaltmaAc(s, l).trim();
  }
  function xKaydet(ham) {
    const tw = tweetAc(ham);
    if (!tw || !tw.legacy || !tw.rest_id) return false;
    const l = tw.legacy, u = kullanici(tw);
    const onceki = VERI.get(tw.rest_id);
    let alinti = null;
    const q = tweetAc(tw.quoted_status_result && tw.quoted_status_result.result);
    if (q && q.legacy) alinti = { kullanici: kullanici(q).kullanici, metin: tweetMetni(q) };
    VERI.set(tw.rest_id, {
      id: tw.rest_id, ad: u.ad, kullanici: u.kullanici, metin: tweetMetni(tw), tarih: xTarih(l.created_at),
      ust: l.in_reply_to_status_id_str || '', konusma: l.conversation_id_str || '',
      cevap: l.reply_count, rt: l.retweet_count, begeni: l.favorite_count, alinti,
      kaynak: 'x', sira: onceki ? onceki.sira : siraSayac++, sayfada: onceki ? onceki.sayfada : false
    });
    return true;
  }
  function tweetleriBul(d, derin) {
    let n = 0;
    if (!d || typeof d !== 'object' || derin > 80) return 0;
    if (Array.isArray(d)) { for (const o of d) n += tweetleriBul(o, derin + 1); return n; }
    const tw = tweetAc(d);
    if (tw && tw.legacy && tw.rest_id) { try { if (xKaydet(d)) n++; } catch (_h) { TANI.hata++; } }
    for (const k of Object.keys(d)) {
      if (k === 'quoted_status_result' || k === 'retweeted_status_result' || k === 'legacy' || k === 'core' || (tw && k === 'tweet')) continue;
      const v = d[k];
      if (v && typeof v === 'object') n += tweetleriBul(v, derin + 1);
    }
    return n;
  }
  function yanitIsle(metin, yol) {
    if (ayar.kaynak !== 'x') return;
    let j;
    try { j = JSON.parse(metin); } catch (_h) { return; }
    let n = 0;
    try { n = tweetleriBul(j && j.data, 0); } catch (_h) { TANI.hata++; }
    TANI.yanit++; TANI.xTweet += n; TANI.yol = yol;
    zamanla();
  }

  // X'in kendi TweetDetail isteklerini dinle (en dar müdahale: yalnız yanıtı okur, isteği değiştirmez)
  const DETAY = /\/i\/api\/graphql\/[^/?]+\/TweetDetail\b/;
  function ihrac(fn, hedef, ad) {
    if (typeof exportFunction === 'function') { exportFunction(fn, hedef, { defineAs: ad }); return; }
    hedef[ad] = fn;
  }
  // Firefox içerik betiğinde sayfaya verilen geri çağrılar dışa aktarılır (Xray); öteki yöneticilerde olduğu gibi kalır
  function sayfaFn(fn) { try { return typeof exportFunction === 'function' ? exportFunction(fn, SAYFA) : fn; } catch (_h) { return fn; } }
  function kancaKur() {
    const kurulan = [];
    try {
      const asil = SAYFA.fetch;
      if (typeof asil === 'function') {
        const yeni = function (girdi, secenek) {
          const p = Reflect.apply(asil, this, Array.from(arguments));
          try {
            const adres = String((girdi && girdi.url) || girdi || '');
            if (DETAY.test(adres)) {
              p.then(sayfaFn((yanit) => {
                try {
                  yanit.clone().text().then(sayfaFn((m) => { yanitIsle(String(m), 'fetch'); }), sayfaFn(() => { TANI.hata++; }));
                } catch (_h) { TANI.hata++; }
              }), sayfaFn(() => {}));
            }
          } catch (_h) { /* kanca isteği bozmaz */ }
          return p;
        };
        ihrac(yeni, SAYFA, 'fetch');
        kurulan.push('fetch');
      }
    } catch (_h) { /* fetch kancası kurulamadı */ }
    try {
      const proto = SAYFA.XMLHttpRequest && SAYFA.XMLHttpRequest.prototype;
      if (proto && typeof proto.open === 'function') {
        const asilAc = proto.open;
        const dinlenen = new WeakSet();
        const yeniAc = function (yontem, adres) {
          try {
            const xhr = this;
            if (DETAY.test(String(adres || '')) && !dinlenen.has(xhr)) {
              dinlenen.add(xhr);
              xhr.addEventListener('load', sayfaFn(() => {
                try {
                  if (!DETAY.test(String(xhr.responseURL || ''))) return;
                  const tur = xhr.responseType;
                  const m = tur === 'json' ? JSON.stringify(xhr.response) : (!tur || tur === 'text') ? xhr.responseText : null;
                  if (typeof m === 'string') yanitIsle(m, 'xhr');
                } catch (_h) { TANI.hata++; }
              }));
            }
          } catch (_h) { /* kanca isteği bozmaz */ }
          return Reflect.apply(asilAc, this, Array.from(arguments));
        };
        ihrac(yeniAc, proto, 'open');
        kurulan.push('xhr');
      }
    } catch (_h) { /* xhr kancası kurulamadı */ }
    TANI.kanca = kurulan.join(' + ');
  }

  // ---------------------------------------------------------------- sayfa okuma
  function sayfaId() { const m = /^\/[^/]+\/status\/(\d+)/.exec(location.pathname); return m ? m[1] : null; }
  function sayiAl(el) {
    if (!el) return null;
    const a = el.getAttribute('aria-label') || '';
    const m = /^\s*(\d[\d.,\s]*)(\S*)/.exec(a);
    const kisa = (x) => /^[,.]\d{1,2}(\D|$)/.test(x.replace(/^\d+/, '')) || /^(k|m|b|bn|mn|b\.)$/i.test(x);
    if (m) {
      const sayi = m[1].trim(), ek = (m[2] || '').replace(/[^\p{L}.]/gu, '');
      if (!kisa(sayi) && !kisa(ek)) { const n = parseInt(sayi.replace(/[^\d]/g, ''), 10); if (!isNaN(n)) return n; }
      return (sayi + (ek ? ' ' + ek : '')).trim();                      // kısaltılmış: ham metin ("2,1 B")
    }
    const s = (el.innerText || '').trim();
    return s ? s : 0;
  }
  function metinAl(el) {
    if (!el) return '';
    const k = el.cloneNode(true);
    k.querySelectorAll('img').forEach((i) => i.replaceWith(document.createTextNode(i.getAttribute('alt') || '')));
    return (k.innerText != null ? k.innerText : k.textContent || '').trim();
  }
  function kartOku(art) {
    const alintiKutu = [...art.querySelectorAll('div[role="link"]')].find((d) => d.querySelector('[data-testid="tweetText"]'));
    const zaman = [...art.querySelectorAll('a[href*="/status/"] time')].find((z) => !alintiKutu || !alintiKutu.contains(z));
    if (!zaman) return null;
    const bag = zaman.closest('a');
    const m = /\/status\/(\d+)/.exec(bag.getAttribute('href') || '');
    if (!m) return null;
    const blok = art.querySelector('[data-testid="User-Name"]');
    let ad = '', kul = '';
    if (blok) {
      const parca = [...blok.querySelectorAll('span')].map((s) => (s.innerText || s.textContent || '').trim()).filter(Boolean);
      kul = (parca.find((s) => s.startsWith('@')) || '').slice(1);
      ad = parca.find((s) => !s.startsWith('@') && s !== '·') || '';
    }
    const metinler = [...art.querySelectorAll('[data-testid="tweetText"]')];
    const anaMetin = metinler.find((e) => !alintiKutu || !alintiKutu.contains(e));
    let alinti = null;
    if (alintiKutu) {
      const qb = alintiKutu.querySelector('[data-testid="User-Name"]');
      const qk = qb ? ((qb.innerText || qb.textContent || '').match(/@(\w+)/) || [])[1] || '' : '';
      alinti = { kullanici: qk, metin: metinAl(alintiKutu.querySelector('[data-testid="tweetText"]')) };
    }
    return {
      id: m[1], ad, kullanici: kul, metin: metinAl(anaMetin), tarih: zaman.getAttribute('datetime') || '',
      cevap: sayiAl(art.querySelector('[data-testid="reply"]')), rt: sayiAl(art.querySelector('[data-testid="retweet"]')),
      begeni: sayiAl(art.querySelector('[data-testid="like"], [data-testid="unlike"]')), alinti, adVar: !!blok, metinVar: !!anaMetin
    };
  }
  const sayfadaGorulen = new Set();
  // Cevapların altındaki "Daha fazlasını keşfet" akışı: kök karttan sonraki ilk h2 başlığından sonrası alınmaz
  function kesifSiniri(kartlar) {
    const id = sayfaId();
    const kokKart = kartlar.find((a) => { const k = a.querySelector('a[href*="/status/"] time'); return k && (k.closest('a').getAttribute('href') || '').includes('/status/' + id); });
    if (!kokKart) return null;
    return [...document.querySelectorAll('main h2, main [role="heading"][aria-level="2"]')].find((h) =>
      !h.closest('article') && !h.closest('[data-aalabs]') && (kokKart.compareDocumentPosition(h) & Node.DOCUMENT_POSITION_FOLLOWING)) || null;
  }
  function sayfaTara() {
    let kartlar = [...document.querySelectorAll('article[data-testid="tweet"]')];
    const sinir = kesifSiniri(kartlar);
    if (sinir) { const once = kartlar.length; kartlar = kartlar.filter((a) => !(sinir.compareDocumentPosition(a) & Node.DOCUMENT_POSITION_FOLLOWING)); TANI.kesif = Math.max(TANI.kesif, once - kartlar.length); }
    let yeni = 0;
    TANI.kart = Math.max(TANI.kart, kartlar.length);
    kartlar.forEach((art) => {
      const k = kartOku(art);
      if (!k) return;
      if (!sayfadaGorulen.has(k.id)) { sayfadaGorulen.add(k.id); TANI.adVar += k.adVar ? 1 : 0; TANI.metinVar += k.metinVar ? 1 : 0; }
      const var_ = VERI.get(k.id);
      if (var_ && var_.kaynak === 'x') { if (!var_.sayfada) { var_.sayfada = true; yeni++; } return; }
      if (!var_) yeni++;
      VERI.set(k.id, {
        id: k.id, ad: k.ad, kullanici: k.kullanici, metin: k.metin, tarih: k.tarih, ust: '', konusma: '',
        cevap: k.cevap, rt: k.rt, begeni: k.begeni, alinti: k.alinti, kaynak: 'sayfa',
        sira: var_ ? var_.sira : siraSayac++, sayfada: true
      });
    });
    return yeni;
  }
  const DAHA_FAZLA = /^(show more replies|show additional replies|show replies|show probable spam|daha fazla yanıt|ek yanıtları göster|yanıtları göster|olası spam(ı)? göster|muhtemel spam(ı)? göster)/i;
  let basilanlar = new WeakSet();
  function dahaFazlaBas() {
    if (!ayar.dahaFazla) return 0;
    let n = 0;
    document.querySelectorAll('main [role="button"], main button').forEach((b) => {
      if (b.closest('article') || b.closest('[data-aalabs]')) return;
      const s = (b.innerText || b.textContent || '').trim();
      if (s && s.length < 90 && DAHA_FAZLA.test(s) && !basilanlar.has(b)) { basilanlar.add(b); b.click(); n++; }
    });
    TANI.dahaFazla += n;
    return n;
  }

  // ---------------------------------------------------------------- derleme
  function kokKaydi() { const id = sayfaId(); return id ? VERI.get(id) || null : null; }
  function xVerisiVar(kok) { return !!(kok && kok.kaynak === 'x' && kok.konusma && ayar.kaynak === 'x'); }
  function derle() {
    const kok = kokKaydi();
    if (!kok) return null;
    const xli = xVerisiVar(kok);
    let kume;
    if (xli) kume = [...VERI.values()].filter((v) => v.kaynak === 'x' && v.konusma === kok.konusma);
    else kume = [...VERI.values()].filter((v) => sayfadaGorulen.has(v.id));
    const idler = new Map(kume.map((v) => [v.id, v]));
    // bağlam: kökün atası olan tweetler
    const baglam = [];
    if (xli) { let u = kok.ust; const gor = new Set(); while (u && idler.has(u) && !gor.has(u)) { gor.add(u); baglam.unshift(idler.get(u)); u = idler.get(u).ust; } }
    else {
      const sira = kume.slice().sort((a, b) => a.sira - b.sira);
      for (const v of sira) { if (v.id === kok.id) break; baglam.push(v); }
    }
    const baglamId = new Set(baglam.map((v) => v.id));
    const cocuk = new Map();
    const ekle = (ust, v) => { if (!cocuk.has(ust)) cocuk.set(ust, []); cocuk.get(ust).push(v); };
    for (const v of kume) {
      if (v.id === kok.id || baglamId.has(v.id)) continue;
      if (xli && v.ust && idler.has(v.ust) && !baglamId.has(v.ust)) ekle(v.ust, v);
      else if (xli && v.ust && baglamId.has(v.ust)) continue;            // başka dal: köke cevap değil
      else if (xli && !sayfadaGorulen.has(v.id)) continue;               // ebeveyni yok ve bu sayfada görünmedi: başka ziyaretin dalı
      else ekle(kok.id, v);
    }
    const sirala = (a, b) => (ayar.sira === 'zaman' ? (a.tarih || '').localeCompare(b.tarih || '') || a.sira - b.sira : a.sira - b.sira);
    for (const l of cocuk.values()) l.sort(sirala);
    // ağaç düz listesi (derinlikli)
    const liste = [];
    const gez = (id, d, gor) => { for (const c of cocuk.get(id) || []) { if (gor.has(c.id)) continue; gor.add(c.id); liste.push({ v: c, d }); gez(c.id, d + 1, gor); } };
    gez(kok.id, 0, new Set([kok.id]));
    let sonuc = liste;
    if (zincirKipi) {
      if (xli) {
        const zincir = new Set([kok.id]);
        sonuc = liste.filter(({ v }) => { if (v.kullanici === kok.kullanici && zincir.has(v.ust)) { zincir.add(v.id); return true; } return false; });
      } else {
        const ardisik = [];
        for (const x of liste) { if (x.v.kullanici && x.v.kullanici === kok.kullanici) ardisik.push(x); else break; }
        sonuc = ardisik;
      }
    }
    return { kok, xli, baglam: zincirKipi ? [] : baglam, liste: sonuc, toplam: 1 + sonuc.length + (zincirKipi ? 0 : baglam.length) };
  }
  function tarihYaz(iso, kisa) {
    if (!iso) return '';
    const d = new Date(iso); if (isNaN(d)) return '';
    const p = (n) => String(n).padStart(2, '0');
    const gun = `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`, saat = `${p(d.getHours())}:${p(d.getMinutes())}`;
    return kisa === gun ? saat : `${gun} ${saat}`;
  }
  function gunYaz(iso) { const d = new Date(iso || Date.now()); const p = (n) => String(n).padStart(2, '0'); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`; }
  function sayiMd(n) { return typeof n === 'number' ? sayiYaz(n) : String(n == null ? '' : n); }
  function markdown() {
    const r = derle();
    if (!r) return null;
    const { kok, xli } = r;
    const sade = ayar.sade, metrik = ayar.metrik && !sade, agac = ayar.agac && xli;
    const sat = [t('mdBas')];
    const kokGun = gunYaz(kok.tarih);
    const metin = (s) => (s && s.trim() ? s.trim() : t('mdBos'));
    const girintili = (s, g) => metin(s).split('\n').map((x, i) => (i === 0 ? x : g + '  ' + x)).join('\n');
    const say = (v) => `${t('mdCevap')} ${sayiMd(v.cevap)} · ${t('mdRt')} ${sayiMd(v.rt)} · ${t('mdBeg')} ${sayiMd(v.begeni)}`;
    const alinti = (v, g) => (ayar.alinti && v.alinti && v.alinti.metin ? `\n${g}  > ${t('mdAlinti')} @${v.alinti.kullanici}: ${v.alinti.metin.replace(/\n/g, ' ')}` : '');
    if (!sade) {
      const bilgi = [`${r.toplam} ${t('mdTw')}`, `${t('mdVeri')}: ${xli ? t('mdVX') : t('mdVS')}`];
      if (zincirKipi) bilgi.push(t('mdZincir'));
      sat.push(`${t('mdKaynak')}: https://x.com/${kok.kullanici || 'i'}/status/${kok.id}`, `${t('mdTop')}: ${tarihYaz(new Date().toISOString())} · ${bilgi.join(' · ')}`, '');
    } else sat.push('');
    if (r.baglam.length) {
      sat.push(sade ? `${t('mdBaglam')}:` : `## ${t('mdBaglam')}`);
      for (const v of r.baglam) sat.push(sade ? `- @${v.kullanici}: ${girintili(v.metin, '')}` : `- @${v.kullanici} · ${tarihYaz(v.tarih)} — ${girintili(v.metin, '')}`);
      sat.push('');
    }
    if (sade) sat.push(`${t('mdKok')} @${kok.kullanici}: ${metin(kok.metin)}${alinti(kok, '')}`, '');
    else {
      sat.push(`## ${t('mdKok')} · @${kok.kullanici} · ${tarihYaz(kok.tarih)}`, metin(kok.metin));
      if (ayar.alinti && kok.alinti && kok.alinti.metin) sat.push(`> ${t('mdAlinti')} @${kok.alinti.kullanici}: ${kok.alinti.metin.replace(/\n/g, ' ')}`);
      if (metrik) sat.push(say(kok));
      sat.push('');
      if (r.liste.length) sat.push(`## ${t('mdCevaplar')}`, '');
    }
    for (const { v, d } of r.liste) {
      const g = agac ? '  '.repeat(d) : '';
      if (sade) sat.push(`${g}- @${v.kullanici}: ${girintili(v.metin, g)}${alinti(v, g)}`);
      else sat.push(`${g}- @${v.kullanici} · ${tarihYaz(v.tarih, kokGun)} — ${girintili(v.metin, g)}${metrik ? `  (${say(v)})` : ''}${alinti(v, g)}`);
    }
    if (ayar.agac && !xli && !sade && r.liste.length) sat.push('', t('mdNot'));
    return { metin: sat.join('\n') + '\n', sayi: r.toplam, kok };
  }
  function dosyaAdi(kok) {
    const ad = ayar.dosyaAdi.split('{id}').join(kok.id).split('{kullanici}').join(kok.kullanici || 'x').split('{tarih}').join(gunYaz());
    let temiz = ad.replace(/[\\/:*?"<>|\u0000-\u001f]+/g, '_').replace(/\.md$/i, '').replace(/[. ]+$/, '').slice(0, 150);
    if (!temiz || /^(con|prn|aux|nul|com\d|lpt\d)(\..*)?$/i.test(temiz)) temiz = '_' + temiz;
    return temiz + '.md';
  }

  // ---------------------------------------------------------------- durum
  const D = { durum: 'hazir', sayi: 0, tur: 0, calisiyor: false, jeton: 0, menu: false, bolum: 'toplama', arama: '', son: null };
  let zincirKipi = false;
  async function topla() {
    if (D.calisiyor) return;
    const baslangicId = sayfaId();
    if (!baslangicId) { D.durum = 'hata'; ciz(); return; }
    const jeton = ++D.jeton;
    const gecerli = () => jeton === D.jeton && sayfaId() === baslangicId;
    D.calisiyor = true; D.durum = 'topluyor'; D.tur = 0; D.sayi = 0; ciz();
    window.scrollTo(0, 0);
    await uyu(600);
    let bos = 0, onceki = -1;
    for (let tur = 1; tur <= ayar.enCokTur && D.calisiyor && gecerli(); tur++) {
      D.tur = tur;
      const yeniS = sayfaTara();
      const basilan = dahaFazlaBas();
      const r = derle();
      const n = r ? r.toplam : 0;
      D.sayi = n;
      if (n === onceki && !yeniS && !basilan) bos++; else bos = 0;
      onceki = n;
      ciz();
      if (bos >= ayar.bosTur) break;
      window.scrollBy(0, Math.round(window.innerHeight * 0.9));
      await uyu(ayar.bekle);
    }
    if (!gecerli()) return;                                                // durduruldu ve yeniden başlatıldı ya da sayfa değişti
    sayfaTara();
    const durduruldu = !D.calisiyor;
    D.calisiyor = false;
    const r = derle();
    D.sayi = r ? r.toplam : 0;
    if (!r) D.durum = 'hata';
    else D.durum = durduruldu ? 'durdu' : 'bitti';
    ciz();
    if (r && !durduruldu && ayar.bildirim && !D.menu) bildir(zincirKipi ? tn('zincirBildirim', { n: D.sayi }) : tn('toplandiBildirim', { n: D.sayi }), 'iyi');
  }
  function durdur() { D.calisiyor = false; D.jeton++; durdurBitir(); }
  function durdurBitir() {
    const r = derle();
    D.sayi = r ? r.toplam : D.sayi;
    D.durum = r ? 'durdu' : 'hata';
    ciz();
  }
  function uyu(ms) { return new Promise((c) => setTimeout(c, ms)); }
  function veriHazir() { return D.durum === 'bitti' || D.durum === 'durdu'; }

  async function panoyaYaz(metin) {
    try { if (typeof GM_setClipboard === 'function') { GM_setClipboard(metin, 'text'); return true; } } catch (_h) { /* sıradaki yol */ }
    try { if (navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(metin); return true; } } catch (_h) { /* sıradaki yol */ }
    return false;
  }
  function yedekKutusu(metin) {
    const ta = el('textarea', { class: 'yedek-metin', readonly: '', 'aria-label': t('mdKop') });
    ta.value = metin;
    (acikModal() || UI.sar).append(ta);
    ta.focus(); ta.select();
    setTimeout(() => ta.remove(), 15000);
  }
  async function mdKopyala() {
    if (!veriHazir()) { bildir(t('veriYok'), 'kotu'); return; }
    const md = markdown(); if (!md) { bildir(t('veriYok'), 'kotu'); return; }
    if (await panoyaYaz(md.metin)) bildir(tn('kopyalandi', { n: md.sayi }), 'iyi');
    else { yedekKutusu(md.metin); bildir(t('kopyaOlmadi'), 'kotu'); }
  }
  function indir(ad, icerik, tur) {
    const a = el('a', { href: 'data:' + tur + ';charset=utf-8,' + encodeURIComponent(icerik), download: ad, class: 'gizli-bag' });
    (acikModal() || UI.sar).append(a);
    a.click();
    setTimeout(() => a.remove(), 1000);
  }
  function mdIndir() {
    if (!veriHazir()) { bildir(t('veriYok'), 'kotu'); return; }
    const md = markdown(); if (!md) { bildir(t('veriYok'), 'kotu'); return; }
    const ad = dosyaAdi(md.kok);
    indir(ad, '﻿' + md.metin, 'text/markdown');
    bildir(t('indirildi', { ad }), 'iyi');
  }
  function zincirDegis() {
    if (D.calisiyor) return;
    zincirKipi = !zincirKipi;
    const r = derle(); if (r && veriHazir()) D.sayi = r.toplam;
    ciz();
  }

  // ---------------------------------------------------------------- tanı
  function taniSatirlari() {
    const id = sayfaId(), kok = kokKaydi();
    const sat = [];
    sat.push({ d: id ? 'e' : 'b', ad: t('tSayfa'), deg: id ? '/status/…' : t('tBekliyor') });
    if (!id) return sat;
    const k = TANI.kart, g = sayfadaGorulen.size;
    sat.push({ d: k ? 'e' : (D.durum === 'hazir' ? 'b' : 'h'), ad: `${t('tKart')} · ${k}`, deg: 'article[data-testid="tweet"]' });
    sat.push({ d: g && TANI.adVar === g ? 'e' : (g ? 'h' : 'b'), ad: `${t('tAd')} · ${TANI.adVar}/${g}`, deg: '[data-testid="User-Name"]' });
    sat.push({ d: g ? (TANI.metinVar ? 'e' : 'h') : 'b', ad: `${t('tMetin')} · ${TANI.metinVar}/${g}`, deg: '[data-testid="tweetText"]' });
    sat.push({ d: !TANI.kanca ? 'h' : (TANI.yanit ? 'e' : 'b'), ad: t('tKanca'), deg: TANI.kanca ? t('tKancaVar', { yol: TANI.kanca }) : t('tKancaYok') });
    if (ayar.kaynak === 'x') {
      const xli = xVerisiVar(kok);
      const d = xli ? 'e' : (veriHazir() ? 'h' : 'b');
      sat.push({ d, ad: t('tVeri'), deg: TANI.yanit ? t('tVeriYanit', { n: TANI.yanit, t: TANI.xTweet, yol: TANI.yol }) : (veriHazir() ? t('tVeriYok') : t('tVeriBekle')) });
    }
    sat.push({ d: 'b', ad: t('tKesif'), deg: t('tKesifN', { n: TANI.kesif }) });
    sat.push({ d: 'b', ad: t('tDaha'), deg: t('tDahaN', { n: TANI.dahaFazla }) });
    return sat;
  }
  function sorunVar() { return taniSatirlari().some((s) => s.d === 'h'); }
  function rapor() {
    const isaret = { e: '✓', h: '✗', b: '–' };
    let yonetici = '';
    try { yonetici = typeof GM_info === 'object' && GM_info ? `${GM_info.scriptHandler || ''} ${GM_info.version || ''}`.trim() : ''; } catch (_h) { yonetici = ''; }
    const sat = [`AALabs ${t('ad')} (${KOD}) ${SURUM}`, `${yonetici} · ${navigator.userAgent.replace(/\s+/g, ' ').slice(0, 120)}`, `${t('dil')}: ${dilEtkin()} · ${t('tema')}: ${ayar.tema}/${temaEtkin()} · ${t('olcek')}: %${ayar.olcek} · ${t('kaynak')}: ${ayar.kaynak}`, ''];
    for (const s of taniSatirlari()) sat.push(`${isaret[s.d]} ${s.ad}: ${s.deg}`);
    sat.push('', `${t('kabul')}:`);
    for (let i = 1; i <= 5; i++) {
      const v = ayar.kabul['K' + i];
      sat.push(`K${i} ${v === 'gecti' ? '✓' : v === 'sorun' ? '✗' : v === 'atla' ? '–' : '?'} ${t('k' + i + 'm')}`);
    }
    return sat.join('\n');
  }

  // ---------------------------------------------------------------- arayüz yardımcıları
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const IKON = {
    topla: ['M12 3v12', 'm7 10 5 5 5-5', 'M5 21h14'],
    dur: ['M7 7h10v10H7z'],
    zincir: ['M9 17H7A5 5 0 0 1 7 7h2', 'M15 7h2a5 5 0 1 1 0 10h-2', 'M8 12h8'],
    kopya: ['M11 9h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z', 'M5 15V5a2 2 0 0 1 2-2h10'],
    dosya: ['M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z', 'M14 3v6h6'],
    ayar: ['M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z', 'M12 2v3', 'M12 19v3', 'm4.9 4.9 2.1 2.1', 'm17 17 2.1 2.1', 'M2 12h3', 'M19 12h3', 'm4.9 19.1 2.1-2.1', 'm17 7 2.1-2.1'],
    x: ['M18 6 6 18', 'm6 6 12 12'],
    tamam: ['M20 6 9 17l-5-5'],
    hata: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z', 'M12 8v5', 'M12 16h.01'],
    bilgi: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z', 'M12 11v5', 'M12 8h.01']
  };
  function ikon(ad, boy) {
    const s = document.createElementNS(SVG_NS, 'svg');
    s.setAttribute('viewBox', '0 0 24 24'); s.setAttribute('width', boy || 16); s.setAttribute('height', boy || 16);
    s.setAttribute('fill', 'none'); s.setAttribute('stroke', 'currentColor'); s.setAttribute('stroke-width', '2');
    s.setAttribute('stroke-linecap', 'round'); s.setAttribute('stroke-linejoin', 'round'); s.setAttribute('aria-hidden', 'true');
    for (const d of IKON[ad] || []) { const p = document.createElementNS(SVG_NS, 'path'); p.setAttribute('d', d); s.append(p); }
    return s;
  }
  function ekle(e, cocuklar) {
    for (const c of [cocuklar].flat(Infinity)) {
      if (c == null || c === false) continue;
      e.append(c instanceof Node ? c : document.createTextNode(String(c)));
    }
    return e;
  }
  function el(etiket, oz, cocuklar) {
    const e = document.createElement(etiket);
    if (oz) for (const [k, v] of Object.entries(oz)) {
      if (v == null || v === false) continue;
      if (k === 'on') { for (const [o, f] of Object.entries(v)) e.addEventListener(o, f); continue; }
      if (k === 'hidden') { e.hidden = !!v; continue; }
      e.setAttribute(k, v === true ? '' : v);
    }
    return ekle(e, cocuklar || []);
  }
  function harfli(metin, harf) {
    // "Topla (T)" — harf Bold 700
    return [metin + ' (', el('span', { class: 'kh' }, harf), ')'];
  }

  // ---------------------------------------------------------------- stil
  // TOKEN-BASLA (aalabs-tema.css 1.4.1'den)
  const TOKEN = `
  :host{--ana:#2456D6;--ana-acik:#E5EBFA;--ana-hover:#F2F5FD;--ana-uzeri:#FFFFFF;--ana-ust:#3A67DA;--vurgu:#2456D6;
    --zemin:#F6F9FC;--yuzey:#FFFFFF;--metin:#17252E;--metin-ikincil:#4E6269;--kenar:#7A9199;--ayirici:#D3DEE6;
    --basari:#18763F;--basari-bg:#E4F5E8;--uyari:#9A5B00;--uyari-bg:#FDF6D8;--hata:#C4313B;--hata-bg:#FDE8E8;--ortu:rgba(15,21,32,.45);color-scheme:light}
  :host(.koyu){--ana-acik:#1D2C4F;--ana-hover:#1B2434;--vurgu:#86A8FF;--zemin:#0F1520;--yuzey:#161E2B;--metin:#E6ECF5;--metin-ikincil:#9AA8BC;
    --kenar:#6A7B93;--ayirici:#263142;--basari:#4CC38A;--basari-bg:#13301F;--uyari:#E8AC45;--uyari-bg:#33270F;--hata:#FF8189;--hata-bg:#3A161A;--ortu:rgba(0,0,0,.6);color-scheme:dark}`;
  // TOKEN-BITIR
  const STIL = `
  [hidden]{display:none !important}
  *{box-sizing:border-box}
  .sar{font-family:"Open Sans","Segoe UI",Roboto,sans-serif;font-size:13px;line-height:1.45;color:var(--metin)}
  button,input,select,textarea{font:inherit;color:inherit}
  :focus-visible{outline:2px solid var(--vurgu);outline-offset:2px}
  .kh{font-weight:700}
  .hap{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 12px;border:0;border-radius:2px;background:var(--ana);color:var(--ana-uzeri);font-weight:600;cursor:pointer}
  .hap:hover{background:var(--ana-ust)}
  .say{background:var(--ana-uzeri);color:var(--ana);border-radius:2px;padding:0 5px;font-size:11px;font-variant-numeric:tabular-nums}
  .nokta{width:8px;height:8px;border-radius:50%;background:var(--hata);border:1px solid var(--ana-uzeri)}
  .menu{position:absolute;bottom:48px;width:270px;background:var(--yuzey);border:1px solid var(--kenar);border-radius:4px;padding:4px 0}
  .sag .menu,.sag .bildirim{right:0}.sol .menu,.sol .bildirim{left:0}
  .mbas{padding:6px 12px;font-size:12px;color:var(--metin-ikincil);display:grid;grid-template-columns:14px 1fr;gap:2px 6px;align-items:start}
  .mbas svg{margin-top:2px}.mbas.iyi{color:var(--basari)}.mbas.kotu{color:var(--hata)}
  .mbas small{grid-column:2;color:var(--metin-ikincil);font-size:11px}
  .cubuk{height:4px;margin:0 12px 6px;background:var(--ayirici);border-radius:2px;overflow:hidden}
  .cubuk i{display:block;height:100%;width:30%;background:var(--ana)}
  .ms{display:flex;align-items:center;gap:8px;width:100%;min-height:28px;padding:0 12px;border:0;background:none;color:var(--metin);cursor:pointer;text-align:left}
  .ms:hover,.ms:focus-visible{background:var(--ana-acik)}
  .ms:focus-visible{outline-offset:-2px}
  .ms .k{margin-left:auto;color:var(--metin-ikincil);font-size:12px}
  .ms[disabled]{opacity:.55;cursor:not-allowed}
  .ayr{height:1px;background:var(--ayirici);margin:4px 0}
  .bildirim{position:absolute;bottom:48px;display:flex;align-items:center;gap:8px;padding:8px 12px;max-width:340px;background:var(--yuzey);border:1px solid var(--kenar);border-radius:4px;color:var(--metin)}
  .bildirim.iyi svg{color:var(--basari)}.bildirim.kotu{border-color:var(--hata);background:var(--hata-bg)}.bildirim.kotu svg{color:var(--hata)}
  dialog .bildirim{position:fixed;bottom:16px;left:50%;transform:translateX(-50%)}
  dialog{padding:0;border:1px solid var(--kenar);border-radius:6px;background:var(--yuzey);color:var(--metin);width:min(760px,calc(100vw - 32px));height:min(540px,calc(100vh - 32px));overflow:hidden}
  dialog::backdrop{background:var(--ortu)}
  .pen{display:grid;grid-template-rows:auto 1fr;height:100%}
  .pbas{display:flex;align-items:center;gap:8px;padding:8px 8px 8px 12px;border-bottom:1px solid var(--ayirici)}
  .pbas .bas{font-weight:600;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .kod{display:inline-grid;place-items:center;min-width:34px;height:20px;padding:0 4px;border-radius:2px;background:var(--ana);color:var(--ana-uzeri);font-weight:600;font-size:11px;letter-spacing:.04em}
  .pgov{display:grid;grid-template-columns:200px minmax(0,1fr);min-height:0}
  .gez{border-right:1px solid var(--ayirici);padding:8px;display:flex;flex-direction:column;gap:2px;background:var(--zemin);overflow:auto}
  .ara{width:100%;min-height:28px;margin-bottom:6px;padding:0 8px;border:1px solid var(--kenar);border-radius:2px;background:var(--yuzey)}
  .grp{font-size:11px;letter-spacing:.06em;color:var(--metin-ikincil);padding:8px 6px 2px;font-weight:600}
  .gb{display:block;width:100%;min-height:28px;padding:0 8px;border:0;border-radius:2px;background:none;text-align:left;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .gb:hover{background:var(--ana-hover)}
  .gb[aria-current="true"]{background:var(--ana-acik);font-weight:600}
  .icerik{padding:14px 16px;overflow:auto;display:flex;flex-direction:column;gap:12px}
  h3{margin:0;font-size:15px;font-weight:600}
  h4{margin:6px 0 0;font-size:12px;font-weight:600;color:var(--metin-ikincil);text-transform:uppercase;letter-spacing:.05em}
  .satir{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;align-items:center}
  .satir small,.not{color:var(--metin-ikincil);font-size:12px}
  .satir small{grid-column:1}
  .giris{min-height:28px;padding:0 8px;border:1px solid var(--kenar);border-radius:2px;background:var(--yuzey);color:var(--metin)}
  .giris.hatali{border-color:var(--hata)}
  ::placeholder{color:var(--metin-ikincil);opacity:1}
  .onay{display:flex;gap:8px;align-items:flex-start;cursor:pointer}
  .onay input{margin-top:3px;accent-color:var(--ana)}
  .onay small{display:block;color:var(--metin-ikincil);font-size:12px}
  .seg{display:inline-flex;border:1px solid var(--kenar);border-radius:2px;overflow:hidden;flex-wrap:wrap}
  .seg button{min-height:28px;padding:0 10px;border:0;border-right:1px solid var(--kenar);background:var(--yuzey);cursor:pointer}
  .seg button:last-child{border-right:0}
  .seg button[aria-pressed="true"]{background:var(--ana);color:var(--ana-uzeri)}
  .dg{display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:0 10px;border:1px solid var(--kenar);border-radius:2px;background:var(--yuzey);cursor:pointer;white-space:nowrap}
  .dg:hover{background:var(--ana-hover)}
  .dg.ikon{width:32px;padding:0;justify-content:center}
  .dg.kucuk{min-height:24px;padding:0 8px;font-size:12px}
  .dg[aria-pressed="true"]{background:var(--ana);border-color:var(--ana);color:var(--ana-uzeri)}
  .tani{display:grid;grid-template-columns:20px minmax(0,1fr) auto;gap:4px 8px;font-size:12px;align-items:baseline}
  .tani .e{color:var(--basari);font-weight:700}.tani .h{color:var(--hata);font-weight:700}.tani .b{color:var(--metin-ikincil)}
  .tani code{font-size:11px;color:var(--metin-ikincil);overflow-wrap:anywhere}
  .madde{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 10px;padding:8px;border:1px solid var(--ayirici);border-radius:4px}
  .madde small{grid-column:1/-1;color:var(--metin-ikincil);font-size:12px}
  .sira3{display:flex;gap:4px;flex-wrap:wrap}
  .yedek-metin{position:fixed;left:16px;right:16px;bottom:72px;height:120px;z-index:2;background:var(--yuzey);color:var(--metin);border:1px solid var(--kenar)}
  .gizli-bag{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .durum-bolge{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  @media (max-width:620px){.pgov{grid-template-columns:minmax(0,1fr)}.gez{display:none}}
  @media (prefers-reduced-motion:reduce){*{transition:none !important}}`;
  const carp = (s) => s.replace(/(^|[^\w.#-])(\d+(?:\.\d+)?)px/g, (m, on, n) => (Number(n) <= 2 ? m : `${on}calc(${n}px*var(--o))`));

  // ---------------------------------------------------------------- tema
  function siteKoyuMu() {
    try {
      const c = getComputedStyle(document.body || document.documentElement).backgroundColor || '';
      const m = /rgba?\((\d+),\s*(\d+),\s*(\d+)/.exec(c);
      if (!m) return matchMedia('(prefers-color-scheme: dark)').matches;
      const [r, g, b] = [m[1], m[2], m[3]].map((x) => { const v = x / 255; return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; });
      return 0.2126 * r + 0.7152 * g + 0.0722 * b < 0.4;
    } catch (_h) { return false; }
  }
  function temaEtkin() { return ayar.tema === 'site' ? (siteKoyuMu() ? 'koyu' : 'acik') : ayar.tema; }

  // ---------------------------------------------------------------- arayüz
  const UI = { host: null, kok: null, sar: null, pencereKap: null, dialog: null, bolge: null, oncekiOdak: null, bildirimZaman: 0, yakala: null, odakSessiz: false, bildirim: null, imza: '' };
  function acikModal() { return UI.dialog && UI.dialog.open ? UI.dialog : null; }
  function zamanla() { if (zamanla.bekliyor) return; zamanla.bekliyor = true; requestAnimationFrame(() => { zamanla.bekliyor = false; if (UI.sar) ciz(); }); }

  function uiKur() {
    if (UI.host || !document.body) return;
    const host = document.createElement('div');
    host.setAttribute('data-aalabs', KOD);
    host.style.cssText = 'position:fixed;bottom:16px;z-index:2147483000;';
    const kok = host.attachShadow({ mode: 'closed' });
    const stil = document.createElement('style');
    stil.textContent = TOKEN + carp(STIL);
    kok.append(stil);
    const sar = el('div', { class: 'sar' });
    const bolge = el('div', { class: 'durum-bolge', role: 'status', 'aria-live': 'polite' });
    const pencereKap = el('div', { class: 'sar' });
    kok.append(sar, pencereKap, bolge);
    document.body.append(host);
    Object.assign(UI, { host, kok, sar, bolge, pencereKap });
    kok.addEventListener('keydown', kokTus, true);
    const deneme = window.__AALABS_TEST__;
    let testMi = false;
    try { testMi = typeof GM_info === 'object' && GM_info && GM_info.scriptHandler === 'Test'; } catch (_h) { testMi = false; }
    if (testMi && deneme && typeof deneme === 'object') {
      deneme.tws = { kok, ayar: () => ayar, durum: () => D, md: () => markdown(), veri: () => VERI, tani: () => taniSatirlari(), rapor: () => rapor(), zincir: () => zincirKipi, metin: METIN };
    }
    ciz();
  }

  function ciz(pencereDe) {
    if (!UI.sar) return;
    const id = sayfaId();
    UI.host.style.display = ayar.yalnizTweet && !id && !acikModal() ? 'none' : '';
    UI.host.style.right = ayar.konum === 'sag' ? '16px' : '';
    UI.host.style.left = ayar.konum === 'sol' ? '16px' : '';
    UI.host.classList.toggle('koyu', temaEtkin() === 'koyu');
    UI.host.style.setProperty('--o', String(ayar.olcek / 100));
    // Yapı değişmediyse yalnız yazıları güncelle: toplarken düğmeler yerinde kalır, tıklama kaybolmaz
    const bildirimVar = !!(UI.bildirim && Date.now() < UI.bildirimZaman && !D.menu && !acikModal());
    const imza = [D.menu, D.durum, D.calisiyor, zincirKipi, veriHazir(), !!id, dilEtkin(), ayar.konum, ayar.kaynak,
      xVerisiVar(kokKaydi()), sorunVar(), bildirimVar ? UI.bildirimZaman : 0, ayar.kisayol.ayarlar].join('|');
    if (imza === UI.imza && UI.sar.firstChild) {
      const yazi = UI.sar.querySelector('.mbas > span'); if (yazi) yazi.textContent = durumMetni();
      const say = UI.sar.querySelector('.say'); if (say) say.textContent = sayiYaz(D.sayi);
      const hap = UI.sar.querySelector('.hap'); if (hap) hap.setAttribute('aria-label', `AALabs ${t('ad')} · ${durumMetni()}`);
      if (UI.bolge && D.durum !== 'topluyor') UI.bolge.textContent = durumMetni();
    } else {
      UI.imza = imza;
      const odakAnahtar = UI.kok.activeElement && UI.kok.activeElement.getAttribute && UI.kok.activeElement.getAttribute('data-k');
      UI.sar.replaceChildren(...panelCiz());
      if (odakAnahtar) { const o = UI.sar.querySelector(`[data-k="${odakAnahtar}"]`); if (o && !o.disabled) o.focus(); }
    }
    if (acikModal()) {
      if (pencereDe) pencereIcerik();
      else if (D.bolum === 'tani') taniYenile();
    }
  }
  function taniYenile() {
    const eski = UI.dialog && UI.dialog.querySelector('.tani');
    if (!eski) return;
    const yeni = sayfaKur('tani').find((n) => n.classList && n.classList.contains('tani'));
    if (yeni) eski.replaceWith(yeni);
  }
  function yaziyor() {
    const a = UI.kok && UI.kok.activeElement;
    return !!(a && a.tagName === 'INPUT' && a.type !== 'checkbox' && !a.classList.contains('ara') && !a.getAttribute('data-kis'));
  }

  function durumMetni() {
    if (!sayfaId() && !D.calisiyor && D.durum !== 'hata') return t('bekliyor');
    if (D.durum === 'topluyor') return tn('topluyor', { n: D.sayi, tur: D.tur });
    if (D.durum === 'bitti') return zincirKipi ? tn('bittiZ', { n: D.sayi }) : tn('bitti', { n: D.sayi });
    if (D.durum === 'durdu') return tn('durdu', { n: D.sayi });
    if (D.durum === 'hata') return t('hata');
    return t('hazir');
  }
  function panelCiz() {
    const kap = el('div', { class: ayar.konum === 'sag' ? 'sag' : 'sol', style: 'position:relative' });
    const veri = veriHazir(), top = D.calisiyor;
    const kok = kokKaydi();
    if (D.menu) {
      const cls = D.durum === 'bitti' ? 'iyi' : D.durum === 'hata' ? 'kotu' : '';
      const ik = D.durum === 'bitti' ? 'tamam' : D.durum === 'hata' ? 'hata' : 'bilgi';
      let kaynak = null;
      if (veri || top) kaynak = el('small', {}, ayar.kaynak !== 'x' ? t('kaynakSecim') : (xVerisiVar(kok) ? t('kaynakX') : (veri ? t('kaynakS') : t('kaynakX'))));
      const menu = el('div', { class: 'menu', role: 'menu', 'aria-label': `AALabs ${t('ad')}` }, [
        el('div', { class: 'mbas ' + cls }, [ikon(ik, 14), el('span', {}, durumMetni()), kaynak]),
        top ? el('div', { class: 'cubuk', 'aria-hidden': 'true' }, el('i')) : null,
        top
          ? el('button', { class: 'ms', type: 'button', role: 'menuitem', 'data-k': 'D', on: { click: durdur } }, [ikon('dur'), el('span', {}, harfli(t('durdur'), 'D'))])
          : el('button', { class: 'ms', type: 'button', role: 'menuitem', 'data-k': 'T', disabled: !sayfaId(), on: { click: () => { topla(); } } }, [ikon('topla'), el('span', {}, harfli(t('topla'), 'T'))]),
        el('button', { class: 'ms', type: 'button', role: 'menuitemcheckbox', 'aria-checked': String(zincirKipi), 'data-k': 'Z', disabled: top || !sayfaId(), on: { click: zincirDegis } },
          [ikon('zincir'), el('span', {}, harfli(t('zincir'), 'Z')), zincirKipi ? el('span', { class: 'k' }, '✓') : null]),
        el('div', { class: 'ayr', role: 'separator' }),
        el('button', { class: 'ms', type: 'button', role: 'menuitem', 'data-k': 'K', disabled: !veri, title: veri ? null : t('veriYok'), on: { click: mdKopyala } }, [ikon('kopya'), el('span', {}, harfli(t('mdKop'), 'K'))]),
        el('button', { class: 'ms', type: 'button', role: 'menuitem', 'data-k': 'M', disabled: !veri, title: veri ? null : t('veriYok'), on: { click: mdIndir } }, [ikon('dosya'), el('span', {}, harfli(t('mdInd'), 'M'))]),
        el('div', { class: 'ayr', role: 'separator' }),
        el('button', { class: 'ms', type: 'button', role: 'menuitem', 'data-k': 'A', on: { click: ayarlariAc } }, [ikon('ayar'), el('span', {}, harfli(t('ayarlar'), 'A')), ayar.kisayol.ayarlar ? el('span', { class: 'k' }, ayar.kisayol.ayarlar) : null])
      ]);
      kap.append(menu);
    }
    if (UI.bildirim && Date.now() < UI.bildirimZaman && !D.menu && !acikModal()) kap.append(UI.bildirim);
    const sayi = top || veri ? el('span', { class: 'say' }, sayiYaz(D.sayi)) : null;
    const nokta = sorunVar() && (veri || D.durum === 'hata') ? el('span', { class: 'nokta', title: t('bTani') }) : null;
    kap.append(el('button', { class: 'hap', type: 'button', 'data-k': 'hap', 'aria-haspopup': 'menu', 'aria-expanded': String(D.menu), 'aria-label': `AALabs ${t('ad')} · ${durumMetni()}`, on: { click: menuDegis } }, [KOD, sayi, nokta]));
    if (UI.bolge) UI.bolge.textContent = D.durum === 'topluyor' ? '' : durumMetni();
    return [kap];
  }
  function menuDegis() {
    D.menu = !D.menu;
    ciz();
    if (D.menu) { const ilk = UI.sar.querySelector('.ms:not([disabled])'); if (ilk) ilk.focus(); }
    else { const h = UI.sar.querySelector('.hap'); if (h) h.focus(); }
  }
  function bildir(metin, tur) {
    UI.bildirim = el('div', { class: 'bildirim ' + (tur || ''), role: tur === 'kotu' ? 'alert' : 'status' }, [ikon(tur === 'kotu' ? 'hata' : 'tamam'), el('span', {}, metin)]);
    UI.bildirimZaman = Date.now() + 4000;
    const m = acikModal();
    if (m) { const eski = m.querySelector('.bildirim'); if (eski) eski.remove(); m.append(UI.bildirim); setTimeout(() => { if (UI.bildirim && UI.bildirim.parentNode === m && Date.now() >= UI.bildirimZaman) UI.bildirim.remove(); }, 4100); return; }
    if (D.menu) { D.menu = false; }
    ciz();
    setTimeout(() => { if (Date.now() >= UI.bildirimZaman) ciz(); }, 4100);
  }

  // ------------------------------------------------ Ayarlar penceresi
  function ayarlariAc() {
    if (!UI.sar) return;
    if (acikModal()) return;
    UI.oncekiOdak = document.activeElement;
    D.menu = false;
    const d = el('dialog', { 'aria-label': `${t('ayarlar')} · AALabs ${t('ad')}` });
    d.addEventListener('close', () => {
      UI.yakala = null;
      d.remove(); UI.dialog = null; ciz();
      const o = UI.oncekiOdak; UI.oncekiOdak = null;
      try {
        if (!o || o === UI.host || o === document.body) { const h = UI.sar.querySelector('.hap'); if (h) h.focus(); }
        else if (o.focus && document.contains(o)) o.focus();
      } catch (_h) { /* odak dönmezse sorun değil */ }
      if (UI.bildirim && Date.now() < UI.bildirimZaman) setTimeout(() => ciz(), Math.max(0, UI.bildirimZaman - Date.now()) + 50);
    });
    UI.pencereKap.append(d);                                        // panel yeniden çizilince pencere silinmesin
    UI.dialog = d;
    pencereIcerik(true);
    d.showModal();
    ciz();
    const a = d.querySelector('.ara'); if (a) a.focus();
  }
  function bolumler() {
    return {
      app: [['toplama', t('bToplama')], ['disa', t('bDisa')], ['panel', t('bPanel')]],
      ortak: [['genel', t('bGenel')], ['kisayol', t('bKisayol')], ['tani', t('bTani')], ['hakkinda', t('bHakkinda')]]
    };
  }
  function degistir(k, v) { ayar[k] = v; ayarYaz(); if (k === 'dil') menuKomutlari(); ciz(true); }
  const seg = (k, secenekler) => el('span', { class: 'seg', role: 'group' }, secenekler.map(([v, a]) =>
    el('button', { type: 'button', 'aria-pressed': String(ayar[k] === v), on: { click: () => degistir(k, v) } }, a)));
  const onayKutusu = (k, metin, not) => el('label', { class: 'onay' }, [
    el('input', { type: 'checkbox', checked: ayar[k], on: { change: (e) => degistir(k, e.target.checked) } }),
    el('span', {}, [metin, not ? el('small', {}, not) : null])]);
  const satir = (metin, not, denetim) => el('div', { class: 'satir' }, [el('span', {}, metin), denetim, not ? el('small', {}, not) : null]);
  const secim = (k, liste, etiket) => el('select', { class: 'giris', 'aria-label': etiket, on: { change: (e) => degistir(k, Number(e.target.value)) } },
    liste.map(([v, a]) => el('option', { value: String(v), selected: ayar[k] === v }, a)));

  function sayfaKur(b) {
    const sn = t('sn');
    const ondalik = (ms) => (ms / 1000).toFixed(1).replace('.', dilEtkin() === 'tr' ? ',' : '.');
    switch (b) {
      case 'toplama': return [
        el('h3', {}, `${KOD} › ${t('bToplama')}`),
        satir(t('kaynak'), t('kaynakN'), seg('kaynak', [['x', t('kX')], ['sayfa', t('kS')]])),
        satir(t('bekle'), t('bekleN'), secim('bekle', SECENEK.bekle.map((v) => [v, `${ondalik(v)} ${sn}`]), t('bekle'))),
        satir(t('bos'), t('bosN'), secim('bosTur', SECENEK.bosTur.map((v) => [v, String(v)]), t('bos'))),
        satir(t('enCok'), t('enCokN'), el('input', { class: 'giris', style: 'width:84px', inputmode: 'numeric', value: String(ayar.enCokTur), 'aria-label': t('enCok'),
          on: { change: (e) => { const n = parseInt(e.target.value, 10); if (Number.isInteger(n) && n >= 20 && n <= 2000) { degistir('enCokTur', n); } else { e.target.classList.add('hatali'); e.target.value = String(ayar.enCokTur); } } } })),
        onayKutusu('dahaFazla', t('dahaFazla'))];
      case 'disa': return [
        el('h3', {}, `${KOD} › ${t('bDisa')}`),
        onayKutusu('agac', t('agac'), t('agacN')), onayKutusu('sade', t('sade'), t('sadeN')),
        onayKutusu('metrik', t('metrik')), onayKutusu('alinti', t('alinti')),
        satir(t('dosyaAdi'), t('dosyaAdiN'), el('input', { class: 'giris', style: 'width:200px', value: ayar.dosyaAdi, 'aria-label': t('dosyaAdi'),
          on: { change: (e) => { const v = e.target.value.trim(); if (v && v.length <= 80) degistir('dosyaAdi', v); else e.target.value = ayar.dosyaAdi; } } })),
        satir(t('sira'), '', el('select', { class: 'giris', 'aria-label': t('sira'), on: { change: (e) => degistir('sira', e.target.value) } },
          [el('option', { value: 'sayfa', selected: ayar.sira === 'sayfa' }, t('siraS')), el('option', { value: 'zaman', selected: ayar.sira === 'zaman' }, t('siraZ'))]))];
      case 'panel': return [
        el('h3', {}, `${KOD} › ${t('bPanel')}`),
        satir(t('konum'), '', seg('konum', [['sag', t('sagAlt')], ['sol', t('solAlt')]])),
        onayKutusu('yalnizTweet', t('yalniz')), onayKutusu('bildirim', t('bitince'), t('bitinceN'))];
      case 'genel': return [
        el('h3', {}, t('bGenel')),
        satir(t('dil'), ayar.dil === 'sistem' ? t('algilanan', { dil: dilEtkin() === 'tr' ? 'Türkçe' : 'English' }) : '', seg('dil', [['tr', 'Türkçe'], ['en', 'English'], ['sistem', t('tarayici')]])),
        satir(t('tema'), '', seg('tema', [['site', t('siteyi')], ['acik', t('acik')], ['koyu', t('koyu')]])),
        satir(t('olcek'), '', secim('olcek', SECENEK.olcek.map((v) => [v, dilEtkin() === 'tr' ? `%${v}` : `${v}%`]), t('olcek'))),
        el('div', {}, el('button', { class: 'dg', type: 'button', on: { click: () => { const k = ayar.kabul; ayar = kopyala(VARSAYILAN); ayar.kabul = k; ayarYaz(); menuKomutlari(); ciz(true); bildir(t('varsayilanOldu'), 'iyi'); } } }, t('varsayilan')))];
      case 'kisayol': return [el('h3', {}, t('bKisayol')),
        ...[['ayarlar', t('kAyar')], ['topla', t('kTopla')], ['zincir', t('kZincir')], ['kopya', t('kKop')]].map(([k, a]) => satir(a, '', kisayolKutusu(k, a))),
        el('p', { class: 'not', style: 'margin:0' }, t('kNot'))];
      case 'tani': {
        const sat = taniSatirlari();
        const tani = el('div', { class: 'tani' }, sat.map((s) => [el('span', { class: s.d }, s.d === 'e' ? '✓' : s.d === 'h' ? '✗' : '–'), el('span', {}, s.ad), el('code', {}, s.deg)]));
        const yanit = Object.values(ayar.kabul).filter(Boolean).length;
        const maddeler = [1, 2, 3, 4, 5].map((i) => el('div', { class: 'madde' }, [
          el('span', {}, `K${i} · ${t('k' + i + 'm')}`),
          el('span', { class: 'sira3', role: 'group', 'aria-label': `K${i}` }, [['gecti', t('gecti')], ['sorun', t('sorun')], ['atla', t('atla')]].map(([v, a]) =>
            el('button', { class: 'dg kucuk', type: 'button', 'aria-pressed': String(ayar.kabul['K' + i] === v),
              on: { click: () => { ayar.kabul['K' + i] = ayar.kabul['K' + i] === v ? null : v; ayarYaz(); ciz(true); } } }, a))),
          el('small', {}, t('nasil') + t('k' + i + 'i'))]));
        return [el('h3', {}, t('bTani')), tani, el('h4', {}, `${t('kabul')} · ${yanit}/5`), ...maddeler,
          el('div', {}, el('button', { class: 'dg', type: 'button', on: { click: async () => { const r = rapor(); if (await panoyaYaz(r)) bildir(t('raporKopyalandi'), 'iyi'); else { yedekKutusu(r); bildir(t('kopyaOlmadi'), 'kotu'); } } } }, [ikon('kopya'), t('rapor')]))];
      }
      case 'hakkinda': {
        const dosya = el('input', { type: 'file', accept: 'application/json,.json', hidden: true, on: { change: yedekAl } });
        return [el('h3', {}, t('bHakkinda')),
          el('div', {}, [el('b', { style: 'font-weight:600' }, `AALabs ${t('ad')}`), ' ', el('span', { class: 'kod' }, KOD)]),
          el('div', { class: 'not' }, [t('surum', { s: SURUM }), el('br'), t('aps')]),
          el('h4', {}, t('yedek')),
          el('div', { style: 'display:flex;gap:8px;flex-wrap:wrap' }, [
            el('button', { class: 'dg', type: 'button', on: { click: () => { indir(`aalabs-tws-ayar_${gunYaz()}.json`, JSON.stringify({ aalabs: KOD, surum: SURUM, ayar }, null, 2), 'application/json'); bildir(t('yedekHazir'), 'iyi'); } } }, t('disaAl')),
            el('button', { class: 'dg', type: 'button', on: { click: () => dosya.click() } }, t('iceAl')), dosya])];
      }
    }
    return [];
  }
  function yedekAl(e) {
    const f = e.target.files && e.target.files[0];
    if (!f) return;
    const r = new FileReader();
    r.onload = () => {
      try {
        const j = JSON.parse(String(r.result));
        if (!j || j.aalabs !== KOD || !j.ayar || typeof j.ayar !== 'object') throw new Error('biçim');
        ayar = dogrula(j.ayar); ayarYaz(); menuKomutlari(); ciz(true); bildir(t('yedekAlindi'), 'iyi');
      } catch (_h) { bildir(t('yedekBozuk'), 'kotu'); }
    };
    r.readAsText(f);
  }
  function kisayolKutusu(k, etiket) {
    const deger = ayar.kisayol[k];
    const yakalaniyor = UI.yakala === k;
    const kutu = el('input', { class: 'giris', style: 'width:140px', readonly: true, 'data-kis': k, 'aria-label': etiket,
      value: yakalaniyor ? '' : deger, placeholder: yakalaniyor ? t('kBekle') : t('kYok'),
      on: {
        focus: () => { if (UI.odakSessiz) { UI.odakSessiz = false; return; } UI.yakala = k; kutu.placeholder = t('kBekle'); kutu.value = ''; },
        mousedown: () => { if (UI.yakala !== k) { UI.yakala = k; kutu.value = ''; kutu.placeholder = t('kBekle'); } },
        blur: () => { if (UI.yakala === k) { UI.yakala = null; kutu.value = ayar.kisayol[k]; kutu.placeholder = t('kYok'); } },
        keydown: (e) => {
          if (e.key === 'Tab') return;                                   // Tab engellenmez
          if (UI.yakala !== k) {                                         // odak var ama yakalama yok: Enter/Boşluk başlatır
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); UI.yakala = k; kutu.placeholder = t('kBekle'); kutu.value = ''; }
            return;
          }
          e.preventDefault(); e.stopPropagation();
          if (e.repeat) return;
          if (e.key === 'Escape') { kutu.blur(); return; }
          if (e.key === 'Delete' || e.key === 'Backspace') { ayar.kisayol[k] = ''; ayarYaz(); UI.yakala = null; ciz(true); return; }
          const kombo = tusKombo(e);
          if (!kombo) return;
          if (!komboKanonikMi(kombo) || yasakMi(kombo)) { bildir(t('kRed', { tus: kombo }), 'kotu'); return; }
          const cakisan = Object.keys(ayar.kisayol).find((o) => o !== k && ayar.kisayol[o] === kombo);
          if (cakisan) { bildir(t('kCakisma', { is: { ayarlar: t('kAyar'), topla: t('kTopla'), zincir: t('kZincir'), kopya: t('kKop') }[cakisan] }), 'kotu'); return; }
          ayar.kisayol[k] = kombo; ayarYaz(); UI.yakala = null; ciz(true);
        }
      } });
    return kutu;
  }
  function pencereIcerik(ilk) {
    const d = UI.dialog; if (!d) return;
    const { app, ortak } = bolumler();
    const tum = [...app, ...ortak];
    if (!tum.some((b) => b[0] === D.bolum)) D.bolum = 'toplama';
    // aramayla süz: bölüm adı ya da sayfadaki metin eşleşirse
    const q = katla(D.arama.trim());
    const eslesen = (b) => !q || katla(b[1]).includes(q) || sayfaKur(b[0]).some((n) => katla(n.textContent || '').includes(q));
    const gorunen = tum.filter(eslesen);
    if (q && gorunen.length && !gorunen.some((b) => b[0] === D.bolum)) D.bolum = gorunen[0][0];
    const odaklanir = () => [...d.querySelectorAll('button, input, select, textarea')];
    const etkin = UI.kok.activeElement;
    const odak = ilk || !etkin || !d.contains(etkin) ? null
      : etkin.classList.contains('ara') ? 'ara'
      : etkin.getAttribute('data-kis') ? 'kis:' + etkin.getAttribute('data-kis')
      : 'sira:' + odaklanir().indexOf(etkin);
    const gb = (b) => el('button', { class: 'gb', type: 'button', title: b[1], 'aria-current': String(D.bolum === b[0]), hidden: !gorunen.includes(b), on: { click: () => { D.bolum = b[0]; pencereIcerik(); const i = d.querySelector('.icerik'); if (i) i.scrollTop = 0; } } }, b[1]);
    const ara = el('input', { class: 'ara', type: 'search', placeholder: t('ara'), 'aria-label': t('ara'), value: D.arama,
      on: { input: (e) => { if (e.isComposing) return; D.arama = e.target.value; pencereIcerik(); }, compositionend: (e) => { D.arama = e.target.value; pencereIcerik(); } } });
    const icerik = gorunen.length ? sayfaKur(D.bolum) : [el('p', { class: 'not' }, t('aramaYok'))];
    const bil = d.querySelector('.bildirim');
    d.replaceChildren(el('div', { class: 'pen' }, [
      el('div', { class: 'pbas' }, [el('span', { class: 'kod' }, KOD), el('span', { class: 'bas' }, `${t('ayarlar')} · AALabs ${t('ad')}`),
        el('button', { class: 'dg ikon', type: 'button', 'aria-label': t('kapat'), title: t('kapat'), on: { click: () => d.close() } }, ikon('x'))]),
      el('div', { class: 'pgov' }, [
        el('nav', { class: 'gez', 'aria-label': t('ayarlar') }, [ara, el('div', { class: 'grp' }, KOD), app.map(gb), el('div', { class: 'grp' }, t('ortak')), ortak.map(gb)]),
        el('div', { class: 'icerik' }, icerik)])]));
    if (bil && Date.now() < UI.bildirimZaman) d.append(bil);
    d.setAttribute('aria-label', `${t('ayarlar')} · AALabs ${t('ad')}`);
    if (odak === 'ara') { const a = d.querySelector('.ara'); a.focus(); a.setSelectionRange(a.value.length, a.value.length); }
    else if (odak && odak.startsWith('kis:')) { const k = d.querySelector(`[data-kis="${odak.slice(4)}"]`); if (k) { UI.odakSessiz = !UI.yakala; k.focus(); } }
    else if (odak && odak.startsWith('sira:')) { const o = odaklanir()[Number(odak.slice(5))]; if (o && !o.disabled && !o.hidden) o.focus(); }
  }

  // ---------------------------------------------------------------- klavye
  function kokTus(e) {
    if (acikModal()) return;                                              // pencere kendi tuşlarını yönetir
    if (!D.menu) return;
    if (e.key === 'Escape') { e.preventDefault(); menuDegis(); return; }
    const ogeler = [...UI.sar.querySelectorAll('.ms:not([disabled])')];
    const i = ogeler.indexOf(UI.kok.activeElement);
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (!ogeler.length) return;
      const n = e.key === 'ArrowDown' ? (i + 1) % ogeler.length : (i <= 0 ? ogeler.length - 1 : i - 1);
      ogeler[n].focus(); return;
    }
    if (e.ctrlKey || e.altKey || e.metaKey || e.repeat) return;
    const harf = /^Key([A-Z])$/.exec(e.code || '');
    if (!harf) return;
    const hedef = UI.sar.querySelector(`.ms[data-k="${harf[1]}"]`);
    if (hedef) { e.preventDefault(); e.stopPropagation(); if (!hedef.disabled) hedef.click(); }
  }
  function belgeTus(e) {
    if (e.repeat || e.defaultPrevented) return;
    if (UI.yakala) return;
    const kombo = tusKombo(e);
    if (!kombo) return;
    const yazi = (() => { const a = document.activeElement; return a && (a.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName)); })();
    if (yazi && !e.ctrlKey && !e.metaKey) return;
    const is = Object.keys(ayar.kisayol).find((k) => ayar.kisayol[k] && ayar.kisayol[k] === kombo);
    if (!is) return;
    e.preventDefault(); e.stopPropagation();
    if (is === 'ayarlar') { if (acikModal()) UI.dialog.close(); else ayarlariAc(); }
    else if (is === 'topla') { if (D.calisiyor) durdur(); else topla(); }
    else if (is === 'zincir') zincirDegis();
    else if (is === 'kopya') mdKopyala();
  }

  // ---------------------------------------------------------------- menü komutları
  let menuKimlik = [];
  function menuKomutlari() {
    if (typeof GM_registerMenuCommand !== 'function') return;
    if (typeof GM_unregisterMenuCommand !== 'function' && menuKimlik.length) return;  // eskisi silinemiyor: çoğaltma
    if (typeof GM_unregisterMenuCommand === 'function') menuKimlik.forEach((k) => { try { GM_unregisterMenuCommand(k); } catch (_h) {} });
    try { menuKimlik = [GM_registerMenuCommand(t('menuKomut'), ayarlariAc, 'a')].filter((k) => k != null); } catch (_h) { menuKimlik = []; }
  }

  // ---------------------------------------------------------------- başlat
  kancaKur();
  let sonId = sayfaId();
  function izle() {
    const id = sayfaId();
    if (id !== sonId) {
      sonId = id;
      if (D.calisiyor) { D.calisiyor = false; D.jeton++; }
      D.durum = 'hazir'; D.sayi = 0; D.tur = 0; zincirKipi = false;
      sayfadaGorulen.clear();
      Object.assign(TANI, { dahaFazla: 0, kesif: 0, kart: 0, adVar: 0, metinVar: 0 });
      basilanlar = new WeakSet();
    }
    if (UI.sar) {
      const koyu = temaEtkin() === 'koyu';
      if (UI.host.classList.contains('koyu') !== koyu || (UI.host.style.display === 'none') !== (ayar.yalnizTweet && !id && !acikModal())) ciz();
    }
  }
  function disTik(e) {
    if (!D.menu || !UI.host) return;
    const yol = e.composedPath ? e.composedPath() : [];
    if (!yol.includes(UI.host)) { D.menu = false; ciz(); }
  }
  function basla() {
    uiKur();
    menuKomutlari();
    document.addEventListener('keydown', belgeTus, true);
    document.addEventListener('pointerdown', disTik, true);
    setInterval(izle, 500);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', basla, { once: true });
  else basla();
})();
