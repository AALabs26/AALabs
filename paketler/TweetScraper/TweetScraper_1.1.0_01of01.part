      sadeN: 'Sayılar, tarihler ve bağlantılar atılır; dosya küçülür.',
      metrik: 'Cevap, RT ve beğeni sayıları',
      alinti: 'Alıntılanan tweet',
      dosyaAdi: 'Dosya adı',
      dosyaAdiN: '{id}, {kullanici} ve {tarih} kullanılabilir.',
      sira: 'Sıra',
      siraS: 'Sayfadaki sıra',
      siraZ: 'Zamana göre',
      konum: 'Panel konumu',
      sagAlt: 'Sağ alt',
      solAlt: 'Sol alt',
      yalniz: 'Yalnız tweet sayfasında göster',
      bitince: 'Bitince bildirim göster',
      bitinceN: '4 sn görünür.',
      dil: 'Dil',
      tarayici: 'Tarayıcı dili',
      algilanan: 'Algılanan: {dil}',
      tema: 'Tema',
      siteyi: 'Siteyi izle',
      acik: 'Açık',
      koyu: 'Koyu',
      olcek: 'Ölçek',
      varsayilan: 'Varsayılana dön',
      varsayilanOldu: 'Ayarlar varsayılana döndü.',
      kAyar: 'Ayarları aç',
      kTopla: 'Topla',
      kZincir: 'Yalnız yazarın zinciri',
      kKop: 'Markdown kopyala',
      kYok: 'yok',
      kBekle: 'Tuşa bas…',
      kNot: 'Kutuya tıkla, tuşa bas. Silmek için Delete. Tarayıcının ve X\'in tuşları kabul edilmez.',
      kRed: 'Bu tuş kullanılamaz: {tus}. Ctrl+Shift, Alt ya da Ctrl ile noktalama dene.',
      kCakisma: 'Bu tuş zaten kullanılıyor: {is}.',
      tSayfa: 'Tweet sayfası',
      tKart: 'Tweet kartı',
      tAd: 'Kullanıcı adı',
      tMetin: 'Tweet metni',
      tVeri: 'X verisi (TweetDetail)',
      tVeriYanit: '{n} yanıt · {t} tweet · {yol}',
      tVeriYok: 'alınamadı',
      tVeriBekle: 'bekliyor',
      tKanca: 'Veri kancası',
      tKancaVar: 'kuruldu ({yol})',
      tKancaYok: 'kurulamadı',
      tKesif: '“Daha fazlasını keşfet” bölümü',
      tKesifN: '{n} kart atlandı',
      tDaha: '“Daha fazla yanıt” düğmesi',
      tDahaN: '{n} kez basıldı',
      tBekliyor: 'bekliyor',
      kabul: 'Kabul testi',
      gecti: 'Geçti',
      sorun: 'Sorun',
      atla: 'Atla',
      nasil: 'Nasıl denenir: ',
      rapor: 'Raporu kopyala',
      raporKopyalandi: 'Rapor panoya kopyalandı.',
      k1m: 'Bitince düğmedeki sayı, sayfadaki cevap sayısına yakın mı?',
      k1i: '20–50 cevaplı bir tweet aç. Topla\'ya bas. Bitince TWS düğmesindeki sayıya bak.',
      k2m: 'Yapıştırılan Markdown\'da kök tweet en üstte mi?',
      k2i: 'Bitince Markdown kopyala\'ya bas. Metni Not Defteri\'ne yapıştır.',
      k3m: 'İndirilen .md dosyasında ş, ğ, ı doğru görünüyor mu?',
      k3i: 'Markdown indir\'e bas. Dosyayı Not Defteri\'nde aç.',
      k4m: 'Durdur\'a basınca sayaç duruyor mu?',
      k4i: 'Topla\'ya bas. 5 sn sonra menüden Durdur\'a bas.',
      k5m: 'X\'in koyu temasında menü yazıları okunuyor mu?',
      k5i: 'X Ayarlar › Görünüm\'den "Lights out" seç. TWS menüsünü aç.',
      surum: 'Sürüm {s}',
      aps: 'AALabs App Store’da güncellenir.',
      yedek: 'Ayar yedeği',
      disaAl: 'Dışa aktar',
      iceAl: 'İçe aktar',
      yedekHazir: 'Yedek dosyası indiriliyor.',
      yedekAlindi: 'Ayarlar yedekten geri yüklendi.',
      yedekBozuk: 'Bu dosya TWS ayar yedeği değil. Dışa aktar ile alınmış bir dosya seç.',
      mdBas: '# Tweet ve cevapları',
      mdKaynak: 'Kaynak',
      mdTop: 'Toplandı',
      mdTw: 'tweet',
      mdKok: 'Kök',
      mdBaglam: 'Bağlam (önceki tweetler)',
      mdCevaplar: 'Cevaplar',
      mdCevap: 'Cevap',
