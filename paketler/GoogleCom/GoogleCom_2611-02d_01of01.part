      const anahtarlar = [['link', 'hLink'], ['gorsel', 'hGorsel'], ['onz', 'hOnz']].map(([a, ad]) =>
        el('button', { class: 'anahtar', type: 'button', id: `${ONEK}-h-${a}`, 'data-a': a, on: { click: () => degistir(() => { ayar[a] = !ayar[a]; }, true) } }, el('i', { 'aria-hidden': 'true' }), el('span', { 'data-ad': ad })));
