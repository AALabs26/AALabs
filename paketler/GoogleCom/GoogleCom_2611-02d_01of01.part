      aramaInput.addEventListener('input', (e) => { if (e.isComposing) return; aramaMetni = aramaInput.value; panelCiz(); });
      aramaInput.addEventListener('compositionend', () => { aramaMetni = aramaInput.value; panelCiz(); });
      const ust = el('div', { class: 'ust' },
        el('div', { class: 'logo', 'aria-hidden': 'true' }, KOD),
        el('span', { class: 'baslik', id: `${ONEK}-baslik` }, `${m('ad')} · ${m('ayarlar')}`),
        el('span', { class: 'arama' }, ikon('ara'), aramaInput),
        el('button', { class: 'dug', type: 'button', id: `${ONEK}-dil`, title: 'TR / EN', on: { click: () => degistir(() => { ayar.dil = ayar.dil === 'tr' ? 'en' : 'tr'; }, true) } }, ikon('dil'), m('dilDugme')),
        el('button', { class: 'dug', type: 'button', id: `${ONEK}-tema`, on: { click: () => degistir(() => { ayar.tema = { sayfa: 'acik', acik: 'koyu', koyu: 'sayfa' }[ayar.tema]; }) } }, ikon('tema'), m('temaDugme')),
        el('button', { class: 'dug', type: 'button', id: `${ONEK}-kapat`, 'aria-label': m('kapat'), title: m('kapat'), on: { click: () => d.close() } }, ikon('kapat')));
      const gorunen = BOLUMLER.filter(bolumEslesir);
      if (gorunen.length && !gorunen.some(b => b.id === bolum)) bolum = gorunen[0].id;
      const nav = el('nav', { 'aria-label': m('ayarlar') });
      let sonGrup = '';
      gorunen.forEach(b => {
        if (b.grup !== sonGrup) { nav.append(el('div', { class: 'grup' }, b.grup === 'ortak' ? m('grupOrtak') : KOD)); sonGrup = b.grup; }
        nav.append(el('button', { type: 'button', id: `${ONEK}-nav-${b.id}`, 'aria-current': String(b.id === bolum), on: { click: () => { bolum = b.id; panelCiz(); } } }, m(b.ad)));
      });
      const icerik = el('div', { class: 'icerik' });
      if (!gorunen.length) icerik.append(el('p', { class: 'not' }, m('aramaYok')));
      else bolumIcerik(icerik);
      d.append(ust, el('div', { class: 'govde' }, nav, icerik));
      if (tostAcik) d.append(UI.tostEl);
      const odak = odakId && d.querySelector('#' + CSS.escape(odakId));
      if (odak) { odak.focus(); if (odak === aramaInput) aramaInput.setSelectionRange(aramaInput.value.length, aramaInput.value.length); }
    } finally { panelCiziliyor = false; }
  }

  function bolumIcerik(ic) {
    const b = BOLUMLER.find(x => x.id === bolum);
    ic.append(el('h3', null, m(b.ad)));
    const ac = (k, yeniden = true) => (v) => degistir(() => { ayar[k] = v; }, yeniden);
    if (bolum === 'linkler') {
      ic.append(el('div', { class: 'dikey' },
        onay('link', m('linkAc'), ayar.link, ac('link')),
        onay('izleme', m('linkIzleme'), ayar.izleme, ac('izleme'), !ayar.link)));
      ic.append(el('small', { class: 'not' }, m('linkNot')), el('small', { class: 'not' }, m('linkKapatNot')));
      ic.append(sifirlaDugmesi('linkler'));
    } else if (bolum === 'gorseller') {
      ic.append(onay('gorsel', m('gorselAc'), ayar.gorsel, ac('gorsel')));
      ic.append(alan(m('gorselDugmeler'), el('div', { class: 'satir' }, ['dAc', 'dLens', 'dTineye', 'dYandex'].map(k => onay(k, m(k), ayar[k], ac(k, false), !ayar.gorsel)))));
      ic.append(el('small', { class: 'not' }, m('gorselNot')));
      ic.append(sifirlaDugmesi('gorseller'));
    } else if (bolum === 'onizleme') {
      ic.append(onay('onz', m('onzAc'), ayar.onz, ac('onz')));
      ic.append(alan(m('onzSekme'), el('div', { class: 'satir' }, ['sTumu', 'sHaber', 'sVideo'].map(k => onay(k, m(k), ayar[k], ac(k), !ayar.onz)))));
      ic.append(onay('onzTikla', m('onzTikla'), ayar.onzTikla, ac('onzTikla'), !ayar.onz));
      ic.append(el('small', { class: 'not' }, m('onzNot')), el('small', { class: 'not' }, m('onzIzinNot')));
      ic.append(sifirlaDugmesi('onizleme'));
    } else if (bolum === 'genel') {
      ic.append(alan(m('tema'), radyo('tema', [['sayfa', m('temaSayfa')], ['acik', m('temaAcik')], ['koyu', m('temaKoyu')]], ayar.tema, v => degistir(() => { ayar.tema = v; }))));
      ic.append(alan(m('dil'), radyo('dil', [['tr', 'Türkçe'], ['en', 'English']], ayar.dil, v => degistir(() => { ayar.dil = v; }, true))));
      ic.append(alan(m('olcek'), radyo('olcek', [90, 100, 110, 125].map(o => [o, '%' + o]), ayar.olcek, v => degistir(() => { ayar.olcek = v; }))));
      ic.append(alan(m('dugme'), el('div', { class: 'satir' }, onay('dugme', m('dugmeGoster'), ayar.dugme, ac('dugme'))), el('small', null, m('dugmeNot'))));
      ic.append(alan(m('hizli'), el('div', { class: 'satir' }, onay('hizli', m('hizliGoster'), ayar.hizli, ac('hizli', false), !ayar.dugme))));
    } else if (bolum === 'kisayol') {
      const goster = el('span', { class: 'kisayol', id: `${ONEK}-kisayol-deger` }, kisayolGoster(ayar.kisayol));
      const bilgi = el('small', { role: 'status' }, kisayolDinle ? m('kisayolBekle') : '');
      const dg = el('button', { class: 'dug', type: 'button', id: `${ONEK}-kisayol-degistir` }, m('kisayolDegistir'));
      dg.addEventListener('click', () => { kisayolDinle = true; bilgi.textContent = m('kisayolBekle'); });
      dg.addEventListener('blur', () => { if (kisayolDinle) { kisayolDinle = false; bilgi.textContent = ''; } });
      dg.addEventListener('keydown', (e) => {
        if (!kisayolDinle) return;
        e.preventDefault(); e.stopPropagation();
        if (e.key === 'Escape') { kisayolDinle = false; bilgi.textContent = ''; return; }
        const k = tusKombo(e);
        if (!k) return;
        if (!komboKanonikMi(k)) { bilgi.textContent = m('kisayolGecersiz'); return; }
        kisayolDinle = false; degistir(() => { ayar.kisayol = k; });
      });
      ic.append(alan(m('kisayolAyarlar'), el('div', { class: 'satir' }, goster, dg,
        el('button', { class: 'dug', type: 'button', on: { click: () => degistir(() => { ayar.kisayol = VARSAYILAN.kisayol; }) } }, m('kisayolSifirla'))), bilgi));
    } else if (bolum === 'tani') {
      const rapor = taniRaporu();
      ic.append(alan(m('taniBaslik'), el('div', { class: 'kod', id: `${ONEK}-rapor` }, rapor)));
      ic.append(el('div', null, el('button', { class: 'dug ana', type: 'button', id: `${ONEK}-rapor-kopyala`, on: { click: () => panoyaYaz(taniRaporu()).then(() => tost(m('raporKopyalandi')), () => { secMetin(UI.dialog.querySelector(`#${ONEK}-rapor`)); tost(m('kopyalanamadi')); }) } }, m('raporuKopyala'))));
    } else if (bolum === 'hakkinda') {
      ic.append(el('p', { class: 'not' }, m('hakkindaNot')));
      ic.append(alan(m('surum'), el('span', null, `${m('ad')} ${SURUM} · ${KOD}`)));
      const veri = JSON.stringify({ uygulama: UYGULAMA, surum: SURUM, ayar }, null, 2);
      const indir = el('a', { class: 'dug', href: 'data:application/json;charset=utf-8,' + encodeURIComponent(veri), download: `${UYGULAMA}.ayar.json` }, m('disaAktar'));
      const dosya = el('input', { type: 'file', accept: '.json,application/json', id: `${ONEK}-ice-dosya`, hidden: true });
      dosya.addEventListener('change', () => {
        const f = dosya.files && dosya.files[0]; if (!f) return;
        const r = new FileReader();
        r.onload = () => {
          try { const j = JSON.parse(r.result); if (!j || j.uygulama !== UYGULAMA || !j.ayar) throw new Error('biçim'); degistir(() => { ayar = j.ayar; }, true); tost(m('iceAktarildi')); }
          catch (_h) { tost(m('iceAktarHata')); }
        };
        r.readAsText(f);
        dosya.value = '';
      });
      ic.append(alan(m('yedek'), el('div', { class: 'satir' }, indir, el('button', { class: 'dug', type: 'button', on: { click: () => dosya.click() } }, m('iceAktar')), dosya)));
    }
  }
  function secMetin(e) { if (!e) return; const r = document.createRange(); r.selectNodeContents(e); const s = getSelection(); s.removeAllRanges(); s.addRange(r); }
  function panoyaYaz(metin) {
    return new Promise((coz, red) => {
      try { if (typeof GM_setClipboard === 'function') { GM_setClipboard(metin, 'text'); coz(); return; } } catch (_h) { /* sonraki yol */ }
      try { navigator.clipboard.writeText(metin).then(coz, red); } catch (h) { red(h); }
    });
  }

  function taniRaporu() {
    const s = sekme();
    const isaret = (iyi, bek) => bek ? '…' : (iyi ? '✓' : '✗');
    const onz = onzAcikMi();
    const satirlar = [
      `${m('ad')} ${SURUM} · ${typeof GM_info === 'object' && GM_info ? (GM_info.scriptHandler || '?') + ' ' + (GM_info.version || '') : '?'}`,
      `· ${m('tSite')}: ${location.hostname}${location.pathname} · ${m('tSekme')}: ${m('sekmeAd')[s]}`,
      `${isaret(sayac.form)} ${m('tForm')} (form[role=search]): ${sayac.form ? m('tFormVar') : m('tFormYok')}`,
      ayar.link
        ? `${isaret(sayac.harici > 0, sayac.harici === 0)} ${m('tLink')}: ${m('tLinkOzet')(sayac.harici, sayac.yon, sayac.ping, sayac.izleme, sayac.reklam)}`
        : `· ${m('tLink')}: ${m('tKapali')}`,
      `· ${m('tGeriYaz')}: ${sayac.geriYaz}`,
      onz
        ? `${isaret(sayac.blok + sayac.google > 0, sayac.baslik === 0)} ${m('tSonuc')} (${BASLIK}): ${sayac.baslik === 0 ? m('tBekliyor') : `${sayac.blok + sayac.google}/${sayac.baslik}`}`
        : `· ${m('tSonuc')}: ${m('tKapali')}`,
      onz ? (() => { const d = [...bloklar.values()].map(o => o.durum); const n = (x) => d.filter(y => y === x).length;
        return `· ${m('tOnz')}: ${m('tOnzOzet')(n('resim'), n('fav'), n('bekliyor'), sayac.google)}`; })() : null,
      !ayar.gorsel ? `· ${m('tGorsel')}: ${m('tKapali')}`
        : s !== 'gorsel' ? `· ${m('tGorsel')}: ${m('tGorselYok')}`
          : `${isaret(!!sayac.gorsel, !sayac.gorsel)} ${m('tGorsel')}: ${sayac.gorsel || m('tGorselBekliyor')}`,
      `· ${m('tIstek')}: ${istekler.length ? '\n    ' + istekler.join('\n    ') : '-'}`,
      `${bekci.durdu ? '✗' : '✓'} ${m('tBekci')}: ${bekci.durdu}`,
      `${sonHata ? '✗' : '✓'} ${m('tHata')}: ${sonHata || '-'}`,
      `· ayar: ${JSON.stringify(Object.fromEntries(ACIK_KAPALI.map(k => [k, ayar[k]])))}`
    ];
    return satirlar.filter(Boolean).join('\n');
  }

  // ---------- Klavye ----------
  function tusKombo(e) {
    if (e.getModifierState && e.getModifierState('AltGraph')) return null;
    if (e.repeat || e.metaKey) return null;
    if (e.ctrlKey && e.altKey) return null;
    let ad = null;
    if (e.key === ',') ad = 'Comma';
    else if (e.key === '.') ad = 'Period';
    else if (/^Key[A-Z]$/.test(e.code || '')) ad = e.code.slice(3);
    else if (/^Digit\d$/.test(e.code || '')) ad = e.code.slice(5);
    else if (/^F\d{1,2}$/.test(e.key || '')) ad = e.key;
    if (!ad) return null;
    return (e.ctrlKey ? 'Ctrl+' : '') + (e.altKey ? 'Alt+' : '') + (e.shiftKey ? 'Shift+' : '') + ad;
  }
  function komboKanonikMi(v) {
    return /^(Ctrl\+|Alt\+)(Shift\+)?([A-Z0-9]|Comma|Period|F\d{1,2})$/.test(String(v || '')) && !YASAK.has(v);
  }
  function kisayolGoster(k) { return k.replace('Comma', ',').replace('Period', '.'); }
  document.addEventListener('keydown', (e) => {
    if (kisayolDinle || !ayar) return;
    const hedef = e.composedPath ? e.composedPath()[0] : e.target;
    const yaziAlani = hedef && hedef.nodeType === 1 && (hedef.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(hedef.tagName));
    if (yaziAlani && !e.ctrlKey) return;
    const k = tusKombo(e);
    if (!k || k !== ayar.kisayol) return;
    e.preventDefault(); e.stopPropagation();
    if (UI && UI.dialog.open) UI.dialog.close(); else ayarlarAc();
  }, true);

  // ---------- Tampermonkey menüsü ----------
  let menuKimlikleri = [];
  function menuKur() {
    if (typeof GM_registerMenuCommand !== 'function') return;
    if (typeof GM_unregisterMenuCommand !== 'function' && menuKimlikleri.length) return; // eskisi silinemiyor: çoğaltma
    if (typeof GM_unregisterMenuCommand === 'function') menuKimlikleri.forEach(k => { try { GM_unregisterMenuCommand(k); } catch (_h) { /* yok */ } });
    const harf = (s) => (/\((.)\)\s*$/.exec(s) || [])[1];
    const ogeler = [
      [m('menuAyarlar'), ayarlarAc],
      [m('menuDil'), () => degistir(() => { ayar.dil = ayar.dil === 'tr' ? 'en' : 'tr'; }, true)]
    ];
    menuKimlikleri = ogeler.map(([ad, fn]) => { try { return GM_registerMenuCommand(ad, fn, (harf(ad) || '').toLowerCase()); } catch (_h) { return null; } }).filter(x => x != null);
  }

  // ---------- Test kancası ----------
  let testMi = false;
  try { testMi = typeof GM_info === 'object' && GM_info && GM_info.scriptHandler === 'Test'; } catch (_h) { testMi = false; }
  if (testMi && window.__AALABS_TEST__ && typeof window.__AALABS_TEST__ === 'object') {
    window.__AALABS_TEST__.goo = {
      ui: () => UI, ust: () => UST, ayar: () => ayar, sayac: () => sayac, tani: taniRaporu, tara, temizAdres, ogBul, sekme,
      ayarlarAc, METIN, gorsel: () => gorselImg, ayarYaz: (a) => degistir(() => { ayar = Object.assign({}, ayar, a); }, true)
    };
  }

  // ---------- Başlat ----------
  ayar = ayarDuzelt(oku('ayar', null));
  sayfaStiliEkle();
  function domHazir() {
    sayfaStiliEkle();
    arayuzKur();
    menuKur();
    tara();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', domHazir, { once: true });
  else domHazir();
  window.addEventListener('load', () => { bekci.n = 0; tara(); }, { once: true });
})();
