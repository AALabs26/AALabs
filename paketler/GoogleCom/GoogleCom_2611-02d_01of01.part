    { id: 'gorseller', grup: KOD, ad: 'bGorseller', ara: ['gorselAc', 'gorselDugmeler', 'dAc', 'dLens', 'dTineye', 'dYandex'] },
    { id: 'onizleme', grup: KOD, ad: 'bOnizleme', ara: ['onzAc', 'onzSekme', 'sTumu', 'sHaber', 'sVideo', 'onzTikla', 'onzNot'] },
    { id: 'genel', grup: 'ortak', ad: 'bGenel', ara: ['tema', 'dil', 'olcek', 'dugme', 'hizli'] },
