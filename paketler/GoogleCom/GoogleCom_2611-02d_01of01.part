.icerik{padding:12px 16px;overflow:auto;display:flex;flex-direction:column;gap:12px;min-width:0}
.icerik h3{margin:0;font-size:14px;font-weight:600}
.alan{display:flex;flex-direction:column;gap:4px}
.alan>.ad{font-weight:600}
.alan small,.not{color:${c.metin2};font-size:12px;margin:0}
.satir{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center}
.dikey{display:flex;flex-direction:column;gap:4px}
label{display:inline-flex;gap:6px;align-items:center;cursor:pointer}
input[type=radio],input[type=checkbox]{accent-color:${c.ana};margin:0}
.kod{font-family:Consolas,"Cascadia Mono",monospace;font-size:12px;white-space:pre-wrap;background:${c.zemin};border:1px solid ${c.ayirici};border-radius:4px;padding:8px;
