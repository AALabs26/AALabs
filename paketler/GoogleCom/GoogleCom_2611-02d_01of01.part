:host{all:initial}
*{box-sizing:border-box}
[hidden]{display:none !important}
.sar{--o:${ayar.olcek / 100};font-family:${YAZI};font-size:13px;line-height:1.5;color:${c.metin}}
.dugme{position:relative;width:32px;height:32px;border-radius:6px;border:0;background:${c.ana};color:${c.anaUzeri};
  font:700 10px ${YAZI};letter-spacing:.02em;cursor:pointer;display:grid;place-items:center;padding:0;flex:none}
.dugme:hover{background:${T.anaBasili}}
.nokta{position:absolute;top:-3px;right:-3px;width:10px;height:10px;border-radius:50%;background:${c.hata};border:2px solid ${c.yuzey}}
.dug{font:inherit;font-weight:600;height:24px;padding:0 8px;border:1px solid ${c.kenar};border-radius:4px;background:${c.yuzey};color:${c.metin};cursor:pointer;
  display:inline-flex;align-items:center;gap:4px;text-decoration:none;white-space:nowrap}
.dug:hover{background:${c.anaHover}}
.dug.ana{background:${c.ana};border-color:${c.ana};color:${c.anaUzeri}}
.dug svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.dugme:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid ${c.vurgu};outline-offset:2px}
.anahtar{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 8px 0 4px;border:1px solid ${c.kenar};border-radius:12px;background:${c.yuzey};
  color:${c.metin};font:600 12px ${YAZI};cursor:pointer;white-space:nowrap}
.anahtar i{display:block;width:24px;height:14px;border-radius:7px;background:${T.kapali};position:relative;flex:none}
.anahtar i::after{content:"";position:absolute;top:2px;left:2px;width:10px;height:10px;border-radius:50%;background:${c.yuzey}}
.anahtar[aria-pressed="true"] i{background:${c.ana}}
.anahtar[aria-pressed="true"] i::after{left:12px}
.anahtar:hover{background:${c.anaHover}}
@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}
`;
