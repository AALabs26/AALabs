// ==UserScript==
// @name         AALabs Migros Kampanya
// @name:tr      AALabs Migros Kampanya
// @name:en      AALabs Migros Deal Price
// @namespace    aalabs
// @version      26.11.2.7
// @description  Migros'ta "3 AL 2 ÖDE", "2.Sİ %50" gibi kampanyalarda toplam fiyatı ve ürün başına düşen fiyatı kartın içinde yeşil kutuda yazar.
// @match        https://www.migros.com.tr/*
// @icon         data:image/png;base64,
// @updateURL    http://127.0.0.1:47815/u/AALabs.MigrosKampanya.user.js
// @downloadURL  http://127.0.0.1:47815/u/AALabs.MigrosKampanya.user.js
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_unregisterMenuCommand
// @grant        GM_setClipboard
// @run-at       document-start
// @noframes
// @aalabs-ikon  MGK
// ==/UserScript==

/* AALabs Migros Kampanya (MGK) — app-lab · 2611-02c
 * 2611-02g: sıralama display:contents kapta da çalışır.
 * 2611-02f: ürün başı yeşil zeminde, toplam kırmızı zeminde beyaz yazı.
 * 2611-02e: yeşil ürün başı fiyat satır kırmaz; kırmızı toplam alt satırda.
 * 2611-02d: fiyatın üstü çizilir, yanına yeşil ürün başı + kırmızı (toplam) (kullanıcı isteği); Firefox'ta TreeWalker süzgeç nesnesi kaldırıldı (Xray); tarama hatası Tanı'ya yazılır.
 * Tasarım kapısı (2026-11-02): tasarım onay · MGK son · Yer A · Birim A · Renk A · +E1 +E2 +E3 +E4 · Çıkar yok · Kabul yok
 *   Yer A: kampanya rozetinin altında kutu (toplam + ürün başı). Birim A: kg/litre/adet fiyatının yanına kampanyalı değer.
 *   Renk A: yeşil. E1: görselde indirim yüzdesi. E2: ürün başı fiyata göre sırala. E3: sepetteki adetle toplam.
 *   E4: kampanyayı tamamlamak için eksik adet.
 * Seçici: sitenin sınıf adlarına bağlanmaz. Rozet, fiyat ve birim fiyat METİNDEN tanınır (sınıf adları değişse de çalışsın).
 * Tanınmayan kampanyada hiçbir şey eklenmez.
 */
(function () {
  'use strict';

  const SURUM = '2611-02g';
  const KOD = 'MGK';
  const ONEK = 'aalabs-mgk';
  const UYGULAMA = 'AALabs.MigrosKampanya';
  const YASAK = new Set(['Ctrl+T', 'Ctrl+W', 'Ctrl+N', 'Ctrl+L', 'Ctrl+R', 'Ctrl+F', 'Ctrl+P', 'Ctrl+S', 'Ctrl+D', 'Ctrl+H', 'Ctrl+J', 'Ctrl+K', 'Ctrl+U', 'Ctrl+Q',
    'Ctrl+C', 'Ctrl+V', 'Ctrl+X', 'Ctrl+A', 'Ctrl+Z', 'Ctrl+Y', 'Ctrl+Shift+T', 'Ctrl+Shift+N', 'Ctrl+Shift+P', 'Ctrl+Shift+I', 'Ctrl+Shift+J',
    'Alt+D', 'Alt+F4', 'Ctrl+Tab', 'Ctrl+Shift+Tab', 'Ctrl+Shift+Delete', 'Ctrl+Plus', 'Ctrl+Minus', 'Ctrl+0']);

  // ---------- Metinler (iki dil zorunlu; anahtarlar iki dilde aynı) ----------
  const METIN = {
    tr: {
      ad: 'AALabs Migros Kampanya', ayarlar: 'Ayarlar', kapat: 'Kapat', ara: 'Ayarlarda ara…', aramaYok: 'Eşleşen ayar yok.',
      grupOrtak: 'ORTAK', bGosterim: 'Gösterim', bGenel: 'Genel', bKisayol: 'Klavye kısayolları', bTani: 'Tanı', bHakkinda: 'Hakkında',
      neGosterilsin: 'Neler gösterilsin', o_kutu: 'Fiyatın yanında ürün başı (yeşil) ve toplam (kırmızı)', o_birim: 'Kg / litre / adet fiyatının kampanyalısı',
      o_yuzde: 'Görselde indirim yüzdesi', o_sirala: 'Sırala düğmesi (sağ altta)', o_sepet: 'Sepetteki adetle toplam', o_eksik: 'Eksik adet uyarısı',
      gosterimNot: 'Kutu yalnız tanınan kampanyada çıkar: "X AL Y ÖDE" ve "N.Sİ %M".',
      sifirla: 'Bu bölümü sıfırla',
      tema: 'Tema', temaSayfa: 'Sayfaya uy', temaAcik: 'Açık', temaKoyu: 'Koyu',
      dil: 'Dil', olcek: 'Ölçek', dugme: 'Sağ altta MGK düğmesi', dugmeGoster: 'Göster',
      dugmeNot: 'Kapalıyken Ayarlar, Ctrl+, ve Tampermonkey menüsünden açılır.',
      kisayolAyarlar: 'Ayarları aç', kisayolDegistir: 'Değiştir', kisayolBekle: 'Tuşa bas… (Esc: vazgeç)',
      kisayolGecersiz: 'Bu tuş kullanılamaz. Ctrl ya da Alt ile bir harf seç.', kisayolSifirla: 'Varsayılan',
      taniBaslik: 'Durum', raporuKopyala: 'Raporu kopyala', raporKopyalandi: 'Rapor kopyalandı.', kopyalanamadi: 'Kopyalanamadı. Metni seçtim: Ctrl+C.',
      surum: 'Sürüm', yedek: 'Yedek', disaAktar: 'Ayarları dışa aktar', iceAktar: 'Ayarları içe aktar',
      iceAktarildi: 'Ayarlar içe aktarıldı.', iceAktarHata: 'Dosya okunamadı. AALabs Migros Kampanya yedeği mi?',
      hakkindaNot: 'Migros kartlarındaki "3 AL 2 ÖDE", "2.Sİ %50" gibi kampanyaları hesaplar. Kampanyayı tamamlayan adetin toplamını ve ürün başına düşen fiyatı yazar.',
      menuAyarlar: 'Ayarlar (A)', menuSirala: 'Ürün başı fiyata göre sırala (S)', menuDil: 'Language: English (L)',
      dugmeEtiket: 'Migros Kampanya ayarları', dugmeUyari: 'Kampanya bulundu ama kart çözülemedi. Ayrıntı Tanı bölümünde.',
      dilDugme: 'EN', temaDugme: 'Tema',
      toplam: (n, t) => `(${n} adet: ${t} TL)`, urunBasi: (u) => `${u} TL`,
      sepette: (q, t, u) => `Sepette ${q}: ${t} TL · ürün başı ${u} TL`,
      eksik: (k, kamp) => `${k} adet daha eklersen ${kamp} tamamlanır`,
      siralaKapali: 'Ürün başı fiyata göre sırala', siralaAcik: 'Sıralama: ürün başı ✓',
      siralaEtiket: 'Ürünleri ürün başı fiyata göre sırala. Bir daha basınca sitenin sırasına döner.',
      siralanamadi: 'Bu listede sıralama yapılamadı. Tanı bölümüne bak.',
      kutuEtiket: (n, t, u) => `Kampanya hesabı: ${n} adet toplam ${t} TL, ürün başı ${u} TL`,
      tSite: 'Sayfa', tRozet: 'Kampanya rozeti', tKart: 'Çözülen kart', tFiyat: 'Fiyatı bulunamayan', tBirim: 'Birim fiyat', tAdet: 'Sepet adedi',
      tGorsel: 'İndirim yüzdesi', tSirala: 'Sıralama', tTanimsiz: 'Tanınmayan rozet', tOrnek: 'Örnek', tAcik: 'açık', tKapali: 'kapalı', tBekliyor: 'bekliyor (sayfada kampanya yok)',
      tSiralaYok: 'liste kabı flex/grid değil', tHata: 'Son hata'
    },
    en: {
      ad: 'AALabs Migros Deal Price', ayarlar: 'Settings', kapat: 'Close', ara: 'Search settings…', aramaYok: 'No matching setting.',
      grupOrtak: 'COMMON', bGosterim: 'Display', bGenel: 'General', bKisayol: 'Keyboard shortcuts', bTani: 'Diagnostics', bHakkinda: 'About',
      neGosterilsin: 'What to show', o_kutu: 'Per item (green) and total (red) next to the price', o_birim: 'Deal value of the kg / litre / unit price',
      o_yuzde: 'Discount percent on the image', o_sirala: 'Sort button (bottom right)', o_sepet: 'Total for the quantity in the cart', o_eksik: 'Missing quantity hint',
      gosterimNot: 'The box appears only for recognised deals: "X AL Y ÖDE" (X for Y) and "N.Sİ %M" (Nth item M% off).',
      sifirla: 'Reset this section',
      tema: 'Theme', temaSayfa: 'Follow page', temaAcik: 'Light', temaKoyu: 'Dark',
      dil: 'Language', olcek: 'Scale', dugme: 'MGK button bottom right', dugmeGoster: 'Show',
      dugmeNot: 'When off, open Settings with Ctrl+, or the Tampermonkey menu.',
      kisayolAyarlar: 'Open settings', kisayolDegistir: 'Change', kisayolBekle: 'Press a key… (Esc: cancel)',
      kisayolGecersiz: 'This key cannot be used. Pick a letter with Ctrl or Alt.', kisayolSifirla: 'Default',
      taniBaslik: 'Status', raporuKopyala: 'Copy report', raporKopyalandi: 'Report copied.', kopyalanamadi: 'Copy failed. Text selected: press Ctrl+C.',
      surum: 'Version', yedek: 'Backup', disaAktar: 'Export settings', iceAktar: 'Import settings',
      iceAktarildi: 'Settings imported.', iceAktarHata: 'Could not read the file. Is it an AALabs Migros Deal Price backup?',
      hakkindaNot: 'Calculates Migros multi-buy deals such as "3 AL 2 ÖDE" (3 for 2) and "2.Sİ %50" (2nd item 50% off). Shows the total for a full deal and the price per item.',
      menuAyarlar: 'Settings (S)', menuSirala: 'Sort by per-item price (O)', menuDil: 'Dil: Türkçe (L)',
      dugmeEtiket: 'Migros Deal Price settings', dugmeUyari: 'A deal was found but its card could not be read. See Diagnostics.',
      dilDugme: 'TR', temaDugme: 'Theme',
      toplam: (n, t) => `(${n} pcs: ${t} TL)`, urunBasi: (u) => `${u} TL`,
      sepette: (q, t, u) => `In cart ${q}: ${t} TL · per item ${u} TL`,
      eksik: (k, kamp) => `add ${k} more to complete ${kamp}`,
      siralaKapali: 'Sort by per-item price', siralaAcik: 'Sorted: per item ✓',
      siralaEtiket: 'Sort products by per-item price. Press again to restore the site order.',
      siralanamadi: 'This list could not be sorted. See Diagnostics.',
      kutuEtiket: (n, t, u) => `Deal: ${n} pcs total ${t} TL, ${u} TL per item`,
      tSite: 'Page', tRozet: 'Deal badge', tKart: 'Card read', tFiyat: 'Price not found', tBirim: 'Unit price', tAdet: 'Cart quantity',
      tGorsel: 'Discount percent', tSirala: 'Sorting', tTanimsiz: 'Unknown badge', tOrnek: 'Sample', tAcik: 'on', tKapali: 'off', tBekliyor: 'waiting (no deal on the page)',
      tSiralaYok: 'list container is not flex/grid', tHata: 'Last error'
    }
  };

  // ---------- GM sarmalayıcıları (başka yöneticide çökmesin) ----------
  const bellek = {};
  function oku(ad, varsayilan) {
    try { if (typeof GM_getValue === 'function') return GM_getValue(ad, varsayilan); } catch (_h) { /* yok */ }
    return ad in bellek ? bellek[ad] : varsayilan;
  }
  function yaz(ad, deger) {
    try { if (typeof GM_setValue === 'function') { GM_setValue(ad, deger); return; } } catch (_h) { /* yok */ }
    bellek[ad] = deger;
  }

  // ---------- Ayarlar ----------
  const VARSAYILAN = {
    kutu: true, birim: true, yuzde: true, sirala: true, sepet: true, eksik: true,
    tema: 'sayfa', dil: 'tr', olcek: 100, dugme: true, kisayol: 'Ctrl+Comma'
  };
  const GOSTERIM = ['kutu', 'birim', 'yuzde', 'sirala', 'sepet', 'eksik'];
  function ayarDuzelt(a) {
    const s = Object.assign({}, VARSAYILAN, a && typeof a === 'object' ? a : {});
    [...GOSTERIM, 'dugme'].forEach(k => { s[k] = !!s[k]; });
    if (!['sayfa', 'acik', 'koyu'].includes(s.tema)) s.tema = 'sayfa';
    if (!['tr', 'en'].includes(s.dil)) s.dil = 'tr';
    s.olcek = Number(s.olcek);
    if (![90, 100, 110, 125].includes(s.olcek)) s.olcek = 100;
    if (!komboKanonikMi(s.kisayol)) s.kisayol = VARSAYILAN.kisayol;
    return s;
  }
  let ayar = null; // yükleme dosyanın sonunda (TDZ kuralı, platform-userscript §2.12)
  function ayarKaydet() { yaz('ayar', ayar); }
  const m = (k) => METIN[ayar.dil][k];

  // ---------- Sayı ve para ----------
  // Kuruş tamsayısıyla çalışılır: kayan nokta hatası olmasın.
  function tlKurus(metin) {
    const r = /^(\d{1,3}(?:\.\d{3})+|\d+),(\d{2})$/.exec(String(metin).trim());
    if (!r) return NaN;
    return Number(r[1].replace(/\./g, '')) * 100 + Number(r[2]);
  }
  function tlYaz(kurus) {
    return (kurus / 100).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  const sade = (s) => String(s || '').replace(/[\s  ]+/g, ' ').trim();
  const buyuk = (s) => sade(s).toLocaleUpperCase('tr-TR');

  // ---------- Kampanya çözme ----------
  // "3 AL 2 ÖDE" · "2.Sİ %50" · "2. ÜRÜN %50" · "2'NCİ %50 İNDİRİMLİ"
  const XAY_RE = /^(\d{1,2})\s*AL\s*(\d{1,2})\s*ÖDE$/;
  const NCI_RE = /^(\d)\s*(?:[.'’]\s*(?:(?:S[İIÜU]|N?C[İIÜU](?:S[İI])?|ÜNCÜ|UNCU|İNCİ|INCI)\s*)?(?:ÜRÜNE?|URUNE?)?|\s+(?:ÜRÜNE?|URUNE?))\s*%\s*(\d{1,3})(?:\s*İNDİRİM(?:L[İI])?)?$/;
  function kampanyaCoz(metin) {
    const t = buyuk(metin);
    let r = XAY_RE.exec(t);
    if (r) {
      const x = Number(r[1]), y = Number(r[2]);
      if (x > y && y > 0 && x <= 20) return { tur: 'xay', n: x, y, metin: `${x} AL ${y} ÖDE` };
      return null;
    }
    r = NCI_RE.exec(t);
    if (r) {
      const n = Number(r[1]), yuzde = Number(r[2]);
      if (n >= 2 && yuzde > 0 && yuzde <= 100) return { tur: 'nci', n, yuzde, metin: `${n}.Sİ %${yuzde}` };
    }
    return null;
  }
  // Rozet gibi görünen ama tanınmayan metin (Tanı için)
  const ROZET_BENZERI = /^\d+\s*AL\b|^\d\s*[.'’]?\s*\S{0,6}\s*%\s*\d+|^%\s*\d+/;

  // q adedin kampanyayla ödenen tutarı (kuruş). Kampanya tam paket olmayan adede uygulanmaz.
  function odenen(k, fiyat, q) {
    const paket = Math.floor(q / k.n), kalan = q % k.n;
    if (k.tur === 'xay') return paket * k.y * fiyat + kalan * fiyat;
    const indirimli = Math.round(fiyat * (100 - k.yuzde) / 100);
    return paket * ((k.n - 1) * fiyat + indirimli) + kalan * fiyat;
  }
  function hesapla(k, fiyat) {
    const toplam = odenen(k, fiyat, k.n);
    const urunBasi = Math.round(toplam / k.n);
    const yuzde = Math.round((1 - toplam / (k.n * fiyat)) * 100);
    return { toplam, urunBasi, yuzde, oran: toplam / (k.n * fiyat) };
  }

  // ---------- Sayaçlar (Tanı) ----------
  let sayac = null;
  function sayacSifirla() {
    sayac = { rozet: 0, kart: 0, fiyatYok: 0, birim: 0, adet: 0, gorsel: 0, tanimsiz: [], ornek: '', sirala: '' };
  }
  sayacSifirla();

  // ---------- Sayfa stili ----------
  // TOKEN-BASLA (aalabs-tema.css 1.7.0'dan; kutu = basari, iki temada)
  const T = {
    acik: { ana: '#2456D6', anaAcik: '#E5EBFA', anaHover: '#F2F5FD', anaUzeri: '#FFFFFF', vurgu: '#2456D6', zemin: '#F6F9FC', yuzey: '#FFFFFF', metin: '#17252E', metin2: '#4E6269', kenar: '#7A9199', ayirici: '#D3DEE6', hata: '#C4313B', basari: '#18763F', basariBg: '#E4F5E8', uyari: '#9A5B00', uyariBg: '#FDF6D8' },
    koyu: { ana: '#2456D6', anaAcik: '#1D2C4F', anaHover: '#1B2434', anaUzeri: '#FFFFFF', vurgu: '#86A8FF', zemin: '#0F1520', yuzey: '#161E2B', metin: '#E6ECF5', metin2: '#9AA8BC', kenar: '#6A7B93', ayirici: '#263142', hata: '#FF8189', basari: '#4CC38A', basariBg: '#15291F', uyari: '#E8AC45', uyariBg: '#33270F' },
    rozet: '#C4313B', rozetYazi: '#FFFFFF', tostZemin: '#17252E', tostYazi: '#FFFFFF', anaBasili: '#204CBD', perde: 'rgba(0,0,0,.35)'
  };
  // TOKEN-BITIR
  function sayfaCss() {
    const c = T[temaSec()];
    const yazi = '"Open Sans","Segoe UI",Roboto,Arial,sans-serif';
    return `
.${ONEK}-kutu{all:initial;display:flex !important;flex-direction:column;gap:1px;box-sizing:border-box;margin:4px 0 !important;padding:4px 8px !important;
  background:${c.basariBg} !important;color:${c.basari} !important;border-left:3px solid ${c.basari} !important;border-radius:2px !important;
  font:600 12px/1.4 ${yazi} !important;font-variant-numeric:tabular-nums;text-align:left !important;white-space:normal !important;letter-spacing:0 !important}
.${ONEK}-kutu span{all:unset;display:block}
.${ONEK}-kutu .${ONEK}-ek{font-weight:400 !important}
.${ONEK}-cizik{text-decoration:line-through !important;text-decoration-thickness:2px !important;opacity:.6}
.${ONEK}-fiyat{all:unset;display:inline !important;margin-left:.4em !important;font-variant-numeric:tabular-nums;white-space:normal}
.${ONEK}-yesil{all:unset;font-weight:700 !important;color:${T.rozetYazi} !important;background:${T.acik.basari} !important;padding:0 .3em !important;border-radius:4px !important;white-space:nowrap !important}
.${ONEK}-kirmizi{all:unset;font-weight:600 !important;font-size:.8em !important;color:${T.rozetYazi} !important;background:${T.rozet} !important;padding:0 .35em !important;border-radius:4px !important;white-space:nowrap !important;display:block !important;width:fit-content !important;margin-top:2px !important}
.${ONEK}-birim{all:unset;font-weight:600 !important;color:${c.basari} !important;font-variant-numeric:tabular-nums;white-space:normal}
.${ONEK}-yuzde{all:initial;position:absolute !important;left:6px !important;bottom:6px !important;z-index:2 !important;pointer-events:none;
  padding:0 6px !important;min-height:20px;display:inline-flex !important;align-items:center;border-radius:4px !important;
  background:${T.rozet} !important;color:${T.rozetYazi} !important;font:700 12px/20px ${yazi} !important}
.${ONEK}-yuzde.${ONEK}-orta{bottom:auto !important;top:50% !important;transform:translateY(-50%)}
`;
  }
  function sayfaStiliEkle() {
    const yer = document.head || document.documentElement;
    if (!yer) return; // belge henüz yoksa domHazir yeniden dener
    let s = document.getElementById(`${ONEK}-stil`);
    if (!s) { s = document.createElement('style'); s.id = `${ONEK}-stil`; yer.appendChild(s); }
    const css = sayfaCss();
    if (s.textContent !== css) s.textContent = css;
  }

  // ---------- Tarama: okuma evresi ----------
  const BIZIM = `.${ONEK}-kutu,.${ONEK}-birim,.${ONEK}-yuzde,.${ONEK}-fiyat,#${ONEK}-kok`;
  function gorunurMu(e) { return !!(e && e.getClientRects().length); }
  function ciziliMi(e) {
    for (let x = e, i = 0; x && i < 3; x = x.parentElement, i++) {
      if (x.classList && x.classList.contains(`${ONEK}-cizik`)) return false; // bizim çizdiğimiz ana fiyat
      if (/^(S|DEL|STRIKE)$/.test(x.tagName)) return true;
      try { if ((getComputedStyle(x).textDecorationLine || '').includes('line-through')) return true; } catch (_h) { /* yok */ }
    }
    return false;
  }

  // Çocuk metinleri boşlukla birleştirir: <span>2</span><span>%25</span> → "2 %25" (yapışık "2%25" yanlış eşleşmesin)
  function metinBosluklu(e) {
    const parca = [];
    const w = document.createTreeWalker(e, NodeFilter.SHOW_TEXT);
    for (let n = w.nextNode(); n; n = w.nextNode()) { parca.push(n.nodeValue); if (parca.length > 12) break; }
    return sade(parca.join(' '));
  }
  // Rozet: metni tam olarak bir kampanya olan en küçük öğe
  function rozetleriBul(kok) {
    const bulunan = new Set();
    // Süzgeç nesnesi verilmez: Firefox'ta Tampermonkey betiği ayrı bölmede (Xray) çalışır, sayfa
    // TreeWalker'ı betiğin acceptNode işlevini çağıramayabilir. Süzme döngünün içinde yapılır.
    const w = document.createTreeWalker(kok, NodeFilter.SHOW_TEXT);
    for (let n = w.nextNode(); n; n = w.nextNode()) {
      const v = n.nodeValue;
      if (!v || v.length > 40 || !/(AL|%)/i.test(v)) continue;
      const p0 = n.parentElement;
      if (!p0 || p0.closest(BIZIM) || p0.closest('script,style,noscript,textarea,input')) continue;
      let e = n.parentElement;
      for (let i = 0; e && i < 4; i++, e = e.parentElement) {
        const t = metinBosluklu(e);
        if (t.length > 40) break;
        const k = kampanyaCoz(t);
        if (k) { if (gorunurMu(e)) bulunan.add(e); break; }
        if (i === 0 && ROZET_BENZERI.test(buyuk(t)) && sayac.tanimsiz.length < 5 && !sayac.tanimsiz.includes(buyuk(t))) sayac.tanimsiz.push(buyuk(t));
      }
    }
    // İç içe iki eşleşme olmasın: ataya değil en küçüğe bağlan
    return [...bulunan].filter(e => ![...bulunan].some(b => b !== e && e.contains(b)));
  }

  // Kart içindeki fiyat metinleri (parantezli birim fiyat ve bizim öğelerimiz hariç)
  function fiyatlariBul(kart, rozet) {
    const sonuc = [];
    const w = document.createTreeWalker(kart, NodeFilter.SHOW_TEXT);
    for (let n = w.nextNode(); n; n = w.nextNode()) {
      const v = sade(n.nodeValue);
      if (!v || v.length > 20) continue;
      const r = /^((?:\d{1,3}(?:\.\d{3})+|\d+),\d{2})(?:\s*(?:TL|₺))?$/.exec(v);
      if (!r) continue;
      const p = n.parentElement;
      if (!p || p.closest(BIZIM) || (rozet && rozet.contains(p)) || !gorunurMu(p)) continue;
      const kurus = tlKurus(r[1]);
      if (!Number.isFinite(kurus) || kurus <= 0) continue;
      // "TL" ayrı öğedeyse kardeş metne bak; hiç TL yoksa fiyat sayılmaz (adet, gram vb.)
      const ebeveynMetni = sade(p.parentElement ? p.parentElement.textContent : '');
      if (!/TL|₺/.test(v) && !/TL|₺/.test(sade(p.textContent) + ' ' + ebeveynMetni.slice(0, 40))) continue;
      if (/^\(/.test(ebeveynMetni) || /TL\s*\/\s*[A-Za-zÇĞİÖŞÜçğıöşü]/.test(ebeveynMetni) || /\/\s*[A-Za-zÇĞİÖŞÜçğıöşü]+\s*\)?$/.test(sade(p.textContent))) continue;
      let boy = 0;
      try { boy = parseFloat(getComputedStyle(p).fontSize) || 0; } catch (_h) { /* yok */ }
      sonuc.push({ el: p, kurus, boy, cizili: ciziliMi(p), sira: sonuc.length });
    }
    return sonuc;
  }

  // Birim fiyat: "(567,58 TL/Kg)"
  const BIRIM_RE = /^\(?\s*(\d{1,3}(?:\.\d{3})*,\d{2}|\d+,\d{2})\s*TL\s*\/\s*([A-Za-zÇĞİÖŞÜçğıöşü.]{1,8})\s*\)?$/;
  function birimBul(kart) {
    const w = document.createTreeWalker(kart, NodeFilter.SHOW_TEXT);
    for (let n = w.nextNode(); n; n = w.nextNode()) {
      if (!/TL\s*\//.test(n.nodeValue || '')) continue;
      let e = n.parentElement;
      for (let i = 0; e && i < 3 && e !== kart; i++, e = e.parentElement) {
        if (e.closest(BIZIM)) break;
        const t = sade([...e.childNodes].filter(c => !(c.nodeType === 1 && c.matches(BIZIM))).map(c => c.textContent).join(''));
        const r = BIRIM_RE.exec(t);
        if (r) return { el: e, kurus: tlKurus(r[1]), olcu: r[2] };
        if (t.length > 40) break;
      }
    }
    return null;
  }

  // Artı/eksi: öğe (ya da sarmalayıcısı) iki kardeş düğmenin arasında durmalı
  function dugmeArasindaMi(p, kart) {
    const dugmeMi = (x) => !!(x && x.matches && x.matches('button,[role="button"]'));
    // En az biri artı/eksi olmalı (favori, karşılaştır düğmeleri arasındaki sayı adet değildir)
    const ARTI_EKSI = /^[-−–+]$|azalt|artır|arttır|çıkar|eksilt|sil|kaldır|ekle|decrease|increase|remove|minus|plus|add/i;
    const artiEksiMi = (x) => dugmeMi(x) && ARTI_EKSI.test(sade(x.textContent) || x.getAttribute('aria-label') || x.getAttribute('title') || '');
    for (let x = p, i = 0; x && x !== kart && i < 2; x = x.parentElement, i++) {
      const o = x.previousElementSibling, s = x.nextElementSibling;
      if (dugmeMi(o) && dugmeMi(s) && (artiEksiMi(o) || artiEksiMi(s))) return true;
    }
    return false;
  }
  // Sepet adedi: artı/eksi düğmeleri arasındaki sayı ya da sayı kutusu (ürün sepette değilse yok)
  function adetBul(kart, haric) {
    const inp = [...kart.querySelectorAll('input')].find(i => /^\d{1,3}$/.test(String(i.value || '').trim()) && gorunurMu(i) && dugmeArasindaMi(i, kart));
    if (inp) return Number(inp.value);
    const w = document.createTreeWalker(kart, NodeFilter.SHOW_TEXT);
    for (let n = w.nextNode(); n; n = w.nextNode()) {
      const v = sade(n.nodeValue);
      const r = /^(\d{1,3})(?:\s*(?:adet|ad\.?))?$/i.exec(v);
      if (!r) continue;
      const p = n.parentElement;
      if (!p || p.closest(BIZIM) || haric.some(h => h && h.contains(p)) || !gorunurMu(p)) continue;
      if (dugmeArasindaMi(p, kart)) return Number(r[1]);
    }
    return 0;
  }

  // Kart: rozetten yukarı, fiyat ve görseli birlikte taşıyan en küçük ata; içinde tek rozet olmalı
  function kartBul(rozet, rozetler) {
    let fiyatli = null;
    for (let e = rozet.parentElement, i = 0; e && e !== document.body && i < 12; e = e.parentElement, i++) {
      if (rozetler.filter(r => e.contains(r)).length > 1) break;
      if (new Set([...e.querySelectorAll('a[href]')].filter(a => a.querySelector('img')).map(a => a.getAttribute('href'))).size > 1) break; // komşu ürüne taşma
      if (!fiyatli && fiyatlariBul(e, rozet).some(f => !f.cizili)) fiyatli = e;
      if (fiyatli && e.querySelector('img')) return e;
    }
    return fiyatli;
  }

  function anaFiyat(fiyatlar) {
    const adaylar = fiyatlar.filter(f => !f.cizili);
    if (!adaylar.length) return null;
    adaylar.sort((a, b) => (b.boy - a.boy) || (a.sira - b.sira)); // eşit boyda ilk gelen: birim fiyat kazanmasın
    return adaylar[0];
  }

  // Rozetin kart içinde bağımsız durduğu en büyük kap (kutu bunun hemen arkasına girer)
  function rozetBlogu(rozet, kart, fiyatEl) {
    let e = rozet;
    while (e.parentElement && e.parentElement !== kart && !e.parentElement.contains(fiyatEl) && sade(e.parentElement.textContent).length <= 60) e = e.parentElement;
    return e;
  }

  function okumaEvresi() {
    const kararlar = [];
    const rozetler = rozetleriBul(document.body);
    sayac.rozet = rozetler.length;
    rozetler.forEach(rozet => {
      const kamp = kampanyaCoz(metinBosluklu(rozet));
      const kart = kartBul(rozet, rozetler);
      if (!kart) { sayac.fiyatYok++; return; }
      const fiyat = anaFiyat(fiyatlariBul(kart, rozet));
      if (!fiyat) { sayac.fiyatYok++; return; }
      const h = hesapla(kamp, fiyat.kurus);
      const birim = birimBul(kart);
      const adet = adetBul(kart, [rozet, fiyat.el, birim && birim.el]);
      let img = null, alan = 0;
      kart.querySelectorAll('img').forEach(i => { const r = i.getBoundingClientRect(); if (r.width * r.height > alan) { alan = r.width * r.height; img = i; } });
      sayac.kart++;
      if (birim) sayac.birim++;
      if (adet) sayac.adet++;
      if (img) sayac.gorsel++;
      if (!sayac.ornek) sayac.ornek = `${kamp.metin} · ${tlYaz(fiyat.kurus)} → ${kamp.n}: ${tlYaz(h.toplam)} · ${tlYaz(h.urunBasi)}${birim ? ' · ' + tlYaz(birim.kurus) + '/' + birim.olcu : ''}${adet ? ' · adet ' + adet : ''}`;
      kararlar.push({ rozet, kart, kamp, fiyat, h, birim, adet, img, blok: rozetBlogu(rozet, kart, fiyat.el) });
    });
    return kararlar;
  }

  // ---------- Tarama: yazma evresi (işaretle-süpür) ----------
  function kutuKur(k) {
    const kutu = document.createElement('div');
    kutu.className = `${ONEK}-kutu`;
    kutu.setAttribute('data-aalabs', KOD);
    const satirlar = [];
    if (ayar.sepet && k.adet > 0) {
      const t = odenen(k.kamp, k.fiyat.kurus, k.adet);
      satirlar.push(['ek', m('sepette')(k.adet, tlYaz(t), tlYaz(Math.round(t / k.adet)))]);
    }
    if (ayar.eksik && k.adet > 0 && k.adet % k.kamp.n) {
      satirlar.push(['ek', m('eksik')(k.kamp.n - (k.adet % k.kamp.n), k.kamp.metin)]);
    }
    if (!satirlar.length) return null;
    satirlar.forEach(([sinif, metin]) => { const s = document.createElement('span'); if (sinif) s.className = `${ONEK}-${sinif}`; s.textContent = metin; kutu.appendChild(s); });
    kutu.setAttribute('role', 'note');
    kutu.setAttribute('aria-label', m('kutuEtiket')(k.kamp.n, tlYaz(k.h.toplam), tlYaz(k.h.urunBasi)));
    return kutu;
  }

  function yazmaEvresi(kararlar) {
    const onayli = new Set(), cizikler = new Set();
    kararlar.forEach(k => {
      const imzaTemel = `${k.kamp.metin}|${k.fiyat.kurus}|${k.adet}|${ayar.dil}|${ayar.kutu}${ayar.sepet}${ayar.eksik}`;
      // Kutu: rozet bloğunun hemen arkasında
      const sonraki = k.blok.nextElementSibling;
      if (sonraki && sonraki.classList.contains(`${ONEK}-kutu`) && sonraki.dataset.imza === imzaTemel) onayli.add(sonraki);
      else {
        const kutu = kutuKur(k);
        if (kutu) { kutu.dataset.imza = imzaTemel; k.blok.after(kutu); onayli.add(kutu); }
      }
      // Ana fiyatın üstü çizilir; yanına yeşil ürün başı ve kırmızı parantezli toplam
      if (ayar.kutu) {
        k.fiyat.el.classList.add(`${ONEK}-cizik`);
        cizikler.add(k.fiyat.el);
        let f = k.fiyat.el.nextElementSibling;
        if (!f || !f.classList.contains(`${ONEK}-fiyat`)) {
          f = document.createElement('span'); f.className = `${ONEK}-fiyat`; f.setAttribute('data-aalabs', KOD);
          const y = document.createElement('span'); y.className = `${ONEK}-yesil`;
          const r = document.createElement('span'); r.className = `${ONEK}-kirmizi`;
          f.append(y, r);
          k.fiyat.el.after(f);
        }
        const yt = m('urunBasi')(tlYaz(k.h.urunBasi)), rt = m('toplam')(k.kamp.n, tlYaz(k.h.toplam));
        if (f.firstChild.textContent !== yt) f.firstChild.textContent = yt;
        if (f.lastChild.textContent !== rt) f.lastChild.textContent = rt;
        f.setAttribute('aria-label', m('kutuEtiket')(k.kamp.n, tlYaz(k.h.toplam), tlYaz(k.h.urunBasi)));
        onayli.add(f);
      }
      // Birim fiyatın kampanyalısı
      if (ayar.birim && k.birim && k.birim.kurus > 0) {
        const metin = ` → ${tlYaz(Math.round(k.birim.kurus * k.h.oran))} TL/${k.birim.olcu}`;
        let b = k.birim.el.querySelector(`:scope > .${ONEK}-birim`);
        if (!b) { b = document.createElement('span'); b.className = `${ONEK}-birim`; b.setAttribute('data-aalabs', KOD); k.birim.el.appendChild(b); }
        if (b.textContent !== metin) b.textContent = metin;
        onayli.add(b);
      }
      // İndirim yüzdesi görselin köşesinde
      if (ayar.yuzde && k.img && k.h.yuzde > 0) {
        let kap = k.img.parentElement;
        const ir = k.img.getBoundingClientRect();
        while (kap && kap !== k.kart && kap.parentElement) {
          const r = kap.getBoundingClientRect();
          if (!/^inline/.test(getComputedStyle(kap).display) && r.height >= ir.height - 1 && r.width >= ir.width - 1) break;
          kap = kap.parentElement;
        }
        let y = kap.querySelector(`:scope > .${ONEK}-yuzde`);
        if (!y) {
          if (getComputedStyle(kap).position === 'static') { kap.style.position = 'relative'; kap.setAttribute(`data-${ONEK}-konum`, ''); }
          y = document.createElement('span'); y.className = `${ONEK}-yuzde`; y.setAttribute('data-aalabs', KOD); y.setAttribute('aria-hidden', 'true');
          kap.appendChild(y);
        }
        const metin = `-%${k.h.yuzde}`;
        if (y.textContent !== metin) y.textContent = metin;
        y.classList.toggle(`${ONEK}-orta`, k.adet > 0); // sepetteyken alttaki artı/eksi düğmeleriyle çakışmasın
        onayli.add(y);
      }
    });
    document.querySelectorAll(`.${ONEK}-kutu,.${ONEK}-birim,.${ONEK}-yuzde,.${ONEK}-fiyat`).forEach(e => { if (!onayli.has(e)) e.remove(); });
    document.querySelectorAll(`.${ONEK}-cizik`).forEach(e => { if (!cizikler.has(e)) e.classList.remove(`${ONEK}-cizik`); });
    document.querySelectorAll(`[data-${ONEK}-konum]`).forEach(e => {
      if (!e.querySelector(`:scope > .${ONEK}-yuzde`)) { e.style.position = ''; e.removeAttribute(`data-${ONEK}-konum`); }
    });
  }

  // ---------- Sıralama (E2) ----------
  // Sitenin düğümleri yerinden oynatılmaz; yalnız CSS "order" verilir. Kapatınca order silinir.
  let siraliMi = false, siralaIstendi = false;
  function ogeBul(kart) {
    let e = kart;
    while (e.parentElement && e.parentElement !== document.body && e.parentElement.children.length < 2) e = e.parentElement;
    return e;
  }
  function urunBasiOku(oge) {
    for (const [kart, deger] of kartlarVeri) if (oge.contains(kart)) return deger;
    const f = anaFiyat(fiyatlariBul(oge, null));
    return f ? f.kurus : Infinity;
  }
  let kartlarVeri = [];
  function siralaUygula(kararlar) {
    sayac.sirala = '';
    kartlarVeri = [];
    if (!siraliMi || !ayar.sirala) {
      document.querySelectorAll(`[data-${ONEK}-sira]`).forEach(e => { e.style.order = ''; e.removeAttribute(`data-${ONEK}-sira`); });
      return;
    }
    kartlarVeri = kararlar.map(k => [k.kart, k.h.urunBasi]);
    const kaplar = new Map();
    kararlar.forEach(k => { const o = ogeBul(k.kart); if (o.parentElement) kaplar.set(o.parentElement, true); });
    let sirali = 0, olmayan = 0;
    kaplar.forEach((_d, kap) => {
      // display:contents kap kutu çizmez; öğeler üst atanın ızgarasına girer (Migros sm-product-list)
      let gk = kap, gorunum = getComputedStyle(kap).display;
      while (gorunum === 'contents' && gk.parentElement) { gk = gk.parentElement; gorunum = getComputedStyle(gk).display; }
      if (!/flex|grid/.test(gorunum)) { olmayan++; return; }
      const ogeler = [...kap.children].filter(c => !c.matches(BIZIM));
      ogeler.map((o, i) => ({ o, i, d: urunBasiOku(o) }))
        .sort((a, b) => (a.d - b.d) || (a.i - b.i))
        .forEach((x, sira) => { if (x.o.style.order !== String(sira)) x.o.style.order = String(sira); if (!x.o.hasAttribute(`data-${ONEK}-sira`)) x.o.setAttribute(`data-${ONEK}-sira`, ''); });
      sirali += ogeler.length;
    });
    sayac.sirala = olmayan && !sirali ? '✗ ' + m('tSiralaYok') : `✓ ${sirali}` + (olmayan ? ` · ✗ ${olmayan} ${m('tSiralaYok')}` : '');
    if (olmayan && !sirali && siralaIstendi) tost(m('siralanamadi'));
    siralaIstendi = false;
  }

  // ---------- Tarama döngüsü ----------
  function tara() {
    if (!document.body) return;
    gozlemciDurdur();
    sayacSifirla();
    try {
      sayfaStiliEkle();
      if (UI && !UI.host.isConnected) document.body.appendChild(UI.host); // site kökü sildiyse geri tak
      const kararlar = okumaEvresi();
      yazmaEvresi(kararlar);
      siralaUygula(kararlar);
      sonHata = '';
    } catch (h) {
      sonHata = String(h && h.stack || h).split('\n').slice(0, 2).join(' | ');
    } finally { gozlemciBaslat(); dugmeDurumu(); taniYenile(); }
  }
  // Sondan erteleme: değişiklik sürdükçe 250 ms bekle, ama ilk istekten en çok 1 sn sonra tara.
  let taramaZaman = 0, ilkIstek = 0, sonHata = '';
  function taramaIste() {
    const simdi = Date.now();
    if (!ilkIstek) ilkIstek = simdi;
    clearTimeout(taramaZaman);
    const bekle = Math.max(0, Math.min(250, ilkIstek + 1000 - simdi));
    taramaZaman = setTimeout(() => { taramaZaman = 0; ilkIstek = 0; tara(); }, bekle);
  }
  function bizimMi(n) {
    const e = n.nodeType === 1 ? n : n.parentElement;
    return !!(e && e.closest && e.closest(BIZIM));
  }
  let gozlemci = null;
  function gozlemciBaslat() {
    if (!gozlemci) {
      gozlemci = new MutationObserver((kayitlar) => {
        for (const k of kayitlar) {
          if (k.type === 'attributes') { if (!bizimMi(k.target)) { taramaIste(); return; } continue; }
          if (bizimMi(k.target)) continue;
          const ekli = [...k.addedNodes, ...k.removedNodes];
          if (k.type === 'childList' && ekli.length && ekli.every(bizimMi)) continue;
          taramaIste(); return;
        }
      });
    }
    if (document.body) gozlemci.observe(document.body, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ['value'] });
  }
  function gozlemciDurdur() { if (gozlemci) { gozlemci.takeRecords(); gozlemci.disconnect(); } }
  // Adet kutusuna yazılınca da yeniden hesapla (value özniteliği değişmeyebilir)
  document.addEventListener('input', (e) => { const t = e.target; if (t && t.tagName === 'INPUT' && !bizimMi(t)) taramaIste(); }, true);
  document.addEventListener('change', (e) => { const t = e.target; if (t && t.tagName === 'INPUT' && !bizimMi(t)) taramaIste(); }, true);
  // Angular adedi value özelliğiyle yazar (olay yok): artı/eksi tıklamasından sonra bir kez daha bak
  document.addEventListener('click', (e) => {
    const t = e.target instanceof Element ? e.target.closest('button,[role="button"]') : null;
    if (t && !bizimMi(t)) setTimeout(taramaIste, 400);
  }, true);

  // ---------- Arayüz (gölge kök) ----------
  let UI = null;
  const SVG = {
    kapat: '<path d="M18 6 6 18M6 6l12 12"/>',
    dil: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/>',
    tema: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
    ara: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
    sirala: '<path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="m21 8-4-4-4 4"/><path d="M17 4v16"/>'
  };
  function ikon(ad) {
    const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    s.setAttribute('viewBox', '0 0 24 24'); s.setAttribute('width', '16'); s.setAttribute('height', '16'); s.setAttribute('aria-hidden', 'true');
    const d = new DOMParser().parseFromString(`<svg xmlns="http://www.w3.org/2000/svg">${SVG[ad]}</svg>`, 'image/svg+xml');
    [...d.documentElement.childNodes].forEach(c => s.appendChild(document.importNode(c, true)));
    return s;
  }
  function ekle(e, cocuklar) {
    for (const c of [cocuklar].flat(Infinity)) {
      if (c == null || c === false) continue;
      e.append(c instanceof Node ? c : document.createTextNode(String(c)));
    }
    return e;
  }
  function el(etiket, ozellik, ...cocuklar) {
    const e = document.createElement(etiket);
    if (ozellik) Object.entries(ozellik).forEach(([k, v]) => {
      if (v == null || v === false) return;
      if (k === 'on') Object.entries(v).forEach(([o, f]) => e.addEventListener(o, f));
      else if (k === 'class') e.className = v;
      else if (k in e && typeof v !== 'string') e[k] = v;
      else e.setAttribute(k, v === true ? '' : v);
    });
    return ekle(e, cocuklar);
  }
  const carp = (s) => s.replace(/(^|[^\w.#-])(\d+(?:\.\d+)?)px/g, (mm, on, n) => (Number(n) <= 2 ? mm : `${on}calc(${n}px*var(--o))`));

  function temaSec() {
    if (ayar.tema === 'acik') return 'acik';
    if (ayar.tema === 'koyu') return 'koyu';
    let renk = '';
    for (const e of [document.body, document.documentElement]) {
      if (!e) continue;
      const c = getComputedStyle(e).backgroundColor;
      if (c && !/rgba\(0, 0, 0, 0\)|transparent/.test(c)) { renk = c; break; }
    }
    const r = /rgba?\((\d+), (\d+), (\d+)/.exec(renk);
    if (!r) return matchMedia('(prefers-color-scheme: dark)').matches ? 'koyu' : 'acik';
    return (0.299 * r[1] + 0.587 * r[2] + 0.114 * r[3]) / 255 < 0.5 ? 'koyu' : 'acik';
  }

  function panelCss() {
    const c = T[temaSec()];
    return carp(`
:host{all:initial}
*{box-sizing:border-box}
[hidden]{display:none !important}
.sar{--o:${ayar.olcek / 100};font-family:"Open Sans","Segoe UI",Roboto,Arial,sans-serif;font-size:13px;line-height:1.5;color:${c.metin}}
.alt{position:fixed;right:16px;bottom:16px;z-index:2147483645;display:flex;gap:8px;align-items:center}
.dugme{position:relative;width:32px;height:32px;border-radius:6px;border:0;background:${c.ana};
  color:${c.anaUzeri};font:600 10px "Open Sans","Segoe UI",Roboto,Arial,sans-serif;letter-spacing:.02em;cursor:pointer;display:grid;place-items:center;padding:0}
.dugme:hover{background:${T.anaBasili}}
.sirala{height:32px;padding:0 10px;border-radius:6px;border:1px solid ${c.kenar};background:${c.yuzey};color:${c.metin};font:600 12px "Open Sans","Segoe UI",Roboto,Arial,sans-serif;
  cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.sirala:hover{background:${c.anaHover}}
.sirala[aria-pressed="true"]{background:${c.basari};border-color:${c.basari};color:${c.anaUzeri}}
.sirala svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.dugme:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid ${c.vurgu};outline-offset:2px}
.nokta{position:absolute;top:-3px;right:-3px;width:10px;height:10px;border-radius:50%;background:${c.hata};border:2px solid ${c.yuzey}}
dialog{border:1px solid ${c.kenar};border-radius:6px;padding:0;background:${c.yuzey};color:${c.metin};width:min(720px,calc(100vw - 32px));
  max-height:min(560px,calc(100vh - 32px));overflow:hidden;font:inherit}
dialog[open]{display:flex;flex-direction:column}
dialog::backdrop{background:${T.perde}}
.ust{display:flex;align-items:center;gap:8px;padding:8px 12px;border-bottom:1px solid ${c.ayirici};flex-wrap:wrap}
.logo{width:24px;height:24px;border-radius:4px;background:${c.ana};color:${c.anaUzeri};display:grid;place-items:center;font-weight:600;font-size:8px;flex:none}
.baslik{font-weight:600;flex:1;min-width:120px}
.arama{display:flex;align-items:center;gap:4px;height:24px;border:1px solid ${c.kenar};border-radius:4px;padding:0 6px;background:${c.zemin};color:${c.metin2}}
.arama input{border:0;background:transparent;color:${c.metin};font:inherit;width:150px;outline:none}
.dug{font:inherit;font-weight:600;height:24px;padding:0 8px;border:1px solid ${c.kenar};border-radius:4px;background:${c.yuzey};color:${c.metin};cursor:pointer;
  display:inline-flex;align-items:center;gap:4px;text-decoration:none}
.dug:hover{background:${c.anaHover}}
.dug.ana{background:${c.ana};border-color:${c.ana};color:${c.anaUzeri}}
.dug svg,.arama svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.govde{display:grid;grid-template-columns:180px 1fr;min-height:0;flex:1}
nav{border-right:1px solid ${c.ayirici};padding:8px 0;background:${c.zemin};overflow:auto}
nav .grup{font-size:11px;font-weight:600;letter-spacing:.06em;color:${c.metin2};padding:8px 12px 2px}
nav button{display:block;width:100%;font:inherit;text-align:left;border:0;background:transparent;color:${c.metin};height:28px;padding:0 12px 0 20px;
  cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
nav button:hover{background:${c.anaHover}}
nav button[aria-current="true"]{background:${c.anaAcik};font-weight:600}
.icerik{padding:12px 16px;overflow:auto;display:flex;flex-direction:column;gap:12px;min-width:0}
.icerik h3{margin:0;font-size:14px;font-weight:600}
.alan{display:flex;flex-direction:column;gap:4px}
.alan>.ad{font-weight:600}
.alan small,.not{color:${c.metin2};font-size:12px}
.satir{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center}
.dikey{display:flex;flex-direction:column;gap:4px}
label{display:inline-flex;gap:6px;align-items:center;cursor:pointer}
input[type=radio],input[type=checkbox]{accent-color:${c.ana};margin:0}
.kod{font-family:Consolas,"Cascadia Mono",monospace;font-size:12px;white-space:pre-wrap;background:${c.zemin};border:1px solid ${c.ayirici};border-radius:4px;padding:8px;
  max-height:220px;overflow:auto;user-select:text;overflow-wrap:anywhere}
.kisayol{font-weight:700}
.tost{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:2147483647;background:${T.tostZemin};color:${T.tostYazi};
  padding:8px 14px;border-radius:4px;font-weight:600;max-width:calc(100vw - 32px)}
@media (max-width:560px){.govde{grid-template-columns:1fr}nav{border-right:0;border-bottom:1px solid ${c.ayirici};display:flex;flex-wrap:wrap;padding:4px}
  nav .grup{width:100%;padding:4px 8px 0}nav button{width:auto;padding:0 10px}}
@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}
`);
  }

  let bolum = 'gosterim', aramaMetni = '', kisayolDinle = false, sonOdak = null, panelCiziliyor = false;
  const BOLUMLER = [
    { id: 'gosterim', grup: KOD, ad: 'bGosterim', ara: ['neGosterilsin', 'o_kutu', 'o_birim', 'o_yuzde', 'o_sirala', 'o_sepet', 'o_eksik'] },
    { id: 'genel', grup: 'ortak', ad: 'bGenel', ara: ['tema', 'dil', 'olcek', 'dugme'] },
    { id: 'kisayol', grup: 'ortak', ad: 'bKisayol', ara: ['kisayolAyarlar'] },
    { id: 'tani', grup: 'ortak', ad: 'bTani', ara: ['taniBaslik', 'raporuKopyala'] },
    { id: 'hakkinda', grup: 'ortak', ad: 'bHakkinda', ara: ['surum', 'yedek', 'disaAktar', 'iceAktar'] }
  ];
  function katla(s) { return String(s).toLocaleLowerCase('tr-TR').replace(/ı/g, 'i'); }
  function bolumEslesir(b) {
    if (!aramaMetni) return true;
    const q = katla(aramaMetni);
    return [b.ad, ...b.ara].some(k => katla(METIN.tr[k]).includes(q) || katla(METIN.en[k]).includes(q));
  }

  function arayuzKur() {
    if (UI || !document.body) return;
    const host = el('div', { id: `${ONEK}-kok` });
    const kok = host.attachShadow({ mode: 'closed' });
    const stil = el('style');
    const sar = el('div', { class: 'sar' });
    const dugme = el('button', { class: 'dugme', type: 'button', on: { click: ayarlarAc } }, KOD);
    const siralaDug = el('button', { class: 'sirala', type: 'button', 'aria-pressed': 'false', on: { click: siralaDegistir } });
    const alt = el('div', { class: 'alt' }, siralaDug, dugme);
    const dialog = el('dialog', { 'aria-labelledby': `${ONEK}-baslik` });
    const tostEl = el('div', { class: 'tost', role: 'status', hidden: true });
    const temizle = () => { if (dialog.open) return; kisayolDinle = false; if (sonOdak && sonOdak.focus) try { sonOdak.focus(); } catch (_h) { /* yok */ } sonOdak = null; };
    dialog.addEventListener('close', temizle);
    dialog.addEventListener('cancel', () => setTimeout(temizle, 0));
    ['keydown', 'keypress', 'keyup'].forEach(o => dialog.addEventListener(o, (e) => e.stopPropagation())); // sitenin tek harfli kısayolları çalışmasın
    sar.append(alt, dialog, tostEl);
    kok.append(stil, sar);
    document.body.appendChild(host);
    UI = { host, kok, stil, sar, dugme, siralaDug, alt, dialog, tostEl };
    temaUygula();
    dugmeDurumu();
  }
  function temaUygula() {
    if (!UI) return;
    UI.stil.textContent = panelCss();
    UI.dugme.hidden = !ayar.dugme;
    sayfaStiliEkle();
  }
  function dugmeDurumu() {
    if (!UI) return;
    const sorun = sayac.rozet > 0 && sayac.kart < sayac.rozet;
    UI.dugme.setAttribute('aria-label', sorun ? `${m('dugmeEtiket')} · ${m('dugmeUyari')}` : m('dugmeEtiket'));
    UI.dugme.title = UI.dugme.getAttribute('aria-label');
    const n = UI.dugme.querySelector('.nokta');
    if (sorun && !n) UI.dugme.append(el('span', { class: 'nokta', 'aria-hidden': 'true' }));
    if (!sorun && n) n.remove();
    // Sırala düğmesi yalnız listede kampanyalı kart varken
    const s = UI.siralaDug;
    s.hidden = !ayar.sirala || sayac.kart < 2;
    const yazi = siraliMi ? m('siralaAcik') : m('siralaKapali');
    if (s.dataset.yazi !== yazi) { s.textContent = ''; s.append(ikon('sirala'), yazi); s.dataset.yazi = yazi; }
    s.setAttribute('aria-pressed', String(siraliMi));
    s.title = m('siralaEtiket');
  }
  function siralaDegistir() { siraliMi = !siraliMi; siralaIstendi = siraliMi; tara(); }
  let tostZaman = 0;
  function tost(metin) {
    arayuzKur(); if (!UI) return;
    const yer = UI.dialog.open ? UI.dialog : UI.sar;
    if (UI.tostEl.parentNode !== yer) yer.append(UI.tostEl);
    UI.tostEl.textContent = metin; UI.tostEl.hidden = false;
    clearTimeout(tostZaman); tostZaman = setTimeout(() => { UI.tostEl.hidden = true; }, 2500);
  }

  function ayarlarAc() {
    arayuzKur(); if (!UI) return;
    if (UI.dialog.open) return; // açık paneli yeniden açma: odak yerinde kalsın
    sonOdak = document.activeElement;
    temaUygula();
    panelCiz();
    try { UI.dialog.showModal(); } catch (_h) { UI.dialog.setAttribute('open', ''); }
    const ilk = UI.dialog.querySelector('nav button[aria-current="true"]'); if (ilk) ilk.focus();
  }
  // Taramadan sonra yalnız Tanı metni güncellenir; panelin geri kalanı yeniden kurulmaz (odak ve kaydırma kalsın)
  function taniYenile() {
    if (!UI || !UI.dialog.open || bolum !== 'tani') return;
    const k = UI.dialog.querySelector(`#${ONEK}-rapor`);
    const r = taniRaporu();
    if (k && k.textContent !== r) k.textContent = r;
  }
  function panelYenile() { if (UI && UI.dialog.open && !kisayolDinle) panelCiz(); }

  function degistir(fn, yenidenTara) {
    fn(); ayar = ayarDuzelt(ayar); ayarKaydet();
    temaUygula(); menuKur();
    if (yenidenTara) { document.querySelectorAll(`.${ONEK}-kutu`).forEach(e => e.remove()); tara(); }
    panelYenile(); dugmeDurumu();
  }

  function radyo(ad, secenekler, secili, fn) {
    return el('div', { class: 'satir', role: 'radiogroup' }, secenekler.map(([v, y]) =>
      el('label', null, el('input', { type: 'radio', name: `${ONEK}-${ad}`, id: `${ONEK}-${ad}-${v}`, checked: v === secili, on: { change: () => fn(v) } }), y)));
  }
  function onay(id, yazi, deger, fn) {
    return el('label', null, el('input', { type: 'checkbox', id: `${ONEK}-${id}`, checked: !!deger, on: { change: (e) => fn(e.target.checked) } }), yazi);
  }
  function alan(ad, ...ic) { return el('div', { class: 'alan' }, el('span', { class: 'ad' }, ad), ...ic); }

  function panelCiz() {
    if (panelCiziliyor) return;
    panelCiziliyor = true;
    try {
      const d = UI.dialog;
      const odakId = (UI.kok.activeElement && UI.kok.activeElement.id) || '';
      const tostAcik = !UI.tostEl.hidden;
      d.textContent = '';
      const aramaInput = el('input', { type: 'search', id: `${ONEK}-ara`, 'aria-label': m('ara'), placeholder: m('ara'), value: aramaMetni });
      aramaInput.addEventListener('input', (e) => { if (e.isComposing) return; aramaMetni = aramaInput.value; panelCiz(); });
      aramaInput.addEventListener('compositionend', () => { aramaMetni = aramaInput.value; panelCiz(); });
      const ust = el('div', { class: 'ust' },
        el('div', { class: 'logo', 'aria-hidden': 'true' }, KOD),
        el('span', { class: 'baslik', id: `${ONEK}-baslik` }, `${m('ad')} · ${m('ayarlar')}`),
        el('span', { class: 'arama' }, ikon('ara'), aramaInput),
        el('button', { class: 'dug', type: 'button', id: `${ONEK}-dil`, title: 'TR / EN', on: { click: () => degistir(() => { ayar.dil = ayar.dil === 'tr' ? 'en' : 'tr'; }, true) } }, ikon('dil'), m('dilDugme')),
        el('button', { class: 'dug', type: 'button', id: `${ONEK}-tema`, on: { click: () => degistir(() => { ayar.tema = { sayfa: 'acik', acik: 'koyu', koyu: 'sayfa' }[ayar.tema]; }) } }, ikon('tema'), m('temaDugme')),
        el('button', { class: 'dug', type: 'button', id: `${ONEK}-kapat`, 'aria-label': m('kapat'), title: m('kapat'), on: { click: () => d.close() } }, ikon('kapat')));
      const gorunen = BOLUMLER.filter(bolumEslesir);
      if (gorunen.length && !gorunen.some(b => b.id === bolum)) bolum = gorunen[0].id;
      const nav = el('nav', { 'aria-label': m('ayarlar') });
      let sonGrup = '';
      gorunen.forEach(b => {
        if (b.grup !== sonGrup) { nav.append(el('div', { class: 'grup' }, b.grup === 'ortak' ? m('grupOrtak') : KOD)); sonGrup = b.grup; }
        nav.append(el('button', { type: 'button', id: `${ONEK}-nav-${b.id}`, 'aria-current': String(b.id === bolum), on: { click: () => { bolum = b.id; panelCiz(); } } }, m(b.ad)));
      });
      const icerik = el('div', { class: 'icerik' });
      if (!gorunen.length) icerik.append(el('p', { class: 'not' }, m('aramaYok')));
      else bolumIcerik(icerik);
      d.append(ust, el('div', { class: 'govde' }, nav, icerik));
      if (tostAcik) d.append(UI.tostEl);
      const odak = odakId && d.querySelector('#' + CSS.escape(odakId));
      if (odak) { odak.focus(); if (odak === aramaInput) aramaInput.setSelectionRange(aramaInput.value.length, aramaInput.value.length); }
    } finally { panelCiziliyor = false; }
  }

  function bolumIcerik(ic) {
    const b = BOLUMLER.find(x => x.id === bolum);
    ic.append(el('h3', null, m(b.ad)));
    if (bolum === 'gosterim') {
      ic.append(alan(m('neGosterilsin'), el('div', { class: 'dikey' },
        GOSTERIM.map(k => onay('g-' + k, m('o_' + k), ayar[k], v => degistir(() => { ayar[k] = v; if (k === 'sirala' && !v) siraliMi = false; }, true)))),
      el('small', null, m('gosterimNot'))));
      ic.append(el('div', null, el('button', { class: 'dug', type: 'button', id: `${ONEK}-sifirla`, on: { click: () => degistir(() => { GOSTERIM.forEach(k => { ayar[k] = VARSAYILAN[k]; }); }, true) } }, m('sifirla'))));
    } else if (bolum === 'genel') {
      ic.append(alan(m('tema'), radyo('tema', [['sayfa', m('temaSayfa')], ['acik', m('temaAcik')], ['koyu', m('temaKoyu')]], ayar.tema, v => degistir(() => { ayar.tema = v; }))));
      ic.append(alan(m('dil'), radyo('dil', [['tr', 'Türkçe'], ['en', 'English']], ayar.dil, v => degistir(() => { ayar.dil = v; }, true))));
      ic.append(alan(m('olcek'), radyo('olcek', [90, 100, 110, 125].map(o => [o, '%' + o]), ayar.olcek, v => degistir(() => { ayar.olcek = v; }))));
      ic.append(alan(m('dugme'), el('div', { class: 'satir' }, onay('dugme', m('dugmeGoster'), ayar.dugme, v => degistir(() => { ayar.dugme = v; }))), el('small', null, m('dugmeNot'))));
    } else if (bolum === 'kisayol') {
      const goster = el('span', { class: 'kisayol', id: `${ONEK}-kisayol-deger` }, kisayolGoster(ayar.kisayol));
      const bilgi = el('small', { role: 'status' }, kisayolDinle ? m('kisayolBekle') : '');
      const dg = el('button', { class: 'dug', type: 'button', id: `${ONEK}-kisayol-degistir` }, m('kisayolDegistir'));
      dg.addEventListener('click', () => { kisayolDinle = true; bilgi.textContent = m('kisayolBekle'); });
      dg.addEventListener('blur', () => { if (kisayolDinle) { kisayolDinle = false; bilgi.textContent = ''; } });
      dg.addEventListener('keydown', (e) => {
        if (!kisayolDinle) return;
        e.preventDefault(); e.stopPropagation();
        if (e.key === 'Escape') { kisayolDinle = false; bilgi.textContent = ''; return; }
        const k = tusKombo(e);
        if (!k) return;
        if (!komboKanonikMi(k)) { bilgi.textContent = m('kisayolGecersiz'); return; }
        kisayolDinle = false; degistir(() => { ayar.kisayol = k; });
      });
      ic.append(alan(m('kisayolAyarlar'), el('div', { class: 'satir' }, goster, dg,
        el('button', { class: 'dug', type: 'button', on: { click: () => degistir(() => { ayar.kisayol = VARSAYILAN.kisayol; }) } }, m('kisayolSifirla'))), bilgi));
    } else if (bolum === 'tani') {
      const rapor = taniRaporu();
      ic.append(alan(m('taniBaslik'), el('div', { class: 'kod', id: `${ONEK}-rapor` }, rapor)));
      ic.append(el('div', null, el('button', { class: 'dug ana', type: 'button', id: `${ONEK}-rapor-kopyala`, on: { click: () => panoyaYaz(taniRaporu()).then(() => tost(m('raporKopyalandi')), () => { secMetin(UI.dialog.querySelector(`#${ONEK}-rapor`)); tost(m('kopyalanamadi')); }) } }, m('raporuKopyala'))));
    } else if (bolum === 'hakkinda') {
      ic.append(el('p', { class: 'not' }, m('hakkindaNot')));
      ic.append(alan(m('surum'), el('span', null, `${m('ad')} ${SURUM} · ${KOD}`)));
      const veri = JSON.stringify({ uygulama: UYGULAMA, surum: SURUM, ayar }, null, 2);
      const indir = el('a', { class: 'dug', href: 'data:application/json;charset=utf-8,' + encodeURIComponent(veri), download: `${UYGULAMA}.ayar.json` }, m('disaAktar'));
      const dosya = el('input', { type: 'file', accept: '.json,application/json', id: `${ONEK}-ice-dosya`, hidden: true });
      dosya.addEventListener('change', () => {
        const f = dosya.files && dosya.files[0]; if (!f) return;
        const r = new FileReader();
        r.onload = () => {
          try { const j = JSON.parse(r.result); if (!j || j.uygulama !== UYGULAMA || !j.ayar) throw new Error('biçim'); degistir(() => { ayar = j.ayar; }, true); tost(m('iceAktarildi')); }
          catch (_h) { tost(m('iceAktarHata')); }
        };
        r.readAsText(f);
        dosya.value = '';
      });
      ic.append(alan(m('yedek'), el('div', { class: 'satir' }, indir, el('button', { class: 'dug', type: 'button', on: { click: () => dosya.click() } }, m('iceAktar')), dosya)));
    }
  }
  function secMetin(e) { if (!e) return; const r = document.createRange(); r.selectNodeContents(e); const s = getSelection(); s.removeAllRanges(); s.addRange(r); }
  function panoyaYaz(metin) {
    return new Promise((coz, red) => {
      try { if (typeof GM_setClipboard === 'function') { GM_setClipboard(metin, 'text'); coz(); return; } } catch (_h) { /* sonraki yol */ }
      try { navigator.clipboard.writeText(metin).then(coz, red); } catch (h) { red(h); }
    });
  }

  function taniRaporu() {
    const bek = sayac.rozet === 0;
    const isaret = (iyi) => bek ? '…' : (iyi ? '✓' : '✗');
    const satirlar = [
      `${m('ad')} ${SURUM} · ${typeof GM_info === 'object' && GM_info ? (GM_info.scriptHandler || '?') + ' ' + (GM_info.version || '') : '?'}`,
      `· ${m('tSite')}: ${location.hostname}${location.pathname.slice(0, 60)}`,
      `${isaret(sayac.rozet > 0)} ${m('tRozet')}: ${bek ? m('tBekliyor') : sayac.rozet}`,
      `${isaret(sayac.kart === sayac.rozet)} ${m('tKart')}: ${sayac.kart}/${sayac.rozet}` + (sayac.fiyatYok ? ` · ${m('tFiyat')}: ${sayac.fiyatYok}` : ''),
      `${isaret(sayac.birim > 0)} ${m('tBirim')}: ${sayac.birim}/${sayac.kart}`,
      `${isaret(sayac.gorsel > 0)} ${m('tGorsel')} (img): ${sayac.gorsel}/${sayac.kart}`,
      `· ${m('tAdet')}: ${sayac.adet}`,
      `· ${m('tSirala')}: ${siraliMi ? (sayac.sirala || '-') : m('tKapali')}`,
      `· ${m('tTanimsiz')}: ${sayac.tanimsiz.length ? sayac.tanimsiz.join(' | ') : '-'}`,
      `· ${m('tOrnek')}: ${sayac.ornek || '-'}`,
      `${sonHata ? '✗' : '✓'} ${m('tHata')}: ${sonHata || '-'}`,
      `· ayar: ${JSON.stringify(Object.fromEntries(GOSTERIM.map(k => [k, ayar[k]])))}`
    ];
    return satirlar.join('\n');
  }

  // ---------- Klavye ----------
  function tusKombo(e) {
    if (e.getModifierState && e.getModifierState('AltGraph')) return null;
    if (e.repeat || e.metaKey) return null;
    if (e.ctrlKey && e.altKey) return null;
    let ad = null;
    if (e.key === ',') ad = 'Comma';
    else if (e.key === '.') ad = 'Period';
    else if (/^Key[A-Z]$/.test(e.code || '')) ad = e.code.slice(3);
    else if (/^Digit\d$/.test(e.code || '')) ad = e.code.slice(5);
    else if (/^F\d{1,2}$/.test(e.key || '')) ad = e.key;
    if (!ad) return null;
    return (e.ctrlKey ? 'Ctrl+' : '') + (e.altKey ? 'Alt+' : '') + (e.shiftKey ? 'Shift+' : '') + ad;
  }
  function komboKanonikMi(v) {
    return /^(Ctrl\+|Alt\+)(Shift\+)?([A-Z0-9]|Comma|Period|F\d{1,2})$/.test(String(v || '')) && !YASAK.has(v);
  }
  function kisayolGoster(k) { return k.replace('Comma', ',').replace('Period', '.'); }
  document.addEventListener('keydown', (e) => {
    if (kisayolDinle || !ayar) return;
    const hedef = e.composedPath ? e.composedPath()[0] : e.target;
    const yaziAlani = hedef && hedef.nodeType === 1 && (hedef.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(hedef.tagName));
    if (yaziAlani && !e.ctrlKey) return;
    const k = tusKombo(e);
    if (!k || k !== ayar.kisayol) return;
    e.preventDefault(); e.stopPropagation();
    if (UI && UI.dialog.open) UI.dialog.close(); else ayarlarAc();
  }, true);

  // ---------- Tampermonkey menüsü ----------
  let menuKimlikleri = [];
  function menuKur() {
    if (typeof GM_registerMenuCommand !== 'function') return;
    if (typeof GM_unregisterMenuCommand !== 'function' && menuKimlikleri.length) return; // eskisi silinemiyor: çoğaltma
    if (typeof GM_unregisterMenuCommand === 'function') menuKimlikleri.forEach(k => { try { GM_unregisterMenuCommand(k); } catch (_h) { /* yok */ } });
    const harf = (s) => (/\((.)\)\s*$/.exec(s) || [])[1];
    const ogeler = [
      [m('menuAyarlar'), ayarlarAc],
      [m('menuSirala'), siralaDegistir],
      [m('menuDil'), () => degistir(() => { ayar.dil = ayar.dil === 'tr' ? 'en' : 'tr'; }, true)]
    ];
    menuKimlikleri = ogeler.map(([ad, fn]) => { try { return GM_registerMenuCommand(ad, fn, (harf(ad) || '').toLowerCase()); } catch (_h) { return null; } }).filter(x => x != null);
  }

  // ---------- Test kancası ----------
  let testMi = false;
  try { testMi = typeof GM_info === 'object' && GM_info && GM_info.scriptHandler === 'Test'; } catch (_h) { testMi = false; }
  if (testMi && window.__AALABS_TEST__ && typeof window.__AALABS_TEST__ === 'object') {
    window.__AALABS_TEST__.mgk = {
      ui: () => UI, ayar: () => ayar, sayac: () => sayac, tani: taniRaporu, tara, kampanyaCoz, hesapla, odenen, tlKurus, tlYaz,
      ayarlarAc, METIN, siralaDegistir, ayarYaz: (a) => degistir(() => { ayar = Object.assign({}, ayar, a); }, true)
    };
  }

  // ---------- Başlat ----------
  ayar = ayarDuzelt(oku('ayar', null));
  sayfaStiliEkle();
  function domHazir() {
    sayfaStiliEkle();
    arayuzKur();
    menuKur();
    tara();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', domHazir, { once: true });
  else domHazir();
})();
