.cubuk{position:fixed;left:50%;transform:translateX(-50%);bottom:16px;z-index:2147483646;display:flex;align-items:center;gap:8px;flex-wrap:wrap;max-width:calc(100vw - 32px);padding:8px 12px;background:${c.yuzey};border:1px solid ${c.kenar};border-radius:6px;color:${c.metin};font-size:13px}
.cubuk .sirala svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.gmenu{position:fixed;z-index:2147483646;display:flex;flex-direction:column;min-width:220px;max-width:280px;padding:4px;background:${c.yuzey};border:1px solid ${c.kenar};border-radius:6px}
.gmenu .menu-oge{all:unset;box-sizing:border-box;padding:6px 10px;border-radius:4px;cursor:pointer;color:${c.metin};font:400 13px "Open Sans","Segoe UI",Roboto,Arial,sans-serif;overflow-wrap:anywhere}
.gmenu .menu-oge:hover,.gmenu .menu-oge:focus-visible{background:${c.anaAcik}}
.gmenu .menu-oge[disabled]{opacity:.55;cursor:default}
.gmenu small{padding:4px 10px;color:${c.metin2};font-size:12px}
.tablo{width:100%;border-collapse:collapse}
