.kod{font-family:Consolas,"Cascadia Mono",monospace;font-size:12px;white-space:pre-wrap;background:${c.zemin};border:1px solid ${c.ayirici};border-radius:4px;padding:8px;
  max-height:220px;overflow:auto;user-select:text;overflow-wrap:anywhere}
.kisayol{font-weight:700}
.giris{height:24px;border:1px solid ${c.kenar};border-radius:4px;padding:0 6px;background:${c.zemin};color:${c.metin};font:inherit;min-width:0;flex:1 1 180px}
.giris.kucuk{flex:1 1 90px;max-width:160px}
.cip{font:inherit;font-size:12px;height:22px;padding:0 6px;border:1px solid ${c.ayirici};border-radius:11px;background:${c.anaAcik};color:${c.metin};cursor:pointer}
.dug.claude-dug{background:${CLAUDE_RENK};border-color:${CLAUDE_RENK};color:${CLAUDE_YAZI}}
