  }
  const carp = (s) => s.replace(/(^|[^\w.#-])(\d+(?:\.\d+)?)px/g, (mm, on, n) => (Number(n) <= 2 ? mm : `${on}calc(${n}px*var(--o))`));

  function temaSec() {
    if (ayar.tema === 'acik') return 'acik';
    if (ayar.tema === 'koyu') return 'koyu';
    let renk = '';
    for (const e of [document.body, document.documentElement]) {
      if (!e) continue;
      const c = getComputedStyle(e).backgroundColor;
      if (c && !/rgba\(0, 0, 0, 0\)|transparent/.test(c)) { renk = c; break; }
    }
