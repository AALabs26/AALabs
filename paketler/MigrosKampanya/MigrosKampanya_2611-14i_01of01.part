.sayac{height:32px;padding:0 10px;border-radius:6px;border:0;background:${c.ana};color:${c.anaUzeri};font:600 12px "Open Sans","Segoe UI",Roboto,Arial,sans-serif;cursor:pointer}
.ozet{position:fixed;right:16px;bottom:56px;z-index:2147483645;max-width:min(380px,calc(100vw - 32px));padding:8px 12px;background:${c.yuzey};border:1px solid ${c.kenar};border-radius:6px;display:flex;flex-direction:column;gap:4px;font-size:12px}
