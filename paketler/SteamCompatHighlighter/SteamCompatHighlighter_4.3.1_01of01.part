// ==UserScript==
// @name         AALabs Steam Compatibility Highlighter
// @namespace    aalabs
// @version      4.3.1
// @description  Steam mağazasında Steam Deck uyumunu ve Türkçe dil desteğini rozetle gösterir. Deck durumu Steam'in kendi uyumluluk bilgisinden okunur.
// @author       AALabs
// @match        https://store.steampowered.com/*
// @icon         data:image/png;base64,
// @run-at       document-start
// @noframes
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_unregisterMenuCommand
// @grant        GM_setClipboard
// @grant        GM_info
// @grant        unsafeWindow
// @aalabs-ikon  SCH
// ==/UserScript==

/*
 * Ne yapar
 *   Oyun sayfasında başlığın altına tek şerit rozet koyar: Steam Deck durumu (Doğrulanmış / Oynanabilir /
 *   Desteklenmiyor / bilinmiyor) ve nedeni, Secure Boot gereği, Türkçe dil desteği.
 *   Arama ve liste sayfalarında her oyunun yanına Deck ve Türkçe rozeti koyar; istenirse Deck'te
 *   desteklenmeyen oyunları gizler.
 *
 * Veri
 *   Deck: store.steampowered.com/saleaction/ajaxgetdeckappcompatibilityreport (Steam'in kendi adresi).
 *   Türkçe: oyun sayfasındaki dil tablosu; listede store.steampowered.com/api/appdetails.
 *   İkisi de 24 saat önbellekte tutulur.
 *
 * 4.3.0 (app-lab v02.02, oturum s7chx): AALabs adı, ortak Ayarlar (Ctrl+,), Türkçe + İngilizce, Tanı raporu.
 * 4.3.1 (s7chx): istek listesi (/wishlist/) satırlarında Deck + Türkçe rozeti; desteklenmeyen satır soluk.
 * Windows 10/11 ve Linux rozetleri kalktı (kullanıcı Windows 11 LTSC kullanıyor).
 * Tasarım kapısı: Rozet Y-A · Liste L-1 · Ayarlar A · E1–E5 · Ç1–Ç5 · K1–K5.
 */
(function () {
  'use strict';

  const SURUM = '4.3.1';
  const ID = 'SteamCompatHighlighter';
  const KOD = 'SCH';
  const AD = 'AALabs Steam Compatibility Highlighter';
  const ONBELLEK_MS = 24 * 60 * 60 * 1000;     // Deck ve dil bilgisi 24 saat geçerli
  const ONBELLEK_EN_COK = 3000;                // en çok bu kadar oyun saklanır (eskiler atılır)
  const AYNI_ANDA = 3;                         // listede aynı anda en çok bu kadar istek
  const ISTEK_ARA_MS = 150;                    // iki istek arası bekleme (Steam'i yormamak için)
  const ISTEK_SURE_MS = 15000;                 // tek istek için en uzun bekleme
  const KOPYA = Math.random().toString(36).slice(2, 8);   // bu betik örneği (iki kopya kuruluysa ayırt etmek için)

  // ---------------------------------------------------------------- test kancası (yalnız Test yöneticisinde)
  let TEST = false;
  try { TEST = typeof GM_info === 'object' && !!GM_info && GM_info.scriptHandler === 'Test'; } catch (_e) { TEST = false; }

  // ---------------------------------------------------------------- tema (tokenlardan üretildi)
  // Bu blok aalabs-tema.css'ten yazılır. Elle değiştirme.
  // TOKEN-BASLA
  // Kaynak: /* AALabs tasarım dili 1.4.1 — aalabs.tokens.json'dan üretildi. Elle değiştirme. */
  const TEMA_CSS = ":host { --tv-olcek: 1; --yazi: \"Open Sans\", \"Segoe UI\", Roboto, sans-serif; --yazi-govde: calc(14px * var(--tv-olcek)); --kontrol: calc(32px * var(--tv-olcek)); --kose-s: calc(2px * var(--tv-olcek)); --kose-m: calc(4px * var(--tv-olcek)); --kose-l: calc(6px * var(--tv-olcek)); --bosluk-1: calc(4px * var(--tv-olcek)); --bosluk-2: calc(8px * var(--tv-olcek)); --bosluk-3: calc(12px * var(--tv-olcek)); --bosluk-4: calc(16px * var(--tv-olcek)); --bosluk-5: calc(24px * var(--tv-olcek)); --bosluk-6: calc(32px * var(--tv-olcek)); --ana: #2456D6; --ana-acik: #E5EBFA; --ana-hover: #F2F5FD; --ana-uzeri: #FFFFFF; --vurgu: #2456D6; --zemin: #F6F9FC; --yuzey: #FFFFFF; --metin: #17252E; --metin-ikincil: #4E6269; --kenar: #7A9199; --ayirici: #D3DEE6; --basari: #18763F; --basari-bg: #E4F5E8; --uyari: #9A5B00; --uyari-bg: #FDF6D8; --hata: #C4313B; --hata-bg: #FDE8E8; --kat-belge: #6237C8; --kat-tablo: #1D7A3A; --kat-gorsel: #B0256C; --kat-kod: #2453C7; --kat-video: #A8500F; --kat-arsiv: #7A5A00; --kat-onemli: #B4232B; --kat-oyun: #0B6E78; color-scheme: light; }\n:host([data-theme=\"dark\"]) { --ana: #2456D6; --ana-acik: #1D2C4F; --ana-hover: #1B2434; --ana-uzeri: #FFFFFF; --vurgu: #86A8FF; --zemin: #0F1520; --yuzey: #161E2B; --metin: #E6ECF5; --metin-ikincil: #9AA8BC; --kenar: #6A7B93; --ayirici: #263142; --basari: #4CC38A; --basari-bg: #13301F; --uyari: #E8AC45; --uyari-bg: #33270F; --hata: #FF8189; --hata-bg: #3A161A; color-scheme: dark; }\n";
  // Türkçe rozeti: kullanıcı kararı (2026-10-21) kırmızı zemin, beyaz yazı = kategori "Önemli" (6,5:1)
  const ROZET_RENK_CSS = ":host { --trk-zemin: #B4232B; --trk-yazi: #FFFFFF; --perde: rgba(10, 14, 20, .55); --steam-zemin: #1B2838; }\n";
  // TOKEN-BITIR

