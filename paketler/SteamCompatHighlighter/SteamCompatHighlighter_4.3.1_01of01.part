      d3: 'Deck Doğrulanmış', d2: 'Deck Oynanabilir', d1: 'Deck Desteklenmiyor', d0: 'Deck bilinmiyor', dYukleniyor: 'Deck…',
      dHata: 'Deck bilgisi alınamadı', tr: 'Türkçe', arayuz: 'arayüz', ses: 'ses', altyazi: 'altyazı', sb: 'Secure Boot gerekli',
