      yedekHata: 'Dosya okunamadı. AALabs Steam Compatibility Highlighter yedeği (.json) seç.',
      menuAyarlar: 'Ayarlar (A)', menuRapor: 'Tanı raporunu kopyala (T)',
    },
    en: {
      ayarlar: 'Settings', ara: 'Search settings (Ctrl+F)', sonucYok: 'No results. Try another word.', ortak: 'COMMON',
      kapat: 'Close (Esc)', bildirimKapat: 'Close notification',
      varsayilan: 'Reset to default', sifirlandi: 'This section was reset',
      b_deck: 'Steam Deck', b_turkce: 'Turkish', b_liste: 'List pages', b_genel: 'General', b_kisayol: 'Keyboard shortcuts', b_tani: 'Diagnostics', b_hakkinda: 'About',
      deckAlt: "Status comes from Steam's own compatibility data. No other extension is needed.",
      deckGoster: 'Show Deck badge', deckDogru: 'Show it for Verified games too', deckDogruAc: 'When off, only Playable and Unsupported are shown.',
