      listeAlt: 'One request goes to Steam for each visible game; results are cached.',
      listeDeck: 'Deck badge in search and lists', listeTr: 'Turkish badge in lists', listeSuz: 'Hide games unsupported on Deck',
      listeSuzAc: 'The number of hidden games is shown above the list. On the wishlist the row is dimmed, not hidden.',
      dil: 'Language', dil_tr: 'Türkçe', dil_en: 'English', dil_tarayici: 'Browser language', algilanan: 'Detected: {dil}',
      tema: 'Theme', tema_sayfa: 'Follow page', tema_acik: 'Light', tema_koyu: 'Dark', olcek: 'Scale',
