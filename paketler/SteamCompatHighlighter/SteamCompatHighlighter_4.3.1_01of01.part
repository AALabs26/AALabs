      gizlendi: '{n} games hidden (unsupported on Deck)', 'gizlendi#1': '{n} game hidden (unsupported on Deck)', gizlenenleriGoster: 'Show', gosteriliyor: 'Showing {n} games unsupported on Deck', 'gosteriliyor#1': 'Showing {n} game unsupported on Deck', tekrarGizle: 'Hide',
