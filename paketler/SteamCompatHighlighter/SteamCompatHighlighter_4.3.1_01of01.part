      t_deck: 'Deck request', t_deckBekle: 'No request yet', t_deckOnbellek: 'from cache',
      t_dil: 'Language table', t_dilVar: 'Turkish row found', t_dilYok: 'No Turkish row', t_dilTabloYok: 'Language table not found',
