  const DIL = (function () {
    const dinleyiciler = new Set();
    let aktif = 'tr';

    function tarayici() {
      const d = (navigator.languages && navigator.languages[0]) || navigator.language || 'tr';
      return /^tr\b/i.test(d) ? 'tr' : 'en';
    }
    function secim() {
      const s = ayarOku('dil', 'tr');
      return s === 'en' || s === 'sistem' ? s : 'tr';
    }
    function kur() {
      const s = secim();
      aktif = s === 'sistem' ? tarayici() : s;
      try { document.documentElement && document.documentElement.setAttribute('data-cls-dil', aktif); } catch (e) {}
    }
    function haber() { for (const f of [...dinleyiciler]) { try { f(aktif); } catch (e) { gunluk('dil', e.message); } } }
    // Geçersiz değer yazılmaz; görünen dil değişmediyse dinleyiciler (özellik yeniden kurulumu) çalışmaz.
    function sec(s) {
      if (!['tr', 'en', 'sistem'].includes(s)) return false;
      ayarYaz('dil', s);
      const once = aktif;
      kur();
      if (aktif !== once) haber();
      return true;
    }
    // "Tarayıcı dili" seçiliyken tarayıcının dili değişirse izle.
    try { window.addEventListener('languagechange', () => { if (secim() !== 'sistem') return; const once = aktif; kur(); if (aktif !== once) haber(); }); } catch (e) {}
    function degistir() { sec(aktif === 'tr' ? 'en' : 'tr'); }
    function degisince(f) { dinleyiciler.add(f); return () => dinleyiciler.delete(f); }
    kur();
    return { aktif: () => aktif, secim, sec, degistir, degisince, tarayici, kur };
  })();

  function _(s) {
    if (DIL.aktif() !== 'en') return s;
    const v = EN[s];
    return v === undefined ? s : v;
  }
  function _f(s, ...a) {
    return _(s).replace(/\{(\d)\}/g, (m, i) => (a[i] === undefined ? '' : String(a[i])));
  }
  // _n: yalnız çeviri anahtarı olarak işaretler; çeviri gösterirken _() ile yapılır
  // (ör. hata iletisi Türkçe atılır, ekrana _(e.message) ile çıkar).
  const _n = s => s;
  // Yüzde: Türkçede %100, İngilizcede 100%.
  const yuzde = v => (DIL.aktif() === 'en' ? v + '%' : '%' + v);
  // Büyük harf: Türkçede i → İ.
  const buyuk = s => s.toLocaleUpperCase(DIL.aktif() === 'tr' ? 'tr' : 'en');

  /* =====================================================================
   * 2d) KLAVYE KISAYOLLARI (Ayarlar › Klavye kısayolları)
   *
   * Tek kayıt: genel dinleyici, Ayarlar sayfası, komut paleti ve özellik
   * satırları buradan okur. Kullanıcı tuşu değiştirebilir; çakışan ya da
   * tarayıcının / claude.ai'nin kullandığı tuş reddedilir. Ctrl+, Ayarlar
   * için sabit ek tuştur, listede değiştirilmez.
   * ===================================================================== */

  const KISAYOL = (function () {
    const LISTE = [
      { id: 'ayarlar', ad: _n('Ayarlar'), varsayilan: 'Alt+D', sabit: 'Ctrl+,' },
      { id: 'palet', ad: _n('Komut paleti'), varsayilan: 'Alt+K' },
      { id: 'sablon', ad: _n('Şablon paleti'), varsayilan: 'Alt+T' },
      { id: 'sablonYonet', ad: _n('Şablon yöneticisi'), varsayilan: 'Alt+Shift+T' },
      { id: 'baslik', ad: _n('Başlığı düzenle'), varsayilan: 'Alt+B' },
      { id: 'markdown', ad: _n('Markdown\'a aktar'), varsayilan: 'Alt+M' },
      { id: 'solaSabitle', ad: _n('Sola sabitle aç/kapa'), varsayilan: 'Alt+L' },
      { id: 'solaYeniden', ad: _n('Sola sabitlemeyi yeniden hesapla'), varsayilan: 'Alt+R' },
      { id: 'dil', ad: _n('Dil değiştir (TR/EN)'), varsayilan: 'Alt+Shift+L' }
    ];
    // Tarayıcının ve claude.ai'nin kendi tuşları; atanamaz.
    const AYRILMIS = new Set(['Ctrl+K', 'Ctrl+Shift+T', 'Ctrl+T', 'Ctrl+W', 'Ctrl+Shift+W', 'Ctrl+N', 'Ctrl+Shift+N',
      'Ctrl+L', 'Ctrl+F', 'Ctrl+G', 'Ctrl+H', 'Ctrl+J', 'Ctrl+D', 'Ctrl+P', 'Ctrl+S', 'Ctrl+O', 'Ctrl+R', 'Ctrl+Shift+R',
      'Ctrl+C', 'Ctrl+V', 'Ctrl+X', 'Ctrl+Z', 'Ctrl+Y', 'Ctrl+A', 'Ctrl+B', 'Ctrl+I', 'Ctrl+U', 'Ctrl+E', 'Ctrl+Enter',
      'Ctrl+Tab', 'Ctrl+Shift+Tab', 'Ctrl+,', 'Alt+F4', 'Alt+Tab', 'Alt+Left', 'Alt+Right', 'Alt+Home', 'Ctrl+Shift+I',
      'Ctrl+Shift+J', 'Ctrl+Shift+K', 'Ctrl+Shift+C', 'Ctrl+Shift+Delete', 'Ctrl+Shift+P', 'Alt+Shift+P',
      'Ctrl+Shift+Z', 'Ctrl+Shift+V', 'Ctrl+Shift+O', 'Ctrl+Shift+E', 'Ctrl+Shift+B', 'Ctrl+Shift+H', 'Ctrl+Shift+A',
      'Ctrl+Shift+M', 'Ctrl+Shift+S', 'Ctrl+Shift+X', 'Ctrl+Shift+Y', 'Ctrl+Shift+D', 'Ctrl+Shift+F', 'Ctrl+Shift+G',
      'Alt+F', 'Alt+E', 'Alt+V', 'Alt+S', 'Alt+H']);   // Firefox menü çubuğu harfleri

    function kayitli() { const o = ayarOku('kisayollar', {}); return o && typeof o === 'object' ? o : {}; }
    function tus(id) {
      const k = LISTE.find(x => x.id === id);
      if (!k) return '';
      const v = kayitli()[id];
      return v === '' ? '' : (v || k.varsayilan);
    }
    // KeyboardEvent → "Ctrl+Alt+Shift+X". Harfte e.code okunur: klavye düzeni ve Alt ile
    // değişen karakter (Alt+D → ∂ gibi) sonucu bozmaz.
    function adlandir(e) {
      let k = e.key;
      if (/^Key[A-Z]$/.test(e.code || '')) k = e.code.slice(3);
      else if (/^Digit\d$/.test(e.code || '')) k = e.code.slice(5);
      else if (/^Numpad\d$/.test(e.code || '')) k = 'Num' + e.code.slice(6);
      else if (k === ' ') k = 'Space';
      else if (k === 'ArrowLeft') k = 'Left';
      else if (k === 'ArrowRight') k = 'Right';
      else if (k === 'ArrowUp') k = 'Up';
      else if (k === 'ArrowDown') k = 'Down';
      else if (k && k.length === 1) k = k.toUpperCase();
      if (['Control', 'Alt', 'Shift', 'Meta', 'AltGraph'].includes(k)) return null;
      const p = [];
      if (e.ctrlKey) p.push('Ctrl');
      if (e.metaKey) p.push('Meta');
      if (e.altKey) p.push('Alt');
      if (e.shiftKey) p.push('Shift');
      p.push(k);
      return p.join('+');
    }
    function eslesir(e) {
      if (api.yakalaniyor) return null;   // Ayarlar'da yeni tuş okunurken kısayollar susar
      if (e.isComposing || e.key === 'Process') return null;               // IME ile yazarken
      if (e.getModifierState && e.getModifierState('AltGraph')) return null; // AltGr ile @ € { } yazılır
      const ad = adlandir(e);
      if (!ad) return null;
      if (ad === 'Ctrl+,') return 'ayarlar';
      for (const k of LISTE) if (tus(k.id) === ad) return k.id;
      return null;
    }
    // Hata varsa Türkçe kaynak metin + değer döner; çağıran _f ile gösterir.
    function denetle(id, ad) {
      if (!ad) return null;
      const parca = ad.split('+');
      const ana = parca[parca.length - 1];
      const ekler = parca.slice(0, -1).join('+');
      if (parca.length === 1 || (parca.length === 2 && parca[0] === 'Shift')) {
        return { m: _n('{0} tek başına kısayol olamaz; Ctrl ya da Alt ile birlikte bas.'), a: [ad] };
      }
      /* İzin listesi: ana tuş harf ya da F1–F12; değiştirici Alt, Alt+Shift ya da Ctrl+Shift.
         Ctrl+Alt Windows'ta AltGr'dir (@ € { } yazar); Alt+rakam numpad karakter kodlarını
         bozar; Ctrl+tek harf ve oklar metin düzenlemenin tuşlarıdır. */
      const anaUygun = /^[A-Z]$/.test(ana) || /^F([1-9]|1[0-2])$/.test(ana);
      if (!anaUygun || !['Alt', 'Alt+Shift', 'Ctrl+Shift'].includes(ekler)) {
        return { m: _n('{0} kullanılamaz. Alt, Alt+Shift ya da Ctrl+Shift ile bir harf ya da F1–F12 seç.'), a: [ad] };
      }
      if (AYRILMIS.has(ad)) return { m: _n('{0} tarayıcının ya da claude.ai\'nin tuşu; başka bir tuş seç.'), a: [ad] };
      const cak = LISTE.find(k => k.id !== id && tus(k.id) === ad);
      if (cak) return { m: _n('{0} zaten "{1}" için kullanılıyor.'), a: [ad, cak.ad], cakisan: cak.ad };
      return null;
    }
    function ayarla(id, ad) {
      const h = denetle(id, ad);
      if (h) return h;
      const o = Object.assign({}, kayitli());
      const k = LISTE.find(x => x.id === id);
      if (k && ad === k.varsayilan) delete o[id]; else o[id] = ad;
      ayarYaz('kisayollar', o);
      return null;
    }
    function sifirla() { ayarYaz('kisayollar', {}); }
    function degismisMi() { return Object.keys(kayitli()).length > 0; }
    const api = { LISTE, tus, adlandir, eslesir, denetle, ayarla, sifirla, degismisMi, yakalaniyor: false };
    return api;
  })();

  /* =====================================================================
   * 3) TEMA VE BİLEŞENLER (AALabs tasarım dili 1.4.1)
   *
   * Tema claude.ai'yi izler: site koyuya geçince bizim pencereler de Gece
   * temasına geçer. Renkler yalnız aşağıdaki token tablosundan gelir.
   * Gölge, bulanıklık ve degrade yok; köşeler 2 / 4 / 6 px.
   * ===================================================================== */

  function media(q) {
    try {
      if (typeof window.matchMedia !== 'function') return null;
      return window.matchMedia(q);
    } catch (e) { return null; }
  }

  function isDark() {
    try {
      const el = document.documentElement;
      const attr = el.getAttribute('data-mode') || el.getAttribute('data-theme');
      if (attr) return /dark/i.test(attr);
      if (el.classList.contains('dark')) return true;
      const m = (getComputedStyle(document.body).backgroundColor || '').match(/\d+(\.\d+)?/g);
      if (m && m.length >= 3 && (m.length < 4 || parseFloat(m[3]) > 0)) {
        return (0.2126 * +m[0] + 0.7152 * +m[1] + 0.0722 * +m[2]) / 255 < 0.5;
      }
    } catch (e) {}
    const mq = media('(prefers-color-scheme: dark)');
    return mq ? mq.matches : false;
  }

  const TOKEN = {
    ortak: {
      'yazi': '"Open Sans","Segoe UI",Roboto,system-ui,sans-serif',
      'kose-s': '2px', 'kose-m': '4px', 'kose-l': '6px',
      'ana': '#2456D6', 'ana-uzeri': '#FFFFFF', 'ana-basili': '#204CBD',
      'kat-belge': '#6237C8', 'kat-tablo': '#1D7A3A', 'kat-gorsel': '#B0256C', 'kat-kod': '#2453C7',
      'kat-video': '#A8500F', 'kat-arsiv': '#7A5A00', 'kat-onemli': '#B4232B', 'kat-oyun': '#0B6E78'
    },
    acik: {
      'ana-acik': '#E5EBFA', 'ana-hover': '#F2F5FD', 'vurgu': '#2456D6',
      'zemin': '#F6F9FC', 'yuzey': '#FFFFFF', 'metin': '#17252E', 'metin-ikincil': '#4E6269',
      'kenar': '#7A9199', 'ayirici': '#D3DEE6',
      'basari': '#18763F', 'basari-bg': '#E4F5E8', 'uyari': '#9A5B00', 'uyari-bg': '#FDF6D8',
      'hata': '#C4313B', 'hata-bg': '#FDE8E8', 'ortu': 'rgba(10,20,30,.32)'
    },
    koyu: {
      'ana-acik': '#1D2C4F', 'ana-hover': '#1B2434', 'vurgu': '#86A8FF',
      'zemin': '#0F1520', 'yuzey': '#161E2B', 'metin': '#E6ECF5', 'metin-ikincil': '#9AA8BC',
      'kenar': '#6A7B93', 'ayirici': '#263142',
      'basari': '#4CC38A', 'basari-bg': '#13301F', 'uyari': '#E8AC45', 'uyari-bg': '#33270F',
      'hata': '#FF8189', 'hata-bg': '#3A161A', 'ortu': 'rgba(0,0,0,.5)'
    }
  };

  /* CLS pencerelerinin teması: Ayarlar › Genel › Tema. "site" claude.ai'yi izler.
     Sayfaya yerleşen parçalar (kullanım şeridi, mesaj saati, model rengi) her
     zaman sitenin temasını izler; onlar isDark() kullanır. */
  function pencereKoyu() {
    const t = ayarOku('tema', 'site');
    if (t === 'acik') return false;
    if (t === 'koyu') return true;
    return isDark();
  }

  const TEMA = (function () {
    const hostlar = new Set();
    let sonKoyu = null;

    function vars() {
      return Object.assign({}, TOKEN.ortak, pencereKoyu() ? TOKEN.koyu : TOKEN.acik);
    }

    function uygula(el) {
      const v = vars();
      for (const [k, val] of Object.entries(v)) el.style.setProperty('--' + k, val);
      el.style.setProperty('color-scheme', pencereKoyu() ? 'dark' : 'light');
    }

    function kaydet(el) { hostlar.add(el); uygula(el); return () => hostlar.delete(el); }

    const dinleyiciler = new Set();

    function denetle() {
      const k = pencereKoyu();
      if (k === sonKoyu) return;
      sonKoyu = k;
      for (const el of hostlar) { if (el.isConnected) uygula(el); else hostlar.delete(el); }
      for (const fn of dinleyiciler) { try { fn(k); } catch (e) {} }
    }

    let kuruldu = false;
    function kur() {
      if (kuruldu) return;
      kuruldu = true;
      new MutationObserver(denetle).observe(document.documentElement, {
        attributes: true, attributeFilter: ['class', 'style', 'data-mode', 'data-theme']
      });
      const mq = media('(prefers-color-scheme: dark)');
      if (mq && mq.addEventListener) mq.addEventListener('change', denetle);
      setInterval(denetle, 3000);   // gövde rengi değişimi için yedek
      denetle();
    }

    return {
      vars, uygula, kaydet, kur, koyuMu: pencereKoyu, yenile() { sonKoyu = null; denetle(); },
      degisince(fn) { dinleyiciler.add(fn); return () => dinleyiciler.delete(fn); }
    };
  })();

  // Open Sans Google Fonts'tan; site izin vermezse yedek aile (Segoe UI) kullanılır.
  function yaziYukle() {
    if (document.getElementById('aalabs-open-sans')) return;
    const l = document.createElement('link');
    l.id = 'aalabs-open-sans';
    l.rel = 'stylesheet';
    l.href = 'https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,700&display=swap';
    (document.head || document.documentElement).appendChild(l);
  }

  /* Lucide ikonları (ISC lisansı), 24 px ızgara, 2 px çizgi, tek renk. */
  const IKON = {
    x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
    ara: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
    etiket: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r="1"/>',
    saat: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
    indir: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/>',
    yukle: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m17 8-5-5-5 5"/><path d="M12 3v12"/>',
    tamam: '<path d="M20 6 9 17l-5-5"/>',
    uyari: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
    bilgi: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
    hata: '<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>',
    dosya: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/>',
    komut: '<path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"/>',
    buyut: '<path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="m21 3-7 7"/><path d="m3 21 7-7"/>',
    nabiz: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
    kopya: '<rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16V4a2 2 0 0 1 2-2h12"/>',
    dis: '<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>',
    onay: '<path d="M21 10.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h12.5"/><path d="m9 11 3 3L22 4"/>',
    yenile: '<path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v6h-6"/>'
  };
  const ikon = (ad, boy) =>
    `<svg width="${boy || 16}" height="${boy || 16}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${IKON[ad] || ''}</svg>`;

  // Menü kısayolu biçimi: "Kaydet (K)" — harf büyük ve kalın; rakam kalın italik.
  function etiketHTML(metin, harf) {
    if (!harf) return metin;
    const h = /[0-9]/.test(harf) ? `<b><i>${harf}</i></b>` : `<b>${buyuk(harf)}</b>`;
    return `${metin} (${h})`;
  }

  /* Bütün AALabs pencerelerinin ortak stili. Her gölge kökünde ilk sırada. */
  const TEMEL_CSS = `
  :host{all:initial}
  *{box-sizing:border-box}
  .k{font-family:var(--yazi);font-size:13px;line-height:1.45;color:var(--metin);-webkit-font-smoothing:antialiased}
  svg{flex:none}
  .dg{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;gap:6px;
    height:32px;padding:0 12px;border-radius:var(--kose-s);border:1px solid var(--kenar);background:var(--yuzey);
    color:var(--metin);font:400 13px/1 var(--yazi);cursor:pointer;white-space:nowrap;transition:background .1s}
  .dg:hover{background:var(--ana-hover)}
  .dg:active{background:var(--ana-acik)}
  .dg:focus-visible,.odak:focus-visible{outline:2px solid var(--vurgu);outline-offset:2px}
  .dg b{font-weight:700}
  .dg.ana{background:var(--ana);border-color:var(--ana);color:var(--ana-uzeri)}
  .dg.ana:hover{background:#3A67DA}
  .dg.ana:active{background:var(--ana-basili)}
  .dg.tehlike{border-color:var(--hata);color:var(--hata)}
  .dg.tehlike:hover{background:var(--hata-bg)}
  .dg.hayalet{border-color:transparent;background:transparent}
  .dg.hayalet:hover{background:var(--ana-hover)}
  .dg.kucuk{height:24px;padding:0 8px;font-size:12px}
  .dg.ikonlu{width:32px;padding:0}
  .dg[disabled]{opacity:.55;cursor:default}
  .girdi{all:unset;box-sizing:border-box;display:block;width:100%;height:32px;padding:0 10px;
    border:1px solid var(--kenar);border-radius:var(--kose-s);background:var(--yuzey);color:var(--metin);
    font:400 13px/30px var(--yazi)}
  .girdi::placeholder{color:var(--metin-ikincil)}
  .girdi:focus{outline:2px solid var(--vurgu);outline-offset:-1px}
  textarea.girdi{height:auto;min-height:140px;padding:8px 10px;line-height:1.5;white-space:pre-wrap;
    font-family:ui-monospace,Consolas,monospace;font-size:12px;overflow-y:auto}
  .anah{all:unset;box-sizing:border-box;position:relative;flex:none;width:32px;height:18px;border-radius:9px;
    background:var(--kenar);cursor:pointer;transition:background .1s}
  .anah::after{content:"";position:absolute;top:3px;left:3px;width:12px;height:12px;border-radius:50%;
    background:var(--yuzey);transition:left .1s}
  .anah[aria-checked="true"]{background:var(--ana)}
  .anah[aria-checked="true"]::after{left:17px}
  .anah:focus-visible{outline:2px solid var(--vurgu);outline-offset:2px}
  .anah[disabled]{opacity:.55;cursor:default}
  .kbd{font:400 11px/1 var(--yazi);color:var(--metin-ikincil);border:1px solid var(--ayirici);
    border-radius:var(--kose-s);padding:3px 5px;white-space:nowrap}
  .ust-etiket{font:600 11px/1.4 var(--yazi);letter-spacing:.04em;text-transform:uppercase;color:var(--metin-ikincil)}
  .ikincil{color:var(--metin-ikincil)}
  .ortu{position:fixed;inset:0;background:var(--ortu)}
  .pencere{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);max-width:calc(100vw - 32px);
    max-height:calc(100vh - 48px);display:flex;flex-direction:column;background:var(--yuzey);
    border:1px solid var(--kenar);border-radius:var(--kose-l);overflow:hidden}
  .p-bas{display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid var(--ayirici);flex:none}
  .p-bas .logo{width:24px;height:24px;border-radius:var(--kose-m);background:var(--ana);color:var(--ana-uzeri);
    display:grid;place-items:center;font:600 9px/1 var(--yazi);letter-spacing:.02em;flex:none}
  .p-bas h2{margin:0;font:600 14px/1.3 var(--yazi);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .p-bas .surum{font-size:11px;color:var(--metin-ikincil);font-variant-numeric:tabular-nums}
  .p-govde{flex:1;min-height:0;overflow:auto}
  .p-alt{display:flex;align-items:center;gap:8px;padding:10px 12px;border-top:1px solid var(--ayirici);flex:none;flex-wrap:wrap}
  .p-alt .bosluk{flex:1}
  .bos{padding:24px 16px;text-align:center;color:var(--metin-ikincil)}
  .bos b{display:block;color:var(--metin);font-weight:600;margin-bottom:4px}
  ::-webkit-scrollbar{width:10px;height:10px}
  ::-webkit-scrollbar-thumb{background:var(--kenar);border-radius:5px;border:2px solid var(--yuzey)}
  ::-webkit-scrollbar-track{background:transparent}
  *{scrollbar-width:thin;scrollbar-color:var(--kenar) transparent}
  @media (prefers-reduced-motion: reduce){*{transition:none!important}}
  `;

  /* Gölge kökü olan bir kabuk açar. Tema kaydı, pano koruması ve kaldırma
     birlikte yönetilir. */
  function kabuk(id, ekCss, zIndex) {
    const host = document.createElement('div');
    if (id) host.id = id;
    host.style.cssText = `position:fixed;inset:0;z-index:${zIndex || 2147483000};pointer-events:none;`;
    const root = host.attachShadow({ mode: 'open' });
    const st = document.createElement('style');
    st.textContent = TEMEL_CSS + (ekCss || '');
    root.appendChild(st);
    const kok = document.createElement('div');
    kok.className = 'k';
    root.appendChild(kok);
    (document.body || document.documentElement).appendChild(host);
    const temaBirak = TEMA.kaydet(host);
    UI_HOSTS.add(host);
    return {
      host, root, kok,
      kaldir() { temaBirak(); UI_HOSTS.delete(host); host.remove(); }
    };
  }

  /* Bildirim: altta ortada, durum ikonu + kısa metin. 2,6 sn kalır. */
  const BILDIRIM = (function () {
    let k = null, el = null, zam = null;
    const CSS = `
    .bld{position:fixed;left:50%;bottom:88px;transform:translateX(-50%);display:flex;align-items:center;gap:8px;
      max-width:min(520px,calc(100vw - 32px));padding:8px 12px;border-radius:var(--kose-m);
      background:var(--yuzey);border:1px solid var(--kenar);color:var(--metin);pointer-events:auto;
      opacity:0;transition:opacity .15s}
    .bld.acik{opacity:1}
    .bld.basari svg{color:var(--basari)} .bld.hata svg{color:var(--hata)}
    .bld.uyari svg{color:var(--uyari)} .bld.bilgi svg{color:var(--vurgu)}`;
    return function bildir(metin, tur) {
      if (!document.body) return;
      if (!k || !k.host.isConnected) {
        k = kabuk('aalabs-cls-bildirim', CSS, 2147483002);
        el = document.createElement('div');
        el.className = 'bld';
        el.setAttribute('role', 'status');
        k.kok.appendChild(el);
      }
      const t = tur || 'bilgi';
      const ad = { basari: 'tamam', hata: 'hata', uyari: 'uyari', bilgi: 'bilgi' }[t] || 'bilgi';
      el.className = 'bld ' + t;
      el.innerHTML = ikon(ad);
      const s = document.createElement('span');
      s.textContent = metin;
      el.appendChild(s);
      requestAnimationFrame(() => el.classList.add('acik'));
      clearTimeout(zam);
      zam = setTimeout(() => { if (el) el.classList.remove('acik'); }, t === 'hata' ? 5000 : 2600);
    };
  })();
  const bildir = BILDIRIM;

  /* Ortada pencere. Esc ve örtüye tıklama kapatır. Aynı anda tek pencere. */
  let aktifPencere = null;
  function pencereAc(o) {
    if (aktifPencere) aktifPencere.kapat();
    const k = kabuk('aalabs-cls-pencere', o.css || '', 2147483001);
    const ortu = document.createElement('div');
    ortu.className = 'ortu';
    ortu.style.pointerEvents = 'auto';
    const p = document.createElement('div');
    p.className = 'pencere';
    p.style.pointerEvents = 'auto';
    p.style.width = (o.genislik || 560) + 'px';
    if (o.yukseklik) p.style.height = o.yukseklik + 'px';
    if (o.ust) { p.style.top = o.ust; p.style.transform = 'translateX(-50%)'; }
    p.setAttribute('role', 'dialog');
    p.setAttribute('aria-modal', 'true');
    p.setAttribute('aria-label', o.baslik || UYGULAMA_ADI);
    olcekUygula(p);
    k.kok.append(ortu, p);

    const onceki = document.activeElement;
    const tus = e => {
      if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); kapat(); return; }
      if (o.tus) o.tus(e);
    };
    p.addEventListener('keydown', tus);
    // Sayfanın kendi kısayolları (Enter yeni satır, site kısayolları) pencerede çalışmasın.
    p.addEventListener('keydown', e => e.stopPropagation());
    p.addEventListener('keyup', e => e.stopPropagation());
    p.addEventListener('keypress', e => e.stopPropagation());
    ortu.addEventListener('click', () => kapat());

    let kapandi = false;
    function kapat() {
      if (kapandi) return;
      kapandi = true;
      if (aktifPencere && aktifPencere.p === p) aktifPencere = null;
      k.kaldir();
      if (o.kapaninca) { try { o.kapaninca(); } catch (e) {} }
      try { if (onceki && onceki.focus && onceki.isConnected) onceki.focus(); } catch (e) {}
    }

    aktifPencere = { p, kapat, k };
    return { k, p, kapat };
  }

  /* Ölçek: Ayarlar › Genel › Ölçek (%100 / 125 / 150). Yalnız CLS pencereleri
     büyür; claude.ai'nin kendisi değişmez. Firefox 126+ ve Chromium 'zoom' bilir. */
  const OLCEKLER = [100, 125, 150];
  function olcek() { const v = +ayarOku('olcek', 100); return OLCEKLER.includes(v) ? v : 100; }
  function olcekUygula(el) {
    const v = olcek();
    if (v === 100) {
      el.style.removeProperty('zoom'); el.style.removeProperty('max-width'); el.style.removeProperty('max-height');
      return;
    }
    // zoom uzunlukları (vw dahil) büyütür; sınırlar ölçeğe bölünür ki pencere ekrana sığsın.
    el.style.setProperty('zoom', String(v / 100));
    el.style.setProperty('max-width', `calc((100vw - 32px) / ${v / 100})`);
    el.style.setProperty('max-height', `calc((100vh - 48px) / ${v / 100})`);
  }

  function basBolum(baslik, sag) {
    const b = document.createElement('div');
    b.className = 'p-bas';
    b.innerHTML = `<span class="logo">${IKON_KODU}</span><h2></h2>`;
    b.querySelector('h2').textContent = baslik;
    if (sag) b.appendChild(sag);
    return b;
  }

  // harf tek harf ya da { tr: 'y', en: 'n' }: iki dilde ayrı kısayol harfi.
  const harfSec = h => (h && typeof h === 'object' ? h[DIL.aktif()] || h.tr : h);
  function dugme(metin, harf, tur, ikonAd) {
    harf = harfSec(harf);
    const d = document.createElement('button');
    d.type = 'button';
    d.className = 'dg' + (tur ? ' ' + tur : '');
    d.innerHTML = (ikonAd ? ikon(ikonAd) : '') + `<span>${etiketHTML(metin, harf)}</span>`;
    if (harf) d.dataset.harf = harf.toLocaleLowerCase(DIL.aktif() === 'tr' ? 'tr' : 'en');
    return d;
  }

  // Pencerede, odak bir alanda değilken düğme harfine basmak düğmeyi çalıştırır.
  function harfKisayolu(p, e) {
    if (e.altKey || e.ctrlKey || e.metaKey || e.key.length !== 1) return false;
    const yol = e.composedPath ? e.composedPath() : [];
    if (yol.some(n => n && (n.tagName === 'INPUT' || n.tagName === 'TEXTAREA'))) return false;
    const h = e.key.toLocaleLowerCase(DIL.aktif() === 'tr' ? 'tr' : 'en');
    const d = [...p.querySelectorAll('button[data-harf]:not([disabled])')].find(b => b.dataset.harf === h);
    if (!d) return false;
    e.preventDefault();
    d.click();
    return true;
  }

  function indir(dosyaAdi, metin, tur) {
    const blob = new Blob([metin], { type: tur || 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = dosyaAdi;
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 4000);
  }

  async function panoyaYaz(metin) {
    try { await navigator.clipboard.writeText(metin); return true; } catch (e) {}
    try {
      const t = document.createElement('textarea');
      t.value = metin;
      t.style.cssText = 'position:fixed;left:-9999px;top:0';
      document.body.appendChild(t);
      t.select();
      const ok = document.execCommand('copy');
      t.remove();
      return ok;
    } catch (e) { return false; }
  }

  function dosyaSec(kabul) {
    return new Promise(resolve => {
      const inp = document.createElement('input');
      inp.type = 'file';
      inp.accept = kabul || '';
      inp.style.display = 'none';
      document.body.appendChild(inp);
      inp.addEventListener('change', () => {
        const f = inp.files && inp.files[0];
        inp.remove();
        if (!f) return resolve(null);
        const rd = new FileReader();
        rd.onload = () => resolve({ ad: f.name, metin: String(rd.result) });
        rd.onerror = () => resolve(null);
        rd.readAsText(f);
      });
      inp.click();
    });
  }

  /* Pencere içinde onay satırı. Sayfanın confirm() kutusu yerine. */
  function onayla(o) {
    return new Promise(resolve => {
      let sonuc = null;
      const w = pencereAc({
        baslik: o.baslik, genislik: 440,
        kapaninca: () => resolve(sonuc),
        tus: e => harfKisayolu(w.p, e)
      });
      const govde = document.createElement('div');
      govde.className = 'p-govde';
      govde.style.cssText = 'padding:14px 12px;white-space:pre-wrap';
      govde.textContent = o.metin;
      const alt = document.createElement('div');
      alt.className = 'p-alt';
      const bos = document.createElement('span');
      bos.className = 'bosluk';
      alt.appendChild(bos);
      const ss = o.secenekler || [];
      ss.forEach((s, i) => {
        const d = dugme(s.metin, s.harf, i === ss.length - 1 ? 'ana' : '');
        d.addEventListener('click', () => { sonuc = s.deger; w.kapat(); });
        alt.appendChild(d);
      });
      w.p.append(basBolum(o.baslik), govde, alt);
      const son = alt.querySelector('.dg.ana');
      if (son) son.focus();
    });
  }
  /* =====================================================================
   * 4) ENTER YENİ SATIR
   * ===================================================================== */

  define({
    id: 'enterNewline',
    label: 'Enter yeni satır',
    desc: 'Enter mesajı göndermez, alt satıra geçer. Göndermek için gönder düğmesi ya da Ctrl+Enter.',
    group: 'Yazma',
    phase: 'start',
    on(ctx) {
      ctx.on(window, 'keydown', (e) => {
        if (e.key !== 'Enter' || e.shiftKey || e.ctrlKey || e.metaKey || e.isComposing) return;
        const el = e.target;
        const isInput = el.closest && (el.closest('[contenteditable]') || el.closest('.ProseMirror')) ||
                        el.tagName === 'TEXTAREA';
        if (!isInput) return;
        e.stopImmediatePropagation();
        e.preventDefault();
        el.dispatchEvent(new KeyboardEvent('keydown', {
          key: 'Enter', code: 'Enter', keyCode: 13, which: 13,
          shiftKey: true, bubbles: true, cancelable: true
        }));
      }, true);
    }
  });

  /* =====================================================================
   * 5) KULLANIM GÖSTERGESİ
   * ===================================================================== */

  const HUD = (function () {
    const CFG = { pollMs: 60000, staleAfterMs: 10 * 60000 };

    /* Doluluk kademeleri. Sınırlar "%X'e kadar" mantığıyla alt sınır olarak
       yazıldı: 0-49 yeşil, 50-74 turkuaz, 75-84 mavi, 85-94 turuncu,
       95-100 kırmızı. Son üç kademe kalın.
       Her ton için açık/koyu tema karşılığı ayrı: tek bir hex iki zeminde
       birden okunaklı olmuyor. */
    const TIERS = [
      { min: 95, bold: true,  light: '#c4453c', dark: '#ff7b72' },   // kırmızı
      { min: 85, bold: true,  light: '#bc4c00', dark: '#f0883e' },   // turuncu
      { min: 75, bold: true,  light: '#1f6feb', dark: '#58a6ff' },   // mavi
      { min: 50, bold: false, light: '#0f766e', dark: '#2dd4bf' },   // turkuaz
      { min: 0,  bold: false, light: '#1a7f37', dark: '#3fb950' }    // yeşil
    ];
    const tierOf = pct => TIERS.find(t => pct >= t.min) || TIERS[TIERS.length - 1];

    /* Kısaltmalar tek harf: şerit sol menüye sığsın ve tüm göstergeler aynı
       genişlikte dursun. C=Current session, A=All models, F=Fable,
       U=Usage credits. */
    const SLOTS = [
      { key: 'session', short: 'C', full: _n('Oturum (C)') },
      { key: 'weekly',  short: 'A', full: _n('Tüm modeller (A)') },
      { key: 'fable',   short: 'F', full: 'Fable (F)' },
      { key: 'credits', short: 'U', full: _n('Kullanım kredisi (U)') }
    ];

    const MATCH = {
      fable:   /(opus|fable|mythos)/i,
      session: /(five[_-]?hour|5[_-]?h(our)?|current[_-]?session|\bsession\b)/i,
      weekly:  /(seven[_-]?day|7[_-]?d(ay)?|\bweek(ly)?\b|all[_-]?models?)/i
    };
    /* Kredi/para alanları oran hesabından dışlanıyor: limit yüzdeleriyle
       karıştırılırlarsa yanlış yuvaya düşerler. Krediler ayrı yoldan,
       ingestCredits ile okunuyor. */
    const REJECT = /(credit|spend|balance|payment|invoice|billing|overage|top[_-]?up)/i;

    const LS = {
      get(k, d) { try { const v = localStorage.getItem('cuhud_' + k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } },
      set(k, v) { try { localStorage.setItem('cuhud_' + k, JSON.stringify(v)); } catch (e) {} }
    };

    let slotData = LS.get('slots', {}) || {};
    let credits = LS.get('credits', null);
    let collapsed = LS.get('collapsed', false);
    let labelMode = LS.get('labelMode', 'full');
    let dock = LS.get('dock', 'sidebar');   // 'sidebar' | 'float'
    let lastError = null, lastBuckets = [], lastRaw = null, lastCreditRaw = null;
    let host = null, hud = null, hooked = false;

    const num = v => (typeof v === 'number' && isFinite(v) ? v : null);

    function pctOf(o) {
      for (const k of ['utilization', 'percent_used', 'percentage_used', 'pct_used', 'usage_percent', 'percent', 'usage_pct']) {
        let v = num(o[k]);
        if (v !== null) { if (v > 0 && v <= 1) v *= 100; return Math.max(0, Math.min(100, v)); }
      }
      const limit = num(o.limit ?? o.total ?? o.max ?? o.allowance ?? o.cap ?? o.quota);
      const used = num(o.used ?? o.consumed ?? o.count ?? o.used_credits);
      if (limit && used !== null) return Math.max(0, Math.min(100, used / limit * 100));
      const rem = num(o.remaining ?? o.left);
      if (limit && rem !== null) return Math.max(0, Math.min(100, (limit - rem) / limit * 100));
      return null;
    }

    function resetOf(o) {
      for (const k of ['resets_at', 'reset_at', 'resets_at_utc', 'next_reset', 'reset', 'expires_at', 'window_end']) {
        const v = o[k];
        if (typeof v === 'string') { const t = Date.parse(v); if (!isNaN(t)) return t; }
        if (typeof v === 'number') return v > 1e12 ? v : v * 1000;
      }
      for (const k of ['resets_in_seconds', 'reset_in_seconds', 'seconds_until_reset']) {
        const v = num(o[k]); if (v !== null) return Date.now() + v * 1000;
      }
      for (const k of ['resets_in_minutes', 'minutes_until_reset']) {
        const v = num(o[k]); if (v !== null) return Date.now() + v * 60000;
      }
      return null;
    }

    // v2 mantığı: dizi elemanları dizinin anahtarını paylaşır, ayrı kimlik almaz.
    /* Dizi elemanlarına kimlik ver. Eskiden bir dizinin tüm elemanları
       dizinin anahtarını paylaşıyordu: "limits" kovası tek başına 19, 100, 100
       değerlerini taşıyor ve hiçbiri ayırt edilemiyordu — Fable verisi tam
       burada saklı kalmıştı. Elemanın kendi type/name alanı varsa o kullanılır,
       yoksa "limits#2" gibi konumlu bir etiket verilir. */
    function collect(root) {
      const out = [], seen = new Set();
      (function walk(node, key, depth, idx) {
        if (!node || typeof node !== 'object' || depth > 9 || seen.has(node)) return;
        seen.add(node);
        if (Array.isArray(node)) {
          node.forEach((n, i) => walk(n, key, depth + 1, i));
          return;
        }
        const pct = pctOf(node);
        if (pct !== null) {
          const own = node.type ?? node.name ?? node.key ?? node.id ??
                      node.model ?? node.window ?? node.period;
          let label = String(own ?? key ?? '').toLowerCase();
          if (own === undefined && idx !== undefined && key) label = key.toLowerCase() + '#' + idx;
          if (label) out.push({ label, pct, resetAt: resetOf(node), idx });
        }
        for (const [k, v] of Object.entries(node)) if (v && typeof v === 'object') walk(v, k, depth + 1, undefined);
      })(root, '', 0, undefined);
      return out;
    }

    function ingest(json, url) {
      let found;
      try { found = collect(json); } catch (e) { return false; }
      if (!found.length) return false;
      lastRaw = json;

      const buckets = new Map();
      for (const c of found) {
        if (REJECT.test(c.label)) continue;
        if (!buckets.has(c.label)) buckets.set(c.label, []);
        buckets.get(c.label).push(c);
      }
      if (!buckets.size) return false;

      const best = arr => arr.reduce((a, b) => (b.pct > a.pct ? b : a));
      const picked = {};
      const usedLabels = new Set();
      for (const [label, members] of buckets) {
        for (const slot of ['fable', 'session', 'weekly']) {
          if (picked[slot] || !MATCH[slot].test(label)) continue;
          picked[slot] = best(members); picked[slot].label = label;
          usedLabels.add(label); break;
        }
      }

      /* Eskiden burada bir tahmin vardı: Fable etiketi eşleşmezse kalan en
         yüksek yüzdeli kova alınıp "Fable" diye gösteriliyordu. O tahmin
         alakasız bir kovayı Fable sanabildiği için kaldırıldı.

         Yerine çok daha dar bir kural: bazı hesaplarda seven_day_opus null
         geliyor ve model limiti yalnızca "limits" dizisinin içinde bulunuyor.
         O diziden Fable'ı ancak şu koşullarda alıyoruz:
           · dizide en az üç öğe var,
           · öğelerden biri zaten atanmış C yüzdesiyle,
             bir diğeri zaten atanmış A yüzdesiyle birebir örtüşüyor,
           · geriye TAM olarak bir öğe kalıyor.
         Yani dizinin arayüzdeki üç çubukla hizalandığı doğrulanmadan hiçbir
         şey atanmıyor. Atanırsa da "inferred" işaretleniyor; scan() ve ipucu
         bunu açıkça yazıyor ki denetlenebilsin. */
      if (!picked.fable && picked.session && picked.weekly) {
        const sPct = picked.session.pct, wPct = picked.weekly.pct;
        const near = (a, b) => a != null && b != null && Math.abs(a - b) <= 0.05;

        if (!near(sPct, wPct)) {          // ikisi eşitse hangisi hangisi belli olmaz
          const groups = new Map();
          for (const [label, members] of buckets) {
            const m = label.match(/^(.+)#(\d+)$/);
            if (!m || usedLabels.has(label)) continue;
            if (!groups.has(m[1])) groups.set(m[1], []);
            groups.get(m[1]).push({ label, c: best(members) });
          }

          for (const items of groups.values()) {
            if (items.length < 3) continue;
            let sawS = false, sawW = false;
            const rest = [];
            for (const it of items) {
              if (!sawS && near(it.c.pct, sPct)) { sawS = true; continue; }
              if (!sawW && near(it.c.pct, wPct)) { sawW = true; continue; }
              rest.push(it);
            }
            if (sawS && sawW && rest.length === 1) {
              picked.fable = rest[0].c;
              picked.fable.label = rest[0].label;
              picked.fable.inferred = true;
              usedLabels.add(rest[0].label);
              break;
            }
          }
        }
      }

      /* Kullanım kredisi oranı /usage gövdesinde "extra_usage" adıyla
         geliyor — içinde ne "credit" ne "spend" geçtiği için hiçbir filtreye
         takılmıyor, kovaya giriyor ama hiçbir limit yuvasına ait değil.
         Doğrudan U yuvasına aktarılıyor. */
      const extraKey = [...buckets.keys()].find(l =>
        /^(extra_usage|overage_usage|credit_usage|extra_credits?)$/i.test(l));
      if (extraKey) {
        const e = best(buckets.get(extraKey));
        ingestCredits({ __directPct: e.pct }, 'extra_usage');
        usedLabels.add(extraKey);
      }

      lastBuckets = [...buckets.entries()].map(([l, members]) => {
        const hit = Object.entries(picked).find(([, c]) => c.label === l);
        return {
          label: l,
          values: members.map(m => Math.round(m.pct * 10) / 10).join(', '),
          slot: hit ? hit[0] : '(kullanılmadı)',
          inferred: hit ? !!hit[1].inferred : false
        };
      });

      const now = Date.now();
      let wrote = false;
      for (const [slot, c] of Object.entries(picked)) {
        slotData[slot] = { pct: c.pct, resetAt: c.resetAt, label: c.label, inferred: !!c.inferred, at: now };
        wrote = true;
      }
      if (!wrote) return false;

      LS.set('slots', slotData);
      LS.set('endpoint', url);
      lastError = null;
      render();
      return true;
    }

    /* ---------------- Kullanım kredileri ----------------
       Ham gövdeler görüldükten sonra genel tarama bırakıldı: alan adlarına
       göre kör arama YANLIŞ değer üretiyordu. Örnek prepaid/credits gövdesi:

         { amount: 1655, currency: "USD", balance_credits: 16,
           tranches: [...], next_expires_at: "2027-08-12" }

       Genel tarayıcı buradan bal=16 (aslında kredi ADEDİ, dolar değil) ve
       limit=2000 (tranches içinden alakasız bir sayı) çıkarıyordu. Doğrusu:
       bakiye = amount / 100 = $16.55.

       overage_credit_grant ise bu hesapta tamamen boş dönüyor
       (available:false, granted:false, amount_minor_units:null) — yani
       harcama/limit oradan gelmiyor.

       Harcanan + aylık limit ("$13.45 / $40.00, %34") henüz hangi uçtan
       geldiği doğrulanmadı; en olası aday /usage gövdesi, o yüzden orada da
       aranıyor. Doğrulanana kadar U yuvası yalnızca GERÇEK bir yüzde
       hesaplanabildiğinde görünüyor — uydurma sayı göstermiyor. */
    const CREDIT_URL_RE = /(credit|billing|balance|wallet|payment|prepaid|overage)/i;

    const minor = v => (num(v) === null ? null : num(v) / 100);

    // prepaid/credits: satın alınmış kredi bakiyesi, minor units (sent).
    function fromPrepaid(j) {
      const out = {};
      const bal = minor(j.amount);
      if (bal !== null) out.bal = bal;
      return out;
    }

    // overage_credit_grant: hediye/promosyon kredisi. Verilmemişse boş.
    function fromGrant(j) {
      if (j.granted === false || j.available === false) return {};
      const out = {};
      const g = minor(j.amount_minor_units);
      if (g !== null) out.grant = g;
      if (typeof j.expires_at === 'string') {
        const t = Date.parse(j.expires_at);
        if (!isNaN(t)) out.resetAt = t;
      }
      return out;
    }

    /* Harcanan / aylık limit araması. Kör tarama değil: yalnızca adında
       "spend" geçen sayısal alanlara bakılıyor, çünkü arayüzdeki ifade
       "monthly spend limit" ve "$13.45 spent". cents / minor_units ekleri
       sent kabul edilip dolara çevriliyor. */
    const IS_MINOR = /(cents|minor_units)/i;

    function fromSpend(root) {
      const out = {};
      const seen = new Set();
      (function walk(node, depth) {
        if (!node || typeof node !== 'object' || depth > 6 || seen.has(node)) return;
        seen.add(node);
        if (Array.isArray(node)) return;          // tranches gibi listelere girme
        for (const [k, v] of Object.entries(node)) {
          const n = num(v);
          if (n === null || !/spend|spent/i.test(k)) continue;
          const val = IS_MINOR.test(k) ? n / 100 : n;
          if (/limit|cap|max|budget/i.test(k)) { if (out.limit === undefined) out.limit = val; }
          else if (out.spent === undefined) out.spent = val;
        }
        for (const v of Object.values(node)) if (v && typeof v === 'object') walk(v, depth + 1);
      })(root, 0);
      return out;
    }

    function extractCredits(json, url) {
      if (json && typeof json.__directPct === 'number') return { directPct: json.__directPct };
      if (/prepaid\/credits/.test(url)) return Object.assign(fromPrepaid(json), fromSpend(json));
      if (/overage_credit_grant/.test(url)) return Object.assign(fromGrant(json), fromSpend(json));
      return fromSpend(json);
    }

    function ingestCredits(json, url) {
      let c;
      try { c = extractCredits(json, url || ''); } catch (e) { return false; }
      if (!c || !Object.keys(c).length) return false;

      const merged = Object.assign({}, credits || {});
      for (const k of ['spent', 'limit', 'bal', 'grant', 'resetAt', 'directPct']) {
        if (c[k] !== undefined && c[k] !== null) merged[k] = c[k];
      }

      /* Yüzde iki yoldan gelebiliyor: tutarlardan hesaplanmış ya da API'nin
         doğrudan verdiği oran (/usage içindeki extra_usage). Hesap mümkünse o
         tercih edilir, değilse doğrudan oran. İkisi de yoksa null — eskiden
         burada NaN oluşuyordu. */
      const sp = num(merged.spent), lim = num(merged.limit);
      merged.pct = (sp !== null && lim !== null && lim > 0)
        ? Math.max(0, Math.min(100, sp / lim * 100))
        : (num(merged.directPct));
      merged.at = Date.now();

      const changed = JSON.stringify(merged) !== JSON.stringify(credits);
      credits = merged;
      lastCreditRaw = json;
      LS.set('credits', credits);
      if (changed) render();
      return true;
    }

    function money(v) {
      if (v === null || v === undefined || !isFinite(v)) return '–';
      return '$' + Number(v).toFixed(2);
    }

    const USAGE_RE = /(usage|rate[_-]?limit|limits|quota|entitl)/i;

    // Ağ yakalayıcı sayfa yüklenirken kurulmalı; bir kez kurulur, geri alınmaz.
    function hook() {
      if (hooked) return;
      hooked = true;
      NET.sub((url, json) => {
        // /usage hem limitleri hem (muhtemelen) harcama bilgisini taşıyor.
        if (USAGE_RE.test(url)) { ingest(json, url); ingestCredits(json, url); }
        if (CREDIT_URL_RE.test(url)) ingestCredits(json, url);
      });
    }

    async function candidates() {
      const saved = LS.get('endpoint', null);
      if (saved) return [saved];
      const orgs = await orgUuid();
      const list = [];
      for (const o of orgs) for (const p of ['usage', 'usage_limits', 'rate_limits', 'limits']) {
        list.push(`${location.origin}/api/organizations/${o}/${p}`);
      }
      list.push(`${location.origin}/api/usage`);
      return list;
    }

    /* Ağ günlüğünden doğrulanan uçlar. Eski tahmin listesi (usage_credits,
       credits, credit_balance, billing/...) hepsi 404 veriyordu ve konsolu
       gereksiz yere dolduruyordu; kaldırıldı. */
    const CREDIT_PATHS = ['overage_credit_grant', 'prepaid/credits'];

    async function creditCandidates() {
      // Birden fazla organizasyon varsa diğerleri 403 döndürüp konsolu
      // kirletiyor; işe yarayan org bir kez öğrenilip saklanıyor.
      const pinned = LS.get('creditOrg', null);
      const orgs = pinned ? [pinned] : await orgUuid();
      const list = [];
      for (const o of orgs) for (const p of CREDIT_PATHS) {
        list.push(`${location.origin}/api/organizations/${o}/${p}`);
      }
      return list;
    }

    async function pollCredits() {
      if (!origFetch) return;
      // Tek uçta durma: harcama bir uçta, bakiye diğerinde.
      for (const u of await creditCandidates()) {
        try {
          const r = await origFetch(u, { credentials: 'include', headers: { accept: 'application/json' } });
          if (!r.ok) continue;
          const m = u.match(/organizations\/([^/]+)\//);
          if (m) LS.set('creditOrg', m[1]);
          ingestCredits(await r.json(), u);
        } catch (e) {}
      }
    }

    let polling = false;
    async function poll() {
      if (polling || !origFetch) return;
      polling = true;
      pollCredits();
      try {
        for (const u of await candidates()) {
          try {
            const r = await origFetch(u, { credentials: 'include', headers: { accept: 'application/json' } });
            if (!r.ok) continue;
            const j = await r.json();
            ingestCredits(j, u);   // /usage harcama bilgisini de taşıyor olabilir
            if (ingest(j, u)) return;
          } catch (e) {}
        }
        if (!Object.keys(slotData).length) { lastError = _n('Ayarlar › Usage sayfasını bir kez aç'); render(); }
      } finally { polling = false; }
    }

    function tokens() {
      const cs = getComputedStyle(document.documentElement);
      const bs = getComputedStyle(document.body);
      const pick = (names, fb) => {
        for (const n of names) {
          const v = (cs.getPropertyValue(n) || bs.getPropertyValue(n) || '').trim();
          if (v) return v;
        }
        return fb;
      };
      const d = isDark();
      return {
        f: bs.fontFamily || 'ui-sans-serif, system-ui, sans-serif',
        tx: pick(['--text-primary', '--text-000'], d ? '#f5f4ef' : '#1f1e1d'),
        sec: pick(['--text-secondary', '--text-300'], d ? '#a9a59d' : '#6b6862'),
        muted: pick(['--text-muted', '--text-400'], d ? '#7d7972' : '#918f8a'),
        bd: pick(['--border-strong', '--border'], d ? 'rgba(255,255,255,.20)' : 'rgba(0,0,0,.16)'),
        hair: pick(['--border'], d ? 'rgba(255,255,255,.12)' : 'rgba(0,0,0,.10)'),
        ok: pick(['--fill-accent', '--text-accent'], d ? '#5a9ee6' : '#2c84db'),
        warn: pick(['--fill-warning', '--text-warning'], d ? '#d8a03c' : '#b07818'),
        bad: pick(['--fill-danger', '--text-danger'], d ? '#e06a6a' : '#c4453c'),
        surf: pick(['--surface-popover', '--surface-3', '--surface-2'], d ? '#2c2b29' : '#ffffff'),
        rad: pick(['--radius'], '8px')
      };
    }

    const CSS = `
    .hud{position:fixed;z-index:2147483000;display:flex;align-items:flex-end;gap:12px;
         padding:5px 7px;font-family:var(--f);font-size:11px;line-height:1;font-weight:400;
         -webkit-font-smoothing:antialiased;color:var(--sec);letter-spacing:.005em;
         user-select:none;cursor:grab;opacity:.72;transition:opacity .15s ease}
    .hud:hover,.hud.dragging{opacity:1}
    .hud.dragging{cursor:grabbing}
    .hud.docked{position:static;width:100%;box-sizing:border-box;
      justify-content:space-between;gap:8px;padding:6px 12px 7px;cursor:default;opacity:.85}
    .hud.docked:hover{opacity:1}
    .hud.docked .ctl{opacity:0}
    .hud.docked:hover .ctl{opacity:1}
    .cell{display:block}
    .cell.faded{opacity:.5}
    .line{display:block;white-space:nowrap;padding-bottom:4px}
    .pct{font-variant-numeric:tabular-nums;color:var(--tx)}
    .pct.bold{font-weight:650}
    .rail{display:block;height:2px;border-radius:1px;background:var(--bd);position:relative;overflow:hidden}
    .tight .rail{min-width:30px}
    .fill{position:absolute;left:0;top:0;bottom:0;border-radius:1px;transition:width .45s ease}
    .ctl{display:flex;align-items:center;gap:1px;padding-bottom:1px;opacity:0;transition:opacity .15s ease}
    .hud:hover .ctl{opacity:1}
    .btn{display:grid;place-items:center;width:17px;height:17px;border-radius:4px;color:var(--muted);cursor:pointer}
    .btn:hover{color:var(--tx)}
    .btn.spin svg{animation:sp .7s linear infinite}
    @keyframes sp{to{transform:rotate(360deg)}}
    .card{min-width:230px;max-width:300px;padding:10px 12px;font-family:var(--yazi);
          background:var(--yuzey);color:var(--metin);border:1px solid var(--kenar);border-radius:var(--kose-l);
          cursor:default;display:none;font-size:12px}
    .card .rlab{color:var(--metin)} .card .rsub,.card .foot{color:var(--metin-ikincil)}
    .card .row + .row,.card .foot{border-color:var(--ayirici)}
    .card.open{display:block}
    .row{display:flex;justify-content:space-between;gap:16px;padding:6px 0}
    .row + .row{border-top:0.5px solid var(--hair)}
    .rlab{color:var(--tx)}
    .rsub{display:block;margin-top:4px;color:var(--muted);font-size:11px}
    .foot{margin-top:8px;padding-top:8px;border-top:0.5px solid var(--hair);color:var(--muted);font-size:11px}
    .msg{white-space:nowrap;color:var(--muted)}
    @media (prefers-reduced-motion: reduce){.fill{transition:none}.btn.spin svg{animation:none}}
    `;

    const ICON = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v6h-6"/></svg>';

    const colorFor = pct => { const k = tierOf(pct); return isDark() ? k.dark : k.light; };

    function fmtReset(ts) {
      if (!ts) return '';
      const d = ts - Date.now();
      if (d <= 0) return _('Şimdi sıfırlanıyor');
      const min = Math.round(d / 60000);
      if (min < 60) return _f('{0} dk sonra sıfırlanır', min);
      if (d < 24 * 3600000) return _f('{0} sa {1} dk sonra sıfırlanır', Math.floor(min / 60), min % 60);
      return _f('{0} sıfırlanır', new Date(ts).toLocaleString(DIL.aktif() === 'en' ? 'en-GB' : 'tr-TR', { weekday: 'short', hour: '2-digit', minute: '2-digit' }));
    }

    function creditLine() {
      if (!credits) return _('veri yok');
      const parts = [];
      if (isFinite(credits.spent)) {
        parts.push(_f('{0} harcandı', money(credits.spent) + (isFinite(credits.limit) ? ' / ' + money(credits.limit) : '')));
      } else if (isFinite(credits.pct)) {
        parts.push(_f('aylık limitin %{0}\'i', Math.round(credits.pct)));
      }
      if (isFinite(credits.bal)) parts.push(_f('{0} bakiye', money(credits.bal)));
      return parts.length ? parts.join(' · ') : _('veri yok');
    }

    let cardHost = null, cardNode = null, cardOpen = false;

    function cardEl() {
      if (cardNode && cardNode.isConnected) return cardNode;
      cardHost = document.createElement('div');
      cardHost.id = 'claude-usage-hud-card';
      cardHost.style.cssText = 'position:fixed;left:0;top:0;z-index:2147483001;';
      const root = cardHost.attachShadow({ mode: 'open' });
      const style = document.createElement('style');
      style.textContent = CSS;
      cardNode = document.createElement('div');
      cardNode.className = 'card';
      cardNode.addEventListener('pointerdown', e => e.stopPropagation());
      root.append(style, cardNode);
      (document.body || document.documentElement).append(cardHost);
      UI_HOSTS.add(cardHost);
      return cardNode;
    }

    function positionCard() {
      if (!cardHost || !hud) return;
      TEMA.uygula(cardHost);
      const r = hud.getBoundingClientRect();
      const w = cardNode.offsetWidth || 210;
      const left = Math.min(Math.max(8, r.left), innerWidth - w - 8);
      const top = Math.min(r.bottom + 8, innerHeight - 40);
      cardHost.style.left = Math.round(left) + 'px';
      cardHost.style.top = Math.round(top) + 'px';
    }

    function closeCard() {
      cardOpen = false;
      if (cardNode) cardNode.classList.remove('open');
    }

    function fmtAgo(ts) {
      if (!ts) return _('Henüz veri yok');
      const m = Math.round((Date.now() - ts) / 60000);
      if (m < 1) return _('Son güncelleme: 1 dakikadan az önce');
      if (m < 60) return _f('Son güncelleme: {0} dk önce', m);
      return _f('Son güncelleme: {0}', saatYaz(ts));
    }

    function applyTokens() {
      if (!hud) return null;
      const t = tokens();
      for (const [k, v] of Object.entries(t)) hud.style.setProperty('--' + k, v);
      return t;
    }

    function view() {
      const now = Date.now();
      return SLOTS.map(s => {
        if (s.key === 'credits') {
          const c = credits;
          return {
            ...s,
            pct: c ? c.pct : null,
            resetAt: null,
            label: 'usage credits',
            inferred: false,
            at: c ? c.at : 0,
            faded: c ? now - c.at > CFG.staleAfterMs : true,
            // Gerçek bir yüzde hesaplanamıyorsa yuva hiç görünmüyor:
            // eksik göstermek, uydurma göstermekten iyi.
            hidden: !c || typeof c.pct !== 'number' || !isFinite(c.pct)
          };
        }
        const d = slotData[s.key];
        return {
          ...s,
          pct: d ? d.pct : null,
          resetAt: d ? d.resetAt : null,
          label: d ? d.label : null,
          inferred: d ? d.inferred : false,
          at: d ? d.at : 0,
          faded: d ? now - d.at > CFG.staleAfterMs : true,
          hidden: false
        };
      }).filter(r => !r.hidden);
    }

    function cell(m, t) {
      const has = typeof m.pct === 'number';
      const c = document.createElement('div');
      c.className = 'cell' + (m.faded ? ' faded' : '');
      const line = document.createElement('span');
      line.className = 'line';
      const p = document.createElement('span');
      p.className = 'pct';
      if (has) {
        const k = tierOf(m.pct);
        p.style.color = isDark() ? k.dark : k.light;
        if (k.bold) p.classList.add('bold');
      }
      p.textContent = has ? Math.round(m.pct) + '%' : '–';
      if (labelMode === 'tight') line.append(p);
      else line.append(document.createTextNode(m.short + ' '), p);
      const rail = document.createElement('span');
      rail.className = 'rail';
      if (has) {
        const fill = document.createElement('span');
        fill.className = 'fill';
        fill.style.width = Math.max(1, m.pct) + '%';
        fill.style.background = colorFor(m.pct);
        rail.append(fill);
      }
      c.append(line, rail);
      c.title = _(m.full) + (m.inferred ? ' (' + _('çıkarım') + ')' : '') + ' — ' + (has
        ? (m.key === 'credits' ? creditLine() : fmtReset(m.resetAt))
        : _('veri yok'));
      return c;
    }

    function render() {
      if (!hud) return;
      const t = applyTokens();
      const rows = view();
      const has = rows.some(r => r.pct !== null);
      hud.innerHTML = '';
      hud.classList.toggle('tight', labelMode === 'tight');

      if (!has) {
        const m = document.createElement('span');
        m.className = 'msg';
        m.textContent = _(lastError || 'Kullanım verisi bekleniyor');
        hud.append(m);
      } else if (collapsed) {
        const shown = rows.filter(r => r.pct !== null);
        hud.append(cell(shown.reduce((a, b) => (b.pct > a.pct ? b : a)), t));
      } else {
        rows.forEach(r => hud.append(cell(r, t)));
      }

      const ctl = document.createElement('div');
      ctl.className = 'ctl';
      const refresh = document.createElement('span');
      refresh.className = 'btn';
      refresh.innerHTML = ICON;
      refresh.title = _('Yenile');
      refresh.setAttribute('aria-label', _('Kullanım verisini yenile'));
      refresh.addEventListener('click', async e => {
        e.stopPropagation();
        refresh.classList.add('spin');
        await poll();
        refresh.classList.remove('spin');
      });
      const dockBtn = document.createElement('span');
      dockBtn.className = 'btn';
      dockBtn.textContent = dock === 'sidebar' ? '⤢' : '⤡';
      dockBtn.title = dock === 'sidebar' ? _('Serbest bırak (sürüklenebilir)') : _('Sol menüye yerleştir');
      dockBtn.addEventListener('click', e => {
        e.stopPropagation();
        setDock(dock === 'sidebar' ? 'float' : 'sidebar');
      });

      const more = document.createElement('span');
      more.className = 'btn';
      more.textContent = '⌄';
      more.title = _('Ayrıntılar');
      more.setAttribute('aria-label', _('Ayrıntıları göster'));
      ctl.append(refresh, dockBtn, more);
      hud.append(ctl);

      /* Kart artık şeridin içinde değil, gövde seviyesinde ayrı bir kabukta.
         Sol menüye gömülüyken .hud position:static oluyor, absolute kart
         neye göre konumlanacağını şaşırıyordu; üstelik menünün taşma kırpması
         onu kesiyordu. Gövdeye alıp fixed konumlandırınca iki kipte de
         çalışıyor. */
      const card = cardEl();
      card.className = 'card';
      card.innerHTML = '';
      rows.forEach(r => {
        const row = document.createElement('div');
        row.className = 'row';
        const l = document.createElement('span');
        const lab = document.createElement('span'); lab.className = 'rlab';
        lab.textContent = _(r.full) + (r.inferred ? ' *' : '');
        const sub = document.createElement('span'); sub.className = 'rsub';
        sub.textContent = r.pct === null ? _('Veri yok')
          : (r.key === 'credits' ? creditLine() : fmtReset(r.resetAt)) + (r.faded ? ' · ' + _('eski veri') : '');
        l.append(lab, sub);
        const v = document.createElement('span');
        v.className = 'pct';
        if (r.pct !== null) {
          const k = tierOf(r.pct);
          v.style.color = isDark() ? k.dark : k.light;
          if (k.bold) v.classList.add('bold');
        }
        v.textContent = r.pct === null ? '–' : _f('%{0} kullanıldı', Math.round(r.pct));
        row.append(l, v);
        card.append(row);
      });
      const foot = document.createElement('div');
      foot.className = 'foot';
      foot.textContent = fmtAgo(Math.max(0, ...rows.map(r => r.at)));
      card.append(foot);

      if (cardOpen) { card.classList.add('open'); positionCard(); }
      more.textContent = cardOpen ? '⌃' : '⌄';
      more.addEventListener('click', e => {
        e.stopPropagation();
        cardOpen = !cardOpen;
        card.classList.toggle('open', cardOpen);
        more.textContent = cardOpen ? '⌃' : '⌄';
        if (cardOpen) positionCard();
      });
    }

    /* ---------------- Yerleşim ----------------
       İki kip var: 'float' (eski davranış, sürüklenebilir) ve 'sidebar'
       (sol menüye satır içi girer, hiçbir şeyin üstüne binmez). Varsayılan
       sidebar. Menü bulunamazsa (daraltılmış menü, farklı düzen) geçici
       olarak float'a düşüyor ki gösterge kaybolmasın. */
    /* Sol menüyü bulmak: "New" bir bağlantı değil buton olabiliyor, o yüzden
       tek bir seçiciye güvenilmiyor. Sırayla birkaç gezinme bağlantısı
       deneniyor, hiçbiri yoksa nav öğesinin kendisine düşülüyor. */
    const NAV_SELECTORS = [
      'a[href="/new"]', 'a[href^="/new"]', 'a[href="/recents"]', 'a[href="/chats"]',
      'a[href="/projects"]', 'a[href="/artifacts"]', 'a[href="/tasks"]'
    ];

    const looksLikeSidebar = r => r.width >= 130 && r.width <= 480 && r.height >= 200;

    function sidebarSlot() {
      for (const sel of NAV_SELECTORS) {
        const link = document.querySelector(sel);
        if (!link || !link.getClientRects().length) continue;
        let el = link;
        for (let i = 0; i < 8; i++) {
          const p = el.parentElement;
          if (!p || p === document.body) break;
          if (looksLikeSidebar(p.getBoundingClientRect())) return { parent: p, before: el };
          el = p;
        }
      }
      // Yedek: gezinme bölgesinin ilk görünür çocuğundan önce.
      for (const nav of document.querySelectorAll('nav, [role="navigation"]')) {
        if (!looksLikeSidebar(nav.getBoundingClientRect())) continue;
        const first = [...nav.children].find(c => c.getClientRects().length && c.id !== 'claude-usage-hud');
        if (first) return { parent: nav, before: first };
      }
      return null;
    }

    function applyFloatPos() {
      const pos = LS.get('pos', null);
      if (pos && typeof pos.left === 'number') {
        hud.style.left = pos.left + 'px';
        hud.style.top = pos.top + 'px';
        hud.style.transform = 'none';
      } else {
        hud.style.left = 'calc(50% + 22vw)';
        hud.style.top = '10px';
        hud.style.transform = 'translateX(-50%)';
      }
    }

    function place() {
      if (!host || !hud) return;
      if (dock === 'sidebar') {
        const slot = sidebarSlot();
        if (slot) {
          if (host.parentElement !== slot.parent || host.nextElementSibling !== slot.before) {
            slot.parent.insertBefore(host, slot.before);
          }
          hud.classList.add('docked');
          hud.style.removeProperty('left');
          hud.style.removeProperty('top');
          hud.style.removeProperty('transform');
          return;
        }
      }
      hud.classList.remove('docked');
      if (host.parentElement !== document.body) (document.body || document.documentElement).append(host);
      applyFloatPos();
    }

    function setDock(mode) {
      dock = mode === 'float' ? 'float' : 'sidebar';
      LS.set('dock', dock);
      place();
      render();
    }

    function build(ctx) {
      host = document.createElement('div');
      host.id = 'claude-usage-hud';
      const root = host.attachShadow({ mode: 'open' });
      const style = document.createElement('style');
      style.textContent = CSS;
      hud = document.createElement('div');
      hud.className = 'hud';
      root.append(style, hud);

      place();
      ctx.node(host);

      hud.addEventListener('dblclick', () => {
        collapsed = !collapsed;
        LS.set('collapsed', collapsed);
        render();
      });
      dragify();
      render();

      ctx.watch(document.documentElement, { attributes: true, attributeFilter: ['class', 'style', 'data-mode', 'data-theme'] }, applyTokens);
      const mq = media('(prefers-color-scheme: dark)');
      if (mq && mq.addEventListener) ctx.on(mq, 'change', applyTokens);
    }

    function dragify() {
      let sx, sy, ox, oy, moved = false;
      hud.addEventListener('pointerdown', e => {
        if (dock === 'sidebar') return;          // menüye gömülüyken taşınmaz
        if (e.target.closest('.btn') || e.target.closest('.card')) return;
        const r = hud.getBoundingClientRect();
        hud.style.transform = 'none';
        hud.style.left = r.left + 'px';
        hud.style.top = r.top + 'px';
        sx = e.clientX; sy = e.clientY; ox = r.left; oy = r.top; moved = false;
        hud.classList.add('dragging');
        hud.setPointerCapture(e.pointerId);
      });
      hud.addEventListener('pointermove', e => {
        if (sx === undefined) return;
        const dx = e.clientX - sx, dy = e.clientY - sy;
        if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
        hud.style.left = Math.min(Math.max(0, ox + dx), innerWidth - hud.offsetWidth) + 'px';
        hud.style.top = Math.min(Math.max(0, oy + dy), innerHeight - hud.offsetHeight) + 'px';
      });
      const end = () => {
        if (sx === undefined) return;
        sx = undefined;
        hud.classList.remove('dragging');
        if (moved) LS.set('pos', { left: parseFloat(hud.style.left), top: parseFloat(hud.style.top) });
      };
      hud.addEventListener('pointerup', end);
      hud.addEventListener('pointercancel', end);
    }

    return {
      hook,
      on(ctx) {
        build(ctx);
        poll();
        ctx.every(poll, CFG.pollMs);
        ctx.every(render, 30000);
        ctx.on(document, 'visibilitychange', () => { if (!document.hidden) poll(); });
        ctx.undo(() => { if (cardHost) cardHost.remove(); });
        ctx.on(document, 'click', e => {
          if (!cardOpen) return;
          if (e.composedPath().some(n => n === cardHost || n === host)) return;
          closeCard();
        }, true);
        ctx.on(window, 'resize', () => { if (cardOpen) positionCard(); });
        ctx.on(window, 'scroll', () => { if (cardOpen) positionCard(); }, true);

        // Sol menü SPA tarafından yeniden çizilebiliyor; yerini koru.
        ctx.every(place, 1000);
        ctx.watch(document.documentElement, { childList: true }, place);
        window.usageHUD = {
          scan() {
            if (!lastBuckets.length) return console.log('Henüz veri yok. Ayarlar › Usage sayfasını aç.');
            console.log('%c[usage] Hangi kova hangi harfi besliyor', 'font-weight:bold');
            const map = { session: 'C · Current session', weekly: 'A · All models', fable: 'F · Fable' };
            console.table(lastBuckets.map(b => ({
              kova: b.label,
              degerler: b.values,
              yuva: (map[b.slot] || b.slot) + (b.inferred ? '  (çıkarım)' : '')
            })));
            const used = lastBuckets.filter(b => map[b.slot]).map(b => b.slot);
            for (const k of ['session', 'weekly', 'fable']) {
              if (!used.includes(k)) {
                console.log('%c' + map[k] + ' → eşleşen kova yok, "–" gösteriliyor.', 'color:#c0392b');
              }
            }
            const dup = used.length !== new Set(used).size;
            if (dup) console.log('%cUYARI: aynı yuvaya birden fazla kova düştü.', 'color:#c0392b');
            return lastBuckets;
          },

          raw() { console.log(lastRaw); return lastRaw; },
          // Konsol nesneleri katlıyor; bu tam metni basar.
          dump() {
            const txt = JSON.stringify(lastRaw, null, 2);
            console.log(txt || '(veri yok)');
            return txt;
          },
          labels(mode) {
            if (mode !== 'full' && mode !== 'tight') return console.log('usageHUD.labels("full") | usageHUD.labels("tight")');
            labelMode = mode; LS.set('labelMode', mode); render();
          },
          dock(mode) {
            if (mode === undefined) {
              const slot = sidebarSlot();
              console.log('kip:', dock, '| sol menü bulundu mu:', !!slot);
              if (slot) console.log('  yerleşim noktası:', slot.parent, '→', slot.before);
              else console.log('%c  Menü tanınamadı, gösterge serbest kipte kalıyor.', 'color:#c0392b');
              console.log('usageHUD.dock("sidebar") | usageHUD.dock("float")');
              return dock;
            }
            if (mode !== 'sidebar' && mode !== 'float') return console.log('usageHUD.dock("sidebar") | usageHUD.dock("float")');
            setDock(mode);
            if (mode === 'sidebar' && !sidebarSlot()) {
              console.log('%cSol menü bulunamadı; serbest kipe düşüldü.', 'color:#c0392b');
            }
          },
          credits() { console.log(credits || 'kredi verisi yok'); return credits; },
          async probeCredits() {
            let hit = false;
            for (const u of await creditCandidates()) {
              try {
                const r = await origFetch(u, { credentials: 'include', headers: { accept: 'application/json' } });
                if (!r.ok) { console.log('%c' + u, 'color:#888', r.status); continue; }
                const j = await r.json();
                const c0 = extractCredits(j, u); const c = c0 && Object.keys(c0).length ? c0 : null;
                console.log('%c' + u, 'font-weight:bold;color:#2d7dff', c ? '✓' : '(para alanı bulunamadı)');
                console.log('   çıkarılan:', c || '—');
                console.log('   ham gövde:', j);
                if (c) hit = true;
              } catch (e) { console.log('%c' + u, 'color:#888', e.message); }
            }
            console.log('%cBirleştirilmiş sonuç:', 'font-weight:bold', credits || 'yok');
            if (!hit) console.log('%cUçlar okundu ama alan tanınmadı. Yukarıdaki "ham gövde" çıktısını paylaş.', 'color:#c0392b');
            return credits;
          },

          /* Kredi ucunun adresini bilmiyoruz ve tahminler 404 döndü. Bu kip
             geçici olarak BÜTÜN JSON yanıtlarını dinleyip içinde para alanı
             olanı yakalıyor. Ayarlar › Usage sayfasını açman yeterli. */
          findCredits(seconds) {
            const secs = Math.min(Math.max(seconds || 120, 15), 600);
            const seen = new Set();
            let found = false;

            const stop = NET.sub((url, json) => {
              if (seen.has(url)) return;
              seen.add(url);
              let c = null;
              try { c = extractCredits(json, url); } catch (e) {}
              if (!c || !Object.keys(c).length) return;
              found = true;
              console.log('%c✓ BULUNDU: ' + url, 'color:#1a7f37;font-weight:bold');
              console.log('   çıkarılan:', c);
              LS.set('creditEndpoint', url);
              ingestCredits(json, url);
              console.log('%cUç kaydedildi, gösterge güncellendi.', 'color:#1a7f37');
            });
            NET.setWide(true);

            console.log('%c[kredi] Dinleme açık (' + secs + " sn).\n" +
              'Şimdi Ayarlar › Usage sayfasını aç. İçinde para alanı olan yanıt yakalanacak.',
              'color:#2d7dff;font-weight:bold');

            setTimeout(() => {
              NET.setWide(false);
              stop();
              if (!found) {
                console.log('%c[kredi] Süre doldu, para alanı içeren yanıt görülmedi. ' +
                  Number(seen.size) + ' yanıt tarandı.', 'color:#c0392b');
                console.log('Taranan adresler:', [...seen]);
              }
            }, secs * 1000);
            return 'dinleniyor…';
          },
          reset() {
            ['slots', 'sources', 'pos', 'collapsed', 'labelMode', 'endpoint', 'cache', 'cacheAt',
             'credits', 'creditEndpoint', 'dock']
              .forEach(k => localStorage.removeItem('cuhud_' + k));
            location.reload();
          }
        };
      },
      durum() {
        const v = view();
        const yer = hud && hud.classList.contains('docked') ? _('sol menüde') : (hud ? _('serbest') : _('kurulmadı'));
        const veri = v.length ? v.map(r => r.short + ' ' + (r.pct === null ? '–' : Math.round(r.pct) + '%')).join(' · ') : _('veri yok');
        const tazelik = Math.max(0, ...v.map(r => r.at || 0));
        return { tamam: v.some(r => r.pct !== null), metin: veri + ' · ' + yer + (tazelik ? ' · ' + fmtAgo(tazelik).toLowerCase() : '') };
      },
      yenile() { return poll(); },
      off() {
        if (cardHost) { UI_HOSTS.delete(cardHost); cardHost.remove(); }
        cardHost = null; cardNode = null; cardOpen = false;
        host = null; hud = null;
        delete window.usageHUD;
      }
    };
  })();

  define({
    id: 'usageHud',
    label: 'Kullanım göstergesi',
    desc: 'Limitleri sol menüde gösterir: C oturum, A tüm modeller, F Fable, U kullanım kredisi. Renk dolulukla değişir. Çift tıkla küçülür.',
    group: 'Bilgi',
    on(ctx) {
      HUD.hook();
      HUD.on(ctx);
      ctx.action({ id: 'hud-yenile', ad: 'Kullanım verisini yenile', grup: 'Bilgi',
        calistir: () => HUD.yenile().then(() => bildir(_('Kullanım verisi yenilendi'), 'basari')) });
    },
    off() { HUD.off(); },
    health() { return HUD.durum(); }
  });

  /* =====================================================================
   * 6) KENDİ MESAJLARIM
   * ===================================================================== */

  define({
    id: 'userMessageColor',
    label: 'Mesaj vurgusu',
    desc: 'Senin yazdığın mesajları mavi, kalın ve alıntı çubuklu gösterir. Kod blokları kendi renklerini ve normal kalınlığını korur.',
    group: 'Bilgi',
    health() {
      const n = document.querySelectorAll('[data-testid="user-message"]').length;
      return suankiSohbet()
        ? { tamam: n > 0, metin: n ? _f('{0} mesajın bulundu', n) : _('Bu sohbette mesajın bulunamadı (seçici değişmiş olabilir)') }
        : { tamam: true, metin: _('Sohbet sayfasında çalışır') };
    },
    on(ctx) {
      const SEL = '[data-testid="user-message"]';
      const LIGHT = '#1f6feb';
      const DARK  = '#79b8ff';
      const WEIGHT = 600;   // 700 uzun mesajlarda yorucu oluyor

      /* Alıntı görünümü CSS ile veriliyor, DOM'a <blockquote> sarılmıyor:
         React her yeniden çizimde eklenen düğümü söker, kenarlık ve dolgu ise
         kalıcıdır.

         Renk ve kalınlık kapsayıcıya verilip içeride miras alınıyor. Kod
         dışarıda tutuluyor: sözdizimi renklendirmesi ezilmesin ve tek aralıklı
         yazı kalınlaşıp bozulmasın. <strong> zaten kalın olan metinden
         ayrılabilsin diye bir kademe daha yukarı alınıyor. */
      const rules = c => `
      ${SEL}{
        color:${c} !important;
        font-weight:${WEIGHT} !important;
        border-left:3px solid ${c} !important;
        padding-left:14px !important;
        background:color-mix(in srgb, ${c} 7%, transparent) !important;
        border-top-left-radius:2px !important;
        border-bottom-left-radius:2px !important;}

      ${SEL} *:not(code):not(pre):not(code *):not(pre *):not(svg):not(svg *):not(strong):not(b){
        color:inherit !important;
        font-weight:inherit !important;}

      ${SEL} strong, ${SEL} b{font-weight:800 !important;}

      ${SEL} code, ${SEL} pre, ${SEL} code *, ${SEL} pre *{
        font-weight:400 !important;}

      ${SEL} a{color:${c} !important;text-decoration-color:${c} !important;}`;

      const style = ctx.css(rules(isDark() ? DARK : LIGHT));

      function repaint() {
        const next = rules(isDark() ? DARK : LIGHT);
        if (style.textContent !== next) style.textContent = next;
      }

      ctx.watch(document.documentElement, {
        attributes: true, attributeFilter: ['class', 'style', 'data-mode', 'data-theme']
      }, repaint);
      const mq = media('(prefers-color-scheme: dark)');
      if (mq && mq.addEventListener) ctx.on(mq, 'change', repaint);
    }
  });


  const SOLA = { durum: () => ({ tamam: true, metin: _('kapalı') }) };

  /* =====================================================================
   * 7) SOHBETİ SOLA SABİTLE
   * ===================================================================== */

  define({
    id: 'stickLeft',
    label: 'Sohbeti sola sabitle',
    desc: 'Sohbet sütununu ortada bırakmak yerine sola yaslar. Sütun bulunamazsa yeniden hesapla kısayolunu dene.',
    group: 'Yerleşim',
    kisayol: 'solaSabitle',
    health() { return SOLA.durum(); },
    on(ctx) {
      const OFFSET = 24, MIN_W = 320, MIN_H = 48, MAX_DEPTH = 30, TOLERANCE = 2, SETTLE = 250;
      const MANUAL_SELECTOR = '';
      const MARK = 'data-zleft';

      let target = null, holder = null, ro = null, settleTimer = null;
      let yakin = null;
      SOLA.durum = () => target && target.isConnected
        ? { tamam: true, metin: _('Sohbet sütunu bulundu ve sola yaslandı') }
        : (suankiSohbet()
          ? { tamam: false, metin: _('Ortalanmış sohbet sütunu bulunamadı') + ' · ' +
              (yakin ? _f('en yakın aday {0} px, boşluk sol {1} / sağ {2} px', yakin.w, yakin.gapL, yakin.gapR) : _('aday yok')),
              ayrinti: SOLA.zincir ? SOLA.zincir() : null }
          : { tamam: true, metin: _('Sohbet sayfasında çalışır') });
      ctx.undo(() => { SOLA.durum = () => ({ tamam: true, metin: _('kapalı') }); });
      let lastUrl = location.href;

      function apply() {
        if (!target || !target.isConnected || !holder || !holder.isConnected) return;
        target.style.removeProperty('left');
        const r = target.getBoundingClientRect();
        const shift = Math.max(0, Math.round((r.left - icKutu(holder).sol) - OFFSET));
        if (shift < 1) return;
        if (getComputedStyle(target).position === 'static') {
          target.style.setProperty('position', 'relative', 'important');
        }
        target.style.setProperty('left', (-shift) + 'px', 'important');
        target.setAttribute(MARK, '1');
      }

      function settle() {
        clearTimeout(settleTimer);
        settleTimer = setTimeout(() => requestAnimationFrame(apply), SETTLE);
      }
      ctx.undo(() => clearTimeout(settleTimer));

      function release() {
        if (target) {
          target.style.removeProperty('left');
          target.style.removeProperty('position');
          target.removeAttribute(MARK);
        }
        if (ro) { ro.disconnect(); ro = null; }
        target = null; holder = null;
      }
      ctx.undo(release);

      const SKIP_TAGS = new Set(['SCRIPT', 'STYLE', 'SVG', 'CANVAS', 'IFRAME', 'EMBED', 'OBJECT',
        'VIDEO', 'IMG', 'TEXTAREA', 'INPUT', 'BUTTON', 'NAV', 'ASIDE', 'DIALOG']);

      function unusable(el) {
        if (SKIP_TAGS.has(el.tagName)) return true;
        if (el.closest('nav, aside, [role="dialog"], [role="menu"], [role="tooltip"]')) return true;
        return false;
      }

      /* Kapsayıcının içerik kutusu: kenarlık, iç dolgu ve kaydırma çubuğu hariç. */
      function icKutu(p) {
        const pr = p.getBoundingClientRect();
        const ps = getComputedStyle(p);
        const padL = parseFloat(ps.paddingLeft) || 0, padR = parseFloat(ps.paddingRight) || 0;
        const sol = pr.left + (p.clientLeft || 0) + padL;
        const gen = (p.clientWidth || pr.width) - padL - padR;
        return { sol, gen, padL, padR };
      }

      function olc(el, r) {
        const p = el.parentElement;
        if (!p) return null;
        const k = icKutu(p);
        r = r || el.getBoundingClientRect();
        return { gapL: r.left - k.sol, gapR: k.sol + k.gen - r.right, k, r };
      }

      function ortadaMi(el, r) {
        const o = olc(el, r);
        if (!o) return false;
        const cs = getComputedStyle(el);
        const flows = cs.position !== 'fixed' && cs.position !== 'absolute';
        const fark = Math.abs(o.gapL - o.gapR);
        if (o.gapL > 12 && o.gapR > -2 && flows && (!yakin || fark < yakin.fark)) {
          yakin = { fark, gapL: Math.round(o.gapL), gapR: Math.round(o.gapR), w: Math.round(o.r.width) };
        }
        const dar = cs.maxWidth !== 'none' || o.k.gen - o.r.width > 48;
        return o.gapL > 12 && fark <= Math.max(TOLERANCE, 6) && flows && dar;
      }

      const MESAJ_SEC = '[data-testid="user-message"], .font-claude-response, [data-is-streaming]';

      /* Yedek yol: ilk mesajdan yukarı çık; ortalanmış ilk ataya kilitlen. */
      function atadanBul() {
        let el = document.querySelector(MESAJ_SEC);
        for (let i = 0; el && el.parentElement && el !== document.body && i < 40; i++, el = el.parentElement) {
          const r = el.getBoundingClientRect();
          if (r.width < MIN_W || r.height < MIN_H || unusable(el)) continue;
          if (ortadaMi(el, r)) { target = el; holder = el.parentElement; return true; }
        }
        return false;
      }

      /* Tanı için: ilk mesajın üst zinciri, her halkada genişlik, boşluklar, dolgu. */
      SOLA.zincir = () => {
        const satir = [];
        let el = document.querySelector(MESAJ_SEC);
        if (!el) return [_('mesaj öğesi bulunamadı')];
        for (let i = 0; el && el !== document.body && i < 40 && satir.length < 14; i++, el = el.parentElement) {
          const r = el.getBoundingClientRect();
          if (r.width < MIN_W) continue;
          const o = olc(el, r);
          const cs = getComputedStyle(el);
          satir.push(i + ' ' + el.tagName.toLowerCase() + ' ' + Math.round(r.width) + ' px · ' +
            _f('sol {0} / sağ {1} · üst dolgu {2}/{3}', Math.round(o.gapL), Math.round(o.gapR), Math.round(o.k.padL), Math.round(o.k.padR)) +
            (cs.maxWidth !== 'none' ? ' · max ' + cs.maxWidth : '') + (cs.position !== 'static' ? ' · ' + cs.position : '') +
            (el.tagName === 'MAIN' ? ' · main' : ''));
        }
        return satir;
      };
      ctx.undo(() => { SOLA.zincir = null; });

      function find() {
        if (MANUAL_SELECTOR) {
          const el = document.querySelector(MANUAL_SELECTOR);
          if (el && el.parentElement) { target = el; holder = el.parentElement; return true; }
          return false;
        }
        const rootEl = document.querySelector('main') || document.body;
        if (!rootEl) return false;

        let level = [rootEl], depth = 0;
        yakin = null;
        while (level.length && depth < MAX_DEPTH) {
          const next = [];
          for (const el of level) {
            for (const child of el.children) {
              if (unusable(child)) continue;
              const r = child.getBoundingClientRect();
              if (r.width < MIN_W || r.height < MIN_H) { next.push(child); continue; }
              const p = child.parentElement;
              /* Boşluklar kapsayıcının içerik kutusuna göre ölçülür: kaydırma
                 çubuğu (Windows, ~17 px) ve iç dolgu (kenar çubuğu payı) hariç. */
              if (ortadaMi(child, r)) { target = child; holder = p; return true; }
              next.push(child);
            }
          }
          level = next; depth++;
        }
        return atadanBul();
      }

      function lockOn() {
        if (target && target.isConnected) return;
        release();
        if (find()) {
          apply();
          ro = new ResizeObserver(settle);
          ro.observe(holder);
        }
      }

      ctx.every(() => {
        if (location.href !== lastUrl) { lastUrl = location.href; release(); }
        if (!target || !target.isConnected) lockOn();
      }, 1000);

      ctx.on(window, 'resize', settle, { passive: true });
      lockOn();

      /* seçici bulma modu — Alt+Shift+P */
      let picking = false;

      function selectorFor(el) {
        if (el.id) return '#' + CSS.escape(el.id);
        const parts = [];
        let cur = el;
        for (let i = 0; i < 4 && cur && cur !== document.body; i++) {
          let s = cur.tagName.toLowerCase();
          const cls = (cur.getAttribute('class') || '').trim().split(/\s+/)
            .filter(c => c && !/^(hover|focus|active|group|dark|md|lg|sm|xl):/.test(c))
            .slice(0, 3).map(c => '.' + CSS.escape(c)).join('');
          parts.unshift(s + cls);
          cur = cur.parentElement;
        }
        return parts.join(' > ');
      }

      function onPick(e) {
        e.preventDefault();
        e.stopPropagation();
        const el = document.elementFromPoint(e.clientX, e.clientY);
        console.log('%c[zleft] Tıklanan eleman ve üst zinciri:', 'font-weight:bold');
        let cur = el;
        for (let i = 0; i < 6 && cur; i++) {
          const r = cur.getBoundingClientRect();
          console.log(`  [${i}] ${Math.round(r.width)}x${Math.round(r.height)} @${Math.round(r.left)}`,
            cur, '\n      MANUAL_SELECTOR = ' + JSON.stringify(selectorFor(cur)));
          cur = cur.parentElement;
        }
        stopPick();
      }

      function stopPick() {
        picking = false;
        document.documentElement.style.removeProperty('cursor');
        window.removeEventListener('click', onPick, true);
      }
      ctx.undo(stopPick);

      ctx.on(window, 'keydown', e => {
        const k = e.key.toLowerCase();
        if (KISAYOL.eslesir(e) === 'solaYeniden') { e.preventDefault(); release(); lockOn(); return; }
        if (k === 'p' && e.altKey && e.shiftKey && !e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          if (picking) return stopPick();
          picking = true;
          document.documentElement.style.setProperty('cursor', 'crosshair', 'important');
          window.addEventListener('click', onPick, true);
          console.log('%c[zleft] Seçici modu açık — sohbet sütununa tıkla.', 'color:#2d7dff');
        }
      });
    }
  });

  define({
    id: 'modelColor',
    label: 'Model adını renklendir',
    desc: 'Seçili modelin adını renkle ayırır: Fable ve Mythos bordo, Opus pembe, Sonnet turuncu, Haiku siyah. Koyu temada açık tonlar.',
    group: 'Bilgi',
    on(ctx) {
      /* Güncel aileler: Fable 5.1, Mythos 5.1, Opus 5.5, Sonnet 5.5, Haiku 5.5.
         Sürüm numarasına göre değil aileye göre boyanır; yeni sürümde de çalışır.
         Koyu temada siyah ve bordo okunmaz, açık karşılıkları kullanılır. */
      const MODEL_RE = /\b(fable|mythos|opus|sonnet|haiku)\b/i;
      const RULES = [
        { re: /\b(fable|mythos)\b/i, light: '#8E1A32', dark: '#F07A92' },
        { re: /\bopus\b/i,           light: '#C2367F', dark: '#F27BB5' },
        { re: /\bsonnet\b/i,         light: '#A85A00', dark: '#F0A03C' },
        { re: /\bhaiku\b/i,          light: '#111111', dark: '#E6ECF5' }
      ];
      const HOLDER = 'button,[role="button"],[role="menuitem"],[role="option"],[aria-haspopup="menu"],[aria-haspopup="listbox"]';
      const painted = new Set();

      ctx.css('.cfc-model{font-weight:700!important;}');

      const colorOf = txt => { const r = RULES.find(x => x.re.test(txt)); return r ? (isDark() ? r.dark : r.light) : null; };

      function leafOf(el) {
        let node = el, next;
        while ((next = [...node.children].find(c => MODEL_RE.test(c.textContent || '')))) node = next;
        return node;
      }

      function clear(el) {
        el.classList.remove('cfc-model');
        el.style.removeProperty('color');
        if (!el.getAttribute('style')) el.removeAttribute('style');
      }

      function paint() {
        const live = new Set();
        for (const holder of document.querySelectorAll(HOLDER)) {
          const t = (holder.textContent || '').trim();
          if (!t || t.length > 60 || !MODEL_RE.test(t)) continue;
          if (!holder.getClientRects().length) continue;
          const el = leafOf(holder);
          const color = colorOf((el.textContent || '').trim());
          if (!color) continue;
          if (el.style.getPropertyValue('color') !== color) el.style.setProperty('color', color, 'important');
          el.classList.add('cfc-model');
          live.add(el);
          painted.add(el);
        }
        for (const el of [...painted]) {
          if (live.has(el) && el.isConnected) continue;
          clear(el);
          painted.delete(el);
        }
      }

      ctx.undo(() => { painted.forEach(clear); painted.clear(); });

      let q = false;
      ctx.watch(document.body, { childList: true, subtree: true, characterData: true }, () => {
        if (q) return;
        q = true;
        requestAnimationFrame(() => { q = false; paint(); });
      });
      ctx.every(paint, 500);
      paint();
    }
  });

  /* =====================================================================
   * 8) WIDGET'I YÜZDÜR
   * ===================================================================== */

  define({
    id: 'widgetFloat',
    label: 'Widget\'ı yüzdür',
    desc: 'Three.js viewer, artifact, visualize gibi iframe widget\'larına "float" butonu koyar; sürükle-bırak yüzen pencereye alır. Esc ile geri koyar.',
    group: 'Araçlar',
    keys: 'Esc',
    on(ctx) {
      const CFG = { minIframeW: 180, minIframeH: 140, minW: 260, minH: 200, scanMs: 300, z: 2147483647, storeKey: 'cwf:v1' };
      const CAN_POPOVER = typeof HTMLElement.prototype.showPopover === 'function';

      function toTopLayer(node) {
        if (!CAN_POPOVER) return false;
        try {
          if (node.getAttribute('popover') !== 'manual') node.setAttribute('popover', 'manual');
          let open = false;
          try { open = node.matches(':popover-open'); } catch (e) { open = false; }
          if (!open) node.showPopover();
          return true;
        } catch (e) { return false; }
      }

      function unTop(node) {
        try { node.hidePopover(); } catch (e) {}
        node.removeAttribute('popover');
      }

      ctx.css(
        '[popover].cwf::backdrop{background:transparent!important;pointer-events:none!important}' +
        '[popover].cwf{inset:auto!important;border:none!important;padding:0!important;' +
        'margin:0!important;overflow:hidden!important;color:inherit}');

      function makesStackingContext(cs) {
        if (cs.position !== 'static' && cs.zIndex !== 'auto') return true;
        if (parseFloat(cs.opacity) < 1) return true;
        if (cs.isolation === 'isolate') return true;
        if (cs.mixBlendMode && cs.mixBlendMode !== 'normal') return true;
        if (cs.transform && cs.transform !== 'none') return true;
        if (cs.filter && cs.filter !== 'none') return true;
        if (cs.backdropFilter && cs.backdropFilter !== 'none') return true;
        if (cs.perspective && cs.perspective !== 'none') return true;
        if (cs.willChange && /transform|opacity|filter/.test(cs.willChange)) return true;
        if (cs.contain && /paint|layout|strict|content/.test(cs.contain)) return true;
        return false;
      }

      function liftAncestors(node) {
        const touched = [];
        let p = node.parentElement;
        while (p && p !== document.documentElement) {
          const cs = getComputedStyle(p);
          const needLift = makesStackingContext(cs);
          const needFlat = (cs.transform !== 'none') || (cs.filter !== 'none') ||
                           (cs.perspective !== 'none') || (cs.contain && cs.contain !== 'none');
          if (needLift || needFlat) {
            touched.push({ node: p, css: p.getAttribute('style') });
            if (cs.position === 'static') p.style.setProperty('position', 'relative', 'important');
            p.style.setProperty('z-index', String(CFG.z), 'important');
            p.style.setProperty('transform', 'none', 'important');
            p.style.setProperty('filter', 'none', 'important');
            p.style.setProperty('backdrop-filter', 'none', 'important');
            p.style.setProperty('perspective', 'none', 'important');
            p.style.setProperty('contain', 'none', 'important');
            p.style.setProperty('will-change', 'auto', 'important');
            p.style.setProperty('isolation', 'auto', 'important');
            p.style.setProperty('overflow', 'visible', 'important');
            if (parseFloat(cs.opacity) < 1) p.style.setProperty('opacity', '1', 'important');
            if (cs.mixBlendMode !== 'normal') p.style.setProperty('mix-blend-mode', 'normal', 'important');
          }
          p = p.parentElement;
        }
        return touched;
      }

      function restoreAncestors(touched) {
        for (const t of touched) {
          if (t.css != null) t.node.setAttribute('style', t.css);
          else t.node.removeAttribute('style');
        }
      }

      let layer = null;
      function ensureLayer() {
        if (layer && document.body && document.body.contains(layer)) return layer;
        layer = document.createElement('div');
        layer.id = 'cwf-layer';
        layer.className = 'cwf';
        Object.assign(layer.style, {
          position: 'fixed', left: '0', top: '0', width: '100vw', height: '100vh',
          pointerEvents: 'none', zIndex: String(CFG.z), background: 'transparent'
        });
        (document.body || document.documentElement).appendChild(layer);
        toTopLayer(layer);
        return layer;
      }
      ctx.undo(() => { if (layer) layer.remove(); layer = null; });

      function raiseLayer() {
        const L = ensureLayer();
        if (!CAN_POPOVER) return;
        try { L.hidePopover(); } catch (e) {}
        toTopLayer(L);
      }

      function el(tag, style, text) {
        const n = document.createElement(tag);
        n.className = 'cwf';
        if (style) Object.assign(n.style, style);
        if (text != null) n.textContent = text;
        return n;
      }

      // AALabs görünümü: düz renk, ince kenar, keskin köşe; bulanıklık ve gölge yok.
      const TV = () => TEMA.vars();
      const btnStyle = {
        pointerEvents: 'auto', cursor: 'pointer', border: '1px solid ' + TV().ana,
        background: TV().ana, color: '#fff', font: '600 12px/1 "Open Sans","Segoe UI",sans-serif',
        padding: '5px 8px', borderRadius: '2px', userSelect: 'none'
      };

      function measureOrigin(node) {
        const prev = node.getAttribute('style');
        node.style.setProperty('position', 'fixed', 'important');
        node.style.setProperty('left', '0px', 'important');
        node.style.setProperty('top', '0px', 'important');
        node.style.setProperty('right', 'auto', 'important');
        node.style.setProperty('bottom', 'auto', 'important');
        node.style.setProperty('margin', '0', 'important');
        const r = node.getBoundingClientRect();
        if (prev != null) node.setAttribute('style', prev); else node.removeAttribute('style');
        return { x: r.left, y: r.top };
      }

      const floats = new Map();
      const pins = new Map();

      const loadState = () => { try { return JSON.parse(localStorage.getItem(CFG.storeKey)); } catch (e) { return null; } };
      const saveState = s => { try { localStorage.setItem(CFG.storeKey, JSON.stringify(s)); } catch (e) {} };
      const clamp = (v, a, b) => Math.max(a, Math.min(b, v));

      function isCandidate(f) {
        if (!f.isConnected) return false;
        const r = f.getBoundingClientRect();
        return r.width >= CFG.minIframeW && r.height >= CFG.minIframeH;
      }

      function float(frame) {
        if (floats.has(frame)) return;

        const startRect = frame.getBoundingClientRect();
        const parent = frame.parentElement;
        const saved = {
          frameCss: frame.getAttribute('style'),
          frameClass: frame.className,
          parentMinH: parent ? (parent.style.minHeight || '') : ''
        };

        if (parent) parent.style.minHeight = Math.round(startRect.height) + 'px';

        frame.classList.add('cwf');
        const promoted = toTopLayer(frame);
        const touched = promoted ? [] : liftAncestors(frame);
        const origin = measureOrigin(frame);

        const prev = loadState();
        const st = {
          x: prev ? prev.x : clamp(startRect.left, 12, Math.max(12, window.innerWidth - startRect.width - 24)),
          y: prev ? prev.y : Math.max(56, startRect.top),
          w: prev ? prev.w : startRect.width,
          h: prev ? prev.h : startRect.height
        };
        st.w = clamp(st.w, CFG.minW, window.innerWidth - 24);
        st.h = clamp(st.h, CFG.minH, window.innerHeight - 80);
        st.x = clamp(st.x, 0, window.innerWidth - st.w);
        st.y = clamp(st.y, 36, window.innerHeight - 60);

        const L = ensureLayer();
        const chrome = el('div', { position: 'fixed', pointerEvents: 'none', boxSizing: 'border-box' });
        const bar = el('div', {
          position: 'absolute', left: '0', top: '-30px', width: '100%', height: '30px',
          pointerEvents: 'auto', cursor: 'move', display: 'flex', alignItems: 'center',
          gap: '6px', padding: '0 8px', boxSizing: 'border-box',
          background: TV().yuzey, color: TV().metin, borderRadius: '6px 6px 0 0',
          border: '1px solid ' + TV().kenar, borderBottom: 'none',
          font: '600 12px/1 "Open Sans","Segoe UI",sans-serif'
        });
        const title = el('span', { flex: '1', color: TV()['metin-ikincil'], overflow: 'hidden', whiteSpace: 'nowrap' }, 'Widget');
        const bMax = el('button', Object.assign({}, btnStyle, { background: 'transparent', border: 'none', color: TV().metin, padding: '4px 6px' }), '⤢');
        const bClose = el('button', Object.assign({}, btnStyle, { background: 'transparent', border: 'none', color: TV().metin, padding: '4px 6px' }), '✕');
        bMax.setAttribute('aria-label', _('Büyüt'));
        bClose.setAttribute('aria-label', _('Yerine koy'));
        bMax.title = _('Büyüt / eski boyut (başlıkta çift tık)');
        bClose.title = _('Yerine geri koy (Esc)');
        bar.append(title, bMax, bClose);

        const grip = el('div', {
          position: 'absolute', right: '-2px', bottom: '-2px', width: '18px', height: '18px',
          pointerEvents: 'auto', cursor: 'nwse-resize',
          borderRight: '3px solid ' + TV().kenar, borderBottom: '3px solid ' + TV().kenar, boxSizing: 'border-box'
        });
        chrome.append(bar, grip);
        L.appendChild(chrome);
        raiseLayer();

        const rec = { frame, parent, saved, touched, origin, st, chrome, bar, grip, max: null, promoted };
        floats.set(frame, rec);
        apply(rec);

        let drag = null;
        bar.addEventListener('pointerdown', e => {
          if (e.target === bMax || e.target === bClose) return;
          drag = { dx: e.clientX - rec.st.x, dy: e.clientY - rec.st.y };
          bar.setPointerCapture(e.pointerId);
          shield(true); e.preventDefault();
        });
        bar.addEventListener('pointermove', e => {
          if (!drag) return;
          rec.st.x = clamp(e.clientX - drag.dx, -rec.st.w + 80, window.innerWidth - 80);
          rec.st.y = clamp(e.clientY - drag.dy, 32, window.innerHeight - 40);
          apply(rec);
        });
        const endDrag = () => { if (drag) { drag = null; shield(false); saveState(rec.st); } };
        bar.addEventListener('pointerup', endDrag);
        bar.addEventListener('pointercancel', endDrag);

        let rez = null;
        grip.addEventListener('pointerdown', e => {
          rez = { x: e.clientX, y: e.clientY, w: rec.st.w, h: rec.st.h };
          grip.setPointerCapture(e.pointerId);
          shield(true); e.preventDefault();
        });
        grip.addEventListener('pointermove', e => {
          if (!rez) return;
          rec.st.w = Math.max(CFG.minW, rez.w + (e.clientX - rez.x));
          rec.st.h = Math.max(CFG.minH, rez.h + (e.clientY - rez.y));
          apply(rec);
        });
        const endRez = () => { if (rez) { rez = null; shield(false); saveState(rec.st); } };
        grip.addEventListener('pointerup', endRez);
        grip.addEventListener('pointercancel', endRez);

        const toggleMax = () => {
          if (rec.max) { rec.st = rec.max; rec.max = null; }
          else {
            rec.max = Object.assign({}, rec.st);
            rec.st = { x: 12, y: 44, w: window.innerWidth - 24, h: window.innerHeight - 60 };
          }
          apply(rec);
          saveState(rec.max ? rec.max : rec.st);
        };
        bMax.addEventListener('click', toggleMax);
        bar.addEventListener('dblclick', toggleMax);
        bClose.addEventListener('click', () => unfloat(frame));
      }

      function apply(rec) {
        const { frame, st, origin, chrome } = rec;
        const S = (k, v) => frame.style.setProperty(k, v, 'important');
        S('position', 'fixed');
        S('left', (st.x - origin.x) + 'px');
        S('top', (st.y - origin.y) + 'px');
        S('right', 'auto'); S('bottom', 'auto'); S('inset', 'auto');
        S('left', (st.x - origin.x) + 'px'); S('top', (st.y - origin.y) + 'px');
        S('width', st.w + 'px'); S('height', st.h + 'px');
        S('min-width', '0'); S('min-height', '0');
        S('max-width', 'none'); S('max-height', 'none');
        S('margin', '0'); S('padding', '0'); S('border', 'none');
        S('z-index', String(CFG.z));
        S('border-radius', '0 0 6px 6px');
        S('box-shadow', 'none');
        S('outline', '1px solid ' + TV().kenar);
        S('background', TV().yuzey);
        S('display', 'block');
        S('visibility', 'visible');
        S('opacity', '1');
        chrome.style.left = st.x + 'px';
        chrome.style.top = st.y + 'px';
        chrome.style.width = st.w + 'px';
        chrome.style.height = st.h + 'px';
      }

      function unfloat(frame) {
        const rec = floats.get(frame);
        if (!rec) return;
        floats.delete(frame);
        rec.chrome.remove();
        if (rec.promoted) unTop(frame);
        frame.className = rec.saved.frameClass;
        if (rec.saved.frameCss != null) frame.setAttribute('style', rec.saved.frameCss);
        else frame.removeAttribute('style');
        if (rec.parent) rec.parent.style.minHeight = rec.saved.parentMinH;
        restoreAncestors(rec.touched);
      }
      ctx.undo(() => { for (const [f] of [...floats]) unfloat(f); });

      let shieldEl = null;
      function shield(on) {
        if (on) {
          if (shieldEl) return;
          shieldEl = el('div', {
            position: 'fixed', left: '0', top: '0', width: '100vw', height: '100vh',
            pointerEvents: 'auto', cursor: 'grabbing', background: 'transparent'
          });
          ensureLayer().appendChild(shieldEl);
        } else if (shieldEl) { shieldEl.remove(); shieldEl = null; }
      }

      function pinFor(frame) {
        let b = pins.get(frame);
        if (!b) {
          b = el('button', Object.assign({}, btnStyle, { position: 'fixed', opacity: '.55' }), '⇱ ' + _('Yüzdür'));
          b.title = _('Yüzen pencereye al');
          b.addEventListener('mouseenter', () => { b.style.opacity = '1'; });
          b.addEventListener('mouseleave', () => { b.style.opacity = '.55'; });
          b.addEventListener('click', () => float(frame));
          ensureLayer().appendChild(b);
          pins.set(frame, b);
        }
        return b;
      }
      ctx.undo(() => { for (const [, b] of pins) b.remove(); pins.clear(); });

      function tick() {
        if (!document.body) return;
        ensureLayer();
        const seen = new Set();
        for (const f of document.querySelectorAll('iframe')) {
          if (floats.has(f)) { seen.add(f); continue; }
          if (!isCandidate(f)) continue;
          seen.add(f);
          const r = f.getBoundingClientRect();
          const b = pinFor(f);
          const vis = r.bottom > 0 && r.top < window.innerHeight;
          b.style.display = vis ? 'block' : 'none';
          b.style.left = Math.round(r.right - 74) + 'px';
          b.style.top = Math.round(r.top + 8) + 'px';
        }
        for (const [f, b] of pins) if (!seen.has(f) || floats.has(f)) { b.remove(); pins.delete(f); }
        for (const [f, rec] of floats) if (!f.isConnected) { rec.chrome.remove(); floats.delete(f); }
      }

      ctx.on(document, 'keydown', e => {
        if (e.key === 'Escape' && floats.size) {
          for (const [f] of [...floats]) unfloat(f);
          e.stopPropagation();
        }
      }, true);

      ctx.on(window, 'resize', () => { for (const [, rec] of floats) apply(rec); });
      ctx.every(tick, CFG.scanMs);
      tick();
    }
  });

  /* =====================================================================
   * 9) PROJE ETİKETLERİ, FİLTRE, SAYI, BAŞLIKTA ARAMA
   *
   * claude.ai iç API'sinde sohbet→proje bağının hangi alanda geldiği
   * sürümden sürüme değişebiliyor, o yüzden tek bir alan adına
   * güvenmiyoruz: hem "project" içeren her anahtarı tarıyoruz, hem de
   * sayfanın kendi yaptığı isteklerin yanıtlarını pasif dinliyoruz.
   * Şema değişirse claudeSuite.probeProjects() gerçek alan adlarını döker.
   * ===================================================================== */

  const PROJ = (function () {
    const KEY = 'csuite:proj';
    const TTL = 10 * 60000;

    let store = load();

    function load() {
      try {
        const v = JSON.parse(localStorage.getItem(KEY));
        if (v && v.projects && v.chats) {
          v.hues = v.hues || {}; v.pins = v.pins || {};
          return v;
        }
      } catch (e) {}
      return { at: 0, projects: {}, chats: {}, hues: {}, pins: {}, complete: false };
    }
    function save() { try { localStorage.setItem(KEY, JSON.stringify(store)); } catch (e) {} }

    // Bugün UUID geliyor, yarın başka bir kimlik biçimi gelebilir. Katı UUID
    // kalıbına bağlanmak yerine "kimlik gibi duran uzun dizge" kabul ediyoruz.
    const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    const ID_RE = /^[0-9a-zA-Z_-]{20,80}$/;
    const isUuid = v => typeof v === 'string' && (UUID_RE.test(v) || ID_RE.test(v));

    /* Bir sohbet nesnesinden proje bağını çıkar. Alan adı bilinmediği için
       "project" geçen her anahtara bakılır; değer düz kimlik de olabilir,
       gömülü nesne de. */
    function projectOf(o, depth) {
      if (!o || typeof o !== 'object' || (depth || 0) > 3) return null;
      for (const [k, v] of Object.entries(o)) {
        if (!/project/i.test(k)) continue;
        if (isUuid(v)) return { uuid: v };
        if (v && typeof v === 'object' && !Array.isArray(v)) {
          const id = v.uuid || v.id;
          if (isUuid(id)) return { uuid: id, name: v.name || v.title || null };
        }
        if (Array.isArray(v) && v.length) {
          const f = v[0];
          if (isUuid(f)) return { uuid: f };
          if (f && typeof f === 'object') {
            const id = f.uuid || f.id;
            if (isUuid(id)) return { uuid: id, name: f.name || f.title || null };
          }
        }
      }
      // bir kademe içeride olabilir (settings, metadata gibi sarmalayıcılar)
      for (const v of Object.values(o)) {
        if (v && typeof v === 'object' && !Array.isArray(v)) {
          const r = projectOf(v, (depth || 0) + 1);
          if (r) return r;
        }
      }
      return null;
    }

    const listOf = j => (Array.isArray(j) ? j : (j && Array.isArray(j.data) ? j.data : null));

    /* Bazı yanıtlar projenin sohbet sayısını hazır veriyor. Varsa onu
       kullanmak, kendi listemizden saymaktan her zaman daha doğru: bizim
       liste sayfalama sınırına takılmış olabilir. Alan adı bilinmediği için
       kalıba göre aranıyor. */
    const COUNT_RE = /^(conversation|chat|message|thread|doc|item)s?_?count$|^(num|total)_(conversation|chat)s?$/i;

    function countIn(o) {
      for (const [k, v] of Object.entries(o)) {
        if (typeof v === 'number' && isFinite(v) && COUNT_RE.test(k)) return v;
      }
      return null;
    }

    function learnProjects(j) {
      const arr = listOf(j);
      if (!arr) return 0;
      let n = 0;
      for (const p of arr) {
        if (!p || typeof p !== 'object') continue;
        const id = p.uuid || p.id;
        const name = p.name || p.title;
        if (!isUuid(id) || !name) continue;
        const cur = store.projects[id];
        const cnt = countIn(p);
        if (!cur || cur.name !== name || cur.apiCount !== cnt) n++;
        store.projects[id] = { name: String(name) };
        if (cnt !== null) store.projects[id].apiCount = cnt;
      }
      return n;
    }

    /* Sabitleme durumu da sohbet üstü bilgisi; proje eşlemesiyle aynı
       gövdelerden geliyor. Alan adı yine bilinmiyor, bu yüzden ada göre
       değil kalıba göre aranıyor: is_starred, pinned, is_favorite... */
    const PIN_KEY_RE = /^(is_)?(starred|pinned|favou?rite[d]?|bookmarked)$/i;

    function pinOf(o) {
      for (const [k, v] of Object.entries(o)) {
        if (typeof v === 'boolean' && PIN_KEY_RE.test(k)) return v;
      }
      return null;
    }

    /* Yanıtların hepsi proje alanı taşımıyor: liste uçları bazen hafif bir
       gövde döndürüyor. Böyle bir yanıtı "bu sohbetler projesiz" diye okursak
       daha önce öğrendiğimiz eşlemeleri siliyoruz ve rozetler kayboluyor —
       eksik pill'lerin sebebi buydu. Bu yüzden silme yalnızca yanıtın gerçekten
       proje bilgisi taşıdığı kanıtlanırsa yapılıyor: aynı gövdede en az bir
       kayıt projeye bağlıysa, o gövde bu konuda yetkili sayılır. */
    function learnChats(j) {
      const arr = listOf(j);
      if (!arr) return 0;

      const rows = [];
      let authoritative = false;
      for (const c of arr) {
        if (!c || typeof c !== 'object') continue;
        const id = c.uuid || c.id;
        if (!isUuid(id)) continue;
        const p = projectOf(c, 0);
        if (p && p.uuid) authoritative = true;
        rows.push([id, p, pinOf(c)]);
      }

      let n = 0;
      for (const [id, p, pin] of rows) {
        if (pin !== null && store.pins[id] !== pin) { store.pins[id] = pin; n++; }
        if (p && p.uuid) {
          if (store.chats[id] !== p.uuid) n++;
          store.chats[id] = p.uuid;
          if (p.name && !store.projects[p.uuid]) store.projects[p.uuid] = { name: String(p.name) };
        } else if (authoritative && store.chats[id]) {
          delete store.chats[id]; n++;   // projeden gerçekten çıkarılmış
        }
      }
      return n;
    }

    // Sayfanın kendi istekleri: bedava veri, ekstra trafik yok.
    function listen() {
      return NET.sub((url, json) => {
        let n = 0;
        if (/\/projects(\?|$|\/)/.test(url)) n += learnProjects(json);
        if (/(chat_conversations|conversations|tasks)/.test(url)) n += learnChats(json);
        if (n) { store.at = Date.now(); save(); if (onChange) onChange(); }
      });
    }

    /* Tek istekte gelen kayıt sayısı sınırlı; arşiv büyükse eski sohbetler
       hiç öğrenilmiyordu. offset ile sayfa sayfa ilerliyoruz. API offset'i
       yok sayarsa aynı sayfa tekrar gelir; o yüzden "yeni kimlik eklendi mi"
       diye bakıp eklenmiyorsa duruyoruz — sonsuz döngü olmaz. */
    const PAGE = 100, MAX_PAGES = 12;

    async function pullChats(org) {
      let learned = 0;
      let before = Object.keys(store.chats).length;
      const seen = new Set();
      /* Listenin sonuna ulaşabildik mi? Ulaşamadıysak kendi saydığımız
         rakamlar eksik kalır ve bunu kullanıcıya belli etmemiz gerekir. */
      let complete = false;

      for (let page = 0; page < MAX_PAGES; page++) {
        let arr = null;
        try {
          const j = await NET.get(`/api/organizations/${org}/chat_conversations?limit=${PAGE}&offset=${page * PAGE}`);
          learned += learnChats(j);
          arr = listOf(j);
        } catch (e) {
          // İlk sayfa okunamıyorsa bu organizasyon bize kapalı (403); sonucu etkilemez.
          if (page === 0) return 0;
          store.yarim = { m: _n('{0}. sayfada {1}'), a: [page + 1, e.message] };
          break;
        }
        if (!arr || !arr.length) { complete = true; break; }

        // aynı sayfa tekrar mı geldi?
        let fresh = 0;
        for (const c of arr) {
          const id = c && (c.uuid || c.id);
          if (id && !seen.has(id)) { seen.add(id); fresh++; }
        }
        if (!fresh) { complete = true; break; }
        if (arr.length < PAGE) { complete = true; break; }   // son sayfa
      }

      /* 2.0.0'da ikinci organizasyon 403 verince "tam" bilgisi eziliyordu;
         panelde hep "liste eksik olabilir" yazıyordu. Artık yalnız okunabilen
         organizasyon sonucu belirliyor. */
      store.complete = complete;
      if (complete) store.yarim = null;
      else if (!store.yarim) store.yarim = { m: _n('sayfa sınırına ulaşıldı ({0} sohbet)'), a: [MAX_PAGES * PAGE] };

      if (!seen.size) {  // sayfalama hiç çalışmadıysa eski tek atışa dön
        for (const u of [`/api/organizations/${org}/chat_conversations?limit=300`,
                         `/api/organizations/${org}/chat_conversations`]) {
          try { if (learnChats(await NET.get(u))) { learned++; break; } } catch (e) {}
        }
      }
      return learned || (Object.keys(store.chats).length !== before ? 1 : 0);
    }

    /* Tek bir sohbetin üst bilgisi. Sohbet açıldığında sabitleme durumunu
       bilmiyorsak bunu çekiyoruz — tüm listeyi tazelemekten çok daha ucuz. */
    async function pullChat(id) {
      if (!id) return false;
      const orgs = await orgUuid();
      for (const org of orgs) {
        try {
          const j = await NET.get(`/api/organizations/${org}/chat_conversations/${id}`);
          if (j && typeof j === 'object' && !Array.isArray(j)) {
            const n = learnChats([j]);
            if (n) { save(); if (onChange) onChange(); }
            return true;
          }
        } catch (e) {}
      }
      return false;
    }

    let inflight = null;
    function refresh(force) {
      if (inflight) return inflight;
      if (!force && Date.now() - store.at < TTL && Object.keys(store.chats).length) {
        return Promise.resolve(false);
      }
      inflight = (async () => {
        const orgs = await orgUuid();
        let touched = 0;
        for (const org of orgs) {
          for (const u of [`/api/organizations/${org}/projects?limit=100`,
                           `/api/organizations/${org}/projects`]) {
            try { if (learnProjects(await NET.get(u))) { touched++; break; } } catch (e) {}
          }
          touched += await pullChats(org);
        }
        store.at = Date.now();
        save();
        inflight = null;
        if (touched && onChange) onChange();
        return touched > 0;
      })();
      return inflight;
    }

    let onChange = null;

    /* ---------------- Renk motoru ----------------
       Renk kimlikten hash'lenmiyor. Hash rastgele dağılsa bile 11 tonluk
       paletten 8 çekilişte beklenen farklı renk sayısı ~5.9 — yani doğum günü
       problemi yüzünden çakışma kaçınılmaz. Onun yerine her projeye ilk
       görüldüğünde EN AZ KULLANILAN ton veriliyor ve bu atama kalıcı olarak
       saklanıyor: 11 projeye kadar hiç çakışma olmuyor, atama oturumlar arası
       değişmiyor.
       Palet sırası bilerek karıştırıldı; ilk projeler mavi-kırmızı-turkuaz-mor
       gibi birbirinden en uzak tonları alsın diye.
       Doygunluk/açıklık %64/%46: bu değerde on bir tonun hepsi siyah ya da
       beyaz yazıyla en az 5.3:1 kontrast veriyor (WCAG AA eşiği 4.5).
       Yazı rengi sabit bir kurala değil, dolgunun gerçek parlaklığına bakar. */
    const HUES = [220, 8, 165, 292, 45, 258, 105, 325, 195, 350, 28];
    const SAT = 64, LIG = 46;
    const colorCache = new Map();

    function hslToRgb(h, s, l) {
      h /= 360; s /= 100; l /= 100;
      const f = n => {
        const k = (n + h * 12) % 12;
        const a = s * Math.min(l, 1 - l);
        return l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));
      };
      return [f(0), f(8), f(4)].map(v => Math.round(v * 255));
    }

    // WCAG göreli parlaklık
    function relLum(rgb) {
      const a = rgb.map(v => {
        v /= 255;
        return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
      });
      return 0.2126 * a[0] + 0.7152 * a[1] + 0.0722 * a[2];
    }

    function slotFor(id) {
      if (!store.hues) store.hues = {};
      if (store.hues[id] !== undefined) return store.hues[id];
      const used = new Array(HUES.length).fill(0);
      for (const k in store.hues) used[store.hues[k]]++;
      let best = 0;
      for (let i = 1; i < HUES.length; i++) if (used[i] < used[best]) best = i;
      store.hues[id] = best;
      save();
      return best;
    }

    function color(id) {
      let v = colorCache.get(id);
      if (v) return v;
      const hue = HUES[slotFor(id)];
      const rgb = hslToRgb(hue, SAT, LIG);
      const Y = relLum(rgb);
      const onBlack = (Y + 0.05) / 0.05;      // siyah yazıyla kontrast
      const onWhite = 1.05 / (Y + 0.05);      // beyaz yazıyla kontrast
      v = {
        hue,
        bg: 'rgb(' + rgb.join(',') + ')',
        fg: onBlack >= onWhite ? '#101010' : '#ffffff',
        ratio: Math.max(onBlack, onWhite)
      };
      colorCache.set(id, v);
      return v;
    }

    function palette() {
      const rows = Object.entries(store.projects).map(([id, p]) => {
        const c = color(id);
        return { proje: p.name, ton: c.hue + '°', dolgu: c.bg, yazı: c.fg, kontrast: c.ratio.toFixed(2) + ':1', id };
      });
      if (!rows.length) {
        console.log('%c[proje] Henüz proje bilinmiyor. Chats sayfasını açıp bekle ya da claudeSuite.refreshProjects() çalıştır.', 'color:#c0392b');
        return rows;
      }
      console.log('%c[proje] Rozet renkleri', 'font-weight:bold');
      for (const r of rows) {
        console.log('%c ' + r.proje + ' ',
          'background:' + r.dolgu + ';color:' + r.yazı +
          ';padding:2px 9px;border-radius:999px;font-weight:600;font-size:11px',
          r.ton + '  ' + r.kontrast);
      }
      const green = rows.filter(r => parseInt(r.ton) >= 90 && parseInt(r.ton) <= 180).length;
      console.log(`toplam ${rows.length} proje, ${new Set(rows.map(r => r.ton)).size} farklı ton, ${green} tanesi yeşil bandında`);
      return rows;
    }

    async function probe() {
      const orgs = await orgUuid();
      if (!orgs.length) return console.log('%c[proje] Organizasyon bulunamadı — giriş yapılı mı?', 'color:#c0392b');
      const org = orgs[0];
      const urls = [
        `/api/organizations/${org}/projects`,
        `/api/organizations/${org}/chat_conversations?limit=3`,
        `/api/organizations/${org}/tasks`
      ];
      for (const u of urls) {
        try {
          const j = await NET.get(u);
          const arr = listOf(j);
          const s = arr ? arr[0] : j;
          console.log('%c' + u, 'font-weight:bold;color:#2d7dff',
            arr ? `(dizi, ${arr.length} kayıt)` : '(tekil)');
          if (s && typeof s === 'object') {
            console.log('   alanlar:', Object.keys(s).join(', '));
            console.log('   proje benzeri:', Object.keys(s).filter(k => /project/i.test(k)).join(', ') || '— yok —');
            console.log(s);
          } else console.log('   ', j);
        } catch (e) {
          console.log('%c' + u, 'color:#888', 'başarısız:', e.message);
        }
      }
      console.log('%c[proje] Bellekte: ' + Object.keys(store.projects).length + ' proje, ' +
        Object.keys(store.chats).length + ' etiketli sohbet.', 'color:#2d7dff');
      return store;
    }

    return {
      listen, refresh, probe, save, color, palette, pullChat,
      projects: () => store.projects,
      chatProject: id => store.chats[id],

      /* Sohbet sayısı. exact=true ise API'nin kendi rakamı ya da tam
         çekilmiş bir liste; false ise elimizdeki kısmi listeden sayıldı. */
      countOf(pid) {
        const p = store.projects[pid];
        if (p && typeof p.apiCount === 'number') return { n: p.apiCount, exact: true };
        let n = 0;
        for (const k in store.chats) if (store.chats[k] === pid) n++;
        return { n, exact: !!store.complete };
      },
      isComplete: () => !!store.complete,
      yarimNedeni: () => store.yarim || null,
      isPinned: id => store.pins[id],
      setPinned(id, v) {
        if (!id || store.pins[id] === v) return false;
        store.pins[id] = !!v; save(); return true;
      },
      count: () => Object.keys(store.chats).length,
      set onChange(fn) { onChange = fn; },
      clear() { store = { at: 0, projects: {}, chats: {}, hues: {}, pins: {} }; colorCache.clear(); save(); }
    };
  })();

  /* Sohbet satırlarını bulmak hem rozet hem filtre modülünün işi; ortak. */
  const CHATDOM = {
    links() { return document.querySelectorAll('a[href*="/chat/"]'); },
    /* Ana listedeki sohbetler. Kenar çubuğundaki "Recents" bağlantıları DOM'da
       listeden önce geliyor; filtre şeridi oraya yerleşiyordu. Gezinme
       bölgeleri dışarıda tutulur. */
    listeLinkleri() {
      return [...document.querySelectorAll('a[href*="/chat/"]')]
        .filter(a => !a.closest('nav, aside, [role="navigation"], #claude-usage-hud'));
    },
    idOf(a) {
      const m = (a.getAttribute('href') || '').match(/\/chat\/([0-9a-zA-Z_-]{20,})/);
      return m ? m[1] : null;
    },
    // Sadece bu sohbete ait olan en büyük kapsayıcı = listedeki satır.
    rowOf(a) {
      let el = a;
      for (let i = 0; i < 8; i++) {
        const p = el.parentElement;
        if (!p || p === document.body) break;
        if (p.querySelectorAll('a[href*="/chat/"]').length > 1) return el;
        el = p;
      }
      return el;
    },
    onListPage() { return /^\/(recents|chats|tasks)/.test(location.pathname); },
    onProjectPage() { return /^\/project\//.test(location.pathname); },
    hasList() { return CHATDOM.onListPage() || CHATDOM.onProjectPage(); }
  };

  /* Birden fazla filtre aynı satırları gizliyor. Her biri kendi yordamını
     kaydediyor, görünürlük hepsinin kesişimi — biri diğerinin gizlemesini
     geri almıyor. */
  const ROWS = (function () {
    const CLS = 'csuite-row-off';
    const preds = new Map();
    let styled = false;

    function style() {
      if (styled) return;
      styled = true;
      const el = document.createElement('style');
      el.textContent = '.' + CLS + '{display:none!important;}';
      (document.head || document.documentElement).appendChild(el);
    }

    function each(fn) {
      for (const a of CHATDOM.listeLinkleri()) {
        const id = CHATDOM.idOf(a);
        if (id) fn(id, a, CHATDOM.rowOf(a));
      }
    }

    // skip: o filtreyi hesaba katma. Sayaçlar için gerekli — bir projenin
    // kaç sohbeti olduğunu gösterirken proje filtresinin kendisi sayılmamalı.
    function ok(id, a, skip) {
      for (const [k, fn] of preds) {
        if (k === skip) continue;
        if (!fn(id, a)) return false;
      }
      return true;
    }

    // Bir filtre değişince diğerleri sayaçlarını tazeleyebilsin.
    const subs = new Set();

    return {
      set(key, fn) { style(); preds.set(key, fn); },
      clear(key) { preds.delete(key); },
      sub(fn) { subs.add(fn); return () => subs.delete(fn); },
      ok, each,
      apply() {
        each((id, a, row) => row.classList.toggle(CLS, !ok(id, a)));
        for (const fn of [...subs]) { try { fn(); } catch (e) {} }
      },
      reset() { document.querySelectorAll('.' + CLS).forEach(n => n.classList.remove(CLS)); }
    };
  })();

  /* Filtre denetimleri tek bir şeritte toplanıyor; iki ayrı çubuk üst üste
     binmesin diye. Şerit taşınırken odak korunuyor: liste yeniden
     oluşturulduğunda arama kutusu taşınıyor ve yazarken odak kaybolurdu. */
  const TOOLBAR = (function () {
    const ID = 'csuite-toolbar';
    const sections = new Map();
    let host = null;

    function listContainer() {
      const first = CHATDOM.listeLinkleri()[0];
      if (!first) return null;
      const row = CHATDOM.rowOf(first);
      return row ? row.parentElement : null;
    }

    function ensure() {
      if (!sections.size) { if (host) { host.remove(); host = null; } return null; }
      const list = listContainer();
      if (!list || !list.parentElement) { if (host) { host.remove(); host = null; } return null; }
      if (host && host.parentElement === list.parentElement && host.nextElementSibling === list) {
        return host;
      }

      const active = document.activeElement;
      const keepFocus = host && host.contains(active);
      const caret = keepFocus && active.selectionStart != null ? active.selectionStart : null;

      if (host) host.remove();
      host = document.createElement('div');
      host.id = ID;
      host.style.cssText =
        'display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:0 0 10px 0;';
      list.parentElement.insertBefore(host, list);
      for (const s of [...sections.values()].sort((a, b) => a.order - b.order)) host.appendChild(s.el);

      if (keepFocus && active.isConnected) {
        active.focus();
        if (caret != null && active.setSelectionRange) {
          try { active.setSelectionRange(caret, caret); } catch (e) {}
        }
      }
      return host;
    }

    return {
      register(key, el, order) {
        if (sections.get(key) && sections.get(key).el === el) { ensure(); return; }
        sections.set(key, { el, order: order || 0 });
        if (host) host.remove();
        host = null;
        ensure();
      },
      unregister(key) {
        const s = sections.get(key);
        if (!s) return;
        if (s.el) s.el.remove();
        sections.delete(key);
        ensure();
      },
      has(key) { return sections.has(key); },
      tick() { ensure(); }
    };
  })();

  /* Türkçe arama için katlama: hem büyük/küçük hem aksan farkını siliyoruz,
     böylece "sarki" yazınca "Şarkı" da eşleşiyor. Sıra önemli — önce
     toLowerCase (İ → i + birleşen nokta), sonra ı → i, sonra NFD ile
     birleşen işaretleri at. */
  function fold(s) {
    return String(s || '')
      .toLowerCase()
      .replace(/ı/g, 'i')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  define({
    id: 'projectTags',
    label: 'Proje etiketi',
    desc: 'Chats ve Tasks listelerinde bir sohbet projeye aitse adını renkli bir rozetle gösterir. Veri sayfanın kendi isteklerinden okunur.',
    group: 'Gezinme',
    health() {
      const n = PROJ.count(), p = Object.keys(PROJ.projects()).length;
      const y = PROJ.yarimNedeni();
      const neden = y ? ' (' + (typeof y === 'object' ? _f(y.m, ...y.a) : y) + ')' : '';
      return { tamam: p > 0, metin: _f('{0} proje, {1} sohbet eşlemesi', p, n) + ' · ' + (PROJ.isComplete() ? _('liste tam') : _('liste eksik olabilir') + neden) };
    },
    on(ctx) {
      const CHIP = 'csp-chip';

      /* Sayfanın kendi stilleri rozeti eziyor (bütün rozetler aynı yeşile
         boyanıyordu), o yüzden görünümün tamamı !important önceliğiyle veriliyor.
         display:inline-block — inline-flex'te metin anonim bir flex öğesi olduğu
         için text-overflow:ellipsis çalışmıyor ve isimler üç nokta olmadan
         sertçe kesiliyordu.
         Genişlik ch değil px: box-sizing:border-box ile 18px'lik yatay dolgu
         genişliğin içinden yeniyor, 18ch metne ancak ~15 karakter bırakıyordu. */
      ctx.css(`
      .${CHIP}{display:inline-block!important;box-sizing:border-box!important;
        max-width:168px!important;overflow:hidden!important;
        text-overflow:ellipsis!important;white-space:nowrap!important;
        flex:0 0 auto!important;align-self:center!important;
        padding:2px 9px!important;border-radius:999px!important;
        vertical-align:middle!important;text-decoration:none!important;
        font:600 10.5px/1.45 "Open Sans","Segoe UI",system-ui,sans-serif!important;
        letter-spacing:.015em!important;
        box-shadow:inset 0 0 0 1px rgba(0,0,0,.08)!important;}`);
      function strip() {
        document.querySelectorAll('.' + CHIP).forEach(n => n.remove());
      }
      ctx.undo(strip);

      /* Rozetin yeri: satırın sağındaki "x minutes ago" damgasının hemen solu.
         Damganın seçicisi bilinmediği için metninden tanınıyor; İngilizce ve
         Türkçe göreli zaman biçimlerinin ikisi de kabul ediliyor. */
      const TIME_RE = new RegExp(
        '^\\s*(just now|now|yesterday|dün|az önce|şimdi|' +
        '\\d+\\s*(sec|second|min|minute|hour|day|week|month|year|' +
        'sn|saniye|dk|dakika|saat|gün|hafta|ay|yıl)s?\\.?' +
        '(\\s*(ago|önce|evvel))?)\\s*$', 'i');

      function leafTime(root) {
        const t = root.querySelector('time');
        if (t) return t;
        const els = root.querySelectorAll('span,div,p,small');
        for (let i = els.length - 1; i >= 0; i--) {   // sondan tara: en sağdaki
          const e = els[i];
          if (e.children.length) continue;
          if (e.classList.contains(CHIP)) continue;
          if (TIME_RE.test(e.textContent || '')) return e;
        }
        return null;
      }

      // Sohbet bağlantısından yukarı çıkıp zaman damgasını ara. Damga bazen
      // bağlantının içinde, bazen kardeş sütunda; ikisi de deneniyor. Başka bir
      // sohbetin bağlantısını kapsayan seviyeye çıkılmaz, yoksa rozet yanlış
      // satıra düşer.
      function timeFor(a) {
        let el = a;
        for (let i = 0; i < 6; i++) {
          const t = leafTime(el);
          if (t) return t;
          const p = el.parentElement;
          if (!p || p === document.body) break;
          if (p.querySelectorAll('a[href*="/chat/"]').length > 1) break;
          el = p;
        }
        return null;
      }

      function build(id, pid) {
        const p = PROJ.projects()[pid];
        const s = PROJ.color(pid);
        const chip = document.createElement('span');
        chip.className = CHIP;
        chip.dataset.pid = pid;
        chip.dataset.chat = id;
        chip.textContent = p ? p.name : _('Proje');
        chip.title = _('Proje') + ': ' + (p ? p.name : pid);
        chip.style.setProperty('background', s.bg, 'important');
        chip.style.setProperty('color', s.fg, 'important');
        return chip;
      }

      function decorate() {
        const wanted = new Map();
        for (const a of document.querySelectorAll('a[href*="/chat/"]')) {
          const m = (a.getAttribute('href') || '').match(/\/chat\/([0-9a-zA-Z_-]{20,})/);
          if (!m) continue;
          const pid = PROJ.chatProject(m[1]);
          if (pid) wanted.set(m[1], { pid, a });
        }

        // Artık geçersiz olan rozetleri kaldır
        for (const c of document.querySelectorAll('.' + CHIP)) {
          const w = wanted.get(c.dataset.chat);
          if (!w || c.dataset.pid !== w.pid) c.remove();
        }

        // Eksikleri yerleştir
        for (const [id, w] of wanted) {
          if (document.querySelector('.' + CHIP + '[data-chat="' + id + '"]')) continue;
          const chip = build(id, w.pid);
          const t = timeFor(w.a);
          if (t && t.parentElement) {
            chip.style.setProperty('margin', '0 10px 0 0', 'important');
            t.parentElement.insertBefore(chip, t);
          } else {
            chip.style.setProperty('margin', '0 0 0 6px', 'important');
            w.a.appendChild(chip);
          }
        }
      }

      PROJ.onChange = decorate;
      ctx.undo(() => { PROJ.onChange = null; });
      ctx.undo(PROJ.listen());

      let q = false;
      ctx.watch(document.body, { childList: true, subtree: true }, () => {
        if (q) return;
        q = true;
        requestAnimationFrame(() => { q = false; decorate(); });
      });

      // Liste sayfalarına girildiğinde veri tazeliğini kontrol et.
      let lastPath = '';
      ctx.every(() => {
        const p = location.pathname;
        if (p !== lastPath) {
          lastPath = p;
          if (CHATDOM.onListPage()) PROJ.refresh(false);
        }
        decorate();
      }, 1000);

      PROJ.refresh(false);
      decorate();
    }
  });

  define({
    id: 'projectFilter',
    parent: 'projectTags',
    label: 'Proje filtresi',
    desc: 'Chats listesinin üstüne proje rozetlerinden bir filtre çubuğu koyar. Bir projeye tıklayınca sadece o projenin sohbetleri kalır; "Projesiz" hiçbir projeye ait olmayanları gösterir.',
    group: 'Gezinme',
    on(ctx) {
      const KEY = 'project';

      ctx.css(`
      .cspf-chips{display:flex!important;flex-wrap:wrap!important;align-items:center!important;
        gap:6px!important;}
      .cspf-chips button{all:unset!important;box-sizing:border-box!important;
        display:inline-block!important;cursor:pointer!important;
        max-width:168px!important;overflow:hidden!important;
        text-overflow:ellipsis!important;white-space:nowrap!important;
        padding:3px 10px!important;border-radius:999px!important;
        font:600 10.5px/1.45 "Open Sans","Segoe UI",system-ui,sans-serif!important;
        letter-spacing:.015em!important;opacity:.45!important;
        transition:opacity .12s!important;}
      .cspf-chips button:hover{opacity:.8!important;}
      .cspf-chips button[aria-pressed="true"]{opacity:1!important;
        box-shadow:0 0 0 2px currentColor!important;}
      .cspf-count{font-weight:400!important;opacity:.75!important;}`);

      /* Filtre kalıcı DEĞİL: sayfa değişince sıfırlanıyor. Kalıcı olsaydı
         filtreyi açık unuttuğunda sohbetlerin kaybolduğunu sanırdın. */
      let mode = 'all';
      const chips = document.createElement('div');
      chips.className = 'cspf-chips';

      ROWS.set(KEY, id => {
        if (mode === 'all') return true;
        const pid = PROJ.chatProject(id);
        return mode === 'none' ? !pid : pid === mode;
      });
      ctx.undo(() => { ROWS.clear(KEY); ROWS.apply(); });
      ctx.undo(() => TOOLBAR.unregister('projectFilter'));
      // Başlık filtresi değişince rozet sayıları anında güncellensin.
      ctx.undo(ROWS.sub(() => render()));

      // Sayımlar diğer filtrelerden sonra: başlıkta arama yapıyorsan proje
      // sayıları da o aramaya göre daralıyor.
      function tally() {
        const counts = new Map();
        let none = 0, total = 0;
        ROWS.each((id, a) => {
          if (!ROWS.ok(id, a, KEY)) return;
          total++;
          const pid = PROJ.chatProject(id);
          if (!pid) { none++; return; }
          counts.set(pid, (counts.get(pid) || 0) + 1);
        });
        return { counts, none, total };
      }

      function chipBtn(label, count, colors, active, onClick) {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-pressed', active ? 'true' : 'false');
        b.textContent = label;
        if (count != null) {
          const c = document.createElement('span');
          c.className = 'cspf-count';
          c.textContent = '  ' + count;
          b.appendChild(c);
        }
        b.style.setProperty('background', colors.bg, 'important');
        b.style.setProperty('color', colors.fg, 'important');
        b.addEventListener('click', e => {
          e.preventDefault(); e.stopPropagation();
          onClick(); render(); ROWS.apply();
        });
        return b;
      }

      function neutral() {
        return isDark() ? { bg: 'rgb(72,70,66)', fg: '#f2f0ec' }
                        : { bg: 'rgb(228,225,217)', fg: '#2b2a28' };
      }

      // Gereksiz yeniden çizim yapma: her saniye DOM'u yenilemek hem
      // titretiyor hem de odağı çalabiliyor.
      let sig = '';

      function render() {
        const { counts, none, total } = tally();
        const named = [...counts.entries()]
          .map(([pid, n]) => ({ pid, n, name: (PROJ.projects()[pid] || {}).name || _('Proje') }))
          .sort((a, b) => a.name.localeCompare(b.name, 'tr'));

        const next = DIL.aktif() + '|' + mode + '|' + total + '|' + none + '|' +
          named.map(p => p.pid + ':' + p.n + ':' + p.name).join(',');
        if (next === sig) return;
        sig = next;

        chips.innerHTML = '';
        chips.appendChild(chipBtn(_('Tümü'), total, neutral(), mode === 'all', () => { mode = 'all'; }));
        if (none) {
          chips.appendChild(chipBtn(_('Projesiz'), none, neutral(), mode === 'none', () => { mode = 'none'; }));
        }
        for (const p of named) {
          chips.appendChild(chipBtn(p.name, p.n, PROJ.color(p.pid), mode === p.pid, () => {
            mode = mode === p.pid ? 'all' : p.pid;
          }));
        }
      }

      // Proje sayfasında tek proje var, rozet şeridi anlamsız.
      function place() {
        if (CHATDOM.onListPage()) TOOLBAR.register('projectFilter', chips, 10);
        else TOOLBAR.unregister('projectFilter');
      }

      let lastPath = location.pathname;
      ctx.every(() => {
        if (location.pathname !== lastPath) { lastPath = location.pathname; mode = 'all'; sig = ''; }
        place(); render(); ROWS.apply();
      }, 700);

      place(); render(); ROWS.apply();
    }
  });

  define({
    id: 'projectCounts',
    parent: 'projectTags',
    label: 'Projede sohbet sayısı',
    desc: 'Projeler sayfasında ve kenar çubuğunda her projenin kaç sohbeti olduğunu gösterir. Sayı kısmi listeden çıkarıldıysa ~ ile işaretlenir.',
    group: 'Gezinme',
    on(ctx) {
      const B = 'cspc-badge';

      ctx.css(`
      .${B}{display:inline-block!important;box-sizing:border-box!important;
        margin-left:6px!important;padding:1px 7px!important;
        border-radius:999px!important;vertical-align:middle!important;
        font:600 10px/1.5 "Open Sans","Segoe UI",system-ui,sans-serif!important;
        font-variant-numeric:tabular-nums!important;letter-spacing:.01em!important;
        white-space:nowrap!important;text-decoration:none!important;
        background:var(--cspc-bg)!important;color:var(--cspc-fg)!important;}`);

      function strip() { document.querySelectorAll('.' + B).forEach(n => n.remove()); }
      ctx.undo(strip);

      const idOf = a => {
        const m = (a.getAttribute('href') || '').match(/\/project\/([0-9a-zA-Z_-]{20,})/);
        return m ? m[1] : null;
      };

      /* Rozet, proje adını taşıyan öğenin sonuna giriyor. Kart düzeninde
         başlık ayrı bir çocuk; bulunamazsa bağlantının kendisine eklenir. */
      function slotFor(a) {
        const h = a.querySelector('h1,h2,h3,h4,[class*="title"],[class*="name"]');
        if (h && (h.textContent || '').trim()) return h;
        return a;
      }

      function decorate() {
        const live = new Set();

        for (const a of document.querySelectorAll('a[href*="/project/"]')) {
          const pid = idOf(a);
          if (!pid) continue;
          const info = PROJ.countOf(pid);
          // Hiç veri yoksa rozet basma: "0" yanlış izlenim verir.
          if (!info.n && !info.exact) continue;

          live.add(pid);
          const host = slotFor(a);
          let b = host.querySelector(':scope > .' + B);
          if (!b) {
            b = document.createElement('span');
            b.className = B;
            host.appendChild(b);
          }
          const label = (info.exact ? '' : '~') + info.n;
          if (b.textContent !== label) b.textContent = label;
          b.title = info.exact
            ? _f('{0} sohbet', info.n)
            : _f('En az {0} sohbet — liste tam çekilemedi, gerçek sayı daha yüksek olabilir', info.n);

          const c = PROJ.color(pid);
          b.style.setProperty('--cspc-bg', c.bg);
          b.style.setProperty('--cspc-fg', c.fg);
        }

        for (const b of document.querySelectorAll('.' + B)) {
          const a = b.closest('a[href*="/project/"]');
          if (!a || !live.has(idOf(a))) b.remove();
        }
      }

      ctx.undo(ROWS.sub(decorate));
      PROJ.refresh(false);

      let q = false;
      ctx.watch(document.body, { childList: true, subtree: true }, () => {
        if (q) return;
        q = true;
        requestAnimationFrame(() => { q = false; decorate(); });
      });
      ctx.every(decorate, 1000);
      decorate();
    }
  });

  define({
    id: 'titleFilter',
    label: 'Başlıkta arama',
    desc: 'Sohbet listelerinin ve proje sayfalarının üstüne bir arama kutusu koyar. Yazdıkça başlığa göre süzer. Birden çok kelime hepsini arar; başına - koyulan kelimeyi İÇERMEYENLERİ gösterir; tırnak içi birebir aranır.',
    group: 'Gezinme',
    health() {
      if (!CHATDOM.hasList()) return { tamam: true, metin: _('Liste ve proje sayfalarında çalışır') };
      const ok = !!document.querySelector('.cstf-box');
      return { tamam: ok, metin: ok ? _('Arama kutusu listenin üstünde') : _('Liste bulunamadı, kutu yerleşmedi') };
    },
    on(ctx) {
      const KEY = 'title';

      ctx.css(`
      .cstf-box{display:flex!important;align-items:center!important;gap:6px!important;
        box-sizing:border-box!important;padding:3px 4px 3px 10px!important;
        border-radius:2px!important;
        border:1px solid var(--border-300,rgba(127,127,127,.32))!important;}
      .cstf-box input{all:unset!important;box-sizing:border-box!important;
        width:190px!important;min-width:120px!important;
        font:400 12px/1.5 "Open Sans","Segoe UI",system-ui,sans-serif!important;
        color:inherit!important;}
      .cstf-box input::placeholder{opacity:.5!important;}
      .cstf-x{all:unset!important;cursor:pointer!important;
        width:18px!important;height:18px!important;text-align:center!important;
        border-radius:2px!important;opacity:.45!important;
        font:600 12px/18px "Open Sans","Segoe UI",system-ui,sans-serif!important;}
      .cstf-x:hover{opacity:1!important;background:rgba(127,127,127,.18)!important;}
      .cstf-n{font:400 11px/1.5 "Open Sans","Segoe UI",system-ui,sans-serif!important;
        opacity:.6!important;white-space:nowrap!important;padding-right:6px!important;}`);

      /* Sorgu dili
           kelime      -> başlık bunu İÇERMELİ
           -kelime     -> başlık bunu İÇERMEMELİ  (! de olur)
           "iki söz"   -> birebir öbek
         Birden çok terim VE ile bağlanır. */
      function parse(q) {
        const terms = [];
        const re = /([-!])?"([^"]*)"|([-!])?(\S+)/g;
        let m;
        while ((m = re.exec(q))) {
          const neg = !!(m[1] || m[3]);
          const raw = m[2] !== undefined ? m[2] : m[4];
          if (!raw) continue;
          const text = fold(raw);
          if (text) terms.push({ neg, text });
        }
        return terms;
      }

      let terms = [];

      // Rozet metni başlığa karışmasın diye onu atlayarak oku.
      function titleOf(a) {
        let out = '';
        (function walk(n) {
          if (n.nodeType === 3) { out += n.nodeValue; return; }
          if (n.nodeType !== 1) return;
          if (n.classList && (n.classList.contains('csp-chip') || n.classList.contains('cls-bu'))) return;
          for (const c of n.childNodes) walk(c);
        })(a);
        return out;
      }

      ROWS.set(KEY, (id, a) => {
        if (!terms.length) return true;
        const t = fold(titleOf(a));
        for (const term of terms) {
          const has = t.includes(term.text);
          if (term.neg ? has : !has) return false;
        }
        return true;
      });
      ctx.undo(() => { ROWS.clear(KEY); ROWS.apply(); });
      ctx.undo(() => TOOLBAR.unregister('titleFilter'));

      const box = document.createElement('div');
      box.className = 'cstf-box';
      UI_SELECTORS.add('.cstf-box');
      ctx.undo(() => UI_SELECTORS.delete('.cstf-box'));
      const input = document.createElement('input');
      input.type = 'text';
      input.spellcheck = false;
      input.autocomplete = 'off';
      input.placeholder = _('başlıkta ara…');
      input.setAttribute('aria-label', _('Başlıkta ara'));
      input.title = _('Birden çok kelime yazabilirsin. "-kelime" o kelimeyi içermeyenleri gösterir, tırnak içi birebir aranır.');
      const note = document.createElement('span');
      note.className = 'cstf-n';
      const clear = document.createElement('button');
      clear.type = 'button';
      clear.className = 'cstf-x';
      clear.textContent = '×';
      clear.title = _('Aramayı temizle');
      clear.setAttribute('aria-label', _('Aramayı temizle'));
      box.append(input, note, clear);

      function count() {
        let shown = 0, total = 0;
        ROWS.each((id, a) => { total++; if (ROWS.ok(id, a)) shown++; });
        return { shown, total };
      }

      function refresh() {
        terms = parse(input.value.trim());
        ROWS.apply();
        const { shown, total } = count();
        note.textContent = terms.length ? shown + ' / ' + total : '';
        clear.style.display = input.value ? '' : 'none';
      }

      input.addEventListener('input', refresh);
      input.addEventListener('keydown', e => {
        e.stopPropagation();          // Alt+P gibi kısayollar araya girmesin
        if (e.key === 'Escape') { input.value = ''; refresh(); }
      });
      clear.addEventListener('click', e => {
        e.preventDefault();
        input.value = '';
        refresh();
        input.focus();
      });

      function place() {
        if (CHATDOM.hasList()) TOOLBAR.register('titleFilter', box, 20);
        else TOOLBAR.unregister('titleFilter');
      }

      let lastPath = location.pathname;
      ctx.every(() => {
        if (location.pathname !== lastPath) {
          lastPath = location.pathname;
          input.value = '';
          terms = [];
        }
        place();
        TOOLBAR.tick();
        refresh();
      }, 700);

      place(); refresh();
    }
  });

  /* =====================================================================
   * 10) PROMPT ŞABLONLARI
   *
   * Palet: Alt+T ya da yazma kutusuna ";;" yazmak.
   * Yönetici: Alt+Shift+T, paletteki "Yönet", ya da paneldeki bağlantı.
   *
   * Arayüz gövde seviyesinde ortada pencere olarak açılır; yazma kutusuna
   * iliştirilmez. Veri 1.x ile aynı anahtarda durur (csuite:templates).
   * ===================================================================== */

  const TPL = (function () {
    const KEY = 'csuite:templates';
    const VARKEY = 'csuite:tplvars';

    const SEED = [{
      id: 'ornek',
      title: 'Örnek şablon',
      tags: ['örnek'],
      body: 'Merhaba {{isim}},\n\n{{konu|Konu}} hakkında yazıyorum.\n\nİyi çalışmalar.'
    }];

    function load() {
      try {
        const v = JSON.parse(localStorage.getItem(KEY));
        if (v && Array.isArray(v.templates)) return v.templates;
      } catch (e) {}
      return SEED.slice();
    }

    let list = load();

    function save() {
      try { localStorage.setItem(KEY, JSON.stringify({ schema: 1, templates: list })); } catch (e) {}
    }

    // Son girilen değişken değerleri; aynı alanı tekrar yazmak zorunda kalma.
    function lastVars() {
      try { return JSON.parse(localStorage.getItem(VARKEY)) || {}; } catch (e) { return {}; }
    }
    function rememberVars(o) {
      try {
        localStorage.setItem(VARKEY, JSON.stringify(Object.assign(lastVars(), o)));
      } catch (e) {}
    }

    const slug = s => fold(s).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40) || 'sablon';

    function uniqueId(base, skipIdx) {
      let id = base, n = 2;
      while (list.some((t, i) => t.id === id && i !== skipIdx)) id = base + '-' + n++;
      return id;
    }

    /* {{ad}} ya da {{ad|varsayılan}}. Aynı ad birden çok geçebilir,
       tek alan olarak sorulur. */
    const VAR_RE = /\{\{\s*([^|{}]+?)\s*(?:\|\s*([^{}]*?)\s*)?\}\}/g;

    function varsOf(body) {
      const out = [];
      const seen = new Set();
      let m;
      VAR_RE.lastIndex = 0;
      while ((m = VAR_RE.exec(body || ''))) {
        const name = m[1].trim();
        if (!name || seen.has(name)) continue;
        seen.add(name);
        out.push({ name, def: (m[2] || '').trim() });
      }
      return out;
    }

    function fill(body, values) {
      return String(body || '').replace(VAR_RE, (all, name, def) => {
        const k = name.trim();
        const v = values[k];
        return v !== undefined && v !== '' ? v : (def || '').trim();
      });
    }

    function exportJson() {
      return JSON.stringify({ schema: 1, exported: new Date().toISOString(), templates: list }, null, 2);
    }

    /* İçe aktarma birleştirir, üzerine yazmaz. Aynı kimlik varsa gövde
       farklıysa çakışma bildirilir; çağıran ne yapacağını sorar. */
    function parseImport(text) {
      let j;
      try { j = JSON.parse(text); } catch (e) { throw new Error(_n('Dosya geçerli JSON değil.')); }
      const arr = Array.isArray(j) ? j : (j && Array.isArray(j.templates) ? j.templates : null);
      if (!arr) throw new Error(_n('İçinde "templates" dizisi bulunamadı.'));
      const clean = [];
      for (const t of arr) {
        if (!t || typeof t !== 'object') continue;
        const title = String(t.title || t.name || '').trim();
        const body = String(t.body || t.text || t.content || '');
        if (!title && !body) continue;
        clean.push({
          id: String(t.id || slug(title)),
          title: title || '(başlıksız)',
          tags: Array.isArray(t.tags) ? t.tags.map(String) : [],
          body
        });
      }
      if (!clean.length) throw new Error(_n('Dosyada kullanılabilir şablon yok.'));
      const fresh = [], clash = [];
      for (const t of clean) {
        const cur = list.find(x => x.id === t.id);
        if (!cur) fresh.push(t);
        else if (cur.body !== t.body || cur.title !== t.title) clash.push(t);
      }
      return { fresh, clash, total: clean.length };
    }

    function applyImport(fresh, clash, mode) {
      for (const t of fresh) list.push(t);
      for (const t of clash) {
        const i = list.findIndex(x => x.id === t.id);
        if (mode === 'overwrite') list[i] = t;
        else if (mode === 'keepBoth') list.push(Object.assign({}, t, { id: uniqueId(t.id + '-yeni') }));
      }
      save();
    }

    return {
      all: () => list,
      get: id => list.find(t => t.id === id),
      add(t) {
        const item = Object.assign({ tags: [], body: '' }, t);
        item.id = uniqueId(item.id || slug(item.title || ''));
        list.push(item);
        save();
        return item;
      },
      update(idx, t) {
        if (!list[idx]) return;
        list[idx] = Object.assign({}, list[idx], t);
        if (!list[idx].id) list[idx].id = uniqueId(slug(list[idx].title));
        save();
      },
      remove(idx) { list.splice(idx, 1); save(); },
      varsOf, fill, lastVars, rememberVars,
      exportJson, parseImport, applyImport, save,
      reload() { list = load(); }
    };
  })();

  const SABLON_CSS = `
      .ara{display:flex;align-items:center;gap:8px;padding:10px 12px;border-bottom:1px solid var(--ayirici);color:var(--metin-ikincil)}
      .ara input{all:unset;flex:1;font:400 14px/1.5 var(--yazi);color:var(--metin)}
      .ara input::placeholder{color:var(--metin-ikincil)}
      .lst{padding:4px 0}
      .oge{display:block;padding:8px 12px;cursor:pointer;border-left:2px solid transparent}
      .oge:hover{background:var(--ana-hover)}
      .oge.sec{background:var(--ana-acik);border-left-color:var(--ana)}
      .oge .bas{display:flex;align-items:center;gap:6px;font-weight:600;color:var(--metin)}
      .oge .on{margin-top:2px;font-size:12px;color:var(--metin-ikincil);display:-webkit-box;-webkit-box-orient:vertical;
        -webkit-line-clamp:2;overflow:hidden}
      .rozet{font:600 10.5px/1.6 var(--yazi);padding:0 6px;border-radius:var(--kose-s);background:var(--ana-acik);color:var(--metin)}
      .form{padding:12px;display:grid;gap:10px}
      .form-bas{font:600 14px/1.3 var(--yazi)}
      .eylem-sira{display:flex;flex-wrap:wrap;gap:8px;padding:10px 12px;border-bottom:1px solid var(--ayirici)}
      .form .eylem-sira{padding:4px 0 0;border:0}
      .onay-serit{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:10px 12px;background:var(--uyari-bg);border-bottom:1px solid var(--ayirici)}
      .onay-serit span{flex:1;min-width:160px}
      .form label{display:grid;gap:4px;font:600 12px/1.4 var(--yazi)}
      .not{font-size:12px;color:var(--metin-ikincil)}
      .satir{display:flex;align-items:center;gap:8px;padding:8px 12px;border-bottom:1px solid var(--ayirici)}
      .satir .ad{flex:1;min-width:0}
      .satir .ad b{display:block;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .satir .ad span{display:block;font-size:11.5px;color:var(--metin-ikincil);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .sayac{font-size:12px;color:var(--metin-ikincil);font-variant-numeric:tabular-nums}`;

  /* Satır içi onay: kabın en üstünde soru + düğmeler. Ayrı pencere açmaz. */
  /* İlk seçenek her zaman "vazgeç" anlamındadır: odak ondadır, Esc onu seçer, yerine yeni
     onay gelirse eskisi onunla kapanır (söz asılı kalmaz). Geri alınamaz seçenek
     { tur: 'tehlike' } ile kırmızı çerçeveli, ana renkli değil. */
  function satirIciOnay(kap, metin, secenekler) {
    return new Promise(resolve => {
      const eski = kap.querySelector(':scope > .onay-serit');
      if (eski && eski._iptal) eski._iptal(); else if (eski) eski.remove();
      const s = document.createElement('div');
      s.className = 'onay-serit';
      s.setAttribute('role', 'alertdialog');
      const m = document.createElement('span');
      m.textContent = metin;
      s.appendChild(m);
      let bitti = false;
      const sec = d => { if (bitti) return; bitti = true; s.remove(); resolve(d); };
      s._iptal = () => sec(secenekler[0].deger);
      secenekler.forEach((o, i) => {
        const tur = o.tur || (i === secenekler.length - 1 ? 'ana' : '');
        const d = dugme(o.metin, o.harf, tur);
        d.addEventListener('click', () => sec(o.deger));
        s.appendChild(d);
      });
      s.addEventListener('keydown', e => {
        if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); s._iptal(); }
      });
      kap.prepend(s);
      const ilk = s.querySelector('.dg');
      if (ilk) ilk.focus();
    });
  }

  // Kısayol, komut paleti ve panel için köprü; modül kapalıyken null.
  const TPLUI = { palet: null, yonetici: null, sec: null, sayfa: null };

  define({
    id: 'promptTemplates',
    label: 'Prompt şablonları',
    desc: 'Sık kullandığın promptlar. Yazma kutusuna ";;" yazınca da açılır. {{değişken}} alanları seçince sorulur.',
    group: 'Yazma',
    kisayol: 'sablon',
    health() { return { tamam: true, metin: _f('{0} şablon kayıtlı', TPL.all().length) }; },
    on(ctx) {
      const TETIK = ';;';
      let kirpilacak = 0;

      /* ---- yazma kutusuna ekleme ----
         ProseMirror'a innerHTML yazmak React durumunu bozar; insertText satır
         sonlarını tek paragrafa sıkıştırabilir. Yapıştırma olayı paragrafları
         doğru kurar; tutmazsa insertText'e düşülür. */
      const editor = () => document.querySelector('div.ProseMirror[contenteditable="true"]');

      // İmlecin hemen önündeki metin (yalnız metin düğümündeyse).
      function onceki() {
        const s = window.getSelection();
        if (!s || !s.focusNode || s.focusNode.nodeType !== 3) return '';
        return (s.focusNode.textContent || '').slice(0, s.focusOffset);
      }

      function ekle(metin) {
        const kir = kirpilacak;
        kirpilacak = 0;                          // sayaç her durumda sıfırlanır; ikinci eklemeye taşınmaz
        const ed = editor();
        if (!ed) return false;
        ed.focus();
        // ";;" yalnız imlecin hemen önündeyse silinir; imleç başka yerdeyse metne dokunulmaz.
        if (kir && onceki().endsWith(TETIK.slice(0, kir))) for (let i = 0; i < kir; i++) document.execCommand('delete', false);
        let ok = false;
        try {
          const dt = new DataTransfer();
          dt.setData('text/plain', metin);
          ok = !ed.dispatchEvent(new ClipboardEvent('paste', { clipboardData: dt, bubbles: true, cancelable: true }));
        } catch (e) { ok = false; }
        if (!ok) { try { ok = document.execCommand('insertText', false, metin); } catch (e) { ok = false; } }
        return ok;
      }

      async function bitir(metin) {
        if (ekle(metin)) return;
        const k = await panoyaYaz(metin);
        bildir(k ? _('Yazma kutusu bulunamadı. Metin panoya kopyalandı.') : _('Yazma kutusu bulunamadı. Bir sohbet aç ve yeniden dene.'), k ? 'uyari' : 'hata');
      }

      function eslesen(q) {
        const hepsi = TPL.all();
        if (!q) return hepsi;
        const terimler = fold(q).split(/\s+/).filter(Boolean);
        return hepsi.filter(t => {
          const yer = fold(t.title + ' ' + (t.tags || []).join(' ') + ' ' + t.body);
          return terimler.every(x => yer.includes(x));
        });
      }

      /* ---- palet ---- */
      function palet(baslangic) {
        let sec = 0, sonuc = [];
        const w = pencereAc({
          baslik: _('Prompt şablonları'), genislik: 620, ust: '14vh', css: SABLON_CSS,
          kapaninca: () => { kirpilacak = 0; }   // kapatılırsa ;; yazılı kalır
        });
        const ara = document.createElement('div');
        ara.className = 'ara';
        ara.innerHTML = ikon('ara');
        const inp = document.createElement('input');
        inp.type = 'text';
        inp.placeholder = _('Şablon ara…');
        inp.setAttribute('aria-label', _('Şablon ara'));
        inp.value = baslangic || '';
        ara.appendChild(inp);
        const govde = document.createElement('div');
        govde.className = 'p-govde lst';
        govde.setAttribute('role', 'listbox');
        const alt = document.createElement('div');
        alt.className = 'p-alt';
        const yonet = dugme(_('Yönet'), null, 'hayalet');
        yonet.addEventListener('click', () => yonetici());
        const bos = document.createElement('span'); bos.className = 'bosluk';
        const sayac = document.createElement('span'); sayac.className = 'sayac';
        const kbd = document.createElement('span'); kbd.className = 'kbd'; kbd.textContent = _('↑↓ seç · Enter ekle · Esc kapat');
        alt.append(yonet, bos, kbd, sayac);
        w.p.append(ara, govde, alt);
        w.p.style.height = 'min(520px, 72vh)';

        function ciz() {
          sonuc = eslesen(inp.value.trim());
          if (sec >= sonuc.length) sec = Math.max(0, sonuc.length - 1);
          govde.innerHTML = '';
          if (!sonuc.length) {
            const b = document.createElement('div');
            b.className = 'bos';
            const bb = document.createElement('b');
            bb.textContent = TPL.all().length ? _('Eşleşen şablon yok') : _('Henüz şablon yok');
            b.append(bb, document.createTextNode(TPL.all().length ? _('Başka bir kelime dene.') : _('Yönet ile ekle ya da JSON içe aktar.')));
            govde.appendChild(b);
          }
          sonuc.forEach((t, i) => {
            const o = document.createElement('div');
            o.className = 'oge' + (i === sec ? ' sec' : '');
            o.setAttribute('role', 'option');
            o.setAttribute('aria-selected', i === sec ? 'true' : 'false');
            const bas = document.createElement('div');
            bas.className = 'bas';
            bas.append(document.createTextNode(t.title));
            for (const tag of (t.tags || []).slice(0, 3)) {
              const r = document.createElement('span'); r.className = 'rozet'; r.textContent = tag; bas.appendChild(r);
            }
            const nv = TPL.varsOf(t.body).length;
            if (nv) { const r = document.createElement('span'); r.className = 'rozet'; r.textContent = _f('{0} alan', nv); bas.appendChild(r); }
            const on = document.createElement('div');
            on.className = 'on';
            on.textContent = t.body.replace(/\s+/g, ' ').slice(0, 180);
            o.append(bas, on);
            o.addEventListener('mouseenter', () => { sec = i; isaretle(); });
            o.addEventListener('click', () => sec_(t));
            govde.appendChild(o);
          });
          sayac.textContent = sonuc.length + ' / ' + TPL.all().length;
        }
        function isaretle() {
          govde.querySelectorAll('.oge').forEach((o, i) => {
            o.classList.toggle('sec', i === sec);
            o.setAttribute('aria-selected', i === sec ? 'true' : 'false');
          });
          const c = govde.querySelectorAll('.oge')[sec];
          if (c) c.scrollIntoView({ block: 'nearest' });
        }
        inp.addEventListener('input', () => { sec = 0; ciz(); });
        inp.addEventListener('keydown', e => {
          if (e.key === 'ArrowDown') { e.preventDefault(); sec = Math.min(sec + 1, sonuc.length - 1); isaretle(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); sec = Math.max(sec - 1, 0); isaretle(); }
          else if (e.key === 'Enter') { e.preventDefault(); if (sonuc[sec]) sec_(sonuc[sec]); }
        });
        ciz();
        inp.focus();
      }

      function sec_(t) {
        const vars = TPL.varsOf(t.body);
        if (!vars.length) { const k = kirpilacak; aktifPencere && aktifPencere.kapat(); kirpilacak = k; bitir(t.body); return; }
        degiskenFormu(t, vars);
      }

      /* ---- değişken formu ---- */
      function degiskenFormu(t, vars) {
        const k = kirpilacak;
        const son = TPL.lastVars();
        const w = pencereAc({ baslik: t.title, genislik: 480, css: SABLON_CSS, kapaninca: () => { kirpilacak = 0; } });
        kirpilacak = k;
        const form = document.createElement('div');
        form.className = 'p-govde form';
        const girdiler = vars.map(v => {
          const lab = document.createElement('label');
          lab.textContent = v.name;
          const inp = document.createElement('input');
          inp.className = 'girdi';
          inp.type = 'text';
          inp.placeholder = v.def || '';
          inp.value = son[v.name] || '';
          inp.dataset.ad = v.name;
          lab.appendChild(inp);
          form.appendChild(lab);
          return inp;
        });
        const alt = document.createElement('div');
        alt.className = 'p-alt';
        const geri = dugme(_('Geri'), { tr: 'G', en: 'B' }, 'hayalet');
        geri.addEventListener('click', () => { const kk = kirpilacak; palet(); kirpilacak = kk; });
        const bos = document.createElement('span'); bos.className = 'bosluk';
        const ekleD = dugme(_('Ekle'), { tr: 'E', en: 'I' }, 'ana');
        alt.append(geri, bos, ekleD);
        w.p.append(basBolum(t.title), form, alt);

        function gonder() {
          const degerler = {};
          for (const inp of girdiler) degerler[inp.dataset.ad] = inp.value;
          TPL.rememberVars(degerler);
          const kk = kirpilacak;
          w.kapat();
          kirpilacak = kk;
          bitir(TPL.fill(t.body, degerler));
        }
        ekleD.addEventListener('click', gonder);
        form.addEventListener('keydown', e => {
          if (e.key !== 'Enter') return;
          e.preventDefault();
          const i = girdiler.indexOf(e.composedPath()[0]);
          if (e.ctrlKey || e.metaKey || i === girdiler.length - 1) gonder();
          else if (girdiler[i + 1]) girdiler[i + 1].focus();
        });
        w.p.addEventListener('keydown', e => harfKisayolu(w.p, e));
        if (girdiler[0]) girdiler[0].focus();
      }

      /* ---- yönetim: liste ve düzenleme ----
         Aynı çizici iki yerde çalışır: kendi penceresinde (Alt+Shift+T) ve
         Ayarlar › Şablonlar sayfasında. Onaylar ayrı pencere açmaz (Ayarlar
         kapanmasın diye); listenin üstünde satır içi sorulur. */
      function yonetimListesi(kap, mesaj, git) {
        kap.innerHTML = '';
        const ust = document.createElement('div');
        ust.className = 'eylem-sira';
        const yeni = dugme(_('Yeni şablon'), 'N', 'ana');
        yeni.addEventListener('click', () => git.duzenle(-1));
        const ice = dugme(_('İçe aktar'), { tr: 'E', en: 'I' }, '', 'yukle');
        ice.addEventListener('click', () => iceAktar(kap, git));
        const disa = dugme(_('Dışa aktar'), { tr: 'D', en: 'X' }, '', 'indir');
        disa.addEventListener('click', () => {
          indir('claude-sablonlar-' + tarihKod(Date.now()) + '.json', TPL.exportJson(), 'application/json');
          bildir(_f('{0} şablon dışa aktarıldı', TPL.all().length), 'basari');
        });
        ust.append(yeni, ice, disa);
        kap.appendChild(ust);
        if (mesaj) {
          const n = document.createElement('div');
          n.className = 'not';
          n.style.padding = '8px 12px';
          n.setAttribute('role', 'status');
          n.textContent = mesaj;
          kap.appendChild(n);
        }
        if (!TPL.all().length) {
          const b = document.createElement('div');
          b.className = 'bos';
          const bb = document.createElement('b'); bb.textContent = _('Henüz şablon yok');
          b.append(bb, document.createTextNode(_('Yeni şablon ile başla ya da JSON içe aktar.')));
          kap.appendChild(b);
        }
        TPL.all().forEach((t, i) => {
          const s = document.createElement('div');
          s.className = 'satir';
          const ad = document.createElement('div');
          ad.className = 'ad';
          const b = document.createElement('b'); b.textContent = t.title;
          const sp = document.createElement('span');
          const nv = TPL.varsOf(t.body).length;
          sp.textContent = [(t.tags || []).join(', '), nv ? _f('{0} alan', nv) : ''].filter(Boolean).join(' · ') || _('etiketsiz');
          ad.append(b, sp);
          const du = dugme(_('Düzenle'), null, 'kucuk');
          du.addEventListener('click', () => git.duzenle(i));
          const si = dugme(_('Sil'), null, 'kucuk hayalet');
          si.setAttribute('aria-label', _f('"{0}" şablonunu sil', t.title));
          si.addEventListener('click', async () => {
            const ok = await satirIciOnay(kap, _f('"{0}" silinecek. Bu geri alınamaz.', t.title),
              [{ metin: _('Vazgeç'), harf: { tr: 'V', en: 'C' }, deger: false }, { metin: _('Sil'), harf: { tr: 'S', en: 'D' }, deger: true, tur: 'tehlike' }]);
            if (ok) { TPL.remove(i); git.liste(_f('"{0}" silindi', t.title)); } else git.liste();
          });
          s.append(ad, du, si);
          kap.appendChild(s);
        });
        return yeni;
      }

      function duzenleFormu(kap, i, git) {
        kap.innerHTML = '';
        const cur = i >= 0 ? TPL.all()[i] : { title: '', tags: [], body: '' };
        const form = document.createElement('div');
        form.className = 'form';
        const h = document.createElement('div');
        h.className = 'form-bas';
        h.textContent = i >= 0 ? _('Şablonu düzenle') : _('Yeni şablon');
        form.appendChild(h);
        const alan = (ad, el) => { const l = document.createElement('label'); l.textContent = ad; l.appendChild(el); form.appendChild(l); return el; };
        const tIn = alan(_('Başlık'), Object.assign(document.createElement('input'), { className: 'girdi', value: cur.title }));
        const gIn = alan(_('Etiketler (virgülle)'), Object.assign(document.createElement('input'), { className: 'girdi', value: (cur.tags || []).join(', '), placeholder: _('iş, fatura') }));
        const bIn = alan(_('Gövde'), Object.assign(document.createElement('textarea'), { className: 'girdi', value: cur.body, placeholder: _('Merhaba {{isim}}, …') }));
        bIn.style.minHeight = '180px';
        const bilgi = document.createElement('div');
        bilgi.className = 'not';
        bilgi.setAttribute('aria-live', 'polite');
        const yenile = () => {
          const v = TPL.varsOf(bIn.value);
          bilgi.textContent = v.length
            ? _('Değişkenler') + ': ' + v.map(x => x.name + (x.def ? ' (' + _('varsayılan') + ': ' + x.def + ')' : '')).join(', ')
            : _('Değişken eklemek için {{ad}} ya da {{ad|varsayılan}} yaz. Ctrl+Enter kaydeder.');
        };
        yenile();
        bIn.addEventListener('input', yenile);
        form.appendChild(bilgi);
        const sira = document.createElement('div');
        sira.className = 'eylem-sira';
        const vaz = dugme(_('Vazgeç'), { tr: 'V', en: 'C' }, 'hayalet');
        let kirli = false;
        form.addEventListener('input', () => { kirli = true; });
        vaz.addEventListener('click', async () => {
          if (kirli && !(await satirIciOnay(form, _('Değişiklikler kaydedilmedi. Atılsın mı?'),
            [{ metin: _('Düzenlemeye dön'), harf: { tr: 'D', en: 'B' }, deger: false }, { metin: _('Değişiklikleri at'), harf: 'A', deger: true, tur: 'tehlike' }]))) return;
          git.liste();
        });
        const kay = dugme(_('Kaydet'), { tr: 'K', en: 'S' }, 'ana');
        function kaydet() {
          const baslik = tIn.value.trim();
          if (!baslik) { bilgi.textContent = _('Başlık boş olamaz. Bir başlık yaz.'); tIn.focus(); return; }
          const veri = { title: baslik, tags: gIn.value.split(',').map(x => x.trim()).filter(Boolean), body: bIn.value };
          if (i >= 0) TPL.update(i, veri); else TPL.add(veri);
          git.liste(_f('"{0}" kaydedildi', baslik));
        }
        kay.addEventListener('click', kaydet);
        form.addEventListener('keydown', e => {
          if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); kaydet(); return; }
          // Düzenleme formunda tek harf kısayolu çalışmaz (yanlışlıkla Vazgeç / Kaydet olmasın).
          if (e.key.length === 1 && !e.ctrlKey && !e.altKey && !e.metaKey) e.stopPropagation();
        });
        sira.append(kay, vaz);
        form.appendChild(sira);
        kap.appendChild(form);
        tIn.focus();
      }

      async function iceAktar(kap, git) {
        const f = await dosyaSec('application/json,.json');
        if (!f) return;
        let r;
        try { r = TPL.parseImport(f.metin); } catch (e) { git.liste(_('İçe aktarılamadı.') + ' ' + _(e.message)); return; }
        let kip = 'skip';
        if (r.clash.length) {
          kip = await satirIciOnay(kap, _f('{0} şablon zaten var ve içeriği farklı. Ne yapılsın?', r.clash.length),
            [{ metin: _('Vazgeç'), harf: { tr: 'V', en: 'C' }, deger: null }, { metin: _('İkisini sakla'), harf: { tr: 'S', en: 'K' }, deger: 'keepBoth', tur: 'ana' },
              { metin: _('Üzerine yaz'), harf: { tr: 'Ü', en: 'O' }, deger: 'overwrite', tur: 'tehlike' }]);
          if (!kip) { git.liste(_('İçe aktarma iptal edildi')); return; }
        }
        TPL.applyImport(r.fresh, r.clash, kip);
        git.liste(_f('{0} yeni şablon eklendi', r.fresh.length) +
          (r.clash.length ? ', ' + (kip === 'overwrite' ? _f('{0} güncellendi', r.clash.length) : _f('{0} kopya olarak eklendi', r.clash.length)) : ''));
      }

      /* Ayarlar sayfası ya da pencere: kap içinde liste ↔ düzenleme. */
      function yonetimKur(kap) {
        const git = {
          // Liste yeniden çizilince odak gövdeye düşmesin (Esc ve harf kısayolları çalışsın).
          liste: m => { const y = yonetimListesi(kap, m, git); if (y && kap.isConnected) y.focus(); },
          duzenle: i => duzenleFormu(kap, i, git)
        };
        return git;
      }

      function yonetici() {
        // ";;" ile açılan paletten gelindiyse sayaç korunur (Palete dön → seç ";;"yi siler).
        const k = kirpilacak;
        const w = pencereAc({ baslik: _('Şablon yöneticisi'), genislik: 620, css: SABLON_CSS });
        kirpilacak = k;
        const govde = document.createElement('div');
        govde.className = 'p-govde';
        govde.style.maxHeight = '64vh';
        const alt = document.createElement('div');
        alt.className = 'p-alt';
        const bos = document.createElement('span'); bos.className = 'bosluk';
        const pal = dugme(_('Palete dön'), 'P', 'hayalet');
        pal.addEventListener('click', () => palet());
        alt.append(bos, pal);
        w.p.append(basBolum(_('Şablon yöneticisi')), govde, alt);
        w.p.addEventListener('keydown', e => harfKisayolu(w.p, e));
        const git = yonetimKur(govde);
        git.liste();
        const y = govde.querySelector('.dg.ana');
        if (y) y.focus();
      }

      TPLUI.palet = b => { kirpilacak = 0; palet(b); };
      TPLUI.yonetici = () => { kirpilacak = 0; yonetici(); };
      TPLUI.sayfa = kap => yonetimKur(kap).liste();
      TPLUI.sec = sec_;
      ctx.undo(() => { TPLUI.palet = null; TPLUI.yonetici = null; TPLUI.sec = null; TPLUI.sayfa = null; });

      ctx.action({ id: 'tpl-palet', ad: 'Şablon paleti', grup: 'Yazma', kisayol: 'sablon', calistir: () => palet() });
      ctx.action({ id: 'tpl-yonet', ad: 'Şablon yöneticisi', grup: 'Yazma', kisayol: 'sablonYonet', calistir: () => yonetici() });

      // ";;" tetikleyicisi: karakterler zaten yazıldı, ekleme sırasında silinir.
      ctx.on(document, 'input', e => {
        const ed = e.target;
        if (!ed.classList || !ed.classList.contains('ProseMirror')) return;
        if (aktifPencere) return;
        // Yalnız ";" yazılınca; silme, geri alma ya da yapıştırma tetiklemez.
        if (e.inputType && e.inputType !== 'insertText') return;
        if (e.data != null && e.data !== ';') return;
        if (!onceki().endsWith(TETIK)) return;
        kirpilacak = TETIK.length;
        palet();
      }, true);
    }
  });

  /* =====================================================================
   * 11) BAŞLIK KODU (seçim 2B: renkli kod ızgarası)
   *
   * Başlık biçimi: KOD Kısa konu YYYY-MMDD (ör. APP Claude Suite 2026-1015).
   * Kod listesi panelden düzenlenir. Kaydetme claude.ai'nin kendi yeniden
   * adlandırma ucuyla yapılır; olmazsa yeni başlık panoya kopyalanır.
   * ===================================================================== */

  const KOD_VARSAYILAN = [
    'İş: ZMASH, ZMASH-S, ZMASH-E, ZMASH-K, OLYMPOS, MARS, Finans, HUKUK',
    'Teknik: APP, HTML, SCRIPT, 3DP',
    'Kişisel: GRK, SRP, TARİF, KURAL',
    'İçerik: STORY, POST'
  ].join('\n');
  const GRUP_RENK = ['kat-onemli', 'kat-kod', 'kat-oyun', 'kat-belge', 'kat-tablo', 'kat-video', 'kat-gorsel', 'kat-arsiv'];

  const BASLIK = {
    gruplar(metin) {
      if (metin === undefined) metin = ayarOku('baslikKodlari', KOD_VARSAYILAN);
      const gr = [];
      String(metin).split('\n').forEach(satir => {
        const m = satir.match(/^\s*([^:]+):\s*(.+)$/);
        if (!m) return;
        const kodlar = m[2].split(',').map(x => x.trim()).filter(Boolean);
        if (kodlar.length) gr.push({ ad: m[1].trim(), renk: GRUP_RENK[gr.length % GRUP_RENK.length], kodlar });
      });
      return gr;
    },
    kodlar(metin) { return this.gruplar(metin).flatMap(g => g.kodlar.map(k => ({ kod: k, grup: g }))); },
    kacis: s => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'),
    desen() {
      const kodlar = this.kodlar().map(k => this.kacis(k.kod)).sort((a, b) => b.length - a.length);
      if (!kodlar.length) return null;
      // Alt kodlar da geçerli: HUKUK-RUHSAT gibi.
      return new RegExp('^(' + kodlar.join('|') + ')((?:-[A-Za-zÇĞİÖŞÜçğıöşü0-9]+)?) (.+) (\\d{4}-\\d{4})$');
    },
    uyarMi(baslik) { const d = this.desen(); return !!(d && d.test(String(baslik || '').trim())); },
    coz(baslik, varsayilanTarih) {
      const t = String(baslik || '').trim();
      const d = this.desen();
      const m = d && t.match(d);
      if (m) return { kod: m[1] + m[2], konu: m[3], tarih: m[4] };
      // Biçime uymayan başlıktan en iyi tahmin: sondaki tarih ve baştaki bilinen kod ayıklanır.
      let konu = t, tarih = varsayilanTarih, kod = '';
      const tm = konu.match(/\s+(\d{4})-(\d{2})(\d{2})?$/);
      if (tm) { konu = konu.slice(0, tm.index); if (tm[3]) tarih = tm[1] + '-' + tm[2] + tm[3]; }
      const ilk = konu.split(/\s+/)[0] || '';
      const bilinen = this.kodlar().find(k => k.kod.toLocaleUpperCase('tr') === ilk.toLocaleUpperCase('tr'));
      if (bilinen) { kod = bilinen.kod; konu = konu.slice(ilk.length).trim(); }
      return { kod, konu, tarih };
    },
    grupRengi(kod) {
      const k = this.kodlar().find(x => kod === x.kod || kod.startsWith(x.kod + '-'));
      return k ? k.grup.renk : 'kat-arsiv';
    }
  };

  const BASLIKUI = { ac: null };

  define({
    id: 'titleCode',
    label: 'Başlık kodu',
    desc: 'Sohbet başlığını KOD Konu YYYY-MMDD biçiminde düzenler. Kodlar renkli ızgarada. Başlığın yanındaki çipe tıkla.',
    group: 'Yazma',
    kisayol: 'baslik',
    health() { return BASLIK._durum || { tamam: true, metin: _('Sohbet sayfasında çalışır') }; },
    on(ctx) {
      const CHIP = 'cls-kod-cip';

      ctx.css(`
      .${CHIP}{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:4px;height:22px;
        padding:0 7px;margin-left:6px;border-radius:2px;cursor:pointer;vertical-align:middle;flex:none;
        font:600 11px/22px "Open Sans","Segoe UI",system-ui,sans-serif;color:${TOKEN.ortak['ana-uzeri']};white-space:nowrap}
      .${CHIP}:focus-visible{outline:2px solid ${TOKEN.ortak.ana};outline-offset:2px}
      .${CHIP}.bos{background:transparent!important;color:inherit;border:1px dashed currentColor;opacity:.6}
      .${CHIP}.bos:hover{opacity:1}`);

      let ad = null, olusma = null, sonId = null;

      async function bilgiAl(taze) {
        const id = suankiSohbet();
        if (!id) { ad = null; return null; }
        try {
          const v = await sohbetAgaci(id, taze);
          ad = v.sohbet && v.sohbet.name || '';
          olusma = v.sohbet && v.sohbet.created_at ? Date.parse(v.sohbet.created_at) : null;
          return v;
        } catch (e) {
          ad = (document.title || '').replace(/\s*[-–|]\s*Claude\s*$/i, '').trim();
          if (/^claude$/i.test(ad)) ad = '';
          gunluk('titleCode', 'sohbet okunamadı: ' + e.message);
          return null;
        }
      }

      // Başlık metnini taşıyan düğme: sayfanın üst bandında, metni sohbet adı olan öğe.
      function baslikOgesi() {
        if (!ad) return null;
        const adaylar = document.querySelectorAll('header button, header [role="button"], main button, button[aria-haspopup="menu"]');
        for (const el of adaylar) {
          const r = el.getBoundingClientRect();
          if (r.top > 140 || !r.width) continue;
          const t = (el.textContent || '').trim();
          if (t === ad || (t.startsWith(ad) && t.length - ad.length < 4)) return el;
        }
        return null;
      }

      function cipYerlestir() {
        const id = suankiSohbet();
        if (!id) { document.querySelectorAll('.' + CHIP).forEach(n => n.remove()); BASLIK._durum = null; return; }
        const hedef = baslikOgesi();
        let cip = document.querySelector('.' + CHIP);
        if (!hedef) {
          if (cip) cip.remove();
          BASLIK._durum = ad
            ? { tamam: false, metin: _f('Başlık bulunamadı; çip yerleşmedi. {0} çalışır.', KISAYOL.tus('baslik')) }
            : ad === ''
              ? { tamam: true, metin: _('Sohbetin henüz adı yok; claude.ai adlandırınca çip gelir') }
              : { tamam: false, metin: _('Sohbet adı okunamadı') };
          return;
        }
        const c = BASLIK.coz(ad, null);
        const uygun = BASLIK.uyarMi(ad);
        if (!cip || cip.previousElementSibling !== hedef) {
          if (cip) cip.remove();
          cip = document.createElement('button');
          cip.type = 'button';
          cip.className = CHIP;
          cip.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); ac(); });
          hedef.insertAdjacentElement('afterend', cip);
        }
        const etiket = uygun ? c.kod : _('Kod');
        if (cip.textContent !== etiket) cip.textContent = etiket;
        cip.classList.toggle('bos', !uygun);
        cip.style.background = uygun ? TEMA.vars()[BASLIK.grupRengi(c.kod)] : '';
        cip.title = uygun ? _('Başlığı düzenle') + ' (' + KISAYOL.tus('baslik') + ')' : _('Başlık biçime uymuyor. Düzenlemek için tıkla') + ' (' + KISAYOL.tus('baslik') + ')';
        cip.setAttribute('aria-label', cip.title);
        BASLIK._durum = { tamam: true, metin: _('Başlık çipi yerleşti') + ' · ' + (uygun ? _('biçime uygun') : _('biçime uymuyor')) };
      }
      ctx.undo(() => { document.querySelectorAll('.' + CHIP).forEach(n => n.remove()); BASLIK._durum = null; });

      const CSS = `
      .izgara{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;padding:12px 12px 6px}
      .kod{all:unset;box-sizing:border-box;height:32px;display:flex;align-items:center;justify-content:center;
        border-radius:var(--kose-s);color:var(--ana-uzeri);font:600 12px/1 var(--yazi);cursor:pointer;overflow:hidden;
        text-overflow:ellipsis;white-space:nowrap;padding:0 4px}
      .kod:hover{filter:brightness(1.1)}
      .kod:focus-visible{outline:2px solid var(--vurgu);outline-offset:2px}
      .kod.sec{outline:2px solid var(--metin);outline-offset:1px}
      .lejant{display:flex;gap:12px;flex-wrap:wrap;padding:0 12px 10px;font-size:11px;color:var(--metin-ikincil)}
      .lejant span{display:inline-flex;align-items:center;gap:4px}
      .lejant i{width:10px;height:10px;border-radius:var(--kose-s);display:inline-block}
      .alanlar{display:grid;grid-template-columns:120px minmax(0,1fr) 110px;gap:8px;padding:0 12px 10px}
      .alanlar label{display:grid;gap:4px;font:600 11px/1.4 var(--yazi);color:var(--metin-ikincil)}
      .onizleme{margin:0 12px 12px;padding:8px 10px;background:var(--ana-acik);border-radius:var(--kose-s);font-size:12px}
      .onizleme b{font-weight:600;color:var(--metin)}
      .hata{margin:0 12px 10px;font-size:12px;color:var(--hata)}`;

      async function ac() {
        const id = suankiSohbet();
        if (!id) { bildir(_('Önce bir sohbet aç. Başlık kodu sohbet sayfasında çalışır.'), 'uyari'); return; }
        await bilgiAl(false);
        const bugun = tarihKod(Date.now());
        const c = BASLIK.coz(ad || '', olusma ? tarihKod(olusma) : bugun);
        let secili = c.kod;

        const w = pencereAc({ baslik: _('Başlığı düzenle'), genislik: 600, css: CSS });
        const izg = document.createElement('div');
        izg.className = 'izgara';
        izg.setAttribute('role', 'listbox');
        izg.setAttribute('aria-label', _('Başlık kodları'));
        const v = TEMA.vars();
        const kodlar = BASLIK.kodlar();
        for (const k of kodlar) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'kod' + (k.kod === secili ? ' sec' : '');
          b.textContent = k.kod;
          b.title = k.grup.ad + ' · ' + k.kod;
          b.style.background = v[k.grup.renk];
          b.setAttribute('role', 'option');
          b.addEventListener('click', () => { secili = k.kod; kodIn.value = k.kod; isaretle(); onizle(); konuIn.focus(); });
          izg.appendChild(b);
        }
        const lej = document.createElement('div');
        lej.className = 'lejant';
        for (const g of BASLIK.gruplar()) {
          const s = document.createElement('span');
          s.innerHTML = `<i style="background:${v[g.renk]}"></i>`;
          s.appendChild(document.createTextNode(g.ad));
          lej.appendChild(s);
        }
        const alan = document.createElement('div');
        alan.className = 'alanlar';
        const mk = (etiket, deger, ph) => {
          const l = document.createElement('label');
          l.textContent = etiket;
          const i = document.createElement('input');
          i.className = 'girdi';
          i.value = deger || '';
          if (ph) i.placeholder = ph;
          l.appendChild(i);
          alan.appendChild(l);
          return i;
        };
        const kodIn = mk(_('Kod'), secili, _('seç'));
        const konuIn = mk(_('Kısa konu'), c.konu, 'Claude Suite');
        const tarihIn = mk(_('Tarih'), c.tarih || bugun, 'YYYY-MMDD');
        const oniz = document.createElement('div');
        oniz.className = 'onizleme';
        const hata = document.createElement('div');
        hata.className = 'hata';
        hata.hidden = true;

        const alt = document.createElement('div');
        alt.className = 'p-alt';
        const bugunD = dugme(_('Bugünün tarihi'), 'T', 'hayalet');
        bugunD.addEventListener('click', () => { tarihIn.value = bugun; onizle(); });
        const bos = document.createElement('span'); bos.className = 'bosluk';
        const vaz = dugme(_('Vazgeç'), { tr: 'V', en: 'C' }, 'hayalet');
        vaz.addEventListener('click', () => w.kapat());
        const kay = dugme(_('Kaydet'), { tr: 'K', en: 'S' }, 'ana');
        alt.append(bugunD, bos, vaz, kay);

        const yeniAd = () => [kodIn.value.trim(), konuIn.value.trim().replace(/\s+/g, ' '), tarihIn.value.trim()].filter(Boolean).join(' ');
        function isaretle() {
          izg.querySelectorAll('.kod').forEach(b => {
            const on = b.textContent === secili;
            b.classList.toggle('sec', on);
            b.setAttribute('aria-selected', on ? 'true' : 'false');
          });
        }
        function onizle() {
          secili = kodIn.value.trim();
          isaretle();
          oniz.textContent = _('Yeni başlık') + ': ';
          oniz.appendChild(document.createElement('b'));
          oniz.querySelector('b').textContent = yeniAd() || '—';
          const uygun = BASLIK.uyarMi(yeniAd());
          hata.hidden = uygun;
          hata.textContent = uygun ? '' : _('Biçim: KOD Kısa konu YYYY-MMDD. Kod listede olmalı, tarih 2026-1015 gibi yazılmalı.');
          kay.disabled = !konuIn.value.trim();
        }
        [kodIn, konuIn, tarihIn].forEach(i => i.addEventListener('input', onizle));
        alan.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); kaydet(); } });
        izg.addEventListener('keydown', e => {
          const bs = [...izg.querySelectorAll('.kod')];
          const i = bs.indexOf(e.composedPath()[0]);
          if (i < 0) return;
          const git = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: 5, ArrowUp: -5 }[e.key];
          if (git) { e.preventDefault(); const h = bs[Math.max(0, Math.min(bs.length - 1, i + git))]; h.focus(); }
        });

        async function kaydet() {
          const yeni = yeniAd();
          if (!konuIn.value.trim()) { konuIn.focus(); return; }
          if (yeni === ad) { w.kapat(); return; }
          kay.disabled = true;
          try {
            await orgIle(o => NET.put(`/api/organizations/${o}/chat_conversations/${id}`, { name: yeni }));
            const eski = ad;
            ad = yeni;
            SOHBET_ONBELLEK.delete(id);
            metniDegistir(eski, yeni);
            w.kapat();
            bildir(_f('Başlık değişti: {0}', yeni), 'basari');
            cipYerlestir();
          } catch (e) {
            gunluk('titleCode', 'yeniden adlandırma: ' + e.message);
            const k = await panoyaYaz(yeni);
            w.kapat();
            bildir(_f('Başlık değiştirilemedi ({0}).', e.message) + ' ' +
              (k ? _('Yeni başlık panoya kopyalandı; claude.ai menüsünden Rename ile yapıştır.') : _('claude.ai menüsünden Rename ile değiştir.')), 'hata');
          }
        }
        kay.addEventListener('click', kaydet);

        w.p.append(basBolum(_('Başlığı düzenle')), izg, lej, alan, hata, oniz, alt);
        w.p.addEventListener('keydown', e => harfKisayolu(w.p, e));
        onizle();
        (konuIn.value ? (izg.querySelector('.kod.sec') || konuIn) : konuIn).focus();
      }

      // Sayfadaki eski başlık metinlerini yenisiyle değiştir (kenar çubuğu, üst band).
      function metniDegistir(eski, yeni) {
        if (!eski) return;
        const w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        const hedefler = [];
        for (let n = w.nextNode(); n; n = w.nextNode()) if (n.nodeValue.trim() === eski) hedefler.push(n);
        for (const n of hedefler) n.nodeValue = n.nodeValue.replace(eski, yeni);
        if (document.title.includes(eski)) document.title = document.title.replace(eski, yeni);
      }

      BASLIKUI.ac = ac;
      ctx.undo(() => { BASLIKUI.ac = null; });
      ctx.action({ id: 'baslik-duzenle', ad: 'Başlığı düzenle', grup: 'Yazma', kisayol: 'baslik', calistir: ac });

      /* Yeni sohbetin adı ilk birkaç saniye boş gelir; claude.ai adı sonra koyar.
         Ad boşken ya da başlık öğesi eski adla bulunamıyorsa kayıt tazelenir. */
      let sonTazeleme = 0, bulunamadi = 0;
      ctx.every(() => {
        const id = suankiSohbet();
        if (id !== sonId) { sonId = id; ad = null; bulunamadi = 0; sonTazeleme = Date.now(); if (id) bilgiAl(false).then(cipYerlestir); else cipYerlestir(); return; }
        if (!id) return;
        if (ad) { cipYerlestir(); bulunamadi = BASLIK._durum && BASLIK._durum.tamam ? 0 : bulunamadi + 1; }
        const bekle = ad ? 10000 : 4000;
        if ((!ad || bulunamadi >= 3) && Date.now() - sonTazeleme > bekle) {
          sonTazeleme = Date.now(); bulunamadi = 0;
          bilgiAl(true).then(cipYerlestir);
        }
      }, 1200);
    }
  });

  define({
    id: 'titleCheck',
    parent: 'titleCode',
    label: 'Biçime uymayanları işaretle',
    desc: 'Sohbet listelerinde KOD Konu YYYY-MMDD biçimine uymayan başlıkların yanına uyarı işareti koyar.',
    group: 'Yazma',
    health() {
      const n = document.querySelectorAll('.cls-bu').length;
      return CHATDOM.links().length ? { tamam: true, metin: _f('{0} başlık biçime uymuyor', n) } : { tamam: true, metin: _('Sohbet listesi görünmüyor') };
    },
    on(ctx) {
      const B = 'cls-bu';
      ctx.css(`
      .${B}{display:inline-flex!important;align-items:center!important;margin-left:6px!important;vertical-align:middle!important;
        color:var(--cls-uyari)!important;flex:none!important}
      .${B} svg{width:14px!important;height:14px!important}`);
      ctx.undo(() => document.querySelectorAll('.' + B).forEach(n => n.remove()));

      function metin(a) {
        let out = '';
        (function walk(n) {
          if (n.nodeType === 3) { out += n.nodeValue; return; }
          if (n.nodeType !== 1) return;
          if (n.classList && (n.classList.contains('csp-chip') || n.classList.contains(B) || n.classList.contains('cspc-badge'))) return;
          for (const c of n.childNodes) walk(c);
        })(a);
        // Satır bağlantısı göreli zamanı da içerebiliyor ("18 minutes ago"); başlıktan ayıklanır.
        return out.replace(/\s+/g, ' ').trim()
          .replace(/\s*(just now|yesterday|dün|az önce|şimdi|\d+\s*(sec|second|min|minute|hour|day|week|month|year|sn|saniye|dk|dakika|saat|gün|hafta|ay|yıl)s?\.?\s*(ago|önce)?)\s*$/i, '')
          .trim();
      }

      function isle() {
        document.documentElement.style.setProperty('--cls-uyari', TEMA.vars().uyari);
        for (const a of CHATDOM.links()) {
          if (a.closest('#claude-usage-hud')) continue;
          const t = metin(a);
          const var_ = a.querySelector(':scope .' + B);
          const uymaz = t && !BASLIK.uyarMi(t);
          if (uymaz && !var_) {
            const s = document.createElement('span');
            s.className = B;
            s.innerHTML = ikon('uyari', 14);
            s.title = _('Başlık biçime uymuyor: KOD Konu YYYY-MMDD');
            s.setAttribute('aria-label', s.title);
            const ilk = a.querySelector('span,div') || a;
            ilk.appendChild(s);
          } else if (!uymaz && var_) var_.remove();
        }
      }
      ctx.undo(() => document.documentElement.style.removeProperty('--cls-uyari'));

      let q = false;
      ctx.watch(document.body, { childList: true, subtree: true, characterData: true }, () => {
        if (q) return;
        q = true;
        setTimeout(() => { q = false; isle(); }, 400);
      });
      isle();
    }
  });

  /* =====================================================================
   * 12) MESAJ SAATLERİ (seçim 3A: mesajın altında)
   *
   * Saat claude.ai'nin kendi sohbet kaydından gelir (created_at). DOM'a düğüm
   * eklenmez: mesaj kutusuna bir data özniteliği yazılır, saat CSS ::after
   * ile çizilir. React yeniden çizse bile sayfa bozulmaz.
   * Eşleme sondan yapılır: uzun sohbette üstteki mesajlar geç yüklenirse
   * son mesajlar yine doğru saati alır.
   * ===================================================================== */

  const SAATLER = { durum: null };

  define({
    id: 'messageTimes',
    label: 'Mesaj saatleri',
    desc: 'Her mesajın altına gönderildiği saati yazar. Bugünden eskiyse tarih de yazar.',
    group: 'Bilgi',
    health() { return SAATLER.durum || { tamam: true, metin: _('Sohbet sayfasında çalışır') }; },
    on(ctx) {
      const OZ = 'data-cls-saat';
      const USER = '[data-testid="user-message"]';
      const AI = '[data-testid="assistant-message"], .font-claude-response, .font-claude-message';

      const stil = ctx.css('');
      function stilYaz() {
        // Saat claude.ai'nin kendi ikincil yazı tonunda: sayfanın parçası gibi durur.
        const renk = isDark() ? '#A5A29A' : '#6B6862';
        stil.textContent = `
        [${OZ}]::after{content:attr(${OZ});display:block;margin-top:6px;font:400 11px/1.4 "Open Sans","Segoe UI",system-ui,sans-serif;
          font-variant-numeric:tabular-nums;color:${renk};letter-spacing:.01em;text-align:left}
        ${USER}[${OZ}]::after{font-weight:400!important;color:${renk}!important}`;
      }
      stilYaz();
      ctx.undo(TEMA.degisince(stilYaz));
      ctx.undo(() => document.querySelectorAll('[' + OZ + ']').forEach(n => n.removeAttribute(OZ)));

      function dis(nodes) { return nodes.filter(n => !nodes.some(m => m !== n && m.contains(n))); }

      const yaz = ts => (ayniGun(ts, Date.now()) ? '' : tarihKisa(ts) + ' ') + saatYaz(ts);

      let veri = null, sonId = null, sonCekim = 0, bekleyen = null;

      /* Eşleme içerikle yapılır. claude.ai uzun sohbette yalnız ekranda görünen
         mesajları çiziyor (2.0.0 tanı raporu: kayıtta 23 + 23, sayfada 2 + 2).
         Sondan eşlemek kaydırınca yanlış saat yazardı. Her mesaj kutusunun
         metni kayıttaki metinle karşılaştırılır; eşleşmeyen kutu komşusundan
         sırayla çıkarılır; hiç ipucu yoksa saat yazılmaz. */
      const sade = t => fold(t || '').replace(/[^a-z0-9]+/g, '');
      const ESIK = 24;

      function benzer(ds, as) {
        if (!ds || !as) return false;
        if (ds.length < 12 || as.length < 12) return ds === as;
        const k = ds.slice(0, ESIK), ka = as.slice(0, ESIK);
        return as.includes(k) || ds.includes(ka);
      }

      function eslestir(domlar, api) {
        const sonuc = new Array(domlar.length).fill(-1);
        let bas = 0, icerikle = 0;
        domlar.forEach((d, i) => {
          const ds = sade(d.textContent);
          for (let j = bas; j < api.length; j++) {
            if (benzer(ds, api[j].s)) { sonuc[i] = j; bas = j + 1; icerikle++; return; }
          }
        });
        for (let i = 0; i < domlar.length; i++) {         // ileri doldur
          if (sonuc[i] >= 0 || i === 0 || sonuc[i - 1] < 0) continue;
          const j = sonuc[i - 1] + 1;
          if (j < api.length && !sonuc.includes(j)) sonuc[i] = j;
        }
        for (let i = domlar.length - 2; i >= 0; i--) {    // geri doldur
          if (sonuc[i] >= 0 || sonuc[i + 1] < 1) continue;
          const j = sonuc[i + 1] - 1;
          if (!sonuc.includes(j)) sonuc[i] = j;
        }
        if (!icerikle && domlar.length === api.length) for (let i = 0; i < domlar.length; i++) sonuc[i] = i;
        return { sonuc, icerikle };
      }

      let sadeOnbellek = null;
      function apiListe() {
        if (sadeOnbellek && sadeOnbellek.veri === veri) return sadeOnbellek;
        const ins = [], yan = [];
        for (const m of veri.dal) (insanMi(m) ? ins : yan).push({ m, s: sade(mesajMetni(m)) });
        sadeOnbellek = { veri, ins, yan };
        return sadeOnbellek;
      }

      function uygula() {
        const id = suankiSohbet();
        if (!id || !veri) return;
        const { ins, yan } = apiListe();
        const uDom = dis([...document.querySelectorAll(USER)]);
        const aDom = dis([...document.querySelectorAll(AI)]).filter(n => !n.closest(USER));
        let yazilan = 0, icerikle = 0, bos = 0;
        const es = (domlar, api) => {
          const r = eslestir(domlar, api);
          icerikle += r.icerikle;
          domlar.forEach((d, i) => {
            const k = r.sonuc[i];
            const m = k >= 0 ? api[k].m : null;
            if (!m || !m.created_at) { bos++; if (d.hasAttribute(OZ)) d.removeAttribute(OZ); return; }
            const s = yaz(Date.parse(m.created_at));
            if (d.getAttribute(OZ) !== s) d.setAttribute(OZ, s);
            yazilan++;
          });
        };
        es(uDom, ins);
        es(aDom, yan);
        SAATLER.durum = {
          tamam: yazilan > 0 || (!uDom.length && !aDom.length),
          metin: _f('Kayıtta {0} + {1} mesaj · sayfada {2} + {3}', ins.length, yan.length, uDom.length, aDom.length) + ' · ' +
            _f('{0} saat yazıldı ({1} metinle eşleşti', yazilan, icerikle) + (bos ? ', ' + _f('{0} eşleşmedi', bos) : '') + ')'
        };
        // Yeni mesaj gelmiş olabilir: eşleşmeyen kutu varsa kayıt seyrek aralıkla tazelenir.
        if (bos && Date.now() - sonCekim > 15000) cek(true);
      }

      function cek(taze) {
        const id = suankiSohbet();
        if (!id) return;
        const simdi = Date.now();
        if (taze && simdi - sonCekim < 4000) {
          if (!bekleyen) bekleyen = setTimeout(() => { bekleyen = null; cek(true); }, 4000 - (simdi - sonCekim));
          return;
        }
        sonCekim = simdi;
        sohbetAgaci(id, taze).then(v => {
          if (suankiSohbet() !== id) return;
          veri = v;
          uygula();
        }).catch(e => {
          SAATLER.durum = { tamam: false, metin: _f('Sohbet kaydı okunamadı: {0}', e.message) };
          gunluk('messageTimes', e.message);
        });
      }
      ctx.undo(() => { clearTimeout(bekleyen); SAATLER.durum = null; });

      let q = false;
      ctx.watch(document.body, { childList: true, subtree: true }, () => {
        if (q) return;
        q = true;
        setTimeout(() => { q = false; uygula(); }, 700);
      });
      ctx.every(() => {
        const id = suankiSohbet();
        if (id !== sonId) { sonId = id; veri = null; if (id) cek(true); else SAATLER.durum = null; }
      }, 800);
    }
  });

  /* =====================================================================
   * 13) MARKDOWN'A AKTAR
   * Açık sohbetin görünen dalını .md dosyası yapar. Kişi adı yazılmaz:
   * konuşmacılar "Kullanıcı" ve "Claude".
   * ===================================================================== */

  async function markdownAktar() {
    const id = suankiSohbet();
    if (!id) { bildir(_('Önce bir sohbet aç. Aktarma sohbet sayfasında çalışır.'), 'uyari'); return; }
    let v;
    try { v = await sohbetAgaci(id, true); }
    catch (e) { bildir(_f('Sohbet okunamadı ({0}). Sayfayı yenileyip yeniden dene.', e.message), 'hata'); return; }
    const ad = (v.sohbet && v.sohbet.name) || _('Sohbet');
    const uzun = ts => tarihKisa(ts) + ' ' + new Date(ts).getFullYear() + ' ' + saatYaz(ts);
    const satir = [];
    satir.push('# ' + ad, '');
    satir.push('- ' + _('Sohbet') + ': https://claude.ai/chat/' + id);
    if (v.dal.length) satir.push('- ' + _('Aralık') + ': ' + uzun(Date.parse(v.dal[0].created_at)) + ' → ' + uzun(Date.parse(v.dal[v.dal.length - 1].created_at)));
    satir.push('- ' + _('Mesaj') + ': ' + v.dal.length, '- ' + _('Dışa aktarıldı') + ': ' + uzun(Date.now()) + ' · ' + UYGULAMA_ADI + ' ' + SURUM, '', '---', '');
    for (const m of v.dal) {
      satir.push('## ' + (insanMi(m) ? _('Kullanıcı') : 'Claude') + ' · ' + (m.created_at ? uzun(Date.parse(m.created_at)) : ''), '');
      const ekler = [...(m.attachments || []), ...(m.files || []), ...(m.files_v2 || [])]
        .map(f => f && (f.file_name || f.name)).filter(Boolean);
      if (ekler.length) satir.push(ekler.map(e => '> ' + _('Ek') + ': ' + e).join('\n'), '');
      satir.push(mesajMetni(m).trim() || '_(' + _('metin yok') + ')_', '');
    }
    const dosya = ad.replace(/[\\/:*?"<>|]+/g, '-').replace(/\s+/g, ' ').trim().slice(0, 120) + '.md';
    indir(dosya, satir.join('\n'), 'text/markdown;charset=utf-8');
    bildir(_f('{0} mesaj aktarıldı: {1}', v.dal.length, dosya), 'basari');
  }

  define({
    id: 'exportMarkdown',
    label: 'Markdown\'a aktar',
    desc: 'Açık sohbeti saatleriyle birlikte .md dosyası olarak indirir. Ayarlardan, komut paletinden ya da kısayolla.',
    group: 'Araçlar',
    kisayol: 'markdown',
    health() { return { tamam: true, metin: suankiSohbet() ? _('Bu sohbet aktarılabilir') : _('Sohbet sayfasında çalışır') }; },
    on(ctx) {
      ctx.action({ id: 'md', ad: 'Sohbeti Markdown\'a aktar', grup: 'Araçlar', kisayol: 'markdown', calistir: markdownAktar });
    }
  });

  /* =====================================================================
   * 14) AYARLARI TAŞI
   * Bütün Claude Suite ayarları tek JSON dosyası. Üç makine arasında taşınır.
   * ===================================================================== */

  const AYAR_ONEKLERI = ['claude-suite:', 'csuite:', 'cuhud_', 'cwf:'];

  function ayarAnahtarlari() {
    const out = [];
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && AYAR_ONEKLERI.some(p => k.startsWith(p))) out.push(k);
      }
    } catch (e) {}
    return out.sort();
  }

  function ayarlarDisaAktar() {
    const anahtarlar = {};
    for (const k of ayarAnahtarlari()) anahtarlar[k] = localStorage.getItem(k);
    const govde = { uygulama: UYGULAMA_ID, surum: SURUM, tarih: new Date().toISOString(), anahtarlar };
    indir('claude-suite-ayarlar-' + tarihKod(Date.now()) + '.json', JSON.stringify(govde, null, 2), 'application/json');
    bildir(_f('{0} ayar dışa aktarıldı', Object.keys(anahtarlar).length), 'basari');
  }

  /* kap verilirse (Ayarlar › Hakkında) onay satır içi sorulur; Ayarlar kapanmaz.
     Yoksa (komut paleti) onay kendi penceresinde. */
  async function ayarlarIceAktar(kap) {
    const f = await dosyaSec('application/json,.json');
    if (!f) return;
    let j;
    try { j = JSON.parse(f.metin); } catch (e) { bildir(_('Dosya okunamadı. Claude Suite ayar dosyası seç.'), 'hata'); return; }
    if (!j || j.uygulama !== UYGULAMA_ID || !j.anahtarlar || typeof j.anahtarlar !== 'object') {
      bildir(_('Bu dosya Claude Suite ayar dosyası değil. "claude-suite-ayarlar-…json" dosyasını seç.'), 'hata');
      return;
    }
    const gecerli = Object.entries(j.anahtarlar).filter(([k, v]) => AYAR_ONEKLERI.some(p => k.startsWith(p)) && typeof v === 'string');
    const metin = _f('{0} ayar yüklenecek ({1} sürümünden, {2}).', gecerli.length, j.surum || '?', String(j.tarih || '').slice(0, 10)) + '\n' +
      _('Bu makinedeki ayarların yerine geçer. Sonra sayfa yenilenir.');
    const secenekler = [{ metin: _('Vazgeç'), harf: { tr: 'V', en: 'C' }, deger: false }, { metin: _('Yükle ve yenile'), harf: { tr: 'Y', en: 'L' }, deger: true }];
    const tamam = kap && kap.isConnected
      ? await satirIciOnay(kap, metin, secenekler)
      : await onayla({ baslik: _('Ayarları içe aktar'), metin, secenekler });
    if (!tamam) return;
    for (const [k, v] of gecerli) { try { localStorage.setItem(k, v); } catch (e) {} }
    location.reload();
  }

  /* =====================================================================
   * 15) TANI RAPORU
   * Her özelliğin sayfada neyi bulduğu. Bir şey çalışmazsa bu rapor yeter.
   * ===================================================================== */

  function saglik(m) {
    if (m._err) return { tamam: false, metin: _f('Açılamadı: {0}', m._err) };
    if (!effective(m.id)) return { tamam: null, metin: _('Kapalı') };
    if (!m._live) return { tamam: null, metin: _('Sayfa yüklenince başlar') };
    try { return m.health ? m.health() : { tamam: true, metin: _('Çalışıyor') }; }
    catch (e) { return { tamam: false, metin: _f('Durum okunamadı: {0}', e.message) }; }
  }

  function taniRaporu() {
    const satir = [UYGULAMA_ADI + ' ' + SURUM + ' · ' + _('tasarım dili') + ' ' + TEMA_SURUM, _('Tarih') + ': ' + new Date().toISOString(),
      _('Sayfa') + ': ' + location.pathname.replace(/[0-9a-f]{8}-[0-9a-f-]{27}/gi, '<id>'),
      _('Tarayıcı') + ': ' + navigator.userAgent, ...ortamSatirlari(), ''];
    for (const m of MODULES) {
      const s = saglik(m);
      const isaret = s.tamam === null ? '·' : s.tamam ? '✓' : '✗';
      satir.push(isaret + ' ' + _(m.label) + ' — ' + s.metin);
      if (s.tamam === false && Array.isArray(s.ayrinti)) for (const a of s.ayrinti) satir.push('    ' + a);
    }
    if (GUNLUK.length) {
      satir.push('', _('Günlük') + ':');
      for (const g of GUNLUK.slice(-20)) satir.push(new Date(g.t).toTimeString().slice(0, 8) + ' ' + g.kaynak + ': ' + g.metin);
    }
    return satir.join('\n');
  }


  // Tanı ve kabul testi raporunun ortak üst bilgisi.
  function ortamSatirlari() {
    const yon = (() => { try { return typeof GM_info !== 'undefined' && GM_info ? (GM_info.scriptHandler || 'userscript') + ' ' + (GM_info.version || '') : _('bilinmiyor'); } catch (e) { return _('bilinmiyor'); } })();
    const tema = { site: _('claude.ai\'yi izler'), acik: _('Açık'), koyu: _('Koyu') }[ayarOku('tema', 'site')] || _('claude.ai\'yi izler');
    const dilSec = { tr: 'Türkçe', en: 'English', sistem: _('Tarayıcı dili') }[DIL.secim()];
    return [
      _('Betik yöneticisi') + ': ' + yon.trim(),
      _('Dil') + ': ' + dilSec + ' → ' + DIL.aktif() + ' · ' + _('Tema') + ': ' + tema + ' → ' + (TEMA.koyuMu() ? _('koyu') : _('açık')) +
        ' · ' + _('Ölçek') + ': ' + yuzde(olcek()),
      _('Kısayollar') + ': ' + (KISAYOL.degismisMi()
        ? KISAYOL.LISTE.filter(k => KISAYOL.tus(k.id) !== k.varsayilan).map(k => _(k.ad) + ' = ' + (KISAYOL.tus(k.id) || '—')).join(', ')
        : _('varsayılan'))
    ];
  }

  /* =====================================================================
   * 15a) KABUL TESTİ (masaüstündeki kabul_testi_windows.bat'ın karşılığı)
   * Otomatik denetimler + elle bakılacaklar listesi. Rapor panoya kopyalanır;
   * kullanıcı sohbete yapıştırır.
   * ===================================================================== */

  async function kabulTesti() {
    const sonuc = [];
    const ekle = (ok, ad, ayrinti) => sonuc.push((ok === null ? '·' : ok ? '✓' : '✗') + ' ' + ad + (ayrinti ? ' — ' + ayrinti : ''));
    const bs = baslikSurumu();
    ekle(bs ? bs === SURUM : null, _('Sürüm betik başlığıyla aynı'), SURUM + (bs && bs !== SURUM ? ' ≠ ' + bs : ''));
    let yaz = false;
    try { const k = 'claude-suite:kabul'; localStorage.setItem(k, '1'); yaz = localStorage.getItem(k) === '1'; localStorage.removeItem(k); } catch (e) {}
    ekle(yaz, _('Ayar deposu yazılabiliyor'));
    ekle(!!document.getElementById('aalabs-cls-dugme'), _('CLS düğmesi sayfada'));
    const yazi = document.fonts && [...document.fonts].some(f => /Open Sans/i.test(f.family) && f.status === 'loaded');
    ekle(yazi ? true : null, _('Open Sans yüklendi'), yazi ? '' : _('yedek yazı tipi kullanılıyor'));
    let org = null;
    try { org = await orgUuid(); } catch (e) {}
    ekle(!!org, _('claude.ai hesabına ulaşıldı'), org ? '' : _('giriş yapılı mı?'));
    const ceviriEksik = KISAYOL.LISTE.filter(k => EN[k.ad] === undefined).length + MODULES.filter(m => EN[m.label] === undefined).length;
    ekle(ceviriEksik === 0, _('İngilizce çeviri eksiksiz'), ceviriEksik ? _f('{0} eksik', ceviriEksik) : '');
    const cak = [];
    for (const k of KISAYOL.LISTE) { const t = KISAYOL.tus(k.id); if (t && KISAYOL.LISTE.some(x => x.id !== k.id && KISAYOL.tus(x.id) === t)) cak.push(t); }
    ekle(!cak.length, _('Kısayollar çakışmıyor'), cak.join(', '));
    for (const m of MODULES) {
      const s = saglik(m);
      ekle(s.tamam, _(m.label), s.metin);
    }
    const elle = [
      _('CLS düğmesine tıkla: Ayarlar açılıyor mu?'),
      _f('{0} ve Ctrl+, Ayarlar\'ı açıyor mu?', KISAYOL.tus('ayarlar')),
      _f('{0} dili değiştiriyor mu; Ayarlar ve sayfadaki yazılar yenilenmeden çevriliyor mu?', KISAYOL.tus('dil')),
      _('Ayarlar › Genel › Tema Koyu: Ayarlar penceresi koyu oluyor mu?'),
      _('Ayarlar › Genel › Ölçek %150: pencere büyüyor ve ekrana sığıyor mu?'),
      _('Bir sohbette mesaj saatleri ve başlık kodu çipi görünüyor mu?'),
      _('Chats sayfasında proje rozetleri ve filtre şeridi görünüyor mu?')
    ];
    const rapor = [_('KABUL TESTİ') + ' · ' + UYGULAMA_ADI + ' ' + SURUM, _('Tarih') + ': ' + new Date().toISOString(),
      _('Tarayıcı') + ': ' + navigator.userAgent, ...ortamSatirlari(), '', _('OTOMATİK'), ...sonuc, '',
      _('ELLE BAK (her satırın başına evet ya da hayır yaz)'), ...elle.map(x => '[ ] ' + x)].join('\n');
    const ok = await panoyaYaz(rapor);
    bildir(ok ? _('Kabul testi raporu panoya kopyalandı. Sohbete yapıştır.') : _('Kopyalanamadı. Konsolda claudeSuite.kabul() yaz.'), ok ? 'basari' : 'hata');
    return { rapor, hata: sonuc.filter(x => x.startsWith('✗')).length };
  }

  async function taniKopyala() {
    const ok = await panoyaYaz(taniRaporu());
    bildir(ok ? _('Tanı raporu panoya kopyalandı') : _('Kopyalanamadı. Konsolda claudeSuite.tani() yaz.'), ok ? 'basari' : 'hata');
  }

  /* =====================================================================
   * 16) KOMUT PALETİ (Alt+K)
   * Bütün eylemler, özellik aç/kapa ve şablonlar tek arama kutusunda.
   * ===================================================================== */

  const KOMUT = { ac: null };

  define({
    id: 'commandPalette',
    label: 'Komut paleti',
    desc: 'Bütün işler, özellikleri açıp kapama ve şablonlar tek arama kutusunda.',
    group: 'Araçlar',
    kisayol: 'palet',
    on(ctx) {
      const CSS = `
      .ara{display:flex;align-items:center;gap:8px;padding:10px 12px;border-bottom:1px solid var(--ayirici);color:var(--metin-ikincil)}
      .ara input{all:unset;flex:1;font:400 14px/1.5 var(--yazi);color:var(--metin)}
      .ara input::placeholder{color:var(--metin-ikincil)}
      .lst{padding:4px 0}
      .oge{display:flex;align-items:center;gap:10px;min-height:32px;padding:4px 12px;cursor:pointer}
      .oge:hover{background:var(--ana-hover)}
      .oge.sec{background:var(--ana-acik)}
      .oge .ad{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .oge .grp{font-size:11px;color:var(--metin-ikincil)}
      .sayac{font-size:12px;color:var(--metin-ikincil)}`;

      function ogeler() {
        const out = [];
        out.push({ ad: _('Ayarları aç'), grup: _('Genel'), tus: KISAYOL.tus('ayarlar'), calistir: () => panelAc() });
        out.push({ ad: _('Dil değiştir (TR/EN)'), grup: _('Genel'), tus: KISAYOL.tus('dil'), calistir: () => DIL.degistir() });
        for (const a of ACTIONS) out.push({ ad: _(a.ad), grup: _(a.grup || 'Genel'), tus: a.kisayol ? KISAYOL.tus(a.kisayol) : a.tus, calistir: a.calistir });
        out.push({ ad: _('Ayarları dışa aktar'), grup: _('Genel'), calistir: ayarlarDisaAktar });
        out.push({ ad: _('Ayarları içe aktar'), grup: _('Genel'), calistir: () => ayarlarIceAktar() });
        out.push({ ad: _('Tanı raporunu kopyala'), grup: _('Tanı'), calistir: taniKopyala });
        out.push({ ad: _('Kabul testini çalıştır'), grup: _('Tanı'), calistir: kabulTesti });
        for (const m of MODULES) {
          if (m.id === 'commandPalette') continue;
          const acik = pref(m.id);
          out.push({ ad: (acik ? _('Kapat') : _('Aç')) + ': ' + _(m.label), grup: _('Özellik'), calistir: () => {
            setPref(m.id, !acik);
            bildir(_(m.label) + ' ' + (acik ? _('kapatıldı') : _('açıldı')), 'basari');
          } });
        }
        if (TPLUI.sec) for (const t of TPL.all()) out.push({ ad: _('Şablon') + ': ' + t.title, grup: _('Şablon'), calistir: () => TPLUI.sec(t) });
        return out;
      }

      function puan(o, terimler) {
        const y = fold(o.ad + ' ' + o.grup);
        if (!terimler.every(t => y.includes(t))) return -1;
        return fold(o.ad).startsWith(terimler[0] || '') ? 2 : 1;
      }

      function ac() {
        let sec = 0, sonuc = [];
        const hepsi = ogeler();
        const w = pencereAc({ baslik: _('Komut paleti'), genislik: 560, ust: '14vh', css: CSS });
        const ara = document.createElement('div');
        ara.className = 'ara';
        ara.innerHTML = ikon('komut');
        const inp = document.createElement('input');
        inp.type = 'text';
        inp.placeholder = _('Komut, özellik ya da şablon ara…');
        inp.setAttribute('aria-label', _('Komut ara'));
        ara.appendChild(inp);
        const govde = document.createElement('div');
        govde.className = 'p-govde lst';
        govde.setAttribute('role', 'listbox');
        govde.style.maxHeight = '56vh';
        const alt = document.createElement('div');
        alt.className = 'p-alt';
        const ipucu = document.createElement('span');
        ipucu.className = 'kbd';
        ipucu.textContent = _('↑↓ seç · Enter çalıştır · Esc kapat');
        const boslukA = document.createElement('span');
        boslukA.className = 'bosluk';
        alt.append(ipucu, boslukA);
        const sayac = document.createElement('span');
        sayac.className = 'sayac';
        alt.appendChild(sayac);
        w.p.append(ara, govde, alt);

        function ciz() {
          const terimler = fold(inp.value.trim()).split(/\s+/).filter(Boolean);
          sonuc = hepsi.map(o => [o, puan(o, terimler)]).filter(x => x[1] >= 0)
            .sort((a, b) => b[1] - a[1]).map(x => x[0]).slice(0, 60);
          if (sec >= sonuc.length) sec = Math.max(0, sonuc.length - 1);
          govde.innerHTML = '';
          if (!sonuc.length) {
            const b = document.createElement('div');
            b.className = 'bos';
            const bb = document.createElement('b');
            bb.textContent = _('Eşleşen komut yok');
            b.append(bb, document.createTextNode(_('Başka bir kelime dene.')));
            govde.appendChild(b);
          }
          sonuc.forEach((o, i) => {
            const r = document.createElement('div');
            r.className = 'oge' + (i === sec ? ' sec' : '');
            r.setAttribute('role', 'option');
            r.setAttribute('aria-selected', i === sec ? 'true' : 'false');
            const a = document.createElement('span'); a.className = 'ad'; a.textContent = o.ad;
            const g = document.createElement('span'); g.className = 'grp'; g.textContent = o.grup;
            r.append(a, g);
            if (o.tus) { const k = document.createElement('span'); k.className = 'kbd'; k.textContent = o.tus; r.appendChild(k); }
            r.addEventListener('mouseenter', () => { sec = i; isaretle(); });
            r.addEventListener('click', () => calistir(o));
            govde.appendChild(r);
          });
          sayac.textContent = _f('{0} komut', sonuc.length);
        }
        function isaretle() {
          govde.querySelectorAll('.oge').forEach((r, i) => { r.classList.toggle('sec', i === sec); r.setAttribute('aria-selected', i === sec ? 'true' : 'false'); });
          const c = govde.querySelectorAll('.oge')[sec];
          if (c) c.scrollIntoView({ block: 'nearest' });
        }
        function calistir(o) {
          w.kapat();
          setTimeout(() => { try { o.calistir(); } catch (e) { gunluk('commandPalette', e.message); bildir(_f('Komut çalışmadı: {0}', e.message), 'hata'); } }, 0);
        }
        inp.addEventListener('input', () => { sec = 0; ciz(); });
        inp.addEventListener('keydown', e => {
          if (e.key === 'ArrowDown') { e.preventDefault(); sec = Math.min(sec + 1, sonuc.length - 1); isaretle(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); sec = Math.max(sec - 1, 0); isaretle(); }
          else if (e.key === 'Enter') { e.preventDefault(); if (sonuc[sec]) calistir(sonuc[sec]); }
        });
        ciz();
        inp.focus();
      }

      KOMUT.ac = ac;
      ctx.undo(() => { KOMUT.ac = null; });
    }
  });

  /* =====================================================================
   * 17) AYARLAR PENCERESİ (app-lab v02.01 ortak Ayarlar; seçenek C, 2026-10-18)
   *
   * Solda gezinti: arama kutusu, CLS başlığı altında uygulamanın bölümleri
   * (5 özellik grubu + Başlık kodları + Şablonlar), ORTAK başlığı altında
   * Genel · Klavye kısayolları · Tanı · Hakkında. Sağda seçili bölüm.
   * CLS düğmesi, Alt+D ya da Ctrl+, açar. Dil değişince yeniden çizilir.
   * Ayrı onay penceresi açılmaz (tek pencere kuralı); onaylar satır içi.
   * ===================================================================== */

  const OZELLIK_GRUPLARI = ['Yerleşim', 'Yazma', 'Gezinme', 'Bilgi', 'Araçlar'];
  const BOLUMLER = [
    ...OZELLIK_GRUPLARI.map(g => ({ id: 'g:' + g, ad: g, kume: 'cls' })),
    { id: 'kodlar', ad: _n('Başlık kodları'), kume: 'cls' },
    { id: 'sablonlar', ad: _n('Şablonlar'), kume: 'cls' },
    { id: 'genel', ad: _n('Genel'), kume: 'ortak' },
    { id: 'kisayol', ad: _n('Klavye kısayolları'), kume: 'ortak' },
    { id: 'tani', ad: _n('Tanı'), kume: 'ortak' },
    { id: 'hakkinda', ad: _n('Hakkında'), kume: 'ortak' }
  ];
  const PAKET_ADRESI = 'https://github.com/AALabs26/AALabs/tree/main/paketler/ClaudeSuite';

  const AYARLAR_CSS = `
  .p-bas .ad2{flex:1;min-width:0;display:flex;flex-direction:column}
  .p-bas .ad2 b{font:600 14px/1.25 var(--yazi)}
  .p-bas .ad2 span{font-size:11.5px;color:var(--metin-ikincil)}
  .dil{min-width:36px;padding:0 8px;font-weight:700;font-size:11px}
  .ic{display:grid;grid-template-columns:208px minmax(0,1fr);min-height:0;flex:1}
  .nav{border-right:1px solid var(--ayirici);display:flex;flex-direction:column;min-height:0}
  .nav .arama{margin:8px;width:calc(100% - 16px);flex:none;height:28px;line-height:26px;font-size:12.5px}
  .nav .liste{overflow:auto;padding-bottom:8px;flex:1}
  .nav h3{margin:10px 12px 4px;font:700 11px/1.4 var(--yazi);letter-spacing:.06em;color:var(--metin-ikincil)}
  .nav button{all:unset;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;
    height:30px;padding:0 12px;cursor:pointer;color:var(--metin);font:400 13px/1 var(--yazi)}
  .nav button .y{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
  .nav button:hover{background:var(--ana-hover)}
  .nav button[aria-current="page"]{background:var(--ana-acik);font-weight:600}
  .nav button:focus-visible{outline:2px solid var(--vurgu);outline-offset:-2px}
  .nav .say{font-size:11px;color:var(--metin-ikincil);font-variant-numeric:tabular-nums;flex:none}
  .nav .say.kotu{color:var(--hata);font-weight:600}
  .sayfa{overflow:auto;min-width:0}
  .sbas{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;padding:12px 16px 10px;border-bottom:1px solid var(--ayirici)}
  .sbas h4{margin:0;font:600 15px/1.3 var(--yazi)}
  .sbas .sag{display:flex;flex-wrap:wrap;gap:8px}
  .eylemler{display:flex;flex-wrap:wrap;gap:8px;padding:10px 16px;border-bottom:1px solid var(--ayirici)}
  .oz{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 12px;align-items:center;padding:9px 16px;border-bottom:1px solid var(--ayirici)}
  .oz.alt{padding-left:32px}
  .oz.olu{opacity:.55}
  .oz .ad{display:flex;align-items:center;gap:8px;font-weight:600;min-width:0;flex-wrap:wrap}
  .oz .acik{grid-column:1;font-size:12px;color:var(--metin-ikincil)}
  .oz .sag{grid-row:1 / span 2;grid-column:2;display:flex;align-items:center;gap:8px}
  .alan{display:grid;grid-template-columns:140px minmax(0,1fr);gap:10px 14px;align-items:baseline;padding:12px 16px;border-bottom:1px solid var(--ayirici)}
  .alan > .et{color:var(--metin-ikincil)}
  .alan .not{font-size:12px;color:var(--metin-ikincil);margin-top:4px}
  .seg{display:inline-flex;flex-wrap:wrap;border:1px solid var(--kenar);border-radius:var(--kose-s);overflow:hidden}
  .seg button{all:unset;box-sizing:border-box;cursor:pointer;height:28px;padding:0 12px;display:inline-flex;align-items:center;
    color:var(--metin);background:var(--yuzey);font:400 13px/1 var(--yazi)}
  .seg button+button{border-left:1px solid var(--kenar)}
  .seg button[aria-checked="true"]{background:var(--ana);color:var(--ana-uzeri);font-weight:600}
  .seg button:focus-visible{outline:2px solid var(--vurgu);outline-offset:-2px}
  .tablo{width:100%;border-collapse:collapse}
  .tablo td{padding:7px 16px;border-bottom:1px solid var(--ayirici);vertical-align:middle}
  .tablo td.t{text-align:right;white-space:nowrap}
  .tablo td.t .kbd{margin-left:4px}
  .tablo .yakala{outline:2px solid var(--vurgu);outline-offset:1px}
  .hatali{color:var(--hata);font-size:12px;padding:6px 16px}
  .ts{display:grid;grid-template-columns:20px minmax(0,1fr);gap:2px 8px;padding:8px 16px;border-bottom:1px solid var(--ayirici)}
  .ts .ik{grid-row:1 / span 2;padding-top:1px}
  .ts .ok{color:var(--basari)} .ts .no{color:var(--hata)} .ts .yok{color:var(--metin-ikincil)}
  .ts b{font-weight:600;grid-column:2}
  .ts .m{grid-column:2;font-size:12px;color:var(--metin-ikincil)}
  .ts .z{grid-column:2;font:400 11px/1.5 ui-monospace,Consolas,monospace;color:var(--metin-ikincil);white-space:pre-wrap}
  .gun{padding:10px 16px;font:400 11.5px/1.5 ui-monospace,Consolas,monospace;color:var(--metin-ikincil);white-space:pre-wrap}
  .izgara{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;padding:12px 16px 6px}
  .kod{height:28px;border-radius:var(--kose-s);color:var(--ana-uzeri);font:600 12px/28px var(--yazi);text-align:center;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 4px}
  .lejant{display:flex;gap:12px;flex-wrap:wrap;padding:0 16px 10px;font-size:11px;color:var(--metin-ikincil)}
  .lejant span{display:inline-flex;align-items:center;gap:4px}
  .lejant i{width:10px;height:10px;border-radius:var(--kose-s);display:inline-block}
  .duz{padding:0 16px 12px;display:grid;gap:8px}
  .duz .sira{display:flex;flex-wrap:wrap;gap:8px}
  .not2{font-size:12px;color:var(--metin-ikincil);padding:10px 16px 0}
  .baglanti{color:var(--vurgu)}`;

  let panelAcik = null;
  // Öznitelik seçicisi için kaçış (CSS.escape her ortamda yok).
  const attrKac = v => String(v).replace(/["\\]/g, '\\$&');

  function panelAc(baslangic) {
    let aktif = baslangic || ayarOku('ayarlarBolum', 'g:Bilgi');
    if (/^[A-ZÇĞİÖŞÜ]/.test(aktif)) aktif = 'g:' + aktif;           // eski çağrı: panelAc('Yazma')
    if (!BOLUMLER.some(b => b.id === aktif)) aktif = 'g:Bilgi';
    let sorgu = '', kodKirli = false;

    const w = pencereAc({
      baslik: _('Ayarlar') + ' · ' + UYGULAMA_ADI, genislik: 820, yukseklik: 560, css: AYARLAR_CSS + SABLON_CSS,
      kapaninca: () => { panelAcik = null; panelYenile = null; dilBirak(); KISAYOL_YAKALA.bitir(); },
      tus: e => {
        if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && (e.key === 'f' || e.key === 'F')) {
          e.preventDefault(); arama.focus(); arama.select();
        }
      }
    });

    // Üst bant: logo, iki satırlı ad, dil düğmesi, kapat.
    const bas = document.createElement('div');
    bas.className = 'p-bas';
    const logo = document.createElement('span');
    logo.className = 'logo';
    logo.textContent = IKON_KODU;
    const ad2 = document.createElement('div');
    ad2.className = 'ad2';
    const adB = document.createElement('b');
    const adS = document.createElement('span');
    adS.textContent = UYGULAMA_ADI;
    ad2.append(adB, adS);
    const dilD = document.createElement('button');
    dilD.type = 'button';
    dilD.className = 'dg dil';
    dilD.addEventListener('click', () => DIL.degistir());
    const kapat = document.createElement('button');
    kapat.type = 'button';
    kapat.className = 'dg hayalet ikonlu';
    kapat.innerHTML = ikon('x');
    kapat.addEventListener('click', () => w.kapat());
    bas.append(logo, ad2, dilD, kapat);

    const ic = document.createElement('div');
    ic.className = 'ic';
    const nav = document.createElement('nav');
    nav.className = 'nav';
    const arama = document.createElement('input');
    arama.className = 'girdi arama';
    arama.type = 'search';
    arama.addEventListener('input', () => { sorgu = arama.value.trim(); ciz(); });
    arama.addEventListener('keydown', e => {
      if (e.key === 'Escape' && arama.value) { e.preventDefault(); e.stopPropagation(); arama.value = ''; sorgu = ''; ciz(); }
      if (e.key === 'ArrowDown') { e.preventDefault(); const b = liste.querySelector('button'); if (b) b.focus(); }
    });
    const liste = document.createElement('div');
    liste.className = 'liste';
    nav.append(arama, liste);
    const sayfa = document.createElement('div');
    sayfa.className = 'sayfa';
    sayfa.setAttribute('role', 'region');
    ic.append(nav, sayfa);
    w.p.append(bas, ic);

    /* ---- arama ---- */
    const terimler = () => fold(sorgu).split(/\s+/).filter(Boolean);
    const uyar = (metin, t) => { const y = fold(metin); return t.every(x => y.includes(x)); };
    const ozMetni = m => _(m.label) + ' ' + _(m.desc) + ' ' + m.label + ' ' + m.desc + (m.kisayol ? ' ' + KISAYOL.tus(m.kisayol) : '');
    function bolumMetni(b) {
      const parca = [_(b.ad), b.ad];
      if (b.id.startsWith('g:')) for (const m of MODULES.filter(x => x.group === b.ad)) parca.push(ozMetni(m));
      if (b.id === 'kisayol') for (const k of KISAYOL.LISTE) parca.push(_(k.ad), k.ad, KISAYOL.tus(k.id));
      if (b.id === 'genel') parca.push(_('Dil'), _('Tema'), _('Ölçek'), 'Türkçe English', _('Tarayıcı dili'), _('Koyu'), _('Açık'));
      if (b.id === 'tani') parca.push(_('Raporu kopyala'), _('Kabul testi'));
      if (b.id === 'hakkinda') parca.push(_('Sürüm'), _('Yedekle'), _('Geri yükle'), 'App Store', _('Lisanslar'));
      if (b.id === 'kodlar') parca.push(...BASLIK.kodlar().map(k => k.kod));
      if (b.id === 'sablonlar') parca.push(...TPL.all().map(t => t.title));
      return parca.join(' ');
    }
    // Özellik grubu: grup adı ya da en az bir özellik bütün kelimelere uyarsa görünür (sayfadaki süzgeçle aynı kural).
    const grupUyar = (g, t) => uyar(g + ' ' + _(g), t) || MODULES.some(m => m.group === g && uyar(ozMetni(m), t));
    const kisayolUyar = (k, t) => uyar(_(k.ad) + ' ' + k.ad + ' ' + KISAYOL.tus(k.id), t) || uyar('Klavye kısayolları ' + _('Klavye kısayolları'), t);
    const gorunur = () => {
      const t = terimler();
      if (!t.length) return BOLUMLER;
      return BOLUMLER.filter(b => b.id.startsWith('g:') ? grupUyar(b.ad, t)
        : b.id === 'kisayol' ? KISAYOL.LISTE.some(k => kisayolUyar(k, t)) : uyar(bolumMetni(b), t));
    };

    /* ---- gezinti ---- */
    function say(b) {
      if (b.id.startsWith('g:')) {
        const ms = MODULES.filter(m => m.group === b.ad);
        return [ms.filter(m => effective(m.id)).length + '/' + ms.length, false];
      }
      if (b.id === 'kodlar') return [String(BASLIK.kodlar().length), false];
      if (b.id === 'sablonlar') return [String(TPL.all().length), false];
      if (b.id === 'tani') { const n = MODULES.filter(m => saglik(m).tamam === false).length; return n ? [_f('{0} sorun', n), true] : ['', false]; }
      return ['', false];
    }
    function navCiz(gor) {
      liste.innerHTML = '';
      for (const kume of ['cls', 'ortak']) {
        const bs = gor.filter(b => b.kume === kume);
        if (!bs.length) continue;
        const h = document.createElement('h3');
        h.textContent = kume === 'cls' ? IKON_KODU : buyuk(_('Ortak'));
        liste.appendChild(h);
        for (const b of bs) {
          const d = document.createElement('button');
          d.type = 'button';
          d.dataset.bolum = b.id;
          const y = document.createElement('span');
          y.className = 'y';
          y.textContent = _(b.ad);
          d.title = _(b.ad);
          d.appendChild(y);
          const [n, kotu] = say(b);
          if (n) { const s = document.createElement('span'); s.className = 'say' + (kotu ? ' kotu' : ''); s.textContent = n; d.appendChild(s); }
          if (b.id === aktif) d.setAttribute('aria-current', 'page');
          d.addEventListener('click', () => git(b.id));
          liste.appendChild(d);
        }
      }
    }
    liste.addEventListener('keydown', e => {
      const dg = [...liste.querySelectorAll('button')];
      const i = dg.indexOf(e.composedPath()[0]);
      const yon = { ArrowDown: 1, ArrowUp: -1 }[e.key];
      if (!yon || i < 0) return;
      e.preventDefault();
      if (i + yon < 0) { arama.focus(); return; }
      const h = dg[Math.min(dg.length - 1, i + yon)];
      git(h.dataset.bolum);
      const yeni = liste.querySelector(`[data-bolum="${h.dataset.bolum}"]`);
      if (yeni) yeni.focus();
    });

    function git(id) { aktif = id; ayarYaz('ayarlarBolum', id); ciz(); sayfa.scrollTop = 0; }

    /* ---- ortak parçalar ---- */
    function baslik(metin, ...sag) {
      const b = document.createElement('div');
      b.className = 'sbas';
      const h = document.createElement('h4');
      h.textContent = metin;
      const s = document.createElement('div');
      s.className = 'sag';
      s.append(...sag.filter(Boolean));
      b.append(h, s);
      sayfa.appendChild(b);
      return b;
    }
    function varsayilanDugmesi(fn) {
      const d = dugme(_('Varsayılana dön'), null, 'kucuk');
      d.addEventListener('click', async () => {
        const ok = await satirIciOnay(sayfa, _('Bu bölümdeki ayarlar varsayılana dönsün mü?'),
          [{ metin: _('Vazgeç'), harf: { tr: 'V', en: 'C' }, deger: false }, { metin: _('Varsayılana dön'), harf: { tr: 'D', en: 'R' }, deger: true, tur: 'tehlike' }]);
        if (ok) { fn(); bildir(_('Varsayılana dönüldü'), 'basari'); ciz(); }
      });
      return d;
    }
    function segment(adi, secenekler, deger, degisti) {
      const s = document.createElement('div');
      s.className = 'seg';
      s.setAttribute('role', 'radiogroup');
      s.setAttribute('aria-label', adi);
      secenekler.forEach(([v, et], i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('role', 'radio');
        b.setAttribute('aria-checked', v === deger ? 'true' : 'false');
        b.tabIndex = v === deger ? 0 : -1;
        b.dataset.odak = 'seg:' + adi + ':' + i;
        b.textContent = et;
        b.addEventListener('click', () => degisti(v));
        // Ok tuşlarıyla seçenekler arasında gezinip seçme (tek sekme durağı).
        b.addEventListener('keydown', e => {
          const yon = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
          if (!yon) return;
          e.preventDefault();
          const j = (i + yon + secenekler.length) % secenekler.length;
          degisti(secenekler[j][0]);
          const yeni = w.p.querySelector(`[data-odak="${attrKac('seg:' + adi + ':' + j)}"]`);
          if (yeni) yeni.focus();
        });
        s.appendChild(b);
      });
      return s;
    }
    function alan(etiket, ...icerik) {
      const a = document.createElement('div');
      a.className = 'alan';
      const e = document.createElement('div');
      e.className = 'et';
      e.textContent = etiket;
      const sag = document.createElement('div');
      sag.append(...icerik.filter(Boolean));
      a.append(e, sag);
      sayfa.appendChild(a);
      return a;
    }
    function not(metin) { const n = document.createElement('div'); n.className = 'not'; n.textContent = metin; return n; }
    function kbd(t) { const k = document.createElement('span'); k.className = 'kbd'; k.textContent = t; return k; }

    /* ---- özellik grupları ---- */
    function ozellikSatiri(m) {
      const s = document.createElement('div');
      const olu = m.parent && !effective(m.parent);
      s.className = 'oz' + (m.parent ? ' alt' : '') + (olu ? ' olu' : '');
      const ad = document.createElement('div');
      ad.className = 'ad';
      ad.append(document.createTextNode(_(m.label)));
      const t = m.kisayol ? KISAYOL.tus(m.kisayol) : m.keys;
      if (t) ad.appendChild(kbd(t));
      const ac_ = document.createElement('div');
      ac_.className = 'acik';
      ac_.textContent = olu ? _(m.desc) + ' ' + _('Üst özellik kapalı.') : _(m.desc);
      const sag_ = document.createElement('div');
      sag_.className = 'sag';
      if (m.id === 'titleCode') {
        const d = dugme(_('Kodları düzenle'), null, 'kucuk');
        d.addEventListener('click', () => git('kodlar'));
        sag_.appendChild(d);
      }
      const an = document.createElement('button');
      an.type = 'button';
      an.className = 'anah';
      an.setAttribute('role', 'switch');
      an.setAttribute('aria-checked', pref(m.id) ? 'true' : 'false');
      an.setAttribute('aria-label', _(m.label));
      an.dataset.odak = 'oz:' + m.id;
      if (olu) an.disabled = true;
      an.addEventListener('click', () => {
        setPref(m.id, !pref(m.id));
        bildir(_(m.label) + ' ' + (pref(m.id) ? _('açıldı') : _('kapatıldı')), 'basari');
      });
      sag_.appendChild(an);
      s.append(ad, sag_, ac_);
      return s;
    }

    function grupCiz(g) {
      const ms = MODULES.filter(m => m.group === g);
      baslik(_(g), varsayilanDugmesi(() => { for (const m of ms) delete prefs.modules[m.id]; writePrefs(prefs); sync(); }));
      const e = document.createElement('div');
      e.className = 'eylemler';
      if (g === 'Yazma') {
        const bk = dugme(_('Başlığı düzenle'), 'B', '', 'etiket');
        bk.disabled = !BASLIKUI.ac || !suankiSohbet();
        bk.title = bk.disabled ? _('Bir sohbet açıkken çalışır') : '';
        bk.addEventListener('click', () => BASLIKUI.ac && BASLIKUI.ac());
        const sb = dugme(_('Şablonları yönet'), { tr: 'Ş', en: 'M' });
        sb.addEventListener('click', () => git('sablonlar'));
        e.append(bk, sb);
      }
      if (g === 'Araçlar') {
        const md = dugme(_('Sohbeti Markdown\'a aktar'), 'M', '', 'dosya');
        md.disabled = !suankiSohbet() || !effective('exportMarkdown');
        md.title = md.disabled ? _('Bir sohbet açıkken ve özellik açıkken çalışır') : '';
        md.addEventListener('click', () => { w.kapat(); markdownAktar(); });
        const kp = dugme(_('Komut paleti'), { tr: 'K', en: 'P' }, '', 'komut');
        kp.disabled = !KOMUT.ac;
        kp.addEventListener('click', () => { w.kapat(); setTimeout(() => KOMUT.ac && KOMUT.ac(), 0); });
        e.append(md, kp);
      }
      if (e.children.length) sayfa.appendChild(e);
      const t = terimler();
      let n = 0;
      for (const m of ms.filter(x => !x.parent)) {
        const cocuk = ms.filter(x => x.parent === m.id);
        const goster = x => !t.length || uyar(ozMetni(x), t) || uyar(g + ' ' + _(g), t);
        if (goster(m) || cocuk.some(goster)) { sayfa.appendChild(ozellikSatiri(m)); n++; }
        for (const c of cocuk) if (goster(c) || goster(m)) { sayfa.appendChild(ozellikSatiri(c)); n++; }
      }
      if (!n) bos(_('Bu bölümde aramaya uyan özellik yok.'));
    }

    function bos(alt) {
      const b = document.createElement('div');
      b.className = 'bos';
      const bb = document.createElement('b');
      bb.textContent = _('Sonuç yok');
      b.append(bb, document.createTextNode(alt || _('Başka bir kelime dene.')));
      sayfa.appendChild(b);
    }

    /* ---- Başlık kodları ---- */
    function kodlarCiz() {
      baslik(_('Başlık kodları'));
      const n = document.createElement('div');
      n.className = 'not2';
      n.textContent = _('Başlık biçimi: KOD Kısa konu YYYY-MMDD. Her satır bir grup: "Grup adı: KOD, KOD". Grup sırası rengi belirler.');
      sayfa.appendChild(n);
      const izg = document.createElement('div');
      izg.className = 'izgara';
      izg.setAttribute('aria-label', _('Kod önizlemesi'));
      const lej = document.createElement('div');
      lej.className = 'lejant';
      const duz = document.createElement('div');
      duz.className = 'duz';
      const ta = document.createElement('textarea');
      ta.className = 'girdi';
      ta.rows = 6;
      ta.value = ayarOku('baslikKodlari', KOD_VARSAYILAN);
      ta.setAttribute('aria-label', _('Başlık kodları'));
      const sira = document.createElement('div');
      sira.className = 'sira';
      const kay = dugme(_('Kaydet'), { tr: 'K', en: 'S' }, 'ana');
      const sif = dugme(_('Varsayılana dön'), { tr: 'D', en: 'R' }, 'hayalet');
      sira.append(kay, sif);
      duz.append(ta, sira);
      sayfa.append(izg, lej, duz);
      function onizle(metin) {
        const v = TEMA.vars();
        // Önizleme yazılan metinden çözülür; kayıt Kaydet'te.
        const kodlar = BASLIK.kodlar(metin), gruplar = BASLIK.gruplar(metin);
        izg.innerHTML = '';
        for (const k of kodlar) {
          const d = document.createElement('div');
          d.className = 'kod';
          d.textContent = k.kod;
          d.title = k.grup.ad + ' · ' + k.kod;
          d.style.background = v[k.grup.renk];
          izg.appendChild(d);
        }
        lej.innerHTML = '';
        for (const g of gruplar) {
          const s = document.createElement('span');
          const i = document.createElement('i');
          i.style.background = v[g.renk];
          s.append(i, document.createTextNode(g.ad));
          lej.appendChild(s);
        }
      }
      ta.addEventListener('input', () => { kodKirli = true; onizle(ta.value); });
      kay.addEventListener('click', () => {
        ayarYaz('baslikKodlari', ta.value.trim() || KOD_VARSAYILAN);
        bildir(_f('{0} kod kaydedildi', BASLIK.kodlar().length), 'basari');
        ciz();
      });
      sif.addEventListener('click', () => { ta.value = KOD_VARSAYILAN; onizle(ta.value); });
      onizle(ta.value);
    }

    /* ---- Şablonlar ---- */
    function sablonlarCiz() {
      baslik(_('Şablonlar'));
      const kap = document.createElement('div');
      sayfa.appendChild(kap);
      if (TPLUI.sayfa) { TPLUI.sayfa(kap); return; }
      const b = document.createElement('div');
      b.className = 'bos';
      const bb = document.createElement('b');
      bb.textContent = _('Prompt şablonları kapalı');
      const ac = dugme(_('Aç'), { tr: 'A', en: 'O' }, 'ana');
      ac.style.marginTop = '8px';
      ac.addEventListener('click', () => setPref('promptTemplates', true));
      b.append(bb, document.createTextNode(_('Şablonları yönetmek için özelliği aç.')), document.createElement('br'), ac);
      kap.appendChild(b);
    }

    /* ---- Genel ---- */
    function genelCiz() {
      baslik(_('Genel'), varsayilanDugmesi(() => {
        ayarYaz('tema', 'site'); ayarYaz('olcek', 100); TEMA.yenile(); olcekUygula(w.p);
        if (DIL.secim() !== 'tr') DIL.sec('tr');
      }));
      const tar = DIL.tarayici() === 'tr' ? 'Türkçe' : 'English';
      alan(_('Dil'),
        segment(_('Dil'), [['tr', 'Türkçe'], ['en', 'English'], ['sistem', _('Tarayıcı dili')]], DIL.secim(), v => { const o = DIL.aktif(); DIL.sec(v); if (DIL.aktif() === o) ciz(); }),
        not(_f('Algılanan tarayıcı dili: {0}', tar) + ' · ' + KISAYOL.tus('dil')));
      alan(_('Tema'),
        segment(_('Tema'), [['site', _('claude.ai\'yi izle')], ['acik', _('Açık')], ['koyu', _('Koyu')]], ayarOku('tema', 'site'),
          v => { ayarYaz('tema', v); TEMA.yenile(); ciz(); }),
        not(_('Yalnız CLS pencereleri değişir. Sayfaya yerleşen parçalar claude.ai\'nin temasını izler.')));
      alan(_('Ölçek'),
        segment(_('Ölçek'), OLCEKLER.map(v => [v, yuzde(v)]), olcek(),
          v => { ayarYaz('olcek', v); olcekUygula(w.p); ciz(); }),
        not(_('Yalnız CLS pencereleri büyür; claude.ai değişmez.')));
    }

    /* ---- Klavye kısayolları ---- */
    function kisayolCiz() {
      baslik(_('Klavye kısayolları'), varsayilanDugmesi(() => KISAYOL.sifirla()));
      const hata = document.createElement('div');
      hata.className = 'hatali';
      hata.setAttribute('role', 'alert');
      sayfa.appendChild(hata);
      const tb = document.createElement('table');
      tb.className = 'tablo';
      const t = terimler();
      for (const k of KISAYOL.LISTE) {
        if (t.length && !kisayolUyar(k, t)) continue;
        const tr = document.createElement('tr');
        const a = document.createElement('td');
        a.textContent = _(k.ad);
        const b = document.createElement('td');
        b.className = 't';
        const tus = KISAYOL.tus(k.id);
        b.appendChild(kbd(tus || '—'));
        if (k.sabit) b.appendChild(kbd(k.sabit));
        const deg = dugme(_('Değiştir'), null, 'kucuk');
        deg.style.marginLeft = '8px';
        deg.setAttribute('aria-label', _f('{0} kısayolunu değiştir', _(k.ad)));
        deg.dataset.odak = 'ks:' + k.id;
        deg.addEventListener('click', () => {
          KISAYOL_YAKALA.bitir();
          hata.textContent = '';
          deg.classList.add('yakala');
          deg.querySelector('span').textContent = _('Tuşa bas… (Esc vazgeç, Delete temizle)');
          KISAYOL_YAKALA.basla(deg, ad => {
            deg.classList.remove('yakala');
            if (ad === null) { ciz(); return; }
            const h = KISAYOL.ayarla(k.id, ad === 'Delete' ? '' : ad);
            if (h) { ciz(); hataGoster(_f(h.m, ...h.a.map(x => _(x)))); return; }
            bildir(_f('{0}: {1}', _(k.ad), KISAYOL.tus(k.id) || '—'), 'basari');
            ciz();
          });
        });
        b.appendChild(deg);
        tr.append(a, b);
        tb.appendChild(tr);
      }
      sayfa.appendChild(tb);
      if (!tb.rows.length) bos(_('Aramaya uyan kısayol yok.'));
      const n = document.createElement('div');
      n.className = 'not2';
      n.textContent = _('Ctrl+, Ayarlar için sabittir. Ctrl+K (claude.ai araması) ve Ctrl+Shift+T (tarayıcı) kullanılmaz.');
      sayfa.appendChild(n);
      function hataGoster(m) { const h = sayfa.querySelector('.hatali'); if (h) h.textContent = m; }
    }

    /* ---- Tanı ---- */
    function taniCiz() {
      const kop = dugme(_('Raporu kopyala'), { tr: 'K', en: 'C' }, 'ana', 'kopya');
      kop.addEventListener('click', taniKopyala);
      const kab = dugme(_('Kabul testi'), 'T', '', 'onay');
      kab.title = _('Otomatik denetimler ve elle bakılacaklar listesi; rapor panoya kopyalanır.');
      kab.addEventListener('click', async () => { kab.disabled = true; try { await kabulTesti(); } finally { kab.disabled = false; } });
      const yen = dugme(_('Yenile'), { tr: 'Y', en: 'R' }, '', 'yenile');
      yen.addEventListener('click', ciz);
      baslik(_('Tanı'), kop, kab, yen);
      for (const m of MODULES) {
        const s = saglik(m);
        const r = document.createElement('div');
        r.className = 'ts';
        const ik = document.createElement('span');
        ik.className = 'ik ' + (s.tamam === null ? 'yok' : s.tamam ? 'ok' : 'no');
        ik.innerHTML = ikon(s.tamam === null ? 'bilgi' : s.tamam ? 'tamam' : 'uyari');
        ik.setAttribute('role', 'img');
        ik.setAttribute('aria-label', s.tamam === null ? _('bilgi') : s.tamam ? _('çalışıyor') : _('sorun var'));
        const b = document.createElement('b');
        b.textContent = _(m.label);
        const sp = document.createElement('span');
        sp.className = 'm';
        sp.textContent = s.metin;
        r.append(ik, b, sp);
        if (s.tamam === false && Array.isArray(s.ayrinti) && s.ayrinti.length) {
          const z = document.createElement('span');
          z.className = 'z';
          z.textContent = s.ayrinti.join('\n');
          r.appendChild(z);
        }
        sayfa.appendChild(r);
      }
      if (GUNLUK.length) {
        const g = document.createElement('div');
        g.className = 'gun';
        g.textContent = _('Son olaylar') + '\n' + GUNLUK.slice(-12).map(x => new Date(x.t).toTimeString().slice(0, 5) + ' ' + x.kaynak + ': ' + x.metin).join('\n');
        sayfa.appendChild(g);
      }
    }

    /* ---- Hakkında ---- */
    function hakkindaCiz() {
      baslik(_('Hakkında'));
      alan(_('Sürüm'), document.createTextNode(SURUM + ' · ' + _('tasarım dili') + ' ' + TEMA_SURUM));
      alan(_('Kimlik'), document.createTextNode(UYGULAMA_ID + ' · ' + IKON_KODU));
      const as = document.createElement('a');
      as.className = 'dg';
      as.href = PAKET_ADRESI;
      as.target = '_blank';
      as.rel = 'noopener';
      as.innerHTML = ikon('dis');
      const asY = document.createElement('span');
      asY.textContent = _('App Store paketini aç');
      as.appendChild(asY);
      alan('App Store', as, not(_('AALabs App Store bu betiği kendiliğinden günceller.')));
      const yed = dugme(_('Yedekle'), { tr: 'D', en: 'B' }, '', 'indir');
      yed.title = _('Bütün ayarları, şablonları ve proje renklerini tek dosyaya yaz');
      yed.addEventListener('click', ayarlarDisaAktar);
      const gy = dugme(_('Geri yükle'), { tr: 'E', en: 'R' }, '', 'yukle');
      gy.title = _('Başka makineden aldığın yedek dosyasını yükle');
      gy.addEventListener('click', () => ayarlarIceAktar(sayfa));
      const sira = document.createElement('div');
      sira.style.cssText = 'display:flex;flex-wrap:wrap;gap:8px';
      sira.append(yed, gy);
      alan(_('Yedek'), sira, not(_('Geri yükleme bu makinedeki ayarların yerine geçer; sonra sayfa yenilenir.')));
      alan(_('Lisanslar'), document.createTextNode('Lucide (ISC) · Open Sans (SIL OFL 1.1)'));
    }

    // Yeniden çizimde odak kaybolmasın: odaktaki öğenin anahtarı saklanır, yenisine verilir.
    // (Odak gövdeye düşerse Esc, harf kısayolları ve Ctrl+F çalışmaz; tuşlar claude.ai'ye gider.)
    function odakAnahtari() {
      const a = w.k.root.activeElement;
      if (!a || a === arama) return a === arama ? 'arama' : null;
      if (a.dataset && a.dataset.odak) return 'o:' + a.dataset.odak;
      if (a.dataset && a.dataset.bolum) return 'b:' + a.dataset.bolum;
      return sayfa.contains(a) ? 'sayfa' : null;
    }
    function odakVer(k) {
      if (!k || k === 'arama') return;
      let el = null;
      if (k.startsWith('o:')) el = w.p.querySelector(`[data-odak="${attrKac(k.slice(2))}"]`);
      else if (k.startsWith('b:')) el = liste.querySelector(`[data-bolum="${attrKac(k.slice(2))}"]`);
      if (!el) el = k === 'sayfa' ? sayfa.querySelector('button:not([disabled]),textarea,input') : null;
      if (!el) el = liste.querySelector('[aria-current="page"]');
      if (el) el.focus();
    }

    function ciz() {
      KISAYOL_YAKALA.bitir();               // süren tuş yakalama yeni çizimde kopuk kalmasın
      const odak = odakAnahtari();
      kodKirli = false;
      try { cizIc(); } catch (e) {
        gunluk('ayarlar', e.message);
        sayfa.innerHTML = '';
        bos(_('Bölüm çizilemedi. Tanı › Raporu kopyala ile bildir.'));
      }
      odakVer(odak);
    }

    function cizIc() {
      adB.textContent = _('Ayarlar');
      dilD.textContent = DIL.aktif() === 'en' ? 'EN' : 'TR';
      dilD.title = (DIL.aktif() === 'en' ? 'Language: English. Switch to Turkish' : 'Dil: Türkçe. İngilizceye geç') + ' (' + KISAYOL.tus('dil') + ')';
      dilD.setAttribute('aria-label', dilD.title);
      kapat.setAttribute('aria-label', _('Kapat (Esc)'));
      kapat.title = _('Kapat (Esc)');
      w.p.setAttribute('aria-label', _('Ayarlar') + ' · ' + UYGULAMA_ADI);
      arama.placeholder = _('Ayarlarda ara (Ctrl+F)');
      arama.setAttribute('aria-label', _('Ayarlarda ara'));
      nav.setAttribute('aria-label', _('Bölümler'));
      const gor = gorunur();
      if (gor.length && !gor.some(b => b.id === aktif)) aktif = gor[0].id;
      navCiz(gor);
      sayfa.innerHTML = '';
      if (!gor.length) { bos(); return; }
      const b = BOLUMLER.find(x => x.id === aktif);
      sayfa.setAttribute('aria-label', _(b.ad));
      if (b.id.startsWith('g:')) grupCiz(b.ad);
      else ({ kodlar: kodlarCiz, sablonlar: sablonlarCiz, genel: genelCiz, kisayol: kisayolCiz, tani: taniCiz, hakkinda: hakkindaCiz })[b.id]();
    }

    const dilBirak = DIL.degisince(() => ciz());
    w.p.addEventListener('keydown', e => harfKisayolu(w.p, e));
    panelAcik = w;
    /* Dışarıdan gelen yenileme (özellik aç/kapa, sync) açık bir onayı ya da
       kaydedilmemiş kod metnini silmesin: o sırada ertelenir. */
    panelYenile = () => {
      if (!panelAcik) return;
      if (sayfa.querySelector('.onay-serit') || kodKirli) return;
      ciz();
    };
    ciz();
    const sec = liste.querySelector('[aria-current="page"]');
    if (sec) sec.focus();
  }

  /* Kısayol yakalama: "Değiştir"e basınca bir sonraki tuş birleşimi okunur.
     Yakalarken genel kısayollar çalışmaz; Esc vazgeçer, Delete temizler. */
  const KISAYOL_YAKALA = (function () {
    let dugmeEl = null, bitince = null;
    function dinle(e) {
      if (!dugmeEl) return;
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      if (e.key === 'Escape' && !e.ctrlKey && !e.altKey && !e.metaKey && !e.shiftKey) return bitir(null);
      if (e.key === 'Delete' && !e.ctrlKey && !e.altKey && !e.metaKey && !e.shiftKey) return bitir('Delete');
      const ad = KISAYOL.adlandir(e);
      if (ad) bitir(ad);
    }
    function basla(d, fn) {
      bitir(undefined);                     // öncekini sessizce bitir (geri çağrı yok)
      dugmeEl = d; bitince = fn;
      window.addEventListener('keydown', dinle, true);
      KISAYOL.yakalaniyor = true;
    }
    function bitir(sonuc) {
      if (!dugmeEl) return;
      window.removeEventListener('keydown', dinle, true);
      KISAYOL.yakalaniyor = false;
      const fn = bitince;
      dugmeEl = null; bitince = null;
      if (fn && sonuc !== undefined) fn(sonuc);
    }
    return { basla, bitir: () => bitir(undefined), aktif: () => !!dugmeEl };
  })();

  /* Sağ alttaki CLS düğmesi: standart uygulama ikonu (Safir zemin, beyaz 3 harf). */
  let dugmeKabuk = null, dugmeBirak = null, dugmeSaat = null;
  function clsDugmesi() {
    if (dugmeKabuk && dugmeKabuk.host.isConnected) return;
    dugmeKabuk = kabuk('aalabs-cls-dugme', `
    .cls{position:fixed;right:16px;bottom:16px;width:32px;height:32px;border-radius:var(--kose-l);border:0;
      background:var(--ana);color:var(--ana-uzeri);font:600 10px/32px var(--yazi);letter-spacing:.02em;text-align:center;
      cursor:pointer;pointer-events:auto;opacity:.7;transition:opacity .1s;padding:0}
    .cls:hover,.cls:focus-visible{opacity:1}
    .cls:focus-visible{outline:2px solid var(--vurgu);outline-offset:2px}
    .cls.sorun::after{content:"";position:absolute;top:-3px;right:-3px;width:8px;height:8px;border-radius:50%;
      background:var(--hata);border:2px solid var(--yuzey)}`, 2147482999);
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'cls';
    b.textContent = IKON_KODU;
    b.addEventListener('click', () => (panelAcik ? panelAcik.kapat() : panelAc()));
    dugmeKabuk.kok.appendChild(b);
    // Bir özellik sorun bildirirse düğmede küçük kırmızı nokta görünür.
    function yaz() {
      if (!b.isConnected) return;
      const sorun = MODULES.some(m => saglik(m).tamam === false);
      b.classList.toggle('sorun', sorun);
      b.title = UYGULAMA_ADI + ' · ' + _('Ayarlar') + ' (' + KISAYOL.tus('ayarlar') + ')' + (sorun ? ' · ' + _('Tanı bölümünde sorun var') : '');
      b.setAttribute('aria-label', b.title);
    }
    yaz();
    // Düğme yeniden kurulursa eski dinleyici ve zamanlayıcı bırakılır (birikmesin).
    if (dugmeBirak) dugmeBirak();
    clearInterval(dugmeSaat);
    dugmeBirak = DIL.degisince(yaz);
    dugmeSaat = setInterval(yaz, 5000);
  }

  /* =====================================================================
   * 18) GLOBAL KISAYOLLAR + AÇILIŞ
   * ===================================================================== */

  window.addEventListener('keydown', e => {
    const id = KISAYOL.eslesir(e);
    if (!id || id === 'solaYeniden') return;      // solaYeniden özelliğin kendi dinleyicisinde
    if (e.repeat) { e.preventDefault(); return; } // basılı tutulan tuş işi tekrarlamasın
    const yap = fn => { e.preventDefault(); e.stopPropagation(); fn(); };
    if (id === 'ayarlar') return yap(() => (panelAcik ? panelAcik.kapat() : panelAc()));
    if (id === 'dil') return yap(() => { DIL.degistir(); bildir(DIL.aktif() === 'en' ? 'Language: English' : 'Dil: Türkçe', 'basari'); });
    if (id === 'palet' && KOMUT.ac) return yap(KOMUT.ac);
    if (id === 'solaSabitle') return yap(() => {
      setPref('stickLeft', !pref('stickLeft'));
      bildir(_(byId.get('stickLeft').label) + ' ' + (pref('stickLeft') ? _('açıldı') : _('kapatıldı')), 'basari');
    });
    if (id === 'baslik' && BASLIKUI.ac) return yap(BASLIKUI.ac);
    if (id === 'markdown' && effective('exportMarkdown')) return yap(markdownAktar);
    if (id === 'sablon' && TPLUI.palet) return yap(() => TPLUI.palet());
    if (id === 'sablonYonet' && TPLUI.yonetici) return yap(() => TPLUI.yonetici());
  }, true);

  /* Dil değişince sayfaya yerleşen bütün parçalar yeniden kurulur: açık
     özellikler kapatılıp açılır, böylece rozet, arama kutusu, saat ve
     kullanım şeridi yeni dilde çizilir. Sayfa yenilenmez. */
  DIL.degisince(() => {
    if (!domReady) return;
    // Belge açılırken kurulan (phase 'start') özellikler yeniden kurulmaz: sıraları
    // (Enter yeni satır gibi) sitenin dinleyicilerinden önce kalmalı; yazıları da yok.
    for (const m of MODULES) if (m._live && m.phase !== 'start') { stop(m); start(m); }   // Ayarlar penceresi kendi dinleyicisiyle yenilenir
  });

  window.claudeSuite = {
    surum: SURUM,
    list() {
      console.table(MODULES.map(m => ({
        id: m.id, ad: m.label, grup: m.group,
        tercih: pref(m.id) ? 'açık' : 'kapalı',
        durum: saglik(m).metin
      })));
      return MODULES.map(m => m.id);
    },
    on(id) { setPref(id, true); },
    off(id) { setPref(id, false); },
    panel(grup) { panelAc(grup); },
    palet() { return KOMUT.ac ? KOMUT.ac() : console.log('Komut paleti kapalı.'); },
    tani() { const r = taniRaporu(); console.log(r); return r; },
    kabul() { return kabulTesti().then(x => { console.log(x.rapor); return x.rapor; }); },
    dil(d) { if (d) DIL.sec(d); return DIL.aktif(); },
    probeProjects() { return PROJ.probe(); },
    projectColors() { return PROJ.palette(); },
    refreshProjects() { return PROJ.refresh(true); },
    clearProjects() { PROJ.clear(); console.log('[' + UYGULAMA_ID + '] proje önbelleği silindi.'); },
    reset() {
      localStorage.removeItem(SKEY);
      prefs = { modules: {} };
      sync();
      console.log('[' + UYGULAMA_ID + '] tercihler sıfırlandı.');
    }
  };

  // Ağ yakalayıcı sayfa yüklenirken kurulmalı; proje ve kullanım verisi buradan gelir.
  if (effective('usageHud') || effective('projectTags') || effective('titleCode')) NET.hook();
  if (effective('usageHud')) HUD.hook();

  sync(); // phase:'start' modülleri

  function ready() {
    if (domReady) return;
    domReady = true;
    yaziYukle();
    TEMA.kur();
    clsDugmesi();
    sync();
    setInterval(() => { if (dugmeKabuk && !dugmeKabuk.host.isConnected) { dugmeKabuk = null; clsDugmesi(); } }, 2000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', ready, { once: true });
  } else {
    ready();
  }
})();
