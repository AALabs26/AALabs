// ==UserScript==
// @name         AALabs Claude Suite
// @namespace    aalabs.claude-suite
// @version      2.1.0
// @description  claude.ai için AALabs araç takımı: kullanım göstergesi, proje etiketleri ve filtresi, başlık kodu, mesaj saatleri, şablonlar, komut paleti. Türkçe ve İngilizce; her özellik Ayarlar'dan ayrı açılıp kapanır.
// @author       AALabs
// @match        https://claude.ai/*
// @run-at       document-start
// @grant        none
// @noframes
// @aalabs-ikon  CLS
// @icon         data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='11' fill='%232456D6'/%3E%3Ctext x='32' y='40' font-family='Segoe UI,Arial,sans-serif' font-size='22' font-weight='600' fill='%23fff' text-anchor='middle'%3ECLS%3C/text%3E%3C/svg%3E
// ==/UserScript==

/*
 * AALabs Claude Suite 2.1.0 · ikon CLS · AALabs tasarım dili 1.4.1 · app-lab v02.01
 *
 * ÖZELLİKLER (Ayarlar: sağ alttaki CLS düğmesi, Alt+D ya da Ctrl+,)
 *   Yerleşim   Sohbeti sola sabitle (Alt+L)
 *   Yazma      Enter yeni satır · Prompt şablonları (Alt+T, ;;) · Başlık kodu (Alt+B)
 *   Gezinme    Proje etiketi · Proje filtresi · Projede sohbet sayısı · Başlıkta arama
 *   Bilgi      Kullanım göstergesi · Mesaj vurgusu · Mesaj saatleri · Model rengi
 *   Araçlar    Komut paleti (Alt+K) · Markdown'a aktar · Widget'ı yüzdür · Ayarları taşı
 *   Ortak      Genel (dil, tema, ölçek) · Klavye kısayolları · Tanı + kabul testi · Hakkında (yedek)
 *   Dil        Türkçe / English / tarayıcı dili; Alt+Shift+L, sayfa yenilenmeden değişir
 *
 * 1.x'TEN KALKANLAR
 *   Yüzen yazma kutusu, sohbet aksiyon butonları, uyarı satırı gizleme.
 *   Eski ayarlar (açık/kapalı tercihleri, şablonlar, proje renkleri) aynen okunur.
 *
 * NEDEN @grant none
 *   Kullanım göstergesi ve proje etiketleri sayfanın kendi isteklerini dinler.
 *   Bunun için betik sayfa bağlamında çalışmalı.
 */

/* global GM_info */
(function () {
  'use strict';

  /* =====================================================================
   * 1) SABİTLER
   * ===================================================================== */

  const UYGULAMA_ADI = 'AALabs Claude Suite';
  const UYGULAMA_ID = 'AALabs.ClaudeSuite';
  const SURUM = '2.1.0';
  const TEMA_SURUM = '1.4.1';
  const IKON_KODU = 'CLS';
  // Tampermonkey / Violentmonkey betik başlığındaki @version (yoksa null).
  function baslikSurumu() { try { return (typeof GM_info !== 'undefined' && GM_info.script && GM_info.script.version) || null; } catch (e) { return null; } }

  /* =====================================================================
   * 2) ÇEKİRDEK — kayıt defteri, ayar deposu, yaşam döngüsü, eylemler
   * ===================================================================== */

  // Anahtar 1.x ile aynı: eski açık/kapalı tercihleri taşınır.
  const SKEY = 'claude-suite:v1';
  const origFetch = window.fetch ? window.fetch.bind(window) : null;

  const MODULES = [];
  const byId = new Map();

  function define(def) {
    const m = Object.assign({ phase: 'ready', group: 'Araçlar', defaultOn: true }, def);
    m._live = false;
    m._ctx = null;
    m._err = null;
    MODULES.push(m);
    byId.set(m.id, m);
    return m;
  }

  function readPrefs() {
    try { return JSON.parse(localStorage.getItem(SKEY)) || {}; } catch (e) { return {}; }
  }
  function writePrefs(p) {
    try { localStorage.setItem(SKEY, JSON.stringify(p)); } catch (e) {}
  }

  let prefs = readPrefs();
  if (!prefs.modules) prefs.modules = {};
  // 1.x'te olup 2.0'da kalkan modüllerin tercihleri temizlenir.
  for (const eski of ['chatActions', 'floatComposer', 'hideNotices', 'promptOutline']) {
    delete prefs.modules[eski];
  }

  function pref(id) {
    const m = byId.get(id);
    if (!m) return false;
    const v = prefs.modules[id];
    return v === undefined ? m.defaultOn : !!v;
  }

  // Alt modül, üst modül kapalıyken çalışamaz.
  function effective(id) {
    const m = byId.get(id);
    if (!m) return false;
    if (!pref(id)) return false;
    return m.parent ? effective(m.parent) : true;
  }

  /* Eylem kaydı. Komut paleti ve panel buradan okur. Modül kapanınca
     eylemleri de kalkar (ctx.action ile kaydedildiyse). */
  const ACTIONS = new Set();

  // Kısa ömürlü tanı günlüğü: konsola gitmeden Tanı bölümünde görünür.
  const GUNLUK = [];
  function gunluk(kaynak, metin) {
    GUNLUK.push({ t: Date.now(), kaynak, metin: String(metin).slice(0, 300) });
    if (GUNLUK.length > 60) GUNLUK.shift();
  }

  /* Her modül kendi temizleyicisini toplar. off() çağrıldığında hepsi geri alınır. */
  function Lifecycle() {
    const jobs = [];
    return {
      on(t, ev, fn, opt) { t.addEventListener(ev, fn, opt); jobs.push(() => t.removeEventListener(ev, fn, opt)); },
      every(fn, ms) { const h = setInterval(fn, ms); jobs.push(() => clearInterval(h)); return h; },
      after(fn, ms) { const h = setTimeout(fn, ms); jobs.push(() => clearTimeout(h)); return h; },
      watch(target, cfg, fn) {
        const o = new MutationObserver(fn);
        o.observe(target, cfg);
        jobs.push(() => o.disconnect());
        return o;
      },
      resize(target, fn) {
        const o = new ResizeObserver(fn);
        if (target) o.observe(target);
        jobs.push(() => o.disconnect());
        return o;
      },
      css(text) {
        const el = document.createElement('style');
        el.textContent = text;
        (document.head || document.documentElement).appendChild(el);
        jobs.push(() => el.remove());
        return el;
      },
      node(el) { jobs.push(() => { if (el && el.remove) el.remove(); }); return el; },
      action(a) { ACTIONS.add(a); jobs.push(() => ACTIONS.delete(a)); return a; },
      undo(fn) { jobs.push(fn); },
      destroy() { while (jobs.length) { try { jobs.pop()(); } catch (e) {} } }
    };
  }

  function start(m) {
    if (m._live || !effective(m.id)) return;
    try {
      m._ctx = Lifecycle();
      m.on(m._ctx);
      m._live = true;
      m._err = null;
    } catch (e) {
      console.error('[' + UYGULAMA_ID + '] "' + m.id + '" açılamadı:', e);
      gunluk(m.id, 'açılamadı: ' + (e && e.message));
      m._err = e && e.message ? e.message : String(e);
      try { m._ctx && m._ctx.destroy(); } catch (e2) {}
      m._live = false;
    }
  }

  function stop(m) {
    if (!m._live) return;
    try { if (m.off) m.off(); } catch (e) { console.error('[' + UYGULAMA_ID + '] "' + m.id + '" kapanışı:', e); }
    try { m._ctx && m._ctx.destroy(); } catch (e) {}
    m._ctx = null;
    m._live = false;
  }

  let panelYenile = null;   // panel kurulunca atanır

  function sync() {
    for (const m of MODULES) {
      const want = effective(m.id) && (m.phase !== 'ready' || domReady);
      if (want && !m._live) start(m);
      else if (!want && m._live) stop(m);
    }
    if (panelYenile) panelYenile();
  }

  function setPref(id, v) {
    prefs.modules[id] = !!v;
    writePrefs(prefs);
    sync();
  }

  // Modüllere ait küçük ayarlar (ör. başlık kodları) aynı depoda durur.
  function ayarOku(anahtar, varsayilan) {
    if (!prefs.ayar) prefs.ayar = {};
    const v = prefs.ayar[anahtar];
    return v === undefined ? varsayilan : v;
  }
  function ayarYaz(anahtar, deger) {
    if (!prefs.ayar) prefs.ayar = {};
    prefs.ayar[anahtar] = deger;
    writePrefs(prefs);
  }

  let domReady = false;

  /* =====================================================================
   * 2a) PANO KORUMASI
   *
   * claude.ai belge seviyesinde bir yapıştırma yakalayıcısı tutuyor. Kendi
   * arayüzümüzdeki bir alana yapıştırınca olay yukarı kabarıp ona ulaşıyor
   * ve içerik sohbet kutusuna gidiyordu. Olayı kendi arayüzümüzden çıkarken
   * durduruyoruz. Dinleyici document-start'ta kuruluyor; sitenin kodundan
   * önce kaydolduğu için sıra deterministik. Varsayılan davranış iptal
   * edilmez: metin yine kendi alanına yapışır.
   * ===================================================================== */

  const UI_HOSTS = new Set();
  const UI_SELECTORS = new Set();

  function inOurUI(e) {
    const path = (e.composedPath && e.composedPath()) || [];
    for (const n of path) {
      if (UI_HOSTS.has(n)) return true;
      if (n && n.matches) {
        for (const s of UI_SELECTORS) {
          try { if (n.matches(s)) return true; } catch (err) {}
        }
      }
    }
    return false;
  }

  for (const type of ['paste', 'copy', 'cut', 'drop', 'dragover', 'dragenter']) {
    window.addEventListener(type, e => {
      if (inOurUI(e)) e.stopImmediatePropagation();
    }, true);
  }

  /* =====================================================================
   * 2b) PAYLAŞILAN AĞ DİNLEYİCİSİ
   * Tek fetch/XHR yaması kurulur, yanıtlar abonelere dağıtılır. Yama geri
   * alınamaz; yalnız gerektiğinde kurulur.
   * ===================================================================== */

  const NET = (function () {
    const SNIFF_RE = /(usage|rate[_-]?limit|limits|quota|entitl|credit|billing|spend|balance|wallet|payment|prepaid|overage|chat_conversations|conversations|projects|tasks)/i;
    const subs = new Set();
    let hooked = false;
    let wide = false;

    const abs = u => { try { return new URL(u, location.origin).href; } catch (e) { return u; } };
    const want = u => wide || SNIFF_RE.test(u);

    function emit(url, json) {
      for (const fn of [...subs]) { try { fn(url, json); } catch (e) {} }
    }

    function hook() {
      if (hooked) return;
      hooked = true;

      if (origFetch) {
        window.fetch = function (input, init) {
          const p = origFetch(input, init);
          try {
            const url = typeof input === 'string' ? input : (input && input.url) || '';
            if (want(url)) {
              p.then(res => {
                const ct = res.headers.get('content-type') || '';
                if (!res.ok || !ct.includes('json')) return;
                res.clone().json().then(j => emit(abs(url), j)).catch(() => {});
              }).catch(() => {});
            }
          } catch (e) {}
          return p;
        };
      }

      const XHR = window.XMLHttpRequest;
      if (XHR) {
        const open = XHR.prototype.open, send = XHR.prototype.send;
        XHR.prototype.open = function (m, url) { this.__netUrl = url; return open.apply(this, arguments); };
        XHR.prototype.send = function () {
          try {
            if (want(this.__netUrl || '')) {
              this.addEventListener('load', () => {
                try { emit(abs(this.__netUrl), JSON.parse(this.responseText)); } catch (e) {}
              });
            }
          } catch (e) {}
          return send.apply(this, arguments);
        };
      }
    }

    function istek(url, opts, govde) {
      if (!origFetch) return Promise.reject(new Error('fetch yok'));
      const o = Object.assign({ credentials: 'include', headers: { accept: 'application/json' } }, opts);
      if (govde !== undefined) {
        o.headers = Object.assign({ 'content-type': 'application/json' }, o.headers);
        o.body = JSON.stringify(govde);
      }
      return origFetch(url, o).then(r => {
        if (!r.ok) {
          const e = new Error('HTTP ' + r.status);
          e.status = r.status;
          throw e;
        }
        const ct = r.headers.get('content-type') || '';
        return ct.includes('json') ? r.json() : r.text();
      });
    }

    return {
      hook,
      sub(fn) { hook(); subs.add(fn); return () => subs.delete(fn); },
      setWide(v) { hook(); wide = !!v; },
      get(url, opts) { return istek(url, opts); },
      put(url, govde) { return istek(url, { method: 'PUT' }, govde); }
    };
  })();

  // Organizasyon kimlikleri birden çok modülün işine yarıyor, bir kez çözülür.
  let orgPromise = null;
  function orgUuid() {
    if (!orgPromise) {
      orgPromise = NET.get('/api/organizations')
        .then(j => (Array.isArray(j) ? j : []).map(o => o.uuid).filter(Boolean))
        .catch(() => []);
    }
    return orgPromise;
  }

  /* Bir sohbetin hangi organizasyonda olduğu bir kez bulunur. Birden çok
     organizasyonda diğerleri 403 döndürüp konsolu kirletmesin diye
     çalışan organizasyon hatırlanır. */
  async function orgSirasi() {
    const kayitli = ayarOku('sohbetOrg', null);
    const orgs = await orgUuid();
    return kayitli && orgs.includes(kayitli) ? [kayitli, ...orgs.filter(o => o !== kayitli)] : orgs;
  }

  // Organizasyonları sırayla dener; ilk başaranı hatırlar.
  async function orgIle(fn) {
    let sonHata = null;
    for (const o of await orgSirasi()) {
      try {
        const r = await fn(o);
        if (o !== ayarOku('sohbetOrg', null)) ayarYaz('sohbetOrg', o);
        return { org: o, sonuc: r };
      } catch (e) { sonHata = e; }
    }
    throw sonHata || new Error(_('Organizasyon bulunamadı'));
  }

  function suankiSohbet() {
    const m = location.pathname.match(/\/chat\/([0-9a-zA-Z_-]{20,})/);
    return m ? m[1] : null;
  }

  /* Sohbetin tam ağacı ve şu an görünen dal. Mesaj saatleri ve Markdown
     aktarımı aynı veriyi kullanır; kısa süre önbellekte tutulur. */
  const SOHBET_ONBELLEK = new Map();

  const SOHBET_YOLDA = new Map();   // aynı anda iki modül isterse tek istek gider

  function sohbetAgaci(chatId, taze) {
    const o = SOHBET_ONBELLEK.get(chatId);
    if (!taze && o && Date.now() - o.at < 15000) return Promise.resolve(o.veri);
    if (SOHBET_YOLDA.has(chatId)) return SOHBET_YOLDA.get(chatId);
    const p = orgIle(org => NET.get(`/api/organizations/${org}/chat_conversations/${chatId}` +
      '?tree=True&rendering_mode=messages&render_all_tools=true'))
      .then(({ org, sonuc: j }) => {
        const veri = { sohbet: j, dal: aktifDal(j), org };
        SOHBET_ONBELLEK.set(chatId, { at: Date.now(), veri });
        return veri;
      })
      .finally(() => SOHBET_YOLDA.delete(chatId));
    SOHBET_YOLDA.set(chatId, p);
    return p;
  }

  // Düzenlenen mesajlar ağaç oluşturur. Görünen dal = son yapraktan köke.
  function aktifDal(j) {
    const msgs = Array.isArray(j && j.chat_messages) ? j.chat_messages : [];
    if (!msgs.length) return [];
    const byUuid = new Map(msgs.map(m => [m.uuid, m]));
    let leaf = j.current_leaf_message_uuid && byUuid.get(j.current_leaf_message_uuid);
    if (!leaf) {
      const sirali = msgs.slice().sort((a, b) => (a.index ?? 0) - (b.index ?? 0));
      return sirali;
    }
    const dal = [];
    const gorulen = new Set();
    for (let m = leaf; m && !gorulen.has(m.uuid); m = byUuid.get(m.parent_message_uuid)) {
      gorulen.add(m.uuid);
      dal.push(m);
    }
    return dal.reverse();
  }

  const insanMi = m => /^(human|user)$/i.test(m && m.sender || '');

  function mesajMetni(m) {
    if (!m) return '';
    if (Array.isArray(m.content) && m.content.length) {
      const parcalar = [];
      for (const c of m.content) {
        if (!c) continue;
        if (c.type === 'text' && c.text) parcalar.push(c.text);
        else if (c.type === 'tool_use') parcalar.push('> ' + _('Araç') + ': ' + (c.name || _('araç')));
      }
      if (parcalar.length) return parcalar.join('\n\n');
    }
    return typeof m.text === 'string' ? m.text : '';
  }

  const p2 = n => String(n).padStart(2, '0');
  function saatYaz(ts) { const d = new Date(ts); return p2(d.getHours()) + ':' + p2(d.getMinutes()); }
  const AYLAR = { tr: ['Oca', 'Şub', 'Mar', 'Nis', 'May', 'Haz', 'Tem', 'Ağu', 'Eyl', 'Eki', 'Kas', 'Ara'],
    en: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'] };
  function tarihKisa(ts) { const d = new Date(ts); return DIL.aktif() === 'en' ? AYLAR.en[d.getMonth()] + ' ' + d.getDate() : d.getDate() + ' ' + AYLAR.tr[d.getMonth()]; }
  function tarihKod(ts) { const d = new Date(ts); return d.getFullYear() + '-' + p2(d.getMonth() + 1) + p2(d.getDate()); }
  function ayniGun(a, b) { return new Date(a).toDateString() === new Date(b).toDateString(); }

  /* =====================================================================
   * 2c) DİL (Türkçe + İngilizce, yeniden yüklemeden değişir)
   *
   * Kaynak dil Türkçe. Arayüz metni _('Türkçe metin') ile yazılır; İngilizce
   * karşılığı aşağıdaki EN sözlüğünden gelir. Sayı ya da ad içeren metin
   * _f('{0} proje', n) biçimindedir. Seçim: Türkçe / English / Tarayıcı dili.
   * Dil değişince DIL.degisince ile kaydolan her şey yeniden çizilir.
   * Kullanıcı verisi (sohbet adları, şablonlar, proje adları) çevrilmez.
   * ===================================================================== */

  const EN = {
    // @@EN-BASLA
    "Organizasyon bulunamadı": "Organisation not found",
    "Araç": "Tool",
    "araç": "tool",
    "Ayarlar": "Settings",
    "Komut paleti": "Command palette",
    "Şablon paleti": "Template palette",
    "Şablon yöneticisi": "Template manager",
    "Başlığı düzenle": "Edit title",
    "Markdown'a aktar": "Export to Markdown",
    "Sola sabitle aç/kapa": "Toggle pin left",
    "Sola sabitlemeyi yeniden hesapla": "Recalculate pin left",
    "Dil değiştir (TR/EN)": "Switch language (TR/EN)",
    "{0} tek başına kısayol olamaz; Ctrl ya da Alt ile birlikte bas.": "{0} cannot be a shortcut on its own; press it with Ctrl or Alt.",
    "{0} tarayıcının ya da claude.ai'nin tuşu; başka bir tuş seç.": "{0} belongs to the browser or claude.ai; pick another key.",
    "{0} zaten \"{1}\" için kullanılıyor.": "{0} is already used for \"{1}\".",
    "Enter yeni satır": "Enter adds a new line",
    "Enter mesajı göndermez, alt satıra geçer. Göndermek için gönder düğmesi ya da Ctrl+Enter.": "Enter does not send the message; it starts a new line. Send with the send button or Ctrl+Enter.",
    "Yazma": "Writing",
    "Oturum (C)": "Current session (C)",
    "Tüm modeller (A)": "All models (A)",
    "Kullanım kredisi (U)": "Usage credits (U)",
    "Ayarlar › Usage sayfasını bir kez aç": "Open Settings › Usage once",
    "Şimdi sıfırlanıyor": "Resetting now",
    "{0} dk sonra sıfırlanır": "Resets in {0} min",
    "{0} sa {1} dk sonra sıfırlanır": "Resets in {0} h {1} min",
    "{0} sıfırlanır": "Resets {0}",
    "veri yok": "no data",
    "{0} harcandı": "{0} spent",
    "aylık limitin %{0}'i": "{0}% of the monthly limit",
    "{0} bakiye": "{0} balance",
    "Henüz veri yok": "No data yet",
    "Son güncelleme: 1 dakikadan az önce": "Last update: less than a minute ago",
    "Son güncelleme: {0} dk önce": "Last update: {0} min ago",
    "Son güncelleme: {0}": "Last update: {0}",
    "çıkarım": "inferred",
    "Yenile": "Refresh",
    "Kullanım verisini yenile": "Refresh usage data",
    "Serbest bırak (sürüklenebilir)": "Float it (draggable)",
    "Sol menüye yerleştir": "Dock in the sidebar",
    "Ayrıntılar": "Details",
    "Ayrıntıları göster": "Show details",
    "Veri yok": "No data",
    "eski veri": "old data",
    "%{0} kullanıldı": "{0}% used",
    "sol menüde": "in sidebar",
    "serbest": "floating",
    "kurulmadı": "not set up",
    "Kullanım göstergesi": "Usage meter",
    "Limitleri sol menüde gösterir: C oturum, A tüm modeller, F Fable, U kullanım kredisi. Renk dolulukla değişir. Çift tıkla küçülür.": "Shows limits in the sidebar: C current session, A all models, F Fable, U usage credits. Colour changes with usage. Double-click to shrink.",
    "Bilgi": "Info",
    "Kullanım verisi yenilendi": "Usage data refreshed",
    "Mesaj vurgusu": "Message highlight",
    "Senin yazdığın mesajları mavi, kalın ve alıntı çubuklu gösterir. Kod blokları kendi renklerini ve normal kalınlığını korur.": "Shows your own messages blue, bold and with a quote bar. Code blocks keep their colours and normal weight.",
    "{0} mesajın bulundu": "{0} of your messages found",
    "Bu sohbette mesajın bulunamadı (seçici değişmiş olabilir)": "None of your messages found in this chat (the selector may have changed)",
    "Sohbet sayfasında çalışır": "Works on a chat page",
    "kapalı": "off",
    "Sohbeti sola sabitle": "Pin chat to the left",
    "Sohbet sütununu ortada bırakmak yerine sola yaslar. Sütun bulunamazsa yeniden hesapla kısayolunu dene.": "Aligns the chat column to the left instead of the centre. If the column is not found, try the recalculate shortcut.",
    "Yerleşim": "Layout",
    "Sohbet sütunu bulundu ve sola yaslandı": "Chat column found and pinned to the left",
    "Ortalanmış sohbet sütunu bulunamadı": "Centred chat column not found",
    "en yakın aday {0} px, boşluk sol {1} / sağ {2} px": "closest candidate {0} px, gap left {1} / right {2} px",
    "aday yok": "no candidate",
