  function dugme(yazi, kisayol, rol, ikonAd) {
    const b = el('button', { class: 'btn' + (rol ? ' ' + rol : ''), type: 'button' });
    if (ikonAd) b.append(ikonEl(ikonAd === 'kopya' ? 'kopya' : ikonAd));
