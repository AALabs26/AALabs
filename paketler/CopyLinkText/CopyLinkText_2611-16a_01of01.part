  // ---------------------------------------------------------------- sayfa teması
  function parlaklik(renk) {
    const m = /rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)(?:[,\s/]+([\d.]+))?/.exec(renk || '');
    if (!m) return null;
    if (m[4] !== undefined && Number(m[4]) === 0) return null;   // saydam
    const kanal = (v) => { v = Number(v) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };
    return 0.2126 * kanal(m[1]) + 0.7152 * kanal(m[2]) + 0.0722 * kanal(m[3]);
  }

  function koyuMu() {
    if (ayar.tema === 'acik') return false;
    if (ayar.tema === 'koyu') return true;
    for (const o of [document.body, document.documentElement]) {
      if (!o) continue;
      const l = parlaklik(getComputedStyle(o).backgroundColor);
      if (l !== null) return l < 0.18;
    }
    return !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
  }

  function temaUygula() { if (ev) ev.setAttribute('data-theme', koyuMu() ? 'dark' : 'light'); }

  // ---------------------------------------------------------------- ikonlar (Lucide 1.55.0, ISC)
  const SVG = 'http://www.w3.org/2000/svg';
  const IKON = {
    tamam: [['path', { d: 'M20 6 9 17l-5-5' }]],
    hata: [['circle', { cx: 12, cy: 12, r: 10 }], ['line', { x1: 12, x2: 12, y1: 8, y2: 12 }], ['line', { x1: 12, x2: 12.01, y1: 16, y2: 16 }]],
    kapat: [['path', { d: 'M18 6 6 18' }], ['path', { d: 'm6 6 12 12' }]],
    kopya: [['rect', { width: 14, height: 14, x: 8, y: 8, rx: 2, ry: 2 }], ['path', { d: 'M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2' }]],
    bilgi: [['circle', { cx: 12, cy: 12, r: 10 }], ['path', { d: 'M12 16v-4' }], ['path', { d: 'M12 8h.01' }]],
    git: [['path', { d: 'm9 18 6-6-6-6' }]],
  };

  function ikonEl(ad, boy = 16) {
    const s = document.createElementNS(SVG, 'svg');
    const oz = { viewBox: '0 0 24 24', width: boy, height: boy, fill: 'none', stroke: 'currentColor',
      'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true', focusable: 'false' };
