  const DEGISIKLIK = (function () {
    const VERI = [
    // @@CHG-BASLA
    {"s": "2611-16a", "t": "2026-11-16", "m": [{"k": "yeni", "tr": "**Link yazısını kopyala** · Fare linkin üstündeyken `Ctrl` + sağ tık linkin görünen yazısını panoya yazar; o tıklamada sağ tık menüsü açılmaz.", "n": "Firefox'taki Copy Link Text eklentisinin yerine.", "en": "**Copy link text** · With the mouse over a link, `Ctrl` + right-click copies the visible link text; no context menu opens on that click.", "w": "Replaces the Copy Link Text add-on in Firefox."}, {"k": "yeni", "tr": "İmlecin yanında 1,5 sn **Kopyalandı** balonu; metnin ilk 25 harfi de görünür.", "en": "A **Copied** bubble by the cursor for 1.5 s, with the first 25 letters of the text."}, {"k": "yeni", "tr": "Yazısız linkte (yalnız resim) linkin adresi kopyalanır.", "en": "On a link without text (image only) the link address is copied."}, {"k": "yeni", "tr": "[Ayarlar › Kopyalama](ayarlar:kopya) bölümünde kısayol `Alt` + sağ tık yapılabilir, balon kapatılabilir.", "en": "In [Settings › Copying](ayarlar:kopya) the shortcut can be `Alt` + right-click and the bubble can be turned off."}]},
    // @@CHG-BITIR
    ];
    const TURLER = [['yeni', _n('Yeni')], ['duzeldi', _n('Düzeldi')], ['degisti', _n('Değişti')], ['kaldirildi', _n('Kaldırıldı')]];
    const TUR_AD = Object.fromEntries(TURLER);
    let bilgiBekliyor = false;

    const CSS = `
    .chg-bilgi{display:flex;align-items:center;gap:8px;padding:8px 16px;background:var(--ana-acik);color:var(--metin)}
    .chg-bilgi svg{color:var(--vurgu);flex:none}
    .chg-arac{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:10px 16px 0}
    .chg-ara{max-width:320px;height:30px}
    .chg-icerik{display:grid;gap:16px;padding:12px 16px}
    .chg-surum-bas{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;margin:0 0 6px;font:600 15px/1.3 var(--yazi)}
    .chg-kod{font-variant-numeric:tabular-nums}
    .chg-tarih{font-size:12px;font-weight:400;color:var(--metin-ikincil)}
    .chg-rozet{display:inline-flex;align-items:center;min-height:20px;padding:0 6px;font-size:12px;font-weight:400;
      border-radius:var(--kose-m);background:var(--ana);color:var(--ana-uzeri)}
    .chg-atlanan{display:inline-flex;align-items:center;min-height:20px;padding:0 6px;font-size:12px;font-weight:400;
      color:var(--uyari);background:var(--uyari-bg);border:1px solid var(--uyari);border-radius:var(--kose-m)}
    .chg-liste{display:grid;gap:6px;margin:0;padding:0;list-style:none}
    .aalabs-degisiklik{display:flex;align-items:flex-start;gap:8px;min-width:0}
    .aalabs-degisiklik[data-tur="yeni"]{--tur:var(--basari);--tur-bg:var(--basari-bg)}
    .aalabs-degisiklik[data-tur="duzeldi"]{--tur:var(--vurgu);--tur-bg:var(--ana-acik)}
    .aalabs-degisiklik[data-tur="degisti"]{--tur:var(--uyari);--tur-bg:var(--uyari-bg)}
    .aalabs-degisiklik[data-tur="kaldirildi"]{--tur:var(--hata);--tur-bg:var(--hata-bg)}
    .chg-isaret{flex:none;min-width:78px}
    .chg-rz{display:inline-flex;justify-content:center;min-width:72px;min-height:20px;padding:0 6px;box-sizing:border-box;
      font-size:12px;color:var(--tur);background:var(--tur-bg);border:1px solid var(--tur);border-radius:var(--kose-m)}
    .chg-metin{min-width:0;overflow-wrap:anywhere}
    .chg-metin b{font-weight:600}
    .chg-metin s{color:var(--metin-ikincil)}
    .chg-metin .yeni-deger{font-weight:600;color:var(--basari)}
    .chg-metin kbd{padding:0 4px;font:inherit;font-size:12px;border:1px solid var(--kenar);border-radius:var(--kose-s)}
    .chg-git{all:unset;cursor:pointer;color:var(--vurgu);display:inline-flex;align-items:center;gap:2px}
    .chg-git svg{width:14px;height:14px}
    .chg-git:focus-visible{outline:2px solid var(--vurgu);outline-offset:1px}
    .aalabs-neden{display:block;margin-top:2px;font-size:12px;font-style:italic;color:var(--metin-ikincil)}
    .chg-alt{position:sticky;bottom:0;display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:8px 16px;border-top:1px solid var(--ayirici);background:var(--yuzey)}
    .chg-alt-not{margin-right:auto;font-size:12px;color:var(--metin-ikincil)}
    .chg-kutu{display:flex;align-items:center;gap:6px;min-height:28px;font-size:12px;cursor:pointer}
    .chg-kutu input{accent-color:var(--ana);margin:0}`;

    /* Satır içi biçim: **ad** · ~~eski~~ · ==yeni== · `tuş` · [yol](ayarlar:bölüm). innerHTML yok. */
    const SATIR_ICI = /\*\*(.+?)\*\*|~~(.+?)~~|==(.+?)==|`([^`]+)`|\[([^\]]+)\]\(([^)\s]+)\)/g;
    function satirIci(metin, git) {
      const f = document.createDocumentFragment();
      let son = 0, m;
      SATIR_ICI.lastIndex = 0;
      while ((m = SATIR_ICI.exec(metin))) {
        if (m.index > son) f.appendChild(document.createTextNode(metin.slice(son, m.index)));
        let el;
        if (m[1] !== undefined) { el = document.createElement('b'); el.textContent = m[1]; }
        else if (m[2] !== undefined) { el = document.createElement('s'); el.textContent = m[2]; }
        else if (m[3] !== undefined) { el = document.createElement('span'); el.className = 'yeni-deger'; el.textContent = m[3]; }
        else if (m[4] !== undefined) { el = document.createElement('kbd'); el.textContent = m[4]; }
        else {
          const hedef = (m[6].match(/^ayarlar:(.+)$/) || [])[1];
          el = document.createElement(hedef && git ? 'button' : 'span');
          el.textContent = m[5];
          if (hedef && git) {
            el.type = 'button';
            el.className = 'chg-git';
            el.title = _('Oraya git');
            el.insertAdjacentHTML('beforeend', ikon('git'));
            el.addEventListener('click', () => git(hedef));
          }
        }
        f.appendChild(el);
        son = SATIR_ICI.lastIndex;
      }
      if (son < metin.length) f.appendChild(document.createTextNode(metin.slice(son)));
      return f;
    }
    const duzMetin = s => String(s || '').replace(SATIR_ICI, (x, a, b, c, d, e) => a || b || c || d || e || '');
    const maddeMetni = x => (DIL.aktif() === 'en' && x.en ? x.en : x.tr);
    const nedenMetni = x => (DIL.aktif() === 'en' && x.w ? x.w : x.n);

    function tarihYaz(t) {
      const m = String(t || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
      return m ? m[3] + '.' + m[2] + '.' + m[1] : String(t || '');
    }

    /* Son görülen sürümle bu sürüm arasında kalanlar "Atladığın sürüm" olur. Karşılaştırma
       sürüm anahtarıyla: önceki sürüm listede olmasa da (maddesiz sürüm) doğru çalışır.
       YYMM-DDx her eski X.Y.Z'den yeni sayılır. */
    const anahtar = v => (/^\d{4}-\d{2}[a-z]*$/.test(v) ? '1' + v.slice(0, 7) + String(v.length).padStart(2, '0') + v.slice(7) : '0' + v);
    function atlananlar() {
      const onceki = ayarOku('degisiklikOnceki', null);
      if (!onceki) return new Set();
      const ust = anahtar(SURUM), alt = anahtar(onceki);
      return new Set(VERI.filter(v => { const k = anahtar(v.s); return k < ust && k > alt; }).map(v => v.s));
    }
    // Süzgeç ve arama pencere açık kaldıkça korunur (dil değişimi ya da yenileme bölümü baştan çizer).
    const durum = { tur: 'hepsi', sorgu: '' };

    /* Ayarlar sayfasına çizer. d: { sayfa, baslik, git, kapat, bilgi } */
    function ciz(d) {
      const { sayfa } = d;
      let { tur, sorgu } = durum;
      d.baslik(_('Değişiklikler'));
      if (d.bilgi) {
        const b = document.createElement('div');
        b.className = 'chg-bilgi';
        b.setAttribute('role', 'status');
        b.innerHTML = ikon('bilgi');
        const y = document.createElement('span');
        y.textContent = _('Yeni sürüm kuruldu. Bu pencere her yeni sürümde bir kez açılır.');
        b.appendChild(y);
        sayfa.appendChild(b);
      }

      const arac = document.createElement('div');
      arac.className = 'chg-arac';
      const seg = document.createElement('div');
      seg.className = 'seg';
      seg.setAttribute('role', 'radiogroup');
      seg.setAttribute('aria-label', _('Süzgeç'));
      const secenek = [['hepsi', _n('Tümü')], ...TURLER];
      const segDugme = secenek.map(([v, et], i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('role', 'radio');
        b.dataset.odak = 'chg-tur:' + v;
        b.textContent = _(et);
        b.addEventListener('click', () => { tur = durum.tur = v; isaretle(); listele(); });
        b.addEventListener('keydown', e => {
          const yon = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
          if (!yon) return;
          e.preventDefault();
          const j = (i + yon + secenek.length) % secenek.length;
          tur = durum.tur = secenek[j][0]; isaretle(); listele(); segDugme[j].focus();
        });
        seg.appendChild(b);
        return b;
      });
      function isaretle() {
        segDugme.forEach((b, i) => {
          const sec = secenek[i][0] === tur;
          b.setAttribute('aria-checked', sec ? 'true' : 'false');
          b.tabIndex = sec ? 0 : -1;
        });
      }
      const ara = document.createElement('input');
      ara.type = 'search';
      ara.className = 'girdi chg-ara';
      ara.dataset.odak = 'chg-ara';
      ara.placeholder = _('Değişikliklerde ara');
      ara.setAttribute('aria-label', _('Değişikliklerde ara'));
      ara.value = sorgu;
      ara.addEventListener('input', e => { if (e.isComposing) return; sorgu = durum.sorgu = ara.value.trim(); listele(); });
      ara.addEventListener('keydown', e => {
        if (e.key === 'Escape' && ara.value) { e.preventDefault(); e.stopPropagation(); ara.value = ''; sorgu = durum.sorgu = ''; listele(); }
      });
      arac.append(seg, ara);
      sayfa.appendChild(arac);

      const icerik = document.createElement('div');
      icerik.className = 'chg-icerik';
      sayfa.appendChild(icerik);

      const alt = document.createElement('div');
      alt.className = 'chg-alt';
      const altNot = document.createElement('span');
      altNot.className = 'chg-alt-not';
      altNot.setAttribute('aria-live', 'polite');
      const kutu = document.createElement('label');
      kutu.className = 'chg-kutu';
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.dataset.odak = 'chg-oto';
      cb.checked = ayarOku('degisiklikOtomatikKapali', false) === true;
      cb.addEventListener('change', () => ayarYaz('degisiklikOtomatikKapali', cb.checked));
      const kutuY = document.createElement('span');
      kutuY.textContent = _('Yeni sürümde otomatik açma');
      kutu.append(cb, kutuY);
      const kop = dugme(_('Kopyala'), { tr: 'K', en: 'C' }, '', 'kopya');
      kop.dataset.odak = 'chg-kopya';
      const tamam = dugme(_('Tamam'), { tr: 'T', en: 'O' }, 'ana');
      tamam.dataset.odak = 'chg-tamam';
      tamam.addEventListener('click', d.kapat);
      alt.append(altNot, kutu, kop, tamam);
      sayfa.appendChild(alt);

      let gorunen = [];
      function sec() {
        const t = fold(sorgu).split(/\s+/).filter(Boolean);
        return VERI.map(v => ({ v, m: v.m.filter(x => (tur === 'hepsi' || x.k === tur) &&
          (!t.length || t.every(w => fold(duzMetin(maddeMetni(x)) + ' ' + duzMetin(nedenMetni(x)) + ' ' + duzMetin(x.tr) + ' ' + v.s).includes(w)))) }))
          .filter(x => x.m.length);
      }
      function listele() {
        gorunen = sec();
        const atl = atlananlar();
        icerik.replaceChildren();   // CLT uyarlaması: Trusted Types sitelerinde düz dize atanamaz
        if (!gorunen.length) {
          const b = document.createElement('div');
          b.className = 'bos';
          b.textContent = VERI.length ? _('Bu süzgeçle değişiklik yok.') : _('Değişiklik kaydı yok.');
          icerik.appendChild(b);
        }
        for (const { v, m } of gorunen) {
          const sec2 = document.createElement('section');
          const h = document.createElement('h3');
          h.className = 'chg-surum-bas';
          const kod = document.createElement('span');
          kod.className = 'chg-kod';
          kod.textContent = v.s;
          h.appendChild(kod);
          if (v.s === SURUM) { const r = document.createElement('span'); r.className = 'chg-rozet'; r.textContent = _('Kurulu'); h.appendChild(r); }
          if (atl.has(v.s)) { const r = document.createElement('span'); r.className = 'chg-atlanan'; r.textContent = _('Atladığın sürüm'); h.appendChild(r); }
          const tr = document.createElement('span');
          tr.className = 'chg-tarih';
          tr.textContent = tarihYaz(v.t);
          h.appendChild(tr);
          const ul = document.createElement('ul');
          ul.className = 'chg-liste';
          for (const x of m) {
            const li = document.createElement('li');
            li.className = 'aalabs-degisiklik';
            if (x.k) li.dataset.tur = x.k;
            const is = document.createElement('span');
            is.className = 'chg-isaret';
            if (x.k) { const rz = document.createElement('span'); rz.className = 'chg-rz'; rz.textContent = _(TUR_AD[x.k]); is.appendChild(rz); }
            const mt = document.createElement('span');
            mt.className = 'chg-metin';
            mt.appendChild(satirIci(maddeMetni(x), d.git));
            const nd = nedenMetni(x);
            if (nd) { const n = document.createElement('span'); n.className = 'aalabs-neden'; n.textContent = (DIL.aktif() === 'en' ? 'Why: ' : 'Neden: ') + duzMetin(nd); mt.appendChild(n); }
            li.append(is, mt);
            ul.appendChild(li);
          }
          sec2.append(h, ul);
          icerik.appendChild(sec2);
        }
        const n = gorunen.reduce((a, x) => a + x.m.length, 0);
        altNot.textContent = _f('{0} sürüm · {1} değişiklik', gorunen.length, n);
      }
      kop.addEventListener('click', async () => {
        const metin = gorunen.map(({ v, m }) => v.s + ' — ' + tarihYaz(v.t) + '\n' +
          m.map(x => '- ' + (x.k ? _(TUR_AD[x.k]) + ': ' : '') + duzMetin(maddeMetni(x))).join('\n')).join('\n\n');
        const ok = await panoyaYaz(metin);
        bildir(ok ? _('Kopyalandı') : _('Kopyalanamadı'), ok ? 'basari' : 'hata');
      });
      isaretle();
      listele();
    }

    /* Açılışta: yeni sürüm ilk kez çalışıyorsa bir kez aç. İlk kurulumda açma.
       Önceki sürümler bu kaydı tutmuyordu: betik başlarken depo doluysa güncelleme sayılır.
       - ilkKayit(): betik başlarken hemen çalışır; ilk kurulumda görülen sürümü yazar
         (sekme 2,5 sn dolmadan kapanırsa sonraki açılış güncelleme sanılmasın).
       - acilista(ac, yaziyor): sekme görünürken ve kullanıcı bir alana yazmıyorken açar;
         değilse 3 sn'de bir yeniden dener. Görülen sürüm, pencere gerçekten açılınca yazılır.
         Karar her seferinde depodan taze okunur: aynı anda açık öteki sekme kazandıysa açılmaz. */
    const tazeAyar = k => { try { return ((readPrefs().ayar) || {})[k]; } catch (e) { return undefined; } };
    function ilkKayit() {
      if (!DEPO_VARDI && !tazeAyar('degisiklikGorulen')) ayarYaz('degisiklikGorulen', SURUM);
    }
    function acilista(ac, yaziyor) {
      const gorulen = tazeAyar('degisiklikGorulen') || null;
      if (gorulen === SURUM) return;
      if (anahtar(gorulen || '0') > anahtar(SURUM)) return;      // eski sürüme dönüldü: açma
      if (tazeAyar('degisiklikOtomatikKapali') === true || !VERI.some(v => v.s === SURUM)) {
        ayarYaz('degisiklikOnceki', gorulen); ayarYaz('degisiklikGorulen', SURUM); return;
      }
      if (document.visibilityState === 'hidden' || yaziyor()) { setTimeout(() => acilista(ac, yaziyor), 3000); return; }
      ayarYaz('degisiklikOnceki', gorulen);
      bilgiBekliyor = true;
      if (ac()) ayarYaz('degisiklikGorulen', SURUM);
      else { bilgiBekliyor = false; setTimeout(() => acilista(ac, yaziyor), 3000); }
    }
    function bilgiAl() {
      const b = bilgiBekliyor; bilgiBekliyor = false;
      durum.tur = 'hepsi'; durum.sorgu = '';                       // yeni pencere temiz başlar
      return b;
    }

    return { CSS, ciz, ilkKayit, acilista, bilgiAl };
  })();

  // ---------------------------------------------------------------- Tampermonkey menüsü
  let menuIdleri = [];
  let menuKayitli = false;
  let idsizMenu = false;
  function menuKaydet() {
    if (typeof GM_registerMenuCommand !== 'function') return;
    const silinebilir = typeof GM_unregisterMenuCommand === 'function' && !idsizMenu;
    if (menuKayitli && !silinebilir) return;   // silinemiyorsa ikinci kez eklenmez (çift satır olmasın)
    try {
      if (silinebilir) for (const id of menuIdleri) { try { GM_unregisterMenuCommand(id); } catch (_e) { /* yok */ } }
      menuIdleri = [];
      menuKayitli = true;
      const ekle = (ad, fn, harf) => {
        const id = GM_registerMenuCommand(ad, fn, harf);
        if (id === undefined || id === null) idsizMenu = true; else menuIdleri.push(id);
      };
      const tr = dilKodu() === 'tr';
      ekle(_('menuAyarlar'), () => panelAc(), tr ? 'a' : 's');
      ekle(_('menuDegisiklik'), () => panelAc('degisiklik'), tr ? 'd' : 'c');
    } catch (_e) { /* yönetici menüyü desteklemiyor */ }
  }

  // ---------------------------------------------------------------- Ayarlar paneli
  let panelBolum = 'kopya';
  let aramaMetni = '';
  let oncekiOdak = null;
  let kayit = null;          // kısayol kaydı sürerken { dinle }
  let tusHatasi = '';
  let ciziliyor = false;

  function panelAcik() { return !!(bil.panel && bil.panel.isConnected); }

  /** Kipli panel: Tab odağı panelin içinde döner. */
  function odakDongusu(e) {
    const ogeler = Array.from(bil.panel.querySelectorAll('button, input:not([type="file"]), [tabindex]:not([tabindex="-1"])'))
      .filter((o) => !o.disabled && o.getClientRects().length);
    if (!ogeler.length) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    const simdiki = ogeler.indexOf(kok.activeElement);
    const sonraki = simdiki < 0 ? 0 : (simdiki + (e.shiftKey ? -1 : 1) + ogeler.length) % ogeler.length;
    ogeler[sonraki].focus({ preventScroll: false });
  }

  function panelAc(bolum) {
    if (!document.body) return false;
    kokKur();
    temaUygula();
    if (bolum) panelBolum = bolum;
    if (!panelAcik() && document.activeElement !== ev) oncekiOdak = document.activeElement;
    if (!panelAcik()) {
      bil.perde = el('div', { class: 'perde', onpointerdown: (e) => { bil.perde.basladi = e.target === bil.perde; },
        onclick: (e) => { if (bil.perde.basladi && e.target === bil.perde) panelKapat(); } });
      bil.panel = el('div', { class: 'panel yazi', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'clt-baslik' });
      kok.append(bil.perde, bil.panel);
    }
    panelCiz();
    if (panelBolum !== 'degisiklik' && bil.ara) bil.ara.focus({ preventScroll: true });
    return true;
  }

  function panelKapat() {
    kayitBitir();
    if (bil.panel) bil.panel.remove();
    if (bil.perde) bil.perde.remove();
    kok.append(bil.yer);
    bil.panel = bil.perde = bil.ara = null;
    aramaMetni = '';
    tusHatasi = '';
    if (oncekiOdak && oncekiOdak.isConnected && typeof oncekiOdak.focus === 'function') {
      try { oncekiOdak.focus({ preventScroll: true }); } catch (_e) { /* yok */ }
    }
    oncekiOdak = null;
  }

  function ayarDegis(k, v) {
    ayar[k] = v;
    ayarlariYaz();
    if (k === 'dil') menuKaydet();
    if (k === 'tema') temaUygula();
    panelCiz();
  }

  function bolumSifirla(bolum) {
    for (const k of BOLUM_ANAHTAR[bolum] || []) ayar[k] = VARSAYILAN[k];
    ayarlariYaz();
    menuKaydet();
    temaUygula();
    tusHatasi = '';
    panelCiz();
    bildir(_('sifirlandi'), 'basari');
  }

  function anahtar(k, etiketId) {
    return el('button', { class: 'anahtar', type: 'button', role: 'switch', 'aria-checked': String(!!ayar[k]),
      'aria-labelledby': etiketId, 'data-ayar': k, onclick: () => ayarDegis(k, !ayar[k]) });
  }

  function segment(k, secenekler, etiketId) {
    const g = el('div', { class: 'seg', role: 'radiogroup', 'aria-labelledby': etiketId, 'data-ayar': k });
    for (const [deger, yazi] of secenekler) {
      g.append(el('button', { type: 'button', role: 'radio', 'aria-checked': String(ayar[k] === deger), 'data-deger': String(deger),
        onclick: () => ayarDegis(k, deger) }, yazi));
    }
    return g;
  }

  let etiketSayac = 0;
  function ayarSatiri(ad, aciklama, denetimKur) {
    const id = 'e' + (++etiketSayac);
    const s = el('div', { class: 'ayar' }, el('span', { id }, ad), denetimKur(id));
    if (aciklama) s.append(el('small', {}, aciklama));
    return s;
  }

  function sifirlaDugmesi(bolum) {
    return el('div', { class: 'satir-btn' }, el('button', { class: 'btn', type: 'button', 'data-sifirla': bolum, onclick: () => bolumSifirla(bolum) }, _('varsayilan')));
  }

  function bolumMetni(b) {
    const anahtarlar = {
      kopya: ['b_kopya', 'tus', 'tus_ctrl', 'tus_alt', 'balon', 'onizle', 'kopyaAlt', 'yazisizNot'],
      genel: ['b_genel', 'dil', 'tema', 'dil_tarayici', 'tema_sayfa'],
      kisayol: ['b_kisayol', 'k_ayarlar', 'k_kopyala'],
      degisiklik: ['b_degisiklik'],
      hakkinda: ['b_hakkinda', 'yedek', 'yedekle', 'geriYukle', 'store'],
    }[b];
    return katla(anahtarlar.map((k) => _(k)).join(' '));
  }

  function panelCiz() {
    kayitBitir();
    if (!panelAcik() || ciziliyor) return;
    ciziliyor = true;
    try {
      etiketSayac = 0;
      const p = bil.panel;
      const aramaOdakta = kok.activeElement === bil.ara;
      const imlec = bil.ara ? bil.ara.selectionStart : null;
      const odakSecici = odakSeciciBul(kok.activeElement);
      p.replaceChildren();
      p.setAttribute('lang', dilKodu());

      const kapat = el('button', { class: 'ikonbtn', type: 'button', title: _('kapat'), 'aria-label': _('kapat'), onclick: () => panelKapat() }, ikonEl('kapat'));
      p.append(el('div', { class: 'ust' }, el('span', { class: 'rozet', 'aria-hidden': 'true' }, KOD),
        el('h2', { id: 'clt-baslik' }, AD + ' · ' + _('ayarlar')), kapat));

      const arama = el('input', { type: 'search', placeholder: _('ara'), 'aria-label': _('ara') });
      arama.value = aramaMetni;
      arama.addEventListener('input', (e) => { if (e.isComposing) return; aramaMetni = arama.value; panelCiz(); });
      arama.addEventListener('compositionend', () => { aramaMetni = arama.value; panelCiz(); });
      bil.ara = arama;
      const nav = el('nav', { class: 'nav', 'aria-label': _('ayarlar') }, arama);
      const sorgu = katla(aramaMetni.trim());
      const uyan = (b) => !sorgu || bolumMetni(b).includes(sorgu);
      const tum = ['kopya', 'genel', 'kisayol', 'degisiklik', 'hakkinda'];
      const gorunen = tum.filter(uyan);
      if (gorunen.length && !gorunen.includes(panelBolum)) panelBolum = gorunen[0];
      const oge = (b) => el('button', { class: 'oge', type: 'button', title: _('b_' + b), 'aria-current': String(panelBolum === b), 'data-bolum': b,
        onclick: () => { panelBolum = b; tusHatasi = ''; panelCiz(); } }, el('span', {}, _('b_' + b)));
      const kendi = ['kopya'].filter(uyan);
      const ort = ['genel', 'kisayol', 'degisiklik', 'hakkinda'].filter(uyan);
      if (kendi.length) nav.append(el('div', { class: 'grup' }, KOD), ...kendi.map(oge));
      if (ort.length) nav.append(el('div', { class: 'grup' }, _('ortak')), ...ort.map(oge));
      if (!gorunen.length) nav.append(el('div', { class: 'yok', role: 'status' }, _('sonucYok')));

      const ic = el('div', { class: 'icerik' + (panelBolum === 'degisiklik' ? ' chg' : ''), 'data-icerik': panelBolum });
      if (gorunen.length) {
        if (panelBolum === 'degisiklik') bolumDegisiklik(ic);
        else {
          ic.append(el('h3', {}, _('b_' + panelBolum)));
          ({ kopya: bolumKopya, genel: bolumGenel, kisayol: bolumKisayol, hakkinda: bolumHakkinda })[panelBolum](ic);
        }
      }
      p.append(el('div', { class: 'govde' }, nav, ic));
      if (bil.kutu && bil.kutu.classList.contains('acik')) p.append(bil.yer);
      if (aramaOdakta) {
        arama.focus({ preventScroll: true });
        if (imlec !== null) { try { arama.setSelectionRange(imlec, imlec); } catch (_e) { /* yok */ } }
      } else if (odakSecici) {
        let hedef = null;
        try { hedef = p.querySelector(odakSecici); } catch (_e) { hedef = null; }
        if (hedef) hedef.focus({ preventScroll: true });
      }
    } finally {
      ciziliyor = false;
    }
  }

  function odakSeciciBul(o) {
    if (!o || o === bil.ara || !o.getAttribute) return '';
    const q = (ad) => `[${ad}="${CSS.escape(o.getAttribute(ad))}"]`;
    if (o.hasAttribute('data-deger') && o.parentElement && o.parentElement.hasAttribute('data-ayar')) {
      return `[data-ayar="${CSS.escape(o.parentElement.getAttribute('data-ayar'))}"] ${q('data-deger')}`;
    }
    for (const ad of ['data-ayar', 'data-bolum', 'data-sifirla', 'data-kisayol', 'data-yedekle', 'data-geri-yukle', 'data-odak']) {
      if (o.hasAttribute(ad)) return q(ad);
    }
    return '';
  }

  function bolumKopya(ic) {
    ic.append(el('p', { class: 'alt' }, _('kopyaAlt')));
    ic.append(ayarSatiri(_('tus'), _('tusAc'), (id) => segment('tus', [['ctrl', _('tus_ctrl')], ['alt', _('tus_alt')]], id)));
    ic.append(ayarSatiri(_('balon'), _('balonAc'), (id) => anahtar('balon', id)));
    ic.append(ayarSatiri(_('onizle'), _('onizleAc'), (id) => anahtar('onizle', id)));
    ic.append(el('p', { class: 'alt', style: 'margin:0' }, _('yazisizNot')));
    ic.append(sifirlaDugmesi('kopya'));
  }

  function bolumGenel(ic) {
    const algi = _('algilanan', { dil: tarayiciDili() === 'tr' ? 'Türkçe' : 'English' });
    ic.append(ayarSatiri(_('dil'), algi, (id) => segment('dil', [['tr', _('dil_tr')], ['en', _('dil_en')], ['tarayici', _('dil_tarayici')]], id)));
    ic.append(ayarSatiri(_('tema'), '', (id) => segment('tema', [['sayfa', _('tema_sayfa')], ['acik', _('tema_acik')], ['koyu', _('tema_koyu')]], id)));
    ic.append(sifirlaDugmesi('genel'));
  }

  function bolumKisayol(ic) {
    ic.append(el('p', { class: 'alt' }, _('kisayolNot')));
    const hataYeri = el('div', { class: 'uyari-satir', role: 'alert' }, tusHatasi);
    const tus = el('button', { class: 'tus', type: 'button', 'data-kisayol': 'kisayolAyarlar' }, ayar.kisayolAyarlar);
    tus.addEventListener('click', () => kayitBasla(tus));
    ic.append(ayarSatiri(_('k_ayarlar'), '', (id) => { tus.setAttribute('aria-labelledby', id); return tus; }));
    if (tusHatasi) ic.append(hataYeri);
    ic.append(ayarSatiri(_('k_kopyala'), _('k_kopyalaAc'), () => el('span', { class: 'tus', 'aria-disabled': 'true' }, _('tus_' + ayar.tus))));
    ic.append(sifirlaDugmesi('kisayol'));
  }

  function kayitBasla(tus) {
    kayitBitir();
    tus.classList.add('kayit');
    tus.textContent = _('tusaBas');
    const dinle = (e) => {
      if (!e.isTrusted) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      if (e.repeat) return;
      if (e.key === 'Escape') { kayitBitir(); panelCiz(); return; }
      const kombo = tusKombo(e);
      if (!kombo) return;                       // yalnız değiştirici basıldı: beklemeye devam
      const neden = tusGecerliMi(kombo);
      kayitBitir();
      if (neden) { tusHatasi = _('tusRed', { tus: kombo, neden: _(neden) }); panelCiz(); return; }
      tusHatasi = '';
      ayarDegis('kisayolAyarlar', kombo);
      bildir(_('tusDegisti', { tus: kombo }), 'basari');
    };
    const bitir = () => { if (kayit) { kayitBitir(); panelCiz(); } };
    kayit = { dinle, bitir, tus };
    window.addEventListener('keydown', dinle, true);
    tus.addEventListener('blur', bitir, { once: true });   // odak kaybında kayıt biter (g7snk)
  }

  function kayitBitir() {
    if (!kayit) return;
    window.removeEventListener('keydown', kayit.dinle, true);
    try { kayit.tus.removeEventListener('blur', kayit.bitir); } catch (_e) { /* yok */ }
    kayit = null;
  }

  function bolumDegisiklik(ic) {
    try {
      DEGISIKLIK.ciz({
        sayfa: ic,
        baslik: (t) => ic.append(el('h3', {}, t)),
        kapat: () => panelKapat(),
        bilgi: DEGISIKLIK.bilgiAl(),
        git: (hedef) => { panelBolum = hedef; panelCiz(); },
      });
    } catch (_e) {
      ic.replaceChildren(el('h3', {}, _('b_degisiklik')), el('p', { class: 'bos' }, _('Değişiklik kaydı yok.')));
    }
  }

  function bolumHakkinda(ic) {
    ic.append(el('p', { style: 'margin:0' }, _('surum', { s: SURUM })), el('p', { class: 'alt', style: 'margin:0' }, _('store')));
    ic.append(el('h4', {}, _('yedek')), el('p', { class: 'alt', style: 'margin:0' }, _('yedekAc')));
    ic.append(el('p', { class: 'alt', style: 'margin:0', 'data-son-yedek': '' }, ayar.sonYedek ? _('sonYedek', { t: ayar.sonYedek }) : _('sonYedekYok')));
    const dosya = el('input', { type: 'file', accept: '.json,application/json', class: 'gizli', 'aria-hidden': 'true', tabindex: '-1' });
    dosya.addEventListener('change', () => { if (dosya.files && dosya.files[0]) geriYukle(dosya.files[0]); });
    ic.append(dosya, el('div', { class: 'satir-btn sol' },
      el('button', { class: 'btn', type: 'button', 'data-yedekle': '', onclick: () => yedekle() }, _('yedekle')),
      el('button', { class: 'btn', type: 'button', 'data-geri-yukle': '', onclick: () => dosya.click() }, _('geriYukle'))));
  }

  function zamanDamgasi() {
    const d = new Date();
    const p = (n) => String(n).padStart(2, '0');
    return `${String(d.getFullYear()).slice(2)}${p(d.getMonth() + 1)}-${p(d.getDate())}-${p(d.getHours())}${p(d.getMinutes())}`;
  }

  function yedekle() {
    const damga = zamanDamgasi();
    const ayarKopya = Object.assign({}, ayar);
    delete ayarKopya.sonYedek;
    const veri = JSON.stringify({ uygulama: ID, surum: SURUM, tarih: damga, ayarlar: ayarKopya }, null, 2);
    // data: adresi (Blob değil): Firefox'ta betik ayrı bağlamda çalışınca Blob adresi sayfadan inmeyebilir
    const a = el('a', { href: 'data:application/json;charset=utf-8,' + encodeURIComponent(veri), download: `CLT_AYARLAR_${damga}.json` });
    kok.appendChild(a);
    a.click();
    a.remove();
    ayar.sonYedek = damga;
    ayarlariYaz();
    panelCiz();
    bildir(_('yedeklendi'), 'basari');
  }

  function geriYukle(dosya) {
    if (dosya.size > 64 * 1024) { bildir(_('yedekHata'), 'hata'); return; }
    const okuyucu = new FileReader();
    okuyucu.onload = () => {
      try {
        const v = JSON.parse(String(okuyucu.result));
        if (!v || v.uygulama !== ID || !v.ayarlar || typeof v.ayarlar !== 'object' || Array.isArray(v.ayarlar)) throw new Error('biçim');
        const sonYedek = ayar.sonYedek;
        ayar = ayarDogrula(v.ayarlar);
        ayar.sonYedek = sonYedek;
        ayarlariYaz();
        menuKaydet();
        temaUygula();
        panelCiz();
        bildir(_('geriYuklendi'), 'basari');
      } catch (_e) {
        bildir(_('yedekHata'), 'hata');
      }
    };
    okuyucu.onerror = () => bildir(_('yedekHata'), 'hata');
    okuyucu.readAsText(dosya);
  }

  // ---------------------------------------------------------------- klavye (Ayarlar kısayolu, panel içi)
  function tusBasildi(e) {
    if (!e.isTrusted || kayit) return;
    if (panelAcik()) {
      if (e.key === 'Escape') { e.preventDefault(); e.stopImmediatePropagation(); panelKapat(); return; }
      if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && e.code === 'KeyF') {
        e.preventDefault(); e.stopImmediatePropagation(); if (bil.ara) bil.ara.focus(); return;
      }
      if (e.key === 'Tab' && !e.ctrlKey && !e.altKey && !e.metaKey) { odakDongusu(e); return; }
    }
    if (!(e.ctrlKey || e.metaKey || e.altKey)) return;     // yalnız değiştiricili kombo (yazı yazarken tetiklenmesin)
    const kombo = tusKombo(e);
    if (!kombo || kombo !== ayar.kisayolAyarlar || e.repeat) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    if (panelAcik()) panelKapat(); else panelAc();
  }
  window.addEventListener('keydown', tusBasildi, true);

  // ---------------------------------------------------------------- açılış
  function yaziyor() { const a = document.activeElement; return !!(a && a !== ev && duzenlenebilirMi(a)); }

  function basla() {
    DEGISIKLIK.acilista(() => (panelAcik() ? false : panelAc('degisiklik')), yaziyor);
  }

  if (!DEPO_VARDI) ayarlariYaz();          // ilk kurulumu işaretle (sonraki açılış güncelleme sayılsın)
  DEGISIKLIK.ilkKayit();
  menuKaydet();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => setTimeout(basla, 2500), { once: true });
  else setTimeout(basla, 2500);

  if (TEST && window.__AALABS_TEST__ && typeof window.__AALABS_TEST__ === 'object') {
    window.__AALABS_TEST__.clt = { metin: METIN, ayar: () => ayar, kok: () => kok, panelAc, panelKapat, linkMetni };
  }
})();
