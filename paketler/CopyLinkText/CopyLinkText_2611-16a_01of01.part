  // ---------------------------------------------------------------- arayüz (Shadow DOM)
  const ARAYUZ_CSS = `
:host { all: initial; }
* { box-sizing: border-box; }
[hidden] { display: none !important; }
.yazi { font: 400 13px/1.45 var(--yazi); color: var(--metin); }
button, input { font: inherit; color: inherit; }
button:focus-visible, input:focus-visible, [tabindex]:focus-visible { outline: 2px solid var(--vurgu); outline-offset: 1px; }

/* Balon: imlecin yanında (tasarım: Bildirim A) */
.balon { position: fixed; z-index: 2147483647; display: flex; align-items: center; gap: 6px; max-width: min(320px, calc(100vw - 16px));
  padding: 4px 10px; border-radius: var(--kose-m); font: 400 13px/1.4 var(--yazi); pointer-events: none;
  opacity: 0; transition: opacity 120ms linear; overflow-wrap: anywhere; }
.balon.acik { opacity: 1; }
.balon.basari { background: var(--basari-bg); color: var(--metin); border: 1px solid var(--basari); }
.balon.basari svg { color: var(--basari); }
.balon.hata { background: var(--hata-bg); color: var(--hata); border: 1px solid var(--hata); }
.balon svg { flex: none; }

/* Alt orta bildirim (Ayarlar işleri: yedek, kısayol) */
.yer { position: fixed; left: 0; right: 0; bottom: 32px; display: flex; justify-content: center; pointer-events: none; z-index: 2147483647; }
.kutu { display: flex; align-items: center; gap: var(--bosluk-2); max-width: min(480px, calc(100vw - 32px));
  min-height: var(--kontrol); padding: 0 var(--bosluk-3); border-radius: var(--kose-m); font: 400 13px/1.4 var(--yazi);
  opacity: 0; transition: opacity 120ms linear; }
.kutu.acik { opacity: 1; }
.kutu.basari { background: var(--basari-bg); color: var(--basari); border-left: 3px solid var(--basari); }
.kutu.hata { background: var(--hata-bg); color: var(--hata); border-left: 3px solid var(--hata); }

/* Ayarlar paneli (ortada pencere) */
.perde { position: fixed; inset: 0; background: color-mix(in srgb, var(--metin) 35%, transparent); z-index: 2147483646; }
:host([data-theme="dark"]) .perde { background: color-mix(in srgb, var(--zemin) 60%, transparent); }
.panel { position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 2147483647;
  width: min(760px, calc(100vw - 32px)); height: min(520px, calc(100vh - 32px));
  display: grid; grid-template-rows: 44px minmax(0, 1fr); background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--ayirici); border-radius: var(--kose-l); font: 400 13px/1.45 var(--yazi); }
.ust { display: flex; align-items: center; gap: 10px; padding: 0 6px 0 14px; border-bottom: 1px solid var(--ayirici); min-width: 0; }
.rozet { width: 22px; height: 22px; border-radius: var(--kose-m); background: var(--ana); color: var(--ana-uzeri);
  font: 600 8px/22px var(--yazi); text-align: center; letter-spacing: .02em; flex: none; }
.ust h2 { flex: 1; min-width: 0; margin: 0; font: 600 14px/1.3 var(--yazi); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ikonbtn { width: 32px; height: 32px; border: 1px solid transparent; border-radius: var(--kose-s); background: transparent;
  cursor: pointer; display: inline-grid; place-items: center; }
.ikonbtn:hover { background: var(--ana-hover); }
.govde { display: grid; grid-template-columns: 196px minmax(0, 1fr); min-height: 0; }
.nav { border-right: 1px solid var(--ayirici); padding: 8px; display: flex; flex-direction: column; gap: 2px; overflow: auto; min-height: 0; }
.nav input { height: 28px; padding: 0 8px; border: 1px solid var(--kenar); border-radius: var(--kose-s);
  background: var(--yuzey); margin-bottom: 6px; width: 100%; }
.nav input::placeholder { color: var(--metin-ikincil); }
.grup { font: 600 11px/1.3 var(--yazi); letter-spacing: .06em; color: var(--metin-ikincil); padding: 8px 8px 2px; }
.nav .oge { text-align: left; min-height: 28px; padding: 0 8px; border: 0; border-radius: var(--kose-s); background: transparent;
  cursor: pointer; display: flex; align-items: center; gap: 6px; min-width: 0; }
.nav .oge span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.nav .oge[aria-current="true"] { background: var(--ana-acik); font-weight: 600; }
.nav .oge:hover { background: var(--ana-hover); }
.nav .yok { color: var(--metin-ikincil); padding: 6px 8px; }
.icerik { padding: 14px 18px; overflow: auto; display: flex; flex-direction: column; gap: 12px; min-width: 0; min-height: 0; }
.icerik.chg { padding: 0; gap: 0; }
.icerik h3 { margin: 0; font: 600 15px/1.3 var(--yazi); }
.icerik.chg > h3 { padding: 14px 18px 0; }
.icerik h4 { margin: 4px 0 0; font: 600 13px/1.3 var(--yazi); }
.alt { color: var(--metin-ikincil); margin: -6px 0 0; }
.ayar { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--ayirici); }
.ayar small { grid-column: 1 / -1; color: var(--metin-ikincil); font-size: 12px; }
.anahtar { width: 36px; height: 20px; border-radius: 10px; border: 1px solid var(--kenar); background: var(--yuzey); position: relative; cursor: pointer; padding: 0; }
.anahtar::after { content: ""; position: absolute; top: 3px; left: 3px; width: 12px; height: 12px; border-radius: 50%; background: var(--kenar); transition: left 120ms linear; }
.anahtar[aria-checked="true"] { background: var(--ana); border-color: var(--ana); }
.anahtar[aria-checked="true"]::after { left: 19px; background: var(--ana-uzeri); }
.seg { display: inline-flex; flex-wrap: wrap; justify-content: flex-end; }
.seg button { height: 28px; padding: 0 10px; border: 1px solid var(--kenar); background: var(--yuzey); margin-left: -1px; cursor: pointer; white-space: nowrap; }
.seg button:first-child { margin-left: 0; border-radius: var(--kose-s) 0 0 var(--kose-s); }
.seg button:last-child { border-radius: 0 var(--kose-s) var(--kose-s) 0; }
.seg button[aria-checked="true"] { background: var(--ana); border-color: var(--ana); color: var(--ana-uzeri); position: relative; z-index: 1; }
.seg button:hover:not([aria-checked="true"]) { background: var(--ana-hover); }
.tus { min-width: 104px; height: 28px; padding: 0 8px; border: 1px solid var(--kenar); border-radius: var(--kose-s); background: var(--zemin);
  font-weight: 600; cursor: pointer; }
.tus[aria-disabled="true"] { cursor: default; opacity: .7; display: inline-flex; align-items: center; justify-content: center; }
.tus.kayit { border-color: var(--vurgu); color: var(--vurgu); }
.uyari-satir { color: var(--hata); font-size: 12px; }
.btn { min-height: 32px; padding: 0 12px; border: 1px solid var(--kenar); border-radius: var(--kose-s); background: var(--yuzey);
  cursor: pointer; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
.btn:hover { background: var(--ana-hover); }
.btn.ana { background: var(--ana); border-color: var(--ana); color: var(--ana-uzeri); }
.btn.ana:hover { filter: brightness(1.08); background: var(--ana); }
.girdi { height: 28px; padding: 0 8px; border: 1px solid var(--kenar); border-radius: var(--kose-s); background: var(--yuzey); min-width: 0; }
.bos { color: var(--metin-ikincil); }
.satir-btn { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; margin-top: auto; padding-top: 8px; }
.satir-btn.sol { justify-content: flex-start; margin-top: 0; padding-top: 0; }
.gizli { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
@media (max-width: 560px) { .govde { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); }
  .nav { border-right: 0; border-bottom: 1px solid var(--ayirici); flex-direction: row; flex-wrap: wrap; max-height: 40vh; }
  .nav input { flex: 1 0 100%; } .grup { display: none; } }
@media (prefers-reduced-motion: reduce) { .balon, .kutu, .anahtar::after { transition: none; } }
`;

  let ev = null;      // <aalabs-clt> barındırıcı
  let kok = null;     // gölge kök
  const bil = { balon: null, balonSayac: 0, yer: null, kutu: null, kutuSayac: 0, perde: null, panel: null, ara: null };

  function kokKur() {
    if (ev) { if (!ev.isConnected) (document.body || document.documentElement).appendChild(ev); return; }
    ev = document.createElement('aalabs-clt');
    ev.setAttribute('data-aalabs', ID);
    kok = ev.attachShadow({ mode: TEST ? 'open' : 'closed' });
    const css = TEMA_CSS + ARAYUZ_CSS + DEGISIKLIK.CSS;
    let eklendi = false;
    try { const s = new CSSStyleSheet(); s.replaceSync(css); kok.adoptedStyleSheets = [s]; eklendi = true; } catch (_e) { /* eski tarayıcı */ }
    if (!eklendi) kok.appendChild(el('style', { text: css }));
    // Gölge kökteki yazı alanında sitenin tek harfli kısayolları çalışmasın (platform-userscript.md §1.5)
    for (const t of ['keydown', 'keypress', 'keyup']) {
      kok.addEventListener(t, (e) => { if (e.target && /^(INPUT|TEXTAREA)$/.test(e.target.tagName)) e.stopPropagation(); });
    }
    bil.balon = el('div', { class: 'balon', role: 'status', 'aria-live': 'polite', hidden: true });
    bil.yer = el('div', { class: 'yer' });
    bil.kutu = el('div', { class: 'kutu', role: 'status', 'aria-live': 'polite' });
    bil.yer.append(bil.kutu);
    kok.append(bil.balon, bil.yer);
    temaUygula();
    (document.body || document.documentElement).appendChild(ev);
  }

  function balonGoster(x, y, yazi, tur) {
    kokKur();
    temaUygula();
    const b = bil.balon;
    clearTimeout(bil.balonSayac);
    b.className = 'balon yazi ' + tur;
    b.setAttribute('role', tur === 'hata' ? 'alert' : 'status');
    b.replaceChildren(ikonEl(tur === 'hata' ? 'hata' : 'tamam', 14), el('span', {}, yazi));
    b.hidden = false;
    b.style.left = '0px';
    b.style.top = '0px';
    const r = b.getBoundingClientRect();
    const sol = Math.max(8, Math.min(x + 14, window.innerWidth - r.width - 8));
    const ust = y + 18 + r.height > window.innerHeight - 8 ? Math.max(8, y - r.height - 10) : y + 18;
    b.style.left = sol + 'px';
    b.style.top = ust + 'px';
    requestAnimationFrame(() => b.classList.add('acik'));
    bil.balonSayac = setTimeout(() => {
      b.classList.remove('acik');
      bil.balonSayac = setTimeout(() => { b.hidden = true; }, 150);
    }, tur === 'hata' ? BALON_MS * 2 : BALON_MS);
  }

  /** Alt orta bildirim; açık panel varsa onun içinde (top layer kuralı). bildir(yazi, tur) — Değişiklikler parçasıyla aynı sıra. */
  function bildir(yazi, tur) {
    kokKur();
    temaUygula();
    clearTimeout(bil.kutuSayac);
    if (panelAcik()) bil.panel.append(bil.yer); else kok.append(bil.yer);
    bil.kutu.className = 'kutu ' + (tur || 'basari');
    bil.kutu.setAttribute('role', tur === 'hata' ? 'alert' : 'status');
    bil.kutu.replaceChildren(ikonEl(tur === 'hata' ? 'hata' : 'tamam'), el('span', {}, yazi));
    requestAnimationFrame(() => bil.kutu.classList.add('acik'));
    bil.kutuSayac = setTimeout(() => bil.kutu.classList.remove('acik'), tur === 'hata' ? 4000 : 2000);
  }

  // ---------------------------------------------------------------- Değişiklikler parçasının depo yardımcıları
  function readPrefs() { const v = depoOku('degisiklik', null); return { ayar: v && typeof v === 'object' ? v : {} }; }
  function ayarOku(k, varsayilan) { const a = readPrefs().ayar; return k in a ? a[k] : varsayilan; }
  function ayarYaz(k, v) { const a = Object.assign({}, readPrefs().ayar); a[k] = v; depoYaz('degisiklik', a); }

  // ==== Değişiklikler parçası (app-lab assets/userscript/degisiklik.js 2611-10a). Uyarlama: innerHTML'e giden dizeler
  // guvenliHtml'den geçer (Trusted Types sitelerinde parça yoksa hata veriyordu). ====
  /* AALabs userscript parçası — Değişiklikler (CHG) · app-lab 2611-10a (kaynak: CLS 2611-09g)
