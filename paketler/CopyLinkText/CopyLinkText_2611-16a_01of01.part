// ==UserScript==
// @name         AALabs Copy Link Text
// @name:tr      AALabs Copy Link Text
// @name:en      AALabs Copy Link Text
// @namespace    aalabs
// @version      26.11.16.1
// @description  Fare linkin üstündeyken Ctrl + sağ tık linkin yazısını panoya kopyalar. Her sitede çalışır.
// @author       AALabs
// @match        *://*/*
// @icon         data:image/png;base64,
// @updateURL    http://127.0.0.1:47815/u/AALabs.CopyLinkText.user.js
// @downloadURL  http://127.0.0.1:47815/u/AALabs.CopyLinkText.user.js
// @run-at       document-start
// @noframes
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_unregisterMenuCommand
// @grant        GM_setClipboard
// @grant        GM.setClipboard
// @grant        GM_info
// @aalabs-ikon  CLT
// ==/UserScript==

/*
 * Ne yapar
 *   Fare bir linkin üstündeyken Ctrl + sağ tık (Ayarlar'dan Alt + sağ tık) linkin görünen yazısını panoya yazar.
 *   O tıklamada sayfanın sağ tık menüsü açılmaz. İmlecin yanında 1,5 sn "Kopyalandı · <ilk 25 harf>" balonu çıkar.
 *   Yazısız linkte (yalnız resim) linkin adresi kopyalanır. Fazla boşluk ve satır sonu tek boşluğa iner.
 *
 * Neye dokunmaz
 *   - Değiştiricisiz sağ tık ve Shift + sağ tık (Firefox Shift + sağ tıkta menüyü her zaman açar; sayfa engelleyemez).
 *   - Yazı alanları (input, textarea, düzenlenebilir alan).
 *   - Sayfada seçili yazı varken (normal menü açılır; seçimle kopyalama bozulmaz).
 *   - Linkten başka öğeler.
 *
 * Firefox'taki "Copy Link Text" eklentisinin yerine yazıldı. Tasarım kapısı: CLT son · Kısayol E · Bildirim A ·
 * Yazısız B · +E1 · -Ç1 (Tanı bölümü yok: betik sayfa parçası aramaz).
 */
(function () {
  'use strict';

  const SURUM = '2611-16a';
  const ID = 'CopyLinkText';
  const KOD = 'CLT';
  const AD = 'AALabs Copy Link Text';
  const BALON_MS = 1500;          // balon süresi (tasarım: 1,5 sn)
  const ONIZLEME_HARF = 25;       // balonda gösterilen metin başı (E1)

  let TEST = false;
  try { TEST = typeof GM_info === 'object' && !!GM_info && GM_info.scriptHandler === 'Test'; } catch (_e) { TEST = false; }

  // ---------------------------------------------------------------- tema tokenları (aalabs-tema.css'ten üretildi)
  // TOKEN-BASLA
  const TEMA_CSS = ":host { --tv-olcek: 1; --yazi: \"Open Sans\", \"Segoe UI\", Roboto, sans-serif; --yazi-govde: calc(14px * var(--tv-olcek)); --kontrol: calc(32px * var(--tv-olcek)); --kose-s: calc(2px * var(--tv-olcek)); --kose-m: calc(4px * var(--tv-olcek)); --kose-l: calc(6px * var(--tv-olcek)); --bosluk-1: calc(4px * var(--tv-olcek)); --bosluk-2: calc(8px * var(--tv-olcek)); --bosluk-3: calc(12px * var(--tv-olcek)); --bosluk-4: calc(16px * var(--tv-olcek)); --bosluk-5: calc(24px * var(--tv-olcek)); --bosluk-6: calc(32px * var(--tv-olcek)); --ana: #2456D6; --ana-acik: #E5EBFA; --ana-hover: #F2F5FD; --ana-uzeri: #FFFFFF; --vurgu: #2456D6; --zemin: #F6F9FC; --yuzey: #FFFFFF; --metin: #17252E; --metin-ikincil: #4E6269; --kenar: #7A9199; --ayirici: #D3DEE6; --basari: #18763F; --basari-bg: #E4F5E8; --uyari: #9A5B00; --uyari-bg: #FDF6D8; --hata: #C4313B; --hata-bg: #FDE8E8; --turuncu: #A34400; --turuncu-bg: #FFE7D1; --kat-belge: #6237C8; --kat-tablo: #1D7A3A; --kat-gorsel: #B0256C; --kat-kod: #2453C7; --kat-video: #A8500F; --kat-arsiv: #7A5A00; --kat-onemli: #B4232B; --kat-oyun: #0B6E78; color-scheme: light; }\n:host([data-theme=\"dark\"]) { --ana: #2456D6; --ana-acik: #1D2C4F; --ana-hover: #1B2434; --ana-uzeri: #FFFFFF; --vurgu: #86A8FF; --zemin: #0F1520; --yuzey: #161E2B; --metin: #E6ECF5; --metin-ikincil: #9AA8BC; --kenar: #6A7B93; --ayirici: #263142; --basari: #4CC38A; --basari-bg: #13301F; --uyari: #E8AC45; --uyari-bg: #33270F; --hata: #FF8189; --hata-bg: #3A161A; --turuncu: #FF7A33; --turuncu-bg: #45210C; color-scheme: dark; }\n";
  // TOKEN-BITIR

  // ---------------------------------------------------------------- dil (TR kaynak, EN çeviri)
  const METIN = {
    tr: {
      ayarlar: 'Ayarlar', ara: 'Ayarlarda ara (Ctrl+F)', sonucYok: 'Sonuç yok. Başka bir kelime dene.', ortak: 'ORTAK',
      kapat: 'Kapat (Esc)', varsayilan: 'Varsayılana dön', sifirlandi: 'Bu bölüm varsayılana döndü',
      b_kopya: 'Kopyalama', b_genel: 'Genel', b_kisayol: 'Klavye kısayolları', b_degisiklik: 'Değişiklikler', b_hakkinda: 'Hakkında',
      kopyaAlt: 'Fare linkin üstündeyken kısayola bas. Linkin görünen yazısı panoya gider. Yazı alanında ve seçili yazı varken çalışmaz.',
      tus: 'Kopyalama kısayolu', tusAc: 'Bu tıklamada sağ tık menüsü açılmaz. Shift kullanılamaz: Firefox Shift + sağ tıkta menüyü her zaman açar.',
      tus_ctrl: 'Ctrl + sağ tık', tus_alt: 'Alt + sağ tık',
      balon: 'Kopyalayınca balon göster', balonAc: 'İmlecin yanında 1,5 sn görünür. Hata balonu bu ayardan bağımsız her zaman çıkar.',
      onizle: 'Balonda metnin başını göster', onizleAc: 'Kopyalanan metnin ilk 25 harfi balonda görünür.',
      yazisizNot: 'Yazısız link (yalnız resim): linkin adresi kopyalanır.',
      dil: 'Dil', dil_tr: 'Türkçe', dil_en: 'English', dil_tarayici: 'Tarayıcı dili', algilanan: 'Algılanan: {dil}',
      tema: 'Tema', tema_sayfa: 'Sayfayı izle', tema_acik: 'Açık', tema_koyu: 'Koyu',
      kisayolNot: 'Tuş kutusuna tıkla, yeni tuşu bas. Vazgeçmek için Esc. Tarayıcının kullandığı tuş kabul edilmez.',
      k_ayarlar: 'Ayarları aç', k_kopyala: 'Link yazısını kopyala', k_kopyalaAc: 'Kopyalama bölümünden değişir.', tusaBas: 'Tuşa bas…',
      tusDegisti: 'Kısayol {tus} oldu', tusRed: '{tus} kullanılamaz: {neden} Başka tuş seç.',
      neden_degistirici: 'Ctrl ya da Alt ile birlikte basılmalı.', neden_tarayici: 'tarayıcı bu tuşu kullanıyor.',
      neden_altgr: 'Ctrl + Alt Türkçe klavyede AltGr ile karışır.',
      surum: 'Sürüm {s}', store: 'AALabs App Store ile güncellenir.',
      yedek: 'Ayar yedeği', yedekle: 'Yedekle (dosya)', geriYukle: 'Geri yükle (dosya)',
      sonYedek: 'Son yedek: {t}', sonYedekYok: 'Son yedek: henüz yok',
      yedekAc: 'Yedek, bu betiğin ayarlarını tek bir JSON dosyasına yazar. Geri yükleyince ayarlar hemen uygulanır.',
      yedeklendi: 'Ayarlar dosyaya yazıldı', geriYuklendi: 'Ayarlar geri yüklendi',
      yedekHata: 'Dosya okunamadı. AALabs Copy Link Text yedeği (.json) seç.',
      kopyalandi: 'Kopyalandı', kopyaHata: 'Kopyalanamadı', bildirimKapat: 'Bildirimi kapat',
      menuAyarlar: 'Ayarlar (A)', menuDegisiklik: 'Değişiklikler (D)',
      // Değişiklikler parçası (assets/userscript/degisiklik.js) Türkçe metni anahtar olarak kullanır
      'Değişiklikler': 'Değişiklikler', 'Yeni': 'Yeni', 'Düzeldi': 'Düzeldi', 'Değişti': 'Değişti', 'Kaldırıldı': 'Kaldırıldı',
      'Tümü': 'Tümü', 'Süzgeç': 'Süzgeç', 'Oraya git': 'Oraya git',
      'Yeni sürüm kuruldu. Bu pencere her yeni sürümde bir kez açılır.': 'Yeni sürüm kuruldu. Bu pencere her yeni sürümde bir kez açılır.',
      'Değişikliklerde ara': 'Değişikliklerde ara', 'Yeni sürümde otomatik açma': 'Yeni sürümde otomatik açma',
      'Kopyala': 'Kopyala', 'Tamam': 'Tamam', 'Bu süzgeçle değişiklik yok.': 'Bu süzgeçle değişiklik yok.',
      'Değişiklik kaydı yok.': 'Değişiklik kaydı yok.', 'Kurulu': 'Kurulu', 'Atladığın sürüm': 'Atladığın sürüm',
      '{0} sürüm · {1} değişiklik': '{0} sürüm · {1} değişiklik', 'Kopyalandı': 'Kopyalandı', 'Kopyalanamadı': 'Kopyalanamadı',
    },
    en: {
      ayarlar: 'Settings', ara: 'Search settings (Ctrl+F)', sonucYok: 'No results. Try another word.', ortak: 'COMMON',
      kapat: 'Close (Esc)', varsayilan: 'Reset to default', sifirlandi: 'This section was reset',
      b_kopya: 'Copying', b_genel: 'General', b_kisayol: 'Keyboard shortcuts', b_degisiklik: 'Changes', b_hakkinda: 'About',
      kopyaAlt: 'Hover a link and use the shortcut. The visible link text goes to the clipboard. Inactive in text fields and while text is selected.',
      tus: 'Copy shortcut', tusAc: 'No context menu opens on that click. Shift is not offered: Firefox always opens its menu on Shift + right-click.',
      tus_ctrl: 'Ctrl + right-click', tus_alt: 'Alt + right-click',
      balon: 'Show a bubble after copying', balonAc: 'Appears by the cursor for 1.5 s. Error bubbles always appear, whatever this setting is.',
      onizle: 'Show the start of the text', onizleAc: 'The first 25 letters of the copied text appear in the bubble.',
      yazisizNot: 'Link without text (image only): the link address is copied.',
      dil: 'Language', dil_tr: 'Türkçe', dil_en: 'English', dil_tarayici: 'Browser language', algilanan: 'Detected: {dil}',
      tema: 'Theme', tema_sayfa: 'Follow the page', tema_acik: 'Light', tema_koyu: 'Dark',
      kisayolNot: 'Click a key box, then press the new keys. Esc cancels. Keys used by the browser are refused.',
      k_ayarlar: 'Open settings', k_kopyala: 'Copy link text', k_kopyalaAc: 'Change it in the Copying section.', tusaBas: 'Press keys…',
      tusDegisti: 'Shortcut is now {tus}', tusRed: "{tus} can't be used: {neden} Pick another key.",
      neden_degistirici: 'press it together with Ctrl or Alt.', neden_tarayici: 'the browser uses this key.',
      neden_altgr: 'Ctrl + Alt clashes with AltGr on Turkish keyboards.',
      surum: 'Version {s}', store: 'Updated by AALabs App Store.',
      yedek: 'Settings backup', yedekle: 'Back up (file)', geriYukle: 'Restore (file)',
      sonYedek: 'Last backup: {t}', sonYedekYok: 'Last backup: none yet',
      yedekAc: "The backup writes this script's settings to one JSON file. Restoring applies them at once.",
      yedeklendi: 'Settings written to a file', geriYuklendi: 'Settings restored',
      yedekHata: "Couldn't read the file. Pick an AALabs Copy Link Text backup (.json).",
      kopyalandi: 'Copied', kopyaHata: "Couldn't copy", bildirimKapat: 'Close notification',
      menuAyarlar: 'Settings (S)', menuDegisiklik: 'Changes (C)',
      'Değişiklikler': 'Changes', 'Yeni': 'New', 'Düzeldi': 'Fixed', 'Değişti': 'Changed', 'Kaldırıldı': 'Removed',
      'Tümü': 'All', 'Süzgeç': 'Filter', 'Oraya git': 'Go there',
      'Yeni sürüm kuruldu. Bu pencere her yeni sürümde bir kez açılır.': 'A new version was installed. This window opens once for each new version.',
      'Değişikliklerde ara': 'Search changes', 'Yeni sürümde otomatik açma': "Don't open on new versions",
      'Kopyala': 'Copy', 'Tamam': 'OK', 'Bu süzgeçle değişiklik yok.': 'No changes match this filter.',
      'Değişiklik kaydı yok.': 'No change log yet.', 'Kurulu': 'Installed', 'Atladığın sürüm': 'Skipped version',
      '{0} sürüm · {1} değişiklik': '{0} versions · {1} changes', 'Kopyalandı': 'Copied', 'Kopyalanamadı': "Couldn't copy",
    },
  };

  // ---------------------------------------------------------------- ayar deposu
  const VARSAYILAN = Object.freeze({
    tus: 'ctrl', balon: true, onizle: true,
    dil: 'tr', tema: 'sayfa',
    kisayolAyarlar: 'Ctrl+,', sonYedek: '',
  });
  const SECENEK = { tus: ['ctrl', 'alt'], dil: ['tr', 'en', 'tarayici'], tema: ['sayfa', 'acik', 'koyu'] };
  const BOLUM_ANAHTAR = { kopya: ['tus', 'balon', 'onizle'], genel: ['dil', 'tema'], kisayol: ['kisayolAyarlar'] };
  const gmDepo = (() => { try { return typeof GM_getValue === 'function' && typeof GM_setValue === 'function'; } catch (_e) { return false; } })();
  const bellek = {};   // GM deposu yoksa ayarlar burada (sayfa kapanınca gider)

  function depoOku(ad, varsayilan) {
    if (!gmDepo) return ad in bellek ? bellek[ad] : varsayilan;
    try { const v = GM_getValue(ad, varsayilan); return v === undefined ? varsayilan : v; } catch (_e) { return varsayilan; }
  }
  function depoYaz(ad, deger) {
    if (!gmDepo) { bellek[ad] = deger; return; }
    try { GM_setValue(ad, deger); } catch (_e) { bellek[ad] = deger; }
  }

  // Değişiklikler parçası "ilk kurulum mu" sorusunu betik başlarken okunan depodan yanıtlar
  const DEPO_VARDI = depoOku('ayarlar', null) !== null;

  // ---------------------------------------------------------------- kısayol kuralları
  const TARAYICI_YASAK = new Set(['Ctrl+T', 'Ctrl+W', 'Ctrl+N', 'Ctrl+L', 'Ctrl+R', 'Ctrl+F', 'Ctrl+P', 'Ctrl+S', 'Ctrl+D',
    'Ctrl+H', 'Ctrl+J', 'Ctrl+K', 'Ctrl+U', 'Ctrl+O', 'Ctrl+G', 'Ctrl+E', 'Ctrl+A', 'Ctrl+C', 'Ctrl+V', 'Ctrl+X', 'Ctrl+Z', 'Ctrl+Y', 'Ctrl+B', 'Ctrl+I',
    'Ctrl+Shift+T', 'Ctrl+Shift+N', 'Ctrl+Shift+W', 'Ctrl+Shift+I', 'Ctrl+Shift+J', 'Ctrl+Shift+C', 'Ctrl+Shift+K', 'Ctrl+Shift+E', 'Ctrl+Shift+M', 'Ctrl+Shift+Delete',
    'Ctrl+Shift+B', 'Ctrl+Shift+O', 'Ctrl+Shift+P', 'Ctrl+Shift+R', 'Ctrl+Shift+V', 'Ctrl+Shift+Z', 'Ctrl+Shift+Enter',
    'Ctrl+Tab', 'Ctrl+Shift+Tab', 'Ctrl+F4', 'Alt+F4', 'Ctrl+Space', 'Ctrl+Enter',
    'Alt+D', 'Alt+E', 'Alt+F', 'Alt+Home', 'Alt+ArrowLeft', 'Alt+ArrowRight', 'Ctrl+Plus', 'Ctrl+-', 'Ctrl+0', 'Ctrl+=',
    'Ctrl+1', 'Ctrl+2', 'Ctrl+3', 'Ctrl+4', 'Ctrl+5', 'Ctrl+6', 'Ctrl+7', 'Ctrl+8', 'Ctrl+9',
    'Ctrl+ArrowLeft', 'Ctrl+ArrowRight', 'Ctrl+ArrowUp', 'Ctrl+ArrowDown', 'Ctrl+Home', 'Ctrl+End', 'Ctrl+PageUp', 'Ctrl+PageDown',
    'Ctrl+Insert', 'Ctrl+Delete', 'Ctrl+Backspace', 'Shift+Insert',
    'Ctrl+Shift+ArrowLeft', 'Ctrl+Shift+ArrowRight', 'Ctrl+Shift+ArrowUp', 'Ctrl+Shift+ArrowDown', 'Ctrl+Shift+Home', 'Ctrl+Shift+End',
    'Ctrl+Shift+PageUp', 'Ctrl+Shift+PageDown']);

  /** Tuşun adı (platform-userscript.md §2.8): harf ve rakam e.code ile; noktalama e.key ile; AltGr yok sayılır. */
  function tusAdi(e) {
    if (e.getModifierState && e.getModifierState('AltGraph')) return null;   // AltGr yazı içindir
    const k = e.key || '';
    if (k === ' ' || k === 'Unidentified' || k === 'Process' || k === 'Dead') return null;
    if (k === '+') return 'Plus';
    if (k.length === 1 && !/[A-Za-z0-9\s]/.test(k) && !/^\p{L}$/u.test(k)) return k.toUpperCase();   // "," = Türkçe Q'da Backslash tuşu
    if (/^Key[A-Z]$/.test(e.code || '')) return e.code.slice(3);
    if (/^Digit\d$/.test(e.code || '')) return e.code.slice(5);
    if (k.length === 1) return k.toLocaleUpperCase('en-US');
    if (['Control', 'Alt', 'Shift', 'Meta', 'AltGraph', 'OS'].includes(k)) return null;
    return k;
  }

  function tusKombo(e) {
    const k = tusAdi(e);
    if (!k) return null;
    const p = [];
    if (e.ctrlKey) p.push('Ctrl');
    if (e.altKey) p.push('Alt');
    if (e.shiftKey) p.push('Shift');
    if (e.metaKey) p.push('Meta');
    p.push(k);
    return p.join('+');
  }

  /** tusKombo'nun üretebileceği biçim mi (dosyadan gelen değer için). */
  function komboKanonikMi(v) {
    if (typeof v !== 'string' || v.length > 40) return false;
    const m = /^(Ctrl\+)?(Alt\+)?(Shift\+)?(Meta\+)?([^+]+|Plus)$/.exec(v);
    if (!m || !(m[1] || m[2] || m[4])) return false;
    const tus = m[5];
    if ([...tus].length === 1) return tus === tus.toLocaleUpperCase('en-US');
    return /^[A-Z][A-Za-z0-9]{1,15}$/.test(tus);
  }

  /** null = geçerli; değilse neden anahtarı. */
  function tusGecerliMi(kombo) {
    const p = kombo.split('+');
    if (!p.some((x) => x === 'Ctrl' || x === 'Alt' || x === 'Meta')) return 'neden_degistirici';
    if (p.includes('Ctrl') && p.includes('Alt')) return 'neden_altgr';
    const esdeger = p.includes('Meta') ? ['Ctrl', ...p.filter((x) => x !== 'Meta' && x !== 'Ctrl')].join('+') : kombo;
    if (TARAYICI_YASAK.has(kombo) || TARAYICI_YASAK.has(esdeger)) return 'neden_tarayici';
    return null;
  }

  function ayarDogrula(ham) {
    const a = Object.assign({}, VARSAYILAN);
    if (!ham || typeof ham !== 'object') return a;
    for (const k of Object.keys(VARSAYILAN)) {
      if (!(k in ham)) continue;
      const v = ham[k];
      if (typeof VARSAYILAN[k] === 'boolean') { if (typeof v === 'boolean') a[k] = v; continue; }
      if (SECENEK[k]) { if (SECENEK[k].includes(v)) a[k] = v; continue; }
      if (k === 'kisayolAyarlar') { if (komboKanonikMi(v) && tusGecerliMi(v) === null) a[k] = v; continue; }
      if (typeof v === 'string') a[k] = v.slice(0, 40);
    }
    return a;
  }

  function ayarlariOku() {
    const ham = depoOku('ayarlar', null);
    try { return ayarDogrula(typeof ham === 'string' ? JSON.parse(ham) : ham); } catch (_e) { return ayarDogrula(null); }
  }
  function ayarlariYaz() { depoYaz('ayarlar', JSON.stringify(ayar)); }

  let ayar = ayarlariOku();

  // ---------------------------------------------------------------- dil yardımcıları
  function tarayiciDili() {
    const d = ((navigator.languages && navigator.languages[0]) || navigator.language || 'tr').toLowerCase();
    return d.startsWith('tr') ? 'tr' : 'en';
  }
  function dilKodu() {
    if (ayar.dil === 'tarayici') return tarayiciDili();
    return ayar.dil === 'en' ? 'en' : 'tr';
  }
  function _(k, deger) {
    const s = (METIN[dilKodu()] || METIN.tr)[k] ?? METIN.tr[k] ?? k;
    return deger ? s.replace(/\{(\w+)\}/g, (m, a) => (a in deger ? String(deger[a]) : m)) : s;
  }
  const _n = (s) => s;                                                     // yalnız işaret: çeviri çizimde yapılır
  const _f = (s, ...d) => _(s).replace(/\{(\d+)\}/g, (m, i) => (i in d ? String(d[i]) : m));
  const DIL = { aktif: dilKodu };
  /** Arama için harf katlama: Türkçe I/ı ile İngilizce I/i aynı sayılır. */
  function katla(s) { return String(s).toLocaleLowerCase('tr-TR').replace(/ı/g, 'i'); }
  const fold = katla;

  // ---------------------------------------------------------------- link ve yazısı
  const DUZENLENEBILIR = 'input, textarea, select, [contenteditable=""], [contenteditable="true"], [contenteditable="plaintext-only"]';

  function duzenlenebilirMi(o) {
    if (!o || o.nodeType !== 1) return false;
    return o.isContentEditable || !!o.closest(DUZENLENEBILIR);
  }

  /** Tıklanan noktadaki link (gölge DOM içinde de). */
  function linkBul(e) {
    const yol = typeof e.composedPath === 'function' ? e.composedPath() : [e.target];
    for (const d of yol) {
      if (!d || d.nodeType !== 1) continue;
      if (d === ev) return null;                                   // kendi arayüzümüz
      if (duzenlenebilirMi(d)) return null;
      if (d.matches && d.matches('a[href], area[href]')) return d;
    }
    return null;
  }

  /** Linkin görünen yazısı; yazı yoksa adresi (tasarım: Yazısız B). */
  function linkMetni(a) {
    let metin = '';
    if (a.tagName === 'AREA') metin = a.getAttribute('alt') || '';
    else metin = typeof a.innerText === 'string' ? a.innerText : (a.textContent || '');
    metin = metin.replace(/\s+/g, ' ').trim();
    if (metin) return metin;
    let adres = '';
    try { adres = a.href && typeof a.href === 'object' ? a.href.baseVal : a.href; } catch (_e) { adres = ''; }
    return String(adres || a.getAttribute('href') || '').trim();
  }

  function seciliYaziVar() {
    try {
      const s = window.getSelection();
      return !!(s && !s.isCollapsed && s.toString().trim());
    } catch (_e) { return false; }
  }

  function degistiriciTutuyor(e) {
    if (e.shiftKey || e.metaKey) return false;
    if (ayar.tus === 'alt') return e.altKey && !e.ctrlKey;
    return e.ctrlKey && !e.altKey;
  }

  // ---------------------------------------------------------------- panoya yazma
  function gmPano() {
    try { if (typeof GM_setClipboard === 'function') return (t) => GM_setClipboard(t, 'text'); } catch (_e) { /* yok */ }
    try { if (typeof GM !== 'undefined' && GM && typeof GM.setClipboard === 'function') return (t) => GM.setClipboard(t, 'text'); } catch (_e) { /* yok */ }
    return null;
  }

  function execKopyala(metin) {
    const kutu = document.createElement('textarea');
    kutu.value = metin;
    kutu.setAttribute('readonly', '');
    kutu.setAttribute('aria-hidden', 'true');
    kutu.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';
    (document.body || document.documentElement).appendChild(kutu);
    const odak = document.activeElement;
    kutu.select();
    let tamam = false;
    try { tamam = document.execCommand('copy'); } catch (_e) { tamam = false; }
    kutu.remove();
    if (odak && typeof odak.focus === 'function') { try { odak.focus({ preventScroll: true }); } catch (_e) { /* yok */ } }
    return tamam;
  }

  /** Panoya yazar; başarılıysa true. */
  async function panoyaYaz(metin) {
    const gm = gmPano();
    if (gm) { try { await gm(metin); return true; } catch (_e) { /* sıradakini dene */ } }
    if (navigator.clipboard && window.isSecureContext) {
      try { await navigator.clipboard.writeText(metin); return true; } catch (_e) { /* sıradakini dene */ }
    }
    return execKopyala(metin);
  }

  // ---------------------------------------------------------------- Ctrl + sağ tık akışı
  let sonKopya = { zaman: 0, metin: '' };

  function sagTik(e) {
    if (!e.isTrusted || (e.button !== undefined && e.button !== 2 && e.button !== 0)) return;
    if (!degistiriciTutuyor(e)) return;
    if (seciliYaziVar()) return;                    // seçim varken normal menü açılsın
    const a = linkBul(e);
    if (!a) return;
    const metin = linkMetni(a);
    if (!metin) return;
    // Bu tıklamada menü açılmasın; sayfanın kendi sağ tık dinleyicileri de çalışmasın
    e.preventDefault();
    e.stopImmediatePropagation();
    const x = e.clientX, y = e.clientY;
    sonKopya = { zaman: Date.now(), metin };
    panoyaYaz(metin).then((tamam) => {
      if (!tamam) { balonGoster(x, y, _('kopyaHata'), 'hata'); return; }
      if (!ayar.balon) return;
      let yazi = _('kopyalandi');
      if (ayar.onizle) {
        const harf = Array.from(metin);
        yazi += ' · ' + (harf.length > ONIZLEME_HARF ? harf.slice(0, ONIZLEME_HARF).join('').trimEnd() + '…' : metin);
      }
      balonGoster(x, y, yazi, 'basari');
    }).catch(() => balonGoster(x, y, _('kopyaHata'), 'hata'));
  }

  window.addEventListener('contextmenu', sagTik, true);
  // Bazı siteler sağ tıkı mousedown'da yakalar (kendi menüsünü açar): o anda onları durdur.
  window.addEventListener('mousedown', (e) => {
