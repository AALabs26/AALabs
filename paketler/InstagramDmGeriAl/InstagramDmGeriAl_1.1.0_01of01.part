      t_listeYok: 'No links found; add the chat to the queue from the panel',
      t_depo: 'Settings storage', t_depoVar: 'GM_getValue ✓', t_depoYok: 'No GM_getValue: settings are lost when the page closes',
      t_son: 'Last run', t_sonYok: 'No run yet', t_sonOzet: '{zaman} · {kip} · {b} unsent · {a} found · {h} errors',
      t_kipDeneme: 'dry run', t_kipCanli: 'live',
      t_gunluk: 'Recent actions', sonuc_tepe: 'start of chat', sonuc_sinir: 'limit', sonuc_durdu: 'stopped', sonuc_engel: 'blocked', sonuc_hataMenu: 'menu error', sonuc_hataOnay: 'confirm error',
      g_alindi: 'Unsent · “{m}”', g_sayildi: 'Counted · “{m}”', g_atlandi: 'Skipped · {neden}', g_hata: 'Error · {neden}',
      n_suzgec: 'filter', n_tur: 'message type', n_degil: 'other person’s message', n_menu: 'menu did not open', n_secenek: 'no unsend option',
      n_onay: 'no confirm', n_kalmadi: 'message not removed', medyaMesaj: 'media',
      kabulBaslik: 'Acceptance items', kabulAlt: 'Try each item and mark the result. Answers are added to the diagnostic report.',
      gecti: 'Passed', sorun: 'Problem', atla: 'Skip', notYer: 'Short note (optional)', nasil: 'How to try?',
      k1: 'In dry run, did pressing Start delete no messages?', k1i: 'In a short chat, press Start with dry run on; the counter changes, messages stay.',
      k2: 'In live mode, were only your messages unsent?', k2i: 'Run with a limit of 3 in a test chat that also has the other person’s messages.',
      k3: 'Did it stop within 2 s after pressing Stop?', k3i: 'Start in live mode, press Stop (or Esc) after the second message.',
      k4: 'Does the unsent count equal the messages that disappeared?', k4i: 'When done, count the chat by hand against the panel.',
      k5: 'Were your settings kept after reloading the page?', k5i: 'Set the limit to 5, press F5, open Settings.',
      raporKopyala: 'Copy report', raporKopyalandi: 'Diagnostic report copied', raporBaslik: 'Diagnostic report', kopyaHata: "Couldn't copy. Copy it by hand from the text box.",
      r_zaman: 'Time', r_tarayici: 'Browser', r_yonetici: 'Extension', r_ayarlar: 'Settings', r_dil: 'Language', r_tema: 'Theme', r_sira: 'Queue',
      r_ok: '[OK]', r_hata: '[ERROR]', r_bilgi: '[INFO]', r_elle: 'MANUAL RESULT', r_elleYok: 'Not marked yet',
      surum: 'Version {s}', store: 'Updated by AALabs App Store. Manual install: KURULUM.md.',
      calisma: 'Where it runs', calismaA: 'The script loads on instagram.com pages; the panel shows only on instagram.com/direct pages.',
      yedek: 'Settings backup', yedekle: 'Back up (file)', geriYukle: 'Restore (file)',
      sonYedek: 'Last backup: {t}', sonYedekYok: 'Last backup: none yet',
      yedekAc: 'The backup writes this script\'s settings to one JSON file. The queue and acceptance answers are not included.',
      yedeklendi: 'Settings written to a file', geriYuklendi: 'Settings restored', yedekHata: "Couldn't read the file. Pick an AALabs DM Unsend backup (.json).",
      menuPanel: 'Open panel (P)', menuAyarlar: 'Settings (A)', menuRapor: 'Copy diagnostic report (T)',
    },
  };

  // ---------------------------------------------------------------- ayar deposu
  const VARSAYILAN = Object.freeze({
    deneme: true, enCok: 30, bekleme: 1500,
    suzgec: '', suzgecKip: 'atla', tur: 'hepsi',
    otoDk: 10, engel: true, sohbetArasiDk: 2,
    dil: 'tarayici', tema: 'sayfa', olcek: 100,
    kisayolAyarlar: 'Ctrl+,', sonYedek: '',
  });
  const SECENEK = {
    suzgecKip: ['atla', 'yalniz'], tur: ['hepsi', 'yazi', 'medya'],
    otoDk: [0, 5, 10, 15, 30], sohbetArasiDk: [1, 2, 5],
    dil: ['tr', 'en', 'tarayici'], tema: ['sayfa', 'acik', 'koyu'], olcek: [90, 100, 115, 130],
  };
  const ARALIK = { enCok: [1, 150, 1], bekleme: [1500, 10000, 500] };   // [en az, en çok, adım]
  const BOLUM_ANAHTAR = {
    geri: ['deneme', 'enCok', 'bekleme', 'suzgec', 'suzgecKip', 'tur', 'otoDk', 'engel', 'sohbetArasiDk'],
    genel: ['dil', 'tema', 'olcek'], kisayol: ['kisayolAyarlar'],
  };
  const gmDepo = (() => { try { return typeof GM_getValue === 'function' && typeof GM_setValue === 'function'; } catch (_) { return false; } })();
  const bellekDepo = {};

  function depoOku(anahtar, yedek) {
    if (!gmDepo) return anahtar in bellekDepo ? bellekDepo[anahtar] : yedek;
    try {
      const ham = GM_getValue(anahtar, null);
      if (ham === null || ham === undefined) return yedek;
      return typeof ham === 'string' ? JSON.parse(ham) : ham;
    } catch (_) { return yedek; }
  }
  function depoYaz(anahtar, deger) {
    if (!gmDepo) { bellekDepo[anahtar] = deger; return; }
    try { GM_setValue(anahtar, JSON.stringify(deger)); } catch (_) { /* yazılamadı; bellekte sürer */ }
  }

  function aralikDogrula(k, v) {
    const [a, b, adim] = ARALIK[k];
    if (typeof v !== 'number' || !Number.isFinite(v) || v < a || v > b) return null;
    return Math.round(v / adim) * adim;
  }

  function ayarDogrula(ham) {
    const s = Object.assign({}, VARSAYILAN);
    if (!ham || typeof ham !== 'object' || Array.isArray(ham)) return s;
    for (const k of Object.keys(VARSAYILAN)) {
      if (!(k in ham)) continue;
      const v = ham[k];
      if (typeof VARSAYILAN[k] === 'boolean') { if (typeof v === 'boolean') s[k] = v; continue; }
      if (SECENEK[k]) { if (SECENEK[k].includes(v)) s[k] = v; continue; }
      if (ARALIK[k]) { const d = aralikDogrula(k, v); if (d !== null) s[k] = d; continue; }
      if (k === 'kisayolAyarlar') { if (komboKanonikMi(v) && tusGecerliMi(v) === null) s[k] = v; continue; }
      if (typeof v === 'string') s[k] = v.slice(0, k === 'suzgec' ? 60 : 40);
    }
    return s;
  }

  // ---------------------------------------------------------------- kısayol kuralları
  const DEGISTIRICI = ['Ctrl', 'Alt', 'Shift', 'Meta'];
  const TARAYICI_YASAK = new Set(['Ctrl+T', 'Ctrl+W', 'Ctrl+N', 'Ctrl+L', 'Ctrl+R', 'Ctrl+F', 'Ctrl+P', 'Ctrl+S', 'Ctrl+D',
    'Ctrl+H', 'Ctrl+J', 'Ctrl+K', 'Ctrl+U', 'Ctrl+O', 'Ctrl+G', 'Ctrl+E', 'Ctrl+A', 'Ctrl+C', 'Ctrl+V', 'Ctrl+X', 'Ctrl+Z', 'Ctrl+Y',
    'Ctrl+Shift+T', 'Ctrl+Shift+N', 'Ctrl+Shift+W', 'Ctrl+Shift+I', 'Ctrl+Shift+J', 'Ctrl+Shift+C', 'Ctrl+Shift+Delete',
    'Ctrl+Shift+B', 'Ctrl+Shift+O', 'Ctrl+Shift+P', 'Ctrl+Shift+R', 'Ctrl+Tab', 'Ctrl+Shift+Tab', 'Ctrl+F4', 'Alt+F4',
    'Alt+D', 'Alt+E', 'Alt+F', 'Alt+Home', 'Alt+Left', 'Alt+Right', 'Ctrl+Plus', 'Ctrl+-', 'Ctrl+0', 'Ctrl+=',
    'Ctrl+1', 'Ctrl+2', 'Ctrl+3', 'Ctrl+4', 'Ctrl+5', 'Ctrl+6', 'Ctrl+7', 'Ctrl+8', 'Ctrl+9', 'Ctrl+Enter']);

  function tusAdi(e) {
    let k = e.key || '';
    if (k === ' ') k = 'Space';
    else if (k === '+') k = 'Plus';
    else if (k.startsWith('Arrow')) k = k.slice(5);
    else if (k.length === 1) {
      // harf/rakam e.code ile (Türkçe klavyede I tuşu "ı" yazar), noktalama e.key ile ("," Türkçe Q'da da ",")
      if (/^Key[A-Z]$/.test(e.code || '')) k = e.code.slice(3);
      else if (/^Digit\d$/.test(e.code || '')) k = e.code.slice(5);
      else k = k.toLocaleUpperCase('en-US');
    }
    return k;
  }

  function tusKombo(e) {
    if (e.getModifierState && e.getModifierState('AltGraph')) return null;   // AltGr yazı içindir
    const p = [];
    if (e.ctrlKey) p.push('Ctrl');
    if (e.altKey) p.push('Alt');
    if (e.shiftKey) p.push('Shift');
    if (e.metaKey) p.push('Meta');
    const k = tusAdi(e);
    if (!k || DEGISTIRICI.includes(k) || k === 'Control' || k === 'AltGraph' || k === 'Dead') return null;
    p.push(k);
    return p.join('+');
  }

  function komboKanonikMi(v) {
    if (typeof v !== 'string' || v.length > 40) return false;
    const m = /^(Ctrl\+)?(Alt\+)?(Shift\+)?(Meta\+)?([^+]+|Plus)$/.exec(v);
    if (!m || !(m[1] || m[2] || m[4])) return false;
    const tus = m[5];
    if ([...tus].length === 1) return tus === tus.toLocaleUpperCase('en-US');
    return /^[A-Z][A-Za-z0-9]{1,15}$/.test(tus);
  }

  /** null = geçerli; değilse neden anahtarı. */
  function tusGecerliMi(kombo) {
    const p = kombo.split('+');
    if (!p.some((x) => x === 'Ctrl' || x === 'Alt' || x === 'Meta')) return 'neden_degistirici';
    if (p.includes('Ctrl') && p.includes('Alt')) return 'neden_altgr';
    const esdeger = p.includes('Meta') ? ['Ctrl', ...p.filter((x) => x !== 'Meta' && x !== 'Ctrl')].join('+') : kombo;
    if (TARAYICI_YASAK.has(kombo) || TARAYICI_YASAK.has(esdeger)) return 'neden_tarayici';
    return null;
  }

  let ayar = ayarDogrula(depoOku('ayarlar', null));
  function ayarYaz() { depoYaz('ayarlar', ayar); }

  // ---------------------------------------------------------------- dil yardımcıları
  function tarayiciDili() {
    const d = ((navigator.languages && navigator.languages[0]) || navigator.language || 'tr').toLowerCase();
    return d.startsWith('tr') ? 'tr' : 'en';
  }
  function dilKodu() {
    if (ayar.dil === 'tarayici') return tarayiciDili();
    return ayar.dil === 'en' ? 'en' : 'tr';
  }
  function _(k, deger) {
    const s = (METIN[dilKodu()] || METIN.tr)[k] ?? METIN.tr[k] ?? k;
    return deger ? s.replace(/\{(\w+)\}/g, (m, a) => (a in deger ? String(deger[a]) : m)) : s;
  }
  function sayi(n) { return Number(n).toLocaleString(dilKodu() === 'tr' ? 'tr-TR' : 'en-US'); }
  function saniye(ms) {
    const v = ms / 1000;
    return _('sn', { n: dilKodu() === 'tr' ? String(v).replace('.', ',') : String(v) });
  }
  function saat(t) {
    return new Date(t).toLocaleTimeString(dilKodu() === 'tr' ? 'tr-TR' : 'en-GB', { hour: '2-digit', minute: '2-digit' });
  }
  function sureYazi(ms) {
    const sn = Math.max(1, Math.round(ms / 1000));
    return sn < 90 ? _('sureSn', { n: sn }) : _('sureDk', { n: Math.round(sn / 60) });
  }
  function katla(s) { return String(s || '').toLocaleLowerCase('tr-TR').replace(/ı/g, 'i'); }

  // ---------------------------------------------------------------- Instagram seçicileri (tek yer)
  // Sitenin üretilmiş sınıf adlarına bağlanılmaz; rol, aria-label ve yapı kullanılır.
  // Canlı sitede doğrulanmadı (1.1.0): sorun çıkarsa Tanı raporu hangi satırın tutmadığını gösterir.
  const SEC = {
    sohbetYolu: /^\/direct\/t\/([^/?#]+)/,
    alan: ['[role="main"] [role="grid"]', '[aria-label^="Messages in conversation"]', '[aria-label*="ile sohbet"]', '[role="main"]'],
    satir: '[role="row"]',
    metin: '[dir="auto"]',
    medya: 'img, video, audio, [aria-label*="Voice"], [aria-label*="Sesli"]',
    menuEtiket: /(see more options|more options|^more$|daha fazla|diğer seçenek|seçenekler|seçenekleri)/i,
    menuOgesi: '[role="menuitem"], [role="menu"] [role="button"], [role="dialog"] [role="button"], [role="dialog"] button, div[role="button"], button',
    geriAlYazi: /^(unsend|gönderimi geri al|geri al)$/i,
    onayKap: '[role="dialog"], [role="alertdialog"]',
    engelYazi: /(try again later|daha sonra tekrar dene|we restrict certain activity|belirli etkinlikleri kısıtl|action blocked|işlem engellendi)/i,
    listeBag: 'a[href*="/direct/t/"]',
  };

  const gorunur = (e) => !!(e && e.isConnected && e.getClientRects().length && getComputedStyle(e).visibility !== 'hidden');

  function sohbetKimligi() {
    const m = SEC.sohbetYolu.exec(location.pathname);
    return m ? decodeURIComponent(m[1]) : '';
  }
  function dmSayfasi() { return location.pathname.startsWith('/direct'); }

  function sohbetAlani() {
    if (!sohbetKimligi()) return null;
    for (const s of SEC.alan) {
      const e = document.querySelector(s);
      if (e && gorunur(e) && e.querySelector(SEC.satir)) return { e, secici: s };
    }
    return null;
  }

  function satirlar(alan) {
    if (!alan) return [];
    return Array.from(alan.e.querySelectorAll(SEC.satir)).filter((r) => gorunur(r) && (r.querySelector(SEC.metin) || r.querySelector(SEC.medya)));
  }

  /** Mesaj satırlarını kaydıran üst öğe. Taşan yoksa kaydırılabilir olan ilk üst öğe (az mesajlı sohbet). */
  function kaydirmaAlani(alan) {
    let e = alan && (alan.e.querySelector(SEC.satir) || alan.e);
    let yedek = null;
    while (e && e !== document.body) {
      const st = getComputedStyle(e);
      if (/(auto|scroll)/.test(st.overflowY)) {
        if (e.scrollHeight > e.clientHeight + 4) return e;
        if (!yedek) yedek = e;
      }
      e = e.parentElement;
    }
    return yedek;
  }

  /** Mesaj balonunun kapladığı alan: metin ve medya öğelerinin birleşimi. */
  function balonAlani(satir) {
    const genislik = satir.getBoundingClientRect().width || 1;
    // yalnız yaprak metin öğeleri; satır boyu sarmalayıcılar ortayı bozmasın
    const parca = Array.from(satir.querySelectorAll(SEC.metin + ', ' + SEC.medya)).filter((p) => gorunur(p)
      && !(p.matches(SEC.metin) && p.querySelector(SEC.metin)) && p.getBoundingClientRect().width < genislik * 0.9);
    if (!parca.length) return null;
    let sol = Infinity, sag = -Infinity, ust = Infinity, alt = -Infinity;
    for (const p of parca) {
      const r = p.getBoundingClientRect();
      if (r.width < 2 || r.height < 2) continue;
      sol = Math.min(sol, r.left); sag = Math.max(sag, r.right); ust = Math.min(ust, r.top); alt = Math.max(alt, r.bottom);
    }
    return Number.isFinite(sol) ? { sol, sag, ust, alt } : null;
  }

  /** Sağa yaslı balon = senin mesajın (ön eleme; kesin karar menüdeki "Geri al" seçeneğidir). */
  function benimMi(satir) {
    const b = balonAlani(satir);
    if (!b) return false;
    const r = satir.getBoundingClientRect();   // satırlar sohbet genişliğinde
    if (r.width < 50) return false;
    const orta = ((b.sol + b.sag) / 2 - r.left) / r.width;
    const sol = (b.sol - r.left) / r.width;
    const rtl = getComputedStyle(satir).direction === 'rtl';
    return rtl ? (orta < 0.45 && (b.sag - r.left) / r.width < 0.75) : (orta > 0.55 && sol > 0.25);   // ölü bant: ortalı satır değil
  }

  function mesajMetni(satir) {
    return Array.from(satir.querySelectorAll(SEC.metin)).map((x) => x.textContent.trim()).filter(Boolean).join(' ').slice(0, 400);
  }
  function medyaMi(satir) {
    const m = satir.querySelector('video, audio, [aria-label*="Voice"], [aria-label*="Sesli"]');
    if (m) return true;
    return Array.from(satir.querySelectorAll('img')).some((i) => { const r = i.getBoundingClientRect(); return r.width > 80 && r.height > 60; });
  }

  /** E1 + E2: null = geri alınabilir; değilse atlama nedeni. */
  function suzgectenGecer(satir) {
    const metin = mesajMetni(satir);
    const medya = medyaMi(satir);
    if (ayar.tur === 'yazi' && (medya || !metin)) return 'n_tur';
    if (ayar.tur === 'medya' && !medya) return 'n_tur';
    const k = katla(ayar.suzgec.trim());
    if (k) {
      const var_ = katla(metin).includes(k);
      if (ayar.suzgecKip === 'atla' && var_) return 'n_suzgec';
      if (ayar.suzgecKip === 'yalniz' && !var_) return 'n_suzgec';
    }
    return null;
  }

  function etiketi(e) { return (e.getAttribute('aria-label') || e.getAttribute('title') || '').trim(); }

  function menuDugmesi(satir) {
    const ust = satir.parentElement;
    const kapsam = [satir];
    if (ust && ust.querySelectorAll(SEC.satir).length <= 1) kapsam.push(ust);   // üst öğe başka satır taşımıyorsa
    for (const k of kapsam) {
      for (const c of k.querySelectorAll('[aria-label], [title]')) {
        if (!SEC.menuEtiket.test(etiketi(c))) continue;
        const d = c.closest('[role="button"], button') || c;
        if (k.contains(d) && gorunur(d)) return d;   // satırı saran üst düğme değil
      }
    }
    return null;
  }

  /** Açık menü kapları: sohbet alanının dışındaki görünür menü ve pencereler (Instagram menüyü sayfa sonunda çizer). */
  function menuKaplari() {
    const alan = document.querySelector('[role="main"]');
    return Array.from(document.querySelectorAll('[role="menu"], [role="dialog"]')).filter((k) => gorunur(k) && !(alan && alan.contains(k) && !k.closest('[role="dialog"]')));
  }
  function geriAlSecenegi() {
    for (const k of menuKaplari()) {
      for (const c of k.querySelectorAll(SEC.menuOgesi)) {
        const y = (c.textContent || '').trim();
        if (y.length < 40 && SEC.geriAlYazi.test(y) && gorunur(c)) return c;
      }
    }
    return null;
  }
  function menuAcikMi() {
    return Array.from(document.querySelectorAll('[role="menuitem"]')).some(gorunur) || menuKaplari().length > 0;
  }
  function onayDugmesi(haric) {
    for (const k of document.querySelectorAll(SEC.onayKap)) {
      if (!gorunur(k) || k.querySelector('[role="menu"], [role="menuitem"]') || (haric && k.contains(haric))) continue;   // menünün penceresi değil
      for (const b of k.querySelectorAll('button, [role="button"]')) {
        if (b === haric || b.closest('[role="menu"]') || (haric && haric.contains(b))) continue;   // menünün kendi öğesi değil
        if (SEC.geriAlYazi.test((b.textContent || '').trim()) && gorunur(b)) return b;
      }
    }
    return null;
  }
  function engelVarMi() {
    for (const k of document.querySelectorAll('[role="dialog"], [role="alertdialog"], [role="alert"]')) {
      if (gorunur(k) && SEC.engelYazi.test(k.textContent || '')) return true;
    }
    return false;
  }

  function sohbetBaglantilari() {
    const alan = document.querySelector('[role="main"]');
    return Array.from(document.querySelectorAll(SEC.listeBag)).filter((a) => gorunur(a) && !(alan && alan.contains(a)) && SEC.sohbetYolu.test(new URL(a.href, location.href).pathname));
  }
  function baglantiKimligi(a) {
    const m = SEC.sohbetYolu.exec(new URL(a.href, location.href).pathname);
    return m ? decodeURIComponent(m[1]) : '';
  }
  function baglantiAdi(a) {
    const s = Array.from(a.querySelectorAll('span, div')).map((x) => x.childElementCount ? '' : x.textContent.trim()).find(Boolean);
    return (s || a.textContent || '').trim().slice(0, 40);
  }
  function sohbetAdi() {
    const id = sohbetKimligi();
    const a = sohbetBaglantilari().find((x) => baglantiKimligi(x) === id);
    return (a && baglantiAdi(a)) || _('buSohbet');
  }

  // ---------------------------------------------------------------- sahte fare ve tuş (Instagram'ın kendi yolu)
  function fareSecenek(hedef) {
    const r = hedef.getBoundingClientRect();
    return { bubbles: true, cancelable: true, composed: true, view: window, clientX: r.left + r.width / 2, clientY: r.top + r.height / 2,
      pointerType: 'mouse', isPrimary: true, pointerId: 1, button: 0, buttons: 0 };
  }
  function fareUstunde(hedef, satir) {
    const o = fareSecenek(hedef);
    const nokta = document.elementFromPoint(o.clientX, o.clientY);
    const asil = nokta && satir && satir.contains(nokta) ? nokta : hedef;   // balonun ortasındaki gerçek öğe
    for (const t of ['pointerover', 'pointerenter', 'mouseover', 'mouseenter', 'pointermove', 'mousemove']) {
      try { asil.dispatchEvent(t.startsWith('pointer') ? new PointerEvent(t, o) : new MouseEvent(t, o)); } catch (_) { /* yok */ }
    }
  }
  /** Meta'nın "press" bileşenleri için basma + bırakma + tıklama. */
  function basTikla(e) {
    const o = Object.assign(fareSecenek(e), { buttons: 1 });
    for (const t of ['pointerdown', 'mousedown']) { try { e.dispatchEvent(t.startsWith('pointer') ? new PointerEvent(t, o) : new MouseEvent(t, o)); } catch (_) { /* yok */ } }
    o.buttons = 0;
    for (const t of ['pointerup', 'mouseup']) { try { e.dispatchEvent(t.startsWith('pointer') ? new PointerEvent(t, o) : new MouseEvent(t, o)); } catch (_) { /* yok */ } }
    e.click();
  }
  function fareCikti(hedef) {
    for (const t of ['pointerout', 'pointerleave', 'mouseout', 'mouseleave']) {
      try { hedef.dispatchEvent(new MouseEvent(t, { bubbles: true, view: window })); } catch (_) { /* yok */ }
    }
  }
  let sentetik = false;   // kendi gönderdiğimiz Esc, Durdur kısayolu sayılmasın
  function escBas() {
    const o = { key: 'Escape', code: 'Escape', keyCode: 27, bubbles: true, cancelable: true };
    sentetik = true;
    try {
      (document.activeElement || document.body).dispatchEvent(new KeyboardEvent('keydown', o));
      document.dispatchEvent(new KeyboardEvent('keydown', o));
    } finally { sentetik = false; }
  }

  // ---------------------------------------------------------------- motor
  const motor = {
    kip: 'bos',            // bos | hazir | tara | calis | bitti | bekle | gecis | engel | hata
    calisiyor: false, deneme: true, bulunan: 0, alinan: 0, hata: 0, hedef: 0,
    sonMesaj: '', hataTur: '', sonKip: '', zamanlayici: 0, hedefZaman: 0, onayBekliyor: 0, durSinyali: false,
    bulgu: { menu: null, secenek: null, onay: null },
    son: null, gunluk: [],
  };
  let islenen = new WeakSet();

  function gunlukYaz(anahtar, deger) {
    motor.gunluk.unshift({ t: Date.now(), anahtar, deger });
    if (motor.gunluk.length > 30) motor.gunluk.length = 30;
  }

  function bekle(ms) {
    return new Promise((coz) => {
      const bitis = Date.now() + ms * hiz;
      const dongu = () => {
        if (motor.durSinyali || Date.now() >= bitis) { coz(); return; }
        setTimeout(dongu, Math.min(100, Math.max(5, bitis - Date.now())));
      };
      dongu();
    });
  }
  async function bulana(fn, ms) {
    const bitis = Date.now() + ms;   // sayfanın cevap süresi; test hızlandırması uygulanmaz
    for (;;) {
      const v = fn();
      if (v) return v;
      if (motor.durSinyali || Date.now() >= bitis) return null;
      await new Promise((c) => setTimeout(c, 50));
    }
  }

  function kisalt(s) { s = String(s || ''); return s.length > 40 ? s.slice(0, 39) + '…' : s; }

  /** Tek mesaj: 'alindi' | 'sayildi' | 'degil' | 'menu' | 'secenek' | 'onay' | 'kalmadi' */
  async function mesajIsle(satir, deneme) {
    // önceki mesajdan açık menü ya da pencere kalmasın: eski "Unsend" düğmesi bu mesaja ait sanılmasın
    if (menuAcikMi() || onayDugmesi()) {
      escBas();
      if (!await bulana(() => !menuAcikMi() && !onayDugmesi(), 800)) return 'menu';
    }
    satir.scrollIntoView({ block: 'center' });
    await bekle(120);
    const hedef = satir.querySelector(SEC.metin) || satir.querySelector(SEC.medya) || satir;
    const vazgec = () => { escBas(); fareCikti(hedef); return 'durdu'; };
    if (motor.durSinyali) return vazgec();
    fareUstunde(hedef, satir);
    const dugme = await bulana(() => menuDugmesi(satir), 900);
    if (motor.durSinyali) return vazgec();
    if (!dugme) { fareCikti(hedef); motor.bulgu.menu = false; return 'menu'; }
    motor.bulgu.menu = true;
    basTikla(dugme);
    const secenek = await bulana(geriAlSecenegi, 1200);
    if (motor.durSinyali) return vazgec();
    if (!secenek) {
      const acik = menuAcikMi();
      escBas();
      fareCikti(hedef);
      if (acik) return 'degil';          // menü açıldı ama geri al yok: karşı tarafın mesajı
      motor.bulgu.secenek = false;
      return 'secenek';
    }
    motor.bulgu.secenek = true;
    if (deneme) { escBas(); fareCikti(hedef); return 'sayildi'; }
    basTikla(secenek);
    await bulana(() => !secenek.isConnected || !gorunur(secenek), 800);   // menü kapansın; menünün öğesi onay sanılmasın
    const onay = await bulana(() => onayDugmesi(secenek), 1500);
    if (onay && motor.durSinyali) return vazgec();          // onaylanmadan durdu: mesaj yerinde kalır
    if (onay) { motor.bulgu.onay = true; basTikla(onay); }
    const gitti = await bulana(() => !satir.isConnected || !gorunur(satir), 4000);
    if (gitti) return 'alindi';
    escBas();                                                // açık kalan pencere bir sonraki mesaja karışmasın
    if (!onay) { motor.bulgu.onay = false; return 'onay'; }
    return 'kalmadi';
  }

  async function yukariKaydir(alan) {
    const sc = kaydirmaAlani(alan);
    if (!sc) return false;
    // tepedeyken eski mesajlar geç gelebilir: 4 tur (≈ 5 sn) yükseklik ve satır değişimi beklenir
    for (let deneme = 0; deneme < 4; deneme++) {
      const once = sc.scrollTop;
      const yukseklik = sc.scrollHeight;
      const ilk = satirlar(alan)[0];
      const sayi0 = satirlar(alan).length;
      sc.scrollBy(0, -Math.max(200, sc.clientHeight * 0.85));
      await bekle(TUR_BEKLE_MS);
      if (motor.durSinyali) return true;
      if (sc.scrollTop !== once || sc.scrollHeight !== yukseklik || satirlar(alan)[0] !== ilk || satirlar(alan).length !== sayi0) return true;
    }
    return false;
  }

  function sonrakiAday(alan) {
    const liste = satirlar(alan);
    for (let i = liste.length - 1; i >= 0; i--) {
      const r = liste[i];
      if (islenen.has(r)) continue;
      if (!benimMi(r)) { islenen.add(r); continue; }
      const neden = suzgectenGecer(r);
      if (neden) { islenen.add(r); gunlukYaz('g_atlandi', { neden }); continue; }
      return r;
    }
    return null;
  }

  function engelle() {
    ayar.bekleme = Math.min(10000, ayar.bekleme * 2);
    ayarYaz();
    calismaYaz(null);
    motor.kip = 'engel';
    gunlukYaz('g_hata', { neden: 'engelCip' });
  }

  async function calistir(denemeZorla) {
    if (motor.calisiyor) return;
    let alan = sohbetAlani();
    clearTimeout(motor.zamanlayici);
    motor.zamanlayici = 0;
    if (!alan) { motor.kip = sohbetKimligi() ? 'hata' : 'bos'; motor.hataTur = 's_hataAlan'; ciz(); return; }
    Object.assign(motor, { calisiyor: true, deneme: typeof denemeZorla === 'boolean' ? denemeZorla : ayar.deneme, bulunan: 0, alinan: 0, hata: 0, durSinyali: false, hataTur: '', onayBekliyor: 0 });
    motor.hedef = motor.deneme ? Infinity : ayar.enCok;
    motor.kip = motor.deneme ? 'tara' : 'calis';
    motor.baslangic = Date.now();
    islenen = new WeakSet();
    const id = sohbetKimligi();
    let sonuc = 'tepe';
    let artArda = 0;
    ciz();
    try {
      for (;;) {
        if (motor.durSinyali) { sonuc = 'durdu'; break; }
        if (sohbetKimligi() !== id) { sonuc = 'durdu'; break; }
        if (ayar.engel && engelVarMi()) { sonuc = 'engel'; break; }
        if (!motor.deneme && motor.alinan >= motor.hedef) { sonuc = 'sinir'; break; }
        if (!alan.e.isConnected) alan = sohbetAlani() || alan;   // Instagram listeyi yeniden kurduysa
        const aday = sonrakiAday(alan);
        if (!aday) {
          if (await yukariKaydir(alan)) continue;
          sonuc = 'tepe';
          break;
        }
        islenen.add(aday);
        const metin = kisalt(mesajMetni(aday) || _('medyaMesaj'));
        const s = await mesajIsle(aday, motor.deneme);
        if (s === 'durdu') { sonuc = 'durdu'; break; }
        if (s === 'alindi') { motor.alinan++; motor.bulunan++; artArda = 0; gunlukYaz('g_alindi', { m: metin }); }
        else if (s === 'sayildi') { motor.bulunan++; artArda = 0; gunlukYaz('g_sayildi', { m: metin }); }
        else if (s === 'degil') { artArda = 0; gunlukYaz('g_atlandi', { neden: 'n_degil' }); }
        else {
          motor.hata++; artArda++;
          gunlukYaz('g_hata', { neden: { menu: 'n_menu', secenek: 'n_secenek', onay: 'n_onay', kalmadi: 'n_kalmadi' }[s] });
          if (artArda >= ART_ARDA_HATA) { sonuc = s === 'onay' ? 'hataOnay' : 'hataMenu'; break; }
        }
        ciz();
        if (ayar.engel && engelVarMi()) { sonuc = 'engel'; break; }
        await bekle(motor.deneme ? DENEME_BEKLE_MS : ayar.bekleme);
      }
    } catch (hata) {
      sonuc = 'hataMenu';
      gunlukYaz('g_hata', { neden: String(hata && hata.message || hata).slice(0, 60) });
    } finally {
      motor.calisiyor = false;
    }
    bitir(sonuc, id);
  }

  /** Bilinen mesaj sayısı: deneme yalnız tam sayımda (tepe) yazar; canlı her sonda geri alınanı düşer. */
  function sayimYaz(id, sonuc) {
    const s = depoOku('sayimlar', {}) || {};
    if (motor.deneme) { if (sonuc === 'tepe') s[id] = motor.bulunan; }
    else if (sonuc === 'tepe') s[id] = motor.hata;            // başa ulaşıldı: yalnız hata veren mesajlar kaldı
    else if (typeof s[id] === 'number') s[id] = Math.max(0, s[id] - motor.alinan);
    depoYaz('sayimlar', s);
  }
  function kalanSayi() {
    const s = depoOku('sayimlar', {}) || {};
    const v = s[sohbetKimligi()];
    if (typeof v !== 'number') return null;
    return motor.calisiyor && !motor.deneme ? Math.max(0, v - motor.alinan) : v;
  }

  function bitir(sonuc, id) {
    motor.son = { zaman: Date.now(), deneme: motor.deneme, alinan: motor.alinan, bulunan: motor.bulunan, hata: motor.hata, sonuc };
    sayimYaz(id, sonuc);
    const sira = siraOku();
    const calisma = calismaOku();
    if (sonuc === 'engel') engelle();
    else if (sonuc === 'durdu') { motor.kip = 'bitti'; motor.sonKip = motor.deneme ? 's_durduDeneme' : 's_durdu'; calismaYaz(null); }
    else if (sonuc === 'hataMenu' || sonuc === 'hataOnay') { motor.kip = 'hata'; motor.hataTur = sonuc === 'hataOnay' ? 's_hataOnay' : 's_hataMenu'; calismaYaz(null); }
    else if (sonuc === 'sinir') {
      if (ayar.otoDk > 0) {
        motor.kip = 'bekle';
        if (calisma) calismaYaz(Object.assign({}, calisma, { zaman: Date.now() }));
        const denemeKip = motor.deneme;
        zamanla(ayar.otoDk * 60000, () => {
          if (sohbetKimligi() === id) { calistir(denemeKip); return; }
          motor.kip = 'bitti'; motor.sonKip = 's_durdu'; calismaYaz(null); ciz();   // kullanıcı başka sohbete geçti
        });
      } else { motor.kip = 'bitti'; motor.sonKip = 's_bittiSinir'; calismaYaz(null); }
    } else {   // tepe: bu sohbet bitti
      motor.kip = 'bitti';
      motor.sonKip = motor.deneme ? 's_bittiDeneme' : 's_bitti';
      if (calisma && calisma.sekme === SEKME && sira.length) {
        const i = sira.findIndex((x) => x.id === id);
        const sonraki = sira[i + 1];
        if (i >= 0 && sonraki) {
          calismaYaz({ aktif: true, i: i + 1, id: sonraki.id, deneme: motor.deneme, zaman: Date.now() });
          motor.kip = 'gecis';
          motor.gecisHedef = sonraki.id;
          motor.gecisAd = (sira[i] && sira[i].ad) || _('buSohbet');
          zamanla(ayar.sohbetArasiDk * 60000, () => { location.assign('/direct/t/' + encodeURIComponent(sonraki.id) + '/'); });
        } else {
          if (i >= 0) motor.sonKip = 's_hepsiBitti';
          calismaYaz(null);
        }
      }
    }
    taniYenile();
    ciz();
  }

  function zamanla(ms, fn) {
    clearTimeout(motor.zamanlayici);
    motor.hedefZaman = Date.now() + ms * hiz;
    motor.zamanlayici = setTimeout(() => { motor.zamanlayici = 0; fn(); }, ms * hiz);
  }

  function durdur() {
    motor.onayBekliyor = 0;
    if (motor.calisiyor) { motor.durSinyali = true; return; }
    if (motor.zamanlayici) {
      clearTimeout(motor.zamanlayici);
      motor.zamanlayici = 0;
      motor.kip = 'bitti';
      motor.sonKip = motor.deneme ? 's_durduDeneme' : 's_durdu';
      calismaYaz(null);
      ciz();
    }
  }

  /** Canlı kipte ilk Başlat onay ister (geri alınamayan iş). */
  function baslatTiklandi() {
    if (motor.calisiyor) return;
    if (!ayar.deneme && !(motor.onayBekliyor && Date.now() < motor.onayBekliyor)) {
      motor.onayBekliyor = Date.now() + 6000;
      ciz();
      setTimeout(() => { if (motor.onayBekliyor && Date.now() >= motor.onayBekliyor) { motor.onayBekliyor = 0; ciz(); } }, 6100);
      return;
    }
    motor.onayBekliyor = 0;
    const sira = siraOku();
    const id = sohbetKimligi();
    if (sira.length) {
      const i = sira.findIndex((x) => x.id === id);
      if (i < 0) {   // açık sohbet sırada değil: sıradaki ilk sohbete git
        calismaYaz({ aktif: true, i: 0, id: sira[0].id, deneme: ayar.deneme, zaman: Date.now() });
        location.assign('/direct/t/' + encodeURIComponent(sira[0].id) + '/');
        return;
      }
      calismaYaz({ aktif: true, i, id, deneme: ayar.deneme, zaman: Date.now() });
    }
    calistir();
  }

  // ---------------------------------------------------------------- sıra (E5)
  function siraOku() {
    const v = depoOku('kuyruk', []);
    return Array.isArray(v) ? v.filter((x) => x && typeof x.id === 'string' && x.id.length < 80).slice(0, 50) : [];
  }
  function siraYaz(s) { depoYaz('kuyruk', s); }
  // Çoklu sohbet işi yalnız başladığı sekmede sürer (sekme kimliği sessionStorage'da; sayfa yenilense de kalır)
  const SEKME = (() => {
    try {
      let k = sessionStorage.getItem('aalabs-igu-sekme');
      if (!k) { k = Math.random().toString(36).slice(2) + Date.now().toString(36); sessionStorage.setItem('aalabs-igu-sekme', k); }
      return k;
    } catch (_) { return 'sekme-' + Math.random().toString(36).slice(2); }
  })();
  function calismaOku() {
    const c = depoOku('calisma', null);
    if (!c || !c.aktif || typeof c.i !== 'number' || typeof c.id !== 'string' || Date.now() - (c.zaman || 0) > CALISMA_OMRU_MS) return null;
    return c;
  }
  function calismaYaz(c) { depoYaz('calisma', c ? Object.assign({ sekme: SEKME }, c) : null); }
  function siradaMi(id) { return siraOku().some((x) => x.id === id); }
  function siraDegistir(id, ad) {
    if (!id) return;
    const s = siraOku();
    const i = s.findIndex((x) => x.id === id);
    if (i >= 0) s.splice(i, 1); else s.push({ id, ad: String(ad || '').slice(0, 40) });
    siraYaz(s);
    ciz();
  }

  // ---------------------------------------------------------------- tema
  function parlaklik(renk) {
    const m = /rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)(?:[,\s/]+([\d.]+))?/.exec(renk || '');
    if (!m) return null;
    if (m[4] !== undefined && Number(m[4]) === 0) return null;
    const kanal = (v) => { v = Number(v) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };
    return 0.2126 * kanal(m[1]) + 0.7152 * kanal(m[2]) + 0.0722 * kanal(m[3]);
  }
  function temaOku() {
    if (ayar.tema === 'acik') return { koyu: false, kaynak: 'ayar' };
    if (ayar.tema === 'koyu') return { koyu: true, kaynak: 'ayar' };
    for (const o of [document.body, document.documentElement]) {
      if (!o) continue;
      const l = parlaklik(getComputedStyle(o).backgroundColor);
      if (l !== null) return { koyu: l < 0.18, kaynak: 'zemin' };
    }
    return { koyu: !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches), kaynak: 'sistem' };
  }
  function temaUygula() {
    if (!ev) return;
    ev.setAttribute('data-theme', temaOku().koyu ? 'dark' : 'light');
    ev.style.setProperty('--o', String(ayar.olcek / 100));
  }

  // ---------------------------------------------------------------- arayüz kökü (Shadow DOM)
  const SVG = 'http://www.w3.org/2000/svg';
  const IKON = {   // Lucide 1.55.0 (ISC)
    ayar: [['path', { d: 'M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915' }], ['circle', { cx: 12, cy: 12, r: 3 }]],
    oynat: [['path', { d: 'M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z' }]],
    kare: [['rect', { width: 18, height: 18, x: 3, y: 3, rx: 2 }]],
    kapat: [['path', { d: 'M18 6 6 18' }], ['path', { d: 'm6 6 12 12' }]],
    tamam: [['path', { d: 'M20 6 9 17l-5-5' }]],
    hata: [['circle', { cx: 12, cy: 12, r: 10 }], ['line', { x1: 12, x2: 12, y1: 8, y2: 12 }], ['line', { x1: 12, x2: 12.01, y1: 16, y2: 16 }]],
    kopyala: [['rect', { width: 14, height: 14, x: 8, y: 8, rx: 2, ry: 2 }], ['path', { d: 'M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2' }]],
    arti: [['path', { d: 'M5 12h14' }], ['path', { d: 'M12 5v14' }]],
  };
  function ikon(ad, boy = 16) {
    const s = document.createElementNS(SVG, 'svg');
    const oz = { viewBox: '0 0 24 24', width: boy, height: boy, fill: 'none', stroke: 'currentColor', 'stroke-width': 2,
      'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true', focusable: 'false' };
    for (const [k, v] of Object.entries(oz)) s.setAttribute(k, String(v));
    for (const [etiket, o] of IKON[ad]) {
      const p = document.createElementNS(SVG, etiket);
      for (const [k, v] of Object.entries(o)) p.setAttribute(k, String(v));
      s.appendChild(p);
    }
    return s;
  }
  /** Öğe kurucu: innerHTML yok (Trusted Types). Çocuklar düzleştirilir. */
  function el(etiket, oz, ...cocuk) {
    const e = document.createElement(etiket);
    if (oz) {
      for (const [k, v] of Object.entries(oz)) {
        if (v === undefined || v === null || v === false) continue;
        if (k === 'class') e.className = v;
        else if (k === 'text') e.textContent = v;
        else if (k.startsWith('on') && typeof v === 'function') e.addEventListener(k.slice(2), v);
        else e.setAttribute(k, v === true ? '' : String(v));
      }
    }
    for (const c of cocuk.flat(Infinity)) {
      if (c === null || c === undefined || c === false) continue;
      e.append(c instanceof Node ? c : document.createTextNode(String(c)));
    }
    return e;
  }

  const carp = (s) => s.replace(/(^|[^\w.#-])(\d+(?:\.\d+)?)px/g, (m, on, n) => (Number(n) <= 2 ? m : `${on}calc(${n}px*var(--o))`));
  const ARAYUZ_CSS = carp(`
:host { all: initial; --o: 1; }
* { box-sizing: border-box; }
[hidden] { display: none !important; }
.yazi { font: 400 13px/1.45 var(--yazi); color: var(--metin); }
button, input, select { font: inherit; color: inherit; }
button:focus-visible, input:focus-visible, select:focus-visible, [tabindex]:focus-visible { outline: 2px solid var(--vurgu); outline-offset: 1px; }
.nokta { width: 8px; height: 8px; border-radius: 50%; background: var(--hata); flex: none; display: inline-block; }

.tetik { position: fixed; right: calc(16px + env(safe-area-inset-right, 0px)); bottom: calc(96px + env(safe-area-inset-bottom, 0px)); z-index: 2147483645;
  height: 32px; padding: 0 10px; border: 1px solid var(--ana); border-radius: var(--kose-l); background: var(--ana); color: var(--ana-uzeri);
  font: 600 12px/1 var(--yazi); letter-spacing: .03em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
.tetik:hover { filter: brightness(1.08); }
.tetik .nokta { outline: 2px solid var(--ana-uzeri); }

.kart { position: fixed; right: calc(16px + env(safe-area-inset-right, 0px)); bottom: calc(136px + env(safe-area-inset-bottom, 0px)); z-index: 2147483645;
  width: 300px; max-height: calc(100vh - 160px); overflow: auto; background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar); border-radius: var(--kose-l); font: 400 13px/1.45 var(--yazi); }
.kart-bas { display: flex; align-items: center; gap: 8px; padding: 8px 6px 8px 10px; border-bottom: 1px solid var(--ayirici); }
.kart-bas b { flex: 1; min-width: 0; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kart-govde { padding: 10px; display: grid; gap: 10px; }
.satir { display: flex; align-items: center; gap: 8px; justify-content: space-between; flex-wrap: wrap; }
.etiket { font-size: 12px; color: var(--metin-ikincil); }
.etiket b { color: var(--metin); font-weight: 600; }
.cipler { display: flex; flex-wrap: wrap; gap: 6px; }
.cip { display: inline-flex; align-items: center; gap: 4px; min-height: 22px; padding: 0 8px; border-radius: var(--kose-s); font-size: 12px; font-weight: 600; }
.cip.uyari { color: var(--uyari); background: var(--uyari-bg); }
.cip.basari { color: var(--basari); background: var(--basari-bg); }
.cip.hata { color: var(--hata); background: var(--hata-bg); }
.cip.notr { color: var(--metin-ikincil); background: var(--zemin); font-weight: 400; }
.sayac { font-variant-numeric: tabular-nums; }
.cubuk { height: 6px; background: var(--ayirici); border-radius: var(--kose-s); overflow: hidden; }
.cubuk i { display: block; height: 100%; background: var(--ana); }
.durum { font-size: 12px; color: var(--metin-ikincil); }
.durum.hata { color: var(--hata); }
.durum.basari { color: var(--basari); }
.durum.uyari { color: var(--uyari); }
.dugmeler { display: flex; gap: 6px; flex-wrap: wrap; }
.btn { height: 32px; padding: 0 12px; border: 1px solid var(--kenar); border-radius: var(--kose-s); background: var(--yuzey);
  cursor: pointer; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
.btn:hover { background: var(--ana-hover); }
.btn.ana { background: var(--ana); border-color: var(--ana); color: var(--ana-uzeri); }
.btn.ana:hover { filter: brightness(1.08); background: var(--ana); }
.btn.tehlike { background: var(--hata); border-color: var(--hata); color: var(--ana-uzeri); }
.btn.kucuk { height: 24px; padding: 0 8px; font-size: 12px; }
.btn:disabled { opacity: .55; cursor: default; filter: none; }
.btn:disabled:hover { background: var(--yuzey); }
.btn.ana:disabled:hover { background: var(--ana); }
.ikonbtn { width: 28px; height: 28px; border: 1px solid transparent; border-radius: var(--kose-s); background: transparent;
  cursor: pointer; display: inline-grid; place-items: center; padding: 0; }
.ikonbtn:hover { background: var(--ana-hover); }
.rozet { width: 22px; height: 22px; border-radius: var(--kose-m); background: var(--ana); color: var(--ana-uzeri);
  font: 600 8px/22px var(--yazi); text-align: center; letter-spacing: .02em; flex: none; }
.anahtar { width: 36px; height: 20px; border-radius: 10px; border: 1px solid var(--kenar); background: var(--yuzey); position: relative; cursor: pointer; padding: 0; flex: none; }
.anahtar::after { content: ""; position: absolute; top: 3px; left: 3px; width: 12px; height: 12px; border-radius: 50%; background: var(--kenar); transition: left 120ms linear; }
.anahtar[aria-checked="true"] { background: var(--ana); border-color: var(--ana); }
.anahtar[aria-checked="true"]::after { left: 19px; background: var(--ana-uzeri); }
.anahtar-satir { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
.uyari-kutu { border: 1px solid var(--hata); background: var(--hata-bg); color: var(--hata); border-radius: var(--kose-m); padding: 6px 8px; font-size: 12px; }

.isaret { position: fixed; z-index: 2147483644; width: 22px; height: 22px; padding: 0; border: 1px solid var(--kenar); border-radius: var(--kose-s);
  background: var(--yuzey); color: var(--basari); cursor: pointer; display: inline-grid; place-items: center; }
.isaret[aria-pressed="true"] { background: var(--basari-bg); border-color: var(--basari); }

.yer { position: fixed; left: 0; right: 0; bottom: 24px; display: flex; justify-content: center; pointer-events: none; z-index: 2147483647; }
.kutu { display: flex; align-items: center; gap: var(--bosluk-2); max-width: min(480px, calc(100vw - 32px)); min-height: var(--kontrol);
  padding: 0 4px 0 12px; border-radius: var(--kose-m); font: 400 13px/1.4 var(--yazi); opacity: 0; transition: opacity 120ms linear; }
.kutu.acik { opacity: 1; }
.kutu.basari { background: var(--basari-bg); color: var(--basari); border-left: 3px solid var(--basari); }
.kutu.hata { background: var(--hata-bg); color: var(--hata); border-left: 3px solid var(--hata); pointer-events: auto; }
.kutu .metin { padding: 4px 12px 4px 0; }
.kutu .kapat { display: none; width: 24px; height: 24px; padding: 0; border: 0; border-radius: var(--kose-s); background: transparent; cursor: pointer; align-items: center; justify-content: center; }
.kutu.hata .kapat { display: inline-flex; }

.perde { position: fixed; inset: 0; background: color-mix(in srgb, var(--metin) 35%, transparent); z-index: 2147483646; }
:host([data-theme="dark"]) .perde { background: color-mix(in srgb, var(--zemin) 60%, transparent); }
.panel { position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 2147483647;
  width: min(760px, calc(100vw - 32px)); height: min(540px, calc(100vh - 32px));
  display: grid; grid-template-rows: 44px minmax(0, 1fr); background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--ayirici); border-radius: var(--kose-l); font: 400 13px/1.45 var(--yazi); }
.ust { display: flex; align-items: center; gap: 10px; padding: 0 6px 0 14px; border-bottom: 1px solid var(--ayirici); min-width: 0; }
.ust h2 { flex: 1; min-width: 0; margin: 0; font: 600 14px/1.3 var(--yazi); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.govde { display: grid; grid-template-columns: 196px minmax(0, 1fr); min-height: 0; }
.nav { border-right: 1px solid var(--ayirici); padding: 8px; display: flex; flex-direction: column; gap: 2px; overflow: auto; min-height: 0; }
.nav input { height: 28px; padding: 0 8px; border: 1px solid var(--kenar); border-radius: var(--kose-s); background: var(--yuzey); color: var(--metin); margin-bottom: 6px; width: 100%; }
.nav input::placeholder, .icerik input::placeholder { color: var(--metin-ikincil); }
.grup { font: 600 11px/1.3 var(--yazi); letter-spacing: .06em; color: var(--metin-ikincil); padding: 8px 8px 2px; }
.nav .oge { text-align: left; height: 28px; padding: 0 8px; border: 0; border-radius: var(--kose-s); background: transparent; cursor: pointer; display: flex; align-items: center; gap: 6px; min-width: 0; }
.nav .oge span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.nav .oge[aria-current="true"] { background: var(--ana-acik); font-weight: 600; }
.nav .oge:hover { background: var(--ana-hover); }
.nav .yok { color: var(--metin-ikincil); padding: 6px 8px; }
.icerik { padding: 14px 18px; overflow: auto; display: flex; flex-direction: column; gap: 12px; min-width: 0; min-height: 0; }
.icerik h3 { margin: 0; font: 600 15px/1.3 var(--yazi); }
.icerik h4 { margin: 4px 0 0; font: 600 13px/1.3 var(--yazi); }
.alt { color: var(--metin-ikincil); margin: -6px 0 0; }
.ayar { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--ayirici); }
.ayar small { grid-column: 1 / -1; color: var(--metin-ikincil); font-size: 12px; }
.ayar .hata-yazi { grid-column: 1 / -1; color: var(--hata); font-size: 12px; }
.seg { display: inline-flex; flex-wrap: wrap; justify-content: flex-end; }
.seg button { height: 28px; padding: 0 10px; border: 1px solid var(--kenar); background: var(--yuzey); margin-left: -1px; cursor: pointer; white-space: nowrap; }
.seg button:first-child { margin-left: 0; border-radius: var(--kose-s) 0 0 var(--kose-s); }
.seg button:last-child { border-radius: 0 var(--kose-s) var(--kose-s) 0; }
.seg button[aria-checked="true"] { background: var(--ana); border-color: var(--ana); color: var(--ana-uzeri); position: relative; z-index: 1; }
.seg button:hover:not([aria-checked="true"]) { background: var(--ana-hover); }
.giris { height: 28px; padding: 0 8px; border: 1px solid var(--kenar); border-radius: var(--kose-s); background: var(--yuzey); color: var(--metin); width: 150px; }
.giris.sayi { width: 84px; text-align: right; font-variant-numeric: tabular-nums; }
.giris[aria-invalid="true"] { border-color: var(--hata); }
.tus { min-width: 104px; height: 28px; padding: 0 8px; border: 1px solid var(--kenar); border-radius: var(--kose-s); background: var(--zemin); font-weight: 600; cursor: pointer; }
.tus[aria-disabled="true"] { cursor: default; opacity: .55; }
.tus.kayit { border-color: var(--vurgu); color: var(--vurgu); }
.uyari-satir { color: var(--hata); font-size: 12px; }
.satir-btn { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; padding-top: 8px; }
.satir-btn.sol { justify-content: flex-start; padding-top: 0; }
.bilgi { padding: 8px 10px; border-radius: var(--kose-m); background: var(--ana-acik); }
.bilgi.kotu { background: var(--hata-bg); color: var(--hata); }
.tani { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 6px; align-items: start; }
.tani .iyi { color: var(--basari); font-weight: 700; }
.tani .kotu { color: var(--hata); font-weight: 700; }
.tani .notr { color: var(--metin-ikincil); font-weight: 700; }
.tani small { display: block; color: var(--metin-ikincil); font: 11px/1.4 Consolas, "Cascadia Mono", monospace; overflow-wrap: anywhere; }
.gunluk { display: grid; gap: 2px; font-size: 12px; }
.gunluk div { display: flex; gap: 8px; min-width: 0; }
.gunluk time { color: var(--metin-ikincil); font-variant-numeric: tabular-nums; flex: none; }
.kabul { display: grid; gap: 6px; border: 1px solid var(--ayirici); border-radius: var(--kose-m); padding: 8px 10px; }
.kabul .ipucu { font-size: 12px; color: var(--metin-ikincil); font-style: italic; }
.kabul .seg { justify-content: flex-start; }
.kabul input { height: 28px; padding: 0 8px; border: 1px solid var(--kenar); border-radius: var(--kose-s); background: var(--yuzey); color: var(--metin); width: 100%; }
.rapor-kutu { width: 100%; min-height: 120px; font: 11px/1.4 Consolas, monospace; border: 1px solid var(--kenar); border-radius: var(--kose-s); background: var(--zemin); color: var(--metin); padding: 6px; }
.gizli { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
@media (prefers-reduced-motion: reduce) { .kutu, .anahtar::after { transition: none; } }
