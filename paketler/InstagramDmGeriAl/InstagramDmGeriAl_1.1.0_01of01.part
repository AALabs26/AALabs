  const ART_ARDA_HATA = 3;            // art arda bu kadar menü hatası → dur
  const CALISMA_OMRU_MS = 6 * 3600 * 1000;   // E5: yarım kalan çoklu sohbet işi 6 saat sonra unutulur

  let TEST = false;
  try { TEST = typeof GM_info === 'object' && !!GM_info && GM_info.scriptHandler === 'Test'; } catch (_) { TEST = false; }
  const testKanca = TEST && typeof window !== 'undefined' && window.__AALABS_TEST__ && typeof window.__AALABS_TEST__ === 'object'
    ? window.__AALABS_TEST__ : null;
  const hiz = testKanca && testKanca.hiz ? Number(testKanca.hiz) : 1;   // testte bekleme çarpanı (ör. 0.05)

