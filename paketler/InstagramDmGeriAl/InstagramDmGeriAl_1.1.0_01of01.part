  }

  function ciz() {
    durumTazele();
    tetikGuncelle();
    if (kartAcik) { if (!bil.kart || !bil.kart.isConnected) kartAc(); else kartCiz(); }
    // Tanı açıksa yenile; ama paneldeki bir kutuya yazılıyorsa yazıyı silme
    const odak = kok && kok.activeElement;
    if (panelAcik() && panelBolum === 'tani' && !(odak && /^(INPUT|TEXTAREA)$/.test(odak.tagName))) panelCiz();
  }

  // ---------------------------------------------------------------- tanı
  const tani = { sorunlu: false };
  function taniSatirlari() {
    const s = [];
    const id = sohbetKimligi();
    if (!id) {
      s.push({ durum: 'notr', ad: _('t_sayfa'), ayrinti: _('t_sayfaYok') });
    } else {
      s.push({ durum: 'iyi', ad: _('t_sayfaVar'), ayrinti: '/direct/t/…' });
      const alan = sohbetAlani();
      if (!alan) s.push({ durum: 'kotu', ad: _('t_alanYok'), ayrinti: SEC.alan.join(' | ') });
      else {
        s.push({ durum: 'iyi', ad: _('t_alanVar'), ayrinti: alan.secici });
        const sat = satirlar(alan);
        const benim = sat.filter((r) => benimMi(r)).length;
        s.push({ durum: sat.length ? 'iyi' : 'kotu', ad: _('t_satir'), ayrinti: SEC.satir + ' · ' + _('t_satirSay', { n: sayi(sat.length), b: sayi(benim) }) });
        const sc = kaydirmaAlani(alan);
        s.push({ durum: sc ? 'iyi' : 'notr', ad: _('t_kaydir'), ayrinti: sc ? 'overflow-y ✓' : '—' });
      }
    }
    const bulgu = (v, ad, sec) => ({ durum: v === null ? 'notr' : v ? 'iyi' : 'kotu', ad, ayrinti: (v === null ? _('t_denenmedi') : v ? _('t_bulundu') : _('t_bulunamadi')) + ' · ' + sec });
    s.push(bulgu(motor.bulgu.menu, _('t_menu'), 'aria-label: More / Daha fazla'));
    s.push(bulgu(motor.bulgu.secenek, _('t_secenek'), 'Unsend / Gönderimi geri al'));
    s.push(bulgu(motor.bulgu.onay, _('t_onay'), '[role=dialog] button'));
    if (dmSayfasi()) {
      const n = sohbetBaglantilari().length;
      s.push({ durum: n ? 'iyi' : 'notr', ad: _('t_liste'), ayrinti: n ? _('t_listeSay', { n: sayi(n) }) + ' · ' + SEC.listeBag : _('t_listeYok') });
    }
    s.push({ durum: gmDepo ? 'iyi' : 'kotu', ad: _('t_depo'), ayrinti: gmDepo ? _('t_depoVar') : _('t_depoYok') });
    const son = motor.son;
    s.push(son ? { durum: son.hata ? 'notr' : 'iyi', ad: _('t_son'), ayrinti: _('t_sonOzet', { zaman: saat(son.zaman), kip: _(son.deneme ? 't_kipDeneme' : 't_kipCanli'), b: son.alinan, a: son.bulunan, h: son.hata }) + ' · ' + _('sonuc_' + son.sonuc) }
      : { durum: 'notr', ad: _('t_son'), ayrinti: _('t_sonYok') });
    return s;
  }
  function taniYenile() {
    const onceki = tani.sorunlu;
    tani.sorunlu = taniSatirlari().some((x) => x.durum === 'kotu');
    if (onceki !== tani.sorunlu) { tetikGuncelle(); menuKaydet(); }
  }

  const KABUL = ['k1', 'k2', 'k3', 'k4', 'k5'];
  function kabulOku() { const v = depoOku('kabul', {}); return v && typeof v === 'object' && !Array.isArray(v) ? v : {}; }
  function kabulYaz(k, deger) { const v = kabulOku(); v[k] = Object.assign({}, v[k] || {}, deger); depoYaz('kabul', v); }

  function taniRaporu() {
    const satirlar = taniSatirlari();
    const t = temaOku();
    let yonetici = '—';
    try { if (typeof GM_info !== 'undefined' && GM_info) yonetici = (GM_info.scriptHandler || '?') + ' ' + (GM_info.version || ''); } catch (_) { /* yok */ }
    const ayarKopya = Object.assign({}, ayar);
    delete ayarKopya.sonYedek;
    ayarKopya.suzgec = ayar.suzgec ? `…(${ayar.suzgec.length})` : '';   // süzgeç kelimesi rapora girmez
    const isaret = { iyi: _('r_ok'), kotu: _('r_hata'), notr: _('r_bilgi') };
    const kabul = kabulOku();
    const elle = KABUL.map((k) => {
      const c = kabul[k];
      const isa = !c || !c.s ? '?' : c.s === 'gecti' ? '✓' : c.s === 'sorun' ? '✗' : '–';
      return `${isa} ${k.toUpperCase()} ${_(k)}${c && c.not ? ' · ' + c.not : ''}`;
    });
    const r = [
      `${AD} ${SURUM} — ${_('raporBaslik')}`,
      `${_('r_zaman')}: ${new Date().toISOString().slice(0, 16).replace('T', ' ')} UTC`,
      `${_('r_tarayici')}: ${navigator.userAgent}`,
      `${_('r_yonetici')}: ${yonetici.trim()}`,
      `${_('r_dil')}: ${ayar.dil} → ${dilKodu()} · ${_('r_tema')}: ${ayar.tema} → ${t.koyu ? 'dark' : 'light'} (${t.kaynak})`,
      `${_('r_ayarlar')}: ${JSON.stringify(ayarKopya)}`,
      `${_('r_sira')}: ${siraOku().length}`,
      '',
      ...satirlar.map((x) => `${isaret[x.durum]} ${x.ad} · ${x.ayrinti}`),
      '',
      `${_('t_gunluk')}:`,
      ...motor.gunluk.slice(0, 10).map((g) => `  ${saat(g.t)} ${gunlukMetni(g, true)}`),   // raporda mesaj metni yok
      '',
      _('r_elle'),
      ...elle,
    ];
    return r.join('\n');
  }
  function gunlukMetni(g, gizle) {
    const d = Object.assign({}, g.deger);
    if (gizle && 'm' in d) d.m = '…';
    if (d.neden && (d.neden in METIN.tr)) d.neden = _(d.neden);
    return _(g.anahtar, d);
  }

  function gmPano() {
    try { if (typeof GM_setClipboard === 'function') return (x) => GM_setClipboard(x, 'text'); } catch (_) { /* yok */ }
    try { if (typeof GM !== 'undefined' && GM && typeof GM.setClipboard === 'function') return (x) => GM.setClipboard(x, 'text'); } catch (_) { /* yok */ }
    return null;
  }
  async function panoyaYaz(metin) {
    const gm = gmPano();
    if (gm) { try { await gm(metin); return true; } catch (_) { /* sıradaki */ } }
    if (navigator.clipboard && window.isSecureContext) { try { await navigator.clipboard.writeText(metin); return true; } catch (_) { /* sıradaki */ } }
    return false;
  }
  let raporYedek = '';
  let raporOdakla = false;
  async function raporuKopyala() {
    const metin = taniRaporu();
    if (await panoyaYaz(metin)) { raporYedek = ''; bildir('basari', _('raporKopyalandi')); }
    else { raporYedek = metin; raporOdakla = true; bildir('hata', _('kopyaHata')); if (!panelAcik()) panelAc('tani'); else { panelBolum = 'tani'; panelCiz(); } }
  }

  // ---------------------------------------------------------------- eklenti menüsü
  let menuIdleri = [];
  let menuKayitli = false;
  let idsizMenu = false;
  function menuKaydet() {
    if (typeof GM_registerMenuCommand !== 'function') return;
    const silinebilir = typeof GM_unregisterMenuCommand === 'function' && !idsizMenu;
    if (menuKayitli && !silinebilir) return;
    try {
      if (silinebilir) for (const m of menuIdleri) { try { GM_unregisterMenuCommand(m); } catch (_) { /* yok */ } }
      menuIdleri = [];
      menuKayitli = true;
      const ekle = (ad, fn, tus) => { const m = GM_registerMenuCommand(ad, fn, tus); if (m === undefined || m === null) idsizMenu = true; else menuIdleri.push(m); };
      // eski menü silinemiyorsa bir kez, iki dilde ve işaretsiz yazılır (sonradan güncellenemez)
      const ad = (k) => (silinebilir ? _(k) : `${METIN.tr[k]} / ${METIN.en[k]}`);
      ekle(ad('menuPanel'), () => kartAc(), 'p');
      ekle(ad('menuAyarlar') + (silinebilir && tani.sorunlu ? ' ●' : ''), () => panelAc(), 'a');
      ekle(ad('menuRapor'), () => raporuKopyala(), 't');
    } catch (_) { /* yönetici menüyü desteklemiyor */ }
  }

  // ---------------------------------------------------------------- Ayarlar penceresi
  let panelBolum = 'geri';
  let aramaMetni = '';
  let oncekiOdak = null;
  let kayit = null;
  let tusHatasi = '';
  const alanHatasi = {};

  function panelAcik() { return !!(bil.panel && bil.panel.isConnected); }
  function odakDongusu(e) {
    const ogeler = Array.from(bil.panel.querySelectorAll('button, input:not([type="file"]), textarea, [tabindex]:not([tabindex="-1"])'))
      .filter((o) => !o.disabled && o.getClientRects().length);
    if (!ogeler.length) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    const i = ogeler.indexOf(kok.activeElement);
    const j = i < 0 ? 0 : (i + (e.shiftKey ? -1 : 1) + ogeler.length) % ogeler.length;
    ogeler[j].focus();
  }
  function panelAc(bolum) {
    kokKur();
    if (!kok) return;
    temaUygula();
    if (bolum) panelBolum = bolum;
    taniYenile();
    if (!panelAcik()) {
      oncekiOdak = (kok.activeElement) || document.activeElement;
      bil.perde = el('div', { class: 'perde', onclick: () => panelKapat() });
      bil.panel = el('div', { class: 'panel yazi', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'igu-ayar-baslik', 'data-panel': '' });
      kok.append(bil.perde, bil.panel);
    }
    panelCiz();
    if (bil.ara) bil.ara.focus({ preventScroll: true });
  }
  function panelKapat() {
    kayitBitir();
    if (bil.panel) bil.panel.remove();
    if (bil.perde) bil.perde.remove();
    bil.panel = bil.perde = bil.ara = null;
    aramaMetni = '';
    tusHatasi = '';
    raporYedek = '';
    for (const k of Object.keys(alanHatasi)) delete alanHatasi[k];
    if (oncekiOdak && oncekiOdak.isConnected && typeof oncekiOdak.focus === 'function') { try { oncekiOdak.focus({ preventScroll: true }); } catch (_) { /* yok */ } }
    oncekiOdak = null;
  }

  function ayarDegis(k, v, panelCizme) {
    ayar[k] = v;
    ayarYaz();
    if (k === 'deneme') motor.onayBekliyor = 0;
    if (k === 'dil') { menuKaydet(); }
    if (k === 'tema' || k === 'olcek') temaUygula();
    ciz();
    if (panelAcik() && !panelCizme) panelCiz();   // giriş kutusundan gelen değerde panel yeniden kurulmaz (tıklama kaybolmasın)
  }
  function bolumSifirla(b) {
    for (const k of BOLUM_ANAHTAR[b] || []) ayar[k] = VARSAYILAN[k];
    for (const k of Object.keys(alanHatasi)) delete alanHatasi[k];
    ayarYaz();
    menuKaydet();
    temaUygula();
    tusHatasi = '';
    ciz();
    panelCiz();
    bildir('basari', _('sifirlandi'));
  }

  let etiketSayac = 0;
  function ayarSatiri(ad, aciklama, denetimKur, hataAnahtar) {
    const id = 'e' + (++etiketSayac);
    const s = el('div', { class: 'ayar' }, el('span', { id }, ad), denetimKur(id));
    if (aciklama) s.append(el('small', {}, aciklama));
    if (hataAnahtar && alanHatasi[hataAnahtar]) {
      const h = alanHatasi[hataAnahtar];
      const yaz = (v) => String(v / h.carpan).replace('.', dilKodu() === 'tr' ? ',' : '.');
      s.append(el('span', { class: 'hata-yazi', role: 'alert' }, _('gecersiz', { a: `${yaz(h.a)}–${yaz(h.b)}${h.birim ? ' ' + _('sn', { n: '' }).trim() : ''}` })));   // o anki dilde
    }
    return s;
  }
  function anahtar(k, etiketId) {
    return el('button', { class: 'anahtar', type: 'button', role: 'switch', 'aria-checked': String(!!ayar[k]), 'aria-labelledby': etiketId,
      'data-ayar': k, disabled: (k === 'deneme' && motor.calisiyor) ? true : null, onclick: () => ayarDegis(k, !ayar[k]) });
  }
  function segment(k, secenekler, etiketId) {
    const g = el('div', { class: 'seg', role: 'radiogroup', 'aria-labelledby': etiketId, 'data-ayar': k });
    for (const [deger, yazi] of secenekler) {
      g.append(el('button', { type: 'button', role: 'radio', 'aria-checked': String(ayar[k] === deger), 'data-deger': String(deger), onclick: () => ayarDegis(k, deger) }, yazi));
    }
    return g;
  }
  /** Sayı girişi: kutudan çıkınca ya da Enter'da doğrulanır; geçersizde eski değer kalır, nedeni yazılır. */
  function sayiGirisi(k, etiketId, carpan, birimYazi) {
    const [a, b] = ARALIK[k];
    const g = el('input', { class: 'giris sayi', type: 'text', inputmode: 'decimal', 'aria-labelledby': etiketId, 'data-ayar': k,
      value: String(ayar[k] / carpan).replace('.', dilKodu() === 'tr' ? ',' : '.'), 'aria-invalid': alanHatasi[k] ? 'true' : null });
    const uygula = () => {
      const v = Number(String(g.value).replace(',', '.').trim()) * carpan;
      const d = aralikDogrula(k, v);
      if (d === null) {
        alanHatasi[k] = { a, b, carpan, birim: !!birimYazi };
        panelCiz();
        return;
      }
      const hataVardi = !!alanHatasi[k];
      delete alanHatasi[k];
      if (d !== ayar[k]) { ayarDegis(k, d, !hataVardi); bildir('basari', _('kaydedildi')); } else if (hataVardi) panelCiz();
      g.removeAttribute('aria-invalid');
    };
    g.addEventListener('change', uygula);
    g.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); uygula(); } });
    return g;
  }
  function sifirlaDugmesi(b) {
    return el('div', { class: 'satir-btn' }, el('button', { class: 'btn', type: 'button', 'data-sifirla': b, onclick: () => bolumSifirla(b) }, _('varsayilan')));
  }
  function bolumMetni(b) {
    const an = {
      geri: ['b_geri', 'o_deneme', 'o_enCok', 'o_bekle', 'o_suzgec', 'o_suzgecKip', 'o_tur', 'o_oto', 'o_engel', 'o_cok'],
      genel: ['b_genel', 'dil', 'tema', 'olcek', 'dil_tarayici', 'tema_sayfa'],
      kisayol: ['b_kisayol', 'k_ayarlar', 'k_durdur'],
      tani: ['b_tani', 'raporKopyala', 'kabulBaslik', 't_menu', 't_secenek', 't_onay', 't_liste', 't_depo', 't_son'],
      hakkinda: ['b_hakkinda', 'yedek', 'yedekle', 'geriYukle', 'store', 'calisma'],
    }[b];
    return katla(an.map((k) => _(k)).join(' '));
  }
  function odakSeciciBul(o) {
    if (!o || o === bil.ara || !o.getAttribute) return '';
    const q = (ad) => `[${ad}="${CSS.escape(o.getAttribute(ad))}"]`;
    if (o.hasAttribute('data-deger') && o.parentElement && o.parentElement.hasAttribute('data-ayar')) {
      const kap = o.closest('[data-kabul]');
      return (kap ? `[data-kabul="${CSS.escape(kap.getAttribute('data-kabul'))}"] ` : '') + `[data-ayar="${CSS.escape(o.parentElement.getAttribute('data-ayar'))}"] ${q('data-deger')}`;
    }
    for (const ad of ['data-ayar', 'data-bolum', 'data-sifirla', 'data-kisayol', 'data-rapor', 'data-yedekle', 'data-geri-yukle', 'data-is', 'data-kabul-not']) {
      if (o.hasAttribute(ad)) return q(ad);
    }
    return '';
  }

  // Yeniden çizim sırasında kaldırılan giriş kutusu 'change' yayar (blur); iç içe çizim olmasın
  let panelCiziliyor = false;
  let panelTekrar = false;
  function panelCiz() {
    if (panelCiziliyor) { panelTekrar = true; return; }
    panelCiziliyor = true;
    try { panelCizIc(); } finally { panelCiziliyor = false; }
    if (panelTekrar) { panelTekrar = false; queueMicrotask(panelCiz); }
  }
  function panelCizIc() {
    kayitBitir();
    if (!panelAcik()) return;
    etiketSayac = 0;
    const p = bil.panel;
    const aramaOdakta = kok.activeElement === bil.ara;
    const imlec = bil.ara ? bil.ara.selectionStart : null;
    const odakSecici = odakSeciciBul(kok.activeElement);
    p.replaceChildren();
    p.setAttribute('lang', dilKodu());
    p.append(el('div', { class: 'ust' }, el('span', { class: 'rozet', 'aria-hidden': 'true' }, KOD),
      el('h2', { id: 'igu-ayar-baslik' }, AD + ' · ' + _('ayarlar')),
      el('button', { class: 'ikonbtn', type: 'button', title: _('kapat'), 'aria-label': _('kapat'), 'data-is': 'panel-kapat', onclick: () => panelKapat() }, ikon('kapat'))));
    const arama = el('input', { type: 'search', placeholder: _('ara'), 'aria-label': _('ara') });
    arama.value = aramaMetni;
    arama.addEventListener('input', (e) => { if (e.isComposing) return; aramaMetni = arama.value; panelCiz(); });
    arama.addEventListener('compositionend', () => { aramaMetni = arama.value; panelCiz(); });
    bil.ara = arama;
    const nav = el('nav', { class: 'nav', 'aria-label': _('ayarlar') }, arama);
    const sorgu = katla(aramaMetni.trim());
    const uyan = (b) => !sorgu || bolumMetni(b).includes(sorgu);
    const tum = ['geri', 'genel', 'kisayol', 'tani', 'hakkinda'];
    const gorunen = tum.filter(uyan);
    if (gorunen.length && !gorunen.includes(panelBolum)) panelBolum = gorunen[0];
    const oge = (b) => {
      const ad = _('b_' + b);
      const d = el('button', { class: 'oge', type: 'button', title: ad, 'aria-current': String(panelBolum === b), 'data-bolum': b,
        onclick: () => { panelBolum = b; tusHatasi = ''; panelCiz(); } }, el('span', {}, ad));
      if (b === 'tani' && tani.sorunlu) d.append(el('span', { class: 'nokta', 'aria-hidden': 'true' }), el('span', { class: 'gizli' }, ' · ' + _('tetikSorun')));
      return d;
    };
    const kendi = ['geri'].filter(uyan);
    const ort = ['genel', 'kisayol', 'tani', 'hakkinda'].filter(uyan);
    if (kendi.length) nav.append(el('div', { class: 'grup' }, KOD), ...kendi.map(oge));
    if (ort.length) nav.append(el('div', { class: 'grup' }, _('ortak')), ...ort.map(oge));
    if (!gorunen.length) nav.append(el('div', { class: 'yok', role: 'status' }, _('sonucYok')));
    const ic = el('div', { class: 'icerik', 'data-icerik': panelBolum });
    if (gorunen.length) {
      ic.append(el('h3', {}, (panelBolum === 'geri' ? KOD + ' › ' : '') + _('b_' + panelBolum)));
      ({ geri: bolumGeri, genel: bolumGenel, kisayol: bolumKisayol, tani: bolumTani, hakkinda: bolumHakkinda })[panelBolum](ic);
    }
    p.append(el('div', { class: 'govde' }, nav, ic));
    if (aramaOdakta) {
      arama.focus({ preventScroll: true });
      if (imlec !== null) try { arama.setSelectionRange(imlec, imlec); } catch (_) { /* yok */ }
    } else if (odakSecici) {
      let h = null;
      try { h = p.querySelector(odakSecici); } catch (_) { h = null; }
      if (h) h.focus({ preventScroll: true });
    }
  }

  function bolumGeri(ic) {
    ic.append(el('p', { class: 'alt' }, _('geriAlt')));
    ic.append(ayarSatiri(_('o_deneme'), _('o_denemeA'), (id) => anahtar('deneme', id)));
    ic.append(ayarSatiri(_('o_enCok'), _('o_enCokA'), (id) => sayiGirisi('enCok', id, 1, ''), 'enCok'));
    ic.append(ayarSatiri(_('o_bekle'), _('o_bekleA'), (id) => sayiGirisi('bekleme', id, 1000, ' ' + _('sn', { n: '' }).trim()), 'bekleme'));
    ic.append(ayarSatiri(_('o_suzgec'), _('o_suzgecA'), (id) => {
      const g = el('input', { class: 'giris', type: 'text', maxlength: '60', placeholder: _('o_suzgecYer'), 'aria-labelledby': id, 'data-ayar': 'suzgec' });
      g.value = ayar.suzgec;
      g.addEventListener('change', () => { ayarDegis('suzgec', g.value.slice(0, 60), true); bildir('basari', _('kaydedildi')); });
      g.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); g.dispatchEvent(new Event('change')); } });
      return g;
    }));
    ic.append(ayarSatiri(_('o_suzgecKip'), '', (id) => segment('suzgecKip', [['atla', _('kip_atlaSec')], ['yalniz', _('kip_yalnizSec')]], id)));
    ic.append(ayarSatiri(_('o_tur'), _('o_turA'), (id) => segment('tur', [['hepsi', _('turSec_hepsi')], ['yazi', _('turSec_yazi')], ['medya', _('turSec_medya')]], id)));
    ic.append(ayarSatiri(_('o_oto'), _('o_otoA'), (id) => segment('otoDk', SECENEK.otoDk.map((n) => [n, n ? _('dk', { n }) : _('dkKapali')]), id)));
    ic.append(ayarSatiri(_('o_engel'), _('o_engelA'), (id) => anahtar('engel', id)));
    ic.append(ayarSatiri(_('o_cok'), _('o_cokA'), (id) => segment('sohbetArasiDk', SECENEK.sohbetArasiDk.map((n) => [n, _('dk', { n })]), id)));
    ic.append(sifirlaDugmesi('geri'));
  }
  function bolumGenel(ic) {
    const algi = _('algilanan', { dil: tarayiciDili() === 'tr' ? 'Türkçe' : 'English' });
    ic.append(ayarSatiri(_('dil'), algi, (id) => segment('dil', [['tr', _('dil_tr')], ['en', _('dil_en')], ['tarayici', _('dil_tarayici')]], id)));
    ic.append(ayarSatiri(_('tema'), '', (id) => segment('tema', [['sayfa', _('tema_sayfa')], ['acik', _('tema_acik')], ['koyu', _('tema_koyu')]], id)));
    ic.append(ayarSatiri(_('olcek'), _('olcekA'), (id) => segment('olcek', SECENEK.olcek.map((n) => [n, dilKodu() === 'tr' ? '%' + n : n + '%']), id)));
    ic.append(sifirlaDugmesi('genel'));
  }
  function bolumKisayol(ic) {
    ic.append(el('p', { class: 'alt' }, _('kisayolNot')));
    const hataYeri = el('div', { class: 'uyari-satir', role: 'alert' }, tusHatasi ? _('tusRed', { tus: tusHatasi.tus, neden: _(tusHatasi.neden) }) : '');
    const tus = el('button', { class: 'tus', type: 'button', 'data-kisayol': 'kisayolAyarlar' }, ayar.kisayolAyarlar);
    tus.addEventListener('click', () => kayitBasla(tus));
    tus.setAttribute('aria-label', _('k_ayarlar') + ': ' + ayar.kisayolAyarlar);   // görünen tuş adı erişilebilir adda da
    ic.append(ayarSatiri(_('k_ayarlar'), '', () => tus));
    if (tusHatasi) ic.append(hataYeri);
    ic.append(ayarSatiri(_('k_durdur'), _('degismez'), () => el('span', { class: 'tus', 'aria-disabled': 'true', style: 'display:inline-flex;align-items:center;justify-content:center' }, 'Esc')));
    ic.append(sifirlaDugmesi('kisayol'));
  }
  function kayitBasla(tus) {
    kayitBitir();
    tus.classList.add('kayit');
    tus.textContent = _('tusaBas');
    const dinle = (e) => {
      if (!e.isTrusted || sentetik) return;
      if (e.key === 'Tab') { kayitBitir(); tus.classList.remove('kayit'); tus.textContent = ayar.kisayolAyarlar; return; }   // Tab engellenmez
      e.preventDefault();
      e.stopImmediatePropagation();
      if (e.repeat) return;
      if (e.key === 'Escape') { kayitBitir(); panelCiz(); return; }
      const kombo = tusKombo(e);
      if (!kombo) return;
      const neden = tusGecerliMi(kombo);
      kayitBitir();
      if (neden) { tusHatasi = { tus: kombo, neden }; panelCiz(); return; }
      tusHatasi = '';
      ayarDegis('kisayolAyarlar', kombo);
      bildir('basari', _('tusDegisti', { tus: kombo }));
    };
    kayit = { dinle };
    window.addEventListener('keydown', dinle, true);
    tus.addEventListener('blur', () => { if (kayit && kayit.dinle === dinle) { kayitBitir(); tus.classList.remove('kayit'); tus.textContent = ayar.kisayolAyarlar; } }, { once: true });
  }
  function kayitBitir() {
    if (!kayit) return;
    window.removeEventListener('keydown', kayit.dinle, true);
    kayit = null;
  }
  function bolumTani(ic) {
    const satirlar = taniSatirlari();
    const kotu = satirlar.filter((x) => x.durum === 'kotu').length;
    ic.append(el('div', { class: 'bilgi' + (kotu ? ' kotu' : ''), role: 'status' }, kotu ? _('taniKotu', { n: kotu }) : _('taniIyi')));
    const t = el('div', { class: 'tani', 'data-tani': '' });
    for (const x of satirlar) {
      t.append(el('span', { class: x.durum, 'aria-hidden': 'true' }, x.durum === 'iyi' ? '✓' : x.durum === 'kotu' ? '✗' : '–'), el('div', {}, x.ad, el('small', {}, x.ayrinti)));
    }
    ic.append(t);
    if (motor.gunluk.length) {
      ic.append(el('h4', {}, _('t_gunluk')), el('div', { class: 'gunluk', 'data-gunluk': '' },
        motor.gunluk.slice(0, 8).map((g) => el('div', {}, el('time', {}, saat(g.t)), el('span', {}, gunlukMetni(g))))));
    }
    // kabul maddeleri (K1–K5)
    ic.append(el('h4', {}, _('kabulBaslik')), el('p', { class: 'alt', style: 'margin:0' }, _('kabulAlt')));
    const kabul = kabulOku();
    for (const k of KABUL) {
      const c = kabul[k] || {};
      const kutu = el('div', { class: 'kabul', 'data-kabul': k });
      const etiketId = 'kabul-' + k;
      kutu.append(el('span', { id: etiketId }, k.toUpperCase() + ' · ' + _(k)), el('span', { class: 'ipucu' }, _('nasil') + ' ' + _(k + 'i')));
      const g = el('div', { class: 'seg', role: 'radiogroup', 'aria-labelledby': etiketId, 'data-ayar': 'kabul-' + k });
      for (const [deger, yazi] of [['gecti', _('gecti')], ['sorun', _('sorun')], ['atla', _('atla')]]) {
        g.append(el('button', { type: 'button', role: 'radio', 'aria-checked': String(c.s === deger), 'data-deger': deger, onclick: () => { kabulYaz(k, { s: deger }); panelCiz(); } }, yazi));
      }
      kutu.append(g);
      if (c.s === 'sorun') {
        const not = el('input', { type: 'text', maxlength: '120', placeholder: _('notYer'), 'aria-label': _('notYer'), 'data-kabul-not': k });
        not.value = c.not || '';
        not.addEventListener('change', () => kabulYaz(k, { not: not.value.slice(0, 120) }));
        kutu.append(not);
      }
      ic.append(kutu);
    }
    if (raporYedek) {
      const ta = el('textarea', { class: 'rapor-kutu', readonly: true, 'aria-label': _('raporBaslik'), 'data-rapor-kutu': '' });
      ta.value = raporYedek;
      ic.append(ta);
      if (raporOdakla) { raporOdakla = false; requestAnimationFrame(() => { ta.focus(); ta.select(); }); }   // yalnız bir kez
    }
    ic.append(el('div', { class: 'satir-btn' }, el('button', { class: 'btn ana', type: 'button', 'data-rapor': '', onclick: () => raporuKopyala() }, ikon('kopyala'), _('raporKopyala'))));
  }
  function bolumHakkinda(ic) {
    ic.append(el('p', { style: 'margin:0' }, _('surum', { s: SURUM })), el('p', { class: 'alt', style: 'margin:0' }, _('store')));
    ic.append(el('h4', {}, _('calisma')), el('p', { class: 'alt', style: 'margin:0' }, _('calismaA')));
    ic.append(el('h4', {}, _('yedek')), el('p', { class: 'alt', style: 'margin:0' }, _('yedekAc')));
    ic.append(el('p', { class: 'etiket', style: 'margin:0', 'data-son-yedek': '' }, ayar.sonYedek ? _('sonYedek', { t: ayar.sonYedek }) : _('sonYedekYok')));
    const dosya = el('input', { type: 'file', accept: '.json,application/json', class: 'gizli', 'aria-hidden': 'true', tabindex: '-1', 'data-geri-yukle-dosya': '' });
    dosya.addEventListener('change', () => { if (dosya.files && dosya.files[0]) geriYukle(dosya.files[0]); });
    ic.append(dosya, el('div', { class: 'satir-btn sol' },
      el('button', { class: 'btn', type: 'button', 'data-yedekle': '', onclick: () => yedekle() }, _('yedekle')),
      el('button', { class: 'btn', type: 'button', 'data-geri-yukle': '', onclick: () => dosya.click() }, _('geriYukle'))));
  }
  function zamanDamgasi() {
    const d = new Date();
    const p = (n) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}${p(d.getDate())}-${p(d.getHours())}${p(d.getMinutes())}`;
  }
  function yedekle() {
    const damga = zamanDamgasi();
    const ayarKopya = Object.assign({}, ayar);
    delete ayarKopya.sonYedek;
    const veri = JSON.stringify({ uygulama: ID, surum: SURUM, tarih: damga, ayarlar: ayarKopya }, null, 2);
    const a = el('a', { href: 'data:application/json;charset=utf-8,' + encodeURIComponent(veri), download: `AALabs.${ID}-ayarlar-${damga}.json` });
    (bil.panel || kok).appendChild(a);
    a.click();
    a.remove();
    ayar.sonYedek = damga;
    ayarYaz();
    panelCiz();
    bildir('basari', _('yedeklendi'));
  }
  function geriYukle(dosya) {
    if (dosya.size > 64 * 1024) { bildir('hata', _('yedekHata')); return; }
    const o = new FileReader();
    o.onload = () => {
      try {
        const v = JSON.parse(String(o.result));
        if (!v || v.uygulama !== ID || !v.ayarlar || typeof v.ayarlar !== 'object' || Array.isArray(v.ayarlar)) throw new Error('biçim');
        const sonYedek = ayar.sonYedek;
        ayar = ayarDogrula(v.ayarlar);
        ayar.sonYedek = sonYedek;
        ayarYaz();
        menuKaydet();
        temaUygula();
        ciz();
        panelCiz();
        bildir('basari', _('geriYuklendi'));
      } catch (_e) { bildir('hata', _('yedekHata')); }
    };
    o.onerror = () => bildir('hata', _('yedekHata'));
    o.readAsText(dosya);
  }

  // ---------------------------------------------------------------- klavye
  function duzenlenebilirMi(d) {
    return !!(d && d.closest && d.closest('input, textarea, [contenteditable=""], [contenteditable="true"], [contenteditable="plaintext-only"]'));
  }
  function tusBasildi(e) {
    if (!e.isTrusted || sentetik) return;
    // Esc çalışan işi her durumda durdurur (panel açık ya da kısayol kaydı sürerken de)
    if (e.key === 'Escape' && motor.calisiyor) { e.preventDefault(); e.stopImmediatePropagation(); durdur(); if (kayit) { kayitBitir(); panelCiz(); } return; }
    if (e.key === 'Escape' && motor.zamanlayici && !panelAcik()) { durdur(); return; }   // bekleyen işi iptal et, Instagram'ın Esc'ini yutma
    if (kayit) return;
    if (panelAcik()) {
      if (e.key === 'Escape') { e.preventDefault(); e.stopImmediatePropagation(); panelKapat(); return; }
      if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && tusAdi(e) === 'F') { e.preventDefault(); e.stopImmediatePropagation(); if (bil.ara) bil.ara.focus(); return; }
      if (e.key === 'Tab' && !e.ctrlKey && !e.altKey && !e.metaKey) { odakDongusu(e); return; }
    }
    const kombo = tusKombo(e);
    if (kombo && kombo === ayar.kisayolAyarlar && !e.repeat && (e.ctrlKey || e.metaKey || !duzenlenebilirMi(document.activeElement))) {
      e.preventDefault(); e.stopImmediatePropagation();
      if (panelAcik()) panelKapat(); else panelAc();
    }
  }

  // ---------------------------------------------------------------- açılış ve sayfa izleme
  let sonYol = '';
  let isaretPlan = 0;
  function isaretPlanla() {
    if (isaretPlan) return;
    isaretPlan = requestAnimationFrame(() => { isaretPlan = 0; if (kartAcik) isaretleriCiz(); });
  }
  function yolDegisti() {
    if (location.pathname === sonYol) return;
    sonYol = location.pathname;
    if (motor.calisiyor) motor.durSinyali = true;
    if (motor.kip === 'bekle' && motor.zamanlayici) {   // otomatik devam yalnız başladığı sohbette
      clearTimeout(motor.zamanlayici); motor.zamanlayici = 0; calismaYaz(null);
    }
    if (motor.kip === 'gecis' && motor.zamanlayici && motor.gecisHedef && sohbetKimligi() !== motor.gecisHedef) durdur();   // kullanıcı başka yere gitti
    if (motor.kip !== 'gecis') { motor.kip = sohbetKimligi() ? 'hazir' : 'bos'; motor.bulunan = 0; motor.alinan = 0; }
    ciz();
    devamKontrol();
  }
  /** E5: sayfa yenilenince yarım kalan çoklu sohbet işine devam. */
  function devamKontrol() {
    const c = calismaOku();
    if (!c) return;
    if (c.sekme !== SEKME) return;                       // başka sekmenin işi
    const sira = siraOku();
    const beklenen = sira.find((x) => x.id === c.id);
    const yasMs = Date.now() - (c.zaman || 0);
    if (!beklenen || yasMs > (ayar.sohbetArasiDk + 3) * 60000) { calismaYaz(null); return; }   // eski ya da sırada yok
    if (sohbetKimligi() !== beklenen.id) return;
    // Durdur/Esc bu beklemeyi de iptal eder (zamanlayıcı motor.zamanlayici'de)
    motor.kip = 'gecis';
    motor.gecisHedef = beklenen.id;
    motor.gecisAd = beklenen.ad || _('buSohbet');
    kartAcik = true;
    kartAc();
    const dene = (kalan) => zamanla(kalan === 5 ? 3000 : 2000, () => {
      const c2 = calismaOku();
      if (motor.calisiyor || !c2 || c2.id !== c.id || c2.sekme !== SEKME || sohbetKimligi() !== beklenen.id) { if (!motor.calisiyor) { motor.kip = 'hazir'; ciz(); } return; }
      if (!sohbetAlani() && kalan > 0) { dene(kalan - 1); return; }   // Instagram mesajları yükleyene dek (≈ 13 sn)
      motor.kip = 'hazir';
      calistir(c2.deneme);                                // kip yalnız bu iş için; ayar değişmez
    });
    dene(5);
  }

  function basla() {
    window.addEventListener('keydown', tusBasildi, true);
    sonYol = location.pathname;
    durumTazele();
    tetikGuncelle();
    taniYenile();
    devamKontrol();
    let ara = 0;
    const gozcu = new MutationObserver(() => {
      if (ara) return;
      ara = requestAnimationFrame(() => {
        ara = 0;
        if (ev && !ev.isConnected && document.body) document.body.appendChild(ev);
        yolDegisti();
        isaretPlanla();
      });
    });
    gozcu.observe(document.body, { childList: true, subtree: true });
    window.addEventListener('popstate', yolDegisti);
    window.addEventListener('scroll', isaretPlanla, true);
    window.addEventListener('resize', isaretPlanla);
    setInterval(() => {
      yolDegisti();
      temaUygula();
      taniYenile();
      if (kartAcik && !motor.calisiyor) kartCiz();
    }, 2000);
  }

  if (testKanca) {
    testKanca.igu = { kok: () => kok, ayar: () => ayar, motor, metin: METIN, rapor: taniRaporu, sec: SEC, durdur, calistir };
  }
  menuKaydet();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', basla, { once: true });
  else basla();
})();
