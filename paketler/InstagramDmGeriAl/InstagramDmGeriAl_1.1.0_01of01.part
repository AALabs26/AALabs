// ==UserScript==
// @name         AALabs DM Geri Al
// @namespace    aalabs
// @version      1.1.0
// @description  Instagram DM'de açık sohbetteki kendi mesajlarını sırayla geri alır (unsend). Önce deneme kipinde sayar; süzgeç, otomatik devam, engel algılama ve birden çok sohbet.
// @author       AALabs
// @match        https://www.instagram.com/*
// @icon         data:image/png;base64,
// @run-at       document-start
// @noframes
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_unregisterMenuCommand
// @grant        GM_setClipboard
// @grant        GM.setClipboard
// @grant        GM_info
// @aalabs-ikon  IGU
// ==/UserScript==

/*
 * Ne yapar
 *   instagram.com/direct sohbetinde senin gönderdiğin mesajları en yeniden eskiye doğru tek tek geri alır.
 *   Her mesajda Instagram'ın kendi "Daha fazla > Gönderimi geri al > Onayla" yolunu kullanır; sunucuya
 *   kendisi istek atmaz. Karşı tarafın mesajına dokunmaz (menüsünde geri al seçeneği yoktur).
 *
 * Güvenlik
 *   - İlk açılışta deneme kipi açıktır: yalnız sayar, hiçbir şey silmez.
 *   - Canlı kipte ilk Başlat ikinci kez onay ister.
 *   - İki işlem arası en az 1,5 sn. Instagram "Daha sonra tekrar dene" derse durur (E4).
 *
 * 1.1.0 (app-lab v02.02 geçişi, q5hnw): konsol scripti (q5hnw_ig_dm_unsend_00.js) userscript oldu.
 * Tasarım kapısı: Platform P2 · Yerleşim A · E1–E5 · Ç1–Ç5 · K1–K5.
 */
(function () {
  'use strict';

