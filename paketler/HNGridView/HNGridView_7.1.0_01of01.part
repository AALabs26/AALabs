      puan: '{n} puan', yorum: '{n} yorum', yorum1: '1 yorum', tartis: 'tartış', daha: 'Daha fazla hikâye',
      makale: 'Makale', yorumlar: 'HN yorumları', yeniSekme: 'Yeni sekmede aç', degis: 'Yer değiştir', kapat: 'Kapat',
      yukleniyor: 'Yükleniyor…', yuklenemedi: 'Bu sayfa bölmede açılamadı.', neden: 'Neden: {n}', zamanAsimi: 'zaman aşımı', ag: 'ağ hatası',
      ayarAra: 'Ayarlarda ara', sonucYok: 'Bu aramayla eşleşen ayar yok.', ortak: 'ORTAK',
      bIzgara: 'Izgara', bResim: 'Küçük resim', bBolme: 'Okuma bölmesi', bArama: 'Arama',
      bGenel: 'Genel', bKisayol: 'Klavye kısayolları', bTani: 'Tanı', bHakkinda: 'Hakkında',
      fKart: 'Kart genişliği', kDar: 'Dar', kOrta: 'Orta', kGenis: 'Geniş',
