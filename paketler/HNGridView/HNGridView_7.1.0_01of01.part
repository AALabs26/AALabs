// ==UserScript==
// @name         AALabs HN Grid View
// @namespace    aalabs
// @version      7.1.0
// @description  Hacker News listesini küçük resimli kart ızgarasına çevirir; makale ve yorumları yan yana bölmede açar.
// @match        https://news.ycombinator.com/*
// @icon         data:image/png;base64,
// @grant        GM_xmlhttpRequest
// @grant        GM_addElement
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_unregisterMenuCommand
// @grant        GM_setClipboard
// @connect      *
// @run-at       document-start
// @noframes
// @aalabs-ikon  HNG
// ==/UserScript==

/* AALabs HN Grid View (HNG) — app-lab v02.02 · tasarım kapısı h7gvn:
   Yerleşim A · Görünüm G2 · Ad N1 · Kod HNG · Ekle E3 · Çıkar yok · Kabul K1–K5. */
(function () {
  'use strict';

  const SURUM = '7.1.0';
  const ONEK = 'hng';

  // ── Hangi sayfada çalışır ────────────────────────────────────────────────
  const YOL = location.pathname;
  const LISTE_SAYFASI = YOL === '/' || /^\/(news|front|newest|ask|show|jobs|best|active)\/?$/.test(YOL);

  // ── Tema tokenları (AALabs tasarım dili 1.4.1 + G2 site rengi) ───────────
  // TOKEN-BASLA
  const TOKEN_CSS = `
  :root {
    --hng-ana: #2456D6; --hng-ana-acik: #E5EBFA; --hng-ana-hover: #F2F5FD; --hng-ana-uzeri: #FFFFFF; --hng-vurgu: #2456D6;
    --hng-zemin: #F6F9FC; --hng-yuzey: #FFFFFF; --hng-metin: #17252E; --hng-metin-ikincil: #4E6269; --hng-kenar: #7A9199; --hng-ayirici: #D3DEE6;
    --hng-basari: #18763F; --hng-basari-bg: #E4F5E8; --hng-uyari: #9A5B00; --hng-uyari-bg: #FDF6D8; --hng-hata: #C4313B; --hng-hata-bg: #FDE8E8;
    --hng-site: #FF6600; --hng-site-uzeri: #000000; --hng-site-logo: #FFFFFF; --hng-perde: rgba(15, 21, 32, 0.45);
    --hng-sira-zemin: rgba(15, 21, 32, 0.72); --hng-sira-metin: #FFFFFF; --hng-cerceve-zemin: #FFFFFF;
  }
  :root[data-hng-tema="koyu"] {
    --hng-ana-acik: #1D2C4F; --hng-ana-hover: #1B2434; --hng-vurgu: #86A8FF; --hng-zemin: #0F1520; --hng-yuzey: #161E2B; --hng-metin: #E6ECF5;
    --hng-metin-ikincil: #9AA8BC; --hng-kenar: #6A7B93; --hng-ayirici: #263142; --hng-basari: #4CC38A; --hng-basari-bg: #13301F;
    --hng-uyari: #E8AC45; --hng-uyari-bg: #33270F; --hng-hata: #FF8189; --hng-hata-bg: #3A161A; --hng-perde: rgba(0, 0, 0, 0.6);
  }`;
  const HATA_SAYFASI_RENK = { zemin: '#F6F9FC', metin: '#17252E', ikincil: '#4E6269', vurgu: '#2456D6' };
  // TOKEN-BITIR

  // ── İki dil ──────────────────────────────────────────────────────────────
  const METIN = {
