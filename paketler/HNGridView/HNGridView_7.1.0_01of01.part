      ksAta: 'Ata', ksBas: 'Kısayola bas…', ksSil: 'Sil', ksVarsayilan: 'Varsayılan', ksYok: 'yok',
      ksYasak: '{k} kullanılamaz: tarayıcı ya da site bu tuşu kullanıyor.', ksCakisma: '{k} zaten "{a}" için atanmış.', ksKaydedildi: 'Kısayol kaydedildi: {k}',
      ksNot: 'Esc kısayol yakalamayı iptal eder. Tema ve dil kısayolu yok; Genel bölümünden değişir.',
      tOto: 'Otomatik denetim', tSatir: 'Hikâye satırları', tResim: 'Küçük resim', tCss: 'Makale CSS\'i', tBolme: 'Son bölme', tYol: 'İstek yolu',
      tSatirDeg: '{a}/{b} kart', tResimDeg: '{a} resim · {b} site simgesi · {c} hata', tCssDeg: '{n} stil dosyası satır içine alındı',
      tBolmeDeg: '{alan} · {durum} · {sure} sn', tBekle: 'bekliyor: {n}', tBolmeYok: 'bölme açılmadı', tResimYok: 'resim istenmedi',
      tListeDegil: 'bu sayfa liste sayfası değil', tHata: 'Başlatma hatası', tGMYok: 'GM_addElement yok: resimler sitenin CSP kuralına takılabilir',
      tElle: 'Kabul testi (elle)', tElleAlt: 'Her maddeyi dene ve cevapla. Cevaplar rapora girer.',
      gecti: 'Geçti', sorun: 'Sorun', atla: 'Atla', notYaz: 'Ne oldu? (kısa not)', raporKopyala: 'Raporu kopyala', kopyalandi: 'Rapor panoya kopyalandı',
      kopyalanamadi: 'Pano kullanılamadı. Metin seçili; Ctrl+C ile kopyala.',
      K1: 'Ön sayfadaki kartların çoğunda küçük resim görünüyor mu?', K1i: 'İlk 12 karta bak; resmi olmayanlarda site simgesi olmalı.',
      K2: 'Bir karta tıklayınca makale kendi renk ve yazı tipiyle açılıyor mu?', K2i: 'github.com ya da bir haber sitesi kartını dene.',
