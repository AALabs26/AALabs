  };
  let DIL = "tr";
  function t(anahtar, ...a) {
    let v = METIN[DIL] ? METIN[DIL][anahtar] : undefined;
    if (v === undefined) { v = METIN.tr[anahtar]; console.warn("WLO: metin yok:", DIL, anahtar); }
    if (v === undefined) return anahtar;
    return typeof v === "function" ? v(...a) : v;
  }
  const tarayiciDili = () => (/^tr\b/i.test(navigator.language || "") ? "tr" : "en");

  // ─── Varsayılanlar ───
  const RENKLER = ["belge", "tablo", "gorsel", "kod", "video", "arsiv", "onemli", "oyun", "notr"];
  const KATEGORI_IKONLARI = [
    "utensils", "cpu", "landmark", "gamepad-2", "tv", "clapperboard", "drama", "laugh", "folder", "music",
    "book-open", "dumbbell", "car", "plane", "heart", "star", "briefcase", "palette", "microscope", "newspaper",
    "mic", "trophy", "graduation-cap", "baby", "paw-print", "shirt", "hammer", "leaf", "globe", "brain", "bike", "sparkles", "tag",
  ];
  const VARSAYILAN_KATEGORILER = [
    { id: "food", ad: "Food", ikon: "utensils", renk: "video" },
    { id: "tech", ad: "Tech", ikon: "cpu", renk: "kod" },
    { id: "history", ad: "History", ikon: "landmark", renk: "arsiv" },
    { id: "gaming", ad: "Gaming", ikon: "gamepad-2", renk: "belge" },
    { id: "tvmovie", ad: "TV/Movie", ikon: "tv", renk: "onemli" },
    { id: "trailers", ad: "Trailers", ikon: "clapperboard", renk: "gorsel" },
    { id: "culture", ad: "Culture", ikon: "drama", renk: "oyun" },
    { id: "fun", ad: "Fun", ikon: "laugh", renk: "tablo" },
    { id: "misc", ad: "Misc", ikon: "folder", renk: "notr" },
  ];
  const ANAHTAR_KELIMELER = {
    food: ["recipe", "cooking", "cook", "kitchen", "food", "eat", "bake", "baking", "chef", "restaurant", "yemek", "tarif", "mutfak", "burger", "pizza", "bbq", "grill", "cuisine", "meal", "tasty", "delicious", "mukbang", "asmr food", "bon appétit", "babish", "joshua weissman", "kenji", "smash burger", "gordon ramsay", "nigella", "jamie oliver", "sorted food", "adam ragusea", "internet shaquille", "ethan chlebowski", "refika", "arda", "burak özdemir", "cenk"],
    tech: ["tech", "code", "coding", "programming", "developer", "software", "hardware", "cpu", "gpu", "linux", "windows", "python", "javascript", "ai ", "llm", "smartphone", "laptop", "review tech", "unbox", "setup", "linus tech", "mkbhd", "dave2d", "gamers nexus", "level1techs", "hardware unboxed", "jayz", "der8auer", "optimum", "3d print", "bambu", "raspberry pi", "homelab", "self-host", "docker", "rtx", "nvidia", "amd", "ryzen", "framework", "ifixit"],
    history: ["history", "ancient", "medieval", "ww1", "ww2", "world war", "empire", "ottoman", "roman", "civilization", "archaeological", "tarih", "osmanlı", "antik", "archaeology", "kings and generals", "oversimplified", "historia civilis", "fall of civilizations", "extra history", "epic history", "invicta", "history matters", "toldinstone"],
    gaming: ["gameplay", "gaming", "walkthrough", "playthrough", "let's play", "speedrun", "esports", "gamer", "steam", "ps5", "xbox", "nintendo", "baldur's gate", "hades", "elden ring", "zelda", "cyberpunk", "souls", "rpg game", "mmorpg", "fps game", "skill up", "act man", "videogamedunkey", "dunkey", "gameranx", "ign ", "gamespot"],
    tvmovie: ["series", "tv show", "episode", "season", "netflix", "hbo", "disney+", "review movie", "film review", "movie review", "analysis movie", "film analysis", "breakdown movie", "dizi", "film", "sinema", "sahne", "behind the scenes", "nerdwriter", "every frame a painting", "lessons from the screenplay", "cinema", "cinematography", "directing"],
    trailers: ["trailer", "teaser", "official trailer", "movie trailer", "fragman", "resmi fragman", "first look", "sneak peek"],
    culture: ["culture", "philosophy", "art ", "museum", "music theory", "design", "architecture", "kültür", "felsefe", "sanat", "language", "linguistics", "anthropology", "sociology", "ted talk", "tedx", "vsauce", "kurzgesagt", "veritasium", "tom scott", "wendover", "half as interesting", "johnny harris", "vox ", "poly matter"],
    fun: ["funny", "comedy", "meme", "prank", "fail", "try not to laugh", "komik", "eğlence", "vine", "tiktok compilation", "skit", "stand-up", "standup", "parody", "satire", "roast", "penguinz0", "moist", "daily dose", "unusual memes"],
  };

  // ─── Yardımcılar ───
  const bekle = (ms) => new Promise((r) => setTimeout(r, ms));
  const SAYFA = typeof unsafeWindow !== "undefined" ? unsafeWindow : window;

  class KullaniciHatasi extends Error {
    constructor(mesaj, neden) { super(mesaj); this.kullanici = mesaj; this.neden = neden; }
  }
  function kullaniciMesaji(e) {
    if (e && e.kullanici) return e.kullanici;
    return t("beklenmeyen");
  }
  function normal(s) {
    return String(s || "").toLocaleLowerCase("tr").replace(/ı/g, "i").normalize("NFD").replace(/[̀-ͯ]/g, "");
  }
  function adEsit(a, b) {
    const n = (s) => String(s || "").normalize("NFC").replace(/\s+/g, " ").trim();
    return n(a) === n(b);
  }
  function sureYaz(sn) {
    if (!sn) return "—";
    const s = Math.floor(sn / 3600), d = Math.floor((sn % 3600) / 60), n = sn % 60;
    return s > 0 ? `${s}:${String(d).padStart(2, "0")}:${String(n).padStart(2, "0")}` : `${d}:${String(n).padStart(2, "0")}`;
  }
  function toplamSure(sn) {
    const s = Math.floor(sn / 3600), d = Math.round((sn % 3600) / 60);
    return s ? t("sureSaDk", s, d) : t("sureDk", d);
  }
  function sureCoz(metin) {
    if (!metin) return 0;
    const p = String(metin).trim().split(":").map((x) => parseInt(x, 10));
    if (p.some(isNaN)) return 0;
    return p.reduce((top, x) => top * 60 + x, 0);
  }
  function sayiCoz(x) {
    if (x == null) return null;
    const m = String(x).replace(/[.,\s]/g, "").match(/\d+/);
    return m ? parseInt(m[0], 10) : null;
  }
  function damga() {
    const z = new Date();
    const p = (n) => String(n).padStart(2, "0");
    return `${z.getFullYear()}-${p(z.getMonth() + 1)}${p(z.getDate())}-${p(z.getHours())}${p(z.getMinutes())}`;
  }
  function okunurZaman() {
    const z = new Date();
    const p = (n) => String(n).padStart(2, "0");
    return `${p(z.getDate())}.${p(z.getMonth() + 1)}.${z.getFullYear()} ${p(z.getHours())}:${p(z.getMinutes())}`;
  }
  function benzersizId(ad) {
    const tr = { ç: "c", ğ: "g", ı: "i", ö: "o", ş: "s", ü: "u", Ç: "c", Ğ: "g", İ: "i", Ö: "o", Ş: "s", Ü: "u" };
    const kok = String(ad).replace(/[çğıöşüÇĞİÖŞÜ]/g, (c) => tr[c]).toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "") || "kategori";
    let id = kok, i = 2;
    while (ayar.kategoriler.some((k) => k.id === id)) id = `${kok}_${i++}`;
    return id;
  }

  // ─── Depolama ───
  function gmOku(anahtar, varsayilan) {
    try {
      const ham = GM_getValue(anahtar, null);
      if (ham == null) return varsayilan;
      return typeof ham === "string" ? JSON.parse(ham) : ham;
    } catch (e) { return varsayilan; }
  }
  function gmYaz(anahtar, deger) {
    try { GM_setValue(anahtar, JSON.stringify(deger)); } catch (e) { console.error("WLO: kayıt yazılamadı", e); }
  }

  // ─── Günlük ───
  const gunluk = (() => { const g = gmOku(GUNLUK_ANAHTAR, []); return Array.isArray(g) ? g.slice(-300) : []; })();
  let gunlukZaman = 0;
  function safeJson(o) { try { return JSON.stringify(o).slice(0, 500); } catch (e) { return String(o); } }
  function log(seviye, ...parca) {
    const metin = parca.map((p) => p instanceof Error ? `${p.message}${p.neden ? " ← " + (p.neden.message || p.neden) : ""}` : typeof p === "object" ? safeJson(p) : String(p)).join(" ");
    (seviye === "hata" ? console.error : seviye === "uyari" ? console.warn : console.log)("WLO:", metin);
    gunluk.push(`${new Date().toISOString()} ${seviye.toUpperCase()} ${metin}`);
    if (gunluk.length > 400) gunluk.splice(0, gunluk.length - 400);
    clearTimeout(gunlukZaman);
    gunlukZaman = setTimeout(() => gmYaz(GUNLUK_ANAHTAR, gunluk), 2000);
  }

  // ─── Ayarlar (2.x anahtarlarından taşıma dahil; eski anahtarlar silinmez) ───
  // Kısayol yalnız Ctrl/Alt ile, ya da "/" (ara) ve "Esc" (kapat) olabilir; ayrılmış ve çakışan tuş varsayılana döner.
  function kisayolGecerli(a, tus) {
    if (typeof tus !== "string" || !tus) return false;
    if (tus === VARSAYILAN_KISAYOLLAR[a]) return true;
    if (tus === "Esc" || tus === "Ctrl+Shift+Z" || AYRILMIS_TUSLAR.has(tus)) return false;
    return /^(Ctrl|Alt)\+(Shift\+)?([A-Z0-9]|F([2-9]|10)|[^A-Za-z0-9+])$/.test(tus) || tus === "/";
  }
  function kisayolDuzelt(k) {
    const s = { ...VARSAYILAN_KISAYOLLAR };
    if (k && typeof k === "object") for (const a of KISAYOL_SIRASI) if (kisayolGecerli(a, k[a])) s[a] = k[a];
    for (let tur = 0; tur < KISAYOL_SIRASI.length; tur++) {
      const sahip = new Map();
      let cakisma = false;
      for (const a of KISAYOL_SIRASI) {
        if (sahip.has(s[a])) { // çakışma: varsayılanı olmayan taraf varsayılanına döner
          const b = sahip.get(s[a]);
          const geri = s[a] === VARSAYILAN_KISAYOLLAR[a] ? b : a;
          s[geri] = VARSAYILAN_KISAYOLLAR[geri]; cakisma = true; break;
        }
        sahip.set(s[a], a);
      }
      if (!cakisma) return s;
    }
    return { ...VARSAYILAN_KISAYOLLAR };
  }
  function ayarDuzelt(a) {
    const s = {
      surum: 3,
      kategoriler: Array.isArray(a.kategoriler) ? a.kategoriler.filter((k) => k && k.id && k.ad).slice(0, 200).map((k) => ({ id: String(k.id), ad: String(k.ad).slice(0, 40), ikon: k.ikon, renk: k.renk })).filter((k, i, l) => l.findIndex((x) => x.id === k.id) === i) : VARSAYILAN_KATEGORILER.map((k) => ({ ...k })),
      kanal: {},
      tema: a.tema === "acik" || a.tema === "koyu" ? a.tema : null,
      dil: a.dil === "tr" || a.dil === "en" ? a.dil : null,
      olcek: OLCEKLER.includes(a.olcek) ? a.olcek : 100,
      siralama: ["kisa", "uzun", "liste"].includes(a.siralama) ? a.siralama : "kisa",
      onek: typeof a.onek === "string" && a.onek.trim().length >= 2 ? Array.from(a.onek).slice(0, 20).join("") : VARSAYILAN_ONEK,
      gorunurluk: GORUNURLUKLER.includes(a.gorunurluk) ? a.gorunurluk : "UNLISTED",
      kucukResim: a.kucukResim !== false,
      suresizSonda: a.suresizSonda !== false,
      acilistaSecili: a.acilistaSecili !== false,
      kisayollar: kisayolDuzelt(a.kisayollar),
      sonYedek: typeof a.sonYedek === "string" ? a.sonYedek : "",
    };
    if (a.kanal && typeof a.kanal === "object" && !Array.isArray(a.kanal)) for (const [k, v] of Object.entries(a.kanal)) if (typeof v === "string" && k.trim()) s.kanal[String(k).toLowerCase().trim()] = v;
    for (const k of s.kategoriler) {
      if (!RENKLER.includes(k.renk)) k.renk = "notr";
      if (!IKONLAR[k.ikon]) k.ikon = "tag";
    }
    const misc = s.kategoriler.find((k) => k.id === "misc") || { ...VARSAYILAN_KATEGORILER[VARSAYILAN_KATEGORILER.length - 1] };
    s.kategoriler = [...s.kategoriler.filter((k) => k.id !== "misc"), misc]; // Misc hep sonda
    return s;
  }
  function ayarYukle() {
    const v3 = gmOku(AYAR_ANAHTAR, null);
    if (v3 && typeof v3 === "object") { const s = ayarDuzelt(v3); s.gecisGerekli = !!v3.gecisGerekli; s.gecisNotu = !!v3.gecisNotu; return s; }
    const a = { kategoriler: VARSAYILAN_KATEGORILER.map((k) => ({ ...k })), kanal: {} };
    const eskiKat = gmOku("wlo_categories", null);
    const eskiEtiket = gmOku("wlo_channel_tags", null);
    const ilkKurulum = !eskiKat && !eskiEtiket; // bu betiğin deposunda hiç ayar yok (ör. ad değişince yeni betik olarak kuruldu)
    if (Array.isArray(eskiKat) && eskiKat.length) {
      let sira = 0;
      a.kategoriler = eskiKat.filter((e) => e && e.id).map((e) => {
        const v = VARSAYILAN_KATEGORILER.find((k) => k.id === e.id);
        return v ? { ...v, ad: String(e.label || v.ad) } : { id: String(e.id), ad: String(e.label || e.id), ikon: "tag", renk: RENKLER[sira++ % 8] };
      });
      log("bilgi", `2.x kategorileri taşındı: ${a.kategoriler.length}`);
    }
    if (eskiEtiket && typeof eskiEtiket === "object") {
      a.kanal = { ...eskiEtiket };
      log("bilgi", `2.x kanal etiketleri taşındı: ${Object.keys(a.kanal).length}`);
    }
    const s = ayarDuzelt(a);
    s.gecisGerekli = ilkKurulum; s.gecisNotu = false;
    gmYaz(AYAR_ANAHTAR, s);
    return s;
  }
  let ayar = ayarYukle();
  function ayarKaydet() { gmYaz(AYAR_ANAHTAR, ayar); }
  const onek = () => ayar.onek;
  const katBul = (id) => ayar.kategoriler.find((k) => k.id === id);
  const kanalAnahtari = (k) => String(k || "").toLowerCase().trim();
  function renkDegiskenleri(renk) {
    return renk === "notr" ? "--k:var(--metin);--k-yazi:var(--yuzey)" : `--k:var(--kat-${renk});--k-yazi:var(--ana-uzeri)`;
  }
  function kategoriTahmin(baslik, kanal) {
    const etiket = ayar.kanal[kanalAnahtari(kanal)];
    if (etiket && katBul(etiket)) return etiket;
    const metin = `${baslik} ${kanal}`.toLowerCase();
    const sira = ["trailers", ...Object.keys(ANAHTAR_KELIMELER).filter((k) => k !== "trailers")];
    for (const id of sira) {
      if (!katBul(id)) continue;
      if (ANAHTAR_KELIMELER[id].some((kw) => metin.includes(kw))) return id;
    }
    return "misc";
  }
  DIL = ayar.dil || tarayiciDili();

  // ─── Durum ───
  const D = {
    listeId: null, listeAdi: "", videolar: [], kaynak: "api",
    yukleniyor: false, yuklemeSayi: null, yuklemeSayfadan: false, hata: null,
    filtre: null, arama: "", imlec: null, gizli: 0,
    mesgul: false, iptal: false,
    geri: [], ileri: [],
  };
  // Tanı: son işlemlerin sonucu (Ayarlar › Tanı bunu okur; kendisi YouTube'a istek göndermez).
  const TANI = { istek: null, liste: null, listeler: null };

  // ─── YouTube iç API (InnerTube) ───
  function ytcfg(anahtar) {
    try {
      const c = SAYFA.ytcfg;
      if (c && typeof c.get === "function") return c.get(anahtar);
      return c && c.data_ ? c.data_[anahtar] : undefined;
    } catch (e) { return undefined; }
  }
  // İki istek biçimi: "tam" (YouTube'un kendi bağlamı + istemci başlıkları) ve "sade" (2.x'te çalışan biçim).
  // Tam biçim 400 alırsa oturum boyunca sade biçime geçilir.
  let sadeKip = false;
  const VARSAYILAN_ISTEMCI = "2.20250101.00.00";
  function istemciSurumu() {
    const v = ytcfg("INNERTUBE_CLIENT_VERSION");
    return typeof v === "string" && /^\d+\.\d+/.test(v) ? v : VARSAYILAN_ISTEMCI;
  }
  function baglam(sade) {
    if (!sade) {
      try {
        const c = JSON.parse(JSON.stringify(ytcfg("INNERTUBE_CONTEXT") || null));
        if (c && c.client && typeof c.client.clientName === "string" && typeof c.client.clientVersion === "string") return c;
      } catch (e) { /* sade bağlama düş */ }
    }
    return { client: { clientName: "WEB", clientVersion: istemciSurumu() } };
  }
  function sapisidCerezi() {
    return document.cookie.split("; ").find((c) => /^(SAPISID|__Secure-3PAPISID|__Secure-1PAPISID)=/.test(c)) || null;
  }
  async function sapisidHash() {
    const cerez = sapisidCerezi();
    if (!cerez) throw new KullaniciHatasi(t("oturumYok"));
    const sid = cerez.slice(cerez.indexOf("=") + 1);
    const zaman = Math.floor(Date.now() / 1000);
    const ozet = await crypto.subtle.digest("SHA-1", new TextEncoder().encode(`${zaman} ${sid} https://www.youtube.com`));
    return `SAPISIDHASH ${zaman}_${Array.from(new Uint8Array(ozet)).map((b) => b.toString(16).padStart(2, "0")).join("")}`;
  }
  function durumMesaji(kod, ayrinti) {
    const ek = ayrinti ? t("ytNotu", ayrinti) : "";
    if (kod === 400) return t("kod400", ek);
    if (kod === 401 || kod === 403) return t("kod401", kod);
    if (kod === 404) return t("kod404");
    if (kod === 429) return t("kod429");
    return t("kodDiger", kod);
  }
  function hataNotuMetin(metin) {
    try { const j = JSON.parse(metin); return String((j.error && (j.error.message || j.error.status)) || "").slice(0, 200); }
    catch (e) { return String(metin || "").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim().slice(0, 200); }
  }
  // İstek hangi bağlamdan gider? Firefox'ta eklentinin kendi fetch'i "Origin: moz-extension://…" gönderir;
  // YouTube bunu "Origin doesn't match Host" (400) ile reddeder. Bu yüzden önce sayfanın kendi fetch'i kullanılır.
  const FETCH_YOLLARI = [];
  try { if (SAYFA !== window && typeof SAYFA.fetch === "function") FETCH_YOLLARI.push(["sayfa", (u, i) => SAYFA.fetch(u, sayfayaKopya(i))]); } catch (e) { /* yok */ }
  try { if (typeof content !== "undefined" && content && typeof content.fetch === "function") FETCH_YOLLARI.push(["content", (u, i) => content.fetch(u, sayfayaKopya(i))]); } catch (e) { /* yok */ } // eslint-disable-line no-undef
  FETCH_YOLLARI.push(["betik", (u, i) => fetch(u, i)]);
  let fetchSira = 0;
  function sayfayaKopya(o) {
    try { if (typeof cloneInto === "function") return cloneInto(o, SAYFA); } catch (e) { /* düz nesne yeter */ } // eslint-disable-line no-undef
    return o;
  }
  function istekKaydet(kayit) { TANI.istek = { ...kayit, zaman: Date.now() }; taniIsaretle(); }
  async function yt(uc, govde) {
    for (let deneme = 0; ; deneme++) {
      const sade = sadeKip;
      const ctx = baglam(sade);
      const basliklar = { "Content-Type": "application/json", "X-Origin": "https://www.youtube.com", Authorization: await sapisidHash() };
      if (!sade) {
        basliklar["X-Youtube-Client-Name"] = "1";
        basliklar["X-Youtube-Client-Version"] = String(ctx.client.clientVersion || "");
        basliklar["X-Goog-AuthUser"] = String(ytcfg("SESSION_INDEX") ?? "0");
        const sayfaId = ytcfg("DELEGATED_SESSION_ID");
        if (sayfaId) basliklar["X-Goog-PageId"] = String(sayfaId);
      }
      let yanit;
      const [yolAdi, getir] = FETCH_YOLLARI[fetchSira];
      try {
        yanit = await getir(`https://www.youtube.com/youtubei/v1/${uc}?prettyPrint=false`, {
          method: "POST", credentials: "include", headers: basliklar,
          body: JSON.stringify({ context: ctx, ...govde }),
        });
      } catch (e) {
        log("uyari", `${uc} · ${yolAdi} yolu hata verdi`, e);
        if (fetchSira < FETCH_YOLLARI.length - 1) { fetchSira++; log("bilgi", `istek yolu: ${FETCH_YOLLARI[fetchSira][0]}`); continue; }
        if (deneme < 2) { await bekle(1500 * (deneme + 1)); continue; }
        istekKaydet({ uc, yol: yolAdi, durum: 0, sade, not: String((e && e.message) || e).slice(0, 200), hata: true });
        throw new KullaniciHatasi(t("ulasilamadi"), e);
      }
      const durum = Number(yanit.status);
      const govdeMetni = String(await yanit.text()); // sayfa nesnesi yerine düz metin: Firefox sınırlarında güvenli
      if (durum >= 200 && durum < 300) {
        istekKaydet({ uc, yol: yolAdi, durum, sade, hata: false });
        try { return JSON.parse(govdeMetni); }
        catch (e) { throw new KullaniciHatasi(t("anlasilmayan"), e); }
      }
      const not_ = hataNotuMetin(govdeMetni);
      log("uyari", `${uc} → ${durum} · ${yolAdi} yolu · ${sade ? "sade" : "tam"} istek · istemci ${ctx.client.clientName} ${ctx.client.clientVersion} · ${not_}`);
      if (durum === 400 && /origin/i.test(not_) && fetchSira < FETCH_YOLLARI.length - 1) {
        fetchSira++; log("bilgi", `istek yolu: ${FETCH_YOLLARI[fetchSira][0]}`); continue;
      }
      if (durum === 400 && !sade && !/origin/i.test(not_)) { sadeKip = true; log("bilgi", "sade istek biçimine geçildi"); continue; }
      if ((durum === 429 || durum >= 500) && deneme < 2) { await bekle(2500 * (deneme + 1)); continue; }
      istekKaydet({ uc, yol: yolAdi, durum, sade, not: not_, hata: true });
      throw new KullaniciHatasi(durumMesaji(durum, not_), new Error(`${uc} → ${durum} ${not_}`));
    }
  }

  // Yanıt ağacında gezinme (sıra korunur). ziyaret false dönerse alt dallara inilmez.
  function gez(o, ziyaret, derinlik = 0) {
    if (!o || typeof o !== "object" || derinlik > 60) return;
    if (ziyaret(o) === false) return;
    if (Array.isArray(o)) { for (const x of o) gez(x, ziyaret, derinlik + 1); return; }
    for (const k in o) { const v = o[k]; if (v && typeof v === "object") gez(v, ziyaret, derinlik + 1); }
  }
  function metin(x) {
    if (!x) return "";
    if (typeof x === "string") return x;
    if (x.simpleText) return x.simpleText;
    if (Array.isArray(x.runs)) return x.runs.map((r) => r.text || "").join("");
    if (typeof x.content === "string") return x.content;
    return "";
  }
  function devamBul(veri) {
    let jeton = null, yedek = null;
    gez(veri, (o) => {
      if (jeton) return false;
      if (o.continuationItemRenderer) {
        const j = o.continuationItemRenderer.continuationEndpoint?.continuationCommand?.token;
        if (j) { jeton = j; return false; }
      }
      if (!yedek && o.continuationCommand && o.continuationCommand.token) yedek = o.continuationCommand.token;
    });
    return jeton || yedek;
  }
  function enIyiKucuk(liste) {
    if (!Array.isArray(liste) || !liste.length) return "";
    const uygun = liste.find((x) => (x.width || 0) >= 120) || liste[liste.length - 1];
    return uygun.url || "";
  }
  function videoAyikla(p, sira) {
    const ilk = p.shortBylineText && p.shortBylineText.runs && p.shortBylineText.runs[0];
    return {
      vid: p.videoId,
      setId: p.setVideoId || null,
      baslik: metin(p.title) || "",
      kanal: metin(p.shortBylineText) || "",
      kanalId: (ilk && ilk.navigationEndpoint && ilk.navigationEndpoint.browseEndpoint && ilk.navigationEndpoint.browseEndpoint.browseId) || "",
      sure: parseInt(p.lengthSeconds, 10) || sureCoz(metin(p.lengthText)) || 0,
      kucuk: enIyiKucuk(p.thumbnail && p.thumbnail.thumbnails),
      oynatilabilir: p.isPlayable !== false,
      sira,
    };
  }
  async function listeOku(listeId, ilerleme) {
    const ogeler = [];
    const gorulen = new Set();
    let baslik = "";
    const topla = (veri) => {
      gez(veri, (o) => {
        if (o.playlistVideoRenderer) {
          const p = o.playlistVideoRenderer;
          const anahtar = p.setVideoId || p.videoId;
          if (p.videoId && !gorulen.has(anahtar)) { gorulen.add(anahtar); ogeler.push(videoAyikla(p, ogeler.length)); }
          return false;
        }
        if (!baslik && o.playlistMetadataRenderer) baslik = metin(o.playlistMetadataRenderer.title);
        if (!baslik && o.playlistHeaderRenderer) baslik = metin(o.playlistHeaderRenderer.title);
      });
    };
    let veri = await yt("browse", { browseId: `VL${listeId}` });
    const veri0 = veri;
    topla(veri);
    // Başlıktaki video sayısı (varsa): eksik okumayı yakalamak için.
    let toplam = null;
    gez(veri, (o) => {
      if (toplam != null) return false;
      if (o.playlistHeaderRenderer) toplam = sayiCoz(metin(o.playlistHeaderRenderer.numVideosText) || metin((o.playlistHeaderRenderer.stats || [])[0]));
      else if (o.playlistSidebarPrimaryInfoRenderer) toplam = sayiCoz(metin((o.playlistSidebarPrimaryInfoRenderer.stats || [])[0]));
    });
    ilerleme && ilerleme(ogeler.length);
    let tam = true;
    let jeton = devamBul(veri);
    for (let tur = 0; jeton; tur++) {
      if (tur >= 80) { tam = false; break; }
      const once = ogeler.length;
      veri = await yt("browse", { continuation: jeton });
      topla(veri);
      ilerleme && ilerleme(ogeler.length);
      if (ogeler.length === once) { tam = false; break; }
      jeton = devamBul(veri);
    }
    // "1 unavailable video is hidden": YouTube kullanılamayan videoları listede göstermez; başlık sayısına dahildir.
    let gizli = 0;
    gez(veri0, (o) => {
      const al = o.alertWithButtonRenderer || o.alertRenderer;
      if (!al) return;
      const m = metin(al.text);
      if (/unavailable|hidden|kullanılamayan|gizli|görüntülenemeyen|gösterilmeyen/i.test(m)) gizli += sayiCoz(m) || 0;
      return false;
    });
    if (toplam != null && toplam > ogeler.length + gizli) tam = false;
    if (!tam) log("uyari", `liste tam okunamadı: ${listeId} · okunan ${ogeler.length}${toplam != null ? ` / başlıkta ${toplam}` : ""}`);
    if (gizli) log("bilgi", `${listeId}: ${gizli} kullanılamayan video YouTube tarafından gizli`);
    return { ogeler, baslik, tam, toplam, gizli };
  }
  function listeAyikla(veri, ekle_) {
    gez(veri, (o) => {
      if (o.playlistAddToOptionRenderer) { const p = o.playlistAddToOptionRenderer; ekle_(p.playlistId, metin(p.title)); return false; }
      if (o.playlistRenderer) { const p = o.playlistRenderer; ekle_(p.playlistId, metin(p.title), sayiCoz(p.videoCount ?? metin(p.videoCountText))); return false; }
      if (o.gridPlaylistRenderer) { const p = o.gridPlaylistRenderer; ekle_(p.playlistId, metin(p.title), sayiCoz(metin(p.videoCountShortText) || metin(p.videoCountText))); return false; }
      if (o.lockupViewModel) {
        const l = o.lockupViewModel;
        if (l.contentType && !/PLAYLIST/.test(l.contentType)) return false;
        ekle_(l.contentId, metin(l.metadata && l.metadata.lockupMetadataViewModel && l.metadata.lockupMetadataViewModel.title));
        return false;
      }
      if (o.listItemViewModel) {
        const l = o.listItemViewModel;
        let id = null;
        gez(l, (x) => { if (!id && typeof x.playlistId === "string") id = x.playlistId; });
        if (id) ekle_(id, metin(l.title));
        return false;
      }
    });
  }
  // Hesaptaki oynatma listeleri: üç kaynak birleştirilir; biri bulamazsa öteki bulur (çift liste oluşmasın diye).
  async function kullaniciListeleri(ornekVid) {
    const harita = new Map();
    const ekle_ = (id, ad, sayi) => {
      if (!id || !ad) return;
      id = String(id).replace(/^VL/, "");
      if (id === "WL" || id === "LL") return;
      const var_ = harita.get(id);
      if (!var_) harita.set(id, { id, ad: String(ad).trim(), sayi: sayi ?? null });
      else if (var_.sayi == null && sayi != null) var_.sayi = sayi;
    };
    const yollar = [];
    if (ornekVid) yollar.push(["kaydet menüsü", async () => listeAyikla(await yt("playlist/get_add_to_playlist", { videoIds: [ornekVid], excludeWatchLater: true }), ekle_)]);
    yollar.push(["liste sayfası", async () => {
      let v = await yt("browse", { browseId: "FEplaylist_aggregation" });
      listeAyikla(v, ekle_);
      let jeton = devamBul(v);
      for (let i = 0; jeton && i < 10; i++) { v = await yt("browse", { continuation: jeton }); listeAyikla(v, ekle_); jeton = devamBul(v); }
    }]);
    yollar.push(["kitaplık", async () => listeAyikla(await yt("browse", { browseId: "FElibrary" }), ekle_)]);
    let basarili = 0;
    for (const [ad, yol] of yollar) {
      try { const once = harita.size; await yol(); basarili++; log("bilgi", `listeler (${ad}): +${harita.size - once}`); }
      catch (e) { log("uyari", `listeler (${ad}) okunamadı`, e); }
    }
    if (!basarili) {
      TANI.listeler = { hata: t("listelerOkunamadi") }; taniIsaretle();
      throw new KullaniciHatasi(t("listelerOkunamadi"));
    }
    const liste = [...harita.values()];
    TANI.listeler = { toplam: liste.length, onekli: liste.filter((l) => l.ad.startsWith(onek().trim())).length };
    taniIsaretle();
    return liste;
  }
  async function listeOlustur(ad) {
    const v = await yt("playlist/create", { title: ad, privacyStatus: ayar.gorunurluk });
    let id = v && v.playlistId;
    if (!id) gez(v, (o) => { if (!id && typeof o.playlistId === "string" && o.playlistId.length > 10) id = o.playlistId; });
    if (!id) throw new KullaniciHatasi(t("listeOlusmadi", ad));
    log("bilgi", `liste oluşturuldu: ${ad} ${id} · ${ayar.gorunurluk}`);
    return id;
  }
  async function listeDuzenle(listeId, eylemler) {
    const v = await yt("browse/edit_playlist", { playlistId: listeId, actions: eylemler });
    if (v && v.status && v.status !== "STATUS_SUCCEEDED") throw new KullaniciHatasi(t("degismedi"), new Error(v.status));
    return v;
  }
  async function parcaParca(listeId, ogeler, eylemYap, islem) {
    const basarili = [], hatali = [];
    for (let i = 0; i < ogeler.length; i += PARCA) {
      if (D.iptal) break;
      const parca = ogeler.slice(i, i + PARCA);
      try {
        await listeDuzenle(listeId, parca.map(eylemYap));
        basarili.push(...parca);
      } catch (e) {
        log("uyari", "toplu düzenleme olmadı, tek tek deneniyor", e);
        for (const x of parca) {
          if (D.iptal) break;
          try { await listeDuzenle(listeId, [eylemYap(x)]); basarili.push(x); }
          catch (e2) { hatali.push(x); log("hata", `düzenleme başarısız: ${x}`, e2); }
          await bekle(250);
        }
      }
      islem && islem.ilerle(Math.min(i + PARCA, ogeler.length), ogeler.length);
      await bekle(300);
    }
    return { basarili, hatali };
  }
  const videolariEkle = (listeId, vidler, islem) => parcaParca(listeId, vidler, (v) => ({ addedVideoId: v, action: "ACTION_ADD_VIDEO" }), islem);
  const videolariCikarApi = (listeId, setIdler, islem) => parcaParca(listeId, setIdler, (s) => ({ setVideoId: s, action: "ACTION_REMOVE_VIDEO" }), islem);
  async function listeSil(listeId) { await yt("playlist/delete", { playlistId: listeId }); log("bilgi", `liste silindi: ${listeId}`); }
  async function listeAdiDegistir(listeId, ad) { await listeDuzenle(listeId, [{ action: "ACTION_SET_PLAYLIST_NAME", playlistName: ad }]); }

  // Yedek yol: API boş dönerse sayfadaki listeyi kaydırarak okur (silme/taşıma için giriş kimliği olmaz).
  async function sayfadanOku(ilerleme) {
    const kap = document.querySelector("ytd-playlist-video-list-renderer #contents, yt-playlist-video-list-renderer #contents");
    if (!kap) return [];
    let son = -1, sabit = 0;
    while (sabit < 4) {
      window.scrollTo(0, document.documentElement.scrollHeight);
      await bekle(800);
      const n = kap.querySelectorAll("ytd-playlist-video-renderer").length;
      ilerleme && ilerleme(n);
      if (n === son) sabit++; else { sabit = 0; son = n; }
    }
    window.scrollTo(0, 0);
    return [...kap.querySelectorAll("ytd-playlist-video-renderer")].map((el, i) => {
      const a = el.querySelector("a#video-title, #video-title");
      const href = (a && (a.closest("a") || a).href) || "";
      let vid = "";
      try { vid = new URL(href, location.origin).searchParams.get("v") || ""; } catch (e) { /* boş */ }
      const kanal = el.querySelector("ytd-channel-name a, #channel-name a, ytd-channel-name yt-formatted-string");
      const sure = el.querySelector("ytd-thumbnail-overlay-time-status-renderer #text, badge-shape .yt-badge-shape__text, [class*='time-status'] span");
      const img = el.querySelector("img");
      return { vid, setId: null, baslik: (a && a.textContent.trim()) || "", kanal: (kanal && kanal.textContent.trim()) || "", kanalId: "", sure: sureCoz(sure && sure.textContent), kucuk: (img && img.src) || "", oynatilabilir: true, sira: i };
    }).filter((v) => v.vid);
  }

  // ─── DOM yardımcıları (innerHTML yok) ───
  function h(etiket, ozellik, ...cocuklar) {
    const el = document.createElement(etiket);
    if (ozellik) {
      for (const [k, v] of Object.entries(ozellik)) {
        if (v == null || v === false) continue;
        if (k === "class") el.className = v;
        else if (k.startsWith("on") && typeof v === "function") el.addEventListener(k.slice(2), guvenli(v));
        else if (["value", "checked", "disabled", "selected", "tabIndex", "indeterminate"].includes(k)) el[k] = v;
        else el.setAttribute(k, v === true ? "" : String(v));
      }
    }
    ekle(el, cocuklar);
    return el;
  }
  function ekle(el, cocuklar) {
    for (const c of cocuklar.flat(Infinity)) {
      if (c == null || c === false) continue;
      el.append(c instanceof Node ? c : document.createTextNode(String(c)));
    }
    return el;
  }
  // Her tıklama/tuş işleyicisi bununla sarılır: hata sessizce kaybolmaz, ekranda ve günlükte görünür.
  function guvenli(fn) {
    return function (e) {
      try {
        const r = fn.call(this, e);
        if (r && typeof r.then === "function") r.catch(hataGoster);
      } catch (hata) { hataGoster(hata); }
    };
  }
  function hataGoster(e) {
    log("hata", "beklenmeyen hata", e, (e && e.stack) || "");
    try { bildir(kullaniciMesaji(e)); } catch (e2) { console.error("WLO:", e2); }
  }
  function bosalt(el) { while (el.firstChild) el.removeChild(el.firstChild); return el; }
  function doldur(el, ...cocuklar) { return ekle(bosalt(el), cocuklar); } // dizi kabul eder; Element.append diziyi metne çevirir
  function ikon(ad, sinif, boy = 16) {
    const SVGNS = "http://www.w3.org/2000/svg";
    const s = document.createElementNS(SVGNS, "svg");
    for (const [k, v] of Object.entries({ width: String(boy), height: String(boy), viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true", focusable: "false" })) s.setAttribute(k, v);
    if (sinif) s.setAttribute("class", sinif);
    if (!IKONLAR[ad]) console.warn("WLO: ikon yok:", ad);
    for (const [e_, a] of IKONLAR[ad] || IKONLAR["circle-help"]) {
      const e = document.createElementNS(SVGNS, e_);
      for (const k in a) e.setAttribute(k, a[k]);
      s.append(e);
    }
    return s;
  }
  // Menü/komut etiketi: "Kopyala (C)" — harf Bold, rakam Bold İtalik.
  function kisayolEtiketi(ad, harf) {
    if (!harf) return [ad];
    const rakam = /^\d$/.test(harf);
    return [ad, " (", h("span", { class: rakam ? "kisayol rakam" : "kisayol" }, harf.toUpperCase()), ")"];
  }
  function dugme(ozellik, ikonAd, yazi) {
    const sinif = ["btn", ozellik.tur || ""].join(" ").trim();
    const b = h("button", { type: "button", class: sinif, title: ozellik.ipucu || null, "aria-label": ozellik.ipucu && !yazi ? ozellik.ipucu : null, onclick: ozellik.tik, disabled: ozellik.kapali }, ikonAd ? ikon(ikonAd) : null, yazi != null ? h("span", { class: ozellik.yaziGizle ? "yazi-gizle" : null }, yazi) : null);
    if (ozellik.id) b.id = ozellik.id;
    return b;
  }
  function not(yazi, tip) { return h("div", { class: `not${tip ? " " + tip : ""}` }, ikon(tip === "uyari" ? "triangle-alert" : "info"), h("span", null, yazi)); }

  // ─── Kök, tema, dil, ölçek ───
  let host = null, kok = null, panel = null, tetik = null, bildirimEl = null, menuEl = null;
  const UI = {};
  function yaziTipiYukle() {
    if (document.getElementById("aalabs-open-sans")) return;
    const l = document.createElement("link");
    l.id = "aalabs-open-sans";
    l.rel = "stylesheet";
    l.href = "https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,700&display=swap";
    (document.head || document.documentElement).append(l);
  }
  function kokKur() {
    if (host && host.isConnected) return;
    yaziTipiYukle();
    host = document.createElement("aalabs-wlo");
    host.setAttribute("lang", DIL);
    kok = host.attachShadow({ mode: "open" });
    const stil = document.createElement("style");
    stil.textContent = CSS;
    kok.append(stil);
    const sar = h("div", { class: "kok" });
    kok.append(sar);
    UI.sar = sar;
    document.documentElement.append(host);
    temaUygula();
    olcekUygula();
    for (const tur of ["keydown", "keyup", "keypress"]) {
      kok.addEventListener(tur, (e) => {
        if (tur === "keydown") guvenli(tusIsle)(e);
        e.stopPropagation(); // YouTube kısayolları panelde yazarken tetiklenmesin
      });
    }
    kok.addEventListener("pointerdown", (e) => {
      if (menuEl && !e.composedPath().includes(menuEl)) menuKapat(false);
    });
  }
  function etkinTema() {
    if (ayar.tema) return ayar.tema;
    return document.documentElement.hasAttribute("dark") ? "koyu" : "acik";
  }
  function temaUygula() {
    if (!host) return;
    const koyu = etkinTema() === "koyu";
    host.setAttribute("data-theme", koyu ? "dark" : "light");
    if (UI.temaBtn) {
      doldur(UI.temaBtn, ikon(koyu ? "sun" : "moon"));
      const ad = koyu ? t("temaAcikGec", ayar.kisayollar.tema) : t("temaKoyuGec", ayar.kisayollar.tema);
      UI.temaBtn.setAttribute("aria-label", ad);
      UI.temaBtn.title = ad;
    }
  }
  function temaSec(deger, sessiz) {
    ayar.tema = deger; ayarKaydet(); temaUygula(); ayarlarTazele();
    if (!sessiz) bildir(deger === "koyu" ? t("temaKoyuOldu") : deger === "acik" ? t("temaAcikOldu") : t("temaYtOldu"));
  }
  function temaDegistir() { temaSec(etkinTema() === "koyu" ? "acik" : "koyu"); }
  new MutationObserver(() => { if (!ayar.tema) temaUygula(); }).observe(document.documentElement, { attributes: true, attributeFilter: ["dark"] });

  function olcekUygula() { if (host) host.style.setProperty("--o", String(ayar.olcek / 100)); }
  function olcekSec(n) { ayar.olcek = n; ayarKaydet(); olcekUygula(); ayarlarTazele(); bildir(t("olcekOldu", n)); }

  // Dil: sayfa yenilenmez. Panel, tetik, Ayarlar ve eklenti menüsü yeni dille yeniden kurulur; durum korunur.
  function dilSec(deger, sessiz) {
    ayar.dil = deger; ayarKaydet();
    const yeni = deger || tarayiciDili();
    const degisti = yeni !== DIL;
    DIL = yeni;
    if (host) host.setAttribute("lang", DIL);
    if (degisti) arayuzuYenile();
    else ayarlarTazele();
    if (!sessiz && degisti) bildir(t("dilOldu"));
  }
  function dilDegistir() { dilSec(DIL === "tr" ? "en" : "tr"); }
  window.addEventListener("languagechange", () => { if (!ayar.dil) dilSec(null, true); });
  function arayuzuYenile() {
    menuKapat(false);
    if (panel) {
      const acik = !panel.hidden;
      const islemEl = UI.islem;
      panel.remove(); panel = null;
      for (const k of Object.keys(UI)) if (k !== "sar") delete UI[k];
      UI.islem = islemEl; // süren işlemin ilerleme alanı yeni panele taşınır
      if (islemEl && islemEl.dilYenile) islemEl.dilYenile();
      panelKur();
      panel.hidden = !acik;
      ciz();
      if (acik && !acikModal()) UI.dilBtn.focus();
    }
    if (tetik) { const gizli = tetik.hidden; tetikGoster(); tetik.hidden = gizli; } // gizli tetik de yeni dille yazılır
    ayarlarTazele(true);
    gmMenuKaydet();
  }
  const acikModal = () => (kok ? [...kok.querySelectorAll("dialog[open]")].pop() || null : null);

  // ─── Kısayol adı: olaydan "Ctrl+Shift+T" biçimi (harf ve rakamda fiziksel tuş; noktalamada yazılan karakter) ───
  function tusAdi(e) {
    const k = e.key;
    if (!k || ["Control", "Shift", "Alt", "Meta", "AltGraph", "CapsLock", "OS", "Dead", "Unidentified"].includes(k)) return null;
    if (e.getModifierState && e.getModifierState("AltGraph")) return null; // AltGr (Windows'ta Ctrl+Alt gibi gelir) yazı içindir
    const degistirici = e.ctrlKey || e.metaKey || e.altKey;
    let ad, noktalama = false;
    if (!degistirici && k.length === 1 && !/[A-Za-z0-9]/.test(k)) { ad = k.toUpperCase(); noktalama = true; } // "/" Türkçe Q'da Shift+7'dir
    else if (/^Key[A-Z]$/.test(e.code || "")) ad = e.code.slice(3);
    else if (/^Digit\d$/.test(e.code || "")) ad = e.code.slice(5);
    else if (k === "Escape") ad = "Esc";
    else if (k === " ") ad = "Space";
    else if (k.length === 1) { ad = k.toUpperCase(); noktalama = !/[A-Z0-9]/i.test(k); }
    else ad = k;
    const p = [];
    if (e.ctrlKey || e.metaKey) p.push("Ctrl");
    if (e.altKey) p.push("Alt");
    if (e.shiftKey && !noktalama) p.push("Shift");
    p.push(ad);
    return p.join("+");
  }

  // ─── Tetik düğmesi ───
  function listeSayfasi() {
    return location.pathname === "/playlist" ? new URLSearchParams(location.search).get("list") : null;
  }
  function tetikGoster() {
    kokKur();
    const wl = listeSayfasi() === "WL";
    if (!tetik) {
      tetik = h("button", { type: "button", class: "tetik", onclick: () => panelAc() });
      UI.sar.append(tetik);
    }
    const sorun = taniSorunVar();
    doldur(tetik, ikon("list-video"), h("span", null, wl ? t("tetikWL") : t("tetikListe")), sorun ? h("span", { class: "nokta", title: t("tetikSorun") }) : null);
    tetik.setAttribute("aria-label", `${wl ? t("tetikWL") : t("tetikListe")}${sorun ? ` · ${t("tetikSorun")}` : ""}`);
    tetik.hidden = !!(panel && !panel.hidden);
  }
  function tetikGizle() { if (tetik) tetik.hidden = true; }

  // ─── Panel ───
  function panelKur() {
    if (panel) return;
    const ks = ayar.kisayollar;
    UI.altBaslik = h("div", { class: "alt-baslik" });
    UI.temaBtn = h("button", { type: "button", class: "btn ikon", onclick: temaDegistir });
    UI.dilBtn = h("button", { type: "button", class: "btn", title: t("dilDugme", ks.dil), "aria-label": t("dilDugme", ks.dil), onclick: dilDegistir }, ikon("languages"), h("span", null, DIL.toUpperCase()));
    UI.arama = h("input", { type: "search", class: "girdi", value: D.arama, placeholder: t("aramaYer"), "aria-label": t("videoAra"), oninput: (e) => { D.arama = e.target.value; listeCiz(); } });
    UI.segment = h("div", { class: "segment", role: "group", "aria-label": t("siralama") },
      [["kisa", t("kisaOnce")], ["uzun", t("uzunOnce")], ["liste", t("listeSirasi")]].map(([d, ad]) =>
        h("button", { type: "button", "data-sira": d, "aria-pressed": String(ayar.siralama === d), onclick: () => { ayar.siralama = d; ayarKaydet(); segmentCiz(); listeCiz(); ayarlarTazele(); } }, ad)));
    UI.cipler = h("div", { class: "cipler", role: "group", "aria-label": t("katSuzgeci") });
    UI.liste = h("div", { class: "liste", tabindex: "0", role: "list", "aria-label": t("videolar"), onkeydown: listeTusu });
    UI.islem = UI.islem || h("div", { class: "islem", hidden: true, role: "status", "aria-live": "polite" });
    UI.altBilgi = h("span", { class: "alt-bilgi" });
    UI.cikarBtn = dugme({ tur: "tehlike", tik: () => seciliCikar() }, "trash-2", t("btnCikar", 0));
    UI.tasiBtn = dugme({ tur: "ana", tik: () => seciliTasi() }, "folder-input", t("btnTasi", 0));
    UI.aracBtn = dugme({ tik: (e) => aracMenusu(e.currentTarget) }, "ellipsis-vertical", t("araclar"));
    UI.aracBtn.setAttribute("aria-haspopup", "menu");
    UI.ayarBtn = dugme({ tik: () => ayarlarAc(), ipucu: `${t("ayarlar")} (${ks.ayarlar})`, yaziGizle: true }, "settings", t("ayarlar"));
    UI.ayarBtn.removeAttribute("aria-label");

    panel = h("div", { class: "panel", hidden: true, role: "dialog", "aria-modal": "true", "aria-label": UYG.ad, tabindex: "-1" },
      h("div", { class: "ust" },
        h("div", { class: "logo", "aria-hidden": "true" }, UYG.ikon),
        h("div", { style: "min-width:0" }, h("div", { class: "baslik" }, `${UYG.ad} ${UYG.surum}`), UI.altBaslik),
        h("div", { class: "esnek" }),
        h("div", { class: "arac" },
          dugme({ tik: () => yukle(), ipucu: t("listeyiYenile"), yaziGizle: true }, "refresh-cw", t("yenile")),
          dugme({ tik: () => ayarlarAc("kat"), yaziGizle: true }, "folder", t("kategoriler")),
          dugme({ tik: () => ayarlarAc("etk"), yaziGizle: true }, "tags", t("etiketler")),
          UI.ayarBtn,
          UI.aracBtn,
          h("div", { class: "dikey", "aria-hidden": "true" }),
          UI.dilBtn,
          UI.temaBtn,
          dugme({ tur: "ikon", tik: panelKapat, ipucu: t("kapatTus", ks.kapat) }, "x"))),
      h("div", { class: "filtre" },
        h("div", { class: "arama" }, ikon("search"), UI.arama),
        UI.segment,
        dugme({ tur: "hayalet", tik: () => topluSec(true), yaziGizle: true }, "list-checks", t("gorunenleriSec")),
        dugme({ tur: "hayalet", tik: () => topluSec(false), yaziGizle: true }, "square", t("secimiKaldir"))),
      UI.cipler,
      UI.liste,
      UI.islem,
      h("div", { class: "alt" }, UI.altBilgi, h("div", { class: "esnek" }), UI.cikarBtn, UI.tasiBtn));
    UI.sar.append(panel);
    temaUygula();
    taniIsaretle();
  }
  function panelAcikMi() { return !!(panel && !panel.hidden); }
  function panelAc() {
    const id = listeSayfasi();
    if (!id) { kokKur(); bildir(t("onceListeAc")); return; }
    kokKur(); panelKur();
    panel.hidden = false;
    if (tetik) tetik.hidden = true;
    if (D.listeId !== id || (!D.videolar.length && !D.yukleniyor)) { D.listeId = id; yukle(); } else ciz();
    setTimeout(() => UI.liste && UI.liste.focus(), 0);
    if (ayar.gecisGerekli && !ayar.gecisNotu) {
      ayar.gecisNotu = true; ayarKaydet();
      bildir(t("ilkKurulumNot"), { sure: 20000 });
    }
  }
  function panelKapat() {
    if (!panel) return;
    menuKapat(false);
    panel.hidden = true;
    if (listeSayfasi()) tetikGoster();
  }

  // ─── Yükleme ───
  async function yukle() {
    if (D.mesgul) return bildir(t("islemSuruyor"));
    const id = listeSayfasi();
    if (!id) return;
    const onceki = new Map(D.listeId === id ? D.videolar.map((v) => [v.vid, v]) : []);
    D.listeId = id; D.yukleniyor = true; D.hata = null; D.yuklemeSayi = null; D.yuklemeSayfadan = false; D.iptal = false;
    ciz();
    try {
      let { ogeler, baslik, gizli, tam, toplam } = await listeOku(id, (n) => { D.yuklemeSayi = n; durumCiz(); });
      D.kaynak = "api";
      if (!ogeler.length && document.querySelector("ytd-playlist-video-renderer")) {
        log("uyari", "API boş döndü, sayfadan okunuyor");
        D.yuklemeSayfadan = true;
        ogeler = await sayfadanOku((n) => { D.yuklemeSayi = n; durumCiz(); });
        D.kaynak = "sayfa";
      }
      D.gizli = gizli || 0;
      D.listeAdi = baslik || (id === "WL" ? "Watch Later" : document.title.replace(/ - YouTube$/, ""));
      D.videolar = ogeler.map((o) => {
        const eski = onceki.get(o.vid);
        return { ...o, kategori: eski && eski.elle && katBul(eski.kategori) ? eski.kategori : kategoriTahmin(o.baslik, o.kanal), elle: !!(eski && eski.elle), secili: eski ? eski.secili : ayar.acilistaSecili };
      });
      TANI.liste = { id, okunan: ogeler.length, toplam, gizli: D.gizli, tam: tam !== false, kaynak: D.kaynak };
      log("bilgi", `liste okundu: ${id} · ${D.videolar.length} video · kaynak ${D.kaynak}`);
    } catch (e) {
      D.hata = e; log("hata", "liste okunamadı", e);
      TANI.liste = { id, hata: kullaniciMesaji(e) };
    } finally {
      D.yukleniyor = false;
      taniIsaretle();
      ciz();
    }
  }

  // ─── Görünüm ───
  function gorunenler() {
    const q = normal(D.arama.trim());
    let l = D.videolar;
    if (D.filtre) l = l.filter((v) => v.kategori === D.filtre);
    if (q) l = l.filter((v) => normal(v.baslik).includes(q) || normal(v.kanal).includes(q));
    const s = [...l];
    const sonda = ayar.suresizSonda;
    if (ayar.siralama === "kisa") s.sort((a, b) => (a.sure || (sonda ? Infinity : 0)) - (b.sure || (sonda ? Infinity : 0)) || a.sira - b.sira);
    else if (ayar.siralama === "uzun") s.sort((a, b) => (b.sure || (sonda ? -Infinity : Infinity)) - (a.sure || (sonda ? -Infinity : Infinity)) || a.sira - b.sira);
    else s.sort((a, b) => a.sira - b.sira);
    return s;
  }
  function ciz() {
    if (!panel) return;
    panel.classList.toggle("resimsiz", !ayar.kucukResim);
    UI.altBaslik.textContent = `${D.listeAdi || (D.listeId === "WL" ? "Watch Later" : t("oynatmaListesi"))}${D.videolar.length ? ` · ${t("nVideo", D.videolar.length)}` : ""}${D.gizli ? ` · ${t("gizliVideo", D.gizli)}` : ""}${D.kaynak === "sayfa" ? ` · ${t("sayfadanOkundu")}` : ""}`;
    segmentCiz(); ciplerCiz(); listeCiz(); temaUygula();
  }
  function segmentCiz() {
    if (!UI.segment) return;
    for (const b of UI.segment.querySelectorAll("button")) b.setAttribute("aria-pressed", String(b.dataset.sira === ayar.siralama));
  }
  function ciplerCiz() {
    const sayac = {};
    for (const v of D.videolar) sayac[v.kategori] = (sayac[v.kategori] || 0) + 1;
    doldur(UI.cipler,
      h("button", { type: "button", class: "cip", "aria-pressed": String(!D.filtre), onclick: () => { D.filtre = null; ciplerCiz(); listeCiz(); } },
        ikon("list-video"), t("tumu"), h("span", { class: "sayi" }, D.videolar.length)),
      ayar.kategoriler.map((k) => h("button", {
        type: "button", class: "cip", style: renkDegiskenleri(k.renk), "aria-pressed": String(D.filtre === k.id),
        onclick: () => { D.filtre = D.filtre === k.id ? null : k.id; ciplerCiz(); listeCiz(); },
      }, ikon(k.ikon), k.ad, h("span", { class: "sayi" }, sayac[k.id] || 0))));
  }
  function bosDurum(ikonAd, baslik, aciklama, dugmeler) {
    return h("div", { class: "bos" }, ikon(ikonAd, ikonAd === "loader-circle" ? "donuyor" : null), h("h3", null, baslik), aciklama ? h("p", null, aciklama) : null, dugmeler ? h("div", { class: "arac", style: "justify-content:center" }, dugmeler) : null);
  }
  function listeCiz() {
    if (!panel) return;
    const kap = bosalt(UI.liste);
    altCiz();
    if (D.yukleniyor) {
      const yazi = D.yuklemeSayfadan ? t("sayfadanOkunuyor", D.yuklemeSayi || 0) : D.yuklemeSayi ? t("okunuyorN", D.yuklemeSayi) : t("okunuyor");
      kap.append(bosDurum("loader-circle", yazi, t("buyukListe"))); return;
    }
    if (D.hata) { kap.append(bosDurum("triangle-alert", t("okunamadi"), kullaniciMesaji(D.hata), [dugme({ tur: "ana", tik: () => yukle() }, "refresh-cw", t("tekrarDene"))])); return; }
    if (!D.videolar.length) { kap.append(bosDurum("list-video", t("listeBos"), t("listeBosAcik"), [dugme({ tik: () => yukle() }, "refresh-cw", t("listeyiYenile"))])); return; }
    const liste = gorunenler();
    if (!liste.length) {
      kap.append(bosDurum("search", t("uyanYok"), t("uyanYokAcik"), [dugme({ tik: () => { D.arama = ""; UI.arama.value = ""; D.filtre = null; ciz(); } }, "x", t("suzgeciTemizle"))]));
      return;
    }
    if (!liste.some((v) => v.vid === D.imlec)) D.imlec = null;
    const parca = document.createDocumentFragment();
    liste.forEach((v, i) => parca.append(satirOlustur(v, i)));
    kap.append(parca);
  }
  function satirOlustur(v, i) {
    const k = katBul(v.kategori) || katBul("misc");
    const etiket = ayar.kanal[kanalAnahtari(v.kanal)];
    const etiketKat = etiket ? katBul(etiket) : null;
    const baslik = v.baslik || t("basliksiz");
    const sec = h("select", { class: "kat", style: renkDegiskenleri(k.renk), "aria-label": t("katAria", baslik), onchange: (e) => kategoriDegistir(v, e.target.value) },
      ayar.kategoriler.map((x) => h("option", { value: x.id, selected: x.id === k.id }, x.ad)));
    const satir = h("div", { class: `satir${v.secili ? "" : " disarida"}${D.imlec === v.vid ? " imlec" : ""}`, role: "listitem", "data-vid": v.vid, onclick: () => imlecKoy(v.vid, false) },
      h("input", { type: "checkbox", class: "chk", checked: v.secili, "aria-label": t("secAria", baslik), onchange: (e) => { v.secili = e.target.checked; satir.classList.toggle("disarida", !v.secili); altCiz(); } }),
      h("span", { class: "sira soluk" }, i + 1),
      v.kucuk ? h("img", { class: "kucukresim soluk", src: v.kucuk, alt: "", loading: "lazy", referrerpolicy: "no-referrer" }) : h("span", { class: "kucukresim soluk" }),
      h("div", { class: "bilgi soluk" },
        h("button", { type: "button", class: "vbaslik", title: baslik, onclick: (e) => { e.stopPropagation(); videoAc(v); } }, baslik),
        h("div", { class: "kanalsatir" },
          h("span", { class: "ikincil" }, v.kanal || t("kanalBilinmiyor")),
          v.kanal ? h("button", { type: "button", class: `etiketbtn${etiketKat ? " etiketli" : ""}`, title: etiketKat ? t("kanalEtiketiIpucu", etiketKat.ad) : t("kanalBagla"), onclick: (e) => { e.stopPropagation(); kanalEtiketiModal(v.kanal); } },
            ikon("tag"), etiketKat ? etiketKat.ad : t("etiketle")) : null,
          !v.oynatilabilir ? h("span", { class: "uyari-rozet" }, ikon("triangle-alert"), t("oynatilamiyor")) : null,
          !v.setId && D.kaynak === "sayfa" ? h("span", { class: "uyari-rozet" }, ikon("triangle-alert"), t("kimlikYok")) : null)),
      h("span", { class: "sure soluk" }, sureYaz(v.sure)),
      sec,
      dugme({ tur: "hayalet ikon kucuk", ipucu: t("listedenCikarIpucu"), tik: (e) => { e.stopPropagation(); videolariCikar([v], { tek: true }); } }, "trash-2"));
    return satir;
  }
  function altCiz() {
    if (!panel) return;
    const secili = D.videolar.filter((v) => v.secili);
    const gorunen = D.yukleniyor || D.hata ? 0 : gorunenler().length;
    UI.altBilgi.textContent = t("altBilgi", gorunen, D.videolar.length, secili.length, toplamSure(secili.reduce((top, v) => top + (v.sure || 0), 0)));
    const wl = D.listeId === "WL";
    UI.tasiBtn.lastChild.textContent = wl ? t("btnTasi", secili.length) : t("btnKopyala", secili.length);
    UI.cikarBtn.lastChild.textContent = t("btnCikar", secili.length);
    const kapali = D.mesgul || D.yukleniyor || !secili.length;
    UI.tasiBtn.disabled = kapali; UI.cikarBtn.disabled = kapali;
  }
  function durumCiz() { if (D.yukleniyor) listeCiz(); }
  function imlecKoy(vid, kaydir = true) {
    if (!UI.liste) return;
    const once = UI.liste.querySelector(".satir.imlec");
    if (once) once.classList.remove("imlec");
    D.imlec = vid;
    const yeni = vid ? UI.liste.querySelector(`.satir[data-vid="${cssKacis(vid)}"]`) : null;
    if (yeni) { yeni.classList.add("imlec"); if (kaydir) yeni.scrollIntoView({ block: "nearest" }); }
  }
  function cssKacis(s) { return String(s).replace(/["\\]/g, "\\$&"); }
  function videoAc(v) { window.open(`https://www.youtube.com/watch?v=${encodeURIComponent(v.vid)}&list=${encodeURIComponent(D.listeId || "")}`, "_blank", "noopener"); }
  function topluSec(deger) {
    const l = gorunenler();
    for (const v of l) v.secili = deger;
    listeCiz();
    bildir(deger ? t("nSecildi", l.length) : t("nSecimdenCikti", l.length));
  }

  // ─── Klavye ───
  function yaziAlani(el) {
    return el && (el.tagName === "INPUT" && !["checkbox", "radio", "button"].includes(el.type) || el.tagName === "TEXTAREA" || el.tagName === "SELECT" || el.isContentEditable);
  }
  function tusIsle(e) {
    if (KAYIT) return; // Ayarlar › Klavye kısayolları yeni tuşu dinliyor
    const tus = tusAdi(e);
    if (!tus) return;
    const ks = ayar.kisayollar;
    const hedef = e.composedPath()[0];
    const modal = acikModal();
    const ayarAcik = !!(AY && AY.dlg.open);
    if (tus === ks.tema) { e.preventDefault(); temaDegistir(); return; }
    if (tus === ks.dil) { e.preventDefault(); if (!modal || modal === (AY && AY.dlg)) dilDegistir(); return; }
    if (ayarAcik && modal === AY.dlg && tus === "Ctrl+F") { e.preventDefault(); AY.ara.focus(); AY.ara.select(); return; }
    if (tus === ks.ayarlar) { e.preventDefault(); if (!modal) ayarlarAc(); return; }
    if (!panelAcikMi()) return;
    if (tus === ks.palet) { e.preventDefault(); if (!modal) komutPaleti(); return; }
    if (modal) return;
    if (e.key === "Escape" && menuEl) { e.preventDefault(); menuKapat(true); return; }
    if (!yaziAlani(hedef) && tus === ks.geri) { e.preventDefault(); geriAl(); return; }
    if (!yaziAlani(hedef) && (tus === ks.ileri || tus === "Ctrl+Shift+Z")) { e.preventDefault(); yinele(); return; }
    if (tus === ks.kapat && (!yaziAlani(hedef) || e.key === "Escape")) { e.preventDefault(); panelKapat(); return; }
    if (!yaziAlani(hedef) && tus === ks.ara) { e.preventDefault(); UI.arama.focus(); }
  }
  function listeTusu(e) {
    if (e.target !== UI.liste || e.ctrlKey || e.metaKey || e.altKey) return;
    const l = gorunenler();
    if (!l.length) return;
    const i = l.findIndex((v) => v.vid === D.imlec);
    const v = i >= 0 ? l[i] : null;
    const git = (j) => { e.preventDefault(); imlecKoy(l[Math.max(0, Math.min(l.length - 1, j))].vid); };
    switch (e.key) {
      case "ArrowDown": return git(i + 1);
      case "ArrowUp": return git(i < 0 ? 0 : i - 1);
      case "Home": return git(0);
      case "End": return git(l.length - 1);
      case "PageDown": return git(i + 10);
      case "PageUp": return git(i - 10);
    }
    if (!v) return;
    if (e.key === " ") {
      e.preventDefault(); v.secili = !v.secili;
      const s = UI.liste.querySelector(`.satir[data-vid="${cssKacis(v.vid)}"]`);
      if (s) { s.classList.toggle("disarida", !v.secili); s.querySelector(".chk").checked = v.secili; }
      altCiz();
    } else if (e.key === "Delete") { e.preventDefault(); videolariCikar([v], { tek: true }); }
    else if (e.key === "Enter") { e.preventDefault(); videoAc(v); }
    else if (e.code === "KeyE") { e.preventDefault(); kanalEtiketiModal(v.kanal); }
    else if (/^[1-9]$/.test(e.key)) {
      const k = ayar.kategoriler[parseInt(e.key, 10) - 1];
      if (k) { e.preventDefault(); kategoriDegistir(v, k.id); }
    }
  }

  // ─── Geri al / yinele ───
  function geriKaydet(ad, geriAlFn, yineleFn) {
    D.geri.push({ ad, geriAlFn, yineleFn });
    if (D.geri.length > 50) D.geri.shift();
    D.ileri.length = 0;
  }
  async function geriAl() {
    if (D.mesgul) return bildir(t("islemSuruyorKisa"));
    const g = D.geri.pop();
    if (!g) return bildir(t("geriYok"));
    try { await g.geriAlFn(); D.ileri.push(g); bildir(t("geriAlindi", g.ad)); ayarlarTazele(); }
    catch (e) { log("hata", "geri alma", e); bildir(kullaniciMesaji(e)); }
  }
  async function yinele() {
    if (D.mesgul) return bildir(t("islemSuruyorKisa"));
    const g = D.ileri.pop();
    if (!g) return bildir(t("yineYok"));
    try { await g.yineleFn(); D.geri.push(g); bildir(t("yinelendi", g.ad)); ayarlarTazele(); }
    catch (e) { log("hata", "yineleme", e); bildir(kullaniciMesaji(e)); }
  }

  // ─── Bildirim (açık bir pencere varsa onun içinde gösterilir; yoksa pencerenin arkasında kalırdı) ───
  let bildirimZaman = 0;
  function bildir(mesaj, secenek = {}) {
    kokKur();
    if (bildirimEl) bildirimEl.remove();
    clearTimeout(bildirimZaman);
    const kapat = () => { if (bildirimEl) { bildirimEl.remove(); bildirimEl = null; } };
    bildirimEl = h("div", { class: "bildirim", role: "status", "aria-live": "polite" }, h("span", null, mesaj),
      secenek.geriAl ? dugme({ tik: () => { kapat(); geriAl(); } }, "undo-2", t("geriAl")) : null);
    (acikModal() || UI.sar).append(bildirimEl);
    bildirimZaman = setTimeout(kapat, secenek.sure || (secenek.geriAl ? 8000 : 4000));
  }

  // ─── İşlem alanı (ilerleme + günlük + durdur) ───
  function islemBaslat(baslik) {
    D.mesgul = true; D.iptal = false;
    const ilerleme = h("div");
    const gunlukEl = h("div", { class: "gunluk" });
    const durdur = dugme({ tur: "kucuk", tik: () => { D.iptal = true; durdur.disabled = true; satir("uyari", t("durduruluyor")); } }, "octagon-x", t("durdur"));
    const kapat = dugme({ tur: "kucuk ikon hayalet", ipucu: t("kapat"), tik: () => { UI.islem.hidden = true; } }, "x");
    kapat.hidden = true;
    UI.islem.dilYenile = () => { durdur.lastChild.textContent = t("durdur"); kapat.title = t("kapat"); kapat.setAttribute("aria-label", t("kapat")); };
    const baslikEl = h("span", { class: "islem-baslik" }, baslik);
    doldur(UI.islem, h("div", { class: "islem-ust" }, baslikEl, h("div", { class: "esnek" }), durdur, kapat), h("div", { class: "ilerleme" }, ilerleme), gunlukEl);
    UI.islem.hidden = false;
    altCiz();
    const ikonlar = { ok: "circle-check", uyari: "triangle-alert", hata: "circle-x", bilgi: "info" };
    function satir(tip, yazi) {
      gunlukEl.append(h("div", { class: `gsatir ${tip}` }, ikon(ikonlar[tip] || "info"), h("span", null, yazi)));
      gunlukEl.scrollTop = gunlukEl.scrollHeight;
      log(tip === "hata" ? "hata" : tip === "uyari" ? "uyari" : "bilgi", yazi);
    }
    return {
      satir,
      adim(yazi, oran) { baslikEl.textContent = yazi; if (oran != null) ilerleme.style.width = `${Math.round(oran * 100)}%`; },
      ilerle(n, toplam) { if (toplam) ilerleme.style.width = `${Math.round((n / toplam) * 100)}%`; },
      bitir(ozet, tip = "ok") {
        D.mesgul = false; ilerleme.style.width = "100%";
        baslikEl.textContent = ozet; satir(tip, ozet);
        durdur.hidden = true; kapat.hidden = false;
        altCiz();
      },
    };
  }

  // ─── Modal ───
  function modalAc({ baslik, icerik, dugmeler, genis }) {
    kokKur();
    return new Promise((coz) => {
      let sonuc = null;
      const kapat = (deger) => { sonuc = deger; if (dlg.open) dlg.close(); };
      const govde = typeof icerik === "function" ? icerik(kapat) : icerik;
      const dlg = h("dialog", { class: `modal${genis ? " genis" : ""}`, "aria-label": baslik },
        h("div", { class: "modal-ic" }, h("h2", null, baslik), govde),
        dugmeler && dugmeler.length ? h("div", { class: "modal-alt" }, dugmeler.map((d) => {
          const b = dugme({ tur: d.tur, tik: () => { if (d.dogrula && !d.dogrula()) return; kapat(d.deger); } }, d.ikon, d.ad);
          if (d.odak) b.setAttribute("autofocus", "");
          return b;
        })) : null);
      dlg.addEventListener("close", () => { dlg.remove(); coz(sonuc); });
      UI.sar.append(dlg);
      dlg.showModal();
      if (bildirimEl) dlg.append(bildirimEl); // açık bildirim pencerenin arkasında soluk kalmasın
    });
  }
  async function onayla(baslik, satirlar, eylem, tur = "ana", ikonAd = "check") {
    const r = await modalAc({
      baslik,
      icerik: h("div", { style: "display:flex;flex-direction:column;gap:8px" }, satirlar),
      dugmeler: [{ ad: t("vazgec"), deger: false }, { ad: eylem, tur, ikon: ikonAd, deger: true, odak: true }],
    });
    return r === true;
  }

  // ─── Menü ve komut paleti ───
  function komutlar() {
    const wl = D.listeId === "WL";
    return [
      { ad: t("m_yenile"), harf: "R", ikon: "refresh-cw", calistir: () => yukle() },
      { ad: wl ? t("m_tasi") : t("m_kopyala"), harf: "M", ikon: "folder-input", calistir: () => seciliTasi() },
      { ad: t("m_cikar"), harf: "S", ikon: "trash-2", calistir: () => seciliCikar() },
      { ayrac: true },
      { ad: t("m_kat"), harf: "K", ikon: "folder", calistir: () => ayarlarAc("kat") },
      { ad: t("m_etk"), harf: "E", ikon: "tags", calistir: () => ayarlarAc("etk") },
      { ad: t("m_birlestir"), harf: "B", ikon: "merge", calistir: () => ciftleriBirlestir() },
      { ayrac: true },
      { ad: t("m_json"), harf: "J", ikon: "download", calistir: () => videolariIndir() },
      wl ? { ad: t("m_bosalt"), harf: "W", ikon: "trash-2", calistir: () => watchLaterBosalt() } : null,
      { ayrac: true },
      { ad: t("m_tema"), harf: "T", ikon: etkinTema() === "koyu" ? "sun" : "moon", ipucu: ayar.kisayollar.tema, calistir: temaDegistir },
      { ad: t("m_dil"), harf: "L", ikon: "languages", ipucu: ayar.kisayollar.dil, calistir: dilDegistir },
      { ad: t("m_ayarlar"), harf: "A", ikon: "settings", ipucu: ayar.kisayollar.ayarlar, calistir: () => ayarlarAc() },
    ].filter(Boolean);
  }
  function menuKapat(odakGeri) {
    if (!menuEl) return;
    menuEl.remove(); menuEl = null;
    if (odakGeri && UI.aracBtn) UI.aracBtn.focus();
    if (UI.aracBtn) UI.aracBtn.setAttribute("aria-expanded", "false");
  }
  function aracMenusu(cipa) {
    if (menuEl) { menuKapat(true); return; }
    const liste = komutlar();
    const ogeler = [];
    menuEl = h("div", { class: "menu", role: "menu", "aria-label": t("araclar") }, liste.map((k) => {
      if (k.ayrac) return h("div", { class: "ayrac", role: "separator" });
      const b = h("button", { type: "button", role: "menuitem", tabindex: "-1", "data-harf": k.harf.toLowerCase(), onclick: () => { menuKapat(true); k.calistir(); } }, ikon(k.ikon), h("span", null, kisayolEtiketi(k.ad, k.harf)));
      ogeler.push(b);
      return b;
    }));
    menuEl.addEventListener("keydown", guvenli((e) => {
      const i = ogeler.indexOf(kok.activeElement);
      if (e.key === "ArrowDown") { e.preventDefault(); ogeler[(i + 1) % ogeler.length].focus(); }
      else if (e.key === "ArrowUp") { e.preventDefault(); ogeler[(i - 1 + ogeler.length) % ogeler.length].focus(); }
      else if (e.key === "Home") { e.preventDefault(); ogeler[0].focus(); }
      else if (e.key === "End") { e.preventDefault(); ogeler[ogeler.length - 1].focus(); }
      else if (e.key === "Tab") { menuKapat(false); }
      else if (e.key.length === 1 && !e.ctrlKey && !e.altKey && !e.metaKey) {
        const harf = /^Key[A-Z]$/.test(e.code || "") ? e.code.slice(3).toLowerCase() : e.key.toLowerCase(); // Türkçe klavyede I tuşu "ı" yazar
        const b = ogeler.find((x) => x.dataset.harf === harf);
        if (b) { e.preventDefault(); b.click(); }
      }
    }));
    UI.sar.append(menuEl);
    const r = cipa.getBoundingClientRect();
    const g = menuEl.getBoundingClientRect();
    menuEl.style.top = `${Math.min(r.bottom + 4, window.innerHeight - g.height - 8)}px`;
    menuEl.style.left = `${Math.max(8, Math.min(r.right - g.width, window.innerWidth - g.width - 8))}px`;
    cipa.setAttribute("aria-expanded", "true");
    ogeler[0].focus();
  }
  function komutPaleti() {
    const liste = komutlar().filter((k) => !k.ayrac);
    let secili = 0, suzulmus = liste;
    const girdi = h("input", { type: "text", class: "girdi", placeholder: t("komutAra"), "aria-label": t("komutAra"), role: "combobox", "aria-expanded": "true", "aria-controls": "wlo-palet", autofocus: true });
    const kutu = h("div", { class: "palet-liste", role: "listbox", id: "wlo-palet", "aria-label": t("komutlar") });
    let kapatFn = null;
    const ciz_ = () => {
      bosalt(kutu);
      if (!suzulmus.length) { kutu.append(h("div", { class: "ay-not", style: "padding:8px 10px" }, t("sonucYok"))); return; }
      suzulmus.forEach((k, i) => kutu.append(h("div", { role: "option", "aria-selected": String(i === secili), onclick: () => calistir(i) }, ikon(k.ikon), h("span", null, k.ad), h("span", { class: "ipucu" }, k.ipucu || k.harf))));
      const s = kutu.children[secili]; if (s) s.scrollIntoView({ block: "nearest" });
    };
    const calistir = (i) => { const k = suzulmus[i]; if (!k) return; kapatFn(null); setTimeout(guvenli(k.calistir), 0); };
    girdi.addEventListener("input", () => { const q = normal(girdi.value); suzulmus = liste.filter((k) => normal(k.ad).includes(q)); secili = 0; ciz_(); });
    girdi.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); secili = Math.min(suzulmus.length - 1, secili + 1); ciz_(); }
      else if (e.key === "ArrowUp") { e.preventDefault(); secili = Math.max(0, secili - 1); ciz_(); }
      else if (e.key === "Enter") { e.preventDefault(); calistir(secili); }
    });
    ciz_();
    modalAc({ baslik: t("komutPaleti"), icerik: (k) => { kapatFn = k; return h("div", { style: "display:flex;flex-direction:column;gap:8px" }, girdi, kutu); } });
  }

  // ─── Ortak Ayarlar penceresi (app-lab v02.01 · maket A: ortada kipli pencere, sol gezinti) ───
  const BOLUMLER = [
    { id: "kat", grup: "uyg", ikon: "folder" },
    { id: "etk", grup: "uyg", ikon: "tags" },
    { id: "tas", grup: "uyg", ikon: "folder-input" },
    { id: "lst", grup: "uyg", ikon: "list" },
    { id: "gen", grup: "ortak", ikon: "settings" },
    { id: "kis", grup: "ortak", ikon: "keyboard" },
    { id: "tan", grup: "ortak", ikon: "stethoscope" },
    { id: "hak", grup: "ortak", ikon: "info" },
  ];
  let AY = null;          // açık pencere: { dlg, nav, ara, baslik, sifir, govde, bolum, sorgu }
  let AY_SON = "gen";     // son açılan bölüm
  let KAYIT = null;       // kısayol yakalama: { anahtar, hata }
  let KAYIT_BITTI = 0;

  function ayarlarAc(bolum) {
    kokKur();
    menuKapat(false);
    if (AY && AY.dlg.open) { if (bolum) bolumGoster(bolum); return; }
    const ara = h("input", { type: "search", class: "girdi", placeholder: t("ayarlarAra"), "aria-label": t("ayarlardaAra"), oninput: () => { AY.sorgu = ara.value; gezintiCiz(); } });
    const navListe = h("div", { class: "g-liste" });
    const nav = h("nav", { class: "gezinti", "aria-label": t("ayarlar") }, h("div", { class: "arama" }, ikon("search"), ara), navListe);
    const baslik = h("h2", { id: "wlo-ay-baslik" });
    const sifir = dugme({ tur: "kucuk", tik: () => varsayilanaDon(AY.bolum) }, "rotate-ccw", t("varsayilanaDon"));
    const govde = h("div", { class: "ay-govde", tabindex: "-1" });
    const dlg = h("dialog", { class: "ayarlar", "aria-labelledby": "wlo-ay-baslik", tabindex: "-1" },
      nav,
      h("div", { class: "ay-icerik" },
        h("div", { class: "ay-ust" }, baslik, sifir, dugme({ tur: "ikon", ipucu: t("kapat"), tik: () => dlg.close() }, "x")),
        govde));
    // Yakalamayı bitiren Esc pencereyi kapatmasın.
    dlg.addEventListener("cancel", (e) => {
      if (KAYIT) { e.preventDefault(); KAYIT = null; KAYIT_BITTI = Date.now(); doldur(AY.govde, bolumKisayollar()); AY.govde.focus(); return; }
      if (Date.now() - KAYIT_BITTI < 60) e.preventDefault();
    });
    dlg.addEventListener("keydown", (e) => { if (KAYIT) { e.preventDefault(); e.stopPropagation(); guvenli(kayitTusu)(e); } }, true);
    dlg.addEventListener("close", () => {
      KAYIT = null;
      dlg.remove();
      if (AY && AY.dlg === dlg) AY = null;
      if (panelAcikMi() && UI.ayarBtn) UI.ayarBtn.focus();
    });
    AY = { dlg, nav, navListe, ara, baslik, sifir, govde, bolum: bolum || AY_SON, sorgu: "" };
    UI.sar.append(dlg);
    dlg.showModal();
    if (bildirimEl) dlg.append(bildirimEl); // açık bildirim pencerenin arkasında soluk kalmasın
    bolumGoster(AY.bolum);
  }
  // Dil, tema, ölçek, geri alma ya da yedek sonrası açık pencereyi yeniler.
  function ayarlarTazele(dilDegisti) {
    if (!AY || !AY.dlg.open) return;
    KAYIT = null;
    if (dilDegisti) {
      AY.ara.placeholder = t("ayarlarAra"); AY.ara.setAttribute("aria-label", t("ayarlardaAra"));
      AY.nav.setAttribute("aria-label", t("ayarlar"));
      AY.sifir.lastChild.textContent = t("varsayilanaDon");
      const x = AY.dlg.querySelector(".ay-ust .btn.ikon"); x.title = t("kapat"); x.setAttribute("aria-label", t("kapat"));
    }
    const odak = kok.activeElement;
    const navOdak = odak && odak.classList && odak.classList.contains("g-oge") ? odak.dataset.bolum : null;
    const denetimler = () => [...AY.govde.querySelectorAll("button, input, select, textarea")];
    const govdeSira = odak && AY.govde.contains(odak) ? denetimler().indexOf(odak) : -1;
    bolumGoster(AY.bolum, false);
    if (navOdak) { const b = AY.nav.querySelector(`[data-bolum="${navOdak}"]`); if (b) b.focus(); }
    else if (govdeSira >= 0) { const d = denetimler()[govdeSira]; (d || AY.govde).focus(); }
    else if (odak && !odak.isConnected) AY.govde.focus();
  }
  function bolumAdi(id) { return t(`b_${id}`); }
  function gezintiCiz() {
    const q = normal((AY.sorgu || "").trim());
    const uyan = BOLUMLER.filter((b) => !q || normal(bolumAdi(b.id)).includes(q) || normal(bolumKur(b.id).textContent).includes(q));
    const sorun = taniSorunVar();
    const oge = (b) => {
      const el = h("button", { type: "button", class: "g-oge", "data-bolum": b.id, title: bolumAdi(b.id), "aria-current": b.id === AY.bolum ? "page" : null, onclick: () => bolumGoster(b.id) },
        ikon(b.ikon), h("span", { class: "g-ad" }, bolumAdi(b.id)),
        b.id === "tan" && sorun ? h("span", { class: "nokta", role: "img", "aria-label": t("taniSorunAria") }) : null);
      return el;
    };
    const uyg = uyan.filter((b) => b.grup === "uyg"), ort = uyan.filter((b) => b.grup === "ortak");
    doldur(AY.navListe,
      uyg.length ? h("div", { class: "g-baslik" }, UYG.ikon) : null, uyg.map(oge),
      ort.length ? h("div", { class: "g-baslik" }, t("ortak")) : null, ort.map(oge),
      !uyan.length ? h("div", { class: "ay-not", style: "padding:8px" }, t("sonucYok")) : null);
    if (uyan.length && !uyan.some((b) => b.id === AY.bolum)) bolumGoster(uyan[0].id, false);
  }
  function bolumGoster(id, odakla = true) {
    if (!AY) return;
    KAYIT = null;
    AY.bolum = id; AY_SON = id;
    const odak = kok.activeElement;
    const araOdakta = odak === AY.ara;
    gezintiCiz();
    if (AY.bolum !== id) return; // arama süzgeci başka bölümü seçti; o bölüm zaten çizildi
    AY.baslik.textContent = bolumAdi(id);
    AY.sifir.hidden = id === "tan" || id === "hak";
    doldur(AY.govde, bolumKur(id));
    AY.govde.scrollTop = 0;
    if (araOdakta) AY.ara.focus();
    else if (odakla) { const b = AY.nav.querySelector(`[data-bolum="${id}"]`); if (b) b.focus(); }
  }
  function bolumKur(id) {
    switch (id) {
      case "kat": return bolumKategoriler();
      case "etk": return bolumEtiketler();
      case "tas": return bolumTasima();
      case "lst": return bolumListe();
      case "gen": return bolumGenel();
      case "kis": return bolumKisayollar();
      case "tan": return bolumTani();
      case "hak": return bolumHakkinda();
    }
    return h("div");
  }
  const alan = (...c) => h("div", { class: "ay-alan" }, c);
  const alanAdi = (yazi) => h("span", { class: "ay-ad" }, yazi);
  const alanNotu = (yazi) => h("span", { class: "ay-not" }, yazi);
  function segmentKur(adi, secenekler, secili, sec) {
    return h("div", { class: "segment", role: "group", "aria-label": adi },
      secenekler.map(([deger, yazi, alt]) => h("button", { type: "button", "aria-pressed": String(deger === secili), onclick: () => sec(deger) }, yazi, alt ? h("small", null, alt) : null)));
  }
  function anahtarKur(yazi, deger, degisti) {
    const b = h("button", { type: "button", class: "anahtar", role: "switch", "aria-checked": String(!!deger), onclick: () => { const yeni = b.getAttribute("aria-checked") !== "true"; b.setAttribute("aria-checked", String(yeni)); degisti(yeni); } },
      h("span", { class: "iz", "aria-hidden": "true" }), h("span", null, yazi));
    return b;
  }

  // ── Kategoriler ──
  function bolumKategoriler() {
    const kutu = h("div", { style: "display:flex;flex-direction:column;gap:12px" });
    let duzenlenen = null;
    const sayac = () => { const s = {}; for (const v of D.videolar) s[v.kategori] = (s[v.kategori] || 0) + 1; return s; };
    const listeGoster = () => {
      const s = sayac();
      doldur(kutu,
        h("div", { class: "arac" }, dugme({ tur: "ana", tik: () => { duzenlenen = {}; formGoster(); } }, "plus", kisayolEtiketi(t("yeniKategori"), "N"))),
        h("div", null, ayar.kategoriler.map((k, i) => h("div", { class: "katsatir" },
          h("span", { class: "sira" }, h("span", { class: "kisayol rakam" }, i < 9 ? i + 1 : "")),
          h("span", { class: "etiket-dolu", style: renkDegiskenleri(k.renk) }, ikon(k.ikon), k.ad),
          h("span", { class: "alt-bilgi" }, t("katSayac", s[k.id] || 0, Object.values(ayar.kanal).filter((x) => x === k.id).length)),
          h("div", { class: "esnek" }),
          dugme({ tur: "kucuk", tik: () => { duzenlenen = k; formGoster(); } }, "pencil", t("duzenle")),
          dugme({ tur: "kucuk tehlike", kapali: k.id === "misc", ipucu: k.id === "misc" ? t("miscSilinmez") : null, tik: () => { kategoriSil(k); listeGoster(); } }, "trash-2", t("sil"))))),
        alanNotu(t("katNot", onek())));
    };
    const formGoster = () => {
      const yeni = !duzenlenen.id;
      let ikonSec = duzenlenen.ikon || "tag", renkSec = duzenlenen.renk || RENKLER.find((r) => !ayar.kategoriler.some((k) => k.renk === r)) || "belge";
      const adGirdi = h("input", { type: "text", class: "girdi", value: duzenlenen.ad || "", maxlength: "40", "aria-label": t("katAdi") });
      const hata = h("div", { class: "alan-hata", hidden: true });
      const ikonlar = h("div", { class: "secim", role: "group", "aria-label": t("ikon") });
      const renkler = h("div", { class: "secim", role: "group", "aria-label": t("renk") });
      const onizleme = h("div");
      const yenidenAd = h("input", { type: "checkbox", checked: true });
      const yt_ = h("label", { class: "onay", hidden: yeni || !panelAcikMi() }, yenidenAd, h("span", null, t("ytAdiDegistir", onek(), duzenlenen.ad || "")));
      const ciz_ = () => {
        doldur(ikonlar, KATEGORI_IKONLARI.map((a) => h("button", { type: "button", class: "ikonsec", title: a, "aria-label": t("ikonAria", a), "aria-pressed": String(a === ikonSec), onclick: () => { ikonSec = a; ciz_(); } }, ikon(a))));
        doldur(renkler, RENKLER.map((r) => h("button", { type: "button", class: "cip", style: renkDegiskenleri(r), "aria-pressed": String(r === renkSec), onclick: () => { renkSec = r; ciz_(); } }, t(`renk_${r}`))));
        doldur(onizleme, h("span", { class: "etiket-dolu", style: renkDegiskenleri(renkSec) }, ikon(ikonSec), adGirdi.value.trim() || t("onizleme")));
      };
      adGirdi.addEventListener("input", ciz_);
      ciz_();
      const kaydet = async () => {
        const ad = adGirdi.value.replace(/\s+/g, " ").trim();
        const goster = (m) => { doldur(hata, ikon("triangle-alert"), h("span", null, m)); hata.hidden = false; adGirdi.focus(); };
        if (!ad) return goster(t("adBos"));
        if (ayar.kategoriler.some((k) => k !== duzenlenen && adEsit(k.ad.toLowerCase(), ad.toLowerCase()))) return goster(t("adVar"));
        if (yeni) kategoriEkle({ id: benzersizId(ad), ad, ikon: ikonSec, renk: renkSec });
        else await kategoriGuncelle(duzenlenen, { ad, ikon: ikonSec, renk: renkSec }, yenidenAd.checked);
        duzenlenen = null; listeGoster();
      };
      adGirdi.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); kaydet(); } });
      doldur(kutu,
        h("label", { class: "alan" }, t("ad"), adGirdi), hata,
        h("div", { class: "alan" }, t("renk"), renkler),
        h("div", { class: "alan" }, t("ikon"), ikonlar),
        h("div", { class: "alan" }, t("onizleme"), onizleme),
        yt_,
        h("div", { class: "arac", style: "justify-content:flex-end" },
          dugme({ tik: () => { duzenlenen = null; listeGoster(); } }, null, t("vazgec")),
          dugme({ tur: "ana", tik: kaydet }, "check", yeni ? t("kategoriyiEkle") : t("degisikligiKaydet"))));
      setTimeout(() => adGirdi.focus(), 0);
    };
    kutu.addEventListener("keydown", (e) => {
      if (duzenlenen || e.ctrlKey || e.altKey || e.metaKey || yaziAlani(e.composedPath()[0])) return;
      if (e.code === "KeyN") { e.preventDefault(); duzenlenen = {}; formGoster(); }
    });
    listeGoster();
    return kutu;
  }

  // ── Kanal etiketleri ──
  function bolumEtiketler() {
    let q = "";
    const kutu = h("div");
    const sayacEl = h("span", { class: "alt-bilgi" });
    const ciz_ = () => {
      const girdiler = Object.entries(ayar.kanal).filter(([k]) => normal(k).includes(normal(q))).sort((a, b) => a[0].localeCompare(b[0], "tr"));
      sayacEl.textContent = t("nEtiket", Object.keys(ayar.kanal).length);
      bosalt(kutu);
      if (!girdiler.length) {
        kutu.append(bosDurum("tags", Object.keys(ayar.kanal).length ? t("uyanEtiketYok") : t("etiketYok"), t("etiketYokAcik")));
        return;
      }
      kutu.append(h("table", { class: "tablo" },
        h("thead", null, h("tr", null, h("th", null, t("kanal")), h("th", null, t("kategori")), h("th", { class: "sag" }, h("span", { class: "yazi-gizle" }, t("kaldir"))))),
        h("tbody", null, girdiler.map(([kanal, katId]) => {
          const k = katBul(katId);
          return h("tr", null,
            h("td", null, kanal),
            h("td", null, h("select", { class: "kat", style: renkDegiskenleri(k ? k.renk : "notr"), "aria-label": t("katAria", kanal), onchange: (e) => { etiketle(kanal, e.target.value); ciz_(); } },
              k ? null : h("option", { value: "", selected: true }, t("silinmisKat")),
              ayar.kategoriler.map((x) => h("option", { value: x.id, selected: x.id === katId }, x.ad)))),
            h("td", { class: "sag" }, dugme({ tur: "hayalet ikon kucuk", ipucu: t("etiketiKaldirAria", kanal), tik: () => { etiketle(kanal, null); ciz_(); } }, "x")));
        }))));
    };
    ciz_();
    return h("div", { style: "display:flex;flex-direction:column;gap:12px" },
      h("div", { class: "arac" },
        h("div", { class: "arama", style: "flex:1 1 200px" }, ikon("search"), h("input", { type: "search", class: "girdi", placeholder: t("kanalAra"), "aria-label": t("kanalAra"), oninput: (e) => { q = e.target.value; ciz_(); } })),
        sayacEl),
      kutu,
      alanNotu(t("etkNot")));
  }

  // ── Taşıma ──
  function bolumTasima() {
    const girdi = h("input", { type: "text", class: "girdi", value: ayar.onek, maxlength: "20", "aria-label": t("onekBaslik") });
    const hata = h("div", { class: "ay-hata", hidden: true });
    const notEl = alanNotu(t("onekNot", ayar.onek));
    const kaydet = () => {
      const deger = girdi.value;
      if (!deger.trim() || deger.trim().length < 2) { doldur(hata, ikon("triangle-alert"), h("span", null, deger.trim() ? t("onekKisa") : t("onekBos"))); hata.hidden = false; girdi.focus(); return; }
      hata.hidden = true;
      if (deger === ayar.onek) return;
      ayar.onek = deger; ayarKaydet();
      notEl.textContent = t("onekNot", deger);
      bildir(t("onekKaydedildi", deger));
    };
    girdi.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); kaydet(); } });
    girdi.addEventListener("change", guvenli(kaydet));
    return h("div", { style: "display:flex;flex-direction:column;gap:14px" },
      alan(h("label", { class: "ay-ad" }, t("onekBaslik")), h("div", { class: "arac" }, girdi, dugme({ tur: "kucuk", tik: kaydet }, "check", t("onekKaydet"))), hata, notEl),
      alan(alanAdi(t("gorunurluk")), segmentKur(t("gorunurluk"), GORUNURLUKLER.map((g) => [g, t(`gor_${g}`)]), ayar.gorunurluk, (g) => { ayar.gorunurluk = g; ayarKaydet(); ayarlarTazele(); }), alanNotu(t("gorNot"))),
      alan(alanAdi(t("davranis")), alanNotu(t("davranisNot"))),
      alan(alanAdi(t("guvenlik")), alanNotu(t("guvenlikNot"))));
  }

  // ── Liste görünümü ──
  function bolumListe() {
    const yenidenCiz = () => { ayarKaydet(); ciz(); };
    return h("div", { style: "display:flex;flex-direction:column;gap:14px" },
      alan(alanAdi(t("acilisSiralama")), segmentKur(t("acilisSiralama"), [["kisa", t("kisaOnce")], ["uzun", t("uzunOnce")], ["liste", t("listeSirasi")]], ayar.siralama, (d) => { ayar.siralama = d; yenidenCiz(); ayarlarTazele(); })),
      alan(anahtarKur(t("kucukResim"), ayar.kucukResim, (v) => { ayar.kucukResim = v; yenidenCiz(); })),
      alan(anahtarKur(t("suresizSonda"), ayar.suresizSonda, (v) => { ayar.suresizSonda = v; yenidenCiz(); }), alanNotu(t("suresizNot"))),
      alan(anahtarKur(t("acilistaSecili"), ayar.acilistaSecili, (v) => { ayar.acilistaSecili = v; ayarKaydet(); }), alanNotu(t("acilistaSeciliNot"))));
  }

  // ── Genel ──
  function bolumGenel() {
    const ks = ayar.kisayollar;
    const dilSecimi = ayar.dil || "tarayici";
    return h("div", { style: "display:flex;flex-direction:column;gap:14px" },
      alan(alanAdi(t("dil")),
        h("div", { class: "segment iki-satir", role: "group", "aria-label": t("dil") },
          [["tarayici", t("tarayiciDili"), t("algilanan", t(`dilAdi_${tarayiciDili()}`))], ["tr", "Türkçe"], ["en", "English"]].map(([d, yazi, alt]) =>
            h("button", { type: "button", lang: d === "tarayici" ? null : d, "aria-pressed": String(d === dilSecimi), onclick: () => dilSec(d === "tarayici" ? null : d) }, yazi, alt ? h("small", null, alt) : null))),
        alanNotu(t("dilNot", ks.dil))),
      alan(alanAdi(t("tema")), segmentKur(t("tema"), [["acik", t("acik")], ["koyu", t("koyu")], [null, t("ytIzle")]], ayar.tema, (d) => temaSec(d)), alanNotu(t("kisayolNot", ks.tema))),
      alan(alanAdi(t("olcek")), segmentKur(t("olcek"), OLCEKLER.map((n) => [n, t("olcekDeger", n)]), ayar.olcek, olcekSec), alanNotu(t("olcekNot"))));
  }

  // ── Klavye kısayolları ──
  function bolumKisayollar() {
    const ks = ayar.kisayollar;
    const mesaj = KAYIT ? h("div", { style: "display:flex;flex-direction:column;gap:4px" },
      KAYIT.hata ? h("div", { class: "ay-hata", role: "alert" }, ikon("triangle-alert"), h("span", null, KAYIT.hata)) : null,
      h("div", { class: "ay-not", role: "status" }, t("ksYonerge", t(`ks_${KAYIT.anahtar}`)))) : null;
    return h("div", { style: "display:flex;flex-direction:column;gap:12px" },
      mesaj,
      h("table", { class: "tablo" },
        h("thead", null, h("tr", null, h("th", null, t("islem")), h("th", null, t("kisayol")), h("th", { class: "sag" }, h("span", { class: "yazi-gizle" }, t("degistir"))))),
        h("tbody", null, KISAYOL_SIRASI.map((a) => {
          const bekliyor = KAYIT && KAYIT.anahtar === a;
          return h("tr", null,
            h("td", null, t(`ks_${a}`)),
            h("td", null, h("span", { class: `tus${bekliyor ? " bekliyor" : ""}` }, bekliyor ? t("ksBekliyor") : ks[a])),
            h("td", { class: "sag" }, dugme({ tur: "kucuk", tik: () => kayitBaslat(a) }, null, t("degistir"))));
        }))),
      alanNotu(t("ksNot")));
  }
  function kayitBaslat(anahtar) {
    KAYIT = { anahtar, hata: null };
    doldur(AY.govde, bolumKisayollar());
    const tus = AY.govde.querySelector(".tus.bekliyor");
    const b = tus && tus.closest("tr").querySelector("button");
    if (b) b.focus();
  }
  function kisayolSorunu(anahtar, tus) {
    if (!/^(Ctrl|Alt)\+/.test(tus) && tus !== "/") return t("ksDegiskenGerekli");
    if (/^Ctrl\+Alt\+/.test(tus) || !kisayolGecerli(anahtar, tus)) return t("ksAyrilmis"); // AltGr, düzenleme tuşları, Firefox
    const diger = KISAYOL_SIRASI.find((a) => a !== anahtar && ayar.kisayollar[a] === tus);
    if (diger) return t("ksKullaniliyor", t(`ks_${diger}`));
    return null;
  }
  function kayitTusu(e) {
    const tus = tusAdi(e);
    if (!tus) return;
    const a = KAYIT.anahtar;
    const yenile = () => { doldur(AY.govde, bolumKisayollar()); const b = AY.govde.querySelectorAll("tbody tr button")[KISAYOL_SIRASI.indexOf(a)]; if (b) b.focus(); };
    if (tus === "Esc") { KAYIT = null; KAYIT_BITTI = Date.now(); yenile(); return; }
    const sorun = kisayolSorunu(a, tus);
    if (sorun) { KAYIT.hata = sorun; yenile(); return; }
    ayar.kisayollar[a] = tus; ayarKaydet();
    KAYIT = null; KAYIT_BITTI = Date.now();
    yenile();
    kisayolMetinleriniYenile();
    bildir(t("ksKaydedildi", t(`ks_${a}`), tus));
  }
  function kisayolMetinleriniYenile() {
    if (!panel) return;
    const ks = ayar.kisayollar;
    UI.dilBtn.title = t("dilDugme", ks.dil); UI.dilBtn.setAttribute("aria-label", t("dilDugme", ks.dil));
    UI.ayarBtn.title = `${t("ayarlar")} (${ks.ayarlar})`;
    const x = panel.querySelector(".ust .arac > .btn.ikon:last-child");
    if (x) { x.title = t("kapatTus", ks.kapat); x.setAttribute("aria-label", t("kapatTus", ks.kapat)); }
    temaUygula();
  }

  // ── Tanı ──
  function yolAdi(y) { return t(`t_yol_${y}`); }
  function taniSatirlari() {
    const satirlar = [];
    const id = listeSayfasi();
    satirlar.push({ durum: id ? "ok" : "bilgi", ad: t("t_sayfa"), deger: id ? `${t("t_sayfaListe")} · list=${id}` : t("t_sayfaDegil") });
    satirlar.push({ durum: sapisidCerezi() ? "ok" : "hata", ad: t("t_oturum"), deger: sapisidCerezi() ? `SAPISID · ${t("t_var")}` : `SAPISID · ${t("t_yok")}` });
    const v = ytcfg("INNERTUBE_CLIENT_VERSION");
    satirlar.push({ durum: v ? "ok" : "bilgi", ad: t("t_istemci"), deger: v ? `${ytcfg("INNERTUBE_CLIENT_NAME") || "WEB"} ${v}` : t("t_istemciYok", VARSAYILAN_ISTEMCI) });
    const i = TANI.istek;
    satirlar.push(!i ? { durum: "bilgi", ad: t("t_istek"), deger: t("t_henuzIstekYok") }
      : { durum: i.hata ? "hata" : "ok", ad: t("t_istek"), deger: `${yolAdi(i.yol)} · ${i.durum || t("t_agHatasi")}${i.sade ? ` · ${t("t_sade")}` : ""}${i.not ? ` · ${i.not}` : ""}` });
    const l = TANI.liste;
    satirlar.push(!l ? { durum: "bilgi", ad: t("t_liste"), deger: t("t_henuzOkunmadi") }
      : l.hata ? { durum: "hata", ad: t("t_liste"), deger: l.hata }
        : { durum: l.tam ? "ok" : "uyari", ad: t("t_liste"), deger: l.tam ? t("t_listeOk", l.okunan, l.gizli) : t("t_listeEksik", l.okunan, l.toplam) });
    const ls = TANI.listeler;
    satirlar.push(!ls ? { durum: "bilgi", ad: t("t_listeler"), deger: t("t_henuzOkunmadi") }
      : ls.hata ? { durum: "hata", ad: t("t_listeler"), deger: ls.hata }
        : { durum: "ok", ad: t("t_listeler"), deger: t("t_listelerOk", ls.toplam, onek().trim(), ls.onekli) });
    satirlar.push({ durum: "ok", ad: t("t_tt"), deger: `${window.trustedTypes ? "trustedTypes ✓" : "trustedTypes —"} · ${t("t_ttOk")}` });
    return satirlar;
  }
  function taniSorunVar() { return taniSatirlari().some((s) => s.durum === "hata"); }
  function taniIsaretle() {
    const sorun = taniSorunVar();
    if (UI.ayarBtn) {
      const n = UI.ayarBtn.querySelector(".nokta");
      if (sorun && !n) UI.ayarBtn.append(h("span", { class: "nokta", role: "img", "aria-label": t("taniSorunAria") }));
      else if (!sorun && n) n.remove();
    }
    if (tetik && !tetik.hidden && !!tetik.querySelector(".nokta") !== sorun) tetikGoster();
    if (AY && AY.dlg.open && !KAYIT) {
      const n = AY.nav.querySelector('[data-bolum="tan"] .nokta');
      if (!!n !== sorun) gezintiCiz();
      if (AY.bolum === "tan") {
        const ozet = JSON.stringify(taniSatirlari());
        const yedekAcik = AY.govde.querySelector("textarea.rapor");
        if (ozet !== AY.taniOzet && !yedekAcik) { AY.taniOzet = ozet; const sira = [...AY.govde.querySelectorAll("button")].indexOf(kok.activeElement); doldur(AY.govde, bolumTani()); if (sira >= 0) { const b = AY.govde.querySelectorAll("button")[sira]; if (b) b.focus(); } }
      }
    }
  }
  function taniRaporu() {
    const ikonMetin = { ok: "✓", hata: "✗", uyari: "!", bilgi: "·" };
    let yonetici = "?";
    try { yonetici = `${GM_info.scriptHandler || "?"} ${GM_info.version || ""}`.trim(); } catch (e) { /* GM_info yok */ }
    const satirlar = [
      `${UYG.ad} ${UYG.surum} · tanı raporu`,
      `Tarih: ${okunurZaman()}`,
      `Tarayıcı: ${navigator.userAgent}`,
      `Eklenti: ${yonetici}`,
      `Sayfa: ${location.pathname}${location.search}`,
      `Dil: ${DIL}${ayar.dil ? "" : " (tarayıcı)"} · Tema: ${ayar.tema || "youtube"} (${etkinTema()}) · Ölçek: %${ayar.olcek}`,
      `Kategori: ${ayar.kategoriler.length} · Kanal etiketi: ${Object.keys(ayar.kanal).length} · Önek: "${ayar.onek}" · Görünürlük: ${ayar.gorunurluk}`,
      `İstek yolları: ${FETCH_YOLLARI.map((y) => y[0]).join(", ")} · şimdiki: ${FETCH_YOLLARI[fetchSira][0]} · sade kip: ${sadeKip ? "evet" : "hayır"}`,
      "",
      ...taniSatirlari().map((s) => `${ikonMetin[s.durum]} ${s.ad}: ${s.deger}`),
      "",
      `Son günlük satırları (${Math.min(30, gunluk.length)}):`,
      ...gunluk.slice(-30),
    ];
    return satirlar.join("\n");
  }
  async function panoyaYaz(metin_) {
    try { if (typeof GM_setClipboard === "function") { GM_setClipboard(metin_, "text"); return true; } } catch (e) { /* sıradaki yol */ }
    try { await navigator.clipboard.writeText(metin_); return true; } catch (e) { return false; }
  }
  function bolumTani() {
    const satirlar = taniSatirlari();
    const sorun = satirlar.some((s) => s.durum === "hata");
    const yedekAlan = h("div", { hidden: true, style: "display:flex;flex-direction:column;gap:6px;align-self:stretch" });
    const kopyala = async () => {
      const r = taniRaporu();
      if (await panoyaYaz(r)) { bildir(t("raporKopyalandi", r.split("\n").length)); return; }
      const alan_ = h("textarea", { class: "rapor", readonly: true, "aria-label": t("raporuKopyala") }, r);
      doldur(yedekAlan, h("div", { class: "ay-hata" }, ikon("triangle-alert"), h("span", null, t("raporKopyalanamadi"))), alan_);
      yedekAlan.hidden = false; alan_.focus(); alan_.select();
    };
    const ikonlar = { ok: "circle-check", hata: "circle-x", uyari: "triangle-alert", bilgi: "info" };
    return h("div", { style: "display:flex;flex-direction:column;gap:12px" },
      sorun ? h("div", { class: "kutu hata", role: "alert" }, h("span", { class: "durum hata kutu-baslik" }, ikon("circle-x"), t("t_sorunBaslik")), h("span", null, t("t_sorunAcik"))) : null,
      h("div", { class: "arac" }, dugme({ tur: "ana", tik: kopyala }, "copy", t("raporuKopyala")), dugme({ tik: gunluguIndir }, "file-down", t("gunluguIndir"))),
      yedekAlan,
      h("table", { class: "tablo" }, h("tbody", null, satirlar.map((s) => h("tr", null,
        h("td", { style: "width:24px" }, h("span", { class: `durum ${s.durum}` }, ikon(ikonlar[s.durum]))),
        h("td", null, s.ad),
        h("td", { class: "ikinci" }, s.deger))))),
      alanNotu(t("taniNot")));
  }

  // ── Hakkında + Yedekleme ──
  function bolumHakkinda() {
    return h("div", { style: "display:flex;flex-direction:column;gap:14px" },
      h("div", { class: "arac", style: "gap:12px;flex-wrap:nowrap" },
        h("div", { class: "logo buyuk", "aria-hidden": "true" }, UYG.ikon),
        h("div", { style: "min-width:0" }, h("div", { class: "baslik" }, UYG.ad), h("div", { class: "alt-baslik", style: "max-width:none;white-space:normal" }, t("surumSatir", UYG.surum, UYG.tarih, UYG.oturum, UYG.tasarim)))),
      alanNotu(t("guncellemeNot")),
      h("div", { class: "kutu" },
        h("span", { class: "kutu-baslik" }, t("yedekleme")),
        h("div", { class: "arac" }, dugme({ tik: yedekOlustur }, "file-down", t("yedekOlustur")), dugme({ tik: yedektenYukle }, "file-up", t("yedektenYukle"))),
        alanNotu(t("yedekNot")),
        alanNotu(t("yedekEskiNot")),
        alanNotu(t("sonYedek", ayar.sonYedek || t("henuzYok")))),
      alanNotu("Lucide 1.55.0 (ISC) · Open Sans (OFL)"));
  }
  const YEDEK_ALANLARI = ["kategoriler", "kanal", "onek", "gorunurluk", "siralama", "kucukResim", "suresizSonda", "acilistaSecili", "tema", "dil", "olcek", "kisayollar"];
  function yedekOlustur() {
    const veri = { uygulama: UYG.ad, tur: "yedek", surum: UYG.surum, tarih: damga(), ayar: {} };
    for (const a of YEDEK_ALANLARI) veri.ayar[a] = JSON.parse(JSON.stringify(ayar[a]));
    dosyaIndir(`${UYG.ikon}-yedek-${damga()}.json`, veri);
    ayar.sonYedek = okunurZaman(); ayarKaydet();
    bildir(t("yedekOlusturuldu"));
    ayarlarTazele();
  }
  function ayarAnlik() { return JSON.parse(JSON.stringify(ayar)); }
  // Geri alma yalnız o işlemin değiştirdiği alanları eski hâline koyar; sonraki ayar değişiklikleri ve son yedek tarihi korunur.
  function ayarGeriKoy(anlik, videolar, alanlar) {
    for (const a of alanlar) ayar[a] = JSON.parse(JSON.stringify(anlik[a]));
    ayar = Object.assign(ayarDuzelt(ayar), { gecisGerekli: ayar.gecisGerekli, gecisNotu: ayar.gecisNotu, sonYedek: ayar.sonYedek });
    ayarKaydet();
    if (videolar) for (const [v, kat, elle] of videolar) { v.kategori = kat; v.elle = elle; }
    for (const v of D.videolar) if (!v.elle || !katBul(v.kategori)) { v.kategori = kategoriTahmin(v.baslik, v.kanal); v.elle = false; }
    sonrakiAyarUygula();
  }
  // Ayar toptan değişince (yedek, varsayılana dön, geri al) her yer yeniden çizilir.
  function sonrakiAyarUygula() {
    if (D.filtre && !katBul(D.filtre)) D.filtre = null;
    olcekUygula(); temaUygula();
    const yeniDil = ayar.dil || tarayiciDili();
    if (yeniDil !== DIL) { DIL = yeniDil; if (host) host.setAttribute("lang", DIL); arayuzuYenile(); }
    else { kisayolMetinleriniYenile(); ciz(); ayarlarTazele(); }
  }
  // Yedekteki her alan ayrı denetlenir; bozuk alan atlanır (şimdiki değer kalır), yerine boş değer yazılmaz.
  function yedekTemizle(y) {
    const temiz = {}, bozuk = [];
    const nesne = (x) => x && typeof x === "object" && !Array.isArray(x);
    const kontrol = {
      kategoriler: (x) => Array.isArray(x) && x.some((k) => k && k.id && k.ad),
      kanal: (x) => nesne(x) && Object.values(x).every((v) => typeof v === "string"),
      onek: (x) => typeof x === "string" && x.trim().length >= 2,
      gorunurluk: (x) => GORUNURLUKLER.includes(x),
      siralama: (x) => ["kisa", "uzun", "liste"].includes(x),
      kucukResim: (x) => typeof x === "boolean", suresizSonda: (x) => typeof x === "boolean", acilistaSecili: (x) => typeof x === "boolean",
      tema: (x) => x === null || x === "acik" || x === "koyu",
      dil: (x) => x === null || x === "tr" || x === "en",
      olcek: (x) => OLCEKLER.includes(x),
      kisayollar: nesne,
    };
    for (const a of YEDEK_ALANLARI) {
      if (!(a in y)) continue;
      if (kontrol[a](y[a])) temiz[a] = y[a]; else bozuk.push(a);
    }
    return { temiz, bozuk };
  }
  function yedektenYukle() {
    const girdi = h("input", { type: "file", accept: "application/json,.json", hidden: true });
    girdi.addEventListener("change", guvenli(async () => {
      const dosya = girdi.files && girdi.files[0];
      girdi.remove();
      if (!dosya) return;
      if (dosya.size > 5 * 1024 * 1024) return bildir(t("dosyaBuyuk"));
      let veri;
      try { veri = JSON.parse(await dosya.text()); }
      catch (e) { return bildir(t("dosyaOkunamadi")); }
      if (!veri || typeof veri !== "object" || Array.isArray(veri)) return bildir(t("yedekIcerikYok"));
      if (veri.tur === "yedek") return veri.ayar && typeof veri.ayar === "object" && !Array.isArray(veri.ayar) ? tamYedekYukle(dosya.name, veri.ayar) : bildir(t("yedekIcerikYok"));
      // Eski biçimler: 3.x "Etiketleri dışa aktar" ({kategoriler, kanal}) ya da düz kanal haritası ({kanal: kategori}).
      const kanal = veri.kanal && typeof veri.kanal === "object" ? veri.kanal
        : (!veri.kategoriler && Object.values(veri).some((x) => typeof x === "string") ? veri : null);
      if (!kanal) return bildir(t("yedekIcerikYok"));
      return eskiEtiketYukle(dosya.name, kanal, Array.isArray(veri.kategoriler) ? veri.kategoriler : []);
    }));
    (acikModal() || UI.sar).append(girdi);
    girdi.click();
  }
  async function tamYedekYukle(dosyaAdi, yedek_) {
    const { temiz: yedek, bozuk } = yedekTemizle(yedek_);
    if (!Object.keys(yedek).length) return bildir(t("yedekIcerikYok"));
    const yeni = ayarDuzelt({ ...ayar, ...yedek });
    const silinecek = ayar.kategoriler.filter((k) => !yeni.kategoriler.some((x) => x.id === k.id)).map((k) => k.ad);
    const etiketOnce = Object.keys(ayar.kanal).length, etiketSonra = Object.keys(yeni.kanal).length;
    const azaliyor = etiketSonra < etiketOnce;
    const alanlar = Object.keys(yedek);
    const ok = await onayla(t("geriYukleBaslik"), [
      h("p", null, dosyaAdi),
      h("table", { class: "tablo" },
        h("thead", null, h("tr", null, h("th", null, ""), h("th", null, t("gy_simdi")), h("th", null, t("gy_yedekte")))),
        h("tbody", null, [
          [t("gy_kategori"), ayar.kategoriler.length, yeni.kategoriler.length],
          [t("gy_etiket"), etiketOnce, etiketSonra],
          [t("gy_onek"), `"${ayar.onek}"`, `"${yeni.onek}"`],
          [t("gy_gorunurluk"), t(`gor_${ayar.gorunurluk}`), t(`gor_${yeni.gorunurluk}`)],
        ].map(([a, x, y]) => h("tr", null, h("td", null, a), h("td", { class: "sayi" }, x), h("td", { class: "sayi" }, y))))),
      silinecek.length ? not(t("gy_silinecekKat", silinecek.join(", ")), "uyari") : null,
      azaliyor ? not(t("gy_etiketAzaliyor", etiketOnce, etiketSonra), "uyari") : null,
      bozuk.length ? not(t("gy_bozukAlan", bozuk.join(", ")), "uyari") : null,
      not(t("geriYukleNot")),
    ], t("geriYukle"), azaliyor || silinecek.length ? "tehlike" : "ana", "file-up");
    if (!ok) return;
    const once = ayarAnlik();
    const videolar = D.videolar.map((v) => [v, v.kategori, v.elle]);
    const uygula = () => {
      const s = ayarDuzelt({ ...ayar, ...yedek });
      s.gecisGerekli = ayar.gecisGerekli; s.gecisNotu = ayar.gecisNotu; s.sonYedek = ayar.sonYedek;
      ayar = s; ayarKaydet();
      for (const v of D.videolar) if (!v.elle || !katBul(v.kategori)) { v.kategori = kategoriTahmin(v.baslik, v.kanal); v.elle = false; }
      sonrakiAyarUygula();
    };
    uygula();
    geriKaydet(t("g_geriYukleme"), () => ayarGeriKoy(once, videolar, alanlar), uygula);
    bildir(t("geriYuklendi"), { geriAl: true });
  }
  async function eskiEtiketYukle(dosyaAdi, kanal, dosyaKat_) {
    const dosyaKat = dosyaKat_.filter((k) => k && k.id && k.ad);
    const yeniKat = dosyaKat.filter((k) => !katBul(k.id));
    const gecerli = (id) => katBul(id) || yeniKat.some((k) => k.id === id);
    let yeniE = 0, degisen = 0, ayni = 0, atlanan = 0;
    for (const [k, v] of Object.entries(kanal)) {
      if (typeof v !== "string" || !gecerli(v)) { atlanan++; continue; }
      const mevcut = ayar.kanal[kanalAnahtari(k)];
      if (!mevcut) yeniE++; else if (mevcut === v) ayni++; else degisen++;
    }
    const ok = await onayla(t("geriYukleBaslik"), [
      h("p", null, dosyaAdi),
      h("table", { class: "tablo" }, h("tbody", null,
        [[t("gy_yeniEtiket"), yeniE], [t("gy_degisecek"), degisen], [t("gy_ayni"), ayni], [t("gy_yeniKat"), yeniKat.length], [t("gy_atlanan"), atlanan]]
          .map(([a, n]) => h("tr", null, h("td", null, a), h("td", { class: "sayi" }, n))))),
      not(t("eskiDosyaNot")),
    ], t("geriYukle"), "ana", "file-up");
    if (!ok) return;
    const once = ayarAnlik();
    const videolar = D.videolar.map((v) => [v, v.kategori, v.elle]);
    const uygula = () => {
      for (const k of yeniKat) if (!katBul(k.id)) ayar.kategoriler.splice(ayar.kategoriler.length - 1, 0, ayarDuzelt({ kategoriler: [{ ...k }] }).kategoriler[0]);
      for (const [k, v] of Object.entries(kanal)) if (typeof v === "string" && katBul(v)) ayar.kanal[kanalAnahtari(k)] = v;
      ayarKaydet();
      for (const v of D.videolar) if (!v.elle) v.kategori = kategoriTahmin(v.baslik, v.kanal);
      ciz(); ayarlarTazele();
    };
    uygula();
    geriKaydet(t("g_geriYukleme"), () => ayarGeriKoy(once, videolar, ["kategoriler", "kanal"]), uygula);
    bildir(t("etiketlerEklendi", yeniE + degisen), { geriAl: true });
  }

  // ── Varsayılana dön (bölüm başına) ──
  async function varsayilanaDon(id) {
    const ad = bolumAdi(id);
    const once = ayarAnlik();
    const videolar = D.videolar.map((v) => [v, v.kategori, v.elle]);
    const ALANLAR = { kat: ["kategoriler", "kanal"], etk: ["kanal"], tas: ["onek", "gorunurluk"], lst: ["siralama", "kucukResim", "suresizSonda", "acilistaSecili"], gen: ["dil", "tema", "olcek"], kis: ["kisayollar"] };
    let uygula = null;
    if (id === "kat") {
      const varsayilanIdler = new Set(VARSAYILAN_KATEGORILER.map((k) => k.id));
      const eklenen = ayar.kategoriler.filter((k) => !varsayilanIdler.has(k.id)).length;
      const etiket = Object.values(ayar.kanal).filter((k) => !varsayilanIdler.has(k)).length;
      if (!(await onayla(t("katSifirBaslik"), [h("p", null, t("katSifirMetin", eklenen, etiket)), not(t("sifirGeriNot"))], t("varsayilanaDon"), "tehlike", "rotate-ccw"))) return;
      uygula = () => {
        ayar.kategoriler = VARSAYILAN_KATEGORILER.map((k) => ({ ...k }));
        for (const [kanal, kat] of Object.entries(ayar.kanal)) if (!katBul(kat)) delete ayar.kanal[kanal];
        for (const v of D.videolar) if (!v.elle || !katBul(v.kategori)) { v.kategori = kategoriTahmin(v.baslik, v.kanal); v.elle = false; }
      };
    } else if (id === "etk") {
      const n = Object.keys(ayar.kanal).length;
      if (!n) return;
      if (!(await onayla(t("etkSifirBaslik"), [h("p", null, t("etkSifirMetin", n)), not(t("sifirGeriNot"))], t("varsayilanaDon"), "tehlike", "rotate-ccw"))) return;
      uygula = () => { ayar.kanal = {}; for (const v of D.videolar) if (!v.elle) v.kategori = kategoriTahmin(v.baslik, v.kanal); };
    } else if (id === "tas") uygula = () => { ayar.onek = VARSAYILAN_ONEK; ayar.gorunurluk = "UNLISTED"; };
    else if (id === "lst") uygula = () => { ayar.siralama = "kisa"; ayar.kucukResim = true; ayar.suresizSonda = true; ayar.acilistaSecili = true; };
    else if (id === "gen") uygula = () => { ayar.dil = null; ayar.tema = null; ayar.olcek = 100; };
    else if (id === "kis") uygula = () => { ayar.kisayollar = { ...VARSAYILAN_KISAYOLLAR }; };
    if (!uygula) return;
    const calis = () => { uygula(); ayarKaydet(); sonrakiAyarUygula(); };
    calis();
    geriKaydet(t("g_varsayilan", ad), () => ayarGeriKoy(once, videolar, ALANLAR[id]), calis);
    bildir(t("varsayilanaDondu", ad), { geriAl: true });
  }

  // ─── Eklenti menüsü (Tampermonkey); dil değişince yeniden kaydedilir ───
  let gmKimlikler = [];
  function gmMenuKaydet() {
    if (typeof GM_registerMenuCommand !== "function") return;
    if (gmKimlikler.length) {
      // Kaldırılamıyorsa (eski eklenti ya da kimlik dönmedi) çift kayıt yerine eskisi kalır.
      if (typeof GM_unregisterMenuCommand !== "function" || gmKimlikler.some((k) => k == null)) return;
      for (const k of gmKimlikler) { try { GM_unregisterMenuCommand(k); } catch (e) { /* yok */ } }
    }
    gmKimlikler = [];
    try { gmKimlikler.push(GM_registerMenuCommand(`${t("gmAc")} (O)`, guvenli(panelAc), "o")); } catch (e) { /* desteklenmiyor */ }
    try { gmKimlikler.push(GM_registerMenuCommand(`${t("gmAyarlar")} (A)`, guvenli(() => ayarlarAc()), "a")); } catch (e) { /* desteklenmiyor */ }
  }

  // ─── İşlemler: kategori, etiket ───
  function kategoriDegistir(v, yeni) {
    const eski = v.kategori, eskiElle = v.elle;
    if (eski === yeni) return;
    const uygula = (k, elle) => { v.kategori = k; v.elle = elle; ciplerCiz(); listeCiz(); imlecKoy(D.imlec, false); };
    uygula(yeni, true);
    geriKaydet(t("g_katDegisikligi"), () => uygula(eski, eskiElle), () => uygula(yeni, true));
  }
  function kanalAnlikGoruntu(kanal) {
    const k = kanalAnahtari(kanal);
    return { etiket: ayar.kanal[k] ?? null, videolar: D.videolar.filter((v) => kanalAnahtari(v.kanal) === k).map((v) => [v, v.kategori, v.elle]) };
  }
  function kanalEtiketiUygula(kanal, katId) {
    const k = kanalAnahtari(kanal);
    if (katId) ayar.kanal[k] = katId; else delete ayar.kanal[k];
    ayarKaydet();
    for (const v of D.videolar) if (kanalAnahtari(v.kanal) === k) { v.kategori = kategoriTahmin(v.baslik, v.kanal); v.elle = false; }
  }
  function kanalGeriYukle(kanal, g) {
    const k = kanalAnahtari(kanal);
    if (g.etiket) ayar.kanal[k] = g.etiket; else delete ayar.kanal[k];
    ayarKaydet();
    for (const [v, kat, elle] of g.videolar) { v.kategori = kat; v.elle = elle; }
  }
  function etiketle(kanal, katId) {
    const once = kanalAnlikGoruntu(kanal);
    kanalEtiketiUygula(kanal, katId);
    geriKaydet(t("g_kanalEtiketi"), () => { kanalGeriYukle(kanal, once); ciz(); }, () => { kanalEtiketiUygula(kanal, katId); ciz(); });
    ciz();
    const kat = katId ? katBul(katId) : null;
    bildir(kat ? t("kanalArtik", kanal, kat.ad) : t("kanalKaldirildi", kanal), { geriAl: true });
  }
  async function kanalEtiketiModal(kanal) {
    if (!kanal) return;
    const mevcut = ayar.kanal[kanalAnahtari(kanal)] || null;
    const ornek = D.videolar.find((v) => kanalAnahtari(v.kanal) === kanalAnahtari(kanal));
    let secim = mevcut || (ornek ? ornek.kategori : "misc");
    const secimKutusu = h("div", { class: "secim", role: "group", "aria-label": t("kategori") });
    const ciz_ = () => {
      doldur(secimKutusu, ayar.kategoriler.map((k) => h("button", { type: "button", class: "cip", style: renkDegiskenleri(k.renk), "aria-pressed": String(secim === k.id), onclick: () => { secim = k.id; ciz_(); } }, ikon(k.ikon), k.ad)));
    };
    ciz_();
    const sayi = D.videolar.filter((v) => kanalAnahtari(v.kanal) === kanalAnahtari(kanal)).length;
    const dugmeler = [{ ad: t("vazgec"), deger: null }];
    if (mevcut) dugmeler.push({ ad: t("etiketiKaldir"), tur: "tehlike", ikon: "x", deger: "__kaldir" });
    dugmeler.push({ ad: t("etiketiKaydet"), tur: "ana", ikon: "check", deger: "__kaydet", odak: true });
    const r = await modalAc({
      baslik: t("kanaliEtiketle"),
      icerik: h("div", { style: "display:flex;flex-direction:column;gap:12px" },
        h("p", null, h("strong", null, kanal)),
        h("p", null, t("kanalAcik", sayi)),
        secimKutusu, not(t("etiketKalici"))),
      dugmeler,
    });
    if (r === "__kaydet") etiketle(kanal, secim);
    else if (r === "__kaldir") etiketle(kanal, null);
  }
  function kategoriEkle(k) {
    ayar.kategoriler.splice(Math.max(0, ayar.kategoriler.length - 1), 0, k); // Misc sonda kalsın
    ayarKaydet(); ciz();
    geriKaydet(t("g_katEkleme"), () => { kategoriKaldir(k.id); ciz(); }, () => { ayar.kategoriler.splice(ayar.kategoriler.length - 1, 0, k); ayarKaydet(); ciz(); });
    bildir(t("katEklendi", k.ad));
  }
  function kategoriKaldir(id) {
    ayar.kategoriler = ayar.kategoriler.filter((k) => k.id !== id);
    for (const [kanal, kat] of Object.entries(ayar.kanal)) if (kat === id) delete ayar.kanal[kanal];
    ayarKaydet();
    for (const v of D.videolar) if (v.kategori === id) { v.kategori = kategoriTahmin(v.baslik, v.kanal); v.elle = false; }
    if (D.filtre === id) D.filtre = null;
  }
  function kategoriSil(k) {
    if (k.id === "misc") return;
    const once = { kategoriler: ayar.kategoriler.map((x) => ({ ...x })), kanal: { ...ayar.kanal }, videolar: D.videolar.map((v) => [v, v.kategori, v.elle]) };
    kategoriKaldir(k.id);
    ciz();
    const geri = () => { ayar.kategoriler = once.kategoriler.map((x) => ({ ...x })); ayar.kanal = { ...once.kanal }; ayarKaydet(); for (const [v, kat, elle] of once.videolar) { v.kategori = kat; v.elle = elle; } ciz(); };
    geriKaydet(t("g_katSilme", k.ad), geri, () => { kategoriKaldir(k.id); ciz(); });
    bildir(t("katSilindi", k.ad), { geriAl: true });
  }
  async function kategoriGuncelle(k, yeni, youtubeAdi) {
    const eski = { ad: k.ad, ikon: k.ikon, renk: k.renk };
    const o = onek();
    let ytListe = null;
    if (youtubeAdi && eski.ad !== yeni.ad && D.mesgul) bildir(t("ytAdMesgul"));
    else if (youtubeAdi && eski.ad !== yeni.ad && panelAcikMi()) {
      const islem = islemBaslat(t("katAraniyor", o, eski.ad));
      try {
        const listeler = await kullaniciListeleri(D.videolar[0] && D.videolar[0].vid);
        const eslesen = listeler.filter((l) => adEsit(l.ad, o + eski.ad));
        if (!eslesen.length) islem.bitir(t("ytBulunamadi", o, eski.ad), "uyari");
        else {
          for (const l of eslesen) await listeAdiDegistir(l.id, o + yeni.ad);
          ytListe = eslesen;
          islem.bitir(t("ytAdDegisti", eslesen.length, o, yeni.ad));
        }
      } catch (e) {
        islem.bitir(t("ytAdHata", kullaniciMesaji(e), o, eski.ad), "hata");
        log("hata", "liste adı", e);
      }
    }
    Object.assign(k, yeni); ayarKaydet(); ciz();
    const kid = k.id;
    geriKaydet(t("g_katDuzenleme"), async () => {
      const x = katBul(kid); if (x) Object.assign(x, eski); ayarKaydet(); ciz();
      if (ytListe) for (const l of ytListe) await listeAdiDegistir(l.id, o + eski.ad);
    }, async () => {
      const x = katBul(kid); if (x) Object.assign(x, yeni); ayarKaydet(); ciz();
      if (ytListe) for (const l of ytListe) await listeAdiDegistir(l.id, o + yeni.ad);
    });
  }

  // ─── Dosya indirme ───
  function dosyaIndir(ad, veri) {
    const blob = new Blob([JSON.stringify(veri, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = h("a", { href: url, download: ad });
    (acikModal() || UI.sar).append(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 5000);
  }
  function videolariIndir() {
    if (!D.videolar.length) return bildir(t("indirilecekYok"));
    const veri = {
      uygulama: UYG.ad, surum: UYG.surum, tarih: damga(), liste: { id: D.listeId, ad: D.listeAdi },
      kategoriler: ayar.kategoriler.map((k) => ({
        kategori: k.ad,
        videolar: D.videolar.filter((v) => v.kategori === k.id).map((v) => ({ baslik: v.baslik, kanal: v.kanal, videoId: v.vid, sure: sureYaz(v.sure), secili: v.secili, url: `https://www.youtube.com/watch?v=${v.vid}` })),
      })).filter((g) => g.videolar.length),
    };
    dosyaIndir(`wlo-videolar-${damga()}.json`, veri);
    bildir(t("jsonIndirildi", D.videolar.length));
  }
  function gunluguIndir() {
    dosyaIndir(`wlo-gunluk-${damga()}.json`, { uygulama: UYG.ad, surum: UYG.surum, tarayici: navigator.userAgent, istemci: istemciSurumu(), ytcfg: !!ytcfg("INNERTUBE_CLIENT_VERSION"), sadeKip, istekYollari: FETCH_YOLLARI.map((y) => y[0]), istekYolu: FETCH_YOLLARI[fetchSira][0], tani: taniSatirlari(), satirlar: gunluk });
    bildir(t("gunlukIndirildi"));
  }

  // ─── İşlemler: listeden çıkar ───
  async function cikar(videolar, islem) {
    const kimlikli = videolar.filter((v) => v.setId);
    if (kimlikli.length < videolar.length) islem && islem.satir("uyari", t("kimliksiz", videolar.length - kimlikli.length));
    const r = await videolariCikarApi(D.listeId, kimlikli.map((v) => v.setId), islem);
    const tamam = new Set(r.basarili);
    const cikanlar = kimlikli.filter((v) => tamam.has(v.setId));
    const silinen = new Set(cikanlar);
    D.videolar = D.videolar.filter((v) => !silinen.has(v));
    return { cikanlar, hatali: r.hatali.length + (videolar.length - kimlikli.length) };
  }
  async function videolariCikar(videolar, { tek } = {}) {
    if (D.mesgul) return bildir(t("islemSuruyor"));
    if (!videolar.length) return;
    const listeId = D.listeId;
    const islem = islemBaslat(tek ? t("cikariliyorTek") : t("cikariliyor", videolar.length));
    try {
      const { cikanlar, hatali } = await cikar(videolar, islem);
      ciz();
      islem.bitir(`${t("cikarildi", cikanlar.length)}${hatali ? t("cikarilamadi", hatali) : ""}${D.iptal ? t("durduruldu") : ""}`, hatali ? "uyari" : "ok");
      if (tek) UI.islem.hidden = true;
      if (cikanlar.length) {
        const vidler = cikanlar.map((v) => v.vid);
        geriKaydet(t("g_cikarma", cikanlar.length), async () => {
          if (D.listeId !== listeId) throw new KullaniciHatasi(t("baskaListe"));
          const is = islemBaslat(t("geriEkleniyor"));
          const r = await videolariEkle(listeId, vidler, is);
          is.bitir(t("geriEklendi", r.basarili.length));
          await yukle();
        }, async () => {
          const hedef = D.videolar.filter((v) => vidler.includes(v.vid));
          const is = islemBaslat(t("yenidenCikariliyor"));
          const r = await cikar(hedef, is);
          ciz(); is.bitir(t("cikarildi", r.cikanlar.length));
        });
        bildir(t("cikarildi", cikanlar.length), { geriAl: true });
      }
    } catch (e) {
      islem.bitir(kullaniciMesaji(e), "hata"); log("hata", "çıkarma", e);
    }
  }
  async function seciliCikar() {
    const secili = D.videolar.filter((v) => v.secili);
    if (!secili.length) return bildir(t("seciliYokCikar"));
    if (secili.length > 1) {
      const ok = await onayla(t("cikarOnayBaslik"), [
        h("p", null, t("cikarOnay", secili.length)),
        not(t("cikarGeriNot", ayar.kisayollar.geri)),
      ], t("cikarBtn", secili.length), "tehlike", "trash-2");
      if (!ok) return;
    }
    videolariCikar(secili);
  }
  async function watchLaterBosalt() {
    if (D.listeId !== "WL") return;
    if (D.mesgul) return bildir(t("islemSuruyorKisa"));
    if (!D.videolar.length) return bildir(t("wlZatenBos"));
    const ok = await onayla(t("bosaltBaslik"), [
      h("p", null, t("bosaltMetin", D.videolar.length)),
      not(t("bosaltOnce"), "uyari"),
      not(t("bosaltGeri", ayar.kisayollar.geri)),
    ], t("bosaltBtn", D.videolar.length), "tehlike", "trash-2");
    if (ok) videolariCikar([...D.videolar]);
  }

  // ─── İşlemler: taşı / kopyala ───
  async function seciliTasi() {
    if (D.mesgul) return bildir(t("islemSuruyor"));
    const secili = D.videolar.filter((v) => v.secili);
    if (!secili.length) return bildir(t("seciliYokTasi"));
    const tasi = D.listeId === "WL";
    const kaynakId = D.listeId;
    const o = onek();
    const gorunurlukAdi = () => t(`gor_${ayar.gorunurluk}`).toLocaleLowerCase(DIL === "tr" ? "tr" : "en");
    const hazirlik = islemBaslat(t("hedefKontrol"));
    let listeler;
    try { listeler = await kullaniciListeleri(secili[0].vid); }
    catch (e) { hazirlik.bitir(kullaniciMesaji(e), "hata"); return; }
    hazirlik.bitir(t("nListeBulundu", listeler.length), "bilgi");
    const plan = ayar.kategoriler.map((k) => {
      const videolar = secili.filter((v) => v.kategori === k.id);
      const ad = o + k.ad;
      const eslesen = listeler.filter((l) => adEsit(l.ad, ad));
      return { k, ad, videolar, adaylar: eslesen, hedef: eslesen[0] || null, cift: eslesen.length };
    }).filter((p) => p.videolar.length);
    const ciftVar = plan.some((p) => p.cift > 1);
    const ok = await onayla(tasi ? t("tasiOnayBaslik", secili.length) : t("kopyaOnayBaslik", secili.length), [
      h("table", { class: "tablo" },
        h("thead", null, h("tr", null, h("th", null, t("kategori")), h("th", null, t("th_video")), h("th", null, t("th_hedef")))),
        h("tbody", null, plan.map((p) => h("tr", null,
          h("td", null, h("span", { class: "etiket-dolu", style: renkDegiskenleri(p.k.renk) }, ikon(p.k.ikon), p.k.ad)),
          h("td", { class: "sayi" }, p.videolar.length),
          h("td", null, p.hedef
            ? h("span", { class: `durum ${p.cift > 1 ? "uyari" : "ok"}` }, ikon(p.cift > 1 ? "triangle-alert" : "circle-check"), p.cift > 1 ? t("hedefCift", p.cift) : `${t("hedefVar")}${p.hedef.sayi != null ? ` · ${t("nVideo", p.hedef.sayi)}` : ""}`)
            : h("span", { class: "durum yeni" }, ikon("plus"), t("hedefYeni", gorunurlukAdi()))))))),
      tasi ? not(t("tasiNot")) : not(t("kopyaNot")),
      not(t("zatenVarNot")),
      ciftVar ? not(t("ciftNot"), "uyari") : null,
      secili.length < D.videolar.length ? not(t("kalanNot", D.videolar.length - secili.length)) : null,
    ], tasi ? t("tasiBtn", secili.length) : t("kopyalaBtn", secili.length), "ana", "folder-input");
    if (!ok) { UI.islem.hidden = true; return; }

    const islem = islemBaslat(tasi ? t("tasiniyor") : t("kopyalaniyor"));
    let eklenen = 0, atlanan = 0, cikarilan = 0, sorun = 0;
    try {
      for (let i = 0; i < plan.length; i++) {
        if (D.iptal) break;
        const p = plan[i];
        islem.adim(`${p.ad} (${i + 1}/${plan.length})`, i / plan.length);
        try {
          let hedefId = null;
          let mevcut = new Set();
          if (p.adaylar.length) {
            // Aynı adda birden çok liste varsa en çok videosu olan kullanılır.
            let secilen = null;
            for (const a of p.adaylar) {
              const ogeler = (await listeOku(a.id)).ogeler;
              if (!secilen || ogeler.length > secilen.o.length) secilen = { a, o: ogeler };
            }
            hedefId = secilen.a.id;
            mevcut = new Set(secilen.o.map((x) => x.vid));
            islem.satir(p.cift > 1 ? "uyari" : "bilgi", t("varOlanKullan", p.ad, mevcut.size, p.cift));
          } else {
            hedefId = await listeOlustur(p.ad);
            listeler.push({ id: hedefId, ad: p.ad, sayi: 0 });
            islem.satir("ok", t("yeniListeOlustu", p.ad, gorunurlukAdi()));
          }
          const eklenecek = [...new Set(p.videolar.filter((v) => !mevcut.has(v.vid)).map((v) => v.vid))];
          atlanan += p.videolar.length - eklenecek.length;
          if (eklenecek.length) await videolariEkle(hedefId, eklenecek, islem);
          await bekle(800);
          const son = new Set((await listeOku(hedefId)).ogeler.map((x) => x.vid));
          const dogrulanan = p.videolar.filter((v) => son.has(v.vid));
          const eksik = p.videolar.length - dogrulanan.length;
          eklenen += eklenecek.filter((v) => son.has(v)).length;
          if (eksik) { sorun += eksik; islem.satir("uyari", t("hedefteGorunmuyor", p.ad, eksik)); }
          if (tasi && dogrulanan.length) {
            const r = await cikar(dogrulanan, islem);
            cikarilan += r.cikanlar.length; sorun += r.hatali;
            islem.satir(r.hatali ? "uyari" : "ok", t("tasindiSatir", p.ad, dogrulanan.length, r.cikanlar.length));
          } else {
            islem.satir("ok", t("hedefteSatir", p.ad, dogrulanan.length));
          }
        } catch (e) {
          sorun += p.videolar.length;
          islem.satir("hata", `${p.ad}: ${kullaniciMesaji(e)}`);
          log("hata", `taşıma ${p.ad}`, e);
        }
      }
      const ozet = tasi
        ? `${t("tasiOzet", cikarilan, eklenen, atlanan)}${sorun ? t("tasiSorun", sorun) : ""}${D.iptal ? t("durduruldu") : ""}`
        : `${t("kopyaOzet", eklenen, atlanan)}${sorun ? t("kopyaSorun", sorun) : ""}${D.iptal ? t("durduruldu") : ""}`;
      islem.bitir(ozet, sorun ? "uyari" : "ok");
    } catch (e) {
      islem.bitir(kullaniciMesaji(e), "hata"); log("hata", "taşıma", e);
    }
    if (D.listeId === kaynakId) ciz();
  }

  // ─── İşlemler: çift listeleri birleştir ───
  async function ciftleriBirlestir() {
    if (D.mesgul) return bildir(t("islemSuruyor"));
    const o = onek().trim();
    const islem = islemBaslat(t("ciftAraniyor"));
    let gruplar = [];
    try {
      const listeler = await kullaniciListeleri(D.videolar[0] && D.videolar[0].vid);
      const harita = new Map();
      // Yalnız bu uygulamanın açtığı adlar: "önek + kategori adı". Kullanıcının kendi listeleri önekle başlasa da karışmaz.
      const katAdlari = ayar.kategoriler.map((k) => onek() + k.ad);
      for (const l of listeler) {
        if (!katAdlari.some((ad) => adEsit(l.ad, ad))) continue;
        const anahtar = l.ad.normalize("NFC").replace(/\s+/g, " ").trim();
        if (!harita.has(anahtar)) harita.set(anahtar, []);
        harita.get(anahtar).push(l);
      }
      gruplar = [...harita.entries()].filter(([, l]) => l.length > 1).map(([ad, l]) => ({ ad, listeler: l }));
      if (!gruplar.length) { islem.bitir(t("ciftYok", o)); return; }
      for (const g of gruplar) {
        for (const l of g.listeler) {
          islem.adim(t("okunuyorAd", g.ad), null);
          const r = await listeOku(l.id);
          l.ogeler = r.ogeler; l.tam = r.tam; l.gizli = r.gizli || 0;
        }
        g.listeler.sort((a, b) => b.ogeler.length - a.ogeler.length);
        g.tutulan = g.listeler[0];
        const tutSet = new Set(g.tutulan.ogeler.map((x) => x.vid));
        g.eksik = [...new Set(g.listeler.slice(1).flatMap((l) => l.ogeler.map((x) => x.vid)).filter((v) => !tutSet.has(v)))];
      }
      islem.bitir(t("ciftBulundu", gruplar.length), "bilgi");
    } catch (e) { islem.bitir(kullaniciMesaji(e), "hata"); log("hata", "çift arama", e); return; }

    const sil = h("input", { type: "checkbox", checked: true });
    const ok = await onayla(t("m_birlestir"), [
      h("table", { class: "tablo" },
        h("thead", null, h("tr", null, h("th", null, t("th_listeAdi")), h("th", null, t("th_tutulan")), h("th", null, t("th_ciftler")), h("th", null, t("th_eklenecek")))),
        h("tbody", null, gruplar.map((g) => h("tr", null,
          h("td", null, g.ad),
          h("td", { class: "sayi" }, t("nVideo", g.tutulan.ogeler.length)),
          h("td", { class: "sayi" }, g.listeler.slice(1).map((l) => `${l.ogeler.length}`).join(" + ")),
          h("td", { class: "sayi" }, g.eksik.length))))),
      not(t("birlestirNot")),
      gruplar.some((g) => g.listeler.slice(1).some((l) => l.gizli)) ? not(t("gizliCiftNot"), "uyari") : null,
      h("label", { class: "onay" }, sil, h("span", null, t("ciftleriSil"))),
      not(t("silGeriAlinmaz"), "uyari"),
    ], t("birlestir"), "ana", "merge");
    if (!ok) { UI.islem.hidden = true; return; }
    const silinsin = sil.checked;

    const is = islemBaslat(t("birlestiriliyor"));
    let eklenen = 0, silinen = 0, kalan = 0;
    try {
      for (let i = 0; i < gruplar.length; i++) {
        if (D.iptal) break;
        const g = gruplar[i];
        is.adim(`${g.ad} (${i + 1}/${gruplar.length})`, i / gruplar.length);
        try {
          if (g.eksik.length) { const r = await videolariEkle(g.tutulan.id, g.eksik, is); eklenen += r.basarili.length; }
          await bekle(800);
          const son = new Set((await listeOku(g.tutulan.id)).ogeler.map((x) => x.vid));
          for (const l of g.listeler.slice(1)) {
            const dogru = l.tam && l.ogeler.every((x) => son.has(x.vid));
            if (silinsin && dogru) { await listeSil(l.id); silinen++; is.satir("ok", t("ciftSilindi", g.ad, l.ogeler.length)); }
            else if (silinsin && !l.tam) { kalan++; is.satir("uyari", t("ciftTamDegil", g.ad)); }
            else if (silinsin) { kalan++; is.satir("uyari", t("ciftDogrulanamadi", g.ad)); }
            else { kalan++; is.satir("ok", t("ciftDuruyor", g.ad)); }
          }
        } catch (e) { is.satir("hata", `${g.ad}: ${kullaniciMesaji(e)}`); log("hata", "birleştirme", e); }
      }
      is.bitir(`${t("birlestirOzet", gruplar.length, eklenen, silinen)}${kalan ? t("birlestirKalan", kalan) : ""}${D.iptal ? t("durduruldu") : ""}`, kalan && silinsin ? "uyari" : "ok");
    } catch (e) { is.bitir(kullaniciMesaji(e), "hata"); }
  }

  // ─── Sayfa takibi (YouTube tek sayfa uygulamasıdır) ───
  function sayfaDegisti() {
    const id = listeSayfasi();
    if (!id) { tetikGizle(); if (panelAcikMi()) panelKapat(); return; }
    if (D.listeId && D.listeId !== id) {
      if (panelAcikMi()) panelKapat();
      if (!D.mesgul) { D.videolar = []; D.listeId = null; D.filtre = null; D.arama = ""; D.geri.length = 0; D.ileri.length = 0; if (UI.arama) UI.arama.value = ""; }
    }
    tetikGoster();
  }
  function baslat() {
    log("bilgi", `başladı ${UYG.surum} · ${location.pathname}${location.search} · dil ${DIL} · istek yolları: ${FETCH_YOLLARI.map((y) => y[0]).join(", ")}`);
    sayfaDegisti();
    document.addEventListener("yt-navigate-finish", sayfaDegisti);
    window.addEventListener("popstate", () => setTimeout(sayfaDegisti, 300));
    let sonAdres = location.href;
    setInterval(() => { if (location.href !== sonAdres) { sonAdres = location.href; sayfaDegisti(); } }, 1000);
    gmMenuKaydet();
  }
  baslat();
})();
