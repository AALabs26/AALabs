  // TOKEN-BASLA — aalabs-tema.css 1.4.1 kopyası (denetle.py bu blokta sabit rengi saymaz)
  const TOKEN_CSS = `
:host{all:initial;
  --yazi:"Open Sans","Segoe UI",Roboto,sans-serif;
  --kose-s:2px;--kose-m:4px;--kose-l:6px;
  --ana:#2456D6;--ana-ustu:#3A67DA;--ana-basili:#204CBD;--ana-acik:#E5EBFA;--ana-hover:#F2F5FD;--ana-uzeri:#FFFFFF;
  --vurgu:#2456D6;--zemin:#F6F9FC;--yuzey:#FFFFFF;--metin:#17252E;--metin-ikincil:#4E6269;--kenar:#7A9199;--ayirici:#D3DEE6;
  --basari:#18763F;--basari-bg:#E4F5E8;--uyari:#9A5B00;--uyari-bg:#FDF6D8;--hata:#C4313B;--hata-bg:#FDE8E8;
  --kat-belge:#6237C8;--kat-tablo:#1D7A3A;--kat-gorsel:#B0256C;--kat-kod:#2453C7;--kat-video:#A8500F;--kat-arsiv:#7A5A00;--kat-onemli:#B4232B;--kat-oyun:#0B6E78;
  color-scheme:light}
:host([data-theme="dark"]){
  --ana-acik:#1D2C4F;--ana-hover:#1B2434;--vurgu:#86A8FF;--zemin:#0F1520;--yuzey:#161E2B;--metin:#E6ECF5;--metin-ikincil:#9AA8BC;--kenar:#6A7B93;--ayirici:#263142;
  --basari:#4CC38A;--basari-bg:#13301F;--uyari:#E8AC45;--uyari-bg:#33270F;--hata:#FF8189;--hata-bg:#3A161A;
  color-scheme:dark}
`;
  // TOKEN-BITIR

  const BILESEN_CSS = `
:host{--o:1}
*{box-sizing:border-box}
.kok,.kok *{font-family:var(--yazi)}
.kok{font-size:14px;line-height:1.35;color:var(--metin)}
button,input,select,textarea{font:inherit;color:inherit;margin:0}
svg{flex:none;width:16px;height:16px}
:focus-visible{outline:2px solid var(--vurgu);outline-offset:2px}
[hidden]{display:none!important}
.kisayol{font-weight:700;font-style:normal}
.kisayol.rakam{font-style:italic}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}

.tetik{position:fixed;right:24px;bottom:24px;z-index:2147482000;height:40px;padding:0 16px;display:inline-flex;align-items:center;gap:8px;
  background:var(--ana);color:var(--ana-uzeri);border:1px solid var(--ana);border-radius:var(--kose-s);cursor:pointer;font-size:14px;transition:background-color 120ms}
.tetik:hover{background:var(--ana-ustu)}.tetik:active{background:var(--ana-basili)}
.tetik:focus-visible{background:var(--ana-acik);color:var(--vurgu);border-color:var(--vurgu)}
.tetik svg{width:18px;height:18px}
.tetik .nokta{margin-left:0;outline:2px solid var(--ana-uzeri)}

.panel{position:fixed;inset:0;z-index:2147482500;background:var(--zemin);color:var(--metin);display:flex;flex-direction:column}
.panel.resimsiz .kucukresim{display:none}
.ust{display:flex;align-items:center;gap:12px;padding:8px 16px;background:var(--yuzey);border-bottom:1px solid var(--ayirici);flex-wrap:wrap}
.logo{width:32px;height:32px;border-radius:var(--kose-l);background:var(--ana);color:var(--ana-uzeri);display:grid;place-items:center;font-weight:600;font-size:11px;flex:none}
.logo.buyuk{width:44px;height:44px;font-size:13px}
.baslik{font-size:15px;font-weight:600;white-space:nowrap}
.alt-baslik{font-size:12px;color:var(--metin-ikincil);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:50vw}
.esnek{flex:1}
.arac{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.dikey{width:1px;height:24px;background:var(--ayirici)}

.btn{height:32px;padding:0 12px;display:inline-flex;align-items:center;gap:6px;border:1px solid var(--kenar);background:var(--yuzey);color:var(--metin);
  border-radius:var(--kose-s);cursor:pointer;white-space:nowrap;font-size:14px;transition:background-color 120ms,color 120ms}
.btn svg{width:16px;height:16px;color:var(--vurgu)}
.btn:hover{background:var(--ana-hover)}
.btn:active{background:var(--ana-acik)}
.btn[disabled]{opacity:.55;cursor:not-allowed}
.btn.ana{background:var(--ana);border-color:var(--ana);color:var(--ana-uzeri)}
.btn.ana svg{color:var(--ana-uzeri)}
.btn.ana:hover{background:var(--ana-ustu)}.btn.ana:active{background:var(--ana-basili)}
.btn.ana:focus-visible{background:var(--ana-acik);color:var(--vurgu);border-color:var(--vurgu)}
.btn.ana:focus-visible svg{color:var(--vurgu)}
.btn.tehlike{color:var(--hata);border-color:var(--hata)}
.btn.tehlike svg{color:var(--hata)}
.btn.tehlike:hover{background:var(--hata-bg)}
.btn.ikon{width:32px;padding:0;justify-content:center}
.btn.hayalet{border-color:transparent;background:transparent}
.btn.hayalet:hover{background:var(--ana-hover)}
.btn.kucuk{height:24px;padding:0 8px;font-size:12px}
.btn.kucuk.ikon{width:24px;padding:0}
.btn .nokta{margin-left:0}

.filtre{display:flex;gap:8px;align-items:center;padding:8px 16px;flex-wrap:wrap}
.arama{position:relative;flex:1 1 240px;max-width:420px}
.arama svg{position:absolute;left:8px;top:8px;width:16px;height:16px;color:var(--metin-ikincil);pointer-events:none}
.girdi{height:32px;width:100%;padding:0 8px;border:1px solid var(--kenar);border-radius:var(--kose-s);background:var(--yuzey);color:var(--metin);font-size:14px}
.arama .girdi{padding-left:30px}
.girdi::placeholder{color:var(--metin-ikincil);opacity:1}
.segment{display:inline-flex;border:1px solid var(--kenar);border-radius:var(--kose-s);overflow:hidden;flex:none}
.segment button{height:30px;padding:0 10px;border:0;border-right:1px solid var(--kenar);background:var(--yuzey);color:var(--metin);cursor:pointer;font-size:13px}
.segment button:last-child{border-right:0}
.segment button:hover{background:var(--ana-hover)}
.segment button[aria-pressed="true"]{background:var(--ana);color:var(--ana-uzeri)}
.segment.iki-satir button{height:auto;min-height:30px;padding:4px 12px;line-height:1.25}
.segment small{display:block;font-size:11px}

.cipler{display:flex;gap:6px;flex-wrap:wrap;padding:0 16px 8px}
.cip{height:28px;display:inline-flex;align-items:center;gap:6px;padding:0 10px;border-radius:var(--kose-m);border:1px solid var(--kenar);background:var(--yuzey);color:var(--metin);cursor:pointer;font-size:12px}
.cip svg{width:14px;height:14px;color:var(--k,var(--vurgu))}
.cip .sayi{color:var(--metin-ikincil)}
.cip:hover{background:var(--ana-hover)}
.cip[aria-pressed="true"]{background:var(--k,var(--ana));border-color:var(--k,var(--ana));color:var(--k-yazi,var(--ana-uzeri))}
.cip[aria-pressed="true"] svg,.cip[aria-pressed="true"] .sayi{color:var(--k-yazi,var(--ana-uzeri))}
.etiket-dolu{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 8px;border-radius:var(--kose-m);background:var(--k);color:var(--k-yazi);font-size:12px}
.etiket-dolu svg{width:14px;height:14px}

.liste{flex:1;overflow:auto;padding:0 8px 8px;scrollbar-width:thin;scrollbar-color:var(--kenar) transparent;outline-offset:-2px}
.satir{display:flex;align-items:center;gap:10px;min-height:48px;padding:4px 8px;border-bottom:1px solid var(--ayirici);content-visibility:auto;contain-intrinsic-size:auto 48px;cursor:default}
.satir:hover{background:var(--ana-hover)}
.satir.imlec{background:var(--ana);color:var(--ana-uzeri)}
.satir.imlec .ikincil,.satir.imlec .sure,.satir.imlec .sira{color:var(--ana-uzeri)}
.satir.imlec .etiketbtn{color:var(--ana-uzeri);border-color:var(--ana-uzeri)}
.satir.imlec select.kat{outline:1px solid var(--ana-uzeri)}
.satir.imlec .btn.hayalet svg{color:var(--ana-uzeri)}
.satir.disarida .soluk{opacity:.55}
.chk{width:18px;height:18px;accent-color:var(--ana);cursor:pointer;flex:none}
.sira{width:32px;text-align:right;font-size:12px;color:var(--metin-ikincil);font-variant-numeric:tabular-nums;flex:none}
.kucukresim{width:64px;height:36px;border-radius:var(--kose-s);object-fit:cover;background:var(--ayirici);flex:none}
.bilgi{flex:1;min-width:0}
.vbaslik{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;background:none;border:0;padding:0;text-align:left;width:100%;display:block}
.vbaslik:hover{text-decoration:underline}
.kanalsatir{display:flex;gap:6px;align-items:center;font-size:12px;min-width:0;margin-top:2px}
.ikincil{color:var(--metin-ikincil);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.etiketbtn{height:20px;padding:0 6px;font-size:11px;border:1px dashed var(--kenar);border-radius:var(--kose-s);background:transparent;color:var(--metin-ikincil);cursor:pointer;display:inline-flex;gap:4px;align-items:center;flex:none}
.etiketbtn svg{width:12px;height:12px}
.etiketbtn.etiketli{border-style:solid}
.sure{font-variant-numeric:tabular-nums;font-size:12px;min-width:56px;text-align:right;color:var(--metin-ikincil);flex:none}
select.kat{height:28px;width:150px;border-radius:var(--kose-m);border:1px solid var(--k);background:var(--k);color:var(--k-yazi);padding:0 6px;font-size:12px;cursor:pointer;flex:none}
select.kat option,select.girdi option{background:var(--yuzey);color:var(--metin)}
.uyari-rozet{font-size:11px;color:var(--uyari);display:inline-flex;gap:3px;align-items:center}
.uyari-rozet svg{width:12px;height:12px}

.bos{margin:48px auto;max-width:440px;text-align:center;display:flex;flex-direction:column;gap:8px;align-items:center;color:var(--metin)}
.bos h3{margin:0;font-size:15px;font-weight:600}
.bos p{margin:0;color:var(--metin-ikincil)}
.bos>svg{width:32px;height:32px;color:var(--vurgu)}
.donuyor{animation:don 1s linear infinite}
@keyframes don{to{transform:rotate(360deg)}}

.islem{border-top:1px solid var(--ayirici);background:var(--yuzey);padding:8px 16px;display:flex;flex-direction:column;gap:6px;max-height:32vh}
.islem-ust{display:flex;align-items:center;gap:8px}
.islem-baslik{font-weight:600;font-size:13px}
.ilerleme{height:6px;background:var(--ayirici);border-radius:var(--kose-s);overflow:hidden}
.ilerleme>div{height:100%;background:var(--ana);width:0;transition:width 120ms}
.gunluk{overflow:auto;font-size:12px;display:flex;flex-direction:column;gap:2px;scrollbar-width:thin;scrollbar-color:var(--kenar) transparent}
.gsatir{display:flex;gap:6px;align-items:flex-start}
.gsatir svg{width:14px;height:14px;margin-top:1px}
.gsatir.ok svg{color:var(--basari)}.gsatir.uyari svg{color:var(--uyari)}.gsatir.hata svg{color:var(--hata)}.gsatir.bilgi svg{color:var(--vurgu)}

.alt{display:flex;align-items:center;gap:8px;padding:8px 16px;background:var(--yuzey);border-top:1px solid var(--ayirici);flex-wrap:wrap}
.alt-bilgi{font-size:12px;color:var(--metin-ikincil)}

dialog.modal{border:1px solid var(--kenar);border-radius:var(--kose-l);background:var(--yuzey);color:var(--metin);padding:0;width:min(560px,calc(100vw - 32px));max-height:calc(100vh - 48px)}
dialog.modal.genis{width:min(760px,calc(100vw - 32px))}
dialog.modal::backdrop,dialog.ayarlar::backdrop{background:color-mix(in srgb,var(--zemin,transparent) 80%,transparent)}
.modal-ic{padding:16px;display:flex;flex-direction:column;gap:12px;overflow:auto;max-height:calc(100vh - 170px)}
.modal h2{margin:0;font-size:15px;font-weight:600}
.modal p{margin:0}
.modal-alt{display:flex;justify-content:flex-end;gap:8px;padding:12px 16px;border-top:1px solid var(--ayirici);flex-wrap:wrap}
.alan{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--metin-ikincil)}
.alan-hata{color:var(--hata);font-size:12px;display:flex;gap:4px;align-items:center}
.alan-hata svg{width:14px;height:14px}
.secim{display:flex;gap:6px;flex-wrap:wrap}
.secim .cip svg{width:16px;height:16px}
.ikonsec{width:32px;height:32px;display:grid;place-items:center;border:1px solid var(--kenar);border-radius:var(--kose-s);background:var(--yuzey);color:var(--metin);cursor:pointer}
.ikonsec svg{width:18px;height:18px}
.ikonsec:hover{background:var(--ana-hover)}
.ikonsec[aria-pressed="true"]{background:var(--ana-acik);border-color:var(--vurgu);color:var(--vurgu)}
.onay{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--metin);cursor:pointer}
.onay input{width:16px;height:16px;accent-color:var(--ana)}
.not{font-size:12px;color:var(--metin-ikincil);display:flex;gap:6px;align-items:flex-start}
.not svg{width:14px;height:14px;color:var(--vurgu);margin-top:1px}
.not.uyari svg{color:var(--uyari)}
.tablo{width:100%;border-collapse:collapse;font-size:13px;color:var(--metin)}
.tablo th,.tablo td{padding:6px;border-bottom:1px solid var(--ayirici);text-align:left;vertical-align:middle;color:inherit}
.tablo th{font-weight:600;color:var(--metin-ikincil);font-size:12px}
.tablo td.sayi{text-align:right;font-variant-numeric:tabular-nums}
.tablo td.sag,.tablo th.sag{text-align:right}
.tablo td.ikinci{color:var(--metin-ikincil);overflow-wrap:anywhere}
.durum{display:inline-flex;gap:4px;align-items:center}
.durum svg{width:14px;height:14px}
.durum.ok svg{color:var(--basari)}.durum.yeni svg{color:var(--vurgu)}.durum.uyari svg{color:var(--uyari)}.durum.hata svg{color:var(--hata)}.durum.bilgi svg{color:var(--metin-ikincil)}
.katsatir{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--ayirici)}
.kaydirma{overflow:auto;max-height:50vh;scrollbar-width:thin;scrollbar-color:var(--kenar) transparent}

.menu{position:fixed;z-index:2147482800;background:var(--yuzey);border:1px solid var(--kenar);border-radius:var(--kose-m);padding:4px;min-width:280px;display:flex;flex-direction:column}
.menu [role="menuitem"]{height:32px;display:flex;align-items:center;gap:8px;padding:0 10px;border:0;background:transparent;color:var(--metin);text-align:left;cursor:pointer;border-radius:var(--kose-s);font-size:14px;width:100%}
.menu [role="menuitem"] svg{width:16px;height:16px;color:var(--vurgu)}
.menu [role="menuitem"]:hover,.menu [role="menuitem"]:focus{background:var(--ana-acik);outline:none}
.menu .ayrac{height:1px;background:var(--ayirici);margin:4px 0}

.palet-liste{display:flex;flex-direction:column;max-height:50vh;overflow:auto}
.palet-liste [role="option"]{height:32px;display:flex;align-items:center;gap:8px;padding:0 10px;cursor:pointer;border-radius:var(--kose-s)}
.palet-liste [role="option"] svg{width:16px;height:16px;color:var(--vurgu)}
.palet-liste [role="option"][aria-selected="true"]{background:var(--ana-acik)}
.palet-liste .ipucu{margin-left:auto;font-size:12px;color:var(--metin-ikincil)}

.bildirim{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:2147482900;background:var(--metin);color:var(--yuzey);border-radius:var(--kose-m);padding:8px 12px;display:flex;gap:12px;align-items:center;max-width:calc(100vw - 32px);font-size:13px}
.bildirim .btn{height:28px;background:transparent;color:var(--yuzey);border-color:var(--yuzey)}
.bildirim .btn svg{color:var(--yuzey)}
.bildirim .btn:hover{background:transparent;text-decoration:underline}

/* Ortak Ayarlar penceresi (app-lab v02.01, maket A) */
dialog.ayarlar{border:1px solid var(--kenar);border-radius:var(--kose-l);background:var(--yuzey);color:var(--metin);padding:0;width:min(860px,calc(100vw - 32px));height:min(560px,calc(100vh - 48px));max-width:none;max-height:none;overflow:hidden}
dialog.ayarlar[open]{display:flex}
.gezinti{width:208px;flex:none;border-right:1px solid var(--ayirici);display:flex;flex-direction:column;gap:2px;padding:10px 8px;background:var(--zemin);overflow-y:auto;overflow-x:hidden;scrollbar-width:thin;scrollbar-color:var(--kenar) transparent}
.gezinti .arama{flex:none;max-width:none;margin-bottom:6px}
.g-baslik{font-size:11px;font-weight:600;color:var(--metin-ikincil);letter-spacing:.06em;padding:8px 8px 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.g-oge{height:30px;flex:none;display:flex;align-items:center;gap:8px;padding:0 8px;border:0;background:transparent;color:var(--metin);border-radius:var(--kose-s);cursor:pointer;text-align:left;font-size:13px;width:100%;min-width:0}
.g-oge .g-ad{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.g-oge svg{color:var(--vurgu)}
.g-oge:hover{background:var(--ana-hover)}
.g-oge[aria-current="page"]{background:var(--ana-acik)}
.nokta{width:8px;height:8px;border-radius:50%;background:var(--hata);flex:none;margin-left:auto}
.ay-icerik{flex:1;min-width:0;display:flex;flex-direction:column}
.ay-ust{display:flex;align-items:center;gap:8px;padding:12px 16px;border-bottom:1px solid var(--ayirici)}
.ay-ust h2{margin:0;font-size:15px;font-weight:600;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ay-govde{flex:1;overflow:auto;padding:14px 16px;display:flex;flex-direction:column;gap:14px;scrollbar-width:thin;scrollbar-color:var(--kenar) transparent}
.ay-alan{display:flex;flex-direction:column;gap:6px;align-items:flex-start}
.ay-alan .girdi{width:220px}
.ay-ad{font-size:12px;font-weight:600;color:var(--metin)}
.ay-not{font-size:12px;color:var(--metin-ikincil)}
.ay-hata{font-size:12px;color:var(--hata);display:flex;gap:4px;align-items:center}
.ay-hata svg{width:14px;height:14px}
.anahtar{display:inline-flex;align-items:center;gap:10px;border:0;background:transparent;color:var(--metin);font-size:13px;cursor:pointer;padding:2px 0;text-align:left}
.anahtar .iz{width:30px;height:16px;border-radius:8px;background:var(--kenar);position:relative;flex:none;transition:background-color 120ms}
.anahtar .iz::after{content:"";position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;background:var(--ana-uzeri);transition:left 120ms}
.anahtar[aria-checked="true"] .iz{background:var(--ana)}
.anahtar[aria-checked="true"] .iz::after{left:16px}
.tus{display:inline-block;padding:1px 6px;border:1px solid var(--kenar);border-radius:var(--kose-s);font-size:12px;background:var(--zemin);font-variant-numeric:tabular-nums;white-space:nowrap}
.tus.bekliyor{border-color:var(--vurgu);color:var(--vurgu)}
.kutu{border:1px solid var(--ayirici);border-radius:var(--kose-l);padding:10px 12px;display:flex;flex-direction:column;gap:8px;align-self:stretch}
.kutu.hata{border-color:var(--hata);background:var(--hata-bg)}
.kutu-baslik{font-weight:600;font-size:13px}
.rapor{width:100%;min-height:150px;padding:8px;border:1px solid var(--kenar);border-radius:var(--kose-s);background:var(--zemin);color:var(--metin);font-family:ui-monospace,Consolas,monospace;font-size:12px;resize:vertical}
.g-liste{display:flex;flex-direction:column;gap:2px;min-width:0}
.katsatir{flex-wrap:wrap}
@media (max-width:600px){dialog.ayarlar[open]{flex-direction:column}.gezinti{width:auto;flex-direction:row;align-items:center;overflow-x:auto;overflow-y:hidden;border-right:0;border-bottom:1px solid var(--ayirici);padding:6px 8px}.gezinti .arama{flex:0 0 150px;margin:0 6px 0 0}.g-liste{flex-direction:row;align-items:center}.g-oge{width:auto}.g-baslik{padding:0 4px}}

@media (max-width:820px){.yazi-gizle{display:none}.kucukresim{display:none}.sira{display:none}select.kat{width:110px}}
`;
  // Ölçek (Ayarlar › Genel): 3 px ve üstü her ölçü --o ile çarpılır; 1–2 px kenarlar keskin kalır.
  function olcekliCss(css) {
    const carp = (s) => s.replace(/(^|[^\w.#-])(\d+(?:\.\d+)?)px/g, (m, on, n) => (Number(n) <= 2 ? m : `${on}calc(${n}px*var(--o))`));
    // @media başlığındaki kırılma noktası değişmez; içindeki kurallar ölçeklenir.
    return css.split("\n").map((s) => { if (!s.trimStart().startsWith("@media")) return carp(s); const i = s.indexOf("{"); return s.slice(0, i + 1) + carp(s.slice(i + 1)); }).join("\n");
  }
  const CSS = TOKEN_CSS + olcekliCss(BILESEN_CSS);

  // ─── Arayüz metinleri (Türkçe + İngilizce; anahtarlar iki dilde aynı) ───
  const cogul = (n, tek, cok) => (n === 1 ? tek : cok);
  const METIN = {
