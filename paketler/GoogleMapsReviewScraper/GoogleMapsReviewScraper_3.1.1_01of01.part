      kb5: 'After pressing Stop, did what was read so far download?', kb5i: 'Start a scrape, press "Stop and save" after 10 s. The downloaded file should have more than 0 reviews.',
      surum: 'Version {s}', store: 'Updated by AALabs App Store.',
      yedek: 'Settings backup', yedekle: 'Back up (file)', geriYukle: 'Restore (file)',
      sonYedek: 'Last backup: {t}', sonYedekYok: 'Last backup: none yet',
      yedekAc: "The backup writes this script's settings to one JSON file. Restoring applies them at once.",
      yedeklendi: 'Settings written to a file', geriYuklendi: 'Settings restored',
      yedekHata: "Couldn't read the file. Pick an AALabs Google Maps Review Scraper backup (.json).",
      menuAyarlar: 'Settings (A)', menuScrape: 'Scrape (S)', menuIpucu: 'Tampermonkey menu: Settings (A) · Scrape (S)',
      penAlt: 'Changes apply right away.',
    },
  };

  // ---------------------------------------------------------------- ayar deposu
  const VARSAYILAN = Object.freeze({
    sirala: true, hiz: 'normal', bekle: 15, ozgun: true, hd: true, bildir: true,
    dil: 'tarayici', tema: 'sayfa', olcek: 100,
    kisayolAyarlar: 'Ctrl+,', kisayolScrape: '', kisayolPanel: '',
    kucuk: false, sonYedek: '',
  });
  const SECENEK = { hiz: ['hizli', 'normal', 'yavas'], dil: ['tr', 'en', 'tarayici'], tema: ['sayfa', 'acik', 'koyu'], olcek: [90, 100, 115, 130] };
  const HIZ_MS = { hizli: 200, normal: 350, yavas: 700 };
  const KISAYOL_ANAHTAR = ['kisayolAyarlar', 'kisayolScrape', 'kisayolPanel'];
  const BOLUM_ANAHTAR = {
    scrape: ['sirala', 'hiz', 'bekle'], metinMedya: ['ozgun', 'hd'], dosya: ['bildir'],
    genel: ['dil', 'tema', 'olcek'], kisayol: KISAYOL_ANAHTAR,
  };
  const gmDepo = (() => { try { return typeof GM_getValue === 'function' && typeof GM_setValue === 'function'; } catch (_) { return false; } })();

  function ayarDogrula(ham) {
    const a = Object.assign({}, VARSAYILAN);
    if (!ham || typeof ham !== 'object' || Array.isArray(ham)) return a;
    for (const k of Object.keys(VARSAYILAN)) {
      if (!(k in ham)) continue;
      const v = ham[k];
      if (typeof VARSAYILAN[k] === 'boolean') { if (typeof v === 'boolean') a[k] = v; continue; }
      if (SECENEK[k]) { if (SECENEK[k].includes(v)) a[k] = v; continue; }
      if (k === 'bekle') { const n = Number(v); if (Number.isInteger(n) && n >= 3 && n <= 60) a[k] = n; continue; }
      if (KISAYOL_ANAHTAR.includes(k)) { if ((v === '' && k !== 'kisayolAyarlar') || (komboKanonikMi(v) && tusGecerliMi(v) === null)) a[k] = v; continue; }
      if (typeof v === 'string') a[k] = v.slice(0, 40);
    }
    // aynı tuş iki eylemde olamaz: sonradan geleni boşalt
    const gorulen = new Set();
    for (const k of KISAYOL_ANAHTAR) { if (!a[k]) continue; if (gorulen.has(a[k])) a[k] = ''; else gorulen.add(a[k]); }
    return a;
  }

  function depoOku(ad, yedek) {
    if (!gmDepo) return yedek;
    try { const ham = GM_getValue(ad, null); return ham === null || ham === undefined ? yedek : (typeof ham === 'string' ? JSON.parse(ham) : ham); } catch (_) { return yedek; }
  }
  function depoYaz(ad, deger) {
    if (!gmDepo) return;
    try { GM_setValue(ad, JSON.stringify(deger)); } catch (_) { /* depo yazılamadı; bellekte sürer */ }
  }
  function ayarYaz() { depoYaz('ayarlar', ayar); }

  // ---------------------------------------------------------------- kısayol kuralları
  const DEGISTIRICI = ['Ctrl', 'Alt', 'Shift', 'Meta'];
  const TARAYICI_YASAK = new Set(['Ctrl+T', 'Ctrl+W', 'Ctrl+N', 'Ctrl+L', 'Ctrl+R', 'Ctrl+F', 'Ctrl+P', 'Ctrl+S', 'Ctrl+D',
    'Ctrl+H', 'Ctrl+J', 'Ctrl+K', 'Ctrl+U', 'Ctrl+O', 'Ctrl+G', 'Ctrl+E', 'Ctrl+A', 'Ctrl+C', 'Ctrl+V', 'Ctrl+X', 'Ctrl+Z', 'Ctrl+Y',
    'Ctrl+Shift+T', 'Ctrl+Shift+N', 'Ctrl+Shift+W', 'Ctrl+Shift+I', 'Ctrl+Shift+J', 'Ctrl+Shift+C', 'Ctrl+Shift+Delete',
    'Ctrl+Shift+B', 'Ctrl+Shift+O', 'Ctrl+Shift+P', 'Ctrl+Shift+R', 'Ctrl+Tab', 'Ctrl+Shift+Tab', 'Ctrl+F4', 'Alt+F4',
    'Alt+D', 'Alt+E', 'Alt+F', 'Alt+Home', 'Alt+Left', 'Alt+Right', 'Ctrl+Plus', 'Ctrl+-', 'Ctrl+0', 'Ctrl+=',
    'Ctrl+1', 'Ctrl+2', 'Ctrl+3', 'Ctrl+4', 'Ctrl+5', 'Ctrl+6', 'Ctrl+7', 'Ctrl+8', 'Ctrl+9', 'Ctrl+Enter',
    // yazı düzenleme (Maps arama kutusunda kelime atlama/silme bozulmasın)
    'Ctrl+Left', 'Ctrl+Right', 'Ctrl+Up', 'Ctrl+Down', 'Ctrl+Home', 'Ctrl+End', 'Ctrl+Backspace', 'Ctrl+Delete',
    'Ctrl+Shift+Left', 'Ctrl+Shift+Right', 'Ctrl+Shift+Home', 'Ctrl+Shift+End', 'Ctrl+Shift+Z', 'Ctrl+Shift+V',
    // Firefox
    'Ctrl+B', 'Ctrl+I', 'Ctrl+M', 'Ctrl+Q', 'Ctrl+Shift+A', 'Ctrl+Shift+E', 'Ctrl+Shift+K', 'Ctrl+Shift+M', 'Ctrl+Shift+Y', 'Ctrl+Shift+H']);

  function tusAdi(e) {
    let k = e.key || '';
    const degistirici = e.ctrlKey || e.metaKey || e.altKey;
    if (k === ' ') return 'Space';
    if (k === '+') return 'Plus';
    if (k.startsWith('Arrow')) return k.slice(5);
    if (/^Key[A-Z]$/.test(e.code || '')) return e.code.slice(3);         // Türkçe klavyede I tuşu "ı" yazar
    if (/^Digit\d$/.test(e.code || '')) return e.code.slice(5);
    if (k.length === 1) return degistirici ? k.toLocaleUpperCase('en-US') : k.toLocaleUpperCase('en-US');
    return k;
  }

  function tusKombo(e) {
    if (e.getModifierState && e.getModifierState('AltGraph')) return null;   // AltGr yazı içindir
    const p = [];
    if (e.ctrlKey || e.metaKey) p.push('Ctrl');   // Meta (Cmd/Win) Ctrl sayılır
    if (e.altKey) p.push('Alt');
    if (e.shiftKey) p.push('Shift');
    const k = tusAdi(e);
    if (!k || DEGISTIRICI.includes(k) || k === 'Control' || k === 'AltGraph' || k === 'Dead' || k === 'Unidentified') return null;
    p.push(k);
    return p.join('+');
  }

  /** tusKombo'nun üretebileceği biçim mi (dosyadan gelen değer için): "Ctrl+Shift+Y", "Alt+F2", "Ctrl+,". */
  function komboKanonikMi(v) {
    if (typeof v !== 'string' || v.length > 40) return false;
    const m = /^(Ctrl\+)?(Alt\+)?(Shift\+)?(Meta\+)?([^+]+|Plus)$/.exec(v);
    if (!m || !(m[1] || m[2] || m[4])) return false;
    const tus = m[5];
    if (m[4] || ['Ctrl', 'Alt', 'Shift', 'Meta', 'Control', 'AltGraph', 'Dead', 'Unidentified', 'Tab', 'Escape'].includes(tus)) return false;
    if ([...tus].length === 1) return tus === tus.toLocaleUpperCase('en-US');
    return /^[A-Z][A-Za-z0-9]{1,15}$/.test(tus);
  }

  /** null = geçerli; değilse neden anahtarı. */
  function tusGecerliMi(kombo) {
    const p = kombo.split('+');
    if (!p.some((x) => x === 'Ctrl' || x === 'Alt' || x === 'Meta')) return 'neden_degistirici';
    if (p.includes('Ctrl') && p.includes('Alt')) return 'neden_altgr';
    const esdeger = p.includes('Meta') ? ['Ctrl', ...p.filter((x) => x !== 'Meta' && x !== 'Ctrl')].join('+') : kombo;
    if (TARAYICI_YASAK.has(kombo) || TARAYICI_YASAK.has(esdeger)) return 'neden_tarayici';
    return null;
  }

  let ayar = ayarDogrula(depoOku('ayarlar', null));

  // ---------------------------------------------------------------- dil yardımcıları
  function tarayiciDili() {
    const d = ((navigator.languages && navigator.languages[0]) || navigator.language || 'tr').toLowerCase();
    return d.startsWith('tr') ? 'tr' : 'en';
  }
  function dilKodu() {
    if (ayar.dil === 'tarayici') return tarayiciDili();
    return ayar.dil === 'en' ? 'en' : 'tr';
  }
  function _(k, deger) {
    const s = (METIN[dilKodu()] || METIN.tr)[k] ?? METIN.tr[k] ?? k;
    return deger ? s.replace(/\{(\w+)\}/g, (m, a) => (a in deger ? String(deger[a]) : m)) : s;
  }
  function sayi(n) { return Number(n).toLocaleString(dilKodu() === 'tr' ? 'tr-TR' : 'en-US'); }
  /** Arama için harf katlama: Türkçe I/ı ile İngilizce I/i aynı sayılır. */
  function katla(s) { return String(s).toLocaleLowerCase('tr-TR').replace(/ı/g, 'i'); }

  // ---------------------------------------------------------------- küçük yardımcılar
  const bekle = (ms) => new Promise((r) => setTimeout(r, Math.max(0, ms * ZC)));
  const sayiOku = (s) => { const d = String(s || '').replace(/[^\d]/g, ''); return d ? parseInt(d, 10) : null; };
  function metinAl(o) {
    if (!o) return '';
    const kopya = o.cloneNode(true);
    kopya.querySelectorAll('button').forEach((b) => b.remove());   // "More / Daha fazla" düğmesi metne girmesin
    return (kopya.textContent || '').replace(/ /g, ' ').trim();
  }
  function yanittaMi(o) { return !!(o && o.closest && o.closest('.CDe7pd')); }
  function ilkDis(kok, secici) {
    for (const o of kok.querySelectorAll(secici)) if (!yanittaMi(o)) return o;
    return null;
  }

  // ---------------------------------------------------------------- Maps sayfasını okuma
  const SEC = {
    kart: '[data-review-id]',
    sekme: 'button[role="tab"]',
    sirala: 'button[aria-label="Sort reviews"], button[data-value="Sort"], button[aria-label="Yorumları sırala"], button[data-value="Sırala"]',
    menuOge: '[role="menuitemradio"], [role="menuitem"]',
    devam: 'button.w8nwRe.kyuRq, button[jsaction*="expandReview"], button[jsaction*="expandOwnerResponse"]',
    ceviri: 'button[role="switch"][jsaction*="showReviewInOriginal"]',
    yanit: '.CDe7pd',
    medya: 'button.Tya61d, [data-photo-index]',
    histogram: 'tr.BHOKXe',
  };

  function yerSayfasiMi() { return /\/maps\/place\//.test(location.pathname); }

  /** Aynı kimlik iç düğmelerde de var: her kimlik için en dış öğe (yorum kartı). */
  function kartlar() {
    const map = new Map();
    for (const o of document.querySelectorAll(SEC.kart)) {
      if (o.closest && o.closest('[data-aalabs]')) continue;
      const id = o.getAttribute('data-review-id');
      if (!id) continue;
      const onceki = map.get(id);
      if (!onceki || o.contains(onceki)) map.set(id, o);
    }
    return [...map.values()];
  }

  function yorumlarSekmesi() {
    return [...document.querySelectorAll(SEC.sekme)].find((b) => /^(reviews|yorumlar)\b/i.test((b.getAttribute('aria-label') || b.textContent || '').trim())) || null;
  }

  function sinirliGorunumMu() {
    const yazi = (document.querySelector('[role="main"]') || document.body || {}).textContent || '';
    return /limited view of Google Maps|Google Haritalar'ın sınırlı|sınırlı bir görünüm/i.test(yazi);
  }

  function kaydirmaKabi() {
    const ilk = kartlar()[0];
    if (ilk) {
      let o = ilk.parentElement;
      while (o && o !== document.body) {
        const s = getComputedStyle(o);
        if ((s.overflowY === 'auto' || s.overflowY === 'scroll') && o.scrollHeight > o.clientHeight + 20) return o;
        o = o.parentElement;
      }
    }
    for (const s of ['div.m6QErb.DxyBCb.kA9KIf.dS8AEf', 'div.m6QErb.DxyBCb.kA9KIf', 'div.m6QErb.DxyBCb']) {
      const c = document.querySelector(s);
      if (c && c.scrollHeight > c.clientHeight) return c;
    }
    return null;
  }

  function isletmeAdi() {
    const h1 = document.querySelector('h1.DUwDvf, h1');
    const ad = h1 && h1.textContent.trim();
    if (ad) return ad;
    return (eskiBaslik !== null ? eskiBaslik : document.title).replace(/\s*[-–]\s*Google (Maps|Haritalar)\s*$/i, '').trim();
  }

  function isletmeBilgisi() {
    const deger = (secici) => { const b = document.querySelector(secici); if (!b) return ''; const t = b.querySelector('.Io6YTe, .fontBodyMedium'); return (t || b).textContent.trim(); };
    let kategori = '';
    const kb = document.querySelector('button[jsaction*="category"]'); if (kb) kategori = kb.textContent.trim();
    if (!kategori) { const ks = document.querySelector('.DkEaL'); if (ks) kategori = ks.textContent.trim(); }
    const w = document.querySelector('a[data-item-id="authority"]');
    return {
      business_name: isletmeAdi(), address: deger('button[data-item-id="address"]'), category: kategori,
      phone: deger('button[data-item-id^="phone"]'), website: w ? w.href || '' : '', url: location.href,
    };
  }

  /** Google'ın yıldız dağılımı, ortalaması ve toplamı (yorumlar sekmesinin başı). */
  function toplamlar() {
    const t = { average_rating: null, total_reviews: null, google_total: null, stars: { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 }, histogram_read: false };
    for (const o of document.querySelectorAll('.fontDisplayLarge')) {
      const v = parseFloat(o.textContent.trim().replace(',', '.'));
      if (v >= 1 && v <= 5) { t.average_rating = v; break; }
    }
    for (const satir of document.querySelectorAll(SEC.histogram)) {
      const lbl = satir.getAttribute('aria-label') || '';
      const m = /^\D*([1-5])\D+(.*)$/.exec(lbl);              // "5 stars, 13,768 reviews" · "5 yıldız, 312 yorum"
      let n = m ? sayiOku(m[2]) : null;
      if (n === null) { const h = satir.querySelectorAll('td'); if (h.length >= 3) n = sayiOku(h[2].textContent); }
      const y = m ? m[1] : (satir.querySelector('td') || {}).textContent;
      if (y && n !== null && t.stars[String(y).trim()] !== undefined) { t.stars[String(y).trim()] = n; t.histogram_read = true; }
    }
    for (const o of document.querySelectorAll('.jANrlb .fontBodySmall, .fontBodySmall')) {
      if (o.closest(SEC.kart)) continue;                     // "Local Guide · 45 reviews" yorumcu satırıdır
      const m = /([\d.,   ]+)\s*(reviews?|yorum)/i.exec(o.textContent || '');
      if (m) { t.google_total = sayiOku(m[1]); break; }
    }
    if (t.google_total === null) {
      for (const o of document.querySelectorAll('[role="main"] [aria-label]')) {
        const m = /^\s*([\d.,\u00a0\u202f ]+)\s*(reviews?|yorum)\s*$/i.exec(o.getAttribute('aria-label') || '');
        if (m) { t.google_total = sayiOku(m[1]); break; }
      }
    }
    const toplam = Object.values(t.stars).reduce((a, b) => a + b, 0);
    t.total_reviews = t.google_total !== null ? t.google_total : (toplam || null);
    return t;
  }

  /** Görünen yorum metni ve dili (sahip yanıtı hariç). */
  function govdeMetni(kart) {
    const kutu = ilkDis(kart, '.MyEned') ;
    const span = kutu ? kutu.querySelector('.wiI7pd') || kutu : ilkDis(kart, '.wiI7pd');
    return { metin: metinAl(span), dil: (kutu && kutu.getAttribute('lang')) || (span && span.getAttribute && span.getAttribute('lang')) || '' };
  }

  function arkaPlanAdresi(o) {
    const s = (o.style && o.style.backgroundImage) || '';
    const m = /url\(["']?(.*?)["']?\)/.exec(s);
    if (m && m[1] && !m[1].startsWith('data:')) return m[1];
    const img = o.querySelector && o.querySelector('img');
    const src = img && (img.getAttribute('src') || img.getAttribute('data-src'));
    return src && !src.startsWith('data:') ? src : '';
  }
  /** googleusercontent adresinin boyut ekini atar: ".../AAB…=w450-h338-p-k-no" → ".../AAB…" */
  function koke(url) {
    const son = url.lastIndexOf('/');
    const esit = url.indexOf('=', son);
    return esit > 0 ? url.slice(0, esit) : url;
  }

  function medyaOku(kart) {
    const liste = [];
    const gorulen = new Set();
    let fazla = 0;
    for (const b of kart.querySelectorAll(SEC.medya)) {
      if (yanittaMi(b)) continue;
      const etiket = b.getAttribute('aria-label') || '';
      const mf = /\+\s*([\d.,]+)/.exec(etiket) || /\+\s*([\d.,]+)/.exec((b.querySelector('.Tap5If') || {}).textContent || '');
      if (mf) fazla += sayiOku(mf[1]) || 0;
      const adres = arkaPlanAdresi(b);
      if (!adres) continue;
      const kok = koke(adres);
      if (gorulen.has(kok)) continue;
      gorulen.add(kok);
      const sure = (b.querySelector('.e5A3N') || {}).textContent;
      const videoMu = /^video\b/i.test(etiket.trim()) || /\bvideo\b/i.test(etiket) || !!sure;
      if (videoMu) liste.push({ type: 'video', url: kok + '=m22', thumbnail: kok + '=s400', duration: (sure || '').trim() });
      else liste.push({ type: 'photo', url: ayar.hd ? kok + '=s0' : adres, thumbnail: kok + '=s400' });
    }
    return { liste, fazla };
  }

  function yanitOku(kart) {
    const k = kart.querySelector(SEC.yanit);
    if (!k) return { metin: '', tarih: '' };
    const govde = k.querySelector('div.wiI7pd, span.wiI7pd, .wiI7pd');
    const tarih = k.querySelector('.DZSIDd, .rsqaWe');
    return { metin: metinAl(govde), tarih: tarih ? tarih.textContent.trim() : '' };
  }

  function kartOku(kart, sira) {
    const id = kart.getAttribute('data-review-id') || '';
    const adO = kart.querySelector('.d4r55');
    const ad = (adO && adO.textContent.trim()) || kart.getAttribute('aria-label') || '';
    let profil = '';
    const pd = kart.querySelector('[data-href*="/contrib/"]');
    if (pd) profil = pd.getAttribute('data-href') || '';
    if (!profil) { const pa = kart.querySelector('a[href*="/contrib/"]'); if (pa) profil = pa.href; }
    const av = kart.querySelector('img.NBa7we');
    let rehber = false, yorumSayisi = null, fotoSayisi = null;
    const bilgi = (kart.querySelector('.RfnDt') || {}).textContent || '';
    if (/local guide|yerel rehber/i.test(bilgi)) rehber = true;
    const ry = /([\d.,]+)\s*(reviews?|yorum)/i.exec(bilgi); if (ry) yorumSayisi = sayiOku(ry[1]);
    const rf = /([\d.,]+)\s*(photos?|fotoğraf)/i.exec(bilgi); if (rf) fotoSayisi = sayiOku(rf[1]);
    let yildiz = null;
    const y = ilkDis(kart, 'span[role="img"][aria-label]');
    if (y) { const m = /([1-5])/.exec(y.getAttribute('aria-label') || ''); if (m) yildiz = parseInt(m[1], 10); }
    const tarihO = ilkDis(kart, '.rsqaWe');
    const tarih = tarihO ? tarihO.textContent.trim() : '';
    let begeni = 0;
    for (const b of kart.querySelectorAll('button')) {
      if (yanittaMi(b)) continue;
      const al = b.getAttribute('aria-label') || '';
      const m = /^([\d.,]+)\s*(likes?|beğeni)/i.exec(al.trim());
      if (m) { begeni = sayiOku(m[1]) || 0; break; }
    }
    if (!begeni) { const p = ilkDis(kart, '.pkWtMe'); if (p) begeni = sayiOku(p.textContent) || 0; }
    const medya = medyaOku(kart);
    const yanit = yanitOku(kart);
    const g = govdeMetni(kart);
    const anahtar = kart.querySelector(SEC.ceviri);
    const ceviri = !!anahtar && !yanittaMi(anahtar);
    const ozgunGorunuyor = ceviri && anahtar.getAttribute('aria-checked') === 'false';   // kullanıcı elle özgüne çevirmiş
    let dilAdi = '';
    if (ceviri) { const m = /\(([^)]+)\)\s*$/.exec(anahtar.textContent.trim()); if (m) dilAdi = m[1].trim(); }
    return {
      index: sira + 1, review_id: id, reviewer_name: ad, reviewer_profile_url: profil,
      reviewer_photo_url: av ? av.getAttribute('src') || '' : '', is_local_guide: rehber,
      reviewer_review_count: yorumSayisi, reviewer_photo_count: fotoSayisi,
      stars: yildiz, review_date: tarih, review_edited: /^(edited|düzenlendi)/i.test(tarih),
      original_text: ceviri && !ozgunGorunuyor ? '' : g.metin, translated_text: ceviri && !ozgunGorunuyor ? g.metin : '',
      original_language: dilAdi, original_language_code: ceviri && !ozgunGorunuyor ? '' : g.dil, is_translated: ceviri,
      text_shortened: !!(ilkDis(kart, '.MyEned') && [...ilkDis(kart, '.MyEned').querySelectorAll(SEC.devam)].some((b) => b.getAttribute('aria-expanded') !== 'true')),
      likes: begeni, media: medya.liste, media_more_count: medya.fazla,
      owner_response: yanit.metin, owner_response_date: yanit.tarih,
    };
  }

  // ---------------------------------------------------------------- scrape akışı
  const ADIMLAR = ['a_sirala', 'a_kaydir', 'a_genislet', 'a_oku', 'a_indir'];
  const durum = { kip: 'bos', adim: -1, yazi: '', oran: 0, sayilar: [0, 0, 0], sonuc: null, durdur: false, baslangic: 0 };
  const tani = { yapildi: false, sekme: null, sirala: null, yeni: null, kap: null, kart: 0, ceviri: 0, ozgunOkunan: 0, ozgunToplam: 0,
    ozgunAtlandi: false, yanit: 0, foto: 0, video: 0, fazla: 0, toplam: null, histogram: false, sinirli: null, son: null, hata: '' };

  class ScrapeHatasi extends Error { constructor(baslik, alt) { super(baslik); this.baslik = baslik; this.alt = alt; } }

  function durumYaz(degisiklik) { Object.assign(durum, degisiklik); kartCiz(); }

  async function bekleKosul(fn, ms, adim = 100) {
    const son = Date.now() + ms * ZC;
    while (Date.now() < son) { if (durum.durdur) return null; try { const v = fn(); if (v) return v; } catch (_) { /* yok */ } await bekle(adim); }
    try { return fn(); } catch (_) { return null; }
  }

  /** "En yeni"yi seçer ve listenin yeniden çizildiğini doğrular (ilk kart öğesi değişmeli). Olmazsa bir kez daha dener. */
  async function siralaEnYeni() {
    tani.siraDegisti = null;
    for (let deneme = 0; deneme < 2 && !durum.durdur; deneme++) {
      const d = await bekleKosul(() => document.querySelector(SEC.sirala), 4000);
      tani.sirala = !!d;
      if (!d) return;
      const onceki = kartlar()[0] || null;
      d.click();
      const ogeler = await bekleKosul(() => { const l = [...document.querySelectorAll(SEC.menuOge)]; return l.length ? l : null; }, 2500);
      if (!ogeler) { tani.yeni = false; return; }
      const yeni = ogeler.find((o) => /newest|en yeni/i.test(o.textContent || ''));
      tani.yeni = !!yeni;
      (yeni || ogeler[1] || ogeler[0]).click();
      const yenilendi = await bekleKosul(() => { const k = kartlar()[0]; return k && k !== onceki && k.isConnected; }, 5000, 150);
      if (yenilendi) { tani.siraDegisti = true; await bekle(800); return; }
      await bekle(1200);
    }
    tani.siraDegisti = false;
  }

  async function kaydir(toplam) {
    let kap = await bekleKosul(() => kaydirmaKabi(), 4000);
    tani.kap = !!kap;
    if (!kap) {
      if (!kartlar().length) throw new ScrapeHatasi(_('h_liste'), _('h_listeAlt'));
      return;                                          // kısa liste: kaydırma gerekmiyor
    }
    let onceki = -1, durgun = 0, sonArtis = Date.now();
    const turBekle = HIZ_MS[ayar.hiz] || 350;
    for (let i = 0; i < 4000 && !durum.durdur; i++) {
      if (!kap.isConnected) kap = kaydirmaKabi() || kap;      // Maps listeyi yeniden çizdiyse yeni kabı al
      kap.scrollTop = kap.scrollHeight + 99999;
      await bekle(turBekle);
      const n = kartlar().length;
      durumYaz({ yazi: toplam ? _('d_kaydir', { n: sayi(n), t: sayi(toplam) }) : _('d_kaydirT', { n: sayi(n) }),
        oran: toplam ? Math.min(1, n / toplam) : 0, sayilar: [n, durum.sayilar[1], durum.sayilar[2]] });
      if (toplam && n >= toplam) break;
      // yavaş ağda erken durmasın: hem tur sayısı hem en az 4 sn yeni yorum gelmemiş olmalı
      if (n === onceki) { durgun++; if (durgun >= ayar.bekle && Date.now() - sonArtis >= 4000 * ZC) break; kap.scrollBy(0, 99999); }
      else { durgun = 0; sonArtis = Date.now(); }
      onceki = n;
    }
  }

  function acilmamislar() {
    return [...document.querySelectorAll(SEC.devam)].filter((b) => b.isConnected && b.getAttribute('role') !== 'switch' && b.closest(SEC.kart)
      && b.getAttribute('aria-expanded') !== 'true');
  }
  /** "Daha fazla"ya basar. Maps bir açılışta komşu kartları yeniden çizebilir; elde kalan düğme boşa gider. Bu yüzden
   *  her turda yeniden aranır (en çok 6 tur) ve tıklamalar arasında kısa ara verilir. */
  async function genislet() {
    let n = 0;
    for (let tur = 0; tur < 6 && !durum.durdur; tur++) {
      const liste = acilmamislar();
      if (!liste.length) break;
      for (const b of liste) {
        if (durum.durdur) break;
        if (!b.isConnected || b.getAttribute('aria-expanded') === 'true') continue;
        try { b.click(); n++; } catch (_) { /* yok */ }
        if (n % 25 === 0) await bekle(20);
        if (n % 40 === 0) durumYaz({ yazi: _('d_genislet', { n: sayi(n) }) });
      }
      await bekle(500);
    }
    tani.kesik = acilmamislar().length;
  }

  /** Çevrili yorumların özgün metnini okur. Toplu çalışır: 40'lık gruptaki bütün "Orijinali göster" düğmelerine
   *  birden basar, hepsinin dönmesini tek beklemede (en çok 4 sn) bekler, kısaltılmış özgünlerin "Daha fazla"sına
   *  birden basar, sonra okur. Sekme arkadayken tarayıcı zamanlayıcıları ~1 sn'ye yavaşlatır; yorum başına
   *  bekleme olursa 313 yorum dakikalar sürer (3.1.0 ilk sürüm). Grup başına birkaç bekleme bunu önler. */
  async function ozgunOku(sonuclar, kartHaritasi) {
    const hedef = sonuclar.filter((r) => r.is_translated && !r.original_text);
    tani.ozgunToplam = hedef.length;
    tani.ozgunOkunan = 0;
    const basilan = [];
    const GRUP = 40;
    const kartBul = (r) => {
      let k = kartHaritasi.get(r.review_id);
      if (!k || !k.isConnected) { k = kartlar().find((x) => x.getAttribute('data-review-id') === r.review_id) || null; if (k) kartHaritasi.set(r.review_id, k); }
      return k;
    };
    // kabul: düğme gerçekten özgüne döndü ve metin çeviriden farklı
    const ozgunMu = (r) => {
      const kart = kartBul(r);
      const a = kart && kart.querySelector(SEC.ceviri);
      if (!a || a.getAttribute('aria-checked') !== 'false') return null;
      const g = govdeMetni(kart);
      return g.metin && g.metin !== r.translated_text ? g : null;
    };
    for (let bas = 0; bas < hedef.length && !durum.durdur; bas += GRUP) {
      const grup = hedef.slice(bas, bas + GRUP);
      for (const r of grup) {
        const kart = kartBul(r);
        const a = kart && kart.querySelector(SEC.ceviri);
        if (a && a.getAttribute('aria-checked') === 'true') { try { a.click(); basilan.push(r.review_id); } catch (_) { /* yok */ } }
      }
      const okunan = new Map();
      await bekleKosul(() => { for (const r of grup) if (!okunan.has(r.review_id)) { const g = ozgunMu(r); if (g) okunan.set(r.review_id, g); } return okunan.size === grup.length; }, 4000, 120);
      // özgün metin yeniden kısaltılmış gelebilir: kartın kendi "Daha fazla"sına bas (hepsine birden)
      const uzayan = [];
      for (const r of grup) {
        const g = okunan.get(r.review_id);
        const kart = g && kartBul(r);
        const kutu = kart && ilkDis(kart, '.MyEned');
        const devam = kutu && [...kutu.querySelectorAll(SEC.devam)].find((b) => b.getAttribute('aria-expanded') !== 'true');
        if (devam) { try { devam.click(); uzayan.push(r); } catch (_) { /* yok */ } }
      }
      if (uzayan.length) {
        await bekleKosul(() => {
          let hepsi = true;
          for (const r of uzayan) { const g = ozgunMu(r); if (g && g.metin.length > okunan.get(r.review_id).metin.length) okunan.set(r.review_id, g); else hepsi = false; }
          return hepsi;
        }, 2000, 120);
      }
      for (const r of grup) {
        const g = okunan.get(r.review_id);
        if (g) { r.original_text = g.metin; r.original_language_code = g.dil; tani.ozgunOkunan++; } else r.original_not_read = true;
      }
      const n = Math.min(bas + GRUP, hedef.length);
      durumYaz({ yazi: _('d_ozgun', { n: sayi(n), t: sayi(hedef.length) }), oran: n / Math.max(1, hedef.length) });
    }
    // sayfayı eski hâline getir (çeviri görünsün); beklemeden. Düğme yeniden çizildiyse kimlikle bulunur.
    for (const id of basilan) {
      try {
        const k = kartlar().find((x) => x.getAttribute('data-review-id') === id);
        const a = k && k.querySelector(SEC.ceviri);
        if (a && a.getAttribute('aria-checked') === 'false') a.click();
      } catch (_) { /* yok */ }
    }
  }

  /** Özgün metni okunamamış her çevrili yoruma işaret koyar (durdurma, ayar kapalı, zaman aşımı). */
  function ozgunEksikIsaretle(sonuclar) {
    for (const r of sonuclar) if (r.is_translated && !r.original_text) r.original_not_read = true;
  }

  function kontrolHesapla(sonuclar, t) {
    const okunan = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };
    for (const r of sonuclar) if (r.stars && okunan[r.stars] !== undefined) okunan[r.stars]++;
    const stars = {};
    let tutuyor = t.histogram_read;
    for (const y of [5, 4, 3, 2, 1]) {
      stars[y] = { google: t.histogram_read ? t.stars[y] : null, scraped: okunan[y] };
      if (t.histogram_read && t.stars[y] !== okunan[y]) tutuyor = false;
    }
    const g = t.google_total;
    return { google_total: g, scraped: sonuclar.length, difference: g === null ? null : sonuclar.length - g, stars, stars_match: tutuyor };
  }

  function dosyaAdi(ad) {
    const temiz = (ad || 'gmaps').replace(/[^\p{L}\p{N} _-]/gu, '').trim().replace(/\s+/g, '_').slice(0, 60) || 'gmaps';
    const d = new Date();
    const p = (n) => String(n).padStart(2, '0');
    return `${temiz}_reviews_${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}.json`;
  }

  function indir(metin, ad, tur) {
    // data: adresi: Firefox'ta betik ayrı bağlamda çalışınca Blob adresi sayfadan inmeyebilir.
    // Chromium'da ~2 MB üstü data: adresi inmeyebilir; orada büyük dosya Blob ile iner.
    let href = `data:${tur};charset=utf-8,` + encodeURIComponent(metin);
    let blob = null;
    if (metin.length > 1500000 && !/firefox/i.test(navigator.userAgent)) {
      try { blob = URL.createObjectURL(new Blob([metin], { type: tur })); href = blob; } catch (_) { blob = null; }
    }
    const a = el('a', { href, download: ad });
    (kok || document.body).appendChild(a);
    a.click();
    a.remove();
    if (blob) setTimeout(() => URL.revokeObjectURL(blob), 60000);
  }

  let calisiyor = false;
  async function scrapeBaslat() {
    if (calisiyor) { scrapeDurdur(); return; }
    if (!yerSayfasiMi()) return;
    calisiyor = true;
    Object.assign(tani, { yapildi: true, sekme: null, sirala: null, yeni: null, kap: null, kart: 0, ceviri: 0, ozgunOkunan: 0, ozgunToplam: 0,
      ozgunAtlandi: !ayar.ozgun, yanit: 0, foto: 0, video: 0, fazla: 0, toplam: null, histogram: false, sinirli: null, hata: '', kesik: 0, siraDegisti: null });
    durumYaz({ kip: 'calis', adim: 0, yazi: _('d_hazirla'), oran: 0, sayilar: [0, 0, 0], sonuc: null, durdur: false, baslangic: Date.now(), isletme: isletmeAdi() });
    let sonuclar = [];
    let indirildi = false;
    try {
      const isletme = isletmeBilgisi();
      const sekme = yorumlarSekmesi();
      tani.sekme = !!sekme || kartlar().length > 0;
      if (sekme && sekme.getAttribute('aria-selected') !== 'true') {
        sekme.click();
        // Genel bakışta da birkaç yorum kartı var; asıl liste sıralama düğmesiyle gelir. Maps listeyi bir kez daha çizer.
        await bekleKosul(() => { const s2 = yorumlarSekmesi(); return s2 && s2.getAttribute('aria-selected') === 'true' && document.querySelector(SEC.sirala); }, 6000);
        await bekle(1200);
      }
      if (!sekme && !kartlar().length) throw new ScrapeHatasi(_('h_sekme'), _('h_sekmeAlt'));
      await bekleKosul(() => kartlar().length, 4000);

      if (ayar.sirala && !durum.durdur) { durumYaz({ yazi: _('d_sirala') }); await siralaEnYeni(); }
      const t = toplamlar();
      tani.toplam = t.google_total; tani.histogram = t.histogram_read;

      durumYaz({ adim: 1 });
      await kaydir(t.google_total);
      tani.sinirli = sinirliGorunumMu();

      durumYaz({ adim: 2, oran: 0, yazi: _('d_genislet', { n: 0 }) });
      if (!durum.durdur) await genislet();

      durumYaz({ adim: 3 });
      const liste = kartlar();
      if (!liste.length) throw new ScrapeHatasi(_('h_liste'), _('h_listeAlt'));
      const harita = new Map();
      liste.forEach((k, i) => {
        const r = kartOku(k, i);
        sonuclar.push(r);
        harita.set(r.review_id, k);
        if ((i + 1) % 50 === 0) durumYaz({ yazi: _('d_oku', { n: sayi(i + 1), t: sayi(liste.length) }), oran: (i + 1) / liste.length });
      });
      const ceviriSay = sonuclar.filter((r) => r.is_translated).length;
      const medyaSay = sonuclar.reduce((a, r) => a + r.media.length, 0);
      durumYaz({ sayilar: [sonuclar.length, ceviriSay, medyaSay] });
      if (ayar.ozgun && ceviriSay && !durum.durdur) await ozgunOku(sonuclar, harita);
      ozgunEksikIsaretle(sonuclar);

      durumYaz({ adim: 4, yazi: _('d_indir'), oran: 1 });
      Object.assign(tani, {
        kart: sonuclar.length, ceviri: ceviriSay, yanit: sonuclar.filter((r) => r.owner_response).length,
        foto: sonuclar.reduce((a, r) => a + r.media.filter((m) => m.type === 'photo').length, 0),
        video: sonuclar.reduce((a, r) => a + r.media.filter((m) => m.type === 'video').length, 0),
        fazla: sonuclar.reduce((a, r) => a + r.media_more_count, 0),
      });
      const kontrol = kontrolHesapla(sonuclar, t);
      const cikti = {
        scrape_date: new Date().toISOString(), scraper: AD, scraper_version: SURUM, stopped: durum.durdur,
        business: isletme.business_name ? isletme : Object.assign(isletme, { business_name: isletmeAdi() }),
        totals: { average_rating: t.average_rating, total_reviews: t.total_reviews, stars: t.stars },
        check: kontrol, reviews_scraped: sonuclar.length, reviews: sonuclar,
      };
      const ad = dosyaAdi(cikti.business.business_name);
      indir(JSON.stringify(cikti, null, 2), ad, 'application/json');
      indirildi = true;
      const sure = Math.round((Date.now() - durum.baslangic) / 1000);
      tani.son = { zaman: new Date(), n: sonuclar.length, sure, durduruldu: durum.durdur };
      const satirlar = [];
      if (kontrol.google_total === null) satirlar.push(['uy', _('farkBilinmiyor', { o: sayi(kontrol.scraped) })]);
      else satirlar.push([Math.abs(kontrol.difference) <= 2 ? 'iyi' : 'uy', kontrol.difference === 0 ? _('farkYok', { g: sayi(kontrol.google_total), o: sayi(kontrol.scraped) })
        : _('farkVar', { g: sayi(kontrol.google_total), o: sayi(kontrol.scraped), f: (kontrol.difference > 0 ? '+' : '') + sayi(kontrol.difference) })]);
      if (t.histogram_read && !durum.durdur) {
        const s = [5, 4, 3, 2, 1].map((y) => kontrol.stars[y].scraped).join(' · ');
        const f = [5, 4, 3, 2, 1].filter((y) => kontrol.stars[y].google !== kontrol.stars[y].scraped).map((y) => `${y}: ${kontrol.stars[y].google} ↔ ${kontrol.stars[y].scraped}`).join(' · ');
        satirlar.push(kontrol.stars_match ? ['iyi', _('yildizTutuyor', { s })] : ['uy', _('yildizTutmuyor', { s: f })]);
      }
      const eksik = tani.ozgunToplam - tani.ozgunOkunan;
      if (ayar.ozgun && eksik > 0) satirlar.push(['uy', _('ozgunEksik', { n: sayi(eksik) })]);
      const sinirli = tani.sinirli && sonuclar.length <= 10;
      durumYaz({
        kip: durum.durdur ? 'durdu' : 'bitti', adim: 5, oran: 1,
        sonuc: sinirli ? { tur: 'kotu', baslik: _('sinirliBas'), alt: _('sinirliAlt'), satirlar, dosya: ad }
          : { tur: 'iyi', baslikA: durum.durdur ? 'durduBas' : 'bittiBas', n: sonuclar.length,
            altD: { c: ceviriSay, m: medyaSay, y: tani.yanit }, satirlar, dosya: ad },
      });
      if (ayar.bildir) bitinceBildir(cikti.business.business_name, sonuclar.length);
    } catch (hata) {
      const s = hata instanceof ScrapeHatasi ? hata : new ScrapeHatasi(_('h_genel'), _('h_genelAlt', { hata: String((hata && hata.message) || hata) + '.' }));
      tani.hata = (hata && hata.message) || String(hata);
      // okunan yorumlar boşa gitmesin: hata da olsa o ana kadar okunanlar iner
      let dosya = '';
      if (sonuclar.length && !indirildi) {
        try {
          ozgunEksikIsaretle(sonuclar);
          const t = toplamlar();
          const cikti = { scrape_date: new Date().toISOString(), scraper: AD, scraper_version: SURUM, stopped: true, error: tani.hata,
            business: isletmeBilgisi(), totals: { average_rating: t.average_rating, total_reviews: t.total_reviews, stars: t.stars },
            check: kontrolHesapla(sonuclar, t), reviews_scraped: sonuclar.length, reviews: sonuclar };
          dosya = dosyaAdi(cikti.business.business_name);
          indir(JSON.stringify(cikti, null, 2), dosya, 'application/json');
        } catch (_) { dosya = ''; }
      }
      durumYaz({ kip: 'hata', sonuc: { tur: 'kotu', baslik: s.baslik, alt: s.alt, satirlar: [], dosya } });
      try { console.error(`[${AD}]`, hata); } catch (_) { /* yok */ }
    } finally {
      calisiyor = false;
      durum.durdur = false;
      taniYenile();
      kartCiz();
    }
  }

  function scrapeDurdur() {
    if (!calisiyor) return;
    durumYaz({ durdur: true });
  }

  let eskiBaslik = null;
  function bitinceBildir(ad, n) {
    if (!document.hidden) return;
    const metin = _('bildirimMetin', { ad, n: sayi(n) });
    try {
      if (typeof GM_notification === 'function') GM_notification({ title: `${KOD} · ${_('bildirimBaslik')}`, text: metin, timeout: 15000, onclick: () => { try { window.focus(); } catch (_) { /* yok */ } } });
    } catch (_) { /* bildirim izni yok */ }
    if (eskiBaslik === null) eskiBaslik = document.title;
    document.title = _('sekmeBaslik', { n: sayi(n) }) + eskiBaslik;
  }
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && eskiBaslik !== null) {
      const on = document.title.indexOf(' · ');
      if (document.title.startsWith('✓')) document.title = on >= 0 ? document.title.slice(on + 3) : eskiBaslik;
      eskiBaslik = null;
    }
  });

  // ---------------------------------------------------------------- tema
  function parlaklik(renk) {
    const m = /rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)(?:[,\s/]+([\d.]+))?/.exec(renk || '');
    if (!m) return null;
    if (m[4] !== undefined && Number(m[4]) === 0) return null;
    const kanal = (v) => { v = Number(v) / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };
    return 0.2126 * kanal(m[1]) + 0.7152 * kanal(m[2]) + 0.0722 * kanal(m[3]);
  }
  /** { koyu, kaynak } — kaynak: 'ayar' | 'zemin' | 'sistem' */
  function temaOku() {
    if (ayar.tema === 'acik') return { koyu: false, kaynak: 'ayar' };
    if (ayar.tema === 'koyu') return { koyu: true, kaynak: 'ayar' };
    for (const o of [document.querySelector('[role="main"]'), document.body, document.documentElement]) {
      if (!o) continue;
      const l = parlaklik(getComputedStyle(o).backgroundColor);
      if (l !== null) return { koyu: l < 0.18, kaynak: 'zemin' };
    }
    const sistem = !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
    return { koyu: sistem, kaynak: 'sistem' };
  }
  function temaUygula() {
    if (!ev) return;
    ev.setAttribute('data-theme', temaOku().koyu ? 'dark' : 'light');
    ev.style.setProperty('--o', String(ayar.olcek / 100));
  }

  // ---------------------------------------------------------------- arayüz kökü (Shadow DOM)
  const SVG = 'http://www.w3.org/2000/svg';
  const IKON = {   // Lucide 1.55.0 (ISC): download, square, refresh-cw, settings, minus, x, check, info, triangle-alert, copy, search, circle-alert
    indir: [['path', { d: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4' }], ['path', { d: 'm7 10 5 5 5-5' }], ['path', { d: 'M12 15V3' }]],
    kare: [['rect', { x: 6, y: 6, width: 12, height: 12, rx: 1 }]],
    yenile: [['path', { d: 'M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8' }], ['path', { d: 'M21 3v5h-5' }], ['path', { d: 'M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16' }], ['path', { d: 'M8 16H3v5' }]],
    disli: [['path', { d: 'M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z' }], ['circle', { cx: 12, cy: 12, r: 3 }]],
    eksi: [['path', { d: 'M5 12h14' }]],
    kapat: [['path', { d: 'M18 6 6 18' }], ['path', { d: 'm6 6 12 12' }]],
    tamam: [['path', { d: 'M20 6 9 17l-5-5' }]],
    bilgi: [['circle', { cx: 12, cy: 12, r: 10 }], ['path', { d: 'M12 16v-4' }], ['path', { d: 'M12 8h.01' }]],
