            el('div', { class: 'ilerleme', role: 'progressbar', 'aria-valuemin': '0', 'aria-valuemax': '100', 'aria-valuenow': String(Math.round(durum.oran * 100)) },
              el('b', { style: `width:${Math.round(durum.oran * 100)}%` })),
            el('div', { class: 'durumyazi', role: 'status', 'aria-live': 'polite', 'data-durum': '' }, durum.yazi)] : null,
          (durum.kip === 'calis' || durum.kip === 'bitti' || durum.kip === 'durdu') ? el('div', { class: 'sayilar' },
            [['s_yuklenen', 0], ['s_ceviri', 1], ['s_medya', 2]].map(([k, i]) => el('div', {}, el('b', {}, sayi(durum.sayilar[i])), el('span', {}, _(k))))) : null,
          sonucKutusu()));
    }
    // odak kaybolmasın: aynı tür düğme yeniden çizilince odağı geri ver
    const odak = kok.activeElement;
    const odakAnahtar = odak && (odak.hasAttribute('data-scrape') ? '[data-scrape]' : odak.hasAttribute('data-ayarlar-ac') ? '[data-ayarlar-ac]' : odak.hasAttribute('data-rozet') ? '[data-rozet]' : odak.hasAttribute('data-kucult') ? '[data-kucult]' : '');
    if (bil.kart) bil.kart.replaceWith(yeni); else kok.insertBefore(yeni, kok.firstChild);
    bil.kart = yeni;
    if (odakAnahtar) { const h = yeni.matches(odakAnahtar) ? yeni : yeni.querySelector(odakAnahtar); if (h) h.focus({ preventScroll: true }); }
  }

  // ---------------------------------------------------------------- tanı
  function taniSatirlari() {
    const s = [];
    const ad = (k, ayrinti, iyi, kotu) => s.push({ durum: iyi ? 'iyi' : kotu ? 'kotu' : 'notr', ad: _(k), ayrinti });
    const canli = !tani.yapildi;
    if (canli) {
      const sekme = yorumlarSekmesi();
      const kartSay = kartlar().length;
      ad('t_sekme', sekme ? 'button[role=tab] ✓' : _('t_yok'), !!sekme || kartSay > 0, false);
      ad('t_kart', kartSay ? _('t_adet', { n: sayi(kartSay) }) + ' · [data-review-id]' : _('t_bekliyor'), kartSay > 0, false);
      const sc = document.querySelectorAll(SEC.ceviri).length;
      ad('t_ceviri', _('t_adet', { n: sayi(sc) }) + ' · ' + SEC.ceviri, sc > 0, false);
      ad('t_yanit', _('t_adet', { n: sayi(document.querySelectorAll(SEC.yanit).length) }) + ' · .CDe7pd > .wiI7pd', document.querySelectorAll(SEC.yanit).length > 0, false);
      const sin = kartSay ? sinirliGorunumMu() : null;
      ad('t_giris', sin === null ? _('t_bekliyor') : sin ? _('t_sinirli') : _('t_tam'), sin === false, sin === true);
    } else {
      ad('t_sekme', tani.sekme ? 'button[role=tab] ✓' : _('t_yok'), tani.sekme, !tani.sekme);
      if (ayar.sirala) {
        ad('t_sirala', tani.sirala ? SEC.sirala.split(',')[0] + ' ✓' : _('t_yok'), tani.sirala, tani.sirala === false);
        const siraTamam = tani.yeni && tani.siraDegisti !== false;
        ad('t_yeni', tani.yeni ? 'menuitemradio "Newest" ✓' + (tani.siraDegisti === false ? ' · ' + _('t_siraYok') : '') : tani.sirala ? _('t_yok') + ' · index 1' : '—',
          siraTamam, tani.yeni === false || tani.siraDegisti === false);
      } else ad('t_sirala', _('t_atlandi'), false, false);
      ad('t_kap', tani.kap ? 'div.m6QErb (overflow) ✓' : tani.kap === false ? _('t_yok') : '—', tani.kap, tani.kap === false && tani.kart > 10);
      ad('t_kart', _('t_adet', { n: sayi(tani.kart) }) + ' · [data-review-id]', tani.kart > 0, tani.kart === 0);
      ad('t_toplam', tani.toplam !== null ? `${sayi(tani.toplam)} · ${tani.histogram ? 'tr.BHOKXe ✓' : 'tr.BHOKXe ✗'}` : _('t_yok'), tani.toplam !== null && tani.histogram, tani.toplam === null);
      ad('t_kesik', tani.kesik ? _('t_adet', { n: sayi(tani.kesik) }) + ' · button.w8nwRe[aria-expanded=false]' : '0', !tani.kesik, tani.kesik > 0);
      ad('t_ceviri', _('t_adet', { n: sayi(tani.ceviri) }) + ' · button[role=switch]', tani.ceviri > 0, false);
      if (tani.ozgunAtlandi) ad('t_ozgun', _('t_atlandi'), false, false);
      else ad('t_ozgun', `${sayi(tani.ozgunOkunan)} / ${sayi(tani.ozgunToplam)}`, tani.ozgunToplam > 0 && tani.ozgunOkunan === tani.ozgunToplam, tani.ozgunOkunan < tani.ozgunToplam);
      ad('t_yanit', tani.yanit ? _('t_adet', { n: sayi(tani.yanit) }) + ' · .CDe7pd > .wiI7pd' : _('t_olmayabilir'), tani.yanit > 0, false);
      ad('t_foto', tani.foto ? _('t_adet', { n: sayi(tani.foto) }) + ' · button.Tya61d' : _('t_olmayabilir'), tani.foto > 0, false);
      ad('t_video', tani.video ? _('t_adet', { n: sayi(tani.video) }) + ' · aria-label="Video" → =m22' : _('t_olmayabilir'), tani.video > 0, false);
      if (tani.fazla) ad('t_fazla', `${sayi(tani.fazla)} · ${_('t_fazlaAc')}`, false, false);
      ad('t_giris', tani.sinirli ? _('t_sinirli') : _('t_tam'), tani.sinirli === false, tani.sinirli === true);
      if (tani.hata) s.push({ durum: 'kotu', ad: _('h_genel'), ayrinti: tani.hata });
    }
    const son = tani.son;
    ad('t_son', son ? _('t_sonSatir', { t: son.zaman.toLocaleString(dilKodu() === 'tr' ? 'tr-TR' : 'en-GB'), n: sayi(son.n), s: sayi(son.sure) }) + (son.durduruldu ? ' · ' + _('t_durduruldu') : '') : _('t_sonYok'), !!son, false);
    ad('t_depo', gmDepo ? _('t_depoVar') : _('t_depoYok'), gmDepo, !gmDepo);
    return s;
  }

  function taniYenile() {
    const onceki = tani.sorunlu;
    tani.sorunlu = tani.yapildi && taniSatirlari().some((x) => x.durum === 'kotu');
    if (onceki !== tani.sorunlu) { menuKaydet(); kartCiz(); }
    if (panelAcik() && panelBolum === 'tani') panelCiz();
  }

  function taniRaporu() {
    const satirlar = taniSatirlari();
    const t = temaOku();
    let yonetici = '—';
    try { if (typeof GM_info !== 'undefined' && GM_info) yonetici = (GM_info.scriptHandler || '?') + ' ' + (GM_info.version || ''); } catch (_) { /* yok */ }
    const ayarKopya = Object.assign({}, ayar);
    delete ayarKopya.sonYedek;
    const isaret = { iyi: _('r_ok'), kotu: _('r_hata'), notr: _('r_bilgi') };
    const r = [
      `${AD} ${SURUM} — ${_('raporBaslik')}`,
      `${_('r_zaman')}: ${new Date().toISOString().slice(0, 16).replace('T', ' ')} UTC`,
      `${_('r_tarayici')}: ${navigator.userAgent}`,
      `${_('r_yonetici')}: ${yonetici.trim()}`,
      `${_('r_sayfa')}: ${location.hostname}${location.pathname.split('/').slice(0, 3).join('/')}/… · ${yerSayfasiMi() ? 'place' : 'other'}`,
      `${_('r_dil')}: ${ayar.dil} → ${dilKodu()} · ${_('r_tema')}: ${ayar.tema} → ${t.koyu ? 'dark' : 'light'} (${t.kaynak})`,
      `${_('r_ayarlar')}: ${JSON.stringify(ayarKopya)}`,
      '',
      ...satirlar.map((x) => `${isaret[x.durum]} ${x.ad} · ${x.ayrinti}`),
      '',
      _('r_elle'),
    ];
    const cev = kabulOku();
    const cevaplar = KABUL.filter((k) => cev.cevaplar[k]);
    if (!cevaplar.length) r.push(_('r_ellebos'));
    for (const k of KABUL) {
      const c = cev.cevaplar[k];
      if (!c) continue;
      const isr = c.s === 'gecti' ? '✓ ' + _('k_gecti') : c.s === 'sorun' ? '✗ ' + _('k_sorun') : '– ' + _('k_atla');
      r.push(`${isr} · ${k} · ${_('kb' + k.slice(1))}${c.not ? ' · ' + c.not : ''}`);
    }
    return r.join('\n');
  }

  // ---------------------------------------------------------------- pano
  function gmPano() {
    try { if (typeof GM_setClipboard === 'function') return (t) => GM_setClipboard(t, 'text'); } catch (_) { /* yok */ }
    return null;
  }
  async function panoyaYaz(metin) {
    const gm = gmPano();
    if (gm) { try { await gm(metin); return 'gm'; } catch (_) { /* sıradaki */ } }
    if (navigator.clipboard && window.isSecureContext) { try { await navigator.clipboard.writeText(metin); return 'pano'; } catch (_) { /* sıradaki */ } }
    const kutu = el('textarea', { readonly: '', 'aria-hidden': 'true', style: 'position:fixed;left:-9999px;top:0;opacity:0' });
    kutu.value = metin;
    (panelAcik() ? bil.panel : kok).appendChild(kutu);
    kutu.select();
    let tamam = false;
    try { tamam = document.execCommand('copy'); } catch (_) { tamam = false; }
    kutu.remove();
    return tamam ? 'exec' : null;
  }
  async function raporuKopyala() {
    const yol = await panoyaYaz(taniRaporu());
    if (yol) bildir('basari', _('raporKopyalandi')); else bildir('hata', _('kopyaHata'));
  }

  // ---------------------------------------------------------------- kabul testi (aalabs.json "kabul" ile aynı maddeler)
  const KABUL = ['K1', 'K2', 'K3', 'K4', 'K5'];
  function kabulOku() {
    const v = depoOku('kabul', null);
    if (!v || v.surum !== SURUM || typeof v.cevaplar !== 'object' || !v.cevaplar) return { surum: SURUM, cevaplar: {} };
    return v;
  }
  function kabulYaz(v) { depoYaz('kabul', v); }

  // ---------------------------------------------------------------- eklenti menüsü
  let menuIdleri = [];
  let menuKayitli = false;
  let idsizMenu = false;
  function menuKaydet() {
    if (typeof GM_registerMenuCommand !== 'function') return;
    const silinebilir = typeof GM_unregisterMenuCommand === 'function' && !idsizMenu;
    if (menuKayitli && !silinebilir) return;   // silinemiyorsa ikinci kez eklenmez (çift satır olmasın)
    try {
      if (silinebilir) for (const id of menuIdleri) { try { GM_unregisterMenuCommand(id); } catch (_) { /* yok */ } }
      menuIdleri = [];
      menuKayitli = true;
      const ekle = (ad, fn, tus) => {
        const id = GM_registerMenuCommand(ad, fn, tus);
        if (id === undefined || id === null) idsizMenu = true; else menuIdleri.push(id);
      };
      ekle(_('menuAyarlar') + (tani.sorunlu ? ' ●' : ''), () => panelAc(), 'a');
      ekle(_('menuScrape'), () => { if (yerSayfasiMi()) scrapeBaslat(); }, 's');
    } catch (_) { /* yönetici menüyü desteklemiyor */ }
  }

  // ---------------------------------------------------------------- Ayarlar penceresi
  let panelBolum = 'scrape';
  let aramaMetni = '';
  let oncekiOdak = null;
  let kayit = null;
  let tusHatasi = '';
  const GMR_BOLUMLER = ['scrape', 'metinMedya', 'dosya'];
  const ORTAK_BOLUMLER = ['genel', 'kisayol', 'tani', 'hakkinda'];
  const BOLUM_ADI = { scrape: 'b_scrape', metinMedya: 'b_metinMedya', dosya: 'b_dosya', genel: 'b_genel', kisayol: 'b_kisayol', tani: 'b_tani', hakkinda: 'b_hakkinda', kabul: 'b_kabul' };

  function panelAcik() { return !!(bil.panel && bil.panel.isConnected); }

  function odakDongusu(e) {
    const ogeler = Array.from(bil.panel.querySelectorAll('button, input:not([type="file"]), [tabindex]:not([tabindex="-1"])'))
      .filter((o) => !o.disabled && o.getClientRects().length);
    if (!ogeler.length) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    const simdiki = ogeler.indexOf(kok.activeElement);
    const sonraki = simdiki < 0 ? 0 : (simdiki + (e.shiftKey ? -1 : 1) + ogeler.length) % ogeler.length;
    ogeler[sonraki].focus();
  }

  function panelAc(bolum) {
    if (!document.body) return;
    kokKur();
    temaUygula();
    if (bolum) panelBolum = bolum;
    if (!panelAcik()) {
      const aktif = document.activeElement;
      oncekiOdak = aktif === ev ? kok.activeElement : aktif;
      bil.perde = el('div', { class: 'perde', onclick: () => panelKapat() });
      bil.panel = el('div', { class: 'panel yazi', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'gmr-baslik', 'data-panel': '' });
      bil.panel.addEventListener('keydown', (e) => {
        if (kayit) return;
        if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); panelKapat(); }
        else if (e.key === 'Tab') odakDongusu(e);
      });
      kok.append(bil.perde, bil.panel);
    }
    panelCiz();
    const hedef = bil.panel.querySelector('.nav .oge[aria-current="true"]') || bil.ara;
    if (hedef) hedef.focus({ preventScroll: true });
  }

  function panelKapat() {
    kayitBitir();
    if (bil.panel && bil.yer && bil.panel.contains(bil.yer)) kok.appendChild(bil.yer);
    if (bil.panel) bil.panel.remove();
    if (bil.perde) bil.perde.remove();
    bil.panel = bil.perde = bil.ara = null;
    aramaMetni = '';
    tusHatasi = '';
    if (panelBolum === 'kabul') panelBolum = 'tani';
    const hedef = oncekiOdak;
    oncekiOdak = null;
    if (hedef && hedef.isConnected && typeof hedef.focus === 'function') { try { hedef.focus({ preventScroll: true }); } catch (_) { /* yok */ } }
  }

  function ayarDegis(k, v) {
    ayar[k] = v;
    ayarYaz();
    if (k === 'dil') { menuKaydet(); }
    if (k === 'tema' || k === 'olcek') temaUygula();
    kartCiz();
    panelCiz();
  }

  function bolumSifirla(bolum) {
    for (const k of BOLUM_ANAHTAR[bolum] || []) ayar[k] = VARSAYILAN[k];
    ayarYaz();
    menuKaydet();
    temaUygula();
    tusHatasi = '';
    kartCiz();
    panelCiz();
    bildir('basari', _('sifirlandi'));
  }

  let etiketSayac = 0;
  function ayarSatiri(ad, aciklama, denetimKur) {
    const id = 'e' + (++etiketSayac);
    const s = el('div', { class: 'ayar' }, el('span', { class: 'a', id }, ad), el('div', { class: 'deg' }, denetimKur(id)));
    if (aciklama) s.append(el('small', {}, aciklama));
    return s;
  }
  function anahtar(k, etiketId) {
    return el('button', { class: 'anahtar', type: 'button', role: 'switch', 'aria-checked': String(!!ayar[k]), 'aria-labelledby': etiketId,
      'data-ayar': k, onclick: () => ayarDegis(k, !ayar[k]) });
  }
  function segment(k, secenekler, etiketId) {
    const g = el('div', { class: 'seg', role: 'radiogroup', 'aria-labelledby': etiketId, 'data-ayar': k });
    for (const [deger, yazi] of secenekler) {
      g.append(el('button', { type: 'button', role: 'radio', 'aria-checked': String(ayar[k] === deger), 'data-deger': String(deger),
        onclick: () => ayarDegis(k, deger) }, yazi));
    }
    return g;
  }
  function sifirlaDugmesi(bolum) {
    return el('div', { class: 'satir-btn' }, el('button', { class: 'd', type: 'button', 'data-sifirla': bolum, onclick: () => bolumSifirla(bolum) }, _('varsayilan')));
  }

  function bolumMetni(b) {
    const anahtarlar = {
      scrape: ['b_scrape', 'aSirala', 'aHiz', 'aBekle', 'aSiralaA', 'aBekleA'],
      metinMedya: ['b_metinMedya', 'aOzgun', 'aHd', 'aOzgunA', 'aHdA'],
      dosya: ['b_dosya', 'aBildir', 'aBildirA'],
      genel: ['b_genel', 'dil', 'tema', 'olcek', 'dil_tarayici', 'tema_sayfa'],
      kisayol: ['b_kisayol', 'k_ayarlar', 'k_scrape', 'k_panel'],
      tani: ['b_tani', 'raporKopyala', 'b_kabul', 't_yanit', 't_video', 't_ceviri'],
      hakkinda: ['b_hakkinda', 'yedek', 'yedekle', 'geriYukle', 'store'],
    }[b] || [];
    return katla(anahtarlar.map((k) => _(k)).join(' '));
  }

  function odakSeciciBul(o) {
    if (!o || o === bil.ara || !o.getAttribute) return '';
    const q = (ad) => `[${ad}="${CSS.escape(o.getAttribute(ad))}"]`;
    if (o.hasAttribute('data-deger') && o.parentElement && o.parentElement.hasAttribute('data-ayar')) {
      return `[data-ayar="${CSS.escape(o.parentElement.getAttribute('data-ayar'))}"] ${q('data-deger')}`;
    }
    if (o.hasAttribute('data-cevap')) return `${q('data-madde')}${q('data-cevap')}`;
    for (const ad of ['data-ayar', 'data-bolum', 'data-sifirla', 'data-kisayol', 'data-kisayol-sil', 'data-rapor', 'data-kabul', 'data-yedekle', 'data-geri-yukle', 'data-not']) {
      if (o.hasAttribute(ad)) return q(ad);
    }
    return '';
  }

  function panelCiz() {
    kayitBitir();
    if (!panelAcik()) return;
    etiketSayac = 0;
    const p = bil.panel;
    const aramaOdakta = kok.activeElement === bil.ara;
    const imlec = bil.ara ? bil.ara.selectionStart : null;
    const odakSecici = odakSeciciBul(kok.activeElement);
    const yerVar = p.contains(bil.yer);
    p.replaceChildren();
    p.setAttribute('lang', dilKodu());
    const kapat = el('button', { class: 'd ik duz', type: 'button', title: _('kapat'), 'aria-label': _('kapat'), onclick: () => panelKapat() }, ikon('kapat'));
    p.append(el('div', { class: 'ust' }, el('span', { class: 'kb', 'aria-hidden': 'true' }, KOD), el('h2', { id: 'gmr-baslik' }, _('ayarlar')), kapat));

    const arama = el('input', { type: 'search', placeholder: _('ara'), 'aria-label': _('ara') });
    arama.value = aramaMetni;
    arama.addEventListener('input', (e) => { if (e.isComposing) return; aramaMetni = arama.value; panelCiz(); });
    arama.addEventListener('compositionend', () => { aramaMetni = arama.value; panelCiz(); });
    bil.ara = arama;
    const nav = el('nav', { class: 'nav', 'aria-label': _('ayarlar') }, arama);
    const sorgu = katla(aramaMetni.trim());
    const uyan = (b) => !sorgu || bolumMetni(b).includes(sorgu);
    const gorunen = [...GMR_BOLUMLER, ...ORTAK_BOLUMLER].filter(uyan);
    if (panelBolum !== 'kabul' && gorunen.length && !gorunen.includes(panelBolum)) panelBolum = gorunen[0];
    const oge = (b) => {
      const ad = _(BOLUM_ADI[b]);
      const etkin = panelBolum === b || (panelBolum === 'kabul' && b === 'tani');
      const d2 = el('button', { class: 'oge', type: 'button', title: ad, 'aria-current': String(etkin), 'data-bolum': b,
        onclick: () => { panelBolum = b; tusHatasi = ''; panelCiz(); } }, el('span', {}, ad));
      if (b === 'tani' && tani.sorunlu) d2.append(el('span', { class: 'nokta', 'aria-hidden': 'true' }), el('span', { class: 'gizli' }, ' · ' + _('taniKotu', { n: 1 })));
      return d2;
    };
    const g = GMR_BOLUMLER.filter(uyan);
    const o = ORTAK_BOLUMLER.filter(uyan);
    if (g.length) nav.append(el('div', { class: 'grup' }, KOD), ...g.map(oge));
    if (o.length) nav.append(el('div', { class: 'grup' }, _('ortak')), ...o.map(oge));
    if (!gorunen.length) nav.append(el('div', { class: 'yok', role: 'status' }, _('sonucYok')));

    const ic = el('div', { class: 'icerik', 'data-icerik': panelBolum });
    if (gorunen.length || panelBolum === 'kabul') {
      ic.append(el('h3', {}, _(BOLUM_ADI[panelBolum])));
      ({ scrape: bolumScrape, metinMedya: bolumMetinMedya, dosya: bolumDosya, genel: bolumGenel, kisayol: bolumKisayol,
        tani: bolumTani, hakkinda: bolumHakkinda, kabul: bolumKabul })[panelBolum](ic);
    }
    p.append(el('div', { class: 'govde' }, nav, ic), el('div', { class: 'pa' }, el('span', {}, _('penAlt')), el('span', {}, 'Esc · ' + _('kapat').replace(/\s*\(Esc\)/, ''))));
    if (yerVar) p.appendChild(bil.yer);
    if (aramaOdakta) {
      arama.focus({ preventScroll: true });
      if (imlec !== null) try { arama.setSelectionRange(imlec, imlec); } catch (_) { /* yok */ }
    } else if (odakSecici) {
      let hedef = null;
      try { hedef = p.querySelector(odakSecici); } catch (_) { hedef = null; }
      if (hedef) hedef.focus({ preventScroll: true });
    }
  }

  function bolumScrape(ic) {
    ic.append(ayarSatiri(_('aSirala'), _('aSiralaA'), (id) => anahtar('sirala', id)));
    ic.append(ayarSatiri(_('aHiz'), _('aHizA'), (id) => segment('hiz', [['hizli', _('hiz_hizli')], ['normal', _('hiz_normal')], ['yavas', _('hiz_yavas')]], id)));
    ic.append(ayarSatiri(_('aBekle'), _('aBekleA'), (id) => {
      const k = el('input', { class: 'sayikutu', type: 'number', min: '3', max: '60', step: '1', 'aria-labelledby': id, 'data-ayar': 'bekle' });
      k.value = String(ayar.bekle);
      k.addEventListener('change', () => {
        const n = Math.round(Number(k.value));
        if (Number.isFinite(n)) ayarDegis('bekle', Math.min(60, Math.max(3, n))); else k.value = String(ayar.bekle);
      });
      return [k, el('span', {}, _('tur'))];
    }));
    ic.append(sifirlaDugmesi('scrape'));
  }
  function bolumMetinMedya(ic) {
    ic.append(ayarSatiri(_('aOzgun'), _('aOzgunA'), (id) => anahtar('ozgun', id)));
    ic.append(ayarSatiri(_('aHd'), _('aHdA'), (id) => anahtar('hd', id)));
    ic.append(sifirlaDugmesi('metinMedya'));
  }
  function bolumDosya(ic) {
    ic.append(ayarSatiri(_('aBildir'), _('aBildirA'), (id) => anahtar('bildir', id)));
    ic.append(sifirlaDugmesi('dosya'));
  }
  function bolumGenel(ic) {
    ic.append(ayarSatiri(_('tema'), _('temaA'), (id) => segment('tema', [['sayfa', _('tema_sayfa')], ['acik', _('tema_acik')], ['koyu', _('tema_koyu')]], id)));
    ic.append(ayarSatiri(_('dil'), _('algilanan', { dil: tarayiciDili() === 'tr' ? 'Türkçe' : 'English' }),
      (id) => segment('dil', [['tarayici', _('dil_tarayici')], ['tr', _('dil_tr')], ['en', _('dil_en')]], id)));
    ic.append(ayarSatiri(_('olcek'), _('olcekA'), (id) => segment('olcek', SECENEK.olcek.map((n) => [n, dilKodu() === 'tr' ? '%' + n : n + '%']), id)));
    ic.append(sifirlaDugmesi('genel'));
  }

  function bolumKisayol(ic) {
    ic.append(el('p', { class: 'not' }, _('kisayolNot')));
    for (const [k, adK] of [['kisayolAyarlar', 'k_ayarlar'], ['kisayolScrape', 'k_scrape'], ['kisayolPanel', 'k_panel']]) {
      const tus = el('button', { class: 'tus' + (ayar[k] ? '' : ' bos'), type: 'button', 'data-kisayol': k }, ayar[k] || _('atanmadi'));
      tus.addEventListener('click', () => kayitBasla(tus, k));
      const sil = ayar[k] && k !== 'kisayolAyarlar' ? el('button', { class: 'd k', type: 'button', 'data-kisayol-sil': k, onclick: () => { ayarDegis(k, ''); bildir('basari', _('tusSilindi')); } }, _('tusSil')) : null;
      ic.append(ayarSatiri(_(adK), '', (id) => { tus.setAttribute('aria-labelledby', id); return [tus, sil]; }));
    }
    if (tusHatasi) ic.append(el('div', { class: 'uyari-satir', role: 'alert' }, tusHatasi));
    ic.append(sifirlaDugmesi('kisayol'));
  }

  function kayitBasla(tus, k) {
    kayitBitir();
    try { tus.focus({ preventScroll: true }); } catch (_) { /* yok */ }   // Firefox/Safari tıklamada odak vermez; blur ile kayıt bitsin
    tus.classList.add('kayit');
    tus.textContent = _('tusaBas');
    const dinle = (e) => {
      if (!e.isTrusted && !TEST) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      if (e.repeat) return;
      if (e.key === 'Escape') { kayitBitir(); panelCiz(); return; }
      if (e.key === 'Tab') { kayitBitir(); panelCiz(); return; }
      const kombo = tusKombo(e);
      if (!kombo) return;                      // yalnız değiştirici: beklemeye devam
      let neden = tusGecerliMi(kombo);
      if (!neden && KISAYOL_ANAHTAR.some((x) => x !== k && ayar[x] === kombo)) neden = 'neden_ayni';
      kayitBitir();
      if (neden) { tusHatasi = _('tusRed', { tus: kombo, neden: _(neden) }); panelCiz(); return; }
      tusHatasi = '';
      ayarDegis(k, kombo);
      bildir('basari', _('tusDegisti', { tus: kombo }));
    };
    kayit = { dinle, tus };
    window.addEventListener('keydown', dinle, true);
    tus.addEventListener('blur', () => { if (kayit && kayit.tus === tus) { kayitBitir(); panelCiz(); } }, { once: true });
  }
  function kayitBitir() {
    if (!kayit) return;
    window.removeEventListener('keydown', kayit.dinle, true);
    kayit = null;
  }

  function bolumTani(ic) {
    const satirlar = taniSatirlari();
    const kotu = satirlar.filter((x) => x.durum === 'kotu').length;
    const yazi = !tani.yapildi ? _('taniBekle') : kotu ? _('taniKotu', { n: kotu }) : _('taniIyi');
    ic.append(el('div', { class: 'bilgikutu' + (kotu ? ' kotu' : ''), role: 'status' }, yazi));
    const t = el('div', { class: 'tani', 'data-tani': '' });
    for (const x of satirlar) {
      t.append(el('span', { class: x.durum, 'aria-hidden': 'true' }, x.durum === 'iyi' ? '✓' : x.durum === 'kotu' ? '✗' : '–'),
        el('div', {}, x.ad, el('small', {}, x.ayrinti)));
    }
    const cev = kabulOku();
    ic.append(t, el('div', { class: 'satir-btn' },
      el('button', { class: 'd', type: 'button', 'data-kabul': '', onclick: () => { panelBolum = 'kabul'; panelCiz(); } },
        _('kabulAc') + ` · ${Object.keys(cev.cevaplar).length}/${KABUL.length}`),
      el('button', { class: 'd ana', type: 'button', 'data-rapor': '', onclick: () => raporuKopyala() }, ikon('kopyala'), _('raporKopyala'))));
  }

  function bolumKabul(ic) {
    const cev = kabulOku();
    ic.append(el('p', { class: 'not' }, _('kabulNot')), el('div', { class: 'bilgikutu', role: 'status', 'data-kabul-sayi': '' },
      _('kabulSayi', { n: Object.keys(cev.cevaplar).length, m: KABUL.length })));
    for (const k of KABUL) {
      const c = cev.cevaplar[k] || {};
      const no = k.slice(1);
      const yaz = (degisiklik) => { const v = kabulOku(); v.cevaplar[k] = Object.assign({}, v.cevaplar[k] || {}, degisiklik); kabulYaz(v); };
      const seg = el('div', { class: 'seg', role: 'radiogroup', 'aria-label': `${k} · ${_('kb' + no)}` });
      for (const [deger, yazi] of [['gecti', _('k_gecti')], ['sorun', _('k_sorun')], ['atla', _('k_atla')]]) {
        seg.append(el('button', { type: 'button', role: 'radio', 'aria-checked': String(c.s === deger), 'data-madde': k, 'data-cevap': deger,
          onclick: () => { yaz({ s: deger, not: deger === 'sorun' ? (c.not || '') : '' }); panelCiz(); } }, yazi));
      }
      const madde = el('div', { class: 'madde', 'data-madde-kutu': k },
        el('div', { class: 'soru' }, `${k} · ${_('kb' + no)}`),
        el('div', { class: 'ipucu' }, el('b', {}, _('nasil')), ' ', _('kb' + no + 'i')), seg);
      if (c.s === 'sorun') {
        const not = el('input', { type: 'text', maxlength: '200', placeholder: _('k_not'), 'aria-label': _('k_not'), 'data-not': k });
        not.value = c.not || '';
        not.addEventListener('change', () => yaz({ not: not.value.slice(0, 200) }));
        madde.append(not);
      }
      ic.append(madde);
    }
    ic.append(el('div', { class: 'satir-btn' },
      el('button', { class: 'd', type: 'button', onclick: () => { kabulYaz({ surum: SURUM, cevaplar: {} }); panelCiz(); bildir('basari', _('kabulSilindi')); } }, _('kabulSil')),
      el('button', { class: 'd', type: 'button', onclick: () => { panelBolum = 'tani'; panelCiz(); } }, _('kabulGeri')),
      el('button', { class: 'd ana', type: 'button', 'data-rapor': '', onclick: () => raporuKopyala() }, ikon('kopyala'), _('raporKopyala'))));
  }

  function bolumHakkinda(ic) {
    ic.append(el('p', { style: 'margin:0' }, el('b', {}, `${AD}`), ' · ', _('surum', { s: SURUM })), el('p', { class: 'not', style: 'margin:0' }, _('store')));
    ic.append(el('p', { class: 'not', style: 'margin:0' }, _('menuIpucu')));
    ic.append(el('h3', { style: 'font-size:13px' }, _('yedek')), el('p', { class: 'not', style: 'margin:0' }, _('yedekAc')));
    ic.append(el('p', { class: 'not', style: 'margin:0', 'data-son-yedek': '' }, ayar.sonYedek ? _('sonYedek', { t: ayar.sonYedek }) : _('sonYedekYok')));
    const dosya = el('input', { type: 'file', accept: '.json,application/json', class: 'gizli', 'aria-hidden': 'true', tabindex: '-1' });
    dosya.addEventListener('change', () => { if (dosya.files && dosya.files[0]) geriYukle(dosya.files[0]); });
    ic.append(dosya, el('div', { class: 'satir-btn sol' },
      el('button', { class: 'd', type: 'button', 'data-yedekle': '', onclick: () => yedekle() }, _('yedekle')),
      el('button', { class: 'd', type: 'button', 'data-geri-yukle': '', onclick: () => dosya.click() }, _('geriYukle'))));
  }

  function zamanDamgasi() {
    const t = new Date();
    const p = (n) => String(n).padStart(2, '0');
    return `${t.getFullYear()}-${p(t.getMonth() + 1)}${p(t.getDate())}-${p(t.getHours())}${p(t.getMinutes())}`;
  }
  function yedekle() {
    const damga = zamanDamgasi();
    const ayarKopya = Object.assign({}, ayar);
    delete ayarKopya.sonYedek;
    indir(JSON.stringify({ uygulama: ID, surum: SURUM, tarih: damga, ayarlar: ayarKopya }, null, 2), `AALabs.${ID}-ayarlar-${damga}.json`, 'application/json');
    ayar.sonYedek = damga;
    ayarYaz();
    panelCiz();
    bildir('basari', _('yedeklendi'));
  }
  function geriYukle(dosya) {
    if (dosya.size > 64 * 1024) { bildir('hata', _('yedekHata')); return; }
    const okuyucu = new FileReader();
    okuyucu.onload = () => {
      try {
        const v = JSON.parse(String(okuyucu.result));
        if (!v || v.uygulama !== ID || !v.ayarlar || typeof v.ayarlar !== 'object' || Array.isArray(v.ayarlar)) throw new Error('biçim');
        const sonYedek = ayar.sonYedek;
        ayar = ayarDogrula(Object.assign({}, ayar, v.ayarlar));
        ayar.sonYedek = sonYedek;
        ayarYaz();
        menuKaydet();
        temaUygula();
        kartCiz();
        panelCiz();
        bildir('basari', _('geriYuklendi'));
      } catch (_e) { bildir('hata', _('yedekHata')); }
    };
    okuyucu.onerror = () => bildir('hata', _('yedekHata'));
    okuyucu.readAsText(dosya);
  }

  // ---------------------------------------------------------------- klavye kısayolları (belge düzeyinde)
  function duzenlenebilirMi(o) {
    return !!(o && (o.isContentEditable || (o.closest && o.closest('input, textarea, select, [contenteditable=""], [contenteditable="true"]'))));
  }
  window.addEventListener('keydown', (e) => {
    if (kayit || e.repeat) return;
    const kombo = tusKombo(e);
    if (!kombo) return;
    const hedef = e.target === ev ? kok.activeElement : ((e.composedPath && e.composedPath()[0]) || e.target);
    const yazida = duzenlenebilirMi(hedef);
    if (yazida && !(e.ctrlKey || e.metaKey)) return;     // yazı alanında yalnız Ctrl/Meta'lı kombo
    const eylem = KISAYOL_ANAHTAR.find((k) => ayar[k] && ayar[k] === kombo);
    if (!eylem) return;
    if (eylem !== 'kisayolAyarlar' && (!yerSayfasiMi() || panelAcik())) return;
    e.preventDefault();
    e.stopPropagation();
    if (eylem === 'kisayolAyarlar') { if (panelAcik()) panelKapat(); else panelAc(); }
    else if (eylem === 'kisayolScrape') scrapeBaslat();
    else if (eylem === 'kisayolPanel') { ayar.kucuk = !ayar.kucuk; ayarYaz(); kartCiz(); }
  }, true);

  // ---------------------------------------------------------------- açılış
  let sonAdres = '';
  function izle() {
    if (!document.body) return;
    if (ev && !ev.isConnected) document.body.appendChild(ev);   // sayfa gövdeyi yenilediyse geri tak
    const adres = location.pathname;
    if (adres !== sonAdres) { sonAdres = adres; if (!calisiyor && durum.kip !== 'bos' && !yerSayfasiMi()) durumYaz({ kip: 'bos', adim: -1, sonuc: null }); kartCiz(); return; }
    if (!calisiyor && bil.kart && !ayar.kucuk && yerSayfasiMi()) {
      // işletme adı ya da Google toplamı değiştiyse kartı yenile (ucuz: iki metin okuması)
      const isim = isletmeAdi();
      const yaziO = bil.kart.querySelector('[data-isletme]');
      if (yaziO && durum.kip === 'bos' && yaziO.textContent !== isim) kartCiz();
    }
    temaUygula();
  }
  function basla() {
    menuKaydet();
    kartCiz();
    setInterval(izle, 1000);
  }

  if (TEST) {
    window.__AALABS_TEST__.gmr = {
      kok: () => kok, ayar: () => ayar, tani: () => tani, durum: () => durum, METIN, carpan: (n) => { ZC = n; },
      rapor: () => taniRaporu(), panelAc: (b) => panelAc(b),
    };
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', basla, { once: true });
  else basla();
  try { console.info(`[${AD} ${SURUM}] etkin`); } catch (_) { /* yok */ }
})();
