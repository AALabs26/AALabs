.sayikutu { width: 64px; height: 28px; padding: 0 8px; border: 1px solid var(--kenar); border-radius: var(--kose-m); background: var(--yuzey); color: var(--metin); }
.tus { min-width: 104px; height: 28px; padding: 0 8px; border: 1px solid var(--kenar); border-radius: var(--kose-m); background: var(--zemin); font-weight: 600; cursor: pointer; }
