.tani { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 6px; align-items: start; }
.tani .iyi { color: var(--basari); font-weight: 700; }
.tani .kotu { color: var(--hata); font-weight: 700; }
.tani .notr { color: var(--metin-ikincil); font-weight: 700; }
.tani small { display: block; color: var(--metin-ikincil); font: 11px/1.4 Consolas, "Cascadia Mono", monospace; overflow-wrap: anywhere; }
.madde { display: grid; gap: 6px; padding: 0 0 10px; border-bottom: 1px solid var(--ayirici); }
.madde .soru { font-weight: 600; }
.madde .ipucu { font-size: 12px; color: var(--metin-ikincil); }
.madde input[type="text"] { height: 28px; padding: 0 8px; border: 1px solid var(--kenar); border-radius: var(--kose-m); background: var(--yuzey); color: var(--metin); width: 100%; }
.pa { display: flex; justify-content: space-between; gap: 8px; padding: 8px 12px; border-top: 1px solid var(--ayirici);
  font-size: 12px; color: var(--metin-ikincil); align-items: center; flex-wrap: wrap; }
.gizli { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
@media (max-width: 560px) { .govde { grid-template-columns: minmax(0, 1fr); } .nav { max-height: 160px; border-right: 0; border-bottom: 1px solid var(--ayirici); } }
@media (prefers-reduced-motion: reduce) { .kutu, .anahtar::after { transition: none; } }
