// ==UserScript==
// @name         AALabs Google Maps Review Scraper
// @namespace    aalabs
// @version      3.1.1
// @description  Google Maps işletme yorumlarını en yeniden eskiye scrape eder. Özgün ve çeviri metni, medya, sahip yanıtı ve yıldız toplamlarını JSON olarak indirir.
// @author       AALabs
// @match        https://www.google.com/maps/*
// @match        https://www.google.com.tr/maps/*
// @icon         data:image/png;base64,
// @run-at       document-idle
// @noframes
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_unregisterMenuCommand
// @grant        GM_setClipboard
// @grant        GM_notification
// @grant        GM_info
// @aalabs-ikon  GMR
// ==/UserScript==

/*
 * Ne yapar
 *   Google Maps'te bir işletmenin bütün yorumlarını en yeniden eskiye scrape eder ve JSON indirir.
 *   Her yorum: yorumcu, yıldız, tarih, özgün metin ve dili, çeviri metni, medya (fotoğraf + video),
 *   sahip yanıtı, beğeni, yorum kimliği. Ayrıca Google'ın yıldız toplamları ve sayı denetimi.
 *
 * Seçiciler (2026-10-21, gerçek Maps sayfasında ölçüldü)
 *   Yorum kartı      div.jftiEf[data-review-id]  (aynı kimlik iç düğmelerde de var; en dış öğe alınır)
 *   Metin            .MyEned .wiI7pd (lang özniteliği dil kodunu verir)
 *   Çeviri düğmesi   button[role=switch][jsaction*=showReviewInOriginal]  aria-checked="true" = çeviri görünüyor
 *   Sahip yanıtı     .CDe7pd > div.wiI7pd (metin) + .DZSIDd (tarih)   — 3.0.0 span ve .rsqaWe arıyordu: 0 buluyordu
 *   Medya            button.Tya61d: arka plan resmi. aria-label "Video" + .e5A3N süre → video.
 *                    Video dosyası = resim adresi + "=m22" (mp4). Fotoğraf aslı = "=s0". "+ N more photos" → gizli medya.
 *   Yıldız toplamı   tr.BHOKXe aria-label "5 stars, 13,768 reviews"; Google toplamı .jANrlb .fontBodySmall
 *
 * 3.1.0 (app-lab v02.02): AALabs adı ve ortak Ayarlar (Ctrl+,), kart paneli, Türkçe + İngilizce, tema,
 * Tanı + Kabul testi, Durdur ve kaydet, sayı denetimi, bitince bildirim; sahip yanıtı ve video düzeltmesi.
 * Tasarım kapısı: Panel B · Ayarlar S1 · Ad N2 · E1 E3 E5 · Ç1–Ç5 · K1–K5.
 */
(function () {
  'use strict';

  const SURUM = '3.1.1';
  const ID = 'GoogleMapsReviewScraper';
  const KOD = 'GMR';
  const AD = 'AALabs Google Maps Review Scraper';
  const KISA_AD = 'Review Scraper';

  // ---------------------------------------------------------------- test kancası (yalnız sahte sayfada)
  let TEST = false;
  try { TEST = typeof GM_info === 'object' && !!GM_info && GM_info.scriptHandler === 'Test' && !!window.__AALABS_TEST__; } catch (_) { TEST = false; }
  let ZC = 1;   // zaman çarpanı: testte bekleme süreleri kısalır

  // ---------------------------------------------------------------- tema (tokenlardan üretildi)
  // Bu blok aalabs-tema.css'ten yazılır. Elle değiştirme.
  // TOKEN-BASLA
  // Kaynak: /* AALabs tasarım dili 1.4.1 — aalabs.tokens.json'dan üretildi. Elle değiştirme. */
