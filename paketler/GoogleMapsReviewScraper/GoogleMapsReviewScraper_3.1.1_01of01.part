.nokta { width: 8px; height: 8px; border-radius: 50%; background: var(--hata); flex: none; display: inline-block; }
.kb { display: inline-grid; place-items: center; height: 24px; min-width: 36px; padding: 0 6px; border-radius: var(--kose-s);
