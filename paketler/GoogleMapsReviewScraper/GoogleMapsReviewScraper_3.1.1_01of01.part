          calis ? el('div', { class: 'adimlar' }, ADIMLAR.map((a, i) => el('span', { class: i < adimDurum ? 'bitti' : (i === adimDurum && durum.kip === 'calis' ? 'simdi' : '') }, _(a)))) : null,
