    if (!kayit || !Number.isFinite(kayit.t)) return;
    if (Number.isFinite(kayit.d) && Math.abs(kayit.d - v.duration) > 2) return; // başka video
    if (kayit.t < 15 || kayit.t > v.duration - 20 || Math.abs(v.currentTime - kayit.t) < 5) return;
    try { v.currentTime = kayit.t; } catch (_hata) { return; }
    if (k.ui) {
      k.ui.bilgiMetin.textContent = m('devam', sure(kayit.t));
      k.ui.bilgi.hidden = false;
      clearTimeout(k.bilgiZaman);
      k.bilgiZaman = setTimeout(() => { if (k.ui) k.ui.bilgi.hidden = true; }, 8000);
    }
  }
  function devamKaydet(k, simdi) {
    if (!AYAR.devam || k.kip !== 'degistir' || !k.devamAnahtar) return;
    const v = k.v;
    if (!Number.isFinite(v.duration) || v.duration < 60 || v.currentTime < 15) return;
    const zaman = Date.now();
    if (!simdi && zaman - k.devamKaydi < 5000) return;
    k.devamKaydi = zaman;
    const l = devamListesi();
    l[k.devamAnahtar] = { t: Math.round(v.currentTime), d: Math.round(v.duration), z: zaman };
    const anahtarlar = Object.keys(l);
    if (anahtarlar.length > 300) {
      anahtarlar.sort((a, b) => (l[a].z || 0) - (l[b].z || 0)).slice(0, anahtarlar.length - 300).forEach(a => delete l[a]);
    }
    depoYaz('devam', l);
  }
  function devamSil(k) {
    const l = devamListesi();
    if (k.devamAnahtar && l[k.devamAnahtar]) { delete l[k.devamAnahtar]; depoYaz('devam', l); }
    if (k.ui) k.ui.bilgi.hidden = true;
  }
  // ---------------------------------------------------------------- önizleme karesi
  function onizSok(k) {
    const pv = k.onizVideo;
    k.onizVideo = null; k.onizSrc = null; k.onizBekleyen = null; k.onizMesgul = false;
    if (k.ui) k.ui.kareKutu.replaceChildren();
    if (pv) { try { pv.removeAttribute('src'); pv.load(); } catch (_hata) { /* yok */ } }
  }
  function onizHazirla(k) {
    if (!AYAR.onizleme || !k.ui) return;
    if (!k.kucukResimArandi) { k.kucukResimArandi = true; kucukResimAra(k); }
    if (k.kucukResim) return; // sitenin küçük resimleri varken ikinci video açılmaz
    const src = k.v.currentSrc || k.v.src;
    if (k.onizVideo && k.onizSrc === src) return;
    onizSok(k);
    if (!src || src.startsWith('blob:') || k.onizHata === src) return;
    const pv = document.createElement('video');
    pv.muted = true; pv.preload = 'metadata'; pv.playsInline = true;
    pv.setAttribute('aria-hidden', 'true');
    if (k.v.crossOrigin) pv.crossOrigin = k.v.crossOrigin;
    pv.addEventListener('seeked', () => {
      if (k.onizVideo !== pv) return;
      k.onizMesgul = false;
      const t = k.onizBekleyen;
      k.onizBekleyen = null;
      if (t != null) onizSar(k, t);
    });
    pv.addEventListener('error', () => {
      if (k.onizVideo !== pv) return;
      k.onizHata = src; // bu kaynak için yeniden denenmez
      onizSok(k); arayuzGuncelle(k);
    });
    pv.src = src;
    k.onizVideo = pv; k.onizSrc = src;
    k.ui.kareKutu.replaceChildren(pv);
  }
  // Sitenin oynatıcısının kullandığı küçük resim VTT'si: JW Player, video.js, <track>, sayfa betikleri.
  const VTT_ADI = /(thumb|sprite|preview|storyboard|seek|scrub)/i;
  function kucukResimAdaylari(k) {
    const l = [];
    const ekleA = (url, yer) => { if (url && typeof url === 'string' && /\.vtt(\?|#|$)/i.test(url)) l.push([url, yer]); };
    try {
      for (const t of k.v.querySelectorAll('track')) {
        const tur = (t.kind || '').toLowerCase();
        if (tur === 'metadata' || tur === 'thumbnails' || VTT_ADI.test(t.label || '') || VTT_ADI.test(t.src || '')) ekleA(t.src, '<track>');
      }
    } catch (_hata) { /* yok */ }
    try {
      const jw = W.jwplayer;
      const jk = k.v.closest('.jwplayer');
      if (typeof jw === 'function' && jk) {
        const p = jw(jk.id) || jw();
        const oge = p && p.getPlaylistItem && p.getPlaylistItem();
        for (const t of (oge && oge.tracks) || []) if (String(t.kind).toLowerCase() === 'thumbnails') ekleA(t.file, 'JW Player');
      }
    } catch (_hata) { /* yok */ }
    try {
      const p = k.vjs || vjsBul(k);
      if (p) {
        const o = p.options_ || {};
        const eklenti = (o.plugins && (o.plugins.vttThumbnails || o.plugins.thumbnails)) || {};
        ekleA(eklenti.src || eklenti.url, 'video.js');
        if (p.vttThumbnails && p.vttThumbnails.options) ekleA(p.vttThumbnails.options.src, 'video.js');
        const iz = p.textTracks ? p.textTracks() : [];
        for (let i = 0; i < iz.length; i++) if (VTT_ADI.test(iz[i].label || '') || iz[i].kind === 'metadata') ekleA(iz[i].src, 'video.js');
      }
    } catch (_hata) { /* yok */ }
    try {
      const re = /["'`]((?:https?:)?\/\/[^"'`\s]+?\.vtt[^"'`\s]*|\/[^"'`\s]+?\.vtt[^"'`\s]*)["'`]/gi;
      for (const s of document.scripts) {
        const metin = s.textContent || '';
        if (!metin || metin.length > 500000) continue;
        let m_;
        while ((m_ = re.exec(metin))) if (VTT_ADI.test(m_[1])) ekleA(m_[1].replace(/\\\//g, '/'), 'sayfa betiği');
      }
    } catch (_hata) { /* yok */ }
    return l;
  }
  async function vttGetir(url) {
    const yollar = [];
    try { if (W !== window && typeof W.fetch === 'function') yollar.push(u => W.fetch(u, sayfayaKopya({ credentials: 'include' }))); } catch (_hata) { /* yok */ }
    yollar.push(u => fetch(u, { credentials: 'include' }));
    for (const yol of yollar) {
      try {
        const y = await yol(url);
        if (y.ok) return await y.text();
        return null; // sunucu cevap verdi: başka yol denenmez
      } catch (_hata) { /* sonraki yol */ }
    }
    return null;
  }
  function sayfayaKopya(o) { try { if (typeof cloneInto === 'function') return cloneInto(o, W); } catch (_hata) { /* yok */ } return o; }
  async function kucukResimAra(k) {
    const adaylar = kucukResimAdaylari(k);
    if (!adaylar.length) {
      // Oynatıcı ayarını geç kurabilir: bir kez daha bakılır.
      if (!k.kucukResimIkinci) { k.kucukResimIkinci = true; setTimeout(() => { if (k.ui) kucukResimAra(k); }, 2500); }
      return;
    }
    for (const [url, yer] of adaylar) {
      let mutlak;
      try { mutlak = new URL(url, location.href).href; } catch (_hata) { continue; }
      const metin = await vttGetir(mutlak);
      if (!metin || !k.ui) continue;
      const kareler = [];
      for (const b of metin.replace(/\r\n?/g, '\n').split(/\n\s*\n/)) {
        const sat = b.split('\n');
        const i = sat.findIndex(x => x.includes('-->'));
        if (i < 0 || !sat[i + 1]) continue;
        const [a, z] = sat[i].split('-->');
        const bas = zamanCoz(a), son = zamanCoz(z);
        const hedef = sat[i + 1].trim();
        const xy = /#xywh=(\d+),(\d+),(\d+),(\d+)/.exec(hedef);
        let resim;
        try { resim = new URL(hedef.replace(/#.*$/, ''), mutlak).href; } catch (_hata) { continue; }
        if (Number.isFinite(bas) && Number.isFinite(son)) {
          kareler.push({ bas, son, resim, x: xy ? +xy[1] : 0, y: xy ? +xy[2] : 0, w: xy ? +xy[3] : 0, h: xy ? +xy[4] : 0 });
        }
      }
      if (kareler.length) {
        k.kucukResim = kareler; k.kucukResimYer = yer;
        onizSok(k);
        const d = ogeKur('div', { sinif: 'serit' });
        k.ui.kareKutu.replaceChildren(d);
        k.kucukResimEl = d;
        arayuzGuncelle(k);
        return;
      }
    }
  }
  function kucukResimGoster(k, t) {
    const l = k.kucukResim, d = k.kucukResimEl;
    if (!l || !d) return;
    let a = 0, b = l.length - 1, bulunan = l[0];
    while (a <= b) { const o = (a + b) >> 1; if (l[o].bas <= t) { bulunan = l[o]; a = o + 1; } else b = o - 1; }
    const kutu = 156; // .kare iç genişliği (160 - 2×2 kenar)
    if (bulunan.w && bulunan.h) {
      // Tek kare kendi boyunda kesilir, sonra kutu genişliğine ölçeklenir.
      const olcek = kutu / bulunan.w;
      d.style.backgroundImage = `url("${bulunan.resim.replace(/"/g, '%22')}")`;
      d.style.backgroundSize = '';
      d.style.width = `${bulunan.w}px`; d.style.height = `${bulunan.h}px`;
      d.style.transformOrigin = '0 0'; d.style.transform = `scale(${olcek})`;
      d.style.backgroundPosition = `${-bulunan.x}px ${-bulunan.y}px`;
    } else {
      d.style.backgroundImage = `url("${bulunan.resim.replace(/"/g, '%22')}")`;
      d.style.backgroundPosition = 'center'; d.style.backgroundSize = 'contain';
      d.style.width = '100%'; d.style.height = '100%'; d.style.transform = '';
    }
  }
  function onizSar(k, t) {
    const pv = k.onizVideo;
    if (!pv) return;
