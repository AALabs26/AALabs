      rozet: '#F2B33D', rozetMetin: '#3A2600', kareZemin: '#1C2433', bilgi: '#1D2C4F', beyaz: '#FFFFFF',
      hover: 'rgba(255,255,255,.08)', siyah: '#000000'
    },
