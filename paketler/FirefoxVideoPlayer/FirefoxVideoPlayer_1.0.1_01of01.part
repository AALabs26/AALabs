  }
  // ---------------------------------------------------------------- çubuk arayüzü
  const V = TOKEN.video;
  const CUBUK_CSS = `
:host { all: initial; }
[hidden] { display: none !important; }
* { box-sizing: border-box; }
.kok { position: absolute; inset: 0; font: 13px/1.4 "Open Sans", "Segoe UI", Roboto, sans-serif; color: ${V.metin};
  user-select: none; -webkit-user-select: none; }
.yuzey { position: absolute; inset: 0; cursor: default; }
.kok.gizli .yuzey { cursor: none; }
.osd { position: absolute; top: 12px; right: 12px; padding: 6px 10px; font-weight: 600; font-size: 15px;
  background: ${V.zemin}; color: ${V.beyaz}; border: 1px solid ${V.kenar}; border-radius: 4px; pointer-events: none;
  opacity: 0; transition: opacity 120ms; }
.osd.gor { opacity: 1; }
.bilgi { position: absolute; top: 12px; left: 12px; display: flex; align-items: center; gap: 8px; padding: 4px 6px 4px 10px;
  font-size: 13px; color: ${V.beyaz}; background: ${V.bilgi}; border: 1px solid ${V.vurgu}; border-radius: 4px; }
.cubuk { position: absolute; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; gap: 6px;
  padding: 26px 10px 8px; background: ${V.zeminYari}; transition: opacity 120ms; }
.kok.gizli .cubuk, .kok.gizli .bilgi { opacity: 0; pointer-events: none; }
.seek { position: relative; height: 18px; cursor: pointer; touch-action: none; outline: none; }
.seek:focus-visible { box-shadow: 0 0 0 2px ${V.vurgu}; }
.ray { position: absolute; inset: 0; background: ${V.ray}; border-radius: 2px; overflow: hidden; }
.tampon { position: absolute; top: 0; bottom: 0; left: 0; background: ${V.tampon}; }
.dolu { position: absolute; top: 0; bottom: 0; left: 0; background: ${V.ana}; }
.imlec { position: absolute; top: -3px; bottom: -3px; width: 2px; margin-left: -1px; background: ${V.imlec};
  pointer-events: none; }
.oniz { position: absolute; bottom: 26px; width: 160px; margin-left: -80px; display: flex; flex-direction: column;
  align-items: center; gap: 2px; pointer-events: none; }
.kare { width: 160px; aspect-ratio: 16 / 9; background: ${V.kareZemin}; border: 2px solid ${V.vurgu}; border-radius: 4px;
  overflow: hidden; display: flex; align-items: center; justify-content: center; }
.kare video { width: 100%; height: 100%; object-fit: contain; display: block; }
.kare { position: relative; }
.kare .serit { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-repeat: no-repeat; }
.kare.bos { display: none; }
.kare-sure { font-size: 12px; font-weight: 700; padding: 0 6px; background: ${V.zemin}; color: ${V.beyaz}; border-radius: 2px; }
.arac { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 4px; min-width: 32px; height: 32px;
  padding: 0 8px; font: inherit; font-size: 13px; font-weight: 600; color: ${V.metin}; background: transparent;
  border: 1px solid ${V.kenar}; border-radius: 2px; cursor: pointer; }
.btn:hover { background: ${V.hover}; }
.btn:focus-visible { outline: 2px solid ${V.vurgu}; outline-offset: 1px; }
.btn.ana { background: ${V.ana}; border-color: ${V.ana}; color: ${V.beyaz}; }
.btn.kucuk { height: 26px; min-width: 26px; padding: 0 6px; font-size: 12px; }
.btn svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.btn.ana svg, .btn .dolgu { fill: currentColor; stroke: none; }
.btn.soluk { opacity: .55; }
.btn.acik { border-color: ${V.vurgu}; color: ${V.vurgu}; }
.sure { font-variant-numeric: tabular-nums; color: ${V.metinIkincil}; font-size: 13px; padding: 0 4px; white-space: nowrap; }
.bosluk { flex: 1 1 auto; }
.ses { display: inline-flex; align-items: center; gap: 4px; }
.ses input { width: 90px; accent-color: ${V.ana}; }
.yuzde { font-size: 12px; font-weight: 600; min-width: 3.4em; white-space: nowrap; }
.yuzde.soluk { opacity: .55; }
.rozet { display: inline-flex; align-items: center; height: 18px; padding: 0 4px; margin-left: 2px; font-size: 10px;
  font-weight: 700; color: ${V.rozetMetin}; background: ${V.rozet}; border-radius: 2px; vertical-align: 1px; }
.dar .gizle-dar { display: none; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
`;
  function arayuzKur(k) {
    const host = ogeKur('div', { 'data-aalabs': 'vdp' });
    host.style.cssText = 'position:absolute;z-index:2147483646;pointer-events:auto;';
    const kok = host.attachShadow({ mode: 'closed' });
    kok.append(ogeKur('style', { metin: CUBUK_CSS }));
    const btn = (ad, ipucu, sinif, fn) => {
      const b = ogeKur('button', { type: 'button', sinif: 'btn ' + (sinif || ''), title: ipucu, 'aria-label': ipucu });
      if (ad) b.append(ikon(ad));
      if (fn) b.addEventListener('click', fn);
      return b;
    };
    const ui = { host, kok };
    ui.yuzey = ogeKur('div', { sinif: 'yuzey' });
    ui.osd = ogeKur('div', { sinif: 'osd', role: 'status' });
    ui.bilgiMetin = ogeKur('span');
    ui.bastanBtn = ogeKur('button', { type: 'button', sinif: 'btn kucuk', metin: m('bastan') });
    ui.bastanBtn.addEventListener('click', e => { e.stopPropagation(); bastan(k); });
    ui.bilgi = ogeKur('div', { sinif: 'bilgi', hidden: true }, [ui.bilgiMetin, ui.bastanBtn]);
    // seekbar
    ui.tampon = ogeKur('div', { sinif: 'tampon' });
    ui.dolu = ogeKur('div', { sinif: 'dolu' });
    ui.imlec = ogeKur('div', { sinif: 'imlec', hidden: true });
    ui.kareKutu = ogeKur('div', { sinif: 'kare bos' });
    ui.kareSure = ogeKur('span', { sinif: 'kare-sure' });
    ui.oniz = ogeKur('div', { sinif: 'oniz', hidden: true }, [ui.kareKutu, ui.kareSure]);
    ui.seek = ogeKur('div', { sinif: 'seek', role: 'slider', tabindex: '0', 'aria-valuemin': '0' },
      [ogeKur('div', { sinif: 'ray' }, [ui.tampon, ui.dolu]), ui.imlec, ui.oniz]);
    // düğmeler
    ui.oynatBtn = btn('oynat', m('oynat'), 'ana', () => oynatDuraklat(k));
    ui.geriBtn = btn('geri', m('geri'), '', () => atla(k, -AYAR.atlama));
    ui.ileriBtn = btn('ileri', m('ileri'), '', () => atla(k, AYAR.atlama));
    ui.kareGeriBtn = btn('kare_geri', m('kare_geri'), 'gizle-dar', () => kare(k, -1));
    ui.kareIleriBtn = btn('kare_ileri', m('kare_ileri'), 'gizle-dar', () => kare(k, 1));
    ui.sure = ogeKur('span', { sinif: 'sure' });
    ui.altyaziBtn = btn('altyazi', m('altyazi'), 'gizle-dar', e => altyaziDugme(k, e.shiftKey));
    ui.hizBtn = btn(null, m('hiz'), '', e => { hiz(k, e.shiftKey ? 0 : 1); });
    ui.hizBtn.addEventListener('contextmenu', e => { e.preventDefault(); hiz(k, -1); });
    ui.sessizBtn = btn('ses', m('sessiz'), 'kucuk', () => sessiz(k));
    ui.sesGir = ogeKur('input', { type: 'range', min: '0', max: '100', step: '1', 'aria-label': m('ses') });
    ui.sesGir.addEventListener('input', () => sesAyarla(k, Number(ui.sesGir.value) / 100, true, true));
    ui.yuzde = ogeKur('span', { sinif: 'yuzde' });
    ui.ses = ogeKur('span', { sinif: 'ses' }, [ui.sessizBtn, ui.sesGir, ui.yuzde]);
    ui.goruntuBtn = btn('resim', m('goruntu'), 'gizle-dar', () => goruntu(k));
    ui.pipBtn = btn('pip', m('pip'), 'gizle-dar', () => pip(k));
    ui.tamBtn = btn('tam', m('tam'), '', () => tamEkran(k));
    ui.ayarBtn = btn('ayar', m('ayarlar'), '', () => ayarlarAc());
    ui.dosya = ogeKur('input', { type: 'file', accept: '.srt,.vtt,text/vtt', hidden: true });
    ui.dosya.addEventListener('change', () => altyaziYukle(k));
    ui.arac = ogeKur('div', { sinif: 'arac' }, [ui.geriBtn, ui.oynatBtn, ui.ileriBtn, ui.kareGeriBtn, ui.kareIleriBtn,
      ui.sure, ogeKur('span', { sinif: 'bosluk' }), ui.altyaziBtn, ui.hizBtn, ui.ses, ui.goruntuBtn, ui.pipBtn,
      ui.tamBtn, ui.ayarBtn, ui.dosya]);
    ui.cubuk = ogeKur('div', { sinif: 'cubuk' }, [ui.seek, ui.arac]);
    ui.kokEl = ogeKur('div', { sinif: 'kok' }, [ui.yuzey, ui.bilgi, ui.osd, ui.cubuk]);
    kok.append(ui.kokEl);
    // Gölge kökteki tuşlar siteye sızmasın; kısayollar belgede ayrıca dinlenir.
    for (const o of ['keypress', 'keyup']) kok.addEventListener(o, e => e.stopPropagation());
    // Sitenin kabındaki tık dinleyicileri (video.js oynat/duraklat) ikinci kez çalışmasın.
    for (const o of ['click', 'dblclick', 'mousedown', 'mouseup', 'pointerdown', 'pointerup', 'touchstart', 'touchend'])
      host.addEventListener(o, e => e.stopPropagation());
    host.addEventListener('pointerdown', () => { k.sonHareket = Date.now(); D.aktif = k; sesHazirla(k); }, true);
    // etkileşim
    ui.yuzey.addEventListener('click', e => {
      if (e.detail !== 1) return;
      clearTimeout(k.tikZaman);
      k.tikZaman = setTimeout(() => { k.tikIslendi = Date.now(); oynatDuraklat(k); }, 300);
    });
    ui.yuzey.addEventListener('dblclick', () => {
      clearTimeout(k.tikZaman);
      if (Date.now() - (k.tikIslendi || 0) < 700) oynatDuraklat(k); // yavaş çift tık: ilk tıkı geri al
      tamEkran(k);
    });
    host.addEventListener('pointermove', () => { D.aktif = k; k.sonHareket = Date.now(); goster(k); });
    host.addEventListener('pointerleave', () => { k.cubukUstunde = false; });
    ui.cubuk.addEventListener('pointerenter', () => { k.cubukUstunde = true; });
    ui.cubuk.addEventListener('pointerleave', () => { k.cubukUstunde = false; });
    host.addEventListener('wheel', e => tekerSes(k, e), { passive: false });
    host.addEventListener('contextmenu', e => e.stopPropagation());
    seekBagla(k, ui);
    k.ui = ui;
    k.kap.appendChild(host);
    k.gizleSayac = setInterval(() => gizleDenetle(k), 500);
  }
  // Sarılabilir aralık: sonlu süre → [0, süre]; canlı yayın → seekable; yoksa null (sarılamaz).
  function aralik(v) {
    if (Number.isFinite(v.duration) && v.duration > 0) return [0, v.duration];
    try {
      const s = v.seekable;
      if (s && s.length) { const a = s.start(0), b = s.end(s.length - 1); if (b > a) return [a, b]; }
    } catch (_hata) { /* yok */ }
    return null;
  }
  function seekBagla(k, ui) {
    const oran = e => {
      const r = ui.seek.getBoundingClientRect();
      return Math.max(0, Math.min(1, (e.clientX - r.left) / (r.width || 1)));
    };
    let surukle = false, bekleyen = null, kare = 0;
    const hedefSure = p => { const a = aralik(k.v); return a ? a[0] + p * (a[1] - a[0]) : null; };
    const sar = t => {
      bekleyen = t;
      if (kare) return;
      kare = requestAnimationFrame(() => {
        kare = 0;
        if (bekleyen == null) return;
        if (k.v.seeking && surukle) { sar(bekleyen); return; } // önceki sarma bitsin
        try { k.v.currentTime = bekleyen; } catch (_hata) { /* yok */ }
        bekleyen = null;
      });
    };
    const goster = e => {
      const p = oran(e), t = hedefSure(p);
      if (t == null) { ui.oniz.hidden = true; ui.imlec.hidden = true; return; }
      ui.imlec.hidden = false; ui.imlec.style.left = `${p * 100}%`;
      const r = ui.seek.getBoundingClientRect();
      const x = Math.max(80, Math.min(r.width - 80, p * r.width));
      ui.oniz.hidden = false; ui.oniz.style.left = `${x}px`;
      ui.kareSure.textContent = sure(t);
      ui.kareKutu.classList.toggle('bos', !k.onizVideo && !k.kucukResim);
      if (k.kucukResim) kucukResimGoster(k, t);
      else if (k.onizVideo) onizSar(k, t);
    };
    const birak = () => { surukle = false; };
    ui.seek.addEventListener('pointermove', e => {
      goster(e);
      if (!surukle) return;
      if (e.buttons === 0) { birak(); return; }
      const t = hedefSure(oran(e));
      if (t != null) sar(t);
    });
    ui.seek.addEventListener('pointerleave', () => { if (!surukle) { ui.oniz.hidden = true; ui.imlec.hidden = true; } });
    ui.seek.addEventListener('pointerdown', e => {
      if (e.button !== 0) return;
      const t = hedefSure(oran(e));
      if (t == null) { osdGoster(k, m('osd_canli')); return; }
      surukle = true;
      try { ui.seek.setPointerCapture(e.pointerId); } catch (_hata) { /* yok */ }
      sar(t);
      goster(e);
    });
    ui.seek.addEventListener('pointerup', birak);
    ui.seek.addEventListener('pointercancel', birak);
    ui.seek.addEventListener('lostpointercapture', birak);
  }
  function yerlesimGuncelle(k) {
    if (!k.ui || !k.v.isConnected) return;
    const v = k.v, kap = k.kap;
    const rv = v.getBoundingClientRect(), rk = kap.getBoundingClientRect();
    const st = getComputedStyle(kap);
    const bl = parseFloat(st.borderLeftWidth) || 0, bt = parseFloat(st.borderTopWidth) || 0;
    const s = k.ui.host.style;
    s.left = `${rv.left - rk.left - bl + kap.scrollLeft}px`;
    s.top = `${rv.top - rk.top - bt + kap.scrollTop}px`;
    s.width = `${rv.width}px`;
    s.height = `${rv.height}px`;
    k.ui.kokEl.classList.toggle('dar', rv.width < 560);
  }
  function arayuzGuncelle(k) {
    const ui = k.ui, v = k.v;
    if (!ui) return;
    const a = aralik(v);
    const sonlu = Number.isFinite(v.duration);
    const d = sonlu ? v.duration : 0;
    const t = v.currentTime || 0;
    const p = a ? Math.max(0, Math.min(1, (t - a[0]) / (a[1] - a[0]))) : 0;
    ui.dolu.style.width = `${p * 100}%`;
    let tamponSon = 0;
    try {
      for (let i = 0; i < v.buffered.length; i++) {
        if (v.buffered.start(i) <= t + 0.5) tamponSon = Math.max(tamponSon, v.buffered.end(i));
      }
    } catch (_hata) { /* yok */ }
    ui.tampon.style.width = a ? `${Math.max(0, Math.min(100, ((tamponSon - a[0]) / (a[1] - a[0])) * 100))}%` : '0';
    ui.seek.setAttribute('aria-valuemax', String(Math.round(d)));
    ui.seek.setAttribute('aria-valuenow', String(Math.round(t)));
    ui.seek.setAttribute('aria-valuetext', `${sure(t)} / ${sure(d)}`);
    ui.seek.setAttribute('aria-label', m('konum'));
    ui.sure.textContent = sonlu || !v.duration ? `${sure(t)} / ${sure(d)}` : `${sure(t)} · ${m('canli')}`;
    const oynuyor = !v.paused && !v.ended;
    ui.oynatBtn.replaceChildren(ikon(oynuyor ? 'duraklat' : 'oynat'));
    const oynatEtiket = oynuyor ? m('duraklat') : m('oynat');
    ui.oynatBtn.title = oynatEtiket; ui.oynatBtn.setAttribute('aria-label', oynatEtiket);
    ui.hizBtn.textContent = `${sayiYaz(v.playbackRate)}×`;
    const ust = sesUst(k);
    ui.sesGir.max = String(Math.round(ust * 100));
    const ses = v.muted ? 0 : k.ses;
    if (document.activeElement !== ui.host || ui.kok.activeElement !== ui.sesGir) ui.sesGir.value = String(Math.round(ses * 100));
    ui.sessizBtn.replaceChildren(ikon(v.muted || ses === 0 ? 'sessiz' : 'ses', 16));
    ui.yuzde.replaceChildren(`%${Math.round(ses * 100)}`);
    if (AYAR.dil === 'en') ui.yuzde.replaceChildren(`${Math.round(ses * 100)}%`);
    const kirli = k.cors === false;
    ui.yuzde.classList.toggle('soluk', kirli);
    if (kirli) ui.yuzde.append(ogeKur('span', { sinif: 'rozet', metin: 'CORS', title: m('ses_kapali') }));
    ui.goruntuBtn.classList.toggle('soluk', kirli);
    ui.goruntuBtn.title = kirli ? m('goruntu_kapali') : m('goruntu');
    ui.goruntuBtn.setAttribute('aria-label', ui.goruntuBtn.title);
    const altAcik = !!(k.altyazi && k.altyazi.mode === 'showing');
    ui.altyaziBtn.classList.toggle('acik', altAcik);
    const tamMi = document.fullscreenElement === k.kap;
    ui.tamBtn.replaceChildren(ikon(tamMi ? 'tam_cik' : 'tam'));
  }
  function arayuzMetinYenile(k) {
    const ui = k.ui;
    if (!ui) return;
    const ata = (b, a) => { b.title = a; b.setAttribute('aria-label', a); };
    ata(ui.geriBtn, m('geri')); ata(ui.ileriBtn, m('ileri')); ata(ui.kareGeriBtn, m('kare_geri'));
    ata(ui.kareIleriBtn, m('kare_ileri')); ata(ui.altyaziBtn, m('altyazi')); ata(ui.hizBtn, m('hiz'));
    ata(ui.sessizBtn, m('sessiz')); ata(ui.pipBtn, m('pip')); ata(ui.tamBtn, m('tam')); ata(ui.ayarBtn, m('ayarlar'));
    ui.sesGir.setAttribute('aria-label', m('ses'));
    ui.bastanBtn.textContent = m('bastan');
    arayuzGuncelle(k);
  }
  function goster(k) {
    if (!k.ui) return;
    k.gizleZaman = Date.now() + 2000;
    k.ui.kokEl.classList.remove('gizli');
  }
  function gizleDenetle(k) {
    if (!k.ui || document.hidden) return;
    const v = k.v;
    const gizle = !v.paused && !k.cubukUstunde && Date.now() > k.gizleZaman && !k.ui.oniz.offsetParent;
    k.ui.kokEl.classList.toggle('gizli', gizle);
  }

  // ---------------------------------------------------------------- eylemler
  function osdGoster(k, metin) {
    if (k && k.ui) {
      const o = k.ui.osd;
      o.textContent = metin; o.classList.add('gor');
      clearTimeout(k.osdZaman); k.osdZaman = setTimeout(() => o.classList.remove('gor'), 1200);
      return;
    }
    // Ekle kipi: videonun sağ üstünde yüzen gösterge (tam ekranda tam ekran öğesinin içinde).
    if (!D.osdKok) {
      const host = ogeKur('div', { 'data-aalabs': 'vdp-osd' });
      host.style.cssText = 'position:fixed;z-index:2147483647;pointer-events:none;top:0;left:0;';
      const kok = host.attachShadow({ mode: 'closed' });
      const el = ogeKur('div', { role: 'status' });
      el.style.cssText = `padding:6px 10px;font:600 15px "Open Sans","Segoe UI",Roboto,sans-serif;background:${V.zemin};` +
        `color:${V.beyaz};border:1px solid ${V.kenar};border-radius:4px;`;
      kok.append(el);
      D.osdKok = { host, el };
    }
    const { host, el } = D.osdKok;
    const tam = document.fullscreenElement;
    if (tam && tam.tagName === 'VIDEO') return; // video tam ekranda: gösterge çizilemez
    const yer = tam || document.documentElement;
    if (host.parentNode !== yer) yer.appendChild(host);
    el.textContent = metin;
    host.hidden = false;
    if (k) {
      const r = k.v.getBoundingClientRect();
      host.style.left = `${Math.max(8, r.right - 12 - el.offsetWidth)}px`;
      host.style.top = `${Math.max(8, r.top + 12)}px`;
    }
    clearTimeout(D.osdZaman); D.osdZaman = setTimeout(() => { host.hidden = true; }, 1200);
  }
  function oynatDuraklat(k) {
    const v = k.v;
    if (v.paused || v.ended) { const p = v.play(); if (p && p.catch) p.catch(() => {}); } else v.pause();
    goster(k);
  }
  function atla(k, sn) {
    const v = k.v;
    const d = Number.isFinite(v.duration) ? v.duration : Infinity;
    v.currentTime = Math.max(0, Math.min(d, v.currentTime + sn));
    osdGoster(k, `${m('osd_atla', (sn > 0 ? '+' : '−') + Math.abs(sn))} · ${sure(v.currentTime)}`);
    goster(k);
  }
  function kare(k, yon) {
    const v = k.v;
    if (!v.paused) v.pause();
    v.currentTime = Math.max(0, v.currentTime + yon / 30);
    osdGoster(k, m('osd_kare', `${sure(v.currentTime)}.${String(Math.floor((v.currentTime % 1) * 30)).padStart(2, '0')}`));
  }
  function hiz(k, yon) {
    const v = k.v;
    let h = yon === 0 ? 1 : Math.round((v.playbackRate + yon * AYAR.hizAdim) * 100) / 100;
    h = Math.max(0.25, Math.min(4, h));
    v.playbackRate = h;
    osdGoster(k, `${m('osd_hiz', sayiYaz(h))} · ${sure(v.currentTime)}`);
  }
  function sessiz(k) {
    const v = k.v;
    v.muted = !v.muted;
    if (!v.muted && k.ses === 0) sesAyarla(k, 0.5, false, true);
    osdGoster(k, v.muted ? m('osd_sessiz') : m('osd_ses', Math.round(k.ses * 100)));
  }
  // Tekerlek adımı: dokunmatik yüzeyin küçük deltaları birikir; ~50 px bir adım.
  function tekerAdim(k, e) {
    const carpan = e.deltaMode === 1 ? 33 : e.deltaMode === 2 ? 400 : 1;
    k.tekerBirikim = (k.tekerBirikim || 0) + e.deltaY * carpan;
    if (Math.abs(k.tekerBirikim) < 50) return 0;
    const yon = k.tekerBirikim < 0 ? 1 : -1;
    k.tekerBirikim = 0;
    return yon;
  }
  function tekerSes(k, e) {
    if (!AYAR.teker || e.ctrlKey || e.metaKey || e.altKey || !e.deltaY) return;
    // İmleç son 3 sn'de videoda hareket etmediyse sayfa kayıyordur: kaydırmaya karışılmaz.
    if (Date.now() - (k.sonHareket || 0) > 3000 && document.fullscreenElement !== k.kap) return;
    e.preventDefault(); e.stopPropagation();
    k.sonHareket = Date.now();
    const yon = tekerAdim(k, e);
    if (!yon) return;
    const adim = e.shiftKey ? 0.01 : 0.05;
    const simdiki = k.v.muted ? 0 : k.ses;
    if (k.v.muted) k.v.muted = false;
    sesAyarla(k, simdiki + yon * adim, true, false);
    goster(k);
  }
  function tamEkran(k) {
    if (document.fullscreenElement) { document.exitFullscreen().catch(() => {}); return; }
    const hedef = k.kip === 'degistir' ? k.kap : k.v;
    if (hedef.requestFullscreen) hedef.requestFullscreen().catch(() => {});
  }
  function pip(k) {
    const v = k.v;
    if (typeof v.requestPictureInPicture === 'function' && document.pictureInPictureEnabled) {
      v.requestPictureInPicture().catch(() => osdGoster(k, m('osd_pip_yok')));
    } else osdGoster(k, m('osd_pip_yok'));
  }
  function bastan(k) {
    k.v.currentTime = 0;
    if (k.ui) k.ui.bilgi.hidden = true;
    osdGoster(k, m('osd_bastan'));
  }
  function goruntu(k) {
    const v = k.v;
    if (k.cors !== true) { osdGoster(k, m('osd_goruntu_yok')); return; }
    if (!v.videoWidth || !v.videoHeight) { osdGoster(k, m('osd_goruntu_hata')); return; }
    try {
      const c = document.createElement('canvas');
      c.width = v.videoWidth; c.height = v.videoHeight;
      c.getContext('2d').drawImage(v, 0, 0);
      const url = c.toDataURL('image/png');
      const ad = `${(HOST || 'video').replace(/[^a-z0-9.-]/g, '_')}_${sure(v.currentTime).replace(/:/g, '-')}.png`;
      const a = ogeKur('a', { href: url, download: ad });
      a.style.display = 'none';
      document.documentElement.appendChild(a);
      a.click();
      a.remove();
      osdGoster(k, m('osd_goruntu'));
    } catch (_hata) { k.cors = false; arayuzGuncelle(k); osdGoster(k, m('osd_goruntu_yok')); }
  }

  // ---------------------------------------------------------------- altyazı (E5)
  function altyaziDugme(k, yeniDosya) {
    if (!k.altyazi || yeniDosya) { k.ui.dosya.value = ''; k.ui.dosya.click(); return; }
    k.altyazi.mode = k.altyazi.mode === 'showing' ? 'hidden' : 'showing';
    osdGoster(k, k.altyazi.mode === 'showing' ? m('osd_altyazi_ac') : m('osd_altyazi_kapali'));
    arayuzGuncelle(k);
  }
  function zamanCoz(s) {
    const p = /(?:(\d+):)?(\d{1,2}):(\d{2})(?:[.,](\d{1,3}))?/.exec(s);
    if (!p) return NaN;
    return (Number(p[1] || 0) * 3600) + Number(p[2]) * 60 + Number(p[3]) + Number((p[4] || '0').padEnd(3, '0')) / 1000;
  }
  function altyaziCoz(metin) {
    const satirlar = [];
    const bloklar = metin.replace(/\r\n?/g, '\n').replace(/^\uFEFF/, '').split(/\n\s*\n/);
    for (const b of bloklar) {
      const l = b.split('\n');
      const i = l.findIndex(x => x.includes('-->'));
      if (i < 0) continue;
      const [a, z] = l[i].split('-->');
      const bas = zamanCoz(a), son = zamanCoz(z);
      const yazi = l.slice(i + 1).join('\n').replace(/<\/?[a-zA-Z][^>]*>/g, '').replace(/\{\\[^}]*\}/g, '').trim();
      if (Number.isFinite(bas) && Number.isFinite(son) && son > bas && yazi) satirlar.push([bas, son, yazi]);
    }
    return satirlar;
  }
  function altyaziYukle(k) {
    const f = k.ui.dosya.files && k.ui.dosya.files[0];
    if (!f) return;
    const r = new FileReader();
    r.onload = () => {
      const satirlar = altyaziCoz(metinCoz(r.result));
      if (!satirlar.length) { osdGoster(k, m('osd_altyazi_hata')); return; }
      if (k.altyazi) k.altyazi.mode = 'disabled';
      const iz = k.v.addTextTrack('subtitles', f.name, AYAR.dil);
      const Cue = W.VTTCue || window.VTTCue;
      let eklenen = 0;
      for (const [bas, son, yazi] of satirlar) { try { iz.addCue(new Cue(bas, son, yazi)); eklenen++; } catch (_hata) { /* atla */ } }
      if (!eklenen) { iz.mode = 'disabled'; osdGoster(k, m('osd_altyazi_hata')); return; }
      iz.mode = 'showing';
      k.altyazi = iz;
      osdGoster(k, m('osd_altyazi_yuklendi', eklenen));
      arayuzGuncelle(k);
    };
    r.onerror = () => osdGoster(k, m('osd_altyazi_hata'));
    r.readAsArrayBuffer(f);
  }
  // Türkçe .srt dosyaları çoğunlukla Windows-1254: UTF-8 geçersizse ona düşülür.
  function metinCoz(tampon) {
    try { return new TextDecoder('utf-8', { fatal: true }).decode(tampon); } catch (_hata) { /* UTF-8 değil */ }
    try { return new TextDecoder('windows-1254').decode(tampon); } catch (_hata) { return ''; }
  }

  // ---------------------------------------------------------------- kısayollar
  function arkaPlanMi(k) { return k.v.loop && k.v.muted; }
  function gorunur(k) { const r = k.v.getBoundingClientRect(); return r.width > 0 && r.bottom > 0 && r.top < innerHeight; }
  function aktifKayit() {
    if (D.aktif && D.videolar.has(D.aktif.v) && gorunur(D.aktif) && !D.aktif.bekliyor) return D.aktif;
    let en = null, enAlan = 0;
    for (const k of D.videolar.values()) {
      if (!gorunur(k) || arkaPlanMi(k) || k.bekliyor) continue;
      const r = k.v.getBoundingClientRect();
      const alan = r.width * r.height;
      if (alan > enAlan) { en = k; enAlan = alan; }
    }
    return en;
  }
  function tusBasildi(e) {
    if (e.defaultPrevented || e.isComposing) return;
    const ad = tusAdi(e);
    if (!ad) return;
    if (ad === 'Ctrl+,') {
      if (e.repeat) return;
      e.preventDefault(); e.stopPropagation();
      ayarlarAc();
      return;
    }
    if (!D.calisiyor || ayarAcikMi()) return;
    const hedef = (e.composedPath && e.composedPath()[0]) || e.target;
    if (yaziAlaniMi(hedef) || yaziAlaniMi(derinOdak())) return;
    const k = aktifKayit();
    if (!k) return;
    const ks = AYAR.kisayol;
    const eylem = Object.keys(ks).find(a => ks[a] === ad);
    // Ekle kipi: yalnız hız. Site oynatıcısının kendi tuşları aynen çalışır.
    if (k.bekliyor) return; // daha site oynatıcısında
    if (k.kip === 'ekle') {
      if (eylem !== 'yavas' && eylem !== 'hizli') return;
      if (e.repeat) return;
      e.preventDefault(); e.stopImmediatePropagation();
      hiz(k, eylem === 'hizli' ? 1 : -1);
      return;
    }
    let is = null;
    // Boşluk ve oklar sayfa kaydırmasıdır: yalnız video son 10 sn'de kullanıldıysa ya da tam ekrandaysa alınır.
    if (SABIT_TUS.has(ad)) {
      const yakin = D.aktif === k && Date.now() - (k.sonHareket || 0) < 10000;
      if (!yakin && document.fullscreenElement !== k.kap) return;
      if (ad === 'Space' && e.repeat) { e.preventDefault(); return; }
    }
    switch (ad) {
      case 'Space': is = () => oynatDuraklat(k); break;
      case 'ArrowLeft': is = () => atla(k, -5); break;
      case 'ArrowRight': is = () => atla(k, 5); break;
      case 'ArrowUp': is = () => sesAyarla(k, (k.v.muted ? 0 : k.ses) + 0.05, true, true); break;
      case 'ArrowDown': is = () => sesAyarla(k, (k.v.muted ? 0 : k.ses) - 0.05, true, true); break;
      default: break;
    }
    if (!is && eylem) {
      const tekrarli = ['geri', 'ileri', 'kare_geri', 'kare_ileri', 'yavas', 'hizli'].includes(eylem);
      if (e.repeat && !tekrarli) return;
      is = {
        oynat: () => oynatDuraklat(k), geri: () => atla(k, -AYAR.atlama), ileri: () => atla(k, AYAR.atlama),
        yavas: () => hiz(k, -1), hizli: () => hiz(k, 1), kare_geri: () => kare(k, -1), kare_ileri: () => kare(k, 1),
        sessiz: () => sessiz(k), tam: () => tamEkran(k), goruntu: () => goruntu(k),
        altyazi: () => altyaziDugme(k, false), bastan: () => bastan(k)
      }[eylem];
    }
    if (!is) return;
    // Boşluk, odak sayfanın bir düğmesinde ya da bağlantısındaysa ona bırakılır.
    const odak = derinOdak();
    if (ad === 'Space' && odak && (odak.tagName === 'BUTTON' || odak.tagName === 'A')) return;
    e.preventDefault(); e.stopImmediatePropagation();
    k.sonHareket = Date.now();
    sesHazirla(k);
    is();
    goster(k);
  }
  function tekerBelge(e) {
    // Ekle kipi: imleç videonun üstündeyse tekerlek sesi değiştirir (≤ %100).
    if (!D.calisiyor || !AYAR.teker || e.ctrlKey || e.metaKey || e.altKey || !e.deltaY) return;
    if (Date.now() - D.sonFareHareket > 3000) return; // sayfa kayıyor
    for (const k of D.videolar.values()) {
      if (k.kip !== 'ekle') continue;
      const r = k.v.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) continue;
      const ust = document.elementFromPoint(e.clientX, e.clientY);
      if (ust && ust !== k.v && !(ust.contains && ust.contains(k.v)) && !(k.v.parentElement && k.v.parentElement.contains(ust))) continue;
      e.preventDefault(); e.stopPropagation();
      D.sonFareHareket = Date.now();
      const yon = tekerAdim(k, e);
      if (!yon) return;
      const adim = e.shiftKey ? 0.01 : 0.05;
      const simdiki = k.v.muted ? 0 : k.v.volume;
      if (k.v.muted) k.v.muted = false;
      k.v.volume = Math.max(0, Math.min(1, Math.round((simdiki + yon * adim) * 100) / 100));
      osdGoster(k, m('osd_ses', Math.round(k.v.volume * 100)));
      return;
    }
  }
  function fareHareket() { D.sonFareHareket = Date.now(); }
  // ---------------------------------------------------------------- başlat / durdur
  // Sayfa dinleyicileri yalnız betik bu sitede çalışırken bağlıdır (kapalı sitede sayfaya dokunulmaz).
  const SAYFA_DINLEYICI = [
    [document, 'fullscreenchange', () => {
      for (const k of D.videolar.values()) { yerlesimGuncelle(k); arayuzGuncelle(k); }
      if (A.host && ayarAcikMi()) ayarlarAc();
    }, false],
    [window, 'resize', () => { for (const k of D.videolar.values()) yerlesimGuncelle(k); }, false],
    [window, 'keydown', tusBasildi, true],
    [window, 'wheel', tekerBelge, { capture: true, passive: false }],
    [window, 'pointermove', fareHareket, { capture: true, passive: true }]
  ];
  function baslat() {
    if (D.calisiyor) return;
    D.calisiyor = true;
    for (const [h, o, fn, sec] of SAYFA_DINLEYICI) h.addEventListener(o, fn, sec);
    const kur = () => {
      if (!D.calisiyor) return;
      if (!D.gozcu && document.documentElement) {
        D.gozcu = new MutationObserver(kayitlar => {
          for (const r of kayitlar) {
            if ([...r.addedNodes].some(videoIlgili) || [...r.removedNodes].some(videoIlgili)) { taramaIste(); return; }
          }
        });
        D.gozcu.observe(document.documentElement, { childList: true, subtree: true });
      }
      tara();
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', kur, { once: true });
    else kur();
  }
  function durdur() {
    D.calisiyor = false;
    if (D.gozcu) { D.gozcu.disconnect(); D.gozcu = null; }
    for (const k of [...D.videolar.values()]) videoBirak(k);
    if (D.osdKok) { D.osdKok.host.remove(); D.osdKok = null; }
    if (D.stil) { D.stil.remove(); D.stil = null; }
    for (const [h, o, fn, sec] of SAYFA_DINLEYICI) h.removeEventListener(o, fn, sec);
    D.atlanan = [];
  }
  function yenidenKur() {
    durdur();
    if (!siteKapali()) baslat();
    menuYaz();
  }

  // ---------------------------------------------------------------- menü
  function menuYaz() {
    if (!UST_PENCERE || typeof GM_registerMenuCommand !== 'function') return;
    if (typeof GM_unregisterMenuCommand !== 'function' && D.menuKimlik.length) return; // eskisi silinemiyor: çoğaltma
    if (typeof GM_unregisterMenuCommand === 'function') {
      D.menuKimlik.forEach(k => { try { GM_unregisterMenuCommand(k); } catch (_hata) { /* yok */ } });
    }
    const kapali = siteKapali();
    const ogeler = [
      [kapali ? m('menu_ac') : m('menu_kapat'), () => siteAcKapa(kapali), kapali ? 'a' : 'k'],
      [siteEkleKipi() ? m('menu_degistir') : m('menu_ekle'), () => siteKip(siteEkleKipi() ? 'degistir' : 'ekle'),
        siteEkleKipi() ? 'd' : 'e'],
      [m('menu_ayarlar'), () => ayarlarAc(), 'y']
    ];
    D.menuKimlik = ogeler.map(([ad, fn, harf]) => GM_registerMenuCommand(ad, fn, harf));
  }
  function siteAcKapa(ac) {
    AYAR = ayarYukle();
    if (ac) AYAR.kapali = AYAR.kapali.filter(s => !(SITE === s || SITE.endsWith('.' + s)));
    else if (!siteKapali()) AYAR.kapali.push(SITE);
    ayarKaydet();
    yenidenKur();

    ayarlarYenile();
  }
  function siteKip(kip) {
    AYAR = ayarYukle();
    if (kip === 'ekle') { if (!siteEkleKipi()) AYAR.ekle.push(SITE); } else {
      AYAR.ekle = AYAR.ekle.filter(s => !(SITE === s || SITE.endsWith('.' + s) || HOST === s || HOST.endsWith('.' + s)));
    }
    ayarKaydet();
    yenidenKur();
    ayarlarYenile();
  }

  // ---------------------------------------------------------------- Ayarlar penceresi
  const A = { host: null, kok: null, dialog: null, bolum: 'oynatici', arama: '', yakala: null, durum: '', kopyaKutu: null };
  function temaRenkleri() {
    let koyu;
    if (AYAR.tema === 'koyu') koyu = true;
    else if (AYAR.tema === 'acik') koyu = false;
    else koyu = !!(window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches);
    return koyu ? TOKEN.koyu : TOKEN.acik;
  }
  function ayarCss() {
    const T = temaRenkleri();
    return `
:host { all: initial; }
[hidden] { display: none !important; }
* { box-sizing: border-box; }
dialog { width: min(760px, calc(100vw - 32px)); max-height: min(560px, calc(100vh - 32px)); padding: 0; margin: auto;
  font: 13px/1.45 "Open Sans", "Segoe UI", Roboto, sans-serif; color: ${T.metin}; background: ${T.yuzey};
  border: 1px solid ${T.kenar}; border-radius: 6px; overflow: hidden; }
dialog::backdrop { background: ${T.perde}; }
.ust { display: flex; align-items: center; gap: 8px; padding: 8px 8px 8px 12px; border-bottom: 1px solid ${T.ayirici}; }
.logo { display: inline-flex; align-items: center; justify-content: center; height: 22px; padding: 0 4px; font-weight: 700;
  font-size: 11px; color: ${TOKEN.video.beyaz}; background: ${TOKEN.uygulama}; border-radius: 2px; }
h2 { margin: 0; font-size: 15px; font-weight: 600; }
.ara { flex: 1 1 auto; max-width: 260px; margin-left: auto; height: 32px; padding: 0 8px; font: inherit; color: ${T.metin};
  background: ${T.yuzey}; border: 1px solid ${T.kenar}; border-radius: 2px; }
.govde { display: grid; grid-template-columns: 180px minmax(0, 1fr); height: min(500px, calc(100vh - 90px)); }
nav { padding: 8px 0; background: ${T.zemin}; border-right: 1px solid ${T.ayirici}; overflow: auto; }
.grup { padding: 8px 12px 4px; font-size: 11px; font-weight: 700; letter-spacing: .04em; color: ${T.metinIkincil}; }
.git { display: block; width: 100%; padding: 6px 12px; font: inherit; text-align: left; white-space: nowrap; overflow: hidden;
  text-overflow: ellipsis; color: ${T.metin}; background: transparent; border: 0; cursor: pointer; }
.git:hover { background: ${T.anaHover}; }
.git[aria-current="page"] { background: ${T.anaAcik}; font-weight: 600; }
.icerik { padding: 12px 16px; overflow: auto; }
h3 { margin: 0 0 8px; font-size: 14px; font-weight: 600; }
.satir { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 8px 0; border-bottom: 1px solid ${T.ayirici}; }
.satir > label, .satir > .etiket { flex: 1 1 200px; min-width: 0; }
.not { width: 100%; font-size: 12px; color: ${T.metinIkincil}; }
input[type=number], select, textarea { font: inherit; color: ${T.metin}; background: ${T.yuzey};
  border: 1px solid ${T.kenar}; border-radius: 2px; }
input[type=number], select { height: 32px; padding: 0 8px; }
textarea { width: 100%; min-height: 96px; padding: 6px 8px; resize: vertical; font-family: Consolas, monospace; font-size: 12px; }
.btn { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 0 12px; font: inherit; color: ${T.metin};
  background: ${T.yuzey}; border: 1px solid ${T.kenar}; border-radius: 2px; cursor: pointer; }
.btn:hover { background: ${T.anaHover}; }
.btn.ana { background: ${T.ana}; border-color: ${T.ana}; color: ${T.anaUzeri}; }
.btn.ikon { width: 32px; padding: 0; justify-content: center; }
.btn svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
.anahtar { position: relative; width: 40px; height: 22px; padding: 0; border: 1px solid ${T.kenar}; border-radius: 11px;
  background: ${T.ayirici}; cursor: pointer; flex: none; }
.anahtar::after { content: ""; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%;
  background: ${T.metinIkincil}; transition: left 120ms; }
.anahtar[aria-checked="true"] { background: ${T.ana}; border-color: ${T.ana}; }
.anahtar[aria-checked="true"]::after { left: 20px; background: ${T.anaUzeri}; }
.segment { display: inline-flex; border: 1px solid ${T.kenar}; border-radius: 2px; overflow: hidden; }
.segment button { height: 30px; padding: 0 12px; font: inherit; color: ${T.metin}; background: ${T.yuzey}; border: 0;
  border-right: 1px solid ${T.ayirici}; cursor: pointer; }
.segment button:last-child { border-right: 0; }
.segment button[aria-checked="true"] { background: ${T.ana}; color: ${T.anaUzeri}; }
table { width: 100%; border-collapse: collapse; color: inherit; }
th, td { padding: 6px 8px; text-align: left; border-bottom: 1px solid ${T.ayirici}; vertical-align: top; }
th { font-size: 12px; font-weight: 600; color: ${T.metinIkincil}; }
kbd { display: inline-block; min-width: 22px; padding: 0 6px; font: 700 12px/20px inherit; text-align: center;
  border: 1px solid ${T.kenar}; border-radius: 2px; }
.durum { min-height: 20px; margin-top: 8px; font-size: 12px; color: ${T.basari}; }
.durum.hata { color: ${T.hata}; }
.iyi { color: ${T.basari}; font-weight: 600; } .kotu { color: ${T.hata}; font-weight: 600; } .bekle { color: ${T.uyari}; font-weight: 600; }
.bos { padding: 16px 0; color: ${T.metinIkincil}; }
:focus-visible { outline: 2px solid ${T.vurgu}; outline-offset: 1px; }
@media (max-width: 560px) { .govde { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); }
  nav { display: flex; overflow-x: auto; border-right: 0; border-bottom: 1px solid ${T.ayirici}; padding: 0; }
  .grup { display: none; } .git { width: auto; flex: none; overflow: visible; } }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
`;
  }
  function katla(s) { return String(s).toLocaleLowerCase('tr-TR').replace(/ı/g, 'i'); }
  function ayarAcikMi() { return !!(A.dialog && A.dialog.open); }
  function ayarlarAc() {
    if (!document.documentElement) return;
    if (!A.host) {
      A.host = ogeKur('div', { 'data-aalabs': 'vdp-ayar' });
      A.kok = A.host.attachShadow({ mode: 'closed' });
      A.stil = ogeKur('style');
      A.dialog = ogeKur('dialog', { 'aria-labelledby': 'vdp-baslik' });
      A.dialog.addEventListener('cancel', e => { if (A.yakala) { e.preventDefault(); A.yakala = null; ayarCiz(); } });
      A.dialog.addEventListener('close', () => { if (!A.dialog.open) { A.yakala = null; A.durum = ''; A.kopyaKutu = null; A.listeTaslak = null; } });
      A.dialog.addEventListener('pointerdown', e => { A.perdeBasladi = e.target === A.dialog; });
      A.dialog.addEventListener('click', e => { if (e.target === A.dialog && A.perdeBasladi) A.dialog.close(); });
      A.dialog.addEventListener('keydown', ayarTus);
      for (const o of ['keypress', 'keyup']) A.kok.addEventListener(o, e => e.stopPropagation());
      A.kok.append(A.stil, A.dialog);
    }
    AYAR = ayarYukle();
    const tam = document.fullscreenElement;
    const yer = tam && tam.tagName !== 'VIDEO' && tam.tagName !== 'IFRAME' ? tam : document.documentElement;
    if (A.host.parentNode !== yer) {
      const acikti = A.dialog.open;
      if (acikti) { try { A.dialog.close(); } catch (_hata) { A.dialog.removeAttribute('open'); } }
      yer.appendChild(A.host);
    }
    ayarCiz();
    if (!A.dialog.open) {
      try { A.dialog.showModal(); } catch (_hata) { A.dialog.setAttribute('open', ''); }
      const ara = A.kok.querySelector('.ara');
      if (ara) ara.focus();
    }
  }
  function ayarlarYenile() { if (ayarAcikMi()) ayarCiz(); }
  function ayarTus(e) {
    e.stopPropagation();
    if (A.yakala) {
      if (e.key === 'Escape') { e.preventDefault(); A.yakala = null; ayarCiz(); return; }
      const ad = tusAdi(e);
      if (!ad) return;
      e.preventDefault();
      const eylem = A.yakala;
      if (!tusGecerli(ad)) { A.durum = '!' + m('k_yasak', ad); A.yakala = null; ayarCiz(); return; }
      AYAR = ayarYukle();
      const diger = Object.keys(AYAR.kisayol).find(x => x !== eylem && AYAR.kisayol[x] === ad);
      if (diger) { A.durum = '!' + m('k_cakisma', ad, m('e_' + diger)); A.yakala = null; ayarCiz(); return; }
      ayarDegistir(a => { a.kisayol[eylem] = ad; });
      A.yakala = null; A.durum = m('a_kaydedildi');
      ayarCiz();
    }
  }
  const BOLUMLER = [
    ['grup_uygulama', [['oynatici', 'bolum_oynatici'], ['siteler', 'bolum_siteler']]],
    ['grup_ortak', [['genel', 'bolum_genel'], ['kisayol', 'bolum_kisayol'], ['tani', 'bolum_tani'], ['hakkinda', 'bolum_hakkinda']]]
  ];
  let ciziliyor = false;
  function ayarCiz() {
    if (ciziliyor || !A.dialog) return;
    ciziliyor = true;
    try {
      const odak = A.kok.activeElement;
      const odakK = odak && odak.getAttribute ? odak.getAttribute('data-k') : null;
      const imlec = odak && odak.selectionStart != null ? [odak.selectionStart, odak.selectionEnd] : null;
      A.stil.textContent = ayarCss();
      const ara = ogeKur('input', { type: 'search', sinif: 'ara', placeholder: m('ara'), 'aria-label': m('ara'), 'data-k': 'ara' });
      ara.value = A.arama;
      ara.addEventListener('input', e => { if (e.isComposing) return; A.arama = ara.value; ayarCiz(); });
      ara.addEventListener('compositionend', () => { A.arama = ara.value; ayarCiz(); });
      const kapatBtn = ogeKur('button', { type: 'button', sinif: 'btn ikon', title: m('kapat'), 'aria-label': m('kapat'),
        'data-k': 'kapat', onclick: () => A.dialog.close() }, [ikon('kapat', 16)]);
      const ust = ogeKur('div', { sinif: 'ust' }, [ogeKur('span', { sinif: 'logo', metin: 'VDP' }),
        ogeKur('h2', { id: 'vdp-baslik', metin: m('ayar_baslik') }), ara, kapatBtn]);
      const nav = ogeKur('nav', { 'aria-label': m('ayar_baslik') });
      for (const [grup, liste] of BOLUMLER) {
        nav.append(ogeKur('div', { sinif: 'grup', metin: m(grup) }));
        for (const [id, ad] of liste) {
          nav.append(ogeKur('button', { type: 'button', sinif: 'git', 'data-k': 'git-' + id,
            'aria-current': A.bolum === id && !A.arama ? 'page' : null, metin: m(ad),
            onclick: () => { A.bolum = id; A.arama = ''; A.durum = ''; ayarCiz(); } }));
        }
      }
      const icerik = ogeKur('div', { sinif: 'icerik' });
      if (A.arama) {
        const q = katla(A.arama.trim());
        let bulundu = 0;
        for (const [, liste] of BOLUMLER) {
          for (const [id, ad] of liste) {
            const satirlar = bolumSatirlari(id).filter(s => katla(s.dataset.ara || s.textContent).includes(q));
            if (!satirlar.length) continue;
            bulundu += satirlar.length;
            ekle(icerik, [ogeKur('h3', { metin: m(ad) }), satirlar]);
          }
        }
        if (!bulundu) icerik.append(ogeKur('p', { sinif: 'bos', metin: m('sonuc_yok') }));
      } else {
        const ad = BOLUMLER.flatMap(x => x[1]).find(x => x[0] === A.bolum);
        ekle(icerik, [ogeKur('h3', { metin: m(ad ? ad[1] : 'bolum_oynatici') }), bolumSatirlari(A.bolum)]);
      }
      const durum = ogeKur('div', { sinif: 'durum' + (A.durum.startsWith('!') ? ' hata' : ''), role: 'status',
        metin: A.durum.replace(/^!/, '') });
      icerik.append(durum);
      if (A.kopyaKutu && A.bolum === 'tani' && !A.arama) icerik.append(A.kopyaKutu);
      A.dialog.replaceChildren(ust, ogeKur('div', { sinif: 'govde' }, [nav, icerik]));
      if (odakK) {
        const el = A.kok.querySelector(`[data-k="${odakK}"]`);
        if (el) { el.focus(); if (imlec && el.setSelectionRange) { try { el.setSelectionRange(imlec[0], imlec[1]); } catch (_hata) { /* yok */ } } }
      }
    } finally { ciziliyor = false; }
  }
  function satir(etiketMetni, denetim, not, k) {
    const s = ogeKur('div', { sinif: 'satir' });
    s.dataset.ara = `${etiketMetni} ${not || ''}`;
    const et = ogeKur('span', { sinif: 'etiket', metin: etiketMetni, id: 'et-' + k });
    s.append(et);
    if (denetim) { denetim.setAttribute('aria-labelledby', 'et-' + k); s.append(denetim); }
    if (not) s.append(ogeKur('div', { sinif: 'not', metin: not }));
    return s;
  }
  function anahtar(deger, k, fn) {
    return ogeKur('button', { type: 'button', role: 'switch', sinif: 'anahtar', 'aria-checked': deger ? 'true' : 'false',
      'data-k': k, onclick: () => { ayarDegistir(() => fn(!deger)); ayarUygula(); ayarCiz(); } });
  }
  function segment(secenekler, deger, k, fn) {
    const s = ogeKur('div', { sinif: 'segment', role: 'radiogroup' });
    for (const [d, metin] of secenekler) {
      s.append(ogeKur('button', { type: 'button', role: 'radio', 'aria-checked': d === deger ? 'true' : 'false',
        'data-k': `${k}-${d}`, metin, onclick: () => { ayarDegistir(() => fn(d)); ayarUygula(); ayarCiz(); } }));
    }
    return s;
  }
  function secim(secenekler, deger, k, fn) {
    const s = ogeKur('select', { 'data-k': k });
    for (const [d, metin] of secenekler) s.append(ogeKur('option', { value: String(d), selected: d === deger, metin }));
    s.addEventListener('change', () => { ayarDegistir(() => fn(s.value)); ayarUygula(); A.durum = m('a_kaydedildi'); ayarCiz(); });
    return s;
  }
  function ayarUygula() {
    menuYaz();
    for (const k of D.videolar.values()) {
      arayuzMetinYenile(k);
      if (AYAR.onizleme && k.kip === 'degistir') onizHazirla(k);
      if (k.ses > sesUst(k)) sesAyarla(k, sesUst(k), false);
    }
  }
  function bolumSatirlari(id) {
    const l = [];
    if (id === 'oynatici') {
      l.push(satir(m('a_atlama'), secim([[5, '5'], [10, '10'], [15, '15'], [30, '30']], AYAR.atlama, 'atlama',
        v => { AYAR.atlama = Number(v); }), null, 'atlama'));
      l.push(satir(m('a_hiz_adim'), secim([[0.05, sayiYaz(0.05)], [0.1, sayiYaz(0.1)], [0.25, sayiYaz(0.25)], [0.5, sayiYaz(0.5)]],
        AYAR.hizAdim, 'hizadim', v => { AYAR.hizAdim = Number(v); }), null, 'hizadim'));
      l.push(satir(m('a_ses_ust'), secim([[1, '%100'], [1.5, '%150'], [2, '%200'], [3, '%300']], AYAR.sesUst, 'sesust',
        v => { AYAR.sesUst = Number(v); }), m('a_ses_ust_not'), 'sesust'));
      l.push(satir(m('a_onizleme'), anahtar(AYAR.onizleme, 'oniz', v => { AYAR.onizleme = v; }), m('a_onizleme_not'), 'oniz'));
      l.push(satir(m('a_devam'), anahtar(AYAR.devam, 'devam', v => { AYAR.devam = v; }), null, 'devam'));
      l.push(satir(m('a_teker'), anahtar(AYAR.teker, 'teker', v => { AYAR.teker = v; }), null, 'teker'));
    } else if (id === 'siteler') {
      const kapali = siteKapali();
      const bu = ogeKur('div', { sinif: 'satir' });
      bu.dataset.ara = `${m('a_bu_site')} ${SITE}`;
      bu.append(ogeKur('span', { sinif: 'etiket' }, [`${m('a_bu_site')}: `, ogeKur('b', { metin: SITE || '—' })]),
        segment([['acik', m('a_durum_acik')], ['kapali', m('a_durum_kapali')]], kapali ? 'kapali' : 'acik', 'durum',
          v => siteAcKapa(v === 'acik')),
        segment([['degistir', m('a_kip_degistir')], ['ekle', m('a_kip_ekle')]], siteEkleKipi() ? 'ekle' : 'degistir', 'kip',
          v => siteKip(v)));
      l.push(bu);
      const kt = ogeKur('textarea', { 'data-k': 'kapali-liste', spellcheck: 'false' });
      kt.value = A.listeTaslak ? A.listeTaslak[0] : AYAR.kapali.join('\n');
      const et = ogeKur('textarea', { 'data-k': 'ekle-liste', spellcheck: 'false' });
      et.value = A.listeTaslak ? A.listeTaslak[1] : AYAR.ekle.join('\n');
      const taslak = () => { A.listeTaslak = [kt.value, et.value]; };
      kt.addEventListener('input', taslak); et.addEventListener('input', taslak);
      const s1 = satir(m('a_kapali_liste'), null, null, 'kapali-l'); s1.append(kt); kt.setAttribute('aria-labelledby', 'et-kapali-l');
      const s2 = satir(m('a_ekle_liste'), null, null, 'ekle-l'); s2.append(et); et.setAttribute('aria-labelledby', 'et-ekle-l');
      const kaydet = ogeKur('button', { type: 'button', sinif: 'btn ana', 'data-k': 'liste-kaydet', metin: m('a_liste_kaydet'),
        onclick: () => {
          ayarDegistir(a => {
            a.kapali = alanListesi(kt.value.split(/\s+/), []);
            a.ekle = alanListesi(et.value.split(/\s+/), []);
          });
          A.listeTaslak = null; A.durum = m('a_kaydedildi'); yenidenKur(); ayarCiz();
        } });
      const s3 = ogeKur('div', { sinif: 'satir' }, [kaydet]);
      s3.dataset.ara = m('a_liste_kaydet');
      l.push(s1, s2, s3);
    } else if (id === 'genel') {
      l.push(satir(m('a_dil'), segment([['tr', 'Türkçe'], ['en', 'English']], AYAR.dil, 'dil', v => { AYAR.dil = v; }), null, 'dil'));
      l.push(satir(m('a_tema'), segment([['sistem', m('a_tema_sistem')], ['acik', m('a_tema_acik')], ['koyu', m('a_tema_koyu')]],
        AYAR.tema, 'tema', v => { AYAR.tema = v; }), null, 'tema'));
    } else if (id === 'kisayol') {
      const tb = ogeKur('tbody');
      for (const eylem of Object.keys(VARSAYILAN_KISAYOL)) {
        const bekliyor = A.yakala === eylem;
        tb.append(ogeKur('tr', null, [
          ogeKur('td', { metin: m('e_' + eylem) }),
          ogeKur('td', null, [bekliyor ? m('k_bekle') : ogeKur('kbd', { metin: AYAR.kisayol[eylem] })]),
          ogeKur('td', null, [ogeKur('button', { type: 'button', sinif: 'btn', 'data-k': 'k-' + eylem, metin: m('k_degistir'),
            'aria-label': `${m('k_degistir')}: ${m('e_' + eylem)}`,
            onclick: () => { A.yakala = eylem; A.durum = ''; ayarCiz(); } })])
        ]));
      }
      const tablo = ogeKur('table', null, [ogeKur('thead', null, [ogeKur('tr', null, [
        ogeKur('th', { metin: m('k_eylem') }), ogeKur('th', { metin: m('k_tus') }), ogeKur('th')])]), tb]);
      const kap = ogeKur('div', { sinif: 'satir' }, [tablo]);
      kap.dataset.ara = Object.keys(VARSAYILAN_KISAYOL).map(e => m('e_' + e)).join(' ') + ' ' + m('bolum_kisayol');
      l.push(kap);
      l.push(satir(m('k_sabit'), null, m('k_sabit_not'), 'sabit'));
      const vb = ogeKur('button', { type: 'button', sinif: 'btn', 'data-k': 'k-varsayilan', metin: m('k_varsayilan'),
        onclick: () => { ayarDegistir(a => { a.kisayol = Object.assign({}, VARSAYILAN_KISAYOL); }); A.durum = m('a_kaydedildi'); ayarCiz(); } });
      const s = ogeKur('div', { sinif: 'satir' }, [vb]); s.dataset.ara = m('k_varsayilan');
      l.push(s);
    } else if (id === 'tani') {
      const tb = ogeKur('tbody');
      for (const [ad, deger, sinif] of taniSatirlari()) {
        tb.append(ogeKur('tr', null, [ogeKur('td', { metin: ad }), ogeKur('td', { sinif, metin: deger })]));
      }
      const tablo = ogeKur('table', null, [tb]);
      const s = ogeKur('div', { sinif: 'satir' }, [tablo]);
      s.dataset.ara = m('bolum_tani');
      l.push(s);
      const rb = ogeKur('button', { type: 'button', sinif: 'btn ana', 'data-k': 'rapor', metin: m('t_rapor'), onclick: raporKopyala });
      const s2 = ogeKur('div', { sinif: 'satir' }, [rb]); s2.dataset.ara = m('t_rapor');
      l.push(s2);
    } else if (id === 'hakkinda') {
      l.push(satir(m('ad'), null, `${m('h_surum')} ${SURUM} · ${m('h_aciklama')}`, 'ad'));
      const al = ogeKur('button', { type: 'button', sinif: 'btn', 'data-k': 'yedek-al', metin: m('h_yedek_al'), onclick: yedekAl });
      const dosya = ogeKur('input', { type: 'file', accept: '.json,application/json', hidden: true });
      dosya.addEventListener('change', () => yedekYukle(dosya));
      const yukle = ogeKur('button', { type: 'button', sinif: 'btn', 'data-k': 'yedek-yukle', metin: m('h_yedek_yukle'),
        onclick: () => { dosya.value = ''; dosya.click(); } });
      const s = ogeKur('div', { sinif: 'satir' }, [al, yukle, dosya]);
      s.dataset.ara = `${m('h_yedek_al')} ${m('h_yedek_yukle')}`;
      l.push(s);
    }
    return l;
  }
  function taniSatirlari() {
    const r = [];
    let kip;
    if (siteKapali()) kip = [m('t_kip_kapali'), 'bekle'];
    else if (siteEkleKipi()) kip = [m('t_kip_ekle'), 'iyi'];
    else kip = [m('t_kip_degistir'), 'iyi'];
    r.push([m('t_kip'), kip[0], kip[1]]);
    r.push([m('t_site'), SITE || '—', '']);
    r.push([m('t_cerceve'), UST_PENCERE ? m('t_ust') : m('t_ic', UST_HOST || '?'), '']);
    if (!D.videolar.size) r.push([m('t_video'), `✗ ${m('t_yok')}`, D.calisiyor ? 'kotu' : 'bekle']);
    let i = 0;
    for (const k of D.videolar.values()) {
      i++;
      const v = k.v;
      r.push([`${m('t_video')} ${i}`, `✓ ${v.videoWidth}×${v.videoHeight} · ${sure(v.duration)} · ${k.kip === 'ekle'
        ? (k.drm ? m('t_kip_drm') : m('t_kip_ekle')) : m('t_kip_degistir')}`, 'iyi']);
      r.push([`  ${m('t_oynatici')}`, `${k.oynatici}${k.vjs ? ' (getPlayer ✓)' : (k.oynatici === 'video.js' ? ' (getPlayer ✗)' : '')}`,
        k.oynatici === 'video.js' && !k.vjs ? 'bekle' : '']);
      r.push([`  ${m('t_kaynak')}`, kaynakTuru(v), '']);
      r.push([`  ${m('t_drm')}`, k.drm ? m('t_drm_var') : m('t_drm_yok'), '']);
      if (k.bekliyor) r.push([`  ${m('t_kip')}`, m('t_kip_bekliyor'), 'bekle']);
      if (k.kip === 'degistir' && !k.bekliyor) {
        r.push([`  ${m('t_cors')}`, k.cors === true ? `✓ ${m('t_cors_temiz')}` : k.cors === false ? `✗ ${m('t_cors_kirli')}`
          : m('t_cors_bekliyor'), k.cors === true ? 'iyi' : k.cors === false ? 'kotu' : 'bekle']);
        r.push([`  ${m('t_onizleme')}`, !AYAR.onizleme ? m('t_oniz_kapali')
          : k.kucukResim ? `✓ ${m('t_oniz_vtt', k.kucukResim.length)} · ${k.kucukResimYer}`
          : k.onizVideo ? `✓ ${m('t_oniz_var')}` : `✗ ${m('t_oniz_mse')}`, k.kucukResim || k.onizVideo ? 'iyi' : 'bekle']);
      }
    }
    for (const n of D.atlanan) r.push([m('t_atlanan'), n, '']);
    return r;
  }
  function raporMetni() {
    const l = [`VDP ${SURUM} · ${location.hostname} · ${new Date().toISOString()}`,
      `GM: ${(() => { try { return GM_info.scriptHandler + ' ' + GM_info.version; } catch (_hata) { return '?'; } })()}`,
      `UA: ${navigator.userAgent}`];
    for (const [a, d] of taniSatirlari()) l.push(`${a}: ${d}`);
    return l.join('\n');
  }
  function raporKopyala() {
    const metin = raporMetni();
    const bitti = () => { A.durum = m('t_kopyalandi'); A.kopyaKutu = null; ayarCiz(); };
    try { if (typeof GM_setClipboard === 'function') { GM_setClipboard(metin, 'text'); bitti(); return; } } catch (_hata) { /* sonraki yol */ }
    const elle = () => {
      const t = ogeKur('textarea', { readonly: true, 'aria-label': m('t_rapor') });
      t.value = metin;
      A.kopyaKutu = t; A.durum = '!' + m('t_kopyala_elle');
      ayarCiz();
      t.focus(); t.select();
    };
    try { navigator.clipboard.writeText(metin).then(bitti, elle); } catch (_hata) { elle(); }
  }
  function yedekAl() {
    const veri = JSON.stringify({ uygulama: 'VDP', surum: SURUM, ayar: AYAR }, null, 2);
    const a = ogeKur('a', { href: 'data:application/json;charset=utf-8,' + encodeURIComponent(veri),
      download: `VDP_ayarlar_${new Date().toISOString().slice(0, 10)}.json` });
    a.style.display = 'none';
    A.kok.append(a); a.click(); a.remove();
  }
  function yedekYukle(dosya) {
    const f = dosya.files && dosya.files[0];
    if (!f) return;
    if (f.size > 200 * 1024) { A.durum = '!' + m('h_yukleme_hata'); ayarCiz(); return; }
    const r = new FileReader();
    r.onload = () => {
      try {
        const v = JSON.parse(String(r.result));
        if (!v || v.uygulama !== 'VDP' || !v.ayar || typeof v.ayar !== 'object' || Array.isArray(v.ayar)) throw new Error('biçim');
        depoYaz('ayar', v.ayar);
        AYAR = ayarYukle();
        ayarKaydet();
        A.durum = m('h_yuklendi');
        yenidenKur();
        ayarUygula();
      } catch (_hata) { A.durum = '!' + m('h_yukleme_hata'); }
      ayarCiz();
    };
    r.readAsText(f);
  }

  // ---------------------------------------------------------------- açılış
  AYAR = ayarYukle();
  // Başka sekme ya da çerçeve ayarı değiştirince: liste değiştiyse yeniden kur, değilse yalnız uygula.
  if (typeof GM_addValueChangeListener === 'function') {
    try {
      GM_addValueChangeListener('ayar', () => {
        const eski = JSON.stringify([AYAR.kapali, AYAR.ekle]);
        AYAR = ayarYukle();
        if (JSON.stringify([AYAR.kapali, AYAR.ekle]) !== eski) yenidenKur(); else { menuYaz(); ayarUygula(); }
        ayarlarYenile();
      });
    } catch (_hata) { /* eski yönetici */ }
  }
  if (window.matchMedia) {
    try { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', ayarlarYenile); } catch (_hata) { /* eski */ }
  }
  menuYaz();
  if (!siteKapali()) baslat();

  // Test kancası: yalnız test düzeneğinde açılır.
  let testMi = false;
  try { testMi = typeof GM_info === 'object' && GM_info && GM_info.scriptHandler === 'Test'; } catch (_hata) { testMi = false; }
  const deneme = window.__AALABS_TEST__;
  if (testMi && deneme && typeof deneme === 'object') {
    deneme.vdp = { D, A, ayar: () => AYAR, tani: taniSatirlari, rapor: raporMetni, altyaziCoz, tusAdi, tusGecerli,
      kokler: () => [...D.videolar.values()].map(k => k.ui && k.ui.kok), ayarKok: () => A.kok };
  }
})();
