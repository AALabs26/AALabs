  };
  // TOKEN-BITIR

  // ---------------------------------------------------------------- ayarlar
  const VARSAYILAN_EKLE = [
    'netflix.com', 'youtube.com', 'disneyplus.com', 'primevideo.com', 'amazon.com', 'max.com', 'hbomax.com',
    'hulu.com', 'tv.apple.com', 'blutv.com', 'exxen.com', 'gain.tv', 'tabii.com', 'twitch.tv', 'spotify.com'
  ];
  const VARSAYILAN_KISAYOL = {
    oynat: 'K', geri: 'J', ileri: 'L', yavas: '<', hizli: '>', kare_geri: ',', kare_ileri: '.',
    sessiz: 'M', tam: 'F', goruntu: 'S', altyazi: 'C', bastan: 'R'
  };
  const VARSAYILAN = {
    surum: 1, dil: 'tr', tema: 'sistem', atlama: 10, hizAdim: 0.25, sesUst: 3, onizleme: true, devam: true,
    teker: true, kapali: [], ekle: VARSAYILAN_EKLE.slice(), kisayol: Object.assign({}, VARSAYILAN_KISAYOL)
  };
  const GM_VAR = typeof GM_getValue === 'function' && typeof GM_setValue === 'function';
  let bellekDepo = {};
  function depoOku(ad, yedek) {
    try { return GM_VAR ? GM_getValue(ad, yedek) : (ad in bellekDepo ? bellekDepo[ad] : yedek); } catch (_hata) { return yedek; }
  }
  function depoYaz(ad, deger) {
    try { if (GM_VAR) GM_setValue(ad, deger); else bellekDepo[ad] = deger; } catch (_hata) { bellekDepo[ad] = deger; }
  }

  let AYAR = null; // dosyanın sonunda yüklenir (TDZ kuralı)


  function alanListesi(v, yedek) {
    if (!Array.isArray(v)) return yedek.slice();
    return [...new Set(v.map(alanTemizle).filter(Boolean))];
  }
  function alanTemizle(s) {
    s = String(s || '').trim().toLowerCase();
    s = s.replace(/^[a-z]+:\/\//, '').replace(/[/?#].*$/, '').replace(/:\d+$/, '').replace(/^www\./, '');
    return /^[a-z0-9.-]+$/.test(s) && s.includes('.') ? s : '';
  }
  function ayarYukle() {
    const ham = depoOku('ayar', null);
    const a = Object.assign({}, VARSAYILAN);
    if (ham && typeof ham === 'object' && !Array.isArray(ham)) {
      for (const k of Object.keys(VARSAYILAN)) if (Object.prototype.hasOwnProperty.call(ham, k)) a[k] = ham[k];
    }
    a.dil = a.dil === 'en' ? 'en' : 'tr';
    a.tema = ['sistem', 'acik', 'koyu'].includes(a.tema) ? a.tema : 'sistem';
    a.atlama = [5, 10, 15, 30].includes(Number(a.atlama)) ? Number(a.atlama) : 10;
    a.hizAdim = [0.05, 0.1, 0.25, 0.5].includes(Number(a.hizAdim)) ? Number(a.hizAdim) : 0.25;
    a.sesUst = [1, 1.5, 2, 3].includes(Number(a.sesUst)) ? Number(a.sesUst) : 3;
    a.onizleme = a.onizleme !== false; a.devam = a.devam !== false; a.teker = a.teker !== false;
    a.kapali = alanListesi(a.kapali, []);
    a.ekle = alanListesi(a.ekle, VARSAYILAN_EKLE);
    a.kisayol = kisayolCoz(a.kisayol);
    return a;
  }
  function kisayolCoz(ham) {
    const eylemler = Object.keys(VARSAYILAN_KISAYOL);
    const ks = {}, kullanilan = new Set();
    if (ham && typeof ham === 'object') {
      for (const e of eylemler) {
        const v = ham[e];
        if (typeof v === 'string' && tusGecerli(v) && !kullanilan.has(v)) { ks[e] = v; kullanilan.add(v); }
      }
    }
    for (const e of eylemler) {
      if (ks[e]) continue;
      if (kullanilan.has(VARSAYILAN_KISAYOL[e])) return Object.assign({}, VARSAYILAN_KISAYOL); // çözülemez: hepsi varsayılan
      ks[e] = VARSAYILAN_KISAYOL[e]; kullanilan.add(ks[e]);
    }
    return ks;
  }
  // Başka sekmenin yazdığını ezmemek için: önce depodan oku, değiştir, yaz.
  function ayarDegistir(fn) { AYAR = ayarYukle(); fn(AYAR); ayarKaydet(); }
  function ayarKaydet() { depoYaz('ayar', JSON.parse(JSON.stringify(AYAR))); }

  // ---------------------------------------------------------------- yardımcılar
  const m = (anahtar, ...p) => {
    const s = (METIN[AYAR ? AYAR.dil : 'tr'] || METIN.tr)[anahtar] || METIN.tr[anahtar] || anahtar;
    return s.replace(/\{(\d)\}/g, (_x, i) => (p[i] !== undefined ? p[i] : ''));
  };
  function sure(s) {
    if (!Number.isFinite(s) || s < 0) s = 0;
    s = Math.floor(s);
    const sa = Math.floor(s / 3600), dk = Math.floor((s % 3600) / 60), sn = s % 60;
    const iki = n => String(n).padStart(2, '0');
    return sa ? `${sa}:${iki(dk)}:${iki(sn)}` : `${iki(dk)}:${iki(sn)}`;
  }
  function sayiYaz(n) {
    const s = (Math.round(n * 100) / 100).toString();
    return AYAR && AYAR.dil === 'tr' ? s.replace('.', ',') : s;
  }
  function ogeKur(etiket, ozellik, cocuklar) {
    const el = document.createElement(etiket);
    if (ozellik) {
      for (const [k, v] of Object.entries(ozellik)) {
        if (v == null || v === false) continue;
        if (k === 'sinif') el.className = v;
        else if (k === 'metin') el.textContent = v;
        else if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
        else el.setAttribute(k, v === true ? '' : String(v));
      }
    }
    if (cocuklar) ekle(el, cocuklar);
    return el;
  }
  function ekle(el, cocuklar) {
    for (const c of [cocuklar].flat(Infinity)) {
      if (c == null || c === false) continue;
      el.append(c instanceof Node ? c : document.createTextNode(String(c)));
    }
    return el;
  }
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const IKON = {
    oynat: 'M7 4v16l13-8z', duraklat: 'M7 4h4v16H7zM13 4h4v16h-4z',
    geri: 'M11 7L6 12l5 5M18 7l-5 5 5 5', ileri: 'M13 7l5 5-5 5M6 7l5 5-5 5',
    kare_geri: 'M6 5v14M18 6l-8 6 8 6z', kare_ileri: 'M18 5v14M6 6l8 6-8 6z',
    ses: 'M4 9v6h4l5 4V5L8 9zM16 9a4 4 0 0 1 0 6', sessiz: 'M4 9v6h4l5 4V5L8 9zM16 9l5 6M21 9l-5 6',
    resim: 'M3 5h18v14H3zM21 16l-5-5-8 8M9 10h.01', altyazi: 'M3 6h18v12H3zM7 14h4M13 14h4M7 11h10',
