// ==UserScript==
// @name         AALabs Firefox Video Player
// @namespace    aalabs
// @version      1.0.1
// @description  Sitenin video oynatıcısını kapatıp kendi çubuğunu açar: önizleme kareli seekbar, hız 0,25×–4×, ses %300'e kadar, kaldığın yerden devam, kare kare, altyazı yükleme.
// @match        *://*/*
// @icon         data:image/png;base64,
// @updateURL    http://127.0.0.1:47815/u/AALabs.FirefoxVideoPlayer.user.js
// @downloadURL  http://127.0.0.1:47815/u/AALabs.FirefoxVideoPlayer.user.js
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_unregisterMenuCommand
// @grant        GM_setClipboard
// @grant        GM_addValueChangeListener
// @grant        unsafeWindow
// @run-at       document-start
// @aalabs-ikon  VDP
// ==/UserScript==

/*
 * AALabs Firefox Video Player (VDP) — tasarım onayı: VDP son · Seekbar B · +E1 +E2 +E4 +E5 (2026-10-30, y4vdn).
 * Kipler:
 *   Değiştir: sitenin oynatıcı çubuğu kapanır, VDP çubuğu video üstüne biner (varsayılan).
 *   Ekle:     site oynatıcısı aynen kalır; yalnız hız (< >), tekerlekle ses ve gösterge (OSD) eklenir.
 *             DRM'li video (mediaKeys) ve Ekle listesindeki siteler (Netflix, YouTube…) bu kiptedir.
 *   Kapalı:   betik sayfaya dokunmaz; yalnız menü komutları kaydedilir.
 */
